Dialog: 0,0:00:58.00,0:01:03.98,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДДСТЕ
Dialog: 0,0:00:58.00,0:01:03.98, Lalai,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807}\fscy2007 92 38 l 0 38
Dialog: 0,0:00:58.00,0:01:03.98,berfungsi,,0,0,0,,{\pos(801,256)}Mengusahakan siri:\N Lily, Tiramisu, Biryulka, Nanas, Hos, Februari
Dialog: 0,0:00:58.00,0:01:03.98,tajuk,,0,0,0,,{\fscx75\fscy75\pos(846,392)}Bagaimana saya menjadi
Dialog: 0,0:00:58.00,0:01:03.98,nama,,0,0,0,,{\fscx75\fscy75\pos(848,456)}ratu
Dialog: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialog: 0,0:01:03.98,0:01:06.45, Lalai, lily,0,0,0,,Semua watak adalah rekaan,
Dialog: 0,0:01:06.45,0:01:09.06, Lalai, lily,0,0,0,,dan acara yang ditunjukkan adalah fiksyen.
Dialog: 0,0:01:14.50,0:01:16.53, Lalai, lily,0,0,0,, Wah.
Dialog: 0,0:01:17.03,0:01:19.43,Lalai,lily,0,0,0,,Saya tidak percaya bahawa Jang Bong-hwan yang hebat
Dialog: 0,0:01:19.53,0:01:23.20, Lalai, lily,0,0,0,,anda memerlukan perkara sedemikian untuk mengekalkan kehidupan.
Dialog: 0,0:01:24.87,0:01:27.54,Lalai,lily,0,0,0,,Hidup sangat tidak bernilai, bukan?
Dialog: 0,0:01:28.84,0:01:31.71, Lalai, lily,0,0,0,,Saya benar-benar bermotivasi.
Dialog: 0,0:01:32.05,0:01:34.92, Lalai, lily,0,0,0,,Bolehkah saya menjadi \NSteve Jobs atau Thomas Edison tempatan?
Dialog: 0,0:01:35.75,0:01:37.28, Lalai, lily,0,0,0,,Tidak, saya merendahkannya. Kami memerlukan seseorang yang hebat.
Dialog: 0,0:01:37.28,0:01:40.15, Lalai, lily,0,0,0,,Penyelamat umat manusia.
Dialog: 0,0:01:49.13,0:01:51.50, Lalai, lily,0,0,0,,Dalam badan ratu duduk,
Dialog: 0,0:01:53.03,0:01:56.30, Lalai, lily,0,0,0,,yang tidak sepatutnya ada.
Dialog: 0,0:01:56.50,0:01:58.11, Lalai, lily,0,0,0,,Roh jahat.
Dialog: 0,0:02:00.01,0:02:03.98,Lalai,lily,0,0,0,,Permaisuri dirasuk roh jahat!
Dialog: 0,0:02:05.28,0:02:07.31, Lalai, lily,0,0,0,,Saya tidak boleh meninggalkan awak seperti ini.
Dialog: 0,0:02:07.38,0:02:09.78, Lalai, lily,0,0,0,, Pergi buat selama-lamanya.
Dialog: 0,0:02:16.02,0:02:19.76, Lalai, lily,0,0,0,,Tepat sekali, Pembawa! Pencipta penghawa dingin!
Dialog: 0,0:02:25.07,0:02:26.27,Lalai,lily,0,0,0,,Yang Mulia!
Dialog: 0,0:02:26.27,0:02:29.37,Lalai,lily,0,0,0,,Sedarlah Tuanku! Ayuh.
Dialog: 0,0:02:29.37,0:02:30.84,Lalai,lily,0,0,0,,Yang Mulia!
Dialog: 0,0:02:36.24,0:02:39.68,Lalai,lily,0,0,0,,7 episod: Topeng
Dialog: 0,0:02:39.68,0:02:41.58, Lalai, lily,0,0,0,,-Cas untuk 100 joule.\N-Alih pergi.
Dialog: 0,0:02:42.85,0:02:45.15, Lalai, lily,0,0,0,,Tambah epinefrin. Caj untuk 150 joule.
Dialog: 0,0:02:45.45,0:02:47.65, Lalai, lily,0,0,0,,-Cas untuk 150 joule.\N-Alih pergi.
Dialog: 0,0:02:55.33,0:02:58.00, Lalai, lily,0,0,0,,-Hidup.\N-Saya datang.
Dialog: 0,0:02:59.43,0:03:02.24,Lalai,lily,0,0,0,,Bukankah ini hamba ratu?
Dialog: 0,0:03:02.97,0:03:06.11, Lalai, lily,0,0,0,,Dan doktor diraja mengejarnya.
Dialog: 0,0:03:10.58,0:03:13.51,Lalai,lily,0,0,0,,-Apa yang berlaku?\N-Yang Mulia...
Dialog: 0,0:03:24.86,0:03:27.36,Lalai,lily,0,0,0,,Yang Mulia. Ia berbahaya!
Dialog: 0,0:03:27.36,0:03:28.80, Lalai, lily,0,0,0,,Tuhan.
Dialog: 0,0:03:32.13,0:03:33.60,Lalai,lily,0,0,0,,Yang Mulia.
Dialog: 0,0:03:33.90,0:03:37.97,Lalai,lily,0,0,0,,Saya telah memikirkannya, saya mengomel awak untuk kebaikan awak...
Dialog: 0,0:03:37.97,0:03:39.64,Lalai,lily,0,0,0,,Yang Mulia.
Dialog: 0,0:03:41.68,0:03:43.11,Lalai,lily,0,0,0,,Yang Mulia!
Dialog: 0,0:03:44.38,0:03:45.65,Lalai,lily,0,0,0,,Apa yang berlaku di sini?
Dialog: 0,0:03:45.65,0:03:48.65, Lalai, lily,0,0,0,,Mereka sudah pergi ke doktor diraja.
Dialog: 0,0:03:49.05,0:03:50.45,Lalai,lily,0,0,0,,Yang Mulia.
Dialog: 0,0:03:50.52,0:03:53.22,Lalai,lily,0,0,0,,Anda tidak boleh mati!
Dialog: 0,0:03:53.22,0:03:56.19,Lalai,lily,0,0,0,,Jangan tinggalkan saya!
Dialog: 0,0:03:56.19,0:03:58.76,Lalai,lily,0,0,0,,Saya tidak akan merungut pada awak lagi.
Dialog: 0,0:03:58.76,0:04:02.33,Lalai,lily,0,0,0,,Sedarlah Tuanku.
Dialog: 0,0:04:03.70,0:04:06.87,Lalai,lily,0,0,0,,Lakukan sesuatu!
Dialog: 0,0:04:07.23,0:04:09.57,Lalai,lily,0,0,0,,Yang Mulia!
Dialog: 0,0:04:09.57,0:04:10.57,Lalai,lily,0,0,0,,Hospital Universiti Hanguk, Jang Bong Hwan
Dialog: 0,0:04:10.57,0:04:12.17, Lalai, lily,0,0,0,,-Cas untuk 100 joule.\N-Selesai.
Dialog: 0,0:04:12.17,0:04:13.61, Lalai, lily,0,0,0,, Beralih.
Dialog: 0,0:04:16.44,0:04:18.18, Lalai, lily,0,0,0,,150 joule, selesai.
Dialog: 0,0:04:19.95,0:04:22.88, Lalai, lily,0,0,0,,-Dia sudah kembali.\N-Apa ini?
Dialog: 0,0:04:23.38,0:04:25.62, Lalai, lily,0,0,0,, Betapa terangnya. Apa yang dia buat?
Dialog: 0,0:04:25.65,0:04:27.85, Lalai, lily,0,0,0,, Denyutan adalah perkara biasa. Tekanan?
Dialog: 0,0:04:27.89,0:04:29.32,Lalai,lily,0,0,0,,Tekanan juga normal.
Dialog: 0,0:04:29.32,0:04:32.66,Lalai,lily,0,0,0,,Hospital? Adakah saya kembali?
Dialog: 0,0:04:32.79,0:04:34.56,Lalai,lily,0,0,0,,Kembali. Kebenaran kembali.
Dialog: 0,0:04:34.56,0:04:37.56,Lalai,lily,0,0,0,,Jang Bong-hwan, awak sedang mati.
Dialog: 0,0:04:37.56,0:04:38.77, Lalai, lily,0,0,0,,Saya tahu.
Dialog: 0,0:04:38.77,0:04:41.60,Lalai,lily,0,0,0,,Saya fikir saya akan terkurung dalam tubuh wanita sepanjang hayat saya.
Dialog: 0,0:04:41.60,0:04:43.14, Lalai, lily,0,0,0,,Berapa hari telah berlalu?
Dialog: 0,0:04:43.14,0:04:45.01,Lalai,lily,0,0,0,,Tepat sekali. Berapa hari saya berbohong?
Dialog: 0,0:04:45.01,0:04:46.61,Lalai,lily,0,0,0,,Badan itu sangat berat.
Dialog: 0,0:04:46.61,0:04:48.14, Lalai, lily,0,0,0,, Seminggu telah berlalu.
Dialog: 0,0:04:48.14,0:04:50.41, Lalai, lily,0,0,0,,Masa berlalu dengan cara yang sama seperti di Joseon.
Dialog: 0,0:04:50.41,0:04:51.81, Lalai, lily,0,0,0,, Mula-mula, bantu saya bangun.
Dialog: 0,0:04:51.81,0:04:54.25, Lalai, lily,0,0,0,,Dia tidak sedarkan diri selama seminggu,
Dialog: 0,0:04:54.65,0:04:56.18, Lalai, lily,0,0,0,,kini dalam keadaan vegetatif.
Dialog: 0,0:04:56.18,0:04:59.19, Lalai, lily,0,0,0,,Apakah maksudnya dalam keadaan vegetatif?
Dialog: 0,0:04:59.22,0:05:02.52,Lalai,lily,0,0,0,,Hei Dr. Lee, adakah anda bercakap tentang saya?
Dialog: 0,0:05:02.52,0:05:04.63, Lalai, lily,0,0,0,,Sungguh keadaan vegetatif, adakah saya normal?
Dialog: 0,0:05:04.63,0:05:05.76,Lalai,lily,0,0,0,,Apa yang awak cakapkan?
Dialog: 0,0:05:05.76,0:05:07.83,Lalai,lily,0,0,0,,-Perhatikan dia.\N-Ya.
Dialog: 0,0:05:10.20,0:05:11.43, Lalai, lily,0,0,0,,Nak ke mana?
Dialog: 0,0:05:11.43,0:05:13.57,Lalai,lily,0,0,0,,Kembalilah! saya sihat!
Dialog: 0,0:05:13.57,0:05:15.14,Lalai,lily,0,0,0,,Ya, saya seperti timun!
Dialog: 0,0:05:15.94,0:05:18.54,Lalai,lily,0,0,0,,Apa? Tidakkah sesiapa mendengar saya?
Dialog: 0,0:05:18.54,0:05:21.21,Lalai,lily,0,0,0,,Saya di sini. saya dah balik.
Dialog: 0,0:05:21.34,0:05:23.91,Lalai,lily,0,0,0,,Jang Bong Hwan kembali!
Dialog: 0,0:05:24.18,0:05:26.65,Lalai,lily,0,0,0,,Bilakah penyembuh akan datang?
Dialog: 0,0:05:27.28,0:05:28.32, Lalai, lily,0,0,0,, Ratu!
Dialog: 0,0:05:28.32,0:05:30.35,Lalai,lily,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialog: 0,0:05:30.75,0:05:33.62,Lalai,lily,0,0,0,,Permaisuriku, bangun!
Dialog: 0,0:05:34.45,0:05:36.32,Lalai,lily,0,0,0,,Apa yang berlaku di sini?
Dialog: 0,0:05:36.62,0:05:40.26,Lalai,lily,0,0,0,,Dia tiba-tiba melompat,
Dialog: 0,0:05:40.29,0:05:43.13, Lalai, lily,0,0,0,,kemudian dia menjadi pucat dan jatuh.
Dialog: 0,0:05:43.13,0:05:45.97, Lalai, lily,0,0,0,,Bagaimana dia boleh jatuh tiba-tiba?
Dialog: 0,0:05:45.97,0:05:47.40,Lalai,lily,0,0,0,,Mungkin diracun.
Dialog: 0,0:05:48.40,0:05:50.40,Lalai,lily,0,0,0,,Dia mungkin diracun!
Dialog: 0,0:05:50.40,0:05:51.87,Lalai,lily,0,0,0,,Apa?
Dialog: 0,0:05:52.84,0:05:55.71, Lalai, lily,0,0,0,,Ini tidak boleh.
Dialog: 0,0:05:55.71,0:05:57.31,Lalai,lily,0,0,0,,Kami memantau produk dengan teliti,
Dialog: 0,0:05:57.31,0:05:59.05,Lalai,lily,0,0,0,,orang luar tidak dibenarkan di sini,
Dialog: 0,0:05:59.05,0:06:02.38, Lalai, lily,0,0,0,,dan permaisuri tidak makan apa-apa di sini.
Dialog: 0,0:06:02.78,0:06:05.02,Lalai,lily,0,0,0,,Kemudian apa yang dia lakukan di sini?
Dialog: 0,0:06:05.02,0:06:06.75,Lalai,lily,0,0,0,,Adakah anda memasak?
Dialog: 0,0:06:07.12,0:06:08.79,Lalai,lily,0,0,0,,Ya.
Dialog: 0,0:06:09.69,0:06:12.89, Lalai, lily,0,0,0,,Dia mungkin mendapat racun
Dialog: 0,0:06:12.89,0:06:15.46,Lalai,lily,0,0,0,,merasa hidangan, Yang Mulia.
Dialog: 0,0:06:15.90,0:06:19.07, Lalai, lily,0,0,0,,Anda tidak pasti tentang itu.
Dialog: 0,0:06:19.07,0:06:20.43, Lalai, lily,0,0,0,, Otolopi.
Dialog: 0,0:06:20.43,0:06:22.60, Lalai, lily,0,0,0,,Saya sentiasa takut,
Dialog: 0,0:06:22.60,0:06:25.61, Lalai, lily,0,0,0,,bahawa sesuatu seperti ini akan berlaku.
Dialog: 0,0:06:25.74,0:06:29.28,Lalai,lily,0,0,0,,Dan akhirnya ia berlaku!
Dialog: 0,0:06:29.38,0:06:32.45, Lalai, lily,0,0,0,,Adakah dia benar-benar telah diracun?
Dialog: 0,0:06:33.98,0:06:35.38,Lalai,lily,0,0,0,,Saya...
Dialog: 0,0:06:35.58,0:06:37.42,Lalai,lily,0,0,0,,Saya akan lihat dia.
Dialog: 0,0:06:37.42,0:06:38.92, Lalai, lily,0,0,0,,Jangan teragak-agak.
Dialog: 0,0:06:50.50,0:06:51.97,Lalai,lily,0,0,0,,Nadi
Dialog: 0,0:06:52.50,0:06:55.10, Lalai, lily,0,0,0,,bukan seperti yang hidup.
Dialog: 0,0:06:55.47,0:06:57.27, Lalai, lily,0,0,0,,Apakah maksud ini?
Dialog: 0,0:07:08.72,0:07:09.92, Lalai, lily,0,0,0,, Keadaan vegetatif.
Dialog: 0,0:07:12.12,0:07:13.45, Lalai, lily,0,0,0,, Keadaan vegetatif?
Dialog: 0,0:07:13.45,0:07:17.69,Lalai,lily,0,0,0,,Seseorang tidak boleh bergerak dan seperti sayur.
Dialog: 0,0:07:19.19,0:07:21.73,Lalai,lily,0,0,0,,Darah dan qi\Nenergynya berkumpul di bahagian atas badannya,
Dialog: 0,0:07:21.73,0:07:25.37,Lalai,lily,0,0,0,,roh telah meninggalkan badan, dan dia sukar bernafas.
Dialog: 0,0:07:25.37,0:07:29.14, Lalai, lily,0,0,0,,Jika tenaga chi kembali, dia akan bertahan. Jika tidak -
Dialog: 0,0:07:31.34,0:07:33.21, Lalai, lily,0,0,0,,dia akan mati.
Dialog: 0,0:07:36.81,0:07:38.38, Lalai, lily,0,0,0,,Apakah maksud mati?
Dialog: 0,0:07:39.48,0:07:40.85,Lalai,lily,0,0,0,,Apa yang boleh saya
Dialog: 0,0:07:40.85,0:07:43.35, Lalai, lily,0,0,0,,apa yang perlu dilakukan untuk menyelamatkannya?
Dialog: 0,0:07:43.95,0:07:48.09, Lalai, lily,0,0,0,,Anda perlu tuangkan air rebusan bunga raya dan jus calamus ke dalam mulutnya.
Dialog: 0,0:07:48.09,0:07:49.46,Lalai,lily,0,0,0,,Ketua Kasim.
Dialog: 0,0:07:49.46,0:07:51.09, Lalai, lily,0,0,0,, Bawa semuanya segera!
Dialog: 0,0:07:51.09,0:07:52.49,Lalai,lily,0,0,0,,Ya, Tuanku.
Dialog: 0,0:07:52.49,0:07:54.86,Lalai,lily,0,0,0,,Adakah Ratu akan bertahan sehingga itu?
Dialog: 0,0:07:55.80,0:07:57.73, Lalai, lily,0,0,0,,Itulah masalahnya.
Dialog: 0,0:07:57.73,0:08:00.83, Lalai, lily,0,0,0,,Jangan hanya berdiri di sana, lakukan sesuatu!
Dialog: 0,0:08:00.83,0:08:03.44, Lalai, lily,0,0,0,,Selamatkan ratu kami.
Dialog: 0,0:08:03.44,0:08:07.27, Lalai, lily,0,0,0,,Untuk melakukan sesuatu, anda perlu mengalihkannya.
Dialog: 0,0:08:11.45,0:08:13.08,Lalai,lily,0,0,0,,Kami pergi ke dewan Daejojon.
Dialog: 0,0:08:14.41,0:08:15.92,Lalai,lily,0,0,0,,Yang Mulia.
Dialog: 0,0:08:16.48,0:08:18.08,Lalai,lily,0,0,0,,Ibu Permaisuri.
Dialog: 0,0:08:18.45,0:08:22.02, Lalai, lily,0,0,0,,Kita perlu mengusir roh jahat dari badan permaisuri.
Dialog: 0,0:08:22.32,0:08:24.16, Lalai, lily,0,0,0,,Anda tidak boleh teragak-agak.
Dialog: 0,0:08:24.62,0:08:27.23, Lalai, lily,0,0,0,,Dan bagaimana untuk melakukan ini?
Dialog: 0,0:08:27.23,0:08:29.90,Lalai,lily,0,0,0,,Mari letak objek menakutkan di sekeliling dewan Daejojon\N
Dialog: 0,0:08:29.90,0:08:31.90, Lalai, lily,0,0,0,, dan sekat tenaga.
Dialog: 0,0:08:32.40,0:08:34.84,Lalai,lily,0,0,0,,Dan kemudian kita akan melakukan ritual mengusir roh.
Dialog: 0,0:08:35.44,0:08:38.54, Lalai, lily,0,0,0,,Ini berbahaya. Upacara seperti itu tidak boleh dilakukan di istana.
Dialog: 0,0:08:38.84,0:08:40.01, Lalai, lily,0,0,0,,Jika kita tertangkap...
Dialog: 0,0:08:40.01,0:08:43.01,Lalai,lily,0,0,0,,Tidak ada gunanya menjalankan ritual di luar istana.
Dialog: 0,0:08:43.34,0:08:47.41,Lalai,lily,0,0,0,,Untuk upacara itu berjaya, lakukannya
Dialog: 0,0:08:47.45,0:08:49.38,Lalai,lily,0,0,0,,diperlukan berhampiran permaisuri.
Dialog: 0,0:09:01.43,0:09:02.90, Lalai, lily,0,0,0,,Live.
Dialog: 0,0:09:03.06,0:09:04.40,Lalai,lily,0,0,0,,Ya.
Dialog: 0,0:09:04.40,0:09:07.13,Lalai,lily,0,0,0,,-Selesai?\N-Ya, semuanya sudah sedia.
Dialog: 0,0:09:20.18,0:09:22.42, Lalai, lily,0,0,0,,Apa yang berlaku?
Dialog: 0,0:09:22.62,0:09:25.12, Lalai, lily,0,0,0,,Pesakit mengalami serangan jantung.
Dialog: 0,0:09:25.12,0:09:27.45,Lalai,lily,0,0,0,,Dengar. Di sini. Tengok sini.
Dialog: 0,0:09:27.45,0:09:29.02,Lalai,lily,0,0,0,,Boleh dengar saya?
Dialog: 0,0:09:32.16,0:09:33.46,Lalai,lily,0,0,0,,Adakah dia berkata sesuatu?
Dialog: 0,0:09:33.46,0:09:36.23, Lalai, lily,0,0,0,,Ya. boleh dengar tak? Saya tahu ia.
Dialog: 0,0:09:36.23,0:09:39.37, Lalai, lily,0,0,0,,Saya mendengar dan melihat segala-galanya, saya bukan sayur.
Dialog: 0,0:09:41.00,0:09:42.10,Lalai,lily,0,0,0,,Betulkah?
Dialog: 0,0:09:42.10,0:09:43.40,Lalai,lily,0,0,0,,Adakah dia benar-benar bercakap?
Dialog: 0,0:09:43.40,0:09:44.60, Lalai, lily,0,0,0,,Dia dituduh palsu.
Dialog: 0,0:09:44.60,0:09:46.81, Lalai, lily,0,0,0,,Hei bodoh, bodoh.
Dialog: 0,0:09:46.81,0:09:49.84,Lalai,lily,0,0,0,,-Saya dengar awak, bodoh.\N-Saya pasti dia rasa begitu.
Dialog: 0,0:09:49.98,0:09:52.31,Lalai,lily,0,0,0,,Dia berada di tengah-tengah skandal antara Khan\N dan Perdana Menteri
Dialog: 0,0:09:52.31,0:09:53.75, Lalai, lily,0,0,0,, dan akan menanggung semua kesalahan pada dirinya sendiri.
Dialog: 0,0:09:53.75,0:09:55.22,Lalai,lily,0,0,0,,Apakah ini?
Dialog: 0,0:09:55.22,0:09:57.92,Lalai,lily,0,0,0,,Helah Pengarah Khan?
Dialog: 0,0:10:06.96,0:10:08.70, Lalai, lily,0,0,0,,Mulakan rawatan.
Dialog: 0,0:10:12.47,0:10:14.47,Lalai,lily,0,0,0,,Dia nampak gila,
Dialog: 0,0:10:14.47,0:10:16.74, Lalai, lily,0,0,0,,tetapi tidak mungkin dapat menyematkan segala-galanya padanya.
Dialog: 0,0:10:16.74,0:10:20.37,Lalai,lily,0,0,0,,Apa yang dia boleh buat? Dia seorang yang kalah.
Dialog: 0,0:10:20.37,0:10:22.74, Lalai, lily,0,0,0,,Cara keluar terbaik untuk dia ialah berbaring di sini.
Dialog: 0,0:10:22.74,0:10:24.41,Lalai,lily,0,0,0,,Adakah anda serius sekarang?
Dialog: 0,0:10:24.41,0:10:27.55,Lalai,lily,0,0,0,,Di tempat saya adakah mereka akan berbohong dan menderita?
Dialog: 0,0:10:27.55,0:10:30.08, Lalai, lily,0,0,0,,Bolehkah detektif berkata begitu?
Dialog: 0,0:10:32.55,0:10:34.02,Lalai,lily,0,0,0,,Sekarang
Dialog: 0,0:10:34.15,0:10:37.79, Lalai, lily,0,0,0,,Saya akan mempertaruhkan nyawa saya dan mendapatkan akupunktur.
Dialog: 0,0:10:53.34,0:10:54.94, Lalai, lily,0,0,0,,Saya tidak akan biarkan dia terlepas dengan ini.
Dialog: 0,0:10:55.01,0:10:58.78, Lalai, lily,0,0,0,,Penjahat Pengarah Khan.
Dialog: 0,0:11:03.05,0:11:04.15, Lalai, nanas, 0,0,0,, Roh Kudus!
Dialog: 0,0:11:04.15,0:11:07.12,Lalai,nanas,0,0,0,,Ya, saya akan gigit tulang belakangnya!
Dialog: 0,0:11:11.26,0:11:13.73, Lalai, nanas,0,0,0,,Apa yang anda lupa di sini?
Dialog: 0,0:11:17.93,0:11:18.93, Lalai, nanas, 0,0,0,, Ratu!
Dialog: 0,0:11:18.93,0:11:20.50,Lalai,nanas,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialog: 0,0:11:20.50,0:11:21.90,Lalai,nanas,0,0,0,,Yang Mulia!
Dialog: 0,0:11:21.94,0:11:25.47,Lalai,nanas,0,0,0,,Anda sudah makan begitu banyak, \Nlupa untuk berhati-hati!
Dialog: 0,0:11:25.47,0:11:28.07, Lalai, nanas,0,0,0,,Apa yang anda akan snek di sana?
Dialog: 0,0:11:36.98,0:11:39.75, Lalai, nanas,0,0,0,, Yang paling teruk sudah berakhir.
Dialog: 0,0:11:40.99,0:11:43.46, Lalai, nanas,0,0,0,,Tetapi kenapa dia tidak bangun?
Dialog: 0,0:11:43.62,0:11:45.49,Lalai,nanas,0,0,0,,Permaisuri bernafas lagi,
Dialog: 0,0:11:45.49,0:11:48.90, Lalai, nanas,0,0,0,,tetapi dia masih belum sedar sepenuhnya.
Dialog: 0,0:11:49.36,0:11:51.70,Lalai,nanas,0,0,0,,Kita perlu memerhatikannya,
Dialog: 0,0:11:51.80,0:11:54.13, Lalai, nanas,0,0,0,, ratu mungkin menjadi lebih teruk.
Dialog: 0,0:11:55.24,0:11:57.40,Lalai,nanas,0,0,0,,Dalam erti kata lain, ia belum berakhir?
Dialog: 0,0:11:57.40,0:11:58.94,Lalai,nanas,0,0,0,,Malam ini
Dialog: 0,0:11:59.31,0:12:00.97, Lalai, nanas,0,0,0,,semuanya akan diselesaikan.
Dialog: 0,0:12:11.42,0:12:14.49,Lalai,nanas,0,0,0,,Raja pergi ke Dewan Daejojong.
Dialog: 0,0:12:16.22,0:12:17.42,Lalai,nanas,0,0,0,,Kenapa?
Dialog: 0,0:12:17.42,0:12:19.79,Lalai,nanas,0,0,0,,Permaisuri tidak sedarkan diri,
Dialog: 0,0:12:20.06,0:12:22.90, Lalai, nanas,0,0,0,,dia mahu tinggal di sisi katilnya dan menjaganya.
Dialog: 0,0:12:27.00,0:12:28.50,Lalai,nanas,0,0,0,,Baiklah.
Dialog: 0,0:12:28.67,0:12:30.60,Lalai,nanas,0,0,0,,Berbaloi untuk diubah...
Dialog: 0,0:12:30.60,0:12:32.51, Lalai, nanas,0,0,0,,Saya kata semuanya baik-baik saja.
Dialog: 0,0:13:05.31,0:13:06.87, Lalai, nanas, 0,0,0,, Tutup mulut anda.
Dialog: 0,0:13:07.37,0:13:10.24,Lalai,nanas,0,0,0,,Ketahui siapa, nyawa anda akan terancam.
Dialog: 0,0:13:10.24,0:13:13.11,Lalai,nanas,0,0,0,,Sudah tentu, saya faham segala-galanya.
Dialog: 0,0:13:18.02,0:13:23.02,Lalai,nanas,0,0,0,,Saya tidak percaya bahawa gadis ini\Ni adalah bawahan kepada wanita mahkamah Choi.
Dialog: 0,0:13:23.16,0:13:26.89, Lalai, nanas,0,0,0,,Semuanya disatukan dengan betul.
Dialog: 0,0:13:27.63,0:13:31.43,Lalai,nanas,0,0,0,,Saya tahu, arwah ada di pihak kita.
Dialog: 0,0:13:31.43,0:13:33.40,Lalai,nanas,0,0,0,,Ibu Permaisuri, adakah kamu di sana?
Dialog: 0,0:13:45.51,0:13:47.75,Lalai,nanas,0,0,0,,Saya mahu melakukan ritual,
Dialog: 0,0:13:47.75,0:13:49.92, Lalai, nanas,0,0,0,, di sini, saya sedang bersedia untuk itu.
Dialog: 0,0:13:49.92,0:13:52.75,Lalai,nanas,0,0,0,,Tiada apa-apa yang serius, jadi duduk.
Dialog: 0,0:13:53.69,0:13:55.59,Lalai,nanas,0,0,0,,Saya mahu bercakap dengan awak.
Dialog: 0,0:13:57.79,0:13:59.53, Lalai, nanas,0,0,0,,Saya tahu tentang segala-galanya.
Dialog: 0,0:14:00.33,0:14:03.96,Lalai,nanas,0,0,0,,Kamu meminta ayah kamu untuk menyelamatkan permaisuri.
Dialog: 0,0:14:04.16,0:14:06.30,Lalai,nanas,0,0,0,,Masa itu anda berkata,
Dialog: 0,0:14:07.03,0:14:10.07, Lalai, nanas, 0,0,0,, bahawa saya tidak perlu bertindak sendirian.
Dialog: 0,0:14:10.07,0:14:12.51,Lalai,nanas,0,0,0,,-Benar.\N-Tetapi apa
Dialog: 0,0:14:13.54,0:14:15.64,Lalai,nanas,0,0,0,,jika saya mahu melakukan sesuatu?
Dialog: 0,0:14:17.38,0:14:18.81,Lalai,nanas,0,0,0,,Kemudian
Dialog: 0,0:14:19.95,0:14:22.92,Lalai,nanas,0,0,0,,bolehkah saya mengatasi ratu?
Dialog: 0,0:14:46.91,0:14:50.78, Lalai, nanas,0,0,0,,Saya akan tinggal sepanjang malam, awak boleh pergi.
Dialog: 0,0:14:51.81,0:14:54.71,Lalai,nanas,0,0,0,,Sudah lewat, saya takut bagaimana anda
Dialog: 0,0:14:54.71,0:14:56.55, Lalai, nanas, 0,0,0,,mereka juga tidak jatuh sakit.
Dialog: 0,0:14:56.78,0:14:58.25, Lalai, nanas,0,0,0,,Semuanya akan baik-baik saja.
Dialog: 0,0:14:58.69,0:15:01.05, Lalai, nanas,0,0,0,, Anda boleh pergi.
Dialog: 0,0:15:01.39,0:15:02.82,Lalai,nanas,0,0,0,,Ya.
Dialog: 0,0:15:15.27,0:15:18.74, Lalai, nanas, 0,0,0,,Saya tidak mempunyai satu hari pun yang tenang di sini.
Dialog: 0,0:15:19.01,0:15:22.24,Lalai,nanas,0,0,0,,Suami yang saya selimut sama cuba membunuh saya.
Dialog: 0,0:15:23.68,0:15:25.45, Lalai, nanas,0,0,0,,Anda akan berasa kebas,
Dialog: 0,0:15:25.45,0:15:26.98, Lalai, nanas,0,0,0,,jangan teragak-agak dan tekan.
Dialog: 0,0:15:26.98,0:15:28.48,Lalai,nanas,0,0,0,,Keluar?
Dialog: 0,0:15:28.58,0:15:30.52,Lalai,nanas,0,0,0,,Saya mengumpulkan keberanian untuk meminta maaf,
Dialog: 0,0:15:30.52,0:15:32.85, Lalai, nanas,0,0,0,, dan ini adalah balasan yang saya dapat?
Dialog: 0,0:15:33.02,0:15:35.62,Lalai,nanas,0,0,0,,Dengar, jika hanya orang yang memerlukan permintaan maaf ialah
Dialog: 0,0:15:35.62,0:15:37.29,Lalai,nanas,0,0,0,,yang meminta maaf, bukan orang yang menerimanya,
Dialog: 0,0:15:37.29,0:15:38.76, Lalai, nanas,0,0,0,, adakah ini satu permintaan maaf?
Dialog: 0,0:15:39.49,0:15:42.70,Lalai,nanas,0,0,0,,Momen hilang. Tidak ada gunanya berkata apa-apa.
Dialog: 0,0:15:45.53,0:15:47.90,Lalai,nanas,0,0,0,,Saya berharap
Dialog: 0,0:15:48.27,0:15:50.80, Lalai, nanas,0,0,0,, bahawa saya akan mempunyai peluang untuk memahami anda.
Dialog: 0,0:15:57.41,0:16:01.58, Lalai, nanas,0,0,0,,Ini adalah kain yang sangat mahal.
Dialog: 0,0:16:01.88,0:16:04.25,Lalai,nanas,0,0,0,,Jika saya menggunakannya,
Dialog: 0,0:16:04.48,0:16:06.89, Lalai, nanas,0,0,0,,Saya akan ingat sepanjang hayat saya.
Dialog: 0,0:16:06.89,0:16:08.39,Lalai,nanas,0,0,0,,Adakah anda pasti?
Dialog: 0,0:16:09.72,0:16:12.63,Lalai,nanas,0,0,0,,Mereka membawakan anda sutera untuk dibuat
Dialog: 0,0:16:12.63,0:16:14.69,Lalai,nanas,0,0,0,,bunga sutera untuk jamuan.
Dialog: 0,0:16:14.69,0:16:15.93,Lalai,nanas,0,0,0,,Betul.
Dialog: 0,0:16:15.93,0:16:19.40, Lalai, nanas,0,0,0,,Dan anda tidak mempunyai lebihan kain lagi?
Dialog: 0,0:16:20.60,0:16:23.00,Lalai,nanas,0,0,0,,Perkaranya,
Dialog: 0,0:16:24.20,0:16:25.61,Lalai,nanas,0,0,0,,ketua di dapur,
Dialog: 0,0:16:25.61,0:16:28.44,Lalai,nanas,0,0,0,,Mr. Kim Moon-geun, mengambil kain itu.
Dialog: 0,0:16:33.81,0:16:37.88, Lalai, nanas,0,0,0,,Adakah terdapat yang serupa antara kain itu?
Dialog: 0,0:16:38.48,0:16:40.65,Lalai,nanas,0,0,0,,Ini...
Dialog: 0,0:17:00.34,0:17:02.18,Lalai,nanas,0,0,0,,Saya nampak dia membakar sesuatu yang berharga,
Dialog: 0,0:17:02.18,0:17:05.35, Lalai, nanas,0,0,0,, mendapati ia mencurigakan dan mengeluarkannya dari api.
Dialog: 0,0:17:05.38,0:17:06.95,Lalai,nanas,0,0,0,,Saya pasti itu dia.
Dialog: 0,0:17:08.78,0:17:10.52,Lalai,nanas,0,0,0,,Putera Yeonpyeong?
Dialog: 0,0:17:18.29,0:17:20.69,Lalai,nanas,0,0,0,,Adakah raja benar-benar ada kaitan dengan ini?
Dialog: 0,0:17:21.13,0:17:22.66, Lalai, nanas,0,0,0,,Apa yang anda katakan?
Dialog: 0,0:17:22.66,0:17:24.06,Lalai,nanas,0,0,0,,Ibu Permaisuri dan Gundik Cho
Dialog: 0,0:17:24.06,0:17:26.90, Lalai, nanas,0,0,0,,adakah mereka melakukan ritual bersama-sama di dalam dinding istana?
Dialog: 0,0:17:26.97,0:17:28.37,Lalai,nanas,0,0,0,,Betul.
Dialog: 0,0:17:29.27,0:17:31.84,Lalai,nanas,0,0,0,,Saya fikir gundik diraja mempunyai otak yang cukup untuk tidak terlibat dalam perkara ini,
Dialog: 0,0:17:31.84,0:17:34.67,Lalai,nanas,0,0,0,,tetapi dia nampaknya sama dengan Ibu Permaisuri.
Dialog: 0,0:17:35.88,0:17:37.28, Lalai, nanas,0,0,0,,Itu lebih baik.
Dialog: 0,0:17:37.28,0:17:40.41,Lalai,nanas,0,0,0,,Saya boleh mengajar orang gila ini satu pelajaran yang baik.
Dialog: 0,0:17:40.41,0:17:42.12,Lalai,nanas,0,0,0,,Jika anda menegur mereka untuk upacara itu
Dialog: 0,0:17:42.12,0:17:44.62, Lalai, nanas, 0,0,0,, dan azimat, khabar angin akan bermula.
Dialog: 0,0:17:45.28,0:17:47.49, Lalai, nanas,0,0,0,,Tetapi mereka tidak akan berhenti.
Dialog: 0,0:17:48.12,0:17:49.82,Lalai,nanas,0,0,0,,Anda betul.
Dialog: 0,0:17:50.06,0:17:53.53,Lalai,nanas,0,0,0,,Saya harap saya boleh melakukan \Nsesuatu yang lebih penting.
Dialog: 0,0:17:55.93,0:17:58.93,Lalai,nanas,0,0,0,,Inilah ketua sida! Saya ada berita segera!
Dialog: 0,0:17:58.93,0:18:00.33, Lalai, nanas,0,0,0,,Masuk.
Dialog: 0,0:18:06.01,0:18:07.57,Lalai,nanas,0,0,0,,Apa yang berlaku?
Dialog: 0,0:18:07.77,0:18:12.18,Lalai,nanas,0,0,0,,Ratu kehilangan nafas, dia tidak sedarkan diri.
Dialog: 0,0:18:13.35,0:18:15.01, Lalai, nanas,0,0,0,, Kehilangan nafas?
Dialog: 0,0:18:15.01,0:18:18.32, Lalai, nanas, 0,0,0,,Penyembuh itu mengembalikan nafasnya,
Dialog: 0,0:18:18.32,0:18:20.72, Lalai, nanas,0,0,0,,tetapi dia perlu diperhatikan sepanjang malam.
Dialog: 0,0:18:20.72,0:18:23.02,Lalai,nanas,0,0,0,,Apa yang berlaku?
Dialog: 0,0:18:23.02,0:18:28.90,Lalai,nanas,0,0,0,,Terdapat syak wasangka ratu diracun semasa memasak di dapur.
Dialog: 0,0:18:35.90,0:18:38.87,Lalai,nanas,0,0,0,,Kim Soyeon
Dialog: 0,0:18:42.91,0:18:45.51,Lalai,nanas,0,0,0,,
Dialog: 0,0:19:14.57,0:19:16.94,Lalai,nanas,0,0,0,,Jika anda ingin berjuang dengan sepenuh hati,
Dialog: 0,0:19:19.61,0:19:22.08,Lalai,nanas,0,0,0,,jika anda mahu mengalahkannya dengan sepenuh hati,
Dialog: 0,0:19:22.22,0:19:27.22,Lalai,nanas,0,0,0,,mulai sekarang\Anda tidak sepatutnya mempunyai rahsia daripada saya.
Dialog: 0,0:19:30.79,0:19:32.63,Lalai,nanas,0,0,0,,Adakah anda bersetuju?
Dialog: 0,0:19:34.36,0:19:37.70,Lalai,nanas,0,0,0,,Ya, saya setuju.
Dialog: 0,0:19:40.70,0:19:43.14,Lalai,nanas,0,0,0,,Kemudian beritahu saya jika ia berbaloi
Dialog: 0,0:19:43.14,0:19:45.97,Lalai,nanas,0,0,0,,adakah raja tahu apa yang berlaku di sini?
Dialog: 0,0:19:55.82,0:19:57.92,Lalai,nanas,0,0,0,,Raja ingin
Dialog: 0,0:19:58.89,0:20:01.05,Lalai,nanas,0,0,0,,sama seperti kita.
Dialog: 0,0:20:15.70,0:20:18.04, Lalai, nanas,0,0,0,,Adakah dia bernafas?
Dialog: 0,0:20:24.08,0:20:25.71, Lalai, nanas, 0,0,0,, Bernafas.
Dialog: 0,0:20:26.28,0:20:27.61,Lalai,nanas,0,0,0,,Tetapi jika dia sedang tidur,
Dialog: 0,0:20:27.61,0:20:30.52, Lalai, nanas,0,0,0,,kenapa dia senyap?
Dialog: 0,0:20:33.12,0:20:36.26, Lalai, nanas,0,0,0,,Apakah itu? Adakah anda terluka?
Dialog: 0,0:20:36.32,0:20:38.16,Lalai,nanas,0,0,0,,Kenapa?
Dialog: 0,0:20:39.29,0:20:42.23, Lalai, nanas,0,0,0,,Anda sentiasa mahukan anak perempuan,
Dialog: 0,0:20:42.83,0:20:45.50,Lalai,nanas,0,0,0,,adakah anda gembira sekarang?
Dialog: 0,0:20:47.67,0:20:50.14,Lalai,nanas,0,0,0,,Anda sedang dalam kesakitan, anda sedang menderita.
Dialog: 0,0:20:51.00,0:20:53.44,Lalai,nanas,0,0,0,,Anda pasti lebih merindui ibu anda sekarang.
Dialog: 0,0:21:15.13,0:21:17.26, Lalai, nanas,0,0,0,,Anda boleh mengendalikan segala-galanya.
Dialog: 0,0:21:18.00,0:21:21.27,Lalai,nanas,0,0,0,,Cepat sembuh,\Nuntuk menjadi penuh kekuatan dan tenaga semula.
Dialog: 0,0:21:21.50,0:21:25.91,Lalai,nanas,0,0,0,,Anda berjanji kepada saya untuk hidup\Nmengikut peraturan penjarakan sosial.
Dialog: 0,0:21:26.61,0:21:30.58,Lalai,nanas,0,0,0,,Saya akan maafkan kamu dan ucapan aneh kamu,
Dialog: 0,0:21:31.31,0:21:33.05, Lalai, nanas, 0,0,0,, dan tingkah laku kurang ajar.
Dialog: 0,0:21:37.42,0:21:39.59,Lalai,nanas,0,0,0,,Bangun sahaja.
Dialog: 0,0:21:59.47,0:22:01.17,Lalai,nanas,0,0,0,,Saya sangat gembira anda belum pergi lagi.
Dialog: 0,0:22:01.17,0:22:02.98, Lalai, nanas,0,0,0,,Apakah itu?
Dialog: 0,0:22:02.98,0:22:05.75,Lalai,nanas,0,0,0,,Ratu berada dalam keadaan vegetatif.
Dialog: 0,0:22:06.15,0:22:08.58, Lalai, nanas,0,0,0,,Adakah dia berhenti bernafas?
Dialog: 0,0:22:08.58,0:22:11.42, Lalai, nanas, 0,0,0,, Mujurlah doktor mengembalikannya kepadanya.
Dialog: 0,0:22:12.29,0:22:15.79,Lalai,nanas,0,0,0,,Saya mahu awak pergi ke Dewan Seongwonjong.
Dialog: 0,0:22:16.89,0:22:19.16,Lalai,nanas,0,0,0,,Seseorang mahu membahayakan permaisuri?
Dialog: 0,0:22:19.16,0:22:23.43,Lalai,nanas,0,0,0,,Kami akan menyerang \NIbu Permaisuri dan Gundik Cho.
Dialog: 0,0:22:30.34,0:22:34.01, Lalai, nanas, 0,0,0,, Pergilah, roh jahat!
Dialog: 0,0:22:34.01,0:22:37.68,Lalai,nanas,0,0,0,,Tuhan, dengarkan doa saya!
Dialog: 0,0:22:37.68,0:22:42.78,Lalai,nanas,0,0,0,,Usir roh jahat!
Dialog: 0,0:22:50.52,0:22:52.56, Lalai, nanas,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:22:53.46,0:22:56.73, Lalai, nanas,0,0,0,,Beraninya awak menceroboh masuk ke sini?\NDAnda tidak tahu apa tempat ini?
Dialog: 0,0:22:56.73,0:22:59.10, Lalai, nanas,0,0,0,,Anda fikir anda boleh lari dengan ini?
Dialog: 0,0:23:06.57,0:23:09.41, Lalai, nanas,0,0,0,,Saya akan tanya anda perkara yang sama.\NDAdakah anda fikir ia satu ancaman kepada kehidupan?
Dialog: 0,0:23:09.41,0:23:11.61, Lalai, nanas,0,0,0,, ratu yang anda boleh lari?
Dialog: 0,0:23:13.88,0:23:15.45,Lalai,nanas,0,0,0,,-Apa itu?\N-Entahlah!
Dialog: 0,0:23:15.45,0:23:18.15,Lalai,nanas,0,0,0,,-Apa yang kamu lakukan?\N-Cari semuanya!
Dialog: 0,0:23:19.85,0:23:21.49, Lalai, nanas,0,0,0,, Sungguh ngeri! awak buat apa?
Dialog: 0,0:23:21.49,0:23:23.86,Lalai,nanas,0,0,0,,-Oh tidak!\N-Sungguh ngeri!
Dialog: 0,0:23:25.09,0:23:29.73,Lalai,nanas,0,0,0,,Saya berdoa untuk kehidupan yang aman di istana!
Dialog: 0,0:23:36.54,0:23:39.97,Lalai,nanas,0,0,0,,Tikus ini ditemui berhampiran Dewan Daejojeon.
Dialog: 0,0:23:40.11,0:23:43.11, Lalai, nanas,0,0,0,,Saya tiada kaitan dengannya.
Dialog: 0,0:23:43.98,0:23:46.85,Default,nenas,0,0,0,,Adakah anda ingin mengatakan bahawa bomoh itu bertindak seorang diri?
Dialog: 0,0:23:47.98,0:23:52.89, Lalai, nanas,0,0,0,,Nampaknya tuhan kamu tidak memberitahu kamu bila kamu akan mati.
Dialog: 0,0:23:55.39,0:23:57.52,Lalai,nanas,0,0,0,,Ia akan berlaku hari ini.
Dialog: 0,0:24:00.69,0:24:03.63, Lalai, nanas, 0,0,0,, Tolong, maafkan saya.
Dialog: 0,0:24:03.83,0:24:08.00,Lalai,nanas,0,0,0,,Saya hanya mengikut arahan Ibu Permaisuri.
Dialog: 0,0:24:08.03,0:24:09.57,Lalai,nanas,0,0,0,,Tutup mulut anda!
Dialog: 0,0:24:11.07,0:24:15.57,Lalai,nanas,0,0,0,,Saya akan melakukan ritual yang akan memecahkan sumpahan.
Dialog: 0,0:24:16.21,0:24:18.68,Lalai,nanas,0,0,0,,Ritual yang akan memecahkan sumpahan?
Dialog: 0,0:24:20.95,0:24:23.08,Lalai,nanas,0,0,0,,Anda berkhidmat kepada Tuhan, bukan raja anda!
Dialog: 0,0:24:23.08,0:24:25.35,Lalai,nanas,0,0,0,,Nampaknya anda memutuskan bahawa istana adalah sarkas!
Dialog: 0,0:24:25.35,0:24:26.89, Lalai, nanas,0,0,0,,Semuanya salah!
Dialog: 0,0:24:27.09,0:24:28.25,Lalai,nanas,0,0,0,,Lewat.
Dialog: 0,0:24:28.25,0:24:30.76,Lalai,nanas,0,0,0,,Nyawa ratu dalam bahaya.
Dialog: 0,0:24:32.56,0:24:33.86, Lalai, nanas,0,0,0,,Ini tidak boleh.
Dialog: 0,0:24:33.86,0:24:35.73, Lalai, nanas,0,0,0,,Anda melakukan ritual itu.
Dialog: 0,0:24:35.73,0:24:38.56, Lalai, nanas,0,0,0,, Dan sekarang anda tidak percaya dengan akibatnya?
Dialog: 0,0:24:39.70,0:24:41.23,Lalai,nanas,0,0,0,,Anda telah ditipu oleh penipu!
Dialog: 0,0:24:41.23,0:24:43.17, Lalai, nanas,0,0,0,, Lihat ke mana arahnya!
Dialog: 0,0:24:43.77,0:24:46.47,Lalai,nanas,0,0,0,,Disebabkan kamu, reputasi seluruh dinasti telah berakhir,
Dialog: 0,0:24:46.47,0:24:48.34,Lalai,nanas,0,0,0,,anda cuba membunuh permaisuri,
Dialog: 0,0:24:48.34,0:24:49.61, Lalai, nanas,0,0,0,,dan juga melakukan jenayah berat,
Dialog: 0,0:24:49.61,0:24:51.04, Lalai, nanas,0,0,0,, mengelirukan kita semua!
Dialog: 0,0:24:51.04,0:24:54.78, Lalai, nanas,0,0,0,,Bagaimanakah anda akan membayar dosa anda?
Dialog: 0,0:24:56.02,0:25:00.19,Lalai,nanas,0,0,0,,Boleh saya tahu keadaan permaisuri?
Dialog: 0,0:25:02.12,0:25:04.92, Lalai, nanas,0,0,0,, Berpura-pura tidak tahu jawapannya?
Dialog: 0,0:25:04.92,0:25:07.43,Lalai,nanas,0,0,0,,Baiklah, saya akan memberitahu anda apa yang berlaku kepada permaisuri.
Dialog: 0,0:25:07.86,0:25:09.40, Lalai, nanas, 0,0,0,, Dia diracun.
Dialog: 0,0:25:10.00,0:25:13.90,Lalai,nanas,0,0,0,,Arsenik ditemui antara produk di dapur.
Dialog: 0,0:25:16.34,0:25:17.80, Lalai, nanas, 0,0,0,, Arsenik.
Dialog: 0,0:25:18.54,0:25:22.04,Lalai,nanas,0,0,0,,Saya pasti anda tahu jenis racun ini.
Dialog: 0,0:25:31.78,0:25:33.39,Lalai,nanas,0,0,0,,Saya pasti,
Dialog: 0,0:25:34.19,0:25:37.99, Lalai, nanas,0,0,0,,anda lebih tahu tentang dia daripada saya.
Dialog: 0,0:25:40.03,0:25:42.19,Lalai,nanas,0,0,0,,Dan sekali lagi anda kembali ke zaman dahulu.
Dialog: 0,0:25:42.60,0:25:46.70,Lalai,nanas,0,0,0,,Sekali lagi kamu menuduh saya membunuh raja.
Dialog: 0,0:25:49.74,0:25:53.91,Lalai,nanas,0,0,0,,Orang bodoh yang cepat melupakan masa lalu.
Dialog: 0,0:25:54.61,0:25:58.68,Lalai,nanas,0,0,0,,Tidak mengetahui betapa berharganya nyawa yang diselamatkan dengan kos nyawa anak anda sendiri.
Dialog: 0,0:26:03.78,0:26:05.75,Lalai,nanas,0,0,0,,Masa itu adalah anda
Dialog: 0,0:26:05.75,0:26:08.12, Lalai, nanas,0,0,0,,rayu saya.
Dialog: 0,0:26:08.49,0:26:10.92,Lalai,nanas,0,0,0,,Daripada menyiasat kematian raja,
Dialog: 0,0:26:10.92,0:26:12.39,Lalai,nanas,0,0,0,,diracun dengan arsenik,
Dialog: 0,0:26:12.39,0:26:15.26, Lalai, nanas,0,0,0,, awak meminta saya untuk hidup awak.
Dialog: 0,0:26:17.66,0:26:19.40,Lalai,nanas,0,0,0,,Dan apa yang saya nampak?
Dialog: 0,0:26:19.40,0:26:23.27,Lalai,nanas,0,0,0,,Kamu memikat gundik yang tidak bersalah Cho ke dalam ritual kotor kamu dan cuba meracuni ratu!
Dialog: 0,0:26:23.37,0:26:26.77,Lalai,nanas,0,0,0,,Tidakkah kamu malu dengan raja yang telah meninggal dunia?
Dialog: 0,0:26:27.74,0:26:29.84,Lalai,nanas,0,0,0,,Walaupun mengapa terkejut, jika anda mempunyai hati nurani,
Dialog: 0,0:26:29.84,0:26:32.48, Lalai, nanas,0,0,0,,anda akan mati selepas dia.
Dialog: 0,0:26:33.71,0:26:37.02,Lalai,nanas,0,0,0,,Meminta maaf tidak berguna.
Dialog: 0,0:26:38.78,0:26:41.32, Lalai, nanas,0,0,0,,Anda tahu lebih daripada sesiapa sahaja,
Dialog: 0,0:26:41.39,0:26:43.92, Lalai, nanas,0,0,0,, betapa saya salah.
Dialog: 0,0:26:43.92,0:26:46.56,Lalai,nanas,0,0,0,,Oleh kerana anda fikir begitu, saya tiada pilihan.
Dialog: 0,0:26:46.56,0:26:47.96,Lalai,nanas,0,0,0,,Saya pesan
Dialog: 0,0:26:48.19,0:26:51.96, Lalai, nanas,0,0,0,,suku bomoh dan wanita mahkamah Khan!
Dialog: 0,0:26:51.96,0:26:53.37, Lalai, nanas,0,0,0,,-Ya!\N-Ya!
Dialog: 0,0:26:55.10,0:27:00.57, Lalai, nanas,0,0,0,, Tolong, selamatkan saya!
Dialog: 0,0:27:00.57,0:27:03.61,Lalai,nanas,0,0,0,,Lepaskan saya!
Dialog: 0,0:27:04.71,0:27:06.65,Lalai,nanas,0,0,0,,Bagi Ibu Permaisuri...
Dialog: 0,0:27:08.21,0:27:09.65, Lalai, nanas, 0,0,0,, Tolong!
Dialog: 0,0:27:11.72,0:27:13.32,Lalai,nanas,0,0,0,,Ampun!
Dialog: 0,0:27:15.05,0:27:17.76, Lalai, nanas,0,0,0,, Tolong maafkan saya!
Dialog: 0,0:27:17.76,0:27:20.36,Lalai,nanas,0,0,0,,Doa tidak akan membantu anda kali ini!
Dialog: 0,0:27:20.36,0:27:24.30,Lalai,nanas,0,0,0,,Berapa lama saya harus menutup mata terhadap kejahatan awak?
Dialog: 0,0:27:24.30,0:27:27.23, Lalai, nanas, 0,0,0,, Anda tidak akan semudah itu kali ini!
Dialog: 0,0:27:27.53,0:27:29.07, Lalai, nanas,0,0,0,,Saya silap!
Dialog: 0,0:27:29.23,0:27:32.47,Lalai,nanas,0,0,0,,Tolong beri saya peluang
Dialog: 0,0:27:32.47,0:27:34.34,Lalai,nanas,0,0,0,,atone!
Dialog: 0,0:27:34.34,0:27:38.28, Lalai, nanas,0,0,0,,Bagaimanakah anda hendak menebus dosa besar itu?
Dialog: 0,0:27:41.81,0:27:44.45,Lalai,nanas,0,0,0,,Anda mesti yakin
Dialog: 0,0:27:45.72,0:27:47.19,Lalai,nanas,0,0,0,,bahawa raja
Dialog: 0,0:27:47.62,0:27:51.52,Lalai,nanas,0,0,0,,tunduk kepada anda dengan sepenuh hati saya.
Dialog: 0,0:27:52.06,0:27:54.96,Lalai,nanas,0,0,0,,Anda pasti raja yang telah mati berada dalam kuasa anda,
Dialog: 0,0:27:54.96,0:27:58.46,Lalai,nanas,0,0,0,,oleh itu, mereka meletakkan jawatan sebagai pemangku raja.
Dialog: 0,0:27:58.56,0:28:00.53, Lalai, nanas,0,0,0,,Atau adakah anda terlupa?
Dialog: 0,0:28:10.38,0:28:12.98,Lalai,fe,0,0,0,,Adakah kata-kata Ibu Permaisuri mengganggu anda?
Dialog: 0,0:28:18.95,0:28:21.15,Lalai,fe,0,0,0,,Untuk ketenangan fikiran anda, saya akan semak,
Dialog: 0,0:28:22.09,0:28:24.32,Default,fe,0,0,0,,jenis orang Yang Maha Mulia.
Dialog: 0,0:28:33.63,0:28:35.77,Lalai,fe,0,0,0,,Apa yang kamu lakukan di sini?
Dialog: 0,0:28:38.34,0:28:39.81,Lalai,fe,0,0,0,,Yang Mulia!
Dialog: 0,0:28:47.91,0:28:49.28,Lalai,fe,0,0,0,,Apa yang kecoh?
Dialog: 0,0:28:49.28,0:28:51.45,Lalai,fe,0,0,0,,Saya menterjemahkan ratu.
Dialog: 0,0:28:52.92,0:28:54.42,Lalai,fe,0,0,0,, Mengangkut?
Dialog: 0,0:28:55.22,0:28:56.59,Lalai,fe,0,0,0,,Di mana?
Dialog: 0,0:28:57.12,0:28:59.02,Lalai,fe,0,0,0,,Saya tidak boleh memberitahu anda.
Dialog: 0,0:29:11.20,0:29:14.51, Lalai, fe,0,0,0,, Tidak boleh beritahu saya ke mana anda akan membawa permaisuri?
Dialog: 0,0:29:18.31,0:29:20.31,Lalai,fe,0,0,0,,Sesuatu telah berlaku?
Dialog: 0,0:29:20.81,0:29:22.41,Lalai,fe,0,0,0,,Topeng pembohongan.
Dialog: 0,0:29:22.41,0:29:26.62,Lalai,fe,0,0,0,,Ratu dikutuk di Seongwonjong.
Dialog: 0,0:29:26.99,0:29:28.45,Lalai,fe,0,0,0,,Itu adalah Ibu Permaisuri
Dialog: 0,0:29:28.99,0:29:31.09,Lalai,fe,0,0,0,,dan gundik diraja Cho.
Dialog: 0,0:29:33.06,0:29:36.13, Lalai, fe,0,0,0,, Gundik Cho tidak akan melakukannya.
Dialog: 0,0:29:36.70,0:29:40.10,Default,fe,0,0,0,,Adakah anda ingin mengatakan bahawa sebab penyakit ratu adalah sumpahan?
Dialog: 0,0:29:40.97,0:29:43.77,Lalai,fe,0,0,0,,Arsenik ditemui di dapur diraja.
Dialog: 0,0:29:48.64,0:29:51.84,Default,fe,0,0,0,,Sekarang siasatan akan dijalankan oleh Jabatan Detektif.
Dialog: 0,0:29:52.08,0:29:54.91,Lalai,fe,0,0,0,,Dalam hal ini, saya ada soalan untuk anda.
Dialog: 0,0:29:56.18,0:29:58.48,Lalai,fe,0,0,0,,Apa dan di mana anda lakukan dengan Putera Yeonpyeong
Dialog: 0,0:29:58.98,0:30:02.52,Lalai,fe,0,0,0,,malam selepas perkahwinan diraja?
Dialog: 0,0:30:04.42,0:30:07.09,Lalai,fe,0,0,0,,Apa yang anda benarkan?
Dialog: 0,0:30:07.23,0:30:09.73,Lalai,fe,0,0,0,,Tunjukkan wajah sebenar anda.
Dialog: 0,0:30:09.73,0:30:12.16,Lalai,fe,0,0,0,,Nampaknya ingatan anda melemahkan anda.
Dialog: 0,0:30:12.97,0:30:16.47,Lalai,fe,0,0,0,,Jika ini berlaku, saya perlu menyoal siasat putera raja secara rasmi.
Dialog: 0,0:30:21.11,0:30:23.01,Lalai,fe,0,0,0,,Tidak selangkah lagi!
Dialog: 0,0:30:26.88,0:30:28.31,Lalai,fe,0,0,0,,Yang Mulia.
Dialog: 0,0:30:39.22,0:30:41.66,Lalai,fe,0,0,0,,Sila jangan bergerak.
Dialog: 0,0:30:42.13,0:30:46.33,Lalai,fe,0,0,0,,Jika tidak, pengawal anda perlu\Ntidak menghormati dan membahayakan anda.
Dialog: 0,0:31:03.68,0:31:05.25,Lalai,fe,0,0,0,,Berhenti.
Dialog: 0,0:31:06.35,0:31:07.92,Lalai,fe,0,0,0,,Ini adalah perintah raja.
Dialog: 0,0:31:12.52,0:31:14.23,Lalai,fe,0,0,0,,Ini wanita saya.
Dialog: 0,0:31:16.40,0:31:19.60,Lalai,fe,0,0,0,,Sentuh dia walaupun dengan jari,
Dialog: 0,0:31:20.10,0:31:22.77,Lalai,fe,0,0,0,,dan pedang ini akan memotong kerongkong anda.
Dialog: 0,0:31:30.21,0:31:34.11,Lalai,fe,0,0,0,,Saya tidak tahu yang permaisuri sangat sayangkan awak.
Dialog: 0,0:31:34.45,0:31:36.85,Lalai,fe,0,0,0,,Anda tidak tahu banyak perkara.
Dialog: 0,0:31:38.02,0:31:40.29,Lalai,fe,0,0,0,,Izinkan saya memberi pengajaran kepada anda.
Dialog: 0,0:31:54.93,0:31:56.67,Lalai,fe,0,0,0,,Bolehkah anda melihat saya?
Dialog: 0,0:32:01.37,0:32:04.51,Lalai,fe,0,0,0,,Saya adalah raja negara ini!
Dialog: 0,0:32:07.31,0:32:09.85,Lalai,fe,0,0,0,,Awak pejuang siapa?
Dialog: 0,0:32:11.42,0:32:13.22, Lalai, fe,0,0,0,, Pengawal saya.
Dialog: 0,0:32:14.45,0:32:16.69,Lalai,fe,0,0,0,,Alih pergi.
Dialog: 0,0:32:29.64,0:32:31.14,Lalai,fe,0,0,0,,Yang Mulia.
Dialog: 0,0:32:35.14,0:32:37.24,Lalai,fe,0,0,0,,Bukankah ini pengkhianatan?
Dialog: 0,0:32:38.08,0:32:39.98,Lalai,fe,0,0,0,,Alih keluar orang anda,
Dialog: 0,0:32:40.21,0:32:43.42,Lalai,fe,0,0,0,,jika anda tidak mahu darah tertumpah di Daejojon.
Dialog: 0,0:32:43.48,0:32:46.62,Lalai,fe,0,0,0,,Jika kamu memerintah, Putera Yeonpyeong
Dialog: 0,0:32:46.62,0:32:49.99,Lalai,fe,0,0,0,, dengan senang hati akan mengotorkan tangannya.
Dialog: 0,0:32:51.09,0:32:53.56,Lalai,fe,0,0,0,,Saya cuma ada soalan untuk anda.
Dialog: 0,0:32:53.76,0:32:55.93,Lalai,fe,0,0,0,,Anda datang tepat pada masanya.
Dialog: 0,0:32:59.03,0:33:01.93,Lalai,fe,0,0,0,,Saya tidak mengarahkan siasatan dimulakan.
Dialog: 0,0:33:03.84,0:33:08.17,Lalai,fe,0,0,0,,Kepada siapa Jabatan Detektif sekarang melaporkan?
Dialog: 0,0:33:13.51,0:33:16.21,Lalai,fe,0,0,0,,Mula-mula saya akan mengkaji perkara itu sendiri.
Dialog: 0,0:33:18.05,0:33:21.05,Lalai,fe,0,0,0,,Dan anda tidak boleh menuduh orang yang tidak bersalah lagi.
Dialog: 0,0:33:21.05,0:33:24.32,Lalai,fe,0,0,0,,Hanya permaisuri yang tidak bersalah di sini!
Dialog: 0,0:33:25.19,0:33:27.13,Lalai,fe,0,0,0,,Saya sudah beritahu anda.
Dialog: 0,0:33:27.13,0:33:31.00,Lalai,fe,0,0,0,,Buat dia menderita,\Dan hidup anda juga akan menjadi penyeksaan.
Dialog: 0,0:33:32.53,0:33:37.10,Lalai,fe,0,0,0,,Saya berkata bahawa ini bukan ancaman.\NBTetapi saya perlu menarik balik kata-kata saya.
Dialog: 0,0:33:37.10,0:33:38.74,Lalai,fe,0,0,0,,Beraninya awak!
Dialog: 0,0:33:49.28,0:33:53.02,Lalai,fe,0,0,0,,Wanita ini bukan lagi sepupu awak.
Dialog: 0,0:33:54.19,0:33:56.22,Lalai,fe,0,0,0,,Kebahagiaannya,
Dialog: 0,0:33:56.59,0:33:59.86,Lalai,fe,0,0,0,,kesedihan dan keselamatan kini menjadi kebimbangan
Dialog: 0,0:34:00.33,0:34:03.03,Lalai,fe,0,0,0,,bukan ketua Jabatan Detektif - awak,
Dialog: 0,0:34:03.56,0:34:05.23, Lalai,fe,0,0,0,,dan saya.
Dialog: 0,0:34:10.27,0:34:12.67,Lalai,fe,0,0,0,,Permaisuri akan diangkut ke rumah keluarganya.
Dialog: 0,0:34:15.87,0:34:17.94,Lalai,fe,0,0,0,,Sediakan tandu.
Dialog: 0,0:34:18.44,0:34:19.85,Lalai,fe,0,0,0,,-Ya.\N-Ya.
Dialog: 0,0:34:31.39,0:34:32.86,Lalai,fe,0,0,0,,Meninggalkan.
Dialog: 0,0:34:43.77,0:34:45.30,Lalai,fe,0,0,0,,Saya lambat.
Dialog: 0,0:34:45.30,0:34:46.74,Lalai,fe,0,0,0,,Anda begitu
Dialog: 0,0:34:47.74,0:34:49.84,Lalai,fe,0,0,0,,cuba menyembunyikan bahagian ini.
Dialog: 0,0:35:12.03,0:35:13.80,Lalai,fe,0,0,0,,Perhatikan dia dengan teliti.
Dialog: 0,0:35:14.03,0:35:15.43,Lalai,fe,0,0,0,,Ya.
Dialog: 0,0:35:15.60,0:35:17.77,Lalai,fe,0,0,0,,Maaf kerana meninggalkan anda sendirian.
Dialog: 0,0:35:31.28,0:35:34.12,Lalai,fe,0,0,0,,Berjaga-jaga sehingga anda tiba.
Dialog: 0,0:35:34.25,0:35:36.79,Lalai,fe,0,0,0,,Dan berjaga sepanjang malam semasa ketibaan.
Dialog: 0,0:35:36.79,0:35:38.29,Lalai,fe,0,0,0,,Ya!
Dialog: 0,0:35:53.61,0:35:57.78,Lalai,fe,0,0,0,,Saya yakin semua orang kecuali saya akan dapat menghembuskan nafas di dalam istana.
Dialog: 0,0:35:58.18,0:36:01.55,Lalai,fe,0,0,0,,Dan mengapa ini membuatkan anda berasa lebih baik?
Dialog: 0,0:36:04.22,0:36:07.85,Lalai,fe,0,0,0,,Tunggu, Kim Hwan sepatutnya berada di sini sekarang.
Dialog: 0,0:36:10.06,0:36:11.69,Lalai,fe,0,0,0,,Dan inilah syaitan sendiri.
Dialog: 0,0:36:15.13,0:36:16.63,Lalai,fe,0,0,0,,Saya sudah bimbang kita tidak akan berjumpa antara satu sama lain
Dialog: 0,0:36:16.63,0:36:18.50,Lalai,fe,0,0,0,,sebelum saya pergi...
Dialog: 0,0:36:20.00,0:36:21.50,Lalai,fe,0,0,0,,Dan siapa ini?
Dialog: 0,0:36:22.73,0:36:25.94,Lalai,fe,0,0,0,,Hari ini saya jumpa kawan baik.
Dialog: 0,0:36:25.94,0:36:29.31,Lalai,fe,0,0,0,,Ini Lee Senban.
Dialog: 0,0:36:29.31,0:36:32.48,Lalai,fe,0,0,0,,Kami bertemu semasa saya mencari rakan saya Lee Senman.
Dialog: 0,0:36:33.11,0:36:37.05,Lalai,fe,0,0,0,,Kami ditakdirkan untuk berkawan.
Dialog: 0,0:36:37.62,0:36:39.75,Lalai,fe,0,0,0,,Saya mahu minum dengan awak
Dialog: 0,0:36:40.02,0:36:42.05, Lalai, fe,0,0,0,, dan main kad.
Dialog: 0,0:36:42.59,0:36:44.99,Lalai,fe,0,0,0,,Adakah anda mahu kedai di sini atau apa?
Dialog: 0,0:36:45.22,0:36:48.46,Lalai,fe,0,0,0,,Minum dan bermain kad? Apakah jenis orang anda?
Dialog: 0,0:36:48.46,0:36:51.50,Lalai,fe,0,0,0,,Apa? Itulah yang kami lakukan di sini.
Dialog: 0,0:36:51.50,0:36:53.83,Lalai,fe,0,0,0,,Hanya anda boleh melakukan ini.
Dialog: 0,0:36:53.83,0:36:56.57,Lalai,fe,0,0,0,,Hanya untuk awak, Kim Hwan.
Dialog: 0,0:36:57.97,0:37:00.51,Lalai,fe,0,0,0,,-Hanya untuk anda.\N-Apa?
Dialog: 0,0:37:01.11,0:37:04.28,Lalai,fe,0,0,0,,Saya tidak tahu ia begitu mudah untuk menarik minat anda.
Dialog: 0,0:37:04.41,0:37:07.75,Lalai,fe,0,0,0,,Adakah begitu mudah untuk anda berkawan?\NDAdakah anda mempunyai lebih daripada mereka daripada yang anda inginkan?
Dialog: 0,0:37:07.75,0:37:10.25,Lalai,fe,0,0,0,,Nampaknya, saya adalah salah seorang kawan awak pada petang itu,
Dialog: 0,0:37:10.25,0:37:13.49,Lalai,fe,0,0,0,,salah seorang daripada ramai rakan anda.
Dialog: 0,0:37:46.35,0:37:49.59,Lalai,fe,0,0,0,,Nah, adakah anda menghantar rakan anda Lee Senban pulang?
Dialog: 0,0:37:49.59,0:37:51.32,Lalai,fe,0,0,0,,Anda dipanggil ke istana.
Dialog: 0,0:37:52.19,0:37:53.63,Lalai,fe,0,0,0,,Apa?
Dialog: 0,0:37:59.30,0:38:01.33,Lalai,fe,0,0,0,,Mengapa tiada sesiapa di sini hari ini?
Dialog: 0,0:38:01.93,0:38:06.61,Lalai,fe,0,0,0,,Adakah semua orang pergi melihat\N sesuatu yang menarik tanpa saya?
Dialog: 0,0:38:09.17,0:38:12.14,Lalai,fe,0,0,0,,Rasa seperti semua orang meninggalkan saya.
Dialog: 0,0:38:22.12,0:38:24.52,Lalai,fe,0,0,0,,Lee Senman, awak masih hidup!
Dialog: 0,0:38:24.52,0:38:26.86,Lalai,fe,0,0,0,,Akhirnya jumpa!
Dialog: 0,0:38:31.30,0:38:34.93,Lalai,fe,0,0,0,,Saya tersilap, saya kelirukan awak dengan kawan.
Dialog: 0,0:38:35.47,0:38:36.97,Lalai,fe,0,0,0,,Maaf.
Dialog: 0,0:38:39.90,0:38:42.17,Lalai,fe,0,0,0,,Saya bukan kawan awak.
Dialog: 0,0:38:42.54,0:38:45.21,Lalai,fe,0,0,0,,Tetapi saya ada sesuatu yang menarik.
Dialog: 0,0:38:53.25,0:38:56.89,Lalai,fe,0,0,0,,Apakah perkara ini? Mereka kelihatan pelik.
Dialog: 0,0:38:56.89,0:38:58.42,Lalai,fe,0,0,0,,Ini...
Dialog: 0,0:39:01.56,0:39:03.16, Lalai, fe,0,0,0,, Perintah berkurung belum ditarik balik.
Dialog: 0,0:39:03.16,0:39:05.86,Lalai,fe,0,0,0,,-Kenapa awak berada di jalan?\N-Sembunyi.
Dialog: 0,0:39:08.00,0:39:09.50,Lalai,fe,0,0,0,,Anda...
Dialog: 0,0:39:10.34,0:39:13.64,Lalai,fe,0,0,0,,Satu pukulan tidak mencukupi?
Dialog: 0,0:39:13.64,0:39:15.71,Lalai,fe,0,0,0,,Adakah anda menjual buku dengan kata-kata lucah lagi?
Dialog: 0,0:39:15.71,0:39:17.11,Lalai,fe,0,0,0,,Tidak senonoh?
Dialog: 0,0:39:19.58,0:39:22.91,Lalai,fe,0,0,0,,Dialah yang mahu menjualnya kepada saya.
Dialog: 0,0:39:23.65,0:39:25.28,Lalai,fe,0,0,0,,Anda dituduh melanggar moral.
Dialog: 0,0:39:25.28,0:39:26.85,Lalai,fe,0,0,0,,Angkat mereka.
Dialog: 0,0:39:26.85,0:39:28.15,Lalai,fe,0,0,0,,Ya.
Dialog: 0,0:39:28.15,0:39:30.92,Lalai,fe,0,0,0,,-Tunggu, saya...\N-Lepaskan saya.
Dialog: 0,0:39:30.92,0:39:32.66,Lalai,fe,0,0,0,,-Tunggu.\N-Berhenti.
Dialog: 0,0:39:32.66,0:39:34.53,Lalai,fe,0,0,0,,-Anda boleh menjadi lebih lembut.\N-Inilah Herod.
Dialog: 0,0:39:34.53,0:39:36.53,Lalai,fe,0,0,0,,Bolehkah anda bersikap lebih lembut, saya takut.
Dialog: 0,0:39:36.53,0:39:40.10,Default,fe,0,0,0,,Dia bertanya secara khusus tentang malam selepas perkahwinan.
Dialog: 0,0:39:40.40,0:39:42.67,Lalai,fe,0,0,0,,Jadi ratu memberitahu segala-galanya.
Dialog: 0,0:39:42.67,0:39:46.00,Lalai,fe,0,0,0,,Rasanya saya pelik bahawa dia diam sekian lama.
Dialog: 0,0:39:46.00,0:39:48.64,Lalai,fe,0,0,0,,Jika dia tahu saya cuba membunuhnya,
Dialog: 0,0:39:48.91,0:39:51.04,Lalai,fe,0,0,0,,satu soal siasat tidak akan menamatkan perkara itu.
Dialog: 0,0:39:51.18,0:39:54.65,Lalai,fe,0,0,0,,Pada hari pelantikannya, dia membaca pepatah:
Dialog: 0,0:39:54.65,0:39:56.95,Lalai,fe,0,0,0,,"Menyelamatkan empayar daripada perselisihan,
Dialog: 0,0:39:57.12,0:39:59.28,Lalai,fe,0,0,0,,kuasa menimbulkan ketakutan kepada raja."
Dialog: 0,0:39:59.28,0:40:00.82,Lalai,fe,0,0,0,,Tukang belanda yakin diri.
Dialog: 0,0:40:00.82,0:40:03.42,Lalai,fe,0,0,0,,Dia mengancam untuk merampas takhta awak.
Dialog: 0,0:40:03.42,0:40:07.16,Lalai,fe,0,0,0,,Jika dia sanggup pergi sejauh itu,\Sepatutnya kamu tergigit lidah.
Dialog: 0,0:40:07.16,0:40:08.66,Lalai,fe,0,0,0,,Dan kemudian
Dialog: 0,0:40:08.66,0:40:10.93,Lalai,fe,0,0,0,,dia akan terus memberi tekanan kepada Baginda.
Dialog: 0,0:40:11.13,0:40:13.40,Lalai,fe,0,0,0,,Baginda akan mendedahkan dirinya dalam apa jua keadaan.
Dialog: 0,0:40:13.40,0:40:14.97,Lalai,fe,0,0,0,,Lelaki pintar.
Dialog: 0,0:40:15.90,0:40:18.40,Lalai,fe,0,0,0,,Dia pasti telah menemui sesuatu.
Dialog: 0,0:40:18.60,0:40:21.21,Lalai,fe,0,0,0,,Saya akan mengetahui sejauh mana dia tahu.
Dialog: 0,0:40:21.97,0:40:26.18,Lalai,fe,0,0,0,,Buat masa ini kita hanya boleh berharap agar permaisuri akan sedar.
Dialog: 0,0:40:26.41,0:40:30.01,Lalai,fe,0,0,0,,Ini adalah perkara yang paling penting untuk semua orang.
Dialog: 0,0:40:30.01,0:40:31.35,Lalai,fe,0,0,0,,Bagaimana pula dengan latihan?
Dialog: 0,0:40:31.35,0:40:33.32,Lalai,fe,0,0,0,,Kim Byonin sedang memburu kepala kita.
Dialog: 0,0:40:33.32,0:40:35.89,Lalai,fe,0,0,0,,Lebih banyak usaha diperlukan.
Dialog: 0,0:40:35.92,0:40:38.92,Lalai,fe,0,0,0,,Ada sedikit masa lagi.
Dialog: 0,0:40:39.92,0:40:41.36,Lalai,fe,0,0,0,,Tuhan.
Dialog: 0,0:40:41.59,0:40:43.43,Lalai,fe,0,0,0,,Naikkan tanglung.
Dialog: 0,0:40:53.81,0:40:55.71,Lalai,fe,0,0,0,,Sejauh mana Yang Mulia?
Dialog: 0,0:40:55.77,0:40:56.81,Lalai,fe,0,0,0,,Dia dalam perjalanan ke sini.
Dialog: 0,0:40:56.81,0:40:59.31,Lalai,fe,0,0,0,,Adakah anda pasti dia tidak berada di ambang kematian?
Dialog: 0,0:40:59.88,0:41:01.68,Lalai,fe,0,0,0,,Ya, mujurlah, semuanya berjaya.
Dialog: 0,0:41:01.68,0:41:03.18,Lalai,fe,0,0,0,,Ya Tuhanku.
Dialog: 0,0:41:03.75,0:41:05.72,Lalai,fe,0,0,0,,Bagaimana ini boleh berlaku?
Dialog: 0,0:41:06.15,0:41:08.99,Lalai,fe,0,0,0,,Diracun? Bagaimana dia boleh diracun?
Dialog: 0,0:41:09.12,0:41:12.92,Lalai,fe,0,0,0,,Saya sudah memanggil doktor terbaik Joseon.
Dialog: 0,0:41:13.59,0:41:15.06,Lalai,fe,0,0,0,,Tuhan.
Dialog: 0,0:41:15.39,0:41:18.20,Lalai,fe,0,0,0,,Walau bagaimanapun,\N anda perlu bertenang.
Dialog: 0,0:41:19.76,0:41:23.40,Lalai,fe,0,0,0,,Anda perlu bertenang dan berfikir secara rasional.
Dialog: 0,0:41:24.67,0:41:26.07,Lalai,fe,0,0,0,,Apakah ini.
Dialog: 0,0:41:26.54,0:41:28.71,Lalai,fe,0,0,0,,Tuhan.
Dialog: 0,0:41:29.37,0:41:32.88,Lalai,fe,0,0,0,,Ya Tuhanku.
Dialog: 0,0:41:33.28,0:41:35.05,Lalai,fe,0,0,0,,Sungguh kejam.
Dialog: 0,0:41:35.08,0:41:37.12,Lalai,fe,0,0,0,,Suami Ibu Ratu telah diracun.
Dialog: 0,0:41:37.12,0:41:38.88,Lalai,fe,0,0,0,,Bagaimana anda boleh menyalahkannya?
Dialog: 0,0:41:38.88,0:41:40.22,Lalai,fe,0,0,0,,Situasinya sukar,
Dialog: 0,0:41:40.22,0:41:43.56,Lalai,fe,0,0,0,,Hwajin, jauhi Ibu Permaisuri.
Dialog: 0,0:41:43.69,0:41:45.46,Lalai,fe,0,0,0,,Ini berlaku pada hari lawatan saya.
Dialog: 0,0:41:45.46,0:41:47.33,Lalai,fe,0,0,0,,Saya memberi mereka peluang.
Dialog: 0,0:41:47.33,0:41:49.13,Lalai,fe,0,0,0,,Jangan menyalahkan diri sendiri tentang perkara ini.
Dialog: 0,0:41:49.33,0:41:51.56,Lalai,fe,0,0,0,,Mereka akan tetap bergerak.
Dialog: 0,0:41:52.10,0:41:53.53,Lalai,fe,0,0,0,,Tetapi
Dialog: 0,0:41:54.37,0:41:57.50,Lalai,fe,0,0,0,,mengapa kamu memindahkan permaisuri pulang ke rumah bapanya?
Dialog: 0,0:41:57.50,0:41:59.84,Lalai,fe,0,0,0,,Dia pasti kesepian di istana.
Dialog: 0,0:41:59.87,0:42:02.24,Lalai,fe,0,0,0,,Dalam mimpi dia menelefon ibunya.
Dialog: 0,0:42:03.34,0:42:06.78,Lalai,fe,0,0,0,,Tetapi Baginda bermimpi tentang ini.
Dialog: 0,0:42:07.71,0:42:09.11,Lalai,fe,0,0,0,,Mengenai apa?
Dialog: 0,0:42:09.31,0:42:11.12,Lalai,fe,0,0,0,,Sesuatu yang salah?
Dialog: 0,0:42:13.55,0:42:16.72,Lalai,fe,0,0,0,,-Tidak.\N-Jangan risau.
Dialog: 0,0:42:16.75,0:42:19.99,Lalai,fe,0,0,0,,Saya akan menghantar abang saya sebaik sahaja semuanya diputuskan.
Dialog: 0,0:42:26.16,0:42:27.60,Lalai,Spillik,0,0,0,,Yang Mulia.
Dialog: 0,0:42:34.84,0:42:36.31,Lalai,Spillik,0,0,0,,Saya mohon.
Dialog: 0,0:42:36.54,0:42:38.91,Lalai,Spillik,0,0,0,,Adakah anda akan menentang kehendak raja?
Dialog: 0,0:42:44.78,0:42:46.48,Lalai,Spillik,0,0,0,,Tolong jangan cedera.
Dialog: 0,0:42:48.89,0:42:50.29,Lalai,Spillik,0,0,0,,Okey.
Dialog: 0,0:43:05.44,0:43:07.34,Lalai,Spillik,0,0,0,,Sekarang anda di sini,
Dialog: 0,0:43:08.24,0:43:10.81,Lalai,Spillik,0,0,0,,ia seperti kita telah kembali ke masa lalu.
Dialog: 0,0:43:13.28,0:43:14.71,Lalai,Spillik,0,0,0,,Benin.
Dialog: 0,0:43:18.55,0:43:22.15,Lalai,Spillik,0,0,0,,Hanya anda yang mencari saya apabila saya melarikan diri.
Dialog: 0,0:43:22.65,0:43:24.89,Lalai,Spillik,0,0,0,,Saya tidak akan membiarkan anda kehilangan diri anda.
Dialog: 0,0:43:26.96,0:43:28.99,Lalai,Spillik,0,0,0,,Dan saya tidak akan lupa.
Dialog: 0,0:43:32.66,0:43:34.90,Lalai,Spillik,0,0,0,,Kalaulah saya boleh kembali ke hari itu.
Dialog: 0,0:43:41.24,0:43:43.07,Lalai,Spillik,0,0,0,,Ini wanita saya.
Dialog: 0,0:43:49.18,0:43:51.45,Lalai,Spillie,0,0,0,,Anda sepatutnya menjadi milik saya.
Dialog: 0,0:43:54.05,0:43:56.32,Lalai,Spillik,0,0,0,,Dan saya milik awak.
Dialog: 0,0:44:44.34,0:44:46.17,Lalai,Spillik,0,0,0,,Adakah anda tahu siapa saya?
Dialog: 0,0:44:46.17,0:44:49.44,Lalai,Spillik,0,0,0,,Kim Hwan yang sama yang akan menjadi pegawai
Dialog: 0,0:44:49.61,0:44:50.88, Lalai, Spilyk,0,0,0,, Jabatan Detektif.
Dialog: 0,0:44:50.88,0:44:52.71,Lalai,Spillik,0,0,0,,Ia tidak mencukupi apa yang dia lakukan,
Dialog: 0,0:44:52.71,0:44:54.25, Lalai, Spikyulka,0,0,0,, memutuskan untuk tawar-menawar dengan janji temu masa depan anda?
Dialog: 0,0:44:54.25,0:44:55.31,Lalai,Spillik,0,0,0,,Tawar-menawar?
Dialog: 0,0:44:55.31,0:44:57.42,Lalai,Spillik,0,0,0,,Saya seorang lelaki yang soleh.
Dialog: 0,0:44:58.28,0:45:00.79,Lalai,Spillik,0,0,0,,Sungguh mengikut wajah dan bakat
Dialog: 0,0:45:00.79,0:45:04.09,Lalai,Spikyulka,0,0,0,,tak nampak ke saya ni pelajar Sungkyunkwan?
Dialog: 0,0:45:04.12,0:45:07.49,Lalai,Spillit,0,0,0,,Saya tidak akan mengalami ketidakadilan...
Dialog: 0,0:45:07.49,0:45:09.06,Lalai,Spillik,0,0,0,,Senyap di sini.
Dialog: 0,0:45:09.69,0:45:11.50,Default,Spillik,0,0,0,,Lihat, awak memang seorang yang cerewet.
Dialog: 0,0:45:11.50,0:45:14.43,Lalai,Spillik,0,0,0,,Beraninya awak? Jika anda melepaskan saya segera,
Dialog: 0,0:45:14.43,0:45:17.04,Lalai,Spiky,0,0,0,,Saya akan beri kamu lima nyan dalam perak.
Dialog: 0,0:45:17.10,0:45:18.57,Lalai,Spillik,0,0,0,,Atau anda boleh
Dialog: 0,0:45:20.91,0:45:22.57,Lalai,Spillik,0,0,0,,berikan kepada saya?
Dialog: 0,0:45:23.91,0:45:27.15,Lalai,Spillik,0,0,0,,Sebagai balasan, kami akan mengajar anda satu pengajaran yang tidak ternilai.
Dialog: 0,0:45:36.19,0:45:38.19,Lalai,Spillik,0,0,0,,Sebaik sahaja anda mendengar apa yang saya katakan,
Dialog: 0,0:45:40.83,0:45:44.00,Lalai,Spillik,0,0,0,,anda tidak lagi seperti dahulu.
Dialog: 0,0:45:45.56,0:45:48.97,Lalai,Spillik,0,0,0,,Anda akan menjadi benar-benar matang.
Dialog: 0,0:46:04.35,0:46:07.89,Lalai,Spillik,0,0,0,,-Adakah anda akan ke istana? \N-Ya. Adakah anda baru pulang ke rumah?
Dialog: 0,0:46:07.92,0:46:10.19,Lalai,Spillik,0,0,0,,Saya mendengar apa yang berlaku antara kamu dan raja semalam.
Dialog: 0,0:46:10.19,0:46:12.52,Lalai,Spillik,0,0,0,,Ya, saya faham.
Dialog: 0,0:46:12.52,0:46:14.69,Lalai,Spillik,0,0,0,,Walaupun dia tidak kelihatan hebat,
Dialog: 0,0:46:14.69,0:46:18.03,Lalai,Spillik,0,0,0,,jika anda memberi tekanan yang tinggi kepadanya, dia akan menjadi seorang.
Dialog: 0,0:46:18.03,0:46:20.36,Lalai,Spillik,0,0,0,,Kenapa awak bertindak tanpa arahan saya?
Dialog: 0,0:46:20.36,0:46:21.80,Lalai,Spillik,0,0,0,,Ini kerana...
Dialog: 0,0:46:22.40,0:46:24.07,Lalai,Spillit,0,0,0,,Matanya.
Dialog: 0,0:46:24.37,0:46:28.14,Lalai,Spillik,0,0,0,,Dia mempunyai mata seorang lelaki yang menyembunyikan aspirasinya.
Dialog: 0,0:46:31.21,0:46:34.78,Lalai,Spillit,0,0,0,,Saya tidak mahu ratu janda bimbang,
Dialog: 0,0:46:35.15,0:46:37.01,Lalai,Spillik,0,0,0,,jadi dia bertindak terburu-buru.
Dialog: 0,0:46:38.72,0:46:40.38,Lalai,Spillit,0,0,0,,Berhati-hati.
Dialog: 0,0:46:41.99,0:46:43.39,Lalai,Spillit,0,0,0,,Bapa.
Dialog: 0,0:46:45.96,0:46:50.03,Lalai,Spillik,0,0,0,,Adakah anda mengetahui keadaan permaisuri?
Dialog: 0,0:46:50.63,0:46:53.06,Lalai,Spilyk,0,0,0,,Saya dengar krisis sudah berakhir.
Dialog: 0,0:46:53.06,0:46:55.87,Lalai,Spillie,0,0,0,,Dia masih belum sedar.
Dialog: 0,0:46:56.07,0:46:58.90,Lalai,Spillie,0,0,0,,Tetapi ia akan menjadi lebih baik tidak lama lagi.
Dialog: 0,0:47:00.34,0:47:02.14,Lalai,Spillik,0,0,0,,Adakah anda ingin mengatakan apa-apa lagi?
Dialog: 0,0:47:02.37,0:47:04.64,Lalai,Spillit,0,0,0,,Saya mendengar ratu janda
Dialog: 0,0:47:04.64,0:47:06.34,Lalai,Spillik,0,0,0,,menyebut pemendapan ratu.
Dialog: 0,0:47:06.34,0:47:08.61,Lalai,Spillik,0,0,0,,Dia berkata ini dalam keadaan marah.
Dialog: 0,0:47:08.61,0:47:10.18,Lalai,Spillik,0,0,0,,Malah, dia tidak mahu ini.
Dialog: 0,0:47:10.18,0:47:12.48,Lalai,Spillik,0,0,0,,Anda tidak perlu risau.
Dialog: 0,0:47:13.05,0:47:16.89,Lalai,Spillik,0,0,0,,Saya tahu betul bagaimana anda mengambil berat tentang permaisuri.
Dialog: 0,0:47:16.89,0:47:18.52,Lalai,Spillik,0,0,0,,Mungkin tidak sebanyak anda,
Dialog: 0,0:47:18.52,0:47:21.93,Lalai,Spillik,0,0,0,,tetapi saya juga menjaganya dengan baik, jadi jangan risau.
Dialog: 0,0:47:22.93,0:47:24.33,Lalai,Spillik,0,0,0,,Ya.
Dialog: 0,0:47:24.60,0:47:26.23,Lalai,Spillik,0,0,0,,Jumpa di istana.
Dialog: 0,0:47:46.22,0:47:50.09,Lalai,Spillik,0,0,0,,Ayah permaisuri menghantar hadiah lagi.
Dialog: 0,0:47:50.89,0:47:53.22,Lalai,Spillik,0,0,0,,Apa khabar ratu?
Dialog: 0,0:47:53.66,0:47:55.49,Lalai,Spillit,0,0,0,,Krisis sudah berakhir,
Dialog: 0,0:47:55.49,0:47:58.23,Lalai,Spillik,0,0,0,,tetapi dia perlukan rehat buat masa ini,\Njadi dia pulang ke rumah.
Dialog: 0,0:47:58.23,0:48:00.60,Lalai,Spillie,0,0,0,,Dia sentiasa sakit.
Dialog: 0,0:48:00.90,0:48:02.97,Lalai,Spillik,0,0,0,,Dia tidak pernah pulih daripada kejadian itu.
Dialog: 0,0:48:02.97,0:48:04.67,Lalai,Spillik,0,0,0,,Apa yang perlu saya panggil?
Dialog: 0,0:48:04.97,0:48:06.90,Lalai,Spillie,0,0,0,,Dia rosak.
Dialog: 0,0:48:07.21,0:48:09.81,Lalai,Spillie,0,0,0,,Saya cuba biarkan dia menjadi lebih kuat,
Dialog: 0,0:48:09.81,0:48:13.51,Lalai,Spillie,0,0,0,,tetapi dia tiba-tiba menjadi sayur. \NSDia terlalu lemah.
Dialog: 0,0:48:13.85,0:48:16.78,Default,Spillit,0,0,0,,Bagaimana jika Gundik Cho melahirkan putera raja dahulu?
Dialog: 0,0:48:16.78,0:48:18.82,Lalai,Spillik,0,0,0,,Kemudian Ibu Permaisuri akan memberontak lagi.
Dialog: 0,0:48:18.82,0:48:20.45,Lalai,Spillik,0,0,0,,Jangan risau.
Dialog: 0,0:48:20.45,0:48:23.22,Lalai,Spilyk,0,0,0,,Saya telah menyediakan pelan sandaran.
Dialog: 0,0:48:23.45,0:48:24.72,Lalai,Spillit,0,0,0,,Pelan sandaran?
Dialog: 0,0:48:24.72,0:48:27.36,Lalai,Spillik,0,0,0,,Saya memastikan bahawa dua yang lain,\Nyang kami pertimbangkan untuk peranan ratu,
Dialog: 0,0:48:27.36,0:48:29.79,Lalai,Spilyk,0,0,0,,mereka tidak berkahwin dengan sesiapa pun.
Dialog: 0,0:48:29.79,0:48:33.03,Lalai,Spillik,0,0,0,,Anda adalah saudara yang boleh dipercayai.
Dialog: 0,0:48:34.40,0:48:39.10,Default,Spillik,0,0,0,,Saya dengar semalam Benin menuduh raja.
Dialog: 0,0:48:40.54,0:48:44.11,Default,Spillik,0,0,0,,Semalam semua orang berkelakuan pelik terhadap raja.
Dialog: 0,0:48:44.41,0:48:48.11,Lalai,Spillik,0,0,0,,Seolah-olah raja menyembunyikan sesuatu.
Dialog: 0,0:48:50.65,0:48:52.92,Lalai,Spillik,0,0,0,,Raja ini berbeza dengan si mati.
Dialog: 0,0:48:52.92,0:48:55.35,Lalai,Spillik,0,0,0,,Begitulah sepatutnya. Awak pilih sendiri.
Dialog: 0,0:48:55.35,0:48:58.99,Lalai,Spillik,0,0,0,,Saya mengangkat raja ke tempatnya hanya untuk satu sebab.
Dialog: 0,0:48:58.99,0:49:02.56,Lalai,Spillik,0,0,0,,Supaya anda tidak perlu membuat keputusan yang menyakitkan,
Dialog: 0,0:49:02.56,0:49:04.90,Lalai,Spillik,0,0,0,,kerana ia berada di bawah mendiang raja.
Dialog: 0,0:49:04.93,0:49:06.36,Lalai,Spillik,0,0,0,,Memang benar.
Dialog: 0,0:49:07.23,0:49:09.73,Lalai,Spillik,0,0,0,,Ia agak menyakitkan.
Dialog: 0,0:49:09.90,0:49:12.24,Lalai,Spillik,0,0,0,,Saya mempertahankan negara dengan kos darah cucu saya
Dialog: 0,0:49:12.24,0:49:14.07,Lalai,Spillie,0,0,0,,dalam pelukan saya.
Dialog: 0,0:49:14.47,0:49:16.07,Lalai,Spillik,0,0,0,,Dan jika seseorang berani memusnahkannya,
Dialog: 0,0:49:16.07,0:49:19.44,Lalai,Spillik,0,0,0,,dia tidak akan diampuni.
Dialog: 0,0:49:21.45,0:49:25.82,Lalai,Spilyk,0,0,0,,Jabatan detektif.
Dialog: 0,0:50:13.30,0:50:15.70,Lalai,Spillik,0,0,0,,-Mula-mula anda mesti.\N-Tidak, anda dahulu.
Dialog: 0,0:50:15.70,0:50:18.44,Lalai,Spillik,0,0,0,,Tidak, anda dahulu.
Dialog: 0,0:50:47.47,0:50:49.17,Lalai,Spillik,0,0,0,,Di manakah saya?
Dialog: 0,0:50:49.70,0:50:52.60,Lalai,Spillik,0,0,0,,Di Joseon atau di Korea?
Dialog: 0,0:50:58.94,0:51:00.58,Lalai,Spillik,0,0,0,,Di Joseon.
Dialog: 0,0:51:02.88,0:51:05.12,Lalai,Spillik,0,0,0,,Saya tidak boleh mengatakan bahawa saya gembira, kerana saya kehilangan mereka,
Dialog: 0,0:51:05.12,0:51:08.42,Lalai,Spillik,0,0,0,,tetapi saya tidak boleh mengatakan bahawa saya sedih, kerana saya gembira kerana saya dapat menyemaknya.
Dialog: 0,0:51:09.55,0:51:13.02,Lalai,Spillik,0,0,0,,Mengapa semuanya berkilauan di sini?
Dialog: 0,0:51:32.64,0:51:34.55,Lalai,Spillit,0,0,0,,Gold of the Empire.
Dialog: 0,0:51:34.68,0:51:36.45,Lalai,Spillie,0,0,0,,Inky?
Dialog: 0,0:51:39.75,0:51:41.22,Lalai,Spillik,0,0,0,,Yang Mulia!
Dialog: 0,0:51:43.82,0:51:46.79,Lalai,Spillik,0,0,0,,Nampaknya saya berada di tempat lain.
Dialog: 0,0:51:47.76,0:51:50.53,Lalai,Spillik,0,0,0,,Akhirnya, anda bangun!
Dialog: 0,0:51:51.00,0:51:52.63,Lalai,Spillik,0,0,0,,Ia seperti deja vu.
Dialog: 0,0:51:52.63,0:51:54.87,Lalai,Spillik,0,0,0,,Mari kita pergi tanpa keributan.
Dialog: 0,0:51:56.53,0:51:59.24,Lalai,Spillik,0,0,0,,Tetapi awak hampir mati.
Dialog: 0,0:51:59.24,0:52:01.51,Lalai,Spillik,0,0,0,,Malah mereka berhenti bernafas sepenuhnya.
Dialog: 0,0:52:02.97,0:52:04.71,Lalai,Spillie,0,0,0,,Jangan menangis.
Dialog: 0,0:52:05.64,0:52:07.14,Lalai,Spillie,0,0,0,,Berhenti bernafas?
Dialog: 0,0:52:07.38,0:52:09.68,Lalai,Spillit,0,0,0,,Menurut pakar perubatan diraja,\Nyou tiada sayur.
Dialog: 0,0:52:09.68,0:52:11.98,Lalai,Spillit,0,0,0,,Seolah-olah anda telah mati.
Dialog: 0,0:52:12.92,0:52:15.09,Lalai,Spillik,0,0,0,,Jadi di sini juga.
Dialog: 0,0:52:15.49,0:52:17.42,Lalai,Spillik,0,0,0,,Tetapi di manakah saya?
Dialog: 0,0:52:18.52,0:52:20.69,Lalai,Spillik,0,0,0,,Anda sudah pulang.
Dialog: 0,0:52:21.53,0:52:22.76,Lalai,Spillik,0,0,0,,Jadi,
Dialog: 0,0:52:22.76,0:52:24.66,Lalai,Spillik,0,0,0,,Saya tidak dapat mengelak daripada bertemu
Dialog: 0,0:52:24.66,0:52:27.06, Lalai, Spillik,0,0,0,,dengan seseorang yang tidak sepatutnya anda temui.
Dialog: 0,0:52:27.06,0:52:29.93,Lalai,Spillik,0,0,0,,-Apa? \N-Jadi, tiada kesulitan,
Dialog: 0,0:52:29.93,0:52:32.34,Lalai,Spikyulka,0,0,0,,tetapi ada seseorang yang saya rasa tidak selesa.
Dialog: 0,0:52:32.84,0:52:35.51,Lalai,Spillik,0,0,0,,Orang yang, pada dasarnya, adalah musuh saya yang sebenar -
Dialog: 0,0:52:36.61,0:52:38.51,Lalai,Spillik,0,0,0,,bapa kepada seorang wanita.
Dialog: 0,0:52:38.71,0:52:40.18,Lalai,Spillik,0,0,0,,Yang Mulia.
Dialog: 0,0:52:40.71,0:52:43.58,Lalai,Spillik,0,0,0,,-Alangkah bahagianya, ratu. \N-Tuhan.
Dialog: 0,0:52:43.58,0:52:47.69,Lalai,Spillik,0,0,0,,Yang Mulia, adakah anda sihat? Bolehkah anda bernafas?
Dialog: 0,0:52:47.69,0:52:50.29,Lalai,Spillik,0,0,0,,Apa yang anda pesan? Perlukah saya menghubungi doktor diraja?
Dialog: 0,0:52:50.29,0:52:53.06,Lalai,Spillik,0,0,0,,Nampaknya anda hampir tidak sedarkan diri.
Dialog: 0,0:52:53.19,0:52:55.69,Lalai,Spillie,0,0,0,,Sini, minum.
Dialog: 0,0:52:55.69,0:52:57.23,Lalai,Spillik,0,0,0,,Okey.
Dialog: 0,0:52:58.06,0:53:00.53,Lalai,Spillik,0,0,0,,Ini adalah herba untuk memulihkan tenaga yin.
Dialog: 0,0:53:00.53,0:53:02.10,Lalai,Spillik,0,0,0,,Cemerlang.
Dialog: 0,0:53:02.30,0:53:05.20,Lalai,Spilyk,0,0,0,,Kenapa awak berpeluh sangat?
Dialog: 0,0:53:07.84,0:53:09.34,Lalai,Spillik,0,0,0,,Syurga yang suci.
Dialog: 0,0:53:09.34,0:53:12.28,Lalai,Spillik,0,0,0,,Saya sangat risau.
Dialog: 0,0:53:12.28,0:53:15.08,Lalai,Spillik,0,0,0,,Saya tidak tidur semalam.
Dialog: 0,0:53:15.08,0:53:16.35,Lalai,Spillit,0,0,0,,Hilang selera makan saya sepenuhnya
Dialog: 0,0:53:16.35,0:53:18.52, Lalai, Spilyk,0,0,0,, dan saya tidak makan apa-apa selama dua hari.
Dialog: 0,0:53:18.52,0:53:22.12,Lalai,Spillik,0,0,0,,Setiap kali saya bangun, kepala saya berputar.
Dialog: 0,0:53:22.39,0:53:24.29,Lalai,Spillik,0,0,0,,-Anda pasti sangat terkejut. \N-Ya.
Dialog: 0,0:53:24.72,0:53:27.19,Lalai,Spillit,0,0,0,,Akar penyakit ialah kebimbangan dan masalah,
Dialog: 0,0:53:27.19,0:53:28.99,Lalai,Spillik,0,0,0,,anda perlu berehat dan bertenang.
Dialog: 0,0:53:28.99,0:53:31.96,Lalai,Spillik,0,0,0,,Ya, sudah tentu, saya akan melakukannya.
Dialog: 0,0:53:31.96,0:53:34.33,Lalai,Spillik,0,0,0,,Saya harap anda cepat sembuh. Sudah tiba masanya untuk saya pergi.
Dialog: 0,0:53:34.33,0:53:36.23,Lalai,Spillit,0,0,0,,Yang Mulia.
Dialog: 0,0:53:36.23,0:53:37.84,Lalai,Spillik,0,0,0,,Nak ke mana?
Dialog: 0,0:53:38.57,0:53:39.74, Lalai, Spilyk,0,0,0,, Orang kudus.
Dialog: 0,0:53:39.74,0:53:42.71,Lalai,Spillik,0,0,0,,Saya tidak boleh berbuat demikian. Saya perlu menunjukkan rasa hormat.
Dialog: 0,0:53:42.94,0:53:44.41,Lalai,Spillik,0,0,0,,Yang Mulia.
Dialog: 0,0:53:44.41,0:53:46.84,Lalai,Spillik,0,0,0,,Wah. awak buat apa? Awak memalukan saya.
Dialog: 0,0:53:46.84,0:53:48.51,Lalai,Spillik,0,0,0,,Tidak, tidak, saya tidak berani.
Dialog: 0,0:53:48.51,0:53:50.92,Lalai,Spillik,0,0,0,,Sila terima busur saya, Yang Mulia.
Dialog: 0,0:53:52.92,0:53:54.39,Lalai,Spillit,0,0,0,,Tidak!
Dialog: 0,0:53:56.65,0:53:57.96,Lalai,Spillik,0,0,0,,Lihat.
Dialog: 0,0:53:57.96,0:53:59.52,Lalai,Spillik,0,0,0,,Bagaimana?
Dialog: 0,0:54:00.19,0:54:03.03,Lalai,Spillik,0,0,0,,Izinkan saya tunduk kepada awak sekali lagi.
Dialog: 0,0:54:03.06,0:54:04.60,Lalai,Spillit,0,0,0,,Bapa.
Dialog: 0,0:54:04.63,0:54:07.43,Lalai,Spillik,0,0,0,,Menjadi ratu di Joseon sangat tidak selesa.
Dialog: 0,0:54:07.43,0:54:09.33,Lalai,Spillik,0,0,0,,Biar saya, sementara saya di sini,
Dialog: 0,0:54:09.33,0:54:13.24,Lalai,Spillik,0,0,0,,untuk menjadi anak perempuan anda Soyeon.
Dialog: 0,0:54:16.21,0:54:19.84, Lalai, hujung julat penangkapan,0,0,0,,Lebih tinggi kedudukan, lebih kuat kesepian.
Dialog: 0,0:54:20.71,0:54:22.21,Lalai,,0,0,0,,Baiklah, saya faham.
Dialog: 0,0:54:22.61,0:54:24.55, Lalai,,0,0,0,, Semasa anda berada di sini,
Dialog: 0,0:54:24.55,0:54:26.62, Lalai,,0,0,0,,Saya akan lakukan ini,
Dialog: 0,0:54:26.62,0:54:29.82, Lalai,,0,0,0,, mengikut kehendak anda.
Dialog: 0,0:54:30.52,0:54:32.29, Lalai,,0,0,0,,Baiklah, sekarang duduk.
Dialog: 0,0:54:32.56,0:54:35.36,Lalai,,0,0,0,,Okey. terima kasih.
Dialog: 0,0:54:36.29,0:54:38.13, Lalai,,0,0,0,, Berhati-hati.
Dialog: 0,0:54:44.87,0:54:48.74, Lalai,,0,0,0,,Tidak kira berapa banyak anda menghiasi bilik itu,\N ia masih kelihatan kosong.
Dialog: 0,0:54:49.11,0:54:53.51, Lalai,,0,0,0,,Tetapi sebaik sahaja anda kembali, bilik itu mula bersinar.
Dialog: 0,0:54:55.15,0:54:56.58, Lalai,,0,0,0,,Ya.
Dialog: 0,0:54:56.68,0:55:00.99,Lalai,,0,0,0,,Biliknya sangat terang sehingga membutakan mata anda.
Dialog: 0,0:55:01.89,0:55:03.69, Lalai,,0,0,0,,Saya sukakannya.
Dialog: 0,0:55:06.52,0:55:10.03, Lalai,,0,0,0,,Jangan risau, tiada apa yang akan mencemarkan reputasi anda.
Dialog: 0,0:55:10.09,0:55:12.70,Lalai,,0,0,0,,Saya uruskan semuanya.
Dialog: 0,0:55:12.80,0:55:15.93, Lalai,,0,0,0,,Saya telah menyediakan yang terbaik.
Dialog: 0,0:55:54.84,0:55:56.47, Lalai,,0,0,0,,Seterusnya, teruskan.
Dialog: 0,0:55:57.17,0:55:59.64, Lalai,,0,0,0,,Saya tidak berjumpa seorang doktor pun di sana,
Dialog: 0,0:55:59.64,0:56:01.55, Lalai,,0,0,0,, dan terdapat ramai orang di sini?
Dialog: 0,0:56:09.25,0:56:11.29, Lalai,,0,0,0,,Adakah orang lain sepatutnya datang?
Dialog: 0,0:56:11.29,0:56:14.33, Lalai,,0,0,0,,-Sesetengah cuti?\N-Ini sarapan pagi.
Dialog: 0,0:56:18.10,0:56:19.56, Lalai,,0,0,0,,Untuk memulihkan kekuatan
Dialog: 0,0:56:19.56,0:56:22.20,Lalai,,0,0,0,,ayah kamu sediakan sup penyu untuk kamu.
Dialog: 0,0:56:22.20,0:56:23.60, Lalai,,0,0,0,,Di sini.
Dialog: 0,0:56:26.17,0:56:28.27, Lalai,,0,0,0,,Penyu sejak pagi?
Dialog: 0,0:56:30.84,0:56:32.61, Lalai,,0,0,0,, Berhati-hati.
Dialog: 0,0:56:35.08,0:56:37.78, Lalai,,0,0,0,,Kenapa? apa yang ada?
Dialog: 0,0:56:38.35,0:56:40.15,Lalai,,0,0,0,,
Dialog: 0,0:56:47.93,0:56:51.16,Lalai,,0,0,0,,Adalah satu penghormatan untuk berkhidmat kepada Tuanku.
Dialog: 0,0:56:56.60,0:56:59.80, Lalai,,0,0,0,,Dia ialah pakar kecantikan terbaik di Joseon.
Dialog: 0,0:57:00.07,0:57:02.94, Lalai,,0,0,0,,Saya sememangnya cantik. Saya tidak perlukan bantuan dia.
Dialog: 0,0:57:05.11,0:57:06.71, Lalai,,0,0,0,, Teruskan.
Dialog: 0,0:57:16.75,0:57:19.32,Lalai,,0,0,0,,Panggilan untuk menggulingkan dan meracuni.
Dialog: 0,0:57:19.92,0:57:23.06,Lalai,,0,0,0,,Mereka melakukan segala-galanya untuk menyingkirkan Baginda.
Dialog: 0,0:57:23.06,0:57:24.66, Lalai,,0,0,0,,Jangan risau.
Dialog: 0,0:57:25.23,0:57:28.23,Lalai,,0,0,0,,Tidak kira betapa kerasnya mereka cuba membahayakan Baginda,
Dialog: 0,0:57:28.80,0:57:31.00, Lalai,,0,0,0,,Saya akan meningkatkan kuasa saya.
Dialog: 0,0:57:32.57,0:57:37.04,Lalai,,0,0,0,,Dengan abang seperti kamu, dia tidak perlu risau.
Dialog: 0,0:57:44.98,0:57:47.25,Lalai,,0,0,0,,Adakah anda biasa dengan bahan ini?
Dialog: 0,0:57:47.25,0:57:49.45,Lalai,,0,0,0,,Ini sutera biasa.
Dialog: 0,0:57:50.42,0:57:53.29,Lalai,,0,0,0,,Ada apa-apa dengan dia?
Dialog: 0,0:57:53.32,0:57:56.96,Lalai,,0,0,0,,Adakah anda memberi seseorang pakaian yang diperbuat daripada bahan ini?
Dialog: 0,0:57:58.36,0:58:01.37, Lalai,,0,0,0,,Selepas Baginda menjadi Ratu,
Dialog: 0,0:58:01.37,0:58:04.60, Lalai,,0,0,0,,Saya hanya menerima hadiah, saya tidak memberikannya sendiri.
Dialog: 0,0:58:05.07,0:58:08.94, Lalai,,0,0,0,,Satu-satunya orang yang saya tawarkan hadiah ialah Janda Permaisuri.
Dialog: 0,0:58:09.34,0:58:10.84, Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:58:12.21,0:58:14.11, Lalai,,0,0,0,,Tetapi anda tahu...
Dialog: 0,0:58:14.78,0:58:17.98, Lalai,,0,0,0,,Gudang saya telah dirompak dua kali baru-baru ini.
Dialog: 0,0:58:18.85,0:58:22.12, Lalai,,0,0,0,,Sutera itu mungkin ada.
Dialog: 0,0:58:22.12,0:58:24.66, Lalai,,0,0,0,,Adakah rumah anda telah diserang?
Dialog: 0,0:58:24.66,0:58:26.49, Lalai,,0,0,0,,Tidak, tidak.
Dialog: 0,0:58:27.09,0:58:29.89, Lalai,,0,0,0,,Adalah berbahaya untuk menyimpan semua barang berharga anda di satu tempat.
Dialog: 0,0:58:29.89,0:58:32.56, Lalai,,0,0,0,,Adalah lebih baik untuk meletakkannya di tempat yang berbeza.
Dialog: 0,0:58:32.56,0:58:34.63, Lalai,,0,0,0,,Saya mempunyai beberapa gudang.
Dialog: 0,0:58:35.40,0:58:40.90,Lalai,,0,0,0,,Tetapi perompak hanya memilih mereka yang mempunyai barang yang paling berharga.
Dialog: 0,0:58:44.44,0:58:47.61, Lalai,,0,0,0,,Memikirkannya, leher saya serta-merta menjadi kebas.
Dialog: 0,0:58:49.31,0:58:51.52, Lalai,,0,0,0,,Harta karun tercinta.
Dialog: 0,0:58:52.35,0:58:54.85,Lalai,,0,0,0,,Adakah mungkin untuk mengetahui antara yang dicuri
Dialog: 0,0:58:54.85,0:58:56.85, Lalai,,0,0,0,,ini sutera atau tidak?
Dialog: 0,0:58:58.12,0:58:59.79, Lalai,,0,0,0,,Terlalu banyak yang dicuri.
Dialog: 0,0:58:59.79,0:59:03.26, Lalai,,0,0,0,,Dan menyimpan rekod harta berharga adalah berbahaya.
Dialog: 0,0:59:04.19,0:59:06.36, Lalai,,0,0,0,,By the way...
Dialog: 0,0:59:08.90,0:59:11.20, Lalai,,0,0,0,,Jangan beritahu sesiapa tentang gudang.
Dialog: 0,0:59:11.20,0:59:14.10, Lalai,,0,0,0,,Tidak baik jika orang mengetahui tentang perkara ini.
Dialog: 0,0:59:14.57,0:59:15.97,Lalai,,0,0,0,,Saya faham.
Dialog: 0,0:59:16.67,0:59:22.18, Lalai,,0,0,0,,Tetapi kamu tidak pernah mendengar apa-apa yang pelik daripada bapa kamu?
Dialog: 0,0:59:23.38,0:59:25.28, Lalai,,0,0,0,,Adakah sesuatu berlaku?
Dialog: 0,0:59:27.15,0:59:31.69, Lalai,,0,0,0,,Seluruh situasi ini dengan Baginda: menyelamatkan raja dengan gundiknya
Dialog: 0,0:59:31.69,0:59:35.59,Lalai,,0,0,0,,dan hubungan yang rosak dengan permaisuri janda - membimbangkan saya.
Dialog: 0,0:59:36.26,0:59:39.83, Lalai,,0,0,0,,Saya mengalami mimpi buruk di mana dia digulingkan.
Dialog: 0,0:59:39.96,0:59:43.30,Lalai,,0,0,0,,Digulingkan? Mengapa anda berfikir tentang ini?
Dialog: 0,0:59:44.50,0:59:47.27,Lalai,,0,0,0,,Terdapat khabar angin bahawa salah seorang pesaing untuk ratu
Dialog: 0,0:59:47.30,0:59:50.14, Lalai,,0,0,0,,menyampaikan mesej rahsia.
Dialog: 0,0:59:50.34,0:59:54.01, Lalai,,0,0,0,,Adakah mungkin mereka mahu memilih ratu baharu?
Dialog: 0,0:59:54.88,0:59:58.95,Lalai,,0,0,0,,Saya sangat bimbang bahawa saya telah makan berlebihan hari ini.
Dialog: 0,1:00:00.48,1:00:03.72,Lalai,,0,0,0,,Mereka tidak akan meninggalkan Baginda.
Dialog: 0,1:00:04.32,1:00:06.49,Lalai,,0,0,0,,Betulkah?
Dialog: 0,1:00:06.99,1:00:12.66, Lalai,,0,0,0,,Saya harus cuba menghantar\N lebih banyak hadiah kepada Janda Ratu.
Dialog: 0,1:00:14.23,1:00:16.03,Lalai,,0,0,0,,Apakah perasaan anda?
Dialog: 0,1:00:16.03,1:00:17.50,Lalai,,0,0,0,,Apa?
Dialog: 0,1:00:17.80,1:00:20.57,Lalai,,0,0,0,,Ini bukan apa-apa. Saya akan ke sana tidak lama lagi...
Dialog: 0,1:00:21.37,1:00:23.54,Lalai,,0,0,0,,Tidak, mungkin tidak begitu pantas.
Dialog: 0,1:00:24.91,1:00:26.91,Lalai,,0,0,0,,Bagaimana ini boleh berlaku?
Dialog: 0,1:00:28.18,1:00:32.05,Lalai,,0,0,0,,Saya benar-benar terlupa bahawa saya tidak lagi muda, dan cuai.
Dialog: 0,1:00:36.52,1:00:39.92,Lalai,,0,0,0,,Saya tidak mempunyai masa untuk berseronok.
Dialog: 0,1:00:52.37,1:00:53.60,Lalai,,0,0,0,,Apakah perasaan anda?
Dialog: 0,1:00:53.60,1:00:55.64,Lalai,,0,0,0,,Saya kelihatan seperti anak patung.
Dialog: 0,1:00:55.64,1:00:57.14,Lalai,,0,0,0,,Hebat!
Dialog: 0,1:00:57.74,1:01:01.01,Lalai,,0,0,0,,Anda suka, bukan?
Dialog: 0,1:01:27.80,1:01:30.67,Lalai,,0,0,0,,Buku ini sudah ditumbuhi acuan.
Dialog: 0,1:01:31.61,1:01:33.91,Lalai,,0,0,0,,Bau busuk.
Dialog: 0,1:01:34.31,1:01:35.98,Lalai,,0,0,0,,Jika anda seorang lelaki,
Dialog: 0,1:01:35.98,1:01:38.45,Lalai,,0,0,0,,akan masuk ke istana selepas lulus peperiksaan negeri.
Dialog: 0,1:01:38.45,1:01:40.85,Lalai,,0,0,0,,Anda sangat seronok belajar.
Dialog: 0,1:01:42.42,1:01:44.32,Lalai,,0,0,0,,Siapa yang suka belajar ini?
Dialog: 0,1:01:44.32,1:01:46.79,Lalai,,0,0,0,,Saya cuba hanya untuk ayah saya.
Dialog: 0,1:01:47.69,1:01:50.09,Lalai,,0,0,0,,Ibu meninggal dunia, memberi saya kehidupan.
Dialog: 0,1:01:50.39,1:01:53.33,Lalai,,0,0,0,,Dan saya memutuskan bahawa saya perlu membayar balik untuk ini.
Dialog: 0,1:01:53.66,1:01:55.73,Lalai,,0,0,0,,Nampaknya itulah sebabnya anda walaupun pada waktu malam
Dialog: 0,1:01:55.73,1:01:59.00,Lalai,,0,0,0,,kami belajar bersungguh-sungguh pada hari lahir kami.
Dialog: 0,1:02:09.88,1:02:11.38,Lalai,,0,0,0,,Soyeon.
Dialog: 0,1:02:16.55,1:02:18.36,Lalai,,0,0,0,,Selamat hari lahir.
Dialog: 0,1:02:23.86,1:02:27.93,Lalai,,0,0,0,,Sebab pada hari lahir saya, kami teringat ibu saya,
Dialog: 0,1:02:29.83,1:02:31.94,Lalai,,0,0,0,,Saya tidak pernah tersenyum.
Dialog: 0,1:02:34.27,1:02:36.27,Lalai,,0,0,0,,Apa itu tadi?
Dialog: 0,1:02:36.54,1:02:37.97,Lalai,,0,0,0,,Yang Mulia.
Dialog: 0,1:02:38.48,1:02:42.15,Lalai,,0,0,0,,Kenangan anda kembali!
Dialog: 0,1:02:43.81,1:02:47.15,Lalai,,0,0,0,,Apa? Apakah kenangan ini yang seolah-olah menjadi milik saya, tetapi tidak sebenarnya?
Dialog: 0,1:02:57.96,1:02:59.73,Lalai,,0,0,0,,Kim Chanhyuk
Dialog: 0,1:02:59.93,1:03:03.10,Lalai,,0,0,0,,Keluar! pergi pergi!
Dialog: 0,1:03:03.30,1:03:04.33,Lalai,,0,0,0,,
Dialog: 0,1:03:04.33,1:03:07.50,Lalai,,0,0,0,,Kim Chanhyuk, Menteri Perang semasa.
Dialog: 0,1:03:07.77,1:03:10.14,Lalai,,0,0,0,,Dikumpul dengan sekumpulan tentera
Dialog: 0,1:03:10.34,1:03:12.24,Lalai,,0,0,0,,cukai perang yang terlalu tinggi.
Dialog: 0,1:03:14.34,1:03:17.28,Lalai,,0,0,0,,Kim Seok-kyn, penasihat kiri semasa.
Dialog: 0,1:03:17.31,1:03:18.68,Lalai,,0,0,0,,Bertanggungjawab untuk kewangan,
Dialog: 0,1:03:18.68,1:03:20.25,Lalai,,0,0,0,,melalui pertukaran bijirin
Dialog: 0,1:03:20.25,1:03:22.19,Lalai,,0,0,0,,sesuai dengan hadiah diraja.
Dialog: 0,1:03:23.02,1:03:25.49,Lalai,,0,0,0,,Kim Byung-hak, ahli majlis negeri semasa.
Dialog: 0,1:03:25.69,1:03:27.29,Lalai,,0,0,0,,Penjenayah cukai:
Dialog: 0,1:03:27.29,1:03:29.66,Lalai,,0,0,0,,berpakat dengan gabenor tempatan
Dialog: 0,1:03:29.76,1:03:31.66, Lalai,,0,0,0,,dan cukai tanah kosong.
Dialog: 0,1:03:35.40,1:03:37.00,Lalai,,0,0,0,,Kim Mungeun.
Dialog: 0,1:03:37.60,1:03:39.37,Lalai,,0,0,0,,Ayah Permaisuri.
Dialog: 0,1:03:39.57,1:03:41.10,Lalai,,0,0,0,,Inilah yang saya maksudkan.
Dialog: 0,1:03:46.24,1:03:48.11,Lalai,,0,0,0,,Bapa Permaisuri,
Dialog: 0,1:03:48.11,1:03:49.68,Lalai,,0,0,0,,ketua pengawal diraja.
Dialog: 0,1:03:49.68,1:03:51.38,Lalai,,0,0,0,,Pengilang terkenal,
Dialog: 0,1:03:51.38,1:03:54.48,Lalai,,0,0,0,,berurusan dengan segala-galanya daripada pinjaman beras kepada sistem cukai perang.
Dialog: 0,1:03:58.89,1:04:00.39,Lalai,,0,0,0,,Kim Jwageun.
Dialog: 0,1:04:01.49,1:04:03.19,Lalai,,0,0,0,,Komander tentera semasa.
Dialog: 0,1:04:17.74,1:04:19.04,Lalai,,0,0,0,,Pada kemuncak kuasanya,
Dialog: 0,1:04:19.04,1:04:22.35,Lalai,,0,0,0,,orang yang mengasaskan keseluruhan sistem rasuah ini.
Dialog: 0,1:04:25.85,1:04:27.28,Lalai,,0,0,0,,Rahsia
Dialog: 0,1:04:30.52,1:04:32.99,Lalai,,0,0,0,,
Dialog: 0,1:04:47.17,1:04:49.84,Lalai,,0,0,0,,Semua orang dalam istana mempunyai rahsia.
Dialog: 0,1:04:52.11,1:04:54.31,Lalai,,0,0,0,,Rahsia yang disembunyikan oleh pembohongan.
Dialog: 0,1:04:55.38,1:04:59.05,Lalai,,0,0,0,, Rahsia yang tidak boleh dilihat atau didengar.
Dialog: 0,1:04:59.95,1:05:01.99,Lalai,,0,0,0,, Rahsia menunggu saat yang sesuai.
Dialog: 0,1:05:08.12,1:05:10.76,Lalai,,0,0,0,,Untuk menyimpan rahsia jauh di dalam hati,
Dialog: 0,1:05:10.76,1:05:12.93,Lalai,,0,0,0,,
Dialog: 0,1:05:12.93,1:05:15.03,Lalai,,0,0,0,,Arahan awal untuk kanak-kanak
Dialog: 0,1:05:16.50,1:05:19.37,Lalai,,0,0,0,,kita semua memakai topeng.
Dialog: 0,1:05:21.81,1:05:24.47,Lalai,,0,0,0,,Cho Hwajin
Dialog: 0,1:06:09.22,1:06:11.35,Lalai,,0,0,0,,Tetapi rahsia
Dialog: 0,1:06:13.99,1:06:16.06,Lalai,,0,0,0,,pasti akan terbuka.
Dialog: 0,1:06:20.06,1:06:23.30,Lalai,,0,0,0,,
Dialog: 0,1:06:23.30,1:06:24.83,Lalai,,0,0,0,,
Dialog: 0,1:06:40.18,1:06:43.62,Lalai,,0,0,0,,{\i1}Yang Mulia, ingatan Tuanku telah kembali!{\i}
Dialog: 0,1:06:46.99,1:06:49.39,Lalai,,0,0,0,,{\i1}Semuanya keliru. Pergilah, wanita, pergilah!{\i}
Dialog: 0,1:06:49.39,1:06:52.43,Lalai,,0,0,0,,{\i1}Mengapa anda semakin pelik dan pelik?{\i}
Dialog: 0,1:06:52.43,1:06:55.03,Lalai,,0,0,0,,{\i1}Ada sesuatu yang saya belum beritahu sesiapa.{\i}
Dialog: 0,1:06:55.03,1:06:56.93,Lalai,,0,0,0,,{\i1}-Bantuan.\N-Bau lembap itu.{\i}
Dialog: 0,1:06:56.93,1:06:59.87,Lalai,,0,0,0,,{\i1}Banyak gudang telah dirompak di ibu negara baru-baru ini.{\i}
Dialog: 0,1:06:59.87,1:07:01.57,Lalai,,0,0,0,,{\i1}-Jadi apa?\N-Saya berminat,{\i}
Dialog: 0,1:07:01.57,1:07:03.84,Lalai,,0,0,0,,{\i1}mungkin ini cara anda menjana wang.{\i}
Dialog: 0,1:07:03.94,1:07:06.71,Lalai,,0,0,0,,{\i1}Hari ini kami akan menjelaskan semuanya.{\i}
Dialog: 0,1:07:06.71,1:07:08.58,Lalai,,0,0,0,,{\i1}Ini yang saya tunggu.{\i}
Dialog: 0,0:10:58.78,0:11:00.78,Lalai,,0,0,0,,

Komen: 0,0:06:11.92,0:06:14.02, Lalai, lily,0,0,0,, Keadaan apabila terdapat nadi, tetapi orang itu hampir tidak bernafas.
