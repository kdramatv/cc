Dialogue: 0,0:00:58.00,0:01:03.98,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДДСТА
Dialogue: 0,0:00:58.00,0:01:03.98,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807}\fscy2007 92 38 l 0 38
Dialogue: 0,0:00:58.00,0:01:03.98,nagtrabaho,,0,0,0,,{\pos(801,256)}Gumawa sa serye:\N Lily, Tiramisu, Biryulka, Pineapple, Host, February
Dialogue: 0,0:00:58.00,0:01:03.98,title,,0,0,0,,{\fscx75\fscy75\pos(846,392)}Paano ako naging
Dialogue: 0,0:00:58.00,0:01:03.98,pangalan,,0,0,0,,{\fscx75\fscy75\pos(848,456)}reyna
Dialogue: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialogue: 0,0:01:03.98,0:01:06.45,Default,lily,0,0,0,,Lahat ng character ay kathang-isip lang,
Dialogue: 0,0:01:06.45,0:01:09.06,Default,lily,0,0,0,,at ang mga kaganapang ipinakita ay fiction.
Dialogue: 0,0:01:14.50,0:01:16.53,Default,lily,0,0,0,,Wow.
Dialogue: 0,0:01:17.03,0:01:19.43,Default,lily,0,0,0,,Hindi ako makapaniwala na ang dakilang Jang Bong-hwan
Dialogue: 0,0:01:19.53,0:01:23.20,Default,lily,0,0,0,,kailangan mo ng ganoong bagay para mapanatili ang buhay.
Dialogue: 0,0:01:24.87,0:01:27.54,Default,lily,0,0,0,,Napakawalang halaga ng buhay, tama ba?
Dialogue: 0,0:01:28.84,0:01:31.71,Default,lily,0,0,0,,Na-motivate talaga ako.
Dialogue: 0,0:01:32.05,0:01:34.92,Default,lily,0,0,0,,Puwede ba akong maging lokal na \NSteve Jobs o Thomas Edison?
Dialogue: 0,0:01:35.75,0:01:37.28,Default,lily,0,0,0,,Hindi, binabawasan ko na. Kailangan natin ng isang mahusay.
Dialogue: 0,0:01:37.28,0:01:40.15,Default,lily,0,0,0,,Tagapagligtas ng sangkatauhan.
Dialogue: 0,0:01:49.13,0:01:51.50,Default,lily,0,0,0,,Sa katawan ng reyna nakaupo,
Dialogue: 0,0:01:53.03,0:01:56.30,Default,lily,0,0,0,,na hindi dapat naroroon.
Dialogue: 0,0:01:56.50,0:01:58.11,Default,lily,0,0,0,,Evil spirit.
Dialogue: 0,0:02:00.01,0:02:03.98,Default,lily,0,0,0,,Ang Reyna ay sinapian ng masamang espiritu!
Dialogue: 0,0:02:05.28,0:02:07.31,Default,lily,0,0,0,,Hindi kita kayang iwan ng ganito.
Dialogue: 0,0:02:07.38,0:02:09.78,Default,lily,0,0,0,,Umalis ka nang tuluyan.
Dialogue: 0,0:02:16.02,0:02:19.76,Default,lily,0,0,0,,Exactly, Carrier! Imbentor ng aircon!
Dialogue: 0,0:02:25.07,0:02:26.27,Default,lily,0,0,0,,Kamahalan!
Dialogue: 0,0:02:26.27,0:02:29.37,Default,lily,0,0,0,,Mamulat ka, Kamahalan! Halika na.
Dialogue: 0,0:02:29.37,0:02:30.84,Default,lily,0,0,0,,Kamahalan!
Dialogue: 0,0:02:36.24,0:02:39.68,Default,lily,0,0,0,,7 episode: Mask
Dialogue: 0,0:02:39.68,0:02:41.58,Default,lily,0,0,0,,-Sisingilin ng 100 joules.\N-Umalis.
Dialogue: 0,0:02:42.85,0:02:45.15,Default,lily,0,0,0,,Magdagdag ng epinephrine. Singilin para sa 150 joules.
Dialogue: 0,0:02:45.45,0:02:47.65,Default,lily,0,0,0,,-Sisingilin ng 150 joules.\N-Umalis.
Dialogue: 0,0:02:55.33,0:02:58.00,Default,lily,0,0,0,,-Live.\N-Darating ako.
Dialogue: 0,0:02:59.43,0:03:02.24,Default,lily,0,0,0,,Hindi ba ito ang lingkod ng reyna?
Dialogue: 0,0:03:02.97,0:03:06.11,Default,lily,0,0,0,,At sinusundan siya ng maharlikang doktor.
Dialogue: 0,0:03:10.58,0:03:13.51,Default,lily,0,0,0,,-Ano ang nangyari?\N-Kamahalan...
Dialogue: 0,0:03:24.86,0:03:27.36,Default,lily,0,0,0,,Kamahalan. Delikado!
Dialogue: 0,0:03:27.36,0:03:28.80,Default,lily,0,0,0,,Lord.
Dialogue: 0,0:03:32.13,0:03:33.60,Default,lily,0,0,0,,Kamahalan.
Dialogue: 0,0:03:33.90,0:03:37.97,Default,lily,0,0,0,,Napag-isipan ko na, nangungulit ako sayo para sa ikabubuti mo...
Dialogue: 0,0:03:37.97,0:03:39.64,Default,lily,0,0,0,,Kamahalan.
Dialogue: 0,0:03:41.68,0:03:43.11,Default,lily,0,0,0,,Kamahalan!
Dialogue: 0,0:03:44.38,0:03:45.65,Default,lily,0,0,0,,Ano ang nangyari dito?
Dialogue: 0,0:03:45.65,0:03:48.65,Default,lily,0,0,0,,Umalis na sila sa royal physician.
Dialogue: 0,0:03:49.05,0:03:50.45,Default,lily,0,0,0,,Kamahalan.
Dialogue: 0,0:03:50.52,0:03:53.22,Default,lily,0,0,0,,Hindi ka maaaring mamatay!
Dialogue: 0,0:03:53.22,0:03:56.19,Default,lily,0,0,0,,Huwag mo akong iwan!
Dialogue: 0,0:03:56.19,0:03:58.76,Default,lily,0,0,0,,Hindi na ako magmumura sayo.
Dialogue: 0,0:03:58.76,0:04:02.33,Default,lily,0,0,0,,Mamulat ka, Kamahalan.
Dialogue: 0,0:04:03.70,0:04:06.87,Default,lily,0,0,0,,Gumawa ka!
Dialogue: 0,0:04:07.23,0:04:09.57,Default,lily,0,0,0,,Kamahalan!
Dialogue: 0,0:04:09.57,0:04:10.57,Default,lily,0,0,0,,Hanguk University Hospital, Jang Bong Hwan
Dialogue: 0,0:04:10.57,0:04:12.17,Default,lily,0,0,0,,-Sisingilin ng 100 joules.\N-Tapos na.
Dialogue: 0,0:04:12.17,0:04:13.61,Default,lily,0,0,0,,Lumayo.
Dialogue: 0,0:04:16.44,0:04:18.18,Default,lily,0,0,0,,150 joules, tapos na.
Dialogue: 0,0:04:19.95,0:04:22.88,Default,lily,0,0,0,,-Bumalik na siya.\N-Ano ito?
Dialogue: 0,0:04:23.38,0:04:25.62,Default,lily,0,0,0,,Gaano kaliwanag. Anong ginagawa niya?
Dialogue: 0,0:04:25.65,0:04:27.85,Default,lily,0,0,0,, Normal ang pulso. pressure?
Dialogue: 0,0:04:27.89,0:04:29.32,Default,lily,0,0,0,,Normal din ang pressure.
Dialogue: 0,0:04:29.32,0:04:32.66,Default,lily,0,0,0,,Ospital? Bumalik na ba ako?
Dialogue: 0,0:04:32.79,0:04:34.56,Default,lily,0,0,0,,Balik. Bumalik ang katotohanan.
Dialogue: 0,0:04:34.56,0:04:37.56,Default,lily,0,0,0,,Jang Bong-hwan, namamatay ka.
Dialogue: 0,0:04:37.56,0:04:38.77,Default,lily,0,0,0,,Alam ko.
Dialogue: 0,0:04:38.77,0:04:41.60,Default,lily,0,0,0,,Akala ko ako ay makulong sa isang babaeng katawan sa buong buhay ko.
Dialogue: 0,0:04:41.60,0:04:43.14,Default,lily,0,0,0,,Ilang araw na ang lumipas?
Dialogue: 0,0:04:43.14,0:04:45.01,Default,lily,0,0,0,,Eksakto. Ilang araw ba akong nagsinungaling?
Dialogue: 0,0:04:45.01,0:04:46.61,Default,lily,0,0,0,,Napakabigat ng katawan.
Dialogue: 0,0:04:46.61,0:04:48.14,Default,lily,0,0,0,,Nakalipas ang isang linggo.
Dialogue: 0,0:04:48.14,0:04:50.41,Default,lily,0,0,0,,Nagdaan ang oras sa parehong paraan tulad ng sa Joseon.
Dialogue: 0,0:04:50.41,0:04:51.81,Default,lily,0,0,0,,Una, tulungan mo akong bumangon.
Dialogue: 0,0:04:51.81,0:04:54.25,Default,lily,0,0,0,,Siya ay walang malay sa loob ng isang linggo,
Dialogue: 0,0:04:54.65,0:04:56.18,Default,lily,0,0,0,,ngayon ay nasa vegetative state.
Dialogue: 0,0:04:56.18,0:04:59.19,Default,lily,0,0,0,,Ano ang ibig sabihin nito sa isang vegetative state?
Dialogue: 0,0:04:59.22,0:05:02.52,Default,lily,0,0,0,,Hoy Dr. Lee, ako ba ang tinutukoy mo?
Dialogue: 0,0:05:02.52,0:05:04.63,Default,lily,0,0,0,,Anong vegetative state, normal ba ako?
Dialogue: 0,0:05:04.63,0:05:05.76,Default,lily,0,0,0,,Ano ang sinasabi mo?
Dialogue: 0,0:05:05.76,0:05:07.83,Default,lily,0,0,0,,-Panoorin mo siya.\N-Oo.
Dialogue: 0,0:05:10.20,0:05:11.43,Default,lily,0,0,0,,Saan ka pupunta?
Dialogue: 0,0:05:11.43,0:05:13.57,Default,lily,0,0,0,,Bumalik! ayos lang ako!
Dialogue: 0,0:05:13.57,0:05:15.14,Default,lily,0,0,0,,Oo, para akong pipino!
Dialogue: 0,0:05:15.94,0:05:18.54,Default,lily,0,0,0,,Ano? Wala bang nakakarinig sa akin?
Dialogue: 0,0:05:18.54,0:05:21.21,Default,lily,0,0,0,,Nandito ako. nakabalik na ako.
Dialogue: 0,0:05:21.34,0:05:23.91,Default,lily,0,0,0,,Bumalik na si Jang Bong Hwan!
Dialogue: 0,0:05:24.18,0:05:26.65,Default,lily,0,0,0,,Kailan darating ang manggagamot?
Dialogue: 0,0:05:27.28,0:05:28.32,Default,lily,0,0,0,,Reyna!
Dialogue: 0,0:05:28.32,0:05:30.35,Default,lily,0,0,0,,-Kamahalan!\N-Kamahalan!
Dialogue: 0,0:05:30.75,0:05:33.62,Default,lily,0,0,0,,Reyna ko, gumising ka!
Dialogue: 0,0:05:34.45,0:05:36.32,Default,lily,0,0,0,,Ano ang nangyayari dito?
Dialogue: 0,0:05:36.62,0:05:40.26,Default,lily,0,0,0,,Bigla siyang tumalon,
Dialogue: 0,0:05:40.29,0:05:43.13,Default,lily,0,0,0,,pagkatapos ay namutla siya at nahulog.
Dialogue: 0,0:05:43.13,0:05:45.97,Default,lily,0,0,0,,Paano siya mahuhulog?
Dialogue: 0,0:05:45.97,0:05:47.40,Default,lily,0,0,0,,Marahil nalason.
Dialogue: 0,0:05:48.40,0:05:50.40,Default,lily,0,0,0,,Maaaring nalason siya!
Dialogue: 0,0:05:50.40,0:05:51.87,Default,lily,0,0,0,,Ano?
Dialogue: 0,0:05:52.84,0:05:55.71,Default,lily,0,0,0,,Hindi ito maaaring.
Dialogue: 0,0:05:55.71,0:05:57.31,Default,lily,0,0,0,,Maingat naming sinusubaybayan ang mga produkto,
Dialogue: 0,0:05:57.31,0:05:59.05,Default,lily,0,0,0,,bawal dito ang mga tagalabas,
Dialogue: 0,0:05:59.05,0:06:02.38,Default,lily,0,0,0,,at walang kumain ang reyna dito.
Dialogue: 0,0:06:02.78,0:06:05.02,Default,lily,0,0,0,,Kung gayon ano ang ginagawa niya dito?
Dialogue: 0,0:06:05.02,0:06:06.75,Default,lily,0,0,0,,Nagluto ka ba?
Dialogue: 0,0:06:07.12,0:06:08.79,Default,lily,0,0,0,,Oo.
Dialogue: 0,0:06:09.69,0:06:12.89,Default,lily,0,0,0,,Maaaring magkaroon siya ng lason
Dialogue: 0,0:06:12.89,0:06:15.46,Default,lily,0,0,0,,tikim ng mga pinggan, Kamahalan.
Dialogue: 0,0:06:15.90,0:06:19.07,Default,lily,0,0,0,,Hindi ka makatitiyak diyan.
Dialogue: 0,0:06:19.07,0:06:20.43,Default,lily,0,0,0,,Otolopy.
Dialogue: 0,0:06:20.43,0:06:22.60,Default,lily,0,0,0,,Lagi akong natatakot,
Dialogue: 0,0:06:22.60,0:06:25.61,Default,lily,0,0,0,,na may mangyayaring ganito.
Dialogue: 0,0:06:25.74,0:06:29.28,Default,lily,0,0,0,,At sa wakas nangyari na!
Dialogue: 0,0:06:29.38,0:06:32.45,Default,lily,0,0,0,,Nalason ba talaga siya?
Dialogue: 0,0:06:33.98,0:06:35.38,Default,lily,0,0,0,,I...
Dialogue: 0,0:06:35.58,0:06:37.42,Default,lily,0,0,0,,Titingnan ko siya.
Dialogue: 0,0:06:37.42,0:06:38.92,Default,lily,0,0,0,,Huwag mag-alinlangan.
Dialogue: 0,0:06:50.50,0:06:51.97,Default,lily,0,0,0,,Pulse
Dialogue: 0,0:06:52.50,0:06:55.10,Default,lily,0,0,0,,hindi tulad ng isang buhay.
Dialogue: 0,0:06:55.47,0:06:57.27,Default,lily,0,0,0,,Ano ang ibig sabihin nito?
Dialogue: 0,0:07:08.72,0:07:09.92,Default,lily,0,0,0,,Vegetative state.
Dialogue: 0,0:07:12.12,0:07:13.45,Default,lily,0,0,0,,Vegetative state?
Dialogue: 0,0:07:13.45,0:07:17.69,Default,lily,0,0,0,,Hindi makagalaw ang isang tao at parang gulay.
Dialogue: 0,0:07:19.19,0:07:21.73,Default,lily,0,0,0,,Ang kanyang dugo at qi\Nenergy ay natipon sa itaas na bahagi ng kanyang katawan,
Dialogue: 0,0:07:21.73,0:07:25.37,Default,lily,0,0,0,,umalis na ang espiritu sa katawan, at halos hindi na siya huminga.
Dialogue: 0,0:07:25.37,0:07:29.14,Default,lily,0,0,0,,Kung bumalik ang chi energy, mabubuhay siya. Kung hindi -
Dialogue: 0,0:07:31.34,0:07:33.21,Default,lily,0,0,0,,mamamatay siya.
Dialogue: 0,0:07:36.81,0:07:38.38,Default,lily,0,0,0,,Ano ang ibig sabihin ng mamatay?
Dialogue: 0,0:07:39.48,0:07:40.85,Default,lily,0,0,0,,Ano ang magagawa ko
Dialogue: 0,0:07:40.85,0:07:43.35,Default,lily,0,0,0,,ano ang gagawin para mailigtas siya?
Dialogue: 0,0:07:43.95,0:07:48.09,Default,lily,0,0,0,,Kailangan mong ibuhos ang hibiscus decoction at calamus juice sa kanyang bibig.
Dialogue: 0,0:07:48.09,0:07:49.46,Default,lily,0,0,0,,Chief Eunuch.
Dialogue: 0,0:07:49.46,0:07:51.09,Default,lily,0,0,0,,Dalhin agad ang lahat!
Dialogue: 0,0:07:51.09,0:07:52.49,Default,lily,0,0,0,,Oo, Kamahalan.
Dialogue: 0,0:07:52.49,0:07:54.86,Default,lily,0,0,0,,Tatagal pa ba ang Reyna?
Dialogue: 0,0:07:55.80,0:07:57.73,Default,lily,0,0,0,,Iyan ang problema.
Dialogue: 0,0:07:57.73,0:08:00.83,Default,lily,0,0,0,,Huwag kang tatayo diyan, gumawa ka!
Dialogue: 0,0:08:00.83,0:08:03.44,Default,lily,0,0,0,,Iligtas ang aming reyna.
Dialogue: 0,0:08:03.44,0:08:07.27,Default,lily,0,0,0,,Upang magawa ang isang bagay, kailangan mong ilipat ito.
Dialogue: 0,0:08:11.45,0:08:13.08,Default,lily,0,0,0,,Pumunta kami sa Daejojon hall.
Dialogue: 0,0:08:14.41,0:08:15.92,Default,lily,0,0,0,,Kamahalan.
Dialogue: 0,0:08:16.48,0:08:18.08,Default,lily,0,0,0,,Inang Reyna.
Dialogue: 0,0:08:18.45,0:08:22.02,Default,lily,0,0,0,,Kailangan nating paalisin ang masamang espiritu sa katawan ng reyna.
Dialogue: 0,0:08:22.32,0:08:24.16,Default,lily,0,0,0,,Hindi ka maaaring mag-alinlangan.
Dialogue: 0,0:08:24.62,0:08:27.23,Default,lily,0,0,0,,At paano ito gagawin?
Dialogue: 0,0:08:27.23,0:08:29.90,Default,lily,0,0,0,,Maglagay tayo ng mga nakakatakot na bagay sa paligid ng Daejojon hall\N
Dialogue: 0,0:08:29.90,0:08:31.90,Default,lily,0,0,0,,at harangan ang enerhiya.
Dialogue: 0,0:08:32.40,0:08:34.84,Default,lily,0,0,0,,At pagkatapos ay gagawin natin ang ritwal ng pagpapaalis ng espiritu.
Dialogue: 0,0:08:35.44,0:08:38.54,Default,lily,0,0,0,,Delikado ito. Ang ganitong ritwal ay hindi maaaring gawin sa palasyo.
Dialogue: 0,0:08:38.84,0:08:40.01,Default,lily,0,0,0,,Kung mahuli tayo...
Dialogue: 0,0:08:40.01,0:08:43.01,Default,lily,0,0,0,,Walang saysay na isagawa ang ritwal sa labas ng palasyo.
Dialogue: 0,0:08:43.34,0:08:47.41,Default,lily,0,0,0,,Upang maging matagumpay ang ritwal, gawin ito
Dialogue: 0,0:08:47.45,0:08:49.38,Default,lily,0,0,0,,kailangan malapit sa reyna.
Dialogue: 0,0:09:01.43,0:09:02.90,Default,lily,0,0,0,,Live.
Dialogue: 0,0:09:03.06,0:09:04.40,Default,lily,0,0,0,,Oo.
Dialogue: 0,0:09:04.40,0:09:07.13,Default,lily,0,0,0,,-Tapos na?\N-Oo, handa na ang lahat.
Dialogue: 0,0:09:20.18,0:09:22.42,Default,lily,0,0,0,,Ano ang nangyari?
Dialogue: 0,0:09:22.62,0:09:25.12,Default,lily,0,0,0,,Nagkaroon ng cardiac arrest ang pasyente.
Dialogue: 0,0:09:25.12,0:09:27.45,Default,lily,0,0,0,,Makinig. Dito. Tumingin dito.
Dialogue: 0,0:09:27.45,0:09:29.02,Default,lily,0,0,0,,Naririnig mo ba ako?
Dialogue: 0,0:09:32.16,0:09:33.46,Default,lily,0,0,0,,May sinabi ba siya?
Dialogue: 0,0:09:33.46,0:09:36.23,Default,lily,0,0,0,,Oo. Naririnig mo ba? alam ko na.
Dialogue: 0,0:09:36.23,0:09:39.37,Default,lily,0,0,0,,Naririnig at nakikita ko lahat, hindi ako gulay.
Dialogue: 0,0:09:41.00,0:09:42.10,Default,lily,0,0,0,,Talaga?
Dialogue: 0,0:09:42.10,0:09:43.40,Default,lily,0,0,0,,Nagsasalita ba talaga siya?
Dialogue: 0,0:09:43.40,0:09:44.60,Default,lily,0,0,0,,Siya ay maling akusado.
Dialogue: 0,0:09:44.60,0:09:46.81,Default,lily,0,0,0,,Hoy tanga, tanga.
Dialogue: 0,0:09:46.81,0:09:49.84,Default,lily,0,0,0,,-naririnig kita, tanga.\N-Sigurado akong ganoon ang nararamdaman niya.
Dialogue: 0,0:09:49.98,0:09:52.31,Default,lily,0,0,0,,Siya ay nasa gitna ng iskandalo sa pagitan ni Khan\N at ng Punong Ministro
Dialogue: 0,0:09:52.31,0:09:53.75,Default,lily,0,0,0,,at siya na ang sisisi sa kanyang sarili.
Dialogue: 0,0:09:53.75,0:09:55.22,Default,lily,0,0,0,,Ano ito?
Dialogue: 0,0:09:55.22,0:09:57.92,Default,lily,0,0,0,,The tricks of Director Khan?
Dialogue: 0,0:10:06.96,0:10:08.70,Default,lily,0,0,0,,Simulan ang paggamot.
Dialogue: 0,0:10:12.47,0:10:14.47,Default,lily,0,0,0,,Para siyang baliw,
Dialogue: 0,0:10:14.47,0:10:16.74,Default,lily,0,0,0,,pero malabong maipit sa kanya ang lahat.
Dialogue: 0,0:10:16.74,0:10:20.37,Default,lily,0,0,0,,Ano ang magagawa niya? Siya ay isang talo pa rin.
Dialogue: 0,0:10:20.37,0:10:22.74,Default,lily,0,0,0,,Ang pinakamagandang paraan para sa kanya ay ang magsinungaling dito.
Dialogue: 0,0:10:22.74,0:10:24.41,Default,lily,0,0,0,,Seryoso ka ba ngayon?
Dialogue: 0,0:10:24.41,0:10:27.55,Default,lily,0,0,0,,Sa lugar ko magsisinungaling ba sila at magdurusa?
Dialogue: 0,0:10:27.55,0:10:30.08,Default,lily,0,0,0,,Masasabi ba yan ng mga detective?
Dialogue: 0,0:10:32.55,0:10:34.02,Default,lily,0,0,0,,Ngayon
Dialogue: 0,0:10:34.15,0:10:37.79,Default,lily,0,0,0,,Ilalagay ko ang buhay ko sa linya at magpa-acupuncture.
Dialogue: 0,0:10:53.34,0:10:54.94,Default,lily,0,0,0,,Hindi ko siya hahayaang makawala dito.
Dialogue: 0,0:10:55.01,0:10:58.78,Default,lily,0,0,0,,Ang kontrabida na Direktor Khan.
Dialogue: 0,0:11:03.05,0:11:04.15,Default,pinya,0,0,0,,Mga Banal na Espiritu!
Dialogue: 0,0:11:04.15,0:11:07.12,Default,pinya,0,0,0,,Oo, kakagatin ko ang backbone niya!
Dialogue: 0,0:11:11.26,0:11:13.73,Default,pinya,0,0,0,,Ano ang nakakalimutan mo dito?
Dialogue: 0,0:11:17.93,0:11:18.93,Default,pinya,0,0,0,,Reyna!
Dialogue: 0,0:11:18.93,0:11:20.50,Default,pinya,0,0,0,,-Kamahalan!\N-Kamahalan!
Dialogue: 0,0:11:20.50,0:11:21.90,Default,pinya,0,0,0,,Kamahalan!
Dialogue: 0,0:11:21.94,0:11:25.47,Default,pinya,0,0,0,,Napakarami mo nang kain, \Nkalimutang mag-ingat!
Dialogue: 0,0:11:25.47,0:11:28.07,Default,pinya,0,0,0,,Ano ang imemeryenda mo diyan?
Dialogue: 0,0:11:36.98,0:11:39.75,Default,pineapple,0,0,0,,Tapos na ang pinakamasama.
Dialogue: 0,0:11:40.99,0:11:43.46,Default,pinya,0,0,0,,Pero bakit hindi siya nagising?
Dialogue: 0,0:11:43.62,0:11:45.49,Default,pinya,0,0,0,,Ang Reyna ay huminga muli,
Dialogue: 0,0:11:45.49,0:11:48.90,Default,pineapple,0,0,0,,pero hindi pa siya ganap na naiisip.
Dialogue: 0,0:11:49.36,0:11:51.70,Default,pinya,0,0,0,,Kailangan natin siyang bantayan,
Dialogue: 0,0:11:51.80,0:11:54.13,Default,pinya,0,0,0,,maaaring lumala ang reyna.
Dialogue: 0,0:11:55.24,0:11:57.40,Default,pinya,0,0,0,,Sa madaling salita, hindi pa tapos?
Dialogue: 0,0:11:57.40,0:11:58.94,Default,pinya,0,0,0,,Ngayong gabi
Dialogue: 0,0:11:59.31,0:12:00.97,Default,pineapple,0,0,0,,resolba ang lahat.
Dialogue: 0,0:12:11.42,0:12:14.49,Default,pinya,0,0,0,,Nagpunta ang hari sa Daejojong Hall.
Dialogue: 0,0:12:16.22,0:12:17.42,Default,pinya,0,0,0,,Bakit?
Dialogue: 0,0:12:17.42,0:12:19.79,Default,pinya,0,0,0,,Nawalan ng malay ang Reyna,
Dialogue: 0,0:12:20.06,0:12:22.90,Default,pineapple,0,0,0,,gusto niyang manatili sa tabi ng kanyang kama at alagaan siya.
Dialogue: 0,0:12:27.00,0:12:28.50,Default,pineapple,0,0,0,,Okay.
Dialogue: 0,0:12:28.67,0:12:30.60,Default,pinya,0,0,0,,Karapat-dapat baguhin...
Dialogue: 0,0:12:30.60,0:12:32.51,Default,pineapple,0,0,0,,Sabi ko ayos lang ang lahat.
Dialogue: 0,0:13:05.31,0:13:06.87,Default,pinya,0,0,0,,Tikom ang iyong bibig.
Dialogue: 0,0:13:07.37,0:13:10.24,Default,pineapple,0,0,0,,Alamin kung sino, ang iyong buhay ay nasa panganib.
Dialogue: 0,0:13:10.24,0:13:13.11,Default,pineapple,0,0,0,,Siyempre, naiintindihan ko ang lahat.
Dialogue: 0,0:13:18.02,0:13:23.02,Default,pinya,0,0,0,,Hindi ako makapaniwala na ang dalagang ito\Nis ay nasa ilalim ng court lady na si Choi.
Dialogue: 0,0:13:23.16,0:13:26.89,Default,pineapple,0,0,0,,Lahat ay magkakasama nang tama.
Dialogue: 0,0:13:27.63,0:13:31.43,Default,pinya,0,0,0,,Alam ko, nasa panig natin ang mga espiritu.
Dialogue: 0,0:13:31.43,0:13:33.40,Default,pinya,0,0,0,,Queen Mother, nandyan ka ba?
Dialogue: 0,0:13:45.51,0:13:47.75,Default,pinya,0,0,0,,Gusto kong magsagawa ng ritwal,
Dialogue: 0,0:13:47.75,0:13:49.92,Default,pineapple,0,0,0,,heto, naghahanda na ako para dito.
Dialogue: 0,0:13:49.92,0:13:52.75,Default,pineapple,0,0,0,,Walang seryoso, kaya maupo ka na.
Dialogue: 0,0:13:53.69,0:13:55.59,Default,pineapple,0,0,0,,Gusto kitang makausap.
Dialogue: 0,0:13:57.79,0:13:59.53,Default,pineapple,0,0,0,,Alam ko ang lahat.
Dialogue: 0,0:14:00.33,0:14:03.96,Default,pinya,0,0,0,,Hiniling mo sa iyong ama na iligtas ang reyna.
Dialogue: 0,0:14:04.16,0:14:06.30,Default,pinya,0,0,0,,Noong oras na sinabi mo,
Dialogue: 0,0:14:07.03,0:14:10.07,Default,pineapple,0,0,0,,na hindi ko kailangang kumilos mag-isa.
Dialogue: 0,0:14:10.07,0:14:12.51,Default,pinya,0,0,0,,-Totoo.\N-Pero ano
Dialogue: 0,0:14:13.54,0:14:15.64,Default,pinya,0,0,0,,kung may gusto akong gawin?
Dialogue: 0,0:14:17.38,0:14:18.81,Default,pinya,0,0,0,,Pagkatapos
Dialogue: 0,0:14:19.95,0:14:22.92,Default,pinya,0,0,0,,malampasan ko ba ang reyna?
Dialogue: 0,0:14:46.91,0:14:50.78,Default,pinya,0,0,0,,Magdamag ako, pwede ka na.
Dialogue: 0,0:14:51.81,0:14:54.71,Default,pinya,0,0,0,,Gabi na, natatakot ako kung paano ka
Dialogue: 0,0:14:54.71,0:14:56.55,Default,pineapple,0,0,0,,hindi rin sila nagkasakit.
Dialogue: 0,0:14:56.78,0:14:58.25,Default,pineapple,0,0,0,,Magiging maayos ang lahat.
Dialogue: 0,0:14:58.69,0:15:01.05,Default,pineapple,0,0,0,,Maaari kang pumunta.
Dialogue: 0,0:15:01.39,0:15:02.82,Default,pineapple,0,0,0,,Oo.
Dialogue: 0,0:15:15.27,0:15:18.74,Default,pineapple,0,0,0,,Wala pa akong tahimik na araw dito.
Dialogue: 0,0:15:19.01,0:15:22.24,Default,pinya,0,0,0,,Ang asawang kasama ko sa parehong kumot ay sinusubukan akong patayin.
Dialogue: 0,0:15:23.68,0:15:25.45,Default,pinya,0,0,0,,Manhid ka,
Dialogue: 0,0:15:25.45,0:15:26.98,Default,pineapple,0,0,0,,huwag mag-alinlangan at pindutin.
Dialogue: 0,0:15:26.98,0:15:28.48,Default,pinya,0,0,0,,Lumabas?
Dialogue: 0,0:15:28.58,0:15:30.52,Default,pinya,0,0,0,,Naglakas loob akong humingi ng tawad,
Dialogue: 0,0:15:30.52,0:15:32.85,Default,pinya,0,0,0,,at ito ang makukuha ko bilang tugon?
Dialogue: 0,0:15:33.02,0:15:35.62,Default,pinya,0,0,0,,Makinig, kung ang nangangailangan lang ng tawad ay
Dialogue: 0,0:15:35.62,0:15:37.29,Default,pinya,0,0,0,,na humihingi ng paumanhin, hindi ang tumatanggap sa kanila,
Dialogue: 0,0:15:37.29,0:15:38.76,Default,pinya,0,0,0,,apology ba ito?
Dialogue: 0,0:15:39.49,0:15:42.70,Default,pineapple,0,0,0,,Nawala ang sandali. Walang kwenta ang magsabi ng kahit ano.
Dialogue: 0,0:15:45.53,0:15:47.90,Default,pinya,0,0,0,,Umaasa ako
Dialogue: 0,0:15:48.27,0:15:50.80,Default,pineapple,0,0,0,,na magkakaroon ako ng pagkakataon na intindihin ka.
Dialogue: 0,0:15:57.41,0:16:01.58,Default,pineapple,0,0,0,,Ito ay isang napakamahal na tela.
Dialogue: 0,0:16:01.88,0:16:04.25,Default,pinya,0,0,0,,Kung ginamit ko ito,
Dialogue: 0,0:16:04.48,0:16:06.89,Default,pineapple,0,0,0,,Tatandaan ko sa natitirang bahagi ng aking buhay.
Dialogue: 0,0:16:06.89,0:16:08.39,Default,pinya,0,0,0,,Sigurado ka ba?
Dialogue: 0,0:16:09.72,0:16:12.63,Default,pinya,0,0,0,,Dalhan ka nila ng sutla para gawing
Dialogue: 0,0:16:12.63,0:16:14.69,Default,pineapple,0,0,0,,silk flowers para sa isang handaan.
Dialogue: 0,0:16:14.69,0:16:15.93,Default,pineapple,0,0,0,,Tama.
Dialogue: 0,0:16:15.93,0:16:19.40,Default,pinya,0,0,0,,At wala ka nang natitirang tela?
Dialogue: 0,0:16:20.60,0:16:23.00,Default,pinya,0,0,0,,Ang bagay ay,
Dialogue: 0,0:16:24.20,0:16:25.61,Default,pinya,0,0,0,,pinuno sa kusina,
Dialogue: 0,0:16:25.61,0:16:28.44,Default,pineapple,0,0,0,,Mr. Kim Moon-geun, kinuha ang tela.
Dialogue: 0,0:16:33.81,0:16:37.88,Default,pinya,0,0,0,,May katulad ba sa telang iyon?
Dialogue: 0,0:16:38.48,0:16:40.65,Default,pinya,0,0,0,,Ito ay...
Dialogue: 0,0:17:00.34,0:17:02.18,Default,pinya,0,0,0,,Nakita kong sinunog niya ang isang mahalagang bagay,
Dialogue: 0,0:17:02.18,0:17:05.35,Default,pineapple,0,0,0,,nakita itong kahina-hinala at inalis ito sa apoy.
Dialogue: 0,0:17:05.38,0:17:06.95,Default,pineapple,0,0,0,,Sigurado akong siya iyon.
Dialogue: 0,0:17:08.78,0:17:10.52,Default,pinya,0,0,0,,Prinsipe Yeonpyeong?
Dialogue: 0,0:17:18.29,0:17:20.69,Default,pinya,0,0,0,,May kinalaman ba dito ang hari?
Dialogue: 0,0:17:21.13,0:17:22.66,Default,pinya,0,0,0,,Ano ang sinabi mo?
Dialogue: 0,0:17:22.66,0:17:24.06,Default,pinya,0,0,0,,Queen Mother at Concubine Cho
Dialogue: 0,0:17:24.06,0:17:26.90,Default,pinya,0,0,0,,nagsasagawa ba sila ng ritwal nang magkasama sa loob ng mga dingding ng palasyo?
Dialogue: 0,0:17:26.97,0:17:28.37,Default,pineapple,0,0,0,,Tama.
Dialogue: 0,0:17:29.27,0:17:31.84,Default,pinya,0,0,0,,Akala ko may sapat na utak ang royal concubine para hindi masangkot dito,
Dialogue: 0,0:17:31.84,0:17:34.67,Default,pinya,0,0,0,,pero parang kapareho niya ang Inang Reyna.
Dialogue: 0,0:17:35.88,0:17:37.28,Default,pineapple,0,0,0,,Mas maganda pa iyan.
Dialogue: 0,0:17:37.28,0:17:40.41,Default,pinya,0,0,0,,Maaari kong turuan ang mga baliw na ito ng magandang aral.
Dialogue: 0,0:17:40.41,0:17:42.12,Default,pinya,0,0,0,,Kung pagsabihan mo sila sa ritwal
Dialogue: 0,0:17:42.12,0:17:44.62,Default,pineapple,0,0,0,,at anting-anting, magsisimula ang tsismis.
Dialogue: 0,0:17:45.28,0:17:47.49,Default,pineapple,0,0,0,,Ngunit hindi sila titigil.
Dialogue: 0,0:17:48.12,0:17:49.82,Default,pineapple,0,0,0,,Tama ka.
Dialogue: 0,0:17:50.06,0:17:53.53,Default,pineapple,0,0,0,,Sana magawa ko \Nisang bagay na mas malaki.
Dialogue: 0,0:17:55.93,0:17:58.93,Default,pinya,0,0,0,,Ito ang punong bating! May urgent news ako!
Dialogue: 0,0:17:58.93,0:18:00.33,Default,pineapple,0,0,0,,Pasok.
Dialogue: 0,0:18:06.01,0:18:07.57,Default,pinya,0,0,0,,Ano ang nangyari?
Dialogue: 0,0:18:07.77,0:18:12.18,Default,pinya,0,0,0,,Nawalan ng hininga ang reyna, wala siyang malay.
Dialogue: 0,0:18:13.35,0:18:15.01,Default,pinya,0,0,0,,Nawalan ng hininga?
Dialogue: 0,0:18:15.01,0:18:18.32,Default,pinya,0,0,0,,Ibinalik ng manggagamot ang kanyang hininga,
Dialogue: 0,0:18:18.32,0:18:20.72,Default,pineapple,0,0,0,,pero kailangan siyang bantayan buong gabi.
Dialogue: 0,0:18:20.72,0:18:23.02,Default,pinya,0,0,0,,Ano ang nangyari?
Dialogue: 0,0:18:23.02,0:18:28.90,Default,pinya,0,0,0,,May hinala na nalason ang reyna habang nagluluto sa kusina.
Dialogue: 0,0:18:35.90,0:18:38.87,Default,pinya,0,0,0,,Kim Soyeon
Dialogue: 0,0:18:42.91,0:18:45.51,Default,pinya,0,0,0,,
Dialogue: 0,0:19:14.57,0:19:16.94,Default,pinya,0,0,0,,Kung gusto mong lumaban ng buong puso,
Dialogue: 0,0:19:19.61,0:19:22.08,Default,pinya,0,0,0,,kung gusto mo siyang talunin ng buong puso,
Dialogue: 0,0:19:22.22,0:19:27.22,Default,pineapple,0,0,0,,mula ngayon\Hindi ka na dapat maglihim sa akin.
Dialogue: 0,0:19:30.79,0:19:32.63,Default,pinya,0,0,0,,Sumasang-ayon ka ba?
Dialogue: 0,0:19:34.36,0:19:37.70,Default,pineapple,0,0,0,,Oo, sumasang-ayon ako.
Dialogue: 0,0:19:40.70,0:19:43.14,Default,pinya,0,0,0,,Pagkatapos sabihin mo sa akin kung sulit ito
Dialogue: 0,0:19:43.14,0:19:45.97,Default,pinya,0,0,0,,alam ba ng hari kung ano ang nangyayari dito?
Dialogue: 0,0:19:55.82,0:19:57.92,Default,pinya,0,0,0,,Nais ng Hari
Dialogue: 0,0:19:58.89,0:20:01.05,Default,pineapple,0,0,0,,kapareho natin.
Dialogue: 0,0:20:15.70,0:20:18.04,Default,pinya,0,0,0,,Nakahinga ba siya?
Dialogue: 0,0:20:24.08,0:20:25.71,Default,pineapple,0,0,0,,Breathes.
Dialogue: 0,0:20:26.28,0:20:27.61,Default,pinya,0,0,0,,Pero kung natutulog siya,
Dialogue: 0,0:20:27.61,0:20:30.52,Default,pinya,0,0,0,,bakit ang tahimik niya?
Dialogue: 0,0:20:33.12,0:20:36.26,Default,pinya,0,0,0,,Ano ito? nasaktan ka ba
Dialogue: 0,0:20:36.32,0:20:38.16,Default,pinya,0,0,0,,Bakit?
Dialogue: 0,0:20:39.29,0:20:42.23,Default,pinya,0,0,0,,Palagi kang gusto ng anak na babae,
Dialogue: 0,0:20:42.83,0:20:45.50,Default,pinya,0,0,0,,masaya ka ba ngayon?
Dialogue: 0,0:20:47.67,0:20:50.14,Default,pinya,0,0,0,,Nasasaktan ka, naghihirap ka.
Dialogue: 0,0:20:51.00,0:20:53.44,Default,pinya,0,0,0,,Mas lalo mo pang nami-miss ang nanay mo ngayon.
Dialogue: 0,0:21:15.13,0:21:17.26,Default,pineapple,0,0,0,,Kaya mo lahat.
Dialogue: 0,0:21:18.00,0:21:21.27,Default,pineapple,0,0,0,,Magpagaling ka kaagad,\Nupang mapuno muli ng lakas at sigla.
Dialogue: 0,0:21:21.50,0:21:25.91,Default,pineapple,0,0,0,,Nangako ka sa akin na mabuhay\Nsusunod sa panuntunan ng social distancing.
Dialogue: 0,0:21:26.61,0:21:30.58,Default,pinya,0,0,0,,patatawarin kita at ang kakaiba mong pananalita,
Dialogue: 0,0:21:31.31,0:21:33.05,Default,pineapple,0,0,0,,at malaswang pag-uugali.
Dialogue: 0,0:21:37.42,0:21:39.59,Default,pineapple,0,0,0,,Kakagising mo lang.
Dialogue: 0,0:21:59.47,0:22:01.17,Default,pineapple,0,0,0,,Natutuwa akong hindi ka pa umaalis.
Dialogue: 0,0:22:01.17,0:22:02.98,Default,pinya,0,0,0,,Ano ito?
Dialogue: 0,0:22:02.98,0:22:05.75,Default,pineapple,0,0,0,,Ang reyna ay nasa vegetative state.
Dialogue: 0,0:22:06.15,0:22:08.58,Default,pinya,0,0,0,,Tumigil na ba siya sa paghinga?
Dialogue: 0,0:22:08.58,0:22:11.42,Default,pinya,0,0,0,,Mabuti na lang at ibinalik ito ng doktor sa kanya.
Dialogue: 0,0:22:12.29,0:22:15.79,Default,pineapple,0,0,0,,Gusto kong pumunta ka sa Seongwonjong Hall.
Dialogue: 0,0:22:16.89,0:22:19.16,Default,pinya,0,0,0,,May gustong saktan ang reyna?
Dialogue: 0,0:22:19.16,0:22:23.43,Default,pinya,0,0,0,,Sasaktan namin \N ang Inang Reyna at ang Concubine Cho.
Dialogue: 0,0:22:30.34,0:22:34.01,Default,pinya,0,0,0,,Umalis ka, masamang espiritu!
Dialogue: 0,0:22:34.01,0:22:37.68,Default,pinya,0,0,0,,Mga Diyos, makinig sa aking mga panalangin!
Dialogue: 0,0:22:37.68,0:22:42.78,Default,pinya,0,0,0,,Palayasin ang masamang espiritu!
Dialogue: 0,0:22:50.52,0:22:52.56,Default,pinya,0,0,0,,Anong ginagawa mo?
Dialogue: 0,0:22:53.46,0:22:56.73,Default,pineapple,0,0,0,,How dare you break in here?\NDHindi mo ba alam kung ano ang lugar na ito?
Dialogue: 0,0:22:56.73,0:22:59.10,Default,pinya,0,0,0,,Sa tingin mo makakatakas ka dito?
Dialogue: 0,0:23:06.57,0:23:09.41,Default,pineapple,0,0,0,,Itatanong ko rin sa iyo ang parehong bagay.\NDSa tingin mo ba ito ay banta sa buhay?
Dialogue: 0,0:23:09.41,0:23:11.61,Default,pinya,0,0,0,,reyna makakatakas ka?
Dialogue: 0,0:23:13.88,0:23:15.45,Default,pineapple,0,0,0,,-Ano ito?\N-Out of the way!
Dialogue: 0,0:23:15.45,0:23:18.15,Default,pinya,0,0,0,,-Anong ginagawa mo?\N-Hanapin lahat!
Dialogue: 0,0:23:19.85,0:23:21.49,Default,pinya,0,0,0,,Nakakatakot! anong ginagawa mo
Dialogue: 0,0:23:21.49,0:23:23.86,Default,pinya,0,0,0,,-Naku!\N-Nakakatakot!
Dialogue: 0,0:23:25.09,0:23:29.73,Default,pinya,0,0,0,,Nanalangin ako para sa isang mapayapang buhay sa palasyo!
Dialogue: 0,0:23:36.54,0:23:39.97,Default,pineapple,0,0,0,,Ang daga na ito ay natagpuan malapit sa Daejojeon Hall.
Dialogue: 0,0:23:40.11,0:23:43.11,Default,pineapple,0,0,0,,Wala akong kinalaman dito.
Dialogue: 0,0:23:43.98,0:23:46.85,Default,pinya,0,0,0,,Gusto mo bang sabihin na nag-iisang kumilos ang shaman?
Dialogue: 0,0:23:47.98,0:23:52.89,Default,pinya,0,0,0,,Mukhang hindi sinabi sa iyo ng iyong mga diyos kung kailan ka mamamatay.
Dialogue: 0,0:23:55.39,0:23:57.52,Default,pineapple,0,0,0,, Mangyayari ito ngayon.
Dialogue: 0,0:24:00.69,0:24:03.63,Default,pinya,0,0,0,,Pakiusap, iligtas mo ako.
Dialogue: 0,0:24:03.83,0:24:08.00,Default,pinya,0,0,0,,Sinusunod ko lang ang utos ng Inang Reyna.
Dialogue: 0,0:24:08.03,0:24:09.57,Default,pinya,0,0,0,,Tumahimik ka!
Dialogue: 0,0:24:11.07,0:24:15.57,Default,pinya,0,0,0,,Magsasagawa ako ng ritwal na sisira sa sumpa.
Dialogue: 0,0:24:16.21,0:24:18.68,Default,pinya,0,0,0,,Ritual na sisira sa sumpa?
Dialogue: 0,0:24:20.95,0:24:23.08,Default,pinya,0,0,0,,Naglilingkod ka sa Diyos, hindi sa iyong hari!
Dialogue: 0,0:24:23.08,0:24:25.35,Default,pinya,0,0,0,,Mukhang napagpasyahan mo na ang palasyo ay isang sirko!
Dialogue: 0,0:24:25.35,0:24:26.89,Default,pinya,0,0,0,,Lahat ay mali!
Dialogue: 0,0:24:27.09,0:24:28.25,Default,pineapple,0,0,0,,Late.
Dialogue: 0,0:24:28.25,0:24:30.76,Default,pinya,0,0,0,,Nasa panganib ang buhay ng reyna.
Dialogue: 0,0:24:32.56,0:24:33.86,Default,pineapple,0,0,0,,Hindi ito maaaring.
Dialogue: 0,0:24:33.86,0:24:35.73,Default,pineapple,0,0,0,,Ginawa mo ang ritwal.
Dialogue: 0,0:24:35.73,0:24:38.56,Default,pinya,0,0,0,,At ngayon hindi ka naniniwala sa mga kahihinatnan nito?
Dialogue: 0,0:24:39.70,0:24:41.23,Default,pinya,0,0,0,,Naloko ka ng scammer!
Dialogue: 0,0:24:41.23,0:24:43.17,Default,pinya,0,0,0,,Tingnan kung saan ito humantong!
Dialogue: 0,0:24:43.77,0:24:46.47,Default,pinya,0,0,0,,Dahil sa iyo, ang reputasyon ng buong dinastiya ay natapos na,
Dialogue: 0,0:24:46.47,0:24:48.34,Default,pinya,0,0,0,,sinubukan mong patayin ang reyna,
Dialogue: 0,0:24:48.34,0:24:49.61,Default,pinya,0,0,0,,at nakagawa din ng malubhang krimen,
Dialogue: 0,0:24:49.61,0:24:51.04,Default,pinya,0,0,0,,nakalilito tayong lahat!
Dialogue: 0,0:24:51.04,0:24:54.78,Default,pinya,0,0,0,,Paano mo babayaran ang iyong mga kasalanan?
Dialogue: 0,0:24:56.02,0:25:00.19,Default,pinya,0,0,0,,Pwede ko bang malaman ang kalagayan ng reyna?
Dialogue: 0,0:25:02.12,0:25:04.92,Default,pinya,0,0,0,,Pagpapanggap na hindi mo alam ang sagot?
Dialogue: 0,0:25:04.92,0:25:07.43,Default,pinya,0,0,0,,Well, sasabihin ko sa iyo kung ano ang nangyari sa reyna.
Dialogue: 0,0:25:07.86,0:25:09.40,Default,pinya,0,0,0,,Nalason siya.
Dialogue: 0,0:25:10.00,0:25:13.90,Default,pineapple,0,0,0,,May nakitang arsenic sa mga produkto sa kusina.
Dialogue: 0,0:25:16.34,0:25:17.80,Default,pineapple,0,0,0,,Arsenic.
Dialogue: 0,0:25:18.54,0:25:22.04,Default,pinya,0,0,0,,Sigurado akong alam mo kung anong uri ng lason ito.
Dialogue: 0,0:25:31.78,0:25:33.39,Default,pinya,0,0,0,,Sigurado ako,
Dialogue: 0,0:25:34.19,0:25:37.99,Default,pineapple,0,0,0,,mas marami kang alam tungkol sa kanya kaysa sa akin.
Dialogue: 0,0:25:40.03,0:25:42.19,Default,pinya,0,0,0,,At muli ay bumalik ka sa dating araw.
Dialogue: 0,0:25:42.60,0:25:46.70,Default,pinya,0,0,0,,Muli mo akong inakusahan na pumatay sa hari.
Dialogue: 0,0:25:49.74,0:25:53.91,Default,pinya,0,0,0,,Ang mga taong tanga na mabilis nakakalimutan ang nakaraan.
Dialogue: 0,0:25:54.61,0:25:58.68,Default,pinya,0,0,0,,Hindi alam kung gaano kahalaga ang isang buhay na nailigtas sa halaga ng buhay ng iyong sariling anak.
Dialogue: 0,0:26:03.78,0:26:05.75,Default,pinya,0,0,0,,Sa oras na iyon ay ikaw
Dialogue: 0,0:26:05.75,0:26:08.12,Default,pinya,0,0,0,,nakiusap sa akin.
Dialogue: 0,0:26:08.49,0:26:10.92,Default,pinya,0,0,0,,Sa halip na imbestigahan ang pagkamatay ng hari,
Dialogue: 0,0:26:10.92,0:26:12.39,Default,pinya,0,0,0,,nalason ng arsenic,
Dialogue: 0,0:26:12.39,0:26:15.26,Default,pinya,0,0,0,,tinanong mo sa akin ang buhay mo.
Dialogue: 0,0:26:17.66,0:26:19.40,Default,pinya,0,0,0,,At ano ang nakikita ko?
Dialogue: 0,0:26:19.40,0:26:23.27,Default,pinya,0,0,0,,Naakit mo ang inosenteng concubine na si Cho sa iyong maruruming ritwal at sinubukan mong lasunin ang reyna!
Dialogue: 0,0:26:23.37,0:26:26.77,Default,pinya,0,0,0,,Hindi ka ba nahihiya sa namatay na hari?
Dialogue: 0,0:26:27.74,0:26:29.84,Default,pinya,0,0,0,,Bagaman bakit magugulat, kung may konsensya ka,
Dialogue: 0,0:26:29.84,0:26:32.48,Default,pineapple,0,0,0,,namatay ka na sana pagkatapos niya.
Dialogue: 0,0:26:33.71,0:26:37.02,Default,pinya,0,0,0,,Walang silbi ang paghingi ng tawad.
Dialogue: 0,0:26:38.78,0:26:41.32,Default,pinya,0,0,0,,Mas alam mo kaysa kanino,
Dialogue: 0,0:26:41.39,0:26:43.92,Default,pineapple,0,0,0,,gaano ako nagkamali.
Dialogue: 0,0:26:43.92,0:26:46.56,Default,pineapple,0,0,0,,Dahil sa tingin mo, wala akong choice.
Dialogue: 0,0:26:46.56,0:26:47.96,Default,pinya,0,0,0,,Utos ko
Dialogue: 0,0:26:48.19,0:26:51.96,Default,pinya,0,0,0,,quarter the shaman and the court lady Khan!
Dialogue: 0,0:26:51.96,0:26:53.37,Default,pinya,0,0,0,,-Oo!\N-Oo!
Dialogue: 0,0:26:55.10,0:27:00.57,Default,pinya,0,0,0,,Pakiusap, iligtas mo ako!
Dialogue: 0,0:27:00.57,0:27:03.61,Default,pinya,0,0,0,,Bitawan mo ako!
Dialogue: 0,0:27:04.71,0:27:06.65,Default,pinya,0,0,0,,Para sa Inang Reyna...
Dialogue: 0,0:27:08.21,0:27:09.65,Default,pinya,0,0,0,,Pakiusap!
Dialogue: 0,0:27:11.72,0:27:13.32,Default,pinya,0,0,0,,Maawa ka!
Dialogue: 0,0:27:15.05,0:27:17.76,Default,pinya,0,0,0,,Pakiusap iligtas mo ako!
Dialogue: 0,0:27:17.76,0:27:20.36,Default,pinya,0,0,0,,Hindi makakatulong sa iyo ang mga panalangin sa oras na ito!
Dialogue: 0,0:27:20.36,0:27:24.30,Default,pinya,0,0,0,,Gaano katagal ako dapat pumikit sa iyong mga maling gawain?
Dialogue: 0,0:27:24.30,0:27:27.23,Default,pineapple,0,0,0,,Hindi ka na ganoon kadali sa pagkakataong ito!
Dialogue: 0,0:27:27.53,0:27:29.07,Default,pinya,0,0,0,,Nagkamali ako!
Dialogue: 0,0:27:29.23,0:27:32.47,Default,pinya,0,0,0,,Pakiusap bigyan mo ako ng pagkakataon
Dialogue: 0,0:27:32.47,0:27:34.34,Default,pinya,0,0,0,,atone!
Dialogue: 0,0:27:34.34,0:27:38.28,Default,pinya,0,0,0,,Paano mo tutubusin ang gayong matinding kasalanan?
Dialogue: 0,0:27:41.81,0:27:44.45,Default,pinya,0,0,0,,Sigurado ka
Dialogue: 0,0:27:45.72,0:27:47.19,Default,pinya,0,0,0,,na ang hari
Dialogue: 0,0:27:47.62,0:27:51.52,Default,pinya,0,0,0,,sumisumite sa iyo nang buong puso.
Dialogue: 0,0:27:52.06,0:27:54.96,Default,pinya,0,0,0,,Natitiyak mong nasa iyong kapangyarihan ang namatay na hari,
Dialogue: 0,0:27:54.96,0:27:58.46,Default,pinya,0,0,0,,kaya, nagbitiw sila bilang regent.
Dialogue: 0,0:27:58.56,0:28:00.53,Default,pinya,0,0,0,,O nakalimutan mo na ba?
Dialogue: 0,0:28:10.38,0:28:12.98,Default,fe,0,0,0,,Nakakaistorbo ka ba sa mga salita ng Inang Reyna?
Dialogue: 0,0:28:18.95,0:28:21.15,Default,fe,0,0,0,,Para sa iyong kapayapaan ng isip, susuriin ko,
Dialogue: 0,0:28:22.09,0:28:24.32,Default,fe,0,0,0,,anong klaseng tao ang Kanyang Kamahalan.
Dialogue: 0,0:28:33.63,0:28:35.77,Default,fe,0,0,0,,Anong ginagawa mo dito?
Dialogue: 0,0:28:38.34,0:28:39.81,Default,fe,0,0,0,,Kamahalan!
Dialogue: 0,0:28:47.91,0:28:49.28,Default,fe,0,0,0,,Ano ang lahat ng kaguluhan?
Dialogue: 0,0:28:49.28,0:28:51.45,Default,fe,0,0,0,,Isinasalin ko ang reyna.
Dialogue: 0,0:28:52.92,0:28:54.42,Default,fe,0,0,0,,Transporting?
Dialogue: 0,0:28:55.22,0:28:56.59,Default,fe,0,0,0,,Saan?
Dialogue: 0,0:28:57.12,0:28:59.02,Default,fe,0,0,0,,Hindi ko masabi sa iyo.
Dialogue: 0,0:29:11.20,0:29:14.51,Default,fe,0,0,0,,Hindi mo ba masabi sa akin kung saan mo dadalhin ang reyna?
Dialogue: 0,0:29:18.31,0:29:20.31,Default,fe,0,0,0,,May nangyari?
Dialogue: 0,0:29:20.81,0:29:22.41,Default,fe,0,0,0,,Mask of lies.
Dialogue: 0,0:29:22.41,0:29:26.62,Default,fe,0,0,0,,Ang reyna ay isinumpa sa Seongwonjong.
Dialogue: 0,0:29:26.99,0:29:28.45,Default,fe,0,0,0,,Ito ay ang Inang Reyna
Dialogue: 0,0:29:28.99,0:29:31.09,Default,fe,0,0,0,,at royal concubine na si Cho.
Dialogue: 0,0:29:33.06,0:29:36.13,Default,fe,0,0,0,,Hinding-hindi gagawin iyon ni Concubine Cho.
Dialogue: 0,0:29:36.70,0:29:40.10,Default,fe,0,0,0,,Gusto mo bang sabihin na ang dahilan ng pagkakasakit ng reyna ay isang sumpa?
Dialogue: 0,0:29:40.97,0:29:43.77,Default,fe,0,0,0,,Nakita ang arsenic sa royal kitchen.
Dialogue: 0,0:29:48.64,0:29:51.84,Default,fe,0,0,0,,Ngayon ang imbestigasyon ay isasagawa ng Detective Department.
Dialogue: 0,0:29:52.08,0:29:54.91,Default,fe,0,0,0,,Kaugnay nito, mayroon akong mga tanong para sa iyo.
Dialogue: 0,0:29:56.18,0:29:58.48,Default,fe,0,0,0,,Ano at saan mo ginawa kay Prince Yeonpyeong
Dialogue: 0,0:29:58.98,0:30:02.52,Default,fe,0,0,0,,sa gabi pagkatapos ng royal wedding?
Dialogue: 0,0:30:04.42,0:30:07.09,Default,fe,0,0,0,,Ano ang pinapayagan mo sa iyong sarili?
Dialogue: 0,0:30:07.23,0:30:09.73,Default,fe,0,0,0,,Ipakita ang iyong totoong mukha.
Dialogue: 0,0:30:09.73,0:30:12.16,Default,fe,0,0,0,,Malamang ang iyong memorya ay nabigo sa iyo.
Dialogue: 0,0:30:12.97,0:30:16.47,Default,fe,0,0,0,,Kung ganito ang kaso, kailangan kong pormal na tanungin ang prinsipe.
Dialogue: 0,0:30:21.11,0:30:23.01,Default,fe,0,0,0,,Hindi isang hakbang pa!
Dialogue: 0,0:30:26.88,0:30:28.31,Default,fe,0,0,0,,Kamahalan.
Dialogue: 0,0:30:39.22,0:30:41.66,Default,fe,0,0,0,,Mangyaring huwag gumalaw.
Dialogue: 0,0:30:42.13,0:30:46.33,Default,fe,0,0,0,,Kung hindi ay kailangang\Ndi-gagalang at saktan ka ng iyong mga tanod.
Dialogue: 0,0:31:03.68,0:31:05.25,Default,fe,0,0,0,,Stop.
Dialogue: 0,0:31:06.35,0:31:07.92,Default,fe,0,0,0,,Ito ang utos ng hari.
Dialogue: 0,0:31:12.52,0:31:14.23,Default,fe,0,0,0,,Ito ang babae ko.
Dialogue: 0,0:31:16.40,0:31:19.60,Default,fe,0,0,0,,Hipuin siya ng kahit isang daliri,
Dialogue: 0,0:31:20.10,0:31:22.77,Default,fe,0,0,0,,at puputulin ng espadang ito ang iyong lalamunan.
Dialogue: 0,0:31:30.21,0:31:34.11,Default,fe,0,0,0,,Hindi ko alam na mahal na mahal ka ng reyna.
Dialogue: 0,0:31:34.45,0:31:36.85,Default,fe,0,0,0,,Hindi mo alam ang maraming bagay.
Dialogue: 0,0:31:38.02,0:31:40.29,Default,fe,0,0,0,,Turuan kita ng leksyon.
Dialogue: 0,0:31:54.93,0:31:56.67,Default,fe,0,0,0,,Nakikita mo ba ako?
Dialogue: 0,0:32:01.37,0:32:04.51,Default,fe,0,0,0,,Ako ang hari ng bansang ito!
Dialogue: 0,0:32:07.31,0:32:09.85,Default,fe,0,0,0,,Kaninong mga mandirigma ka?
Dialogue: 0,0:32:11.42,0:32:13.22,Default,fe,0,0,0,,Bantayan ko.
Dialogue: 0,0:32:14.45,0:32:16.69,Default,fe,0,0,0,,Lumayo.
Dialogue: 0,0:32:29.64,0:32:31.14,Default,fe,0,0,0,,Kamahalan.
Dialogue: 0,0:32:35.14,0:32:37.24,Default,fe,0,0,0,,Hindi ba ito pagtataksil?
Dialogue: 0,0:32:38.08,0:32:39.98,Default,fe,0,0,0,,Alisin ang iyong mga tao,
Dialogue: 0,0:32:40.21,0:32:43.42,Default,fe,0,0,0,,kung ayaw mong dumanak ang dugo sa Daejojon.
Dialogue: 0,0:32:43.48,0:32:46.62,Default,fe,0,0,0,,Kung utos mo, Prinsipe Yeonpyeong
Dialogue: 0,0:32:46.62,0:32:49.99,Default,fe,0,0,0,,masayang madudumihan ang kanyang mga kamay.
Dialogue: 0,0:32:51.09,0:32:53.56,Default,fe,0,0,0,,May mga tanong lang ako sa iyo.
Dialogue: 0,0:32:53.76,0:32:55.93,Default,fe,0,0,0,,Dumating ka sa oras.
Dialogue: 0,0:32:59.03,0:33:01.93,Default,fe,0,0,0,,Hindi ko inutusan na magsimula ang imbestigasyon.
Dialogue: 0,0:33:03.84,0:33:08.17,Default,fe,0,0,0,,Kanino ngayon nag-uulat ang Detective Department?
Dialogue: 0,0:33:13.51,0:33:16.21,Default,fe,0,0,0,,Pag-aaralan ko muna ang bagay na ito.
Dialogue: 0,0:33:18.05,0:33:21.05,Default,fe,0,0,0,,At hindi mo na muling maakusahan ang inosente.
Dialogue: 0,0:33:21.05,0:33:24.32,Default,fe,0,0,0,,Ang reyna lang ang inosente dito!
Dialogue: 0,0:33:25.19,0:33:27.13,Default,fe,0,0,0,,Sinabi ko na sa iyo.
Dialogue: 0,0:33:27.13,0:33:31.00,Default,fe,0,0,0,,Pahirapan mo siya,\Nand magiging torture din ang buhay mo.
Dialogue: 0,0:33:32.53,0:33:37.10,Default,fe,0,0,0,,Sinabi ko na hindi ito banta.\Ngunit kailangan kong bawiin ang aking mga salita.
Dialogue: 0,0:33:37.10,0:33:38.74,Default,fe,0,0,0,,How dare you!
Dialogue: 0,0:33:49.28,0:33:53.02,Default,fe,0,0,0,,Hindi mo na pinsan ang babaeng ito.
Dialogue: 0,0:33:54.19,0:33:56.22,Default,fe,0,0,0,,Ang kaligayahan niya,
Dialogue: 0,0:33:56.59,0:33:59.86,Default,fe,0,0,0,,kalungkutan at kaligtasan ay alalahanin na ngayon
Dialogue: 0,0:34:00.33,0:34:03.03,Default,fe,0,0,0,,hindi ang pinuno ng Detective Department - ikaw,
Dialogue: 0,0:34:03.56,0:34:05.23,Default,fe,0,0,0,,at sa akin.
Dialogue: 0,0:34:10.27,0:34:12.67,Default,fe,0,0,0,,Ihahatid ang Reyna sa tahanan ng kanyang pamilya.
Dialogue: 0,0:34:15.87,0:34:17.94,Default,fe,0,0,0,,Ihanda ang palanquin.
Dialogue: 0,0:34:18.44,0:34:19.85,Default,fe,0,0,0,,-Oo.\N-Oo.
Dialogue: 0,0:34:31.39,0:34:32.86,Default,fe,0,0,0,,Aalis.
Dialogue: 0,0:34:43.77,0:34:45.30,Default,fe,0,0,0,,Late na ako.
Dialogue: 0,0:34:45.30,0:34:46.74,Default,fe,0,0,0,,Grabe ka
Dialogue: 0,0:34:47.74,0:34:49.84,Default,fe,0,0,0,,sinubukang itago ang bahaging ito ng kanilang mga sarili.
Dialogue: 0,0:35:12.03,0:35:13.80,Default,fe,0,0,0,,Bantayan siyang mabuti.
Dialogue: 0,0:35:14.03,0:35:15.43,Default,fe,0,0,0,,Oo.
Dialogue: 0,0:35:15.60,0:35:17.77,Default,fe,0,0,0,,Paumanhin sa pag-iiwan sa iyo.
Dialogue: 0,0:35:31.28,0:35:34.12,Default,fe,0,0,0,,Mag-ingat hanggang sa dumating ka.
Dialogue: 0,0:35:34.25,0:35:36.79,Default,fe,0,0,0,,At magbantay buong gabi pagdating.
Dialogue: 0,0:35:36.79,0:35:38.29,Default,fe,0,0,0,,Oo!
Dialogue: 0,0:35:53.61,0:35:57.78,Default,fe,0,0,0,,Pusta ako na lahat maliban sa akin ay makakapag-exhale sa palasyo.
Dialogue: 0,0:35:58.18,0:36:01.55,Default,fe,0,0,0,,At bakit ito nagpapagaan sa iyong pakiramdam?
Dialogue: 0,0:36:04.22,0:36:07.85,Default,fe,0,0,0,,Teka, dapat nandito na si Kim Hwan.
Dialogue: 0,0:36:10.06,0:36:11.69,Default,fe,0,0,0,,At narito ang diyablo mismo.
Dialogue: 0,0:36:15.13,0:36:16.63,Default,fe,0,0,0,,Nag-aalala na ako na hindi tayo magkikita
Dialogue: 0,0:36:16.63,0:36:18.50,Default,fe,0,0,0,,bago ako umalis...
Dialogue: 0,0:36:20.00,0:36:21.50,Default,fe,0,0,0,,At sino ito?
Dialogue: 0,0:36:22.73,0:36:25.94,Default,fe,0,0,0,,Ngayon nakahanap ako ng isang mabuting kaibigan.
Dialogue: 0,0:36:25.94,0:36:29.31,Default,fe,0,0,0,,Ito si Lee Senban.
Dialogue: 0,0:36:29.31,0:36:32.48,Default,fe,0,0,0,,Nagkita kami noong hinahanap ko ang kaibigan kong si Lee Senman.
Dialogue: 0,0:36:33.11,0:36:37.05,Default,fe,0,0,0,,Nakatakda tayong maging magkaibigan.
Dialogue: 0,0:36:37.62,0:36:39.75,Default,fe,0,0,0,,Gusto kong makipag-inuman kasama ka
Dialogue: 0,0:36:40.02,0:36:42.05,Default,fe,0,0,0,,at maglaro ng mga baraha.
Dialogue: 0,0:36:42.59,0:36:44.99,Default,fe,0,0,0,,Gusto mo ba ng tavern dito o ano?
Dialogue: 0,0:36:45.22,0:36:48.46,Default,fe,0,0,0,,Uminom at maglaro ng baraha? Anong klaseng tao ka?
Dialogue: 0,0:36:48.46,0:36:51.50,Default,fe,0,0,0,,Ano? Yan ang ginagawa namin dito.
Dialogue: 0,0:36:51.50,0:36:53.83,Default,fe,0,0,0,,Ikaw lang ang makakagawa nito.
Dialogue: 0,0:36:53.83,0:36:56.57,Default,fe,0,0,0,,Para sa iyo lang, Kim Hwan.
Dialogue: 0,0:36:57.97,0:37:00.51,Default,fe,0,0,0,,-Para sa iyo lang.\N-Ano?
Dialogue: 0,0:37:01.11,0:37:04.28,Default,fe,0,0,0,,Hindi ko alam na napakadaling mainteresan ka.
Dialogue: 0,0:37:04.41,0:37:07.75,Default,fe,0,0,0,,Napakadali ba para sa iyo na makipagkaibigan?\NDMayroon ka bang higit sa kanila kaysa sa iyong naisin?
Dialogue: 0,0:37:07.75,0:37:10.25,Default,fe,0,0,0,,Malamang, isa ako sa mga kaibigan mo noong gabi,
Dialogue: 0,0:37:10.25,0:37:13.49,Default,fe,0,0,0,,isa sa marami mong kaibigan.
Dialogue: 0,0:37:46.35,0:37:49.59,Default,fe,0,0,0,,Well, pinauwi mo ba ang kaibigan mong si Lee Senban?
Dialogue: 0,0:37:49.59,0:37:51.32,Default,fe,0,0,0,,Pinapatawag ka sa palasyo.
Dialogue: 0,0:37:52.19,0:37:53.63,Default,fe,0,0,0,,Ano?
Dialogue: 0,0:37:59.30,0:38:01.33,Default,fe,0,0,0,,Bakit walang tao ngayon?
Dialogue: 0,0:38:01.93,0:38:06.61,Default,fe,0,0,0,,Napunta na ba ang lahat upang tumingin\N sa isang bagay na kawili-wili nang wala ako?
Dialogue: 0,0:38:09.17,0:38:12.14,Default,fe,0,0,0,,Feeling na inabandona ako ng lahat.
Dialogue: 0,0:38:22.12,0:38:24.52,Default,fe,0,0,0,,Lee Senman, buhay ka!
Dialogue: 0,0:38:24.52,0:38:26.86,Default,fe,0,0,0,,Sa wakas nakilala na!
Dialogue: 0,0:38:31.30,0:38:34.93,Default,fe,0,0,0,,Nagkamali ako, nalito kita sa isang kaibigan.
Dialogue: 0,0:38:35.47,0:38:36.97,Default,fe,0,0,0,,Paumanhin.
Dialogue: 0,0:38:39.90,0:38:42.17,Default,fe,0,0,0,,Hindi mo ako kaibigan.
Dialogue: 0,0:38:42.54,0:38:45.21,Default,fe,0,0,0,,Ngunit mayroon akong isang bagay na kawili-wili.
Dialogue: 0,0:38:53.25,0:38:56.89,Default,fe,0,0,0,,Ano ang mga bagay na ito? Kakaiba ang itsura nila.
Dialogue: 0,0:38:56.89,0:38:58.42,Default,fe,0,0,0,,Ito...
Dialogue: 0,0:39:01.56,0:39:03.16,Default,fe,0,0,0,,Hindi pa inaalis ang curfew.
Dialogue: 0,0:39:03.16,0:39:05.86,Default,fe,0,0,0,,-Bakit ka nasa kalye?\N-Magtago.
Dialogue: 0,0:39:08.00,0:39:09.50,Default,fe,0,0,0,,Ikaw...
Dialogue: 0,0:39:10.34,0:39:13.64,Default,fe,0,0,0,,Hindi sapat ang isang palo?
Dialogue: 0,0:39:13.64,0:39:15.71,Default,fe,0,0,0,,Nagbebenta ka na naman ba ng mga librong may kahalayan?
Dialogue: 0,0:39:15.71,0:39:17.11,Default,fe,0,0,0,,Indecency?
Dialogue: 0,0:39:19.58,0:39:22.91,Default,fe,0,0,0,,Siya ang gustong ibenta sa akin.
Dialogue: 0,0:39:23.65,0:39:25.28,Default,fe,0,0,0,,Ikaw ay inakusahan ng paglabag sa moralidad.
Dialogue: 0,0:39:25.28,0:39:26.85,Default,fe,0,0,0,,Alisin sila.
Dialogue: 0,0:39:26.85,0:39:28.15,Default,fe,0,0,0,,Oo.
Dialogue: 0,0:39:28.15,0:39:30.92,Default,fe,0,0,0,,-Teka lang, ako...\N-Bitawan mo ako.
Dialogue: 0,0:39:30.92,0:39:32.66,Default,fe,0,0,0,,-Wait.\N-Stop.
Dialogue: 0,0:39:32.66,0:39:34.53,Default,fe,0,0,0,,-Maaari kang maging mas malumanay.\N-Narito si Herodes.
Dialogue: 0,0:39:34.53,0:39:36.53,Default,fe,0,0,0,,Pwede bang mas malumanay ka, natatakot ako.
Dialogue: 0,0:39:36.53,0:39:40.10,Default,fe,0,0,0,,Nagtanong siya partikular tungkol sa gabi pagkatapos ng kasal.
Dialogue: 0,0:39:40.40,0:39:42.67,Default,fe,0,0,0,,Kaya sinabi sa kanya ng reyna ang lahat.
Dialogue: 0,0:39:42.67,0:39:46.00,Default,fe,0,0,0,,Parang kakaiba sa akin na nanahimik siya ng napakatagal.
Dialogue: 0,0:39:46.00,0:39:48.64,Default,fe,0,0,0,,Kung alam niya na sinubukan kong patayin siya,
Dialogue: 0,0:39:48.91,0:39:51.04,Default,fe,0,0,0,,hindi sana tatapusin ng isang interogasyon ang usapin.
Dialogue: 0,0:39:51.18,0:39:54.65,Default,fe,0,0,0,,Sa araw ng kanyang appointment, binasa niya ang kasabihan:
Dialogue: 0,0:39:54.65,0:39:56.95,Default,fe,0,0,0,,"Pagliligtas sa imperyo mula sa hindi pagkakasundo,
Dialogue: 0,0:39:57.12,0:39:59.28,Default,fe,0,0,0,,power strikes fear into the king."
Dialogue: 0,0:39:59.28,0:40:00.82,Default,fe,0,0,0,,Tiwala sa sarili na pabo.
Dialogue: 0,0:40:00.82,0:40:03.42,Default,fe,0,0,0,,Nagbanta siya na kukunin niya ang iyong trono.
Dialogue: 0,0:40:03.42,0:40:07.16,Default,fe,0,0,0,,Kung handa siyang pumunta ng ganoon kalayo,\Dapat nakagat mo ang dila mo.
Dialogue: 0,0:40:07.16,0:40:08.66,Default,fe,0,0,0,,At pagkatapos
Dialogue: 0,0:40:08.66,0:40:10.93,Default,fe,0,0,0,,patuloy niya sana ang pressure sa Kanyang Kamahalan.
Dialogue: 0,0:40:11.13,0:40:13.40,Default,fe,0,0,0,,Ang Kanyang Kamahalan ay maghahayag ng kanyang sarili sa anumang kaso.
Dialogue: 0,0:40:13.40,0:40:14.97,Default,fe,0,0,0,,Smart guy.
Dialogue: 0,0:40:15.90,0:40:18.40,Default,fe,0,0,0,,Siguro may nahanap siya.
Dialogue: 0,0:40:18.60,0:40:21.21,Default,fe,0,0,0,,Aalamin ko kung gaano niya kakilala.
Dialogue: 0,0:40:21.97,0:40:26.18,Default,fe,0,0,0,,Sa ngayon ay umaasa na lang tayo na magigising na ang reyna.
Dialogue: 0,0:40:26.41,0:40:30.01,Default,fe,0,0,0,,Ito ang pinakamahalagang bagay para sa lahat.
Dialogue: 0,0:40:30.01,0:40:31.35,Default,fe,0,0,0,,Kumusta naman ang pagsasanay?
Dialogue: 0,0:40:31.35,0:40:33.32,Default,fe,0,0,0,,Hinahanap ni Kim Byonin ang ating mga ulo.
Dialogue: 0,0:40:33.32,0:40:35.89,Default,fe,0,0,0,,Kailangan ng higit pang pagsisikap.
Dialogue: 0,0:40:35.92,0:40:38.92,Default,fe,0,0,0,,Kaunti na lang ang natitirang oras.
Dialogue: 0,0:40:39.92,0:40:41.36,Default,fe,0,0,0,,God.
Dialogue: 0,0:40:41.59,0:40:43.43,Default,fe,0,0,0,,Itaas ang lantern.
Dialogue: 0,0:40:53.81,0:40:55.71,Default,fe,0,0,0,,Gaano kalayo ang Her Majesty?
Dialogue: 0,0:40:55.77,0:40:56.81,Default,fe,0,0,0,,Papunta na siya rito.
Dialogue: 0,0:40:56.81,0:40:59.31,Default,fe,0,0,0,,Sigurado ka bang wala siya sa bingit ng kamatayan?
Dialogue: 0,0:40:59.88,0:41:01.68,Default,fe,0,0,0,,Oo, buti na lang, naging maayos ang lahat.
Dialogue: 0,0:41:01.68,0:41:03.18,Default,fe,0,0,0,,Oh aking Diyos.
Dialogue: 0,0:41:03.75,0:41:05.72,Default,fe,0,0,0,,Paano ito mangyayari?
Dialogue: 0,0:41:06.15,0:41:08.99,Default,fe,0,0,0,,Nalason? Paano siya nalason?
Dialogue: 0,0:41:09.12,0:41:12.92,Default,fe,0,0,0,,Natawagan ko na ang pinakamahusay na mga doktor ng Joseon.
Dialogue: 0,0:41:13.59,0:41:15.06,Default,fe,0,0,0,,God.
Dialogue: 0,0:41:15.39,0:41:18.20,Default,fe,0,0,0,,Gayunpaman,\N kailangan mong manatiling kalmado.
Dialogue: 0,0:41:19.76,0:41:23.40,Default,fe,0,0,0,,Kailangan mong huminahon at mag-isip nang makatwiran.
Dialogue: 0,0:41:24.67,0:41:26.07,Default,fe,0,0,0,,Ano ito.
Dialogue: 0,0:41:26.54,0:41:28.71,Default,fe,0,0,0,,God.
Dialogue: 0,0:41:29.37,0:41:32.88,Default,fe,0,0,0,,Oh aking Diyos.
Dialogue: 0,0:41:33.28,0:41:35.05,Default,fe,0,0,0,,Gaano kalupit.
Dialogue: 0,0:41:35.08,0:41:37.12,Default,fe,0,0,0,,Nalason ang asawa ng Inang Reyna.
Dialogue: 0,0:41:37.12,0:41:38.88,Default,fe,0,0,0,,Paano mo siya masisisi?
Dialogue: 0,0:41:38.88,0:41:40.22,Default,fe,0,0,0,,Mahirap ang sitwasyon,
Dialogue: 0,0:41:40.22,0:41:43.56,Default,fe,0,0,0,,Hwajin, lumayo ka sa Inang Reyna.
Dialogue: 0,0:41:43.69,0:41:45.46,Default,fe,0,0,0,,Nangyari ito sa araw ng aking pagbisita.
Dialogue: 0,0:41:45.46,0:41:47.33,Default,fe,0,0,0,,Binigyan ko sila ng pagkakataon.
Dialogue: 0,0:41:47.33,0:41:49.13,Default,fe,0,0,0,,Huwag kang magpatalo tungkol dito.
Dialogue: 0,0:41:49.33,0:41:51.56,Default,fe,0,0,0,,Gagawin pa rin sana nila.
Dialogue: 0,0:41:52.10,0:41:53.53,Default,fe,0,0,0,,Ngunit
Dialogue: 0,0:41:54.37,0:41:57.50,Default,fe,0,0,0,,bakit mo pinabalik ang reyna sa bahay ng kanyang ama?
Dialogue: 0,0:41:57.50,0:41:59.84,Default,fe,0,0,0,,Malamang nag-iisa siya sa palasyo.
Dialogue: 0,0:41:59.87,0:42:02.24,Default,fe,0,0,0,,Sa isang panaginip tinawag niya ang kanyang ina.
Dialogue: 0,0:42:03.34,0:42:06.78,Default,fe,0,0,0,,Ngunit napanaginipan ito ng Her Majesty.
Dialogue: 0,0:42:07.71,0:42:09.11,Default,fe,0,0,0,,Tungkol saan?
Dialogue: 0,0:42:09.31,0:42:11.12,Default,fe,0,0,0,,May mali?
Dialogue: 0,0:42:13.55,0:42:16.72,Default,fe,0,0,0,,-Hindi.\N-Huwag kang mag-alala.
Dialogue: 0,0:42:16.75,0:42:19.99,Default,fe,0,0,0,,Ipapadala ko ang kapatid ko kapag napagdesisyunan na ang lahat.
Dialogue: 0,0:42:26.16,0:42:27.60,Default,Spillik,0,0,0,,Kamahalan.
Dialogue: 0,0:42:34.84,0:42:36.31,Default,Spillik,0,0,0,,Nakikiusap ako sa iyo.
Dialogue: 0,0:42:36.54,0:42:38.91,Default,Spillik,0,0,0,,Labag ka ba sa kalooban ng hari?
Dialogue: 0,0:42:44.78,0:42:46.48,Default,Spillik,0,0,0,,Pakiusap huwag masaktan.
Dialogue: 0,0:42:48.89,0:42:50.29,Default,Spillik,0,0,0,,Okay.
Dialogue: 0,0:43:05.44,0:43:07.34,Default,Spillik,0,0,0,,Ngayong nandito ka na,
Dialogue: 0,0:43:08.24,0:43:10.81,Default,Spillik,0,0,0,,parang bumalik tayo sa nakaraan.
Dialogue: 0,0:43:13.28,0:43:14.71,Default,Spillik,0,0,0,,Benin.
Dialogue: 0,0:43:18.55,0:43:22.15,Default,Spillik,0,0,0,,Ikaw lang ang naghahanap sa akin kapag tumakas ako.
Dialogue: 0,0:43:22.65,0:43:24.89,Default,Spillik,0,0,0,,Hindi ko hahayaang mawala ka sa sarili mo.
Dialogue: 0,0:43:26.96,0:43:28.99,Default,Spillik,0,0,0,,At hindi ko malilimutan.
Dialogue: 0,0:43:32.66,0:43:34.90,Default,Spillik,0,0,0,,Kung maibabalik ko lang ang araw na iyon.
Dialogue: 0,0:43:41.24,0:43:43.07,Default,Spillik,0,0,0,,Ito ang aking babae.
Dialogue: 0,0:43:49.18,0:43:51.45,Default,Spillie,0,0,0,,Dapat naging akin ka.
Dialogue: 0,0:43:54.05,0:43:56.32,Default,Spillik,0,0,0,,At ako ay sa iyo.
Dialogue: 0,0:44:44.34,0:44:46.17,Default,Spillik,0,0,0,,Kilala mo pa ba kung sino ako?
Dialogue: 0,0:44:46.17,0:44:49.44,Default,Spillik,0,0,0,,Ang parehong Kim Hwan na malapit nang maging opisyal
Dialogue: 0,0:44:49.61,0:44:50.88,Default,Spilyk,0,0,0,,Detective Department.
Dialogue: 0,0:44:50.88,0:44:52.71,Default,Spillik,0,0,0,,Hindi sapat ang ginawa niya,
Dialogue: 0,0:44:52.71,0:44:54.25,Default,Spikyulka,0,0,0,,nagpasya na makipag-bargain sa iyong appointment sa hinaharap?
Dialogue: 0,0:44:54.25,0:44:55.31,Default,Spillik,0,0,0,,Bargain?
Dialogue: 0,0:44:55.31,0:44:57.42,Default,Spillik,0,0,0,,Ako ay isang matuwid na tao.
Dialogue: 0,0:44:58.28,0:45:00.79,Default,Spillik,0,0,0,,Talagang ayon sa mukha at talento
Dialogue: 0,0:45:00.79,0:45:04.09,Default,Spikyulka,0,0,0,,hindi mo ba nakikita na estudyante ako ni Sungkyunkwan?
Dialogue: 0,0:45:04.12,0:45:07.49,Default,Spillit,0,0,0,,Hindi ako magdaranas ng kawalang-katarungan...
Dialogue: 0,0:45:07.49,0:45:09.06,Default,Spillik,0,0,0,,Tumahimik ka dito.
Dialogue: 0,0:45:09.69,0:45:11.50,Default,Spillik,0,0,0,,Tingnan mo, napakadaldal mong lalaki.
Dialogue: 0,0:45:11.50,0:45:14.43,Default,Spillik,0,0,0,,How dare you? Kung pinakawalan mo ako kaagad,
Dialogue: 0,0:45:14.43,0:45:17.04,Default,Spiky,0,0,0,,Bibigyan kita ng limang nyan sa silver.
Dialogue: 0,0:45:17.10,0:45:18.57,Default,Spillik,0,0,0,,O kaya mo
Dialogue: 0,0:45:20.91,0:45:22.57,Default,Spillik,0,0,0,,ibigay mo sa akin?
Dialogue: 0,0:45:23.91,0:45:27.15,Default,Spillik,0,0,0,,Bilang kapalit, ituturo namin sa iyo ang isang napakahalagang aral.
Dialogue: 0,0:45:36.19,0:45:38.19,Default,Spillik,0,0,0,,Sa sandaling marinig mo ang sinasabi ko,
Dialogue: 0,0:45:40.83,0:45:44.00,Default,Spillik,0,0,0,,hindi ka na magiging kung ano ka dati.
Dialogue: 0,0:45:45.56,0:45:48.97,Default,Spillik,0,0,0,,Magiging tunay kang mature.
Dialogue: 0,0:46:04.35,0:46:07.89,Default,Spillik,0,0,0,,-Pupunta ka ba sa palasyo? \N-Oo. Kakauwi mo lang ba?
Dialogue: 0,0:46:07.92,0:46:10.19,Default,Spillik,0,0,0,,Narinig ko ang nangyari sa pagitan mo at ng hari kahapon.
Dialogue: 0,0:46:10.19,0:46:12.52,Default,Spillik,0,0,0,,Oo, naiintindihan ko.
Dialogue: 0,0:46:12.52,0:46:14.69,Default,Spillik,0,0,0,,Kahit hindi siya maganda,
Dialogue: 0,0:46:14.69,0:46:18.03,Default,Spillik,0,0,0,,kung pipilitin mo siya ng sobra, magiging isa siya.
Dialogue: 0,0:46:18.03,0:46:20.36,Default,Spillik,0,0,0,,Bakit ka kumilos nang wala ang utos ko?
Dialogue: 0,0:46:20.36,0:46:21.80,Default,Spillik,0,0,0,,Ito ay dahil...
Dialogue: 0,0:46:22.40,0:46:24.07,Default,Spillit,0,0,0,,Ang kanyang mga mata.
Dialogue: 0,0:46:24.37,0:46:28.14,Default,Spillik,0,0,0,,Siya ay may mga mata ng isang tao na nagtatago ng kanyang mga hangarin.
Dialogue: 0,0:46:31.21,0:46:34.78,Default,Spillit,0,0,0,,Ayokong mag-alala ang dowager queen,
Dialogue: 0,0:46:35.15,0:46:37.01,Default,Spillik,0,0,0,,kaya padalus-dalos siyang kumilos.
Dialogue: 0,0:46:38.72,0:46:40.38,Default,Spillit,0,0,0,,Mag-ingat.
Dialogue: 0,0:46:41.99,0:46:43.39,Default,Spillit,0,0,0,,Ama.
Dialogue: 0,0:46:45.96,0:46:50.03,Default,Spillik,0,0,0,,Nalaman mo ba kung kumusta ang reyna?
Dialogue: 0,0:46:50.63,0:46:53.06,Default,Spilyk,0,0,0,,Nabalitaan ko na tapos na ang krisis.
Dialogue: 0,0:46:53.06,0:46:55.87,Default,Spillie,0,0,0,,Hindi pa siya nakakaintindi.
Dialogue: 0,0:46:56.07,0:46:58.90,Default,Spillie,0,0,0,,Ngunit ito ay gagaling sa lalong madaling panahon.
Dialogue: 0,0:47:00.34,0:47:02.14,Default,Spillik,0,0,0,,May gusto ka pa bang sabihin?
Dialogue: 0,0:47:02.37,0:47:04.64,Default,Spillit,0,0,0,,Narinig ko ang dowager queen
Dialogue: 0,0:47:04.64,0:47:06.34,Default,Spillik,0,0,0,,binanggit ang deposition ng reyna.
Dialogue: 0,0:47:06.34,0:47:08.61,Default,Spillik,0,0,0,,Sinabi niya ito sa galit.
Dialogue: 0,0:47:08.61,0:47:10.18,Default,Spillik,0,0,0,,Sa katunayan, hindi niya ito gusto.
Dialogue: 0,0:47:10.18,0:47:12.48,Default,Spillik,0,0,0,,Wala kang dapat ipag-alala.
Dialogue: 0,0:47:13.05,0:47:16.89,Default,Spillik,0,0,0,,Alam na alam ko kung gaano ka nagmamalasakit sa reyna.
Dialogue: 0,0:47:16.89,0:47:18.52,Default,Spillik,0,0,0,,Siguro hindi kasing dami mo,
Dialogue: 0,0:47:18.52,0:47:21.93,Default,Spillik,0,0,0,,pero inaalagaan ko rin siya, kaya huwag kang mag-alala.
Dialogue: 0,0:47:22.93,0:47:24.33,Default,Spillik,0,0,0,,Oo.
Dialogue: 0,0:47:24.60,0:47:26.23,Default,Spillik,0,0,0,,Magkita tayo sa palasyo.
Dialogue: 0,0:47:46.22,0:47:50.09,Default,Spillik,0,0,0,,Nagpadala muli ng mga regalo ang ama ng reyna.
Dialogue: 0,0:47:50.89,0:47:53.22,Default,Spillik,0,0,0,,Kumusta ang reyna?
Dialogue: 0,0:47:53.66,0:47:55.49,Default,Spillit,0,0,0,,Tapos na ang krisis,
Dialogue: 0,0:47:55.49,0:47:58.23,Default,Spillik,0,0,0,,pero kailangan niya munang magpahinga,\Nkaya umuwi siya.
Dialogue: 0,0:47:58.23,0:48:00.60,Default,Spillie,0,0,0,,Palagi siyang may sakit.
Dialogue: 0,0:48:00.90,0:48:02.97,Default,Spillik,0,0,0,,Hindi pa siya nakakarecover sa insidenteng iyon.
Dialogue: 0,0:48:02.97,0:48:04.67,Default,Spillik,0,0,0,,Ano ang dapat kong itawag dito?
Dialogue: 0,0:48:04.97,0:48:06.90,Default,Spillie,0,0,0,,She's broken.
Dialogue: 0,0:48:07.21,0:48:09.81,Default,Spillie,0,0,0,,Sinusubukan kong hayaan siyang lumakas,
Dialogue: 0,0:48:09.81,0:48:13.51,Default,Spillie,0,0,0,,pero bigla siyang naging gulay. \NSmasyadong mahina siya.
Dialogue: 0,0:48:13.85,0:48:16.78,Default,Spillit,0,0,0,,Paano kung si Concubine Cho ay unang manganak ng isang prinsipe?
Dialogue: 0,0:48:16.78,0:48:18.82,Default,Spillik,0,0,0,,Tapos magrerebelde na naman ang Inang Reyna.
Dialogue: 0,0:48:18.82,0:48:20.45,Default,Spillik,0,0,0,,Huwag mag-alala.
Dialogue: 0,0:48:20.45,0:48:23.22,Default,Spilyk,0,0,0,,Naghanda ako ng backup plan.
Dialogue: 0,0:48:23.45,0:48:24.72,Default,Spillit,0,0,0,,Backup plan?
Dialogue: 0,0:48:24.72,0:48:27.36,Default,Spillik,0,0,0,,Sigurado kong ang dalawa pa,\Nna aming isinasaalang-alang para sa papel na reyna,
Dialogue: 0,0:48:27.36,0:48:29.79,Default,Spilyk,0,0,0,,hindi sila nagpakasal sa sinuman.
Dialogue: 0,0:48:29.79,0:48:33.03,Default,Spillik,0,0,0,,Ikaw ay isang maaasahang kapatid.
Dialogue: 0,0:48:34.40,0:48:39.10,Default,Spillik,0,0,0,,Nabalitaan kong inakusahan ni Benin ang hari kahapon.
Dialogue: 0,0:48:40.54,0:48:44.11,Default,Spillik,0,0,0,,Kahapon kakaiba ang ugali ng lahat sa hari.
Dialogue: 0,0:48:44.41,0:48:48.11,Default,Spillik,0,0,0,,Parang may tinatago ang hari.
Dialogue: 0,0:48:50.65,0:48:52.92,Default,Spillik,0,0,0,,Ibang iba ang haring ito sa namatay.
Dialogue: 0,0:48:52.92,0:48:55.35,Default,Spillik,0,0,0,,Ganyan dapat. Ikaw mismo ang pumili nito.
Dialogue: 0,0:48:55.35,0:48:58.99,Default,Spillik,0,0,0,,Itinaas ko ang hari sa kanyang lugar sa isang dahilan lamang.
Dialogue: 0,0:48:58.99,0:49:02.56,Default,Spillik,0,0,0,,Para hindi mo na kailangang gumawa ng masasakit na desisyon,
Dialogue: 0,0:49:02.56,0:49:04.90,Default,Spillik,0,0,0,,dahil nasa ilalim ito ng yumaong hari.
Dialogue: 0,0:49:04.93,0:49:06.36,Default,Spillik,0,0,0,,Totoo ito.
Dialogue: 0,0:49:07.23,0:49:09.73,Default,Spillik,0,0,0,,Ito ay medyo masakit.
Dialogue: 0,0:49:09.90,0:49:12.24,Default,Spillik,0,0,0,,Ipinagtanggol ko ang bansa sa halaga ng dugo ng aking apo
Dialogue: 0,0:49:12.24,0:49:14.07,Default,Spillie,0,0,0,,sa aking mga bisig.
Dialogue: 0,0:49:14.47,0:49:16.07,Default,Spillik,0,0,0,,At kung may mangahas na sirain ito,
Dialogue: 0,0:49:16.07,0:49:19.44,Default,Spillik,0,0,0,,hindi siya patatawarin.
Dialogue: 0,0:49:21.45,0:49:25.82,Default,Spilyk,0,0,0,,Detective department.
Dialogue: 0,0:50:13.30,0:50:15.70,Default,Spillik,0,0,0,,-Una kailangan mo.\N-Hindi, ikaw muna.
Dialogue: 0,0:50:15.70,0:50:18.44,Default,Spillik,0,0,0,,Hindi, una ka.
Dialogue: 0,0:50:47.47,0:50:49.17,Default,Spillik,0,0,0,,Nasaan ako?
Dialogue: 0,0:50:49.70,0:50:52.60,Default,Spillik,0,0,0,,Sa Joseon o sa Korea?
Dialogue: 0,0:50:58.94,0:51:00.58,Default,Spillik,0,0,0,,Sa Joseon.
Dialogue: 0,0:51:02.88,0:51:05.12,Default,Spillik,0,0,0,,Hindi ko masasabi na natutuwa ako, dahil nawala sila,
Dialogue: 0,0:51:05.12,0:51:08.42,Default,Spillik,0,0,0,,pero hindi ko masasabi na nalulungkot ako, dahil natutuwa ako na nasusuri ko ito.
Dialogue: 0,0:51:09.55,0:51:13.02,Default,Spillik,0,0,0,,Bakit kumikinang ang lahat dito?
Dialogue: 0,0:51:32.64,0:51:34.55,Default,Spillit,0,0,0,,Gold of the Empire.
Dialogue: 0,0:51:34.68,0:51:36.45,Default,Spillie,0,0,0,,Inky?
Dialogue: 0,0:51:39.75,0:51:41.22,Default,Spillik,0,0,0,,Kamahalan!
Dialogue: 0,0:51:43.82,0:51:46.79,Default,Spillik,0,0,0,,Mukhang nasa ibang lugar ako.
Dialogue: 0,0:51:47.76,0:51:50.53,Default,Spillik,0,0,0,,Sa wakas, nagising ka na!
Dialogue: 0,0:51:51.00,0:51:52.63,Default,Spillik,0,0,0,,Parang deja vu.
Dialogue: 0,0:51:52.63,0:51:54.87,Default,Spillik,0,0,0,,Let's go na lang ng walang gulo.
Dialogue: 0,0:51:56.53,0:51:59.24,Default,Spillik,0,0,0,,Pero muntik ka nang mamatay.
Dialogue: 0,0:51:59.24,0:52:01.51,Default,Spillik,0,0,0,,Pati silang huminto ng tuluyan.
Dialogue: 0,0:52:02.97,0:52:04.71,Default,Spillie,0,0,0,,Huwag umiyak.
Dialogue: 0,0:52:05.64,0:52:07.14,Default,Spillie,0,0,0,,Tumigil sa paghinga?
Dialogue: 0,0:52:07.38,0:52:09.68,Default,Spillit,0,0,0,,Ayon sa royal physician,\Nyou ay walang gulay.
Dialogue: 0,0:52:09.68,0:52:11.98,Default,Spillit,0,0,0,,Para kang namatay.
Dialogue: 0,0:52:12.92,0:52:15.09,Default,Spillik,0,0,0,,Narito rin.
Dialogue: 0,0:52:15.49,0:52:17.42,Default,Spillik,0,0,0,,Ngunit nasaan ako?
Dialogue: 0,0:52:18.52,0:52:20.69,Default,Spillik,0,0,0,,Uwi ka na.
Dialogue: 0,0:52:21.53,0:52:22.76,Default,Spillik,0,0,0,,So,
Dialogue: 0,0:52:22.76,0:52:24.66,Default,Spillik,0,0,0,,Hindi ko maiwasang magkita
Dialogue: 0,0:52:24.66,0:52:27.06,Default,Spillik,0,0,0,,sa taong hindi mo dapat makilala.
Dialogue: 0,0:52:27.06,0:52:29.93,Default,Spillik,0,0,0,,-Ano? \N-Kaya, walang kahirapan,
Dialogue: 0,0:52:29.93,0:52:32.34,Default,Spikyulka,0,0,0,,pero may isang tao na hindi ako kumportable.
Dialogue: 0,0:52:32.84,0:52:35.51,Default,Spillik,0,0,0,,Ang isa na, sa esensya, ay ang aking tunay na kaaway -
Dialogue: 0,0:52:36.61,0:52:38.51,Default,Spillik,0,0,0,,ama ng isang babae.
Dialogue: 0,0:52:38.71,0:52:40.18,Default,Spillik,0,0,0,,Kamahalan.
Dialogue: 0,0:52:40.71,0:52:43.58,Default,Spillik,0,0,0,,-Anong kaligayahan, reyna. \N-Panginoon.
Dialogue: 0,0:52:43.58,0:52:47.69,Default,Spillik,0,0,0,,Kamahalan, okay ka lang? kaya mo bang huminga?
Dialogue: 0,0:52:47.69,0:52:50.29,Default,Spillik,0,0,0,,Ano ang order mo? Dapat ko bang tawagan ang maharlikang manggagamot?
Dialogue: 0,0:52:50.29,0:52:53.06,Default,Spillik,0,0,0,,Mukhang malapit ka nang mawalan ng malay.
Dialogue: 0,0:52:53.19,0:52:55.69,Default,Spillie,0,0,0,,Narito, uminom.
Dialogue: 0,0:52:55.69,0:52:57.23,Default,Spillik,0,0,0,,Okay.
Dialogue: 0,0:52:58.06,0:53:00.53,Default,Spillik,0,0,0,,Ito ay mga halamang gamot para sa pagpapanumbalik ng yin energy.
Dialogue: 0,0:53:00.53,0:53:02.10,Default,Spillik,0,0,0,,Mahusay.
Dialogue: 0,0:53:02.30,0:53:05.20,Default,Spilyk,0,0,0,,Bakit pawis na pawis ka?
Dialogue: 0,0:53:07.84,0:53:09.34,Default,Spillik,0,0,0,,Holy heavens.
Dialogue: 0,0:53:09.34,0:53:12.28,Default,Spillik,0,0,0,,Nag-alala ako.
Dialogue: 0,0:53:12.28,0:53:15.08,Default,Spillik,0,0,0,,Hindi ako nakatulog kagabi.
Dialogue: 0,0:53:15.08,0:53:16.35,Default,Spillit,0,0,0,,Nawawalan ng gana
Dialogue: 0,0:53:16.35,0:53:18.52,Default,Spilyk,0,0,0,,at hindi ako kumakain ng kahit ano sa loob ng dalawang araw.
Dialogue: 0,0:53:18.52,0:53:22.12,Default,Spillik,0,0,0,,Tuwing babangon ako, umiikot ang ulo ko.
Dialogue: 0,0:53:22.39,0:53:24.29,Default,Spillik,0,0,0,,-Siguradong nabigla ka nang husto. \N-Oo.
Dialogue: 0,0:53:24.72,0:53:27.19,Default,Spillit,0,0,0,,Ang ugat ng mga sakit ay alalahanin at problema,
Dialogue: 0,0:53:27.19,0:53:28.99,Default,Spillik,0,0,0,,kailangan mong magpahinga at huminahon.
Dialogue: 0,0:53:28.99,0:53:31.96,Default,Spillik,0,0,0,,Oo, siyempre, gagawin ko iyon.
Dialogue: 0,0:53:31.96,0:53:34.33,Default,Spillik,0,0,0,,Sana bumuti ang pakiramdam mo sa lalong madaling panahon. Oras na para pumunta ako.
Dialogue: 0,0:53:34.33,0:53:36.23,Default,Spillit,0,0,0,,Kamahalan.
Dialogue: 0,0:53:36.23,0:53:37.84,Default,Spillik,0,0,0,,Saan ka pupunta?
Dialogue: 0,0:53:38.57,0:53:39.74,Default,Spilyk,0,0,0,,Mga Banal na santo.
Dialogue: 0,0:53:39.74,0:53:42.71,Default,Spillik,0,0,0,,Hindi ko magagawa iyon. Kailangan kong magpakita ng respeto.
Dialogue: 0,0:53:42.94,0:53:44.41,Default,Spillik,0,0,0,,Kamahalan.
Dialogue: 0,0:53:44.41,0:53:46.84,Default,Spillik,0,0,0,,Wow. anong ginagawa mo Pinahiya mo ako.
Dialogue: 0,0:53:46.84,0:53:48.51,Default,Spillik,0,0,0,,No, no, I don’t dare.
Dialogue: 0,0:53:48.51,0:53:50.92,Default,Spillik,0,0,0,,Pakiusap tanggapin ang aking busog, Kamahalan.
Dialogue: 0,0:53:52.92,0:53:54.39,Default,Spillit,0,0,0,,Hindi!
Dialogue: 0,0:53:56.65,0:53:57.96,Default,Spillik,0,0,0,,Tingnan.
Dialogue: 0,0:53:57.96,0:53:59.52,Default,Spillik,0,0,0,,Paano kaya?
Dialogue: 0,0:54:00.19,0:54:03.03,Default,Spillik,0,0,0,,Hayaan mo akong yumukod muli sa iyo.
Dialogue: 0,0:54:03.06,0:54:04.60,Default,Spillit,0,0,0,,Ama.
Dialogue: 0,0:54:04.63,0:54:07.43,Default,Spillik,0,0,0,,Ang pagiging reyna sa Joseon ay hindi komportable.
Dialogue: 0,0:54:07.43,0:54:09.33,Default,Spillik,0,0,0,,Hayaan mo ako, habang nandito ako,
Dialogue: 0,0:54:09.33,0:54:13.24,Default,Spillik,0,0,0,,para maging anak mo lang si Soyeon.
Dialogue: 0,0:54:16.21,0:54:19.84,Default,end of shooting range,0,0,0,,Kung mas mataas ang posisyon, mas malakas ang kalungkutan.
Dialogue: 0,0:54:20.71,0:54:22.21,Default,,0,0,0,,Okay, naiintindihan ko.
Dialogue: 0,0:54:22.61,0:54:24.55,Default,,0,0,0,,Habang nandito ka,
Dialogue: 0,0:54:24.55,0:54:26.62,Default,,0,0,0,,Gagawin ko ito,
Dialogue: 0,0:54:26.62,0:54:29.82,Default,,0,0,0,,ayon sa gusto mo.
Dialogue: 0,0:54:30.52,0:54:32.29,Default,,0,0,0,,Okay, ngayon maupo.
Dialogue: 0,0:54:32.56,0:54:35.36,Default,,0,0,0,,Okay. salamat po.
Dialogue: 0,0:54:36.29,0:54:38.13,Default,,0,0,0,,Mag-ingat.
Dialogue: 0,0:54:44.87,0:54:48.74,Default,,0,0,0,,Kahit gaano mo pa palamuti ang kwarto,\N parang walang laman.
Dialogue: 0,0:54:49.11,0:54:53.51,Default,,0,0,0,,Ngunit sa sandaling bumalik ka, nagsimulang lumiwanag ang silid.
Dialogue: 0,0:54:55.15,0:54:56.58,Default,,0,0,0,,Oo.
Dialogue: 0,0:54:56.68,0:55:00.99,Default,,0,0,0,,Napakaliwanag ng kwarto kaya nabubulag ang iyong mga mata.
Dialogue: 0,0:55:01.89,0:55:03.69,Default,,0,0,0,,Gusto ko.
Dialogue: 0,0:55:06.52,0:55:10.03,Default,,0,0,0,,Huwag mag-alala, walang makakasira sa iyong reputasyon.
Dialogue: 0,0:55:10.09,0:55:12.70,Default,,0,0,0,,ako na ang bahala sa lahat.
Dialogue: 0,0:55:12.80,0:55:15.93,Default,,0,0,0,,Inihanda ko ang lahat ng pinakamahusay.
Dialogue: 0,0:55:54.84,0:55:56.47,Default,,0,0,0,,Susunod, sige.
Dialogue: 0,0:55:57.17,0:55:59.64,Default,,0,0,0,,Wala akong nakitang doktor doon,
Dialogue: 0,0:55:59.64,0:56:01.55,Default,,0,0,0,,at maraming tao dito?
Dialogue: 0,0:56:09.25,0:56:11.29,Default,,0,0,0,,May pupuntahan pa ba?
Dialogue: 0,0:56:11.29,0:56:14.33,Default,,0,0,0,,-Isang uri ng holiday?\N-Ito ay almusal.
Dialogue: 0,0:56:18.10,0:56:19.56,Default,,0,0,0,,Upang ibalik ang lakas
Dialogue: 0,0:56:19.56,0:56:22.20,Default,,0,0,0,,pinahanda ka ng tatay mo ng sabaw ng pagong.
Dialogue: 0,0:56:22.20,0:56:23.60,Default,,0,0,0,,Narito.
Dialogue: 0,0:56:26.17,0:56:28.27,Default,,0,0,0,,Mga Pagong simula pa noong umaga?
Dialogue: 0,0:56:30.84,0:56:32.61,Default,,0,0,0,,Mag-ingat.
Dialogue: 0,0:56:35.08,0:56:37.78,Default,,0,0,0,,Bakit? Anong meron?
Dialogue: 0,0:56:38.35,0:56:40.15,Default,,0,0,0,,
Dialogue: 0,0:56:47.93,0:56:51.16,Default,,0,0,0,,Isang karangalan na paglingkuran ka, Kamahalan.
Dialogue: 0,0:56:56.60,0:56:59.80,Default,,0,0,0,,Siya ang pinakamahusay na beauty master sa Joseon.
Dialogue: 0,0:57:00.07,0:57:02.94,Default,,0,0,0,,Likas na maganda ako. Hindi ko kailangan ng tulong niya.
Dialogue: 0,0:57:05.11,0:57:06.71,Default,,0,0,0,,Sige.
Dialogue: 0,0:57:16.75,0:57:19.32,Default,,0,0,0,,Tumawag para sa pagpapabagsak at pagkalason.
Dialogue: 0,0:57:19.92,0:57:23.06,Default,,0,0,0,,Ginagawa nila ang lahat para maalis ang Her Majesty.
Dialogue: 0,0:57:23.06,0:57:24.66,Default,,0,0,0,,Huwag mag-alala.
Dialogue: 0,0:57:25.23,0:57:28.23,Default,,0,0,0,,Gaano man nila subukang saktan ang Kanyang Kamahalan,
Dialogue: 0,0:57:28.80,0:57:31.00,Default,,0,0,0,,Dadagdagan ko ang kapangyarihan ko.
Dialogue: 0,0:57:32.57,0:57:37.04,Default,,0,0,0,,Sa isang kapatid na tulad mo, wala siyang dapat ipag-alala.
Dialogue: 0,0:57:44.98,0:57:47.25,Default,,0,0,0,,Familiar ka ba sa materyal na ito?
Dialogue: 0,0:57:47.25,0:57:49.45,Default,,0,0,0,,Ito ay ordinaryong seda.
Dialogue: 0,0:57:50.42,0:57:53.29,Default,,0,0,0,,May problema ba sa kanya?
Dialogue: 0,0:57:53.32,0:57:56.96,Default,,0,0,0,,Nabigyan mo na ba ang isang tao ng damit na gawa sa materyal na ito?
Dialogue: 0,0:57:58.36,0:58:01.37,Default,,0,0,0,,Pagkatapos maging Reyna ng Kanyang Kamahalan,
Dialogue: 0,0:58:01.37,0:58:04.60,Default,,0,0,0,,Regalo lang ang natatanggap ko, hindi ko binigay sa sarili ko.
Dialogue: 0,0:58:05.07,0:58:08.94,Default,,0,0,0,,Ang tanging taong inaalok ko ng mga regalo ay ang Queen Dowager.
Dialogue: 0,0:58:09.34,0:58:10.84,Default,,0,0,0,,Nakikita ko.
Dialogue: 0,0:58:12.21,0:58:14.11,Default,,0,0,0,,Pero alam mo...
Dialogue: 0,0:58:14.78,0:58:17.98,Default,,0,0,0,,Ang aking bodega ay dalawang beses na ninakawan kamakailan.
Dialogue: 0,0:58:18.85,0:58:22.12,Default,,0,0,0,,Maaaring naroon ang seda.
Dialogue: 0,0:58:22.12,0:58:24.66,Default,,0,0,0,,Inatake ba ang iyong tahanan?
Dialogue: 0,0:58:24.66,0:58:26.49,Default,,0,0,0,,Hindi, hindi.
Dialogue: 0,0:58:27.09,0:58:29.89,Default,,0,0,0,,Mapanganib na panatilihin ang lahat ng iyong mga mahahalagang bagay sa isang lugar.
Dialogue: 0,0:58:29.89,0:58:32.56,Default,,0,0,0,,Mas mainam na ilagay ang mga ito sa iba't ibang lugar.
Dialogue: 0,0:58:32.56,0:58:34.63,Default,,0,0,0,,Mayroon akong ilang warehouse.
Dialogue: 0,0:58:35.40,0:58:40.90,Default,,0,0,0,,Ngunit pinili lamang ng mga tulisan ang mga may pinakamahalagang bagay.
Dialogue: 0,0:58:44.44,0:58:47.61,Default,,0,0,0,,Pag-iisipan ko pa lang, manhid na agad ang leeg ko.
Dialogue: 0,0:58:49.31,0:58:51.52,Default,,0,0,0,,Ang aking minamahal na kayamanan.
Dialogue: 0,0:58:52.35,0:58:54.85,Default,,0,0,0,,Posible bang malaman sa mga ninakaw
Dialogue: 0,0:58:54.85,0:58:56.85,Default,,0,0,0,,silk ba ito o hindi?
Dialogue: 0,0:58:58.12,0:58:59.79,Default,,0,0,0,,Masyadong marami ang ninakaw.
Dialogue: 0,0:58:59.79,0:59:03.26,Default,,0,0,0,,At ang pag-iingat ng mga talaan ng mahalagang ari-arian ay mapanganib.
Dialogue: 0,0:59:04.19,0:59:06.36,Default,,0,0,0,,Nga pala...
Dialogue: 0,0:59:08.90,0:59:11.20,Default,,0,0,0,,Huwag sabihin kahit kanino ang tungkol sa mga bodega.
Dialogue: 0,0:59:11.20,0:59:14.10,Default,,0,0,0,,Hindi maganda kung malalaman ito ng mga tao.
Dialogue: 0,0:59:14.57,0:59:15.97,Default,,0,0,0,,Naiintindihan ko.
Dialogue: 0,0:59:16.67,0:59:22.18,Default,,0,0,0,,Ngunit wala kang narinig na kakaiba mula sa iyong ama?
Dialogue: 0,0:59:23.38,0:59:25.28,Default,,0,0,0,,May nangyari ba?
Dialogue: 0,0:59:27.15,0:59:31.69,Default,,0,0,0,,Itong buong sitwasyon kasama ang Her Majesty: iniligtas ang hari kasama ang kanyang asawa
Dialogue: 0,0:59:31.69,0:59:35.59,Default,,0,0,0,,at nasirang relasyon sa dowager queen - nag-aalala ako.
Dialogue: 0,0:59:36.26,0:59:39.83,Default,,0,0,0,,May mga bangungot ako kung saan siya ay napabagsak.
Dialogue: 0,0:59:39.96,0:59:43.30,Default,,0,0,0,,Ibinagsak? Bakit mo ito iniisip?
Dialogue: 0,0:59:44.50,0:59:47.27,Default,,0,0,0,,May mga tsismis na isa sa mga contenders para sa reyna
Dialogue: 0,0:59:47.30,0:59:50.14,Default,,0,0,0,,naghatid ng lihim na mensahe.
Dialogue: 0,0:59:50.34,0:59:54.01,Default,,0,0,0,,Posible bang gusto nilang pumili ng bagong reyna?
Dialogue: 0,0:59:54.88,0:59:58.95,Default,,0,0,0,,Nag-aalala ako na sobra akong kumakain nitong mga araw na ito.
Dialogue: 0,1:00:00.48,1:00:03.72,Default,,0,0,0,,Hindi nila pababayaan ang Kanyang Kamahalan.
Dialogue: 0,1:00:04.32,1:00:06.49,Default,,0,0,0,,Talaga?
Dialogue: 0,1:00:06.99,1:00:12.66,Default,,0,0,0,,Dapat kong subukan at magpadala\N ng higit pang mga regalo sa Queen Dowager.
Dialogue: 0,1:00:14.23,1:00:16.03,Default,,0,0,0,,Kumusta ang pakiramdam mo?
Dialogue: 0,1:00:16.03,1:00:17.50,Default,,0,0,0,,Ano?
Dialogue: 0,1:00:17.80,1:00:20.57,Default,,0,0,0,,Wala ito. malapit na ako...
Dialogue: 0,1:00:21.37,1:00:23.54,Default,,0,0,0,,Hindi, baka hindi ganoon kabilis.
Dialogue: 0,1:00:24.91,1:00:26.91,Default,,0,0,0,,Paano ito mangyayari?
Dialogue: 0,1:00:28.18,1:00:32.05,Default,,0,0,0,,Lubos kong nakalimutan na hindi na ako bata, at pabaya.
Dialogue: 0,1:00:36.52,1:00:39.92,Default,,0,0,0,,Wala akong oras para magsaya.
Dialogue: 0,1:00:52.37,1:00:53.60,Default,,0,0,0,,Kumusta ang pakiramdam mo?
Dialogue: 0,1:00:53.60,1:00:55.64,Default,,0,0,0,,Mukha akong manika.
Dialogue: 0,1:00:55.64,1:00:57.14,Default,,0,0,0,,Magaling!
Dialogue: 0,1:00:57.74,1:01:01.01,Default,,0,0,0,,Gusto mo, hindi ba?
Dialogue: 0,1:01:27.80,1:01:30.67,Default,,0,0,0,,Ang aklat na ito ay tinutubuan na ng amag.
Dialogue: 0,1:01:31.61,1:01:33.91,Default,,0,0,0,,Nakakatakot na baho.
Dialogue: 0,1:01:34.31,1:01:35.98,Default,,0,0,0,,Kung lalaki ka,
Dialogue: 0,1:01:35.98,1:01:38.45,Default,,0,0,0,,papasok sa palasyo pagkatapos makapasa sa state exam.
Dialogue: 0,1:01:38.45,1:01:40.85,Default,,0,0,0,,Nasiyahan ka talaga sa pag-aaral.
Dialogue: 0,1:01:42.42,1:01:44.32,Default,,0,0,0,,Sino ang gustong mag-aral nito?
Dialogue: 0,1:01:44.32,1:01:46.79,Default,,0,0,0,,Sinubukan ko lang para sa tatay ko.
Dialogue: 0,1:01:47.69,1:01:50.09,Default,,0,0,0,,Namatay si Nanay, binibigyan ako ng buhay.
Dialogue: 0,1:01:50.39,1:01:53.33,Default,,0,0,0,,At napagpasyahan ko na kailangan kong magbayad para dito.
Dialogue: 0,1:01:53.66,1:01:55.73,Default,,0,0,0,,Malamang kaya ka kahit gabi
Dialogue: 0,1:01:55.73,1:01:59.00,Default,,0,0,0,,nag-aral kaming mabuti noong birthday namin.
Dialogue: 0,1:02:09.88,1:02:11.38,Default,,0,0,0,,Soyeon.
Dialogue: 0,1:02:16.55,1:02:18.36,Default,,0,0,0,,Maligayang kaarawan.
Dialogue: 0,1:02:23.86,1:02:27.93,Default,,0,0,0,,Dahil noong birthday ko naalala namin ang aking ina,
Dialogue: 0,1:02:29.83,1:02:31.94,Default,,0,0,0,,Hindi ako ngumiti.
Dialogue: 0,1:02:34.27,1:02:36.27,Default,,0,0,0,,Ano iyon ngayon lang?
Dialogue: 0,1:02:36.54,1:02:37.97,Default,,0,0,0,,Kamahalan.
Dialogue: 0,1:02:38.48,1:02:42.15,Default,,0,0,0,,Nagbabalik ang iyong mga alaala!
Dialogue: 0,1:02:43.81,1:02:47.15,Default,,0,0,0,,Ano? Ano ang mga alaalang ito na tila sa akin, ngunit hindi talaga?
Dialogue: 0,1:02:57.96,1:02:59.73,Default,,0,0,0,,Kim Chanhyuk
Dialogue: 0,1:02:59.93,1:03:03.10,Default,,0,0,0,,Out of the way! umalis ka na!
Dialogue: 0,1:03:03.30,1:03:04.33,Default,,0,0,0,,
Dialogue: 0,1:03:04.33,1:03:07.50,Default,,0,0,0,,Kim Chanhyuk, kasalukuyang Ministro ng Digmaan.
Dialogue: 0,1:03:07.77,1:03:10.14,Default,,0,0,0,,Nakolekta sa isang grupo ng militar
Dialogue: 0,1:03:10.34,1:03:12.24,Default,,0,0,0,,sobrang mataas na buwis sa digmaan.
Dialogue: 0,1:03:14.34,1:03:17.28,Default,,0,0,0,,Kim Seok-kyn, kasalukuyang kaliwang tagapayo.
Dialogue: 0,1:03:17.31,1:03:18.68,Default,,0,0,0,,Responsable para sa pananalapi,
Dialogue: 0,1:03:18.68,1:03:20.25,Default,,0,0,0,,sa pamamagitan ng pagpapalitan ng butil
Dialogue: 0,1:03:20.25,1:03:22.19,Default,,0,0,0,,angkop sa mga maharlikang regalo.
Dialogue: 0,1:03:23.02,1:03:25.49,Default,,0,0,0,,Kim Byung-hak, kasalukuyang konsehal ng estado.
Dialogue: 0,1:03:25.69,1:03:27.29,Default,,0,0,0,,Tax criminal:
Dialogue: 0,1:03:27.29,1:03:29.66,Default,,0,0,0,,nakipagsabwatan sa mga lokal na gobernador
Dialogue: 0,1:03:29.76,1:03:31.66,Default,,0,0,0,,at binuwisan ang mga walang laman na lupain.
Dialogue: 0,1:03:35.40,1:03:37.00,Default,,0,0,0,,Kim Mungeun.
Dialogue: 0,1:03:37.60,1:03:39.37,Default,,0,0,0,,Ama ng Reyna.
Dialogue: 0,1:03:39.57,1:03:41.10,Default,,0,0,0,,Ito ang sinasabi ko.
Dialogue: 0,1:03:46.24,1:03:48.11,Default,,0,0,0,,Ama ng Reyna,
Dialogue: 0,1:03:48.11,1:03:49.68,Default,,0,0,0,,head ng royal guard.
Dialogue: 0,1:03:49.68,1:03:51.38,Default,,0,0,0,,Sikat na tagagawa,
Dialogue: 0,1:03:51.38,1:03:54.48,Default,,0,0,0,,pagharap sa lahat mula sa mga pautang sa bigas hanggang sa sistema ng buwis sa digmaan.
Dialogue: 0,1:03:58.89,1:04:00.39,Default,,0,0,0,,Kim Jwageun.
Dialogue: 0,1:04:01.49,1:04:03.19,Default,,0,0,0,,Kasalukuyang troop commander.
Dialogue: 0,1:04:17.74,1:04:19.04,Default,,0,0,0,,Sa tuktok ng kapangyarihan nito,
Dialogue: 0,1:04:19.04,1:04:22.35,Default,,0,0,0,,ang nagtatag ng buong tiwaling sistemang ito.
Dialogue: 0,1:04:25.85,1:04:27.28,Default,,0,0,0,,Sikreto
Dialogue: 0,1:04:30.52,1:04:32.99,Default,,0,0,0,,
Dialogue: 0,1:04:47.17,1:04:49.84,Default,,0,0,0,,Lahat ng tao sa palasyo ay may sikreto.
Dialogue: 0,1:04:52.11,1:04:54.31,Default,,0,0,0,,Isang sikretong tinatago ng kasinungalingan.
Dialogue: 0,1:04:55.38,1:04:59.05,Default,,0,0,0,,Isang lihim na hindi nakikita o naririnig.
Dialogue: 0,1:04:59.95,1:05:01.99,Default,,0,0,0,,Isang lihim na naghihintay sa tamang sandali.
Dialogue: 0,1:05:08.12,1:05:10.76,Default,,0,0,0,,Upang magtago ng lihim sa kaibuturan ng puso,
Dialogue: 0,1:05:10.76,1:05:12.93,Default,,0,0,0,,
Dialogue: 0,1:05:12.93,1:05:15.03,Default,,0,0,0,,Paunang pagtuturo para sa mga bata
Dialogue: 0,1:05:16.50,1:05:19.37,Default,,0,0,0,,nagsusuot tayong lahat ng maskara.
Dialogue: 0,1:05:21.81,1:05:24.47,Default,,0,0,0,,Cho Hwajin
Dialogue: 0,1:06:09.22,1:06:11.35,Default,,0,0,0,,Pero sikreto
Dialogue: 0,1:06:13.99,1:06:16.06,Default,,0,0,0,,ay tiyak na magbubukas.
Dialogue: 0,1:06:20.06,1:06:23.30,Default,,0,0,0,,
Dialogue: 0,1:06:23.30,1:06:24.83,Default,,0,0,0,,
Dialogue: 0,1:06:40.18,1:06:43.62,Default,,0,0,0,,{\i1}Kamahalan, nagbalik ang iyong mga alaala!{\i}
Dialogue: 0,1:06:46.99,1:06:49.39,Default,,0,0,0,,{\i1}Nalilito ang lahat. Umalis ka, babae, umalis ka!{\i}
Dialogue: 0,1:06:49.39,1:06:52.43,Default,,0,0,0,,{\i1}Bakit lalo kang nagiging kakaiba?{\i}
Dialogue: 0,1:06:52.43,1:06:55.03,Default,,0,0,0,,{\i1}May isang bagay na hindi ko pa nasasabi kahit kanino.{\i}
Dialogue: 0,1:06:55.03,1:06:56.93,Default,,0,0,0,,{\i1}-Tulong.\N-Yung mamasa-masa na amoy.{\i}
Dialogue: 0,1:06:56.93,1:06:59.87,Default,,0,0,0,,{\i1}Maraming bodega ang ninakawan sa kabisera kamakailan.{\i}
Dialogue: 0,1:06:59.87,1:07:01.57,Default,,0,0,0,,{\i1}-Ano?\N-Interesado ako,{\i}
Dialogue: 0,1:07:01.57,1:07:03.84,Default,,0,0,0,,{\i1}baka ganito ka kumita.{\i}
Dialogue: 0,1:07:03.94,1:07:06.71,Default,,0,0,0,,{\i1}Ngayon ay lilinawin namin ang lahat.{\i}
Dialogue: 0,1:07:06.71,1:07:08.58,Default,,0,0,0,,{\i1}Ito ang hinihintay ko.{\i}
Dialogue: 0,0:10:58.78,0:11:00.78,Default,,0,0,0,,

Comment: 0,0:06:11.92,0:06:14.02,Default,lily,0,0,0,,Isang kondisyon kapag may pulso, ngunit ang tao ay halos hindi humihinga.
