Dialogue: 0,0:01:13.06,2:01:37.06,الحاضر,,0,0,0,,{\fs40\pos(1181,4)}أزاليا
Dialogue: 0,0:01:17.36,0:01:20.36,Default,LILY,0,0,0,,في تلك الليلة كانت الغرفة بأكملها تفوح منها رائحة الياسمين.
Dialogue: 0,0:01:25.57,0:01:29.04,Default,LILY,0,0,0,,حتى أن الرائحة تغلغلت في كمه.
Dialogue: 0,0:01:56.16,0:01:57.26,Default,LILY,0,0,0,,لقد كنت أنت.
Dialogue: 0,0:02:00.67,0:02:01.84,Default,LILY,0,0,0,,إنها أنت...
Dialogue: 0,0:02:02.17,0:02:04.67,Default,LILY,0,0,0,,كملاذ أخير، هناك الكم الأيسر.
Dialogue: 0,0:02:13.38,0:02:16.88,Default,LILY,0,0,0,,أنتِ التي أحتاجها.
Dialogue: 0,0:02:16.98,0:02:18.02,Default,LILY,0,0,0,,4 حلقة
Dialogue: 0,0:02:18.38,0:02:19.59,Default,LILY,0,0,0,,هذا الشاي.
Dialogue: 0,0:02:23.99,0:02:25.73,Default,LILY,0,0,0,,سعيد لأنه أعجبك.
Dialogue: 0,0:02:29.20,0:02:31.43,Default,LILY,0,0,0,,لم يتركني لأكتشف ذلك
Dialogue: 0,0:02:31.43,0:02:32.77,Default,LILY,0,0,0,,هل أتذكر.
Dialogue: 0,0:02:32.77,0:02:36.07,Default,LILY,0,0,0,,جلالتك، لماذا أصبحت شاحباً؟
Dialogue: 0,0:02:36.07,0:02:37.37,Default,LILY,0,0,0,,وتعرق.
Dialogue: 0,0:02:40.47,0:02:42.08,Default,LILY,0,0,0,,كل شيء على ما يرام.
Dialogue: 0,0:02:42.61,0:02:44.48,Default,LILY,0,0,0,,تعبت لأنني لم أنم طوال الليل.
Dialogue: 0,0:02:45.38,0:02:48.58,Default,LILY,0,0,0,,في هذه الحالة، سيكون الشاي مفيدًا.
Dialogue: 0,0:02:49.15,0:02:51.62,Default,LILY,0,0,0,,اشرب واذهب إلى السرير.
Dialogue: 0,0:02:53.32,0:02:54.35,Default,LILY,0,0,0,,حاول.
Dialogue: 0,0:03:06.73,0:03:08.07,Default,LILY,0,0,0,,يمكنك أن تشرب.
Dialogue: 0,0:03:09.67,0:03:11.80,Default,LILY,0,0,0,,سأسكبها بنفسي. يمكنك أن تكون حرا.
Dialogue: 0,0:03:33.53,0:03:35.90,Default,LILY,0,0,0,,اشرب. رائحتها لذيذة جدًا.
Dialogue: 0,0:03:49.24,0:03:51.84,Default,LILY,0,0,0,,سأتظاهر بأنني لا أعرف. هذه هي الطريقة الوحيدة التي يمكنني البقاء على قيد الحياة.
Dialogue: 0,0:03:57.52,0:03:59.35,Default,LILY,0,0,0,,لماذا يحاول إقناعك بشرب الشاي؟
Dialogue: 0,0:03:59.59,0:04:01.09,Default,LILY,0,0,0,,حقاً مسمومة؟
Dialogue: 0,0:04:04.42,0:04:05.66,Default,LILY,0,0,0,,ماذا حدث؟
Dialogue: 0,0:04:06.56,0:04:07.66,Default,LILY,0,0,0,,الأذواق
Dialogue: 0,0:04:10.70,0:04:11.83,Default,LILY,0,0,0,,جميل جدًا.
Dialogue: 0,0:04:14.53,0:04:15.60,Default,LILY,0,0,0,,أنا سعيد جدًا.
Dialogue: 0,0:04:16.30,0:04:18.74,Default,LILY,0,0,0,,هل تناولت العشاء مؤخرًا؟
Dialogue: 0,0:04:20.84,0:04:22.78,Default,LILY,0,0,0,,السم سيعمل بشكل أسرع على معدة فارغة.
Dialogue: 0,0:04:23.31,0:04:24.58,Default,LILY,0,0,0,,فسأل.
Dialogue: 0,0:04:25.38,0:04:27.65,Default,LILY,0,0,0,,كنت تتساءل عما أفعله.
Dialogue: 0,0:04:28.15,0:04:29.62,Default,LILY,0,0,0,,كنت مشغولاً.
Dialogue: 0,0:04:29.95,0:04:31.99,Default,LILY,0,0,0,,لكنني كنت مهتماً دائماً
Dialogue: 0,0:04:31.99,0:04:34.15,Default,LILY,0,0,0,,أنت وأقاربك.
Dialogue: 0,0:04:36.42,0:04:37.46,Default,LILY,0,0,0,,ثم
Dialogue: 0,0:04:42.00,0:04:43.16,Default,LILY,0,0,0,,اشرب أيضًا.
Dialogue: 0,0:04:45.20,0:04:46.57,Default,LILY,0,0,0,,كدليل على التعاطف.
Dialogue: 0,0:04:51.37,0:04:52.61,Default,LILY,0,0,0,,إذا كنت مصراً.
Dialogue: 0,0:05:00.98,0:05:02.05,Default,LILY,0,0,0,,غير مسمومة.
Dialogue: 0,0:05:15.46,0:05:16.73,Default,LILY,0,0,0,,أنت أحمق.
Dialogue: 0,0:05:17.26,0:05:18.73,Default,LILY,0,0,0,,قالتها بنفسها كدليل على التعاطف.
Dialogue: 0,0:05:20.77,0:05:21.90,Default,LILY,0,0,0,,ماذا تفعل؟
Dialogue: 0,0:05:21.90,0:05:23.54,Default,LILY,0,0,0,,دعني أذهب، أريد أن أنظف معدتي.
Dialogue: 0,0:05:26.71,0:05:29.08,Default,LILY,0,0,0,,هل تعتقد أنني سممتك؟
Dialogue: 0,0:05:29.38,0:05:31.91,Default,LILY,0,0,0,,لماذا؟ هل هناك أي سبب للاعتقاد بذلك؟
Dialogue: 0,0:05:34.08,0:05:35.25,Default,LILY,0,0,0,,دعونا ننتظر.
Dialogue: 0,0:05:36.25,0:05:38.65,Default,LILY,0,0,0,,إذا لم يحدث شيء لك،
Dialogue: 0,0:05:39.25,0:05:40.92,Default,LILY,0,0,0,,سيتم إثبات براءتي.
Dialogue: 0,0:05:41.72,0:05:42.82,Default,LILY,0,0,0,,ماذا لو لم أرغب في ذلك؟
Dialogue: 0,0:05:49.73,0:05:52.60,Default,LILY,0,0,0,,إذا تسممت، فسوف يتخدر لسانك أولاً.
Dialogue: 0,0:05:53.27,0:05:54.57,Default,LILY,0,0,0,,سوف تشعر بالخدر،
Dialogue: 0,0:05:55.00,0:05:56.80,Default,LILY,0,0,0,,لا تتردد واضرب.
Dialogue: 0,0:05:58.54,0:05:59.81,Default,LILY,0,0,0,,هل تعتقد أنني لا أستطيع؟
Dialogue: 0,0:06:00.71,0:06:01.97,Default,LILY,0,0,0,,أنا متأكد من أنك تستطيع ذلك.
Dialogue: 0,0:06:02.71,0:06:04.38,Default,LILY,0,0,0,,يمكنك فعل ذلك.
Dialogue: 0,0:06:06.28,0:06:07.45,Default,LILY,0,0,0,,فهمت بشكل صحيح.
Dialogue: 0,0:06:08.61,0:06:11.25,Default,LILY,0,0,0,,إذا مت، على الأقل لست وحدي.
Dialogue: 0,0:06:18.50,0:06:21.90,Default,LILY,0,0,0,,4 حلقة: الرجل الذي عرف أكثر من اللازم
Dialogue: 0,0:06:29.54,0:06:31.70,Default,LILY,0,0,0,,-جلالتك.\N-لا أستطيع فعل ذلك بعد الآن.
Dialogue: 0,0:06:33.37,0:06:35.11,Default,LILY,0,0,0,,حتى لو كانت حياتي تعتمد على ذلك.
Dialogue: 0,0:06:36.18,0:06:37.84,Default,LILY,0,0,0,,سأموت قريباً أيضاً.
Dialogue: 0,0:06:43.98,0:06:45.25,Default,LILY,0,0,0,,كن حذراً.
Dialogue: 0,0:06:46.55,0:06:48.52,Default,LILY,0,0,0,,هل ستؤذيني أثناء نومي؟
Dialogue: 0,0:06:50.56,0:06:51.76,Default,LILY,0,0,0,,هناك خطأ ما معي.
Dialogue: 0,0:06:52.46,0:06:54.29,Default,LILY,0,0,0,,ماذا أعطيتني؟
Dialogue: 0,0:06:54.96,0:06:56.16,Default,LILY,0,0,0,,أجب عن السؤال.
Dialogue: 0,0:06:57.46,0:06:59.17,Default,LILY,0,0,0,,أين ذهبت عندما ذهبت
Dialogue: 0,0:06:59.57,0:07:01.30,Default,LILY,0,0,0,,ذهبت إلى القصر الصيفي؟
Dialogue: 0,0:07:01.30,0:07:02.77,Default,LILY,0,0,0,,أريد الهرب.
Dialogue: 0,0:07:03.34,0:07:04.80,Default,LILY,0,0,0,,نحن بحاجة للخروج.
Dialogue: 0,0:07:05.27,0:07:09.31,Default,LILY,0,0,0,,لا أستطيع أن أموت عندما يكون المخرج أمامي مباشرة.
Dialogue: 0,0:07:17.72,0:07:20.69,Default,LILY,0,0,0,,ماذا حدث لك تلك الليلة؟
Dialogue: 0,0:07:21.59,0:07:24.52,Default,LILY,0,0,0,,هذا أمر خطير. عليك أن تكون صامتا.
Dialogue: 0,0:07:24.52,0:07:25.89,Default,LILY,0,0,0,,أنا...
Dialogue: 0,0:07:27.13,0:07:28.36,Default,LILY,0,0,0,,ماذا قلت؟
Dialogue: 0,0:07:28.43,0:07:29.73,Default,LILY,0,0,0,,في تلك الليلة
Dialogue: 0,0:07:30.80,0:07:32.00,Default,LILY,0,0,0,,لقد حاولت
Dialogue: 0,0:07:35.43,0:07:36.84,Default,LILY,0,0,0,,اقتلني.
Dialogue: 0,0:07:37.74,0:07:38.87,Default,LILY,0,0,0,,إنها تعرف.
Dialogue: 0,0:07:39.94,0:07:41.67,Default,LILY,0,0,0,,لو كنتم تعلمون،
Dialogue: 0,0:07:42.31,0:07:44.68,Default,LILY,0,0,0,,لماذا لم تقل أي شيء؟
Dialogue: 0,0:07:45.01,0:07:46.98,Default,LILY,0,0,0,,ما الذي تنوي فعله؟
Dialogue: 0,0:07:48.05,0:07:49.48,Default,LILY,0,0,0,,لم أكن أعرف حتى.
Dialogue: 0,0:07:49.85,0:07:52.75,Default,LILY,0,0,0,,اكتشفت ذلك للتو، بفضل الشاي الذي قدمته.
Dialogue: 0,0:07:55.35,0:07:56.69,Default,LILY,0,0,0,,يا للأسف.
Dialogue: 0,0:07:56.76,0:07:59.63,Default,LILY,0,0,0,,لو كنت أعرف من قبل، لقتلتك بالتأكيد.
Dialogue: 0,0:08:01.43,0:08:03.06,Default,LILY,0,0,0,,تفرخ الشر.
Dialogue: 0,0:08:03.36,0:08:05.93,Default,LILY,0,0,0,,حتى لو كنت مجنونًا بشخص آخر،
Dialogue: 0,0:08:05.93,0:08:07.27,Default,LILY,0,0,0,,لماذا تقتل زوجتك؟
Dialogue: 0,0:08:07.53,0:08:09.20,Default,LILY,0,0,0,,هل تسمي نفسك إنساناً؟
Dialogue: 0,0:08:09.54,0:08:11.87,Default,LILY,0,0,0,,تشو هواجين هي خليلتك.
Dialogue: 0,0:08:12.37,0:08:14.44,Default,LILY,0,0,0,,ألا يمكنك أن تنغمس في الزنا فحسب؟
Dialogue: 0,0:08:14.77,0:08:17.34,Default,LILY,0,0,0,,هل كنت ستقتل زوجتك بيديك؟
Dialogue: 0,0:08:17.78,0:08:19.31,Default,LILY,0,0,0,,إنها لا تعرف السبب.
Dialogue: 0,0:08:23.85,0:08:24.98,Default,LILY,0,0,0,,ملكتي.
Dialogue: 0,0:08:25.62,0:08:28.62,Default,LILY,0,0,0,,في تلك الليلة سمعت شيئاً لا ينبغي أن تسمعه.
Dialogue: 0,0:08:29.12,0:08:30.82,Default,LILY,0,0,0,,ماذا سمعت؟
Dialogue: 0,0:08:31.92,0:08:34.46,Default,LILY,0,0,0,,أجب! ماذا سمعت؟
Dialogue: 0,0:08:37.90,0:08:39.90,Default,LILY,0,0,0,,إذن ليس هذا هو السبب؟
Dialogue: 0,0:08:41.33,0:08:43.74,Default,LILY,0,0,0,,لديك سبب وجيه،
Dialogue: 0,0:08:44.07,0:08:47.11,Default,LILY,0,0,0,,لقتل هذه المرأة؟
Dialogue: 0,0:08:47.87,0:08:49.21,Default,LILY,0,0,0,,هل فهمت بشكل صحيح؟
Dialogue: 0,0:08:50.68,0:08:52.38,Default,LILY,0,0,0,,لا تنخدع.
Dialogue: 0,0:08:52.71,0:08:54.31,Default,LILY,0,0,0,,هل لأنني سمعت شيئًا ما،
Dialogue: 0,0:08:54.31,0:08:55.88,Default,LILY,0,0,0,,أو بسبب حب امرأة أخرى -
Dialogue: 0,0:08:55.88,0:08:57.82,Default,LILY,0,0,0,,سبب واحد للقتل.
Dialogue: 0,0:08:58.62,0:09:00.45,Default,LILY,0,0,0,,أنا فقط أضعف.
Dialogue: 0,0:09:02.62,0:09:05.66,Default,LILY,0,0,0,,لو كنت أقوى لما هاجمتني.
Dialogue: 0,0:09:05.76,0:09:07.83,Default,LILY,0,0,0,,من السهل أن أقتل،
Dialogue: 0,0:09:07.83,0:09:09.76,Default,LILY,0,0,0,,لأنني الأضعف.
Dialogue: 0,0:09:10.53,0:09:12.27,Default,LILY,0,0,0,,هذا هو السبب الحقيقي.
Dialogue: 0,0:09:18.10,0:09:20.47,Default,LILY,0,0,0,,هيا. هنا.
Dialogue: 0,0:09:21.37,0:09:24.98,Default,LILY,0,0,0,,أثبت أنك تقتل من هم أضعف فقط.
Dialogue: 0,0:09:40.99,0:09:42.23,Default,LILY,0,0,0,,اللعنة.
Dialogue: 0,0:09:42.80,0:09:44.10,Default,LILY,0,0,0,,أنا وحيدة.
Dialogue: 0,0:09:44.33,0:09:45.83,Default,LILY,0,0,0,,جلالتك.
Dialogue: 0,0:09:47.30,0:09:49.50,Default,LILY,0,0,0,,لم يأخذني على محمل الجد.
Dialogue: 0,0:09:51.27,0:09:54.14,Default,LILY,0,0,0,,لو كنت مكاني لطردته بضربة واحدة!
Dialogue: 0,0:09:54.14,0:09:55.27,Default,LILY,0,0,0,,اللعنة!
Dialogue: 0,0:10:35.45,0:10:36.85,Default,LILY,0,0,0,,ماذا حدث؟
Dialogue: 0,0:10:37.62,0:10:41.55,Default,LILY,0,0,0,,كنت أعتقد دائمًا أنني ضعيف يقاتل شخصًا أقوى.
Dialogue: 0,0:10:42.76,0:10:45.02,Default,LILY,0,0,0,,لذلك كنت أعتقد أن أي تقنيات
Dialogue: 0,0:10:46.79,0:10:48.69,Default,LILY,0,0,0,,مقبول.
Dialogue: 0,0:10:53.80,0:10:55.90,Default,LILY,0,0,0,,الملكة تعرف،
Dialogue: 0,0:10:56.14,0:10:57.94,Default,LILY,0,0,0,,أنني حاولت قتلها.
Dialogue: 0,0:11:05.08,0:11:09.65,Default,LILY,0,0,0,,اعتقدت أن هناك أسبابًا كثيرة\N لقتل الملكة.
Dialogue: 0,0:11:10.02,0:11:12.28,Default,LILY,0,0,0,,ليس فقط بسبب المحادثة المسموعة.
Dialogue: 0,0:11:12.28,0:11:15.55,Default,LILY,0,0,0,,ولكن أيضاً لأنها ساهمت في الاستبداد.
Dialogue: 0,0:11:16.26,0:11:19.49,Default,LILY,0,0,0,,لذلك اعتقدت أنني أستطيع قتل الملكة.
Dialogue: 0,0:11:24.26,0:11:27.13,Default,LILY,0,0,0,,ومع ذلك، كان هذا عذرًا جبانًا.
Dialogue: 0,0:11:27.83,0:11:30.40,Default,LILY,0,0,0,,لست مستعداً لقتال خصوم أقوياء،
Dialogue: 0,0:11:30.40,0:11:33.11,Default,LILY,0,0,0,,لذلك استهدفت الملكة الضعيفة.
Dialogue: 0,0:11:35.04,0:11:37.68,Default,LILY,0,0,0,,-جلالتك.\N-إذا هاجمت الضعيف،
Dialogue: 0,0:11:39.01,0:11:41.88,Default,LILY,0,0,0,,كيف أختلف عن البقية؟
Dialogue: 0,0:11:44.38,0:11:46.42,Default,LILY,0,0,0,,ركّز على الهدف الصالح.
Dialogue: 0,0:11:47.09,0:11:50.79,Default,LILY,0,0,0,,كل الوسائل صالحة لتحقيق هدف جيد.
Dialogue: 0,0:11:51.49,0:11:54.26,Default,LILY,0,0,0,,لا يمكن هزيمة عشيرة كيم بالطرق الصالحة.
Dialogue: 0,0:12:00.43,0:12:01.83,Default,LILY,0,0,0,,لا تشك في ذلك.
Dialogue: 0,0:12:02.07,0:12:04.47,Default,LILY,0,0,0,,أنا متأكد من أن خططهم ماكرة.
Dialogue: 0,0:12:05.14,0:12:07.44,Default,LILY,0,0,0,,فقط الملكة تعرف عن هذا الآن،
Dialogue: 0,0:12:08.07,0:12:10.31,Default,LILY,0,0,0,,فقط خمنت.
Dialogue: 0,0:12:10.44,0:12:12.38,Default,LILY,0,0,0,,عليها أن تصمت.
Dialogue: 0,0:12:12.78,0:12:15.05,Default,LILY,0,0,0,,عاجلاً أم آجلاً سيتضح كل شيء.
Dialogue: 0,0:12:17.28,0:12:20.12,Default,LILY,0,0,0,,لن أستخدم التكتيكات الجبانة بعد الآن.
Dialogue: 0,0:12:20.15,0:12:21.22,Default,LILY,0,0,0,,جلالتك.
Dialogue: 0,0:12:21.42,0:12:24.36,Default,LILY,0,0,0,,لقد أدنت الملكة لأنها من عائلة كيم.
Dialogue: 0,0:12:24.36,0:12:27.06,Default,LILY,0,0,0,,ومع ذلك، فقد تصرفت بشكل غير متوقع.
Dialogue: 0,0:12:28.43,0:12:31.70,Default,LILY,0,0,0,,بشكل عام، أنا لست من تظنني.
Dialogue: 0,0:12:31.70,0:12:33.03,Default,LILY,0,0,0,,المظاهر قد تكون خادعة، كما تعلم.
Dialogue: 0,0:12:34.13,0:12:36.97,Default,LILY,0,0,0,,قالت الملكة إنها شخص مختلف.
Dialogue: 0,0:12:37.74,0:12:40.61,Default,LILY,0,0,0,,ربما كانت تحاول أن تقول،
Dialogue: 0,0:12:40.61,0:12:43.78,Default,LILY,0,0,0,,إنها مصبوبة من عجينة مختلفة وتتصرف بشكل مختلف.
Dialogue: 0,0:12:43.91,0:12:45.71,Default,LILY,0,0,0,,ماذا تتوقع منها؟
Dialogue: 0,0:12:46.15,0:12:47.41,Default,LILY,0,0,0,,الملكة هي نفسها،
Dialogue: 0,0:12:48.31,0:12:49.65,Default,LILY,0,0,0,,مثل بقية آل كيم.
Dialogue: 0,0:12:50.28,0:12:52.52,Default,LILY,0,0,0,,ربما أنا ملك الدمى،
Dialogue: 0,0:12:53.49,0:12:56.39,Default,LILY,0,0,0,,لكن كلمات الملكة لن تمنحهم شيئاً.
Dialogue: 0,0:12:56.56,0:12:58.46,Default,LILY,0,0,0,,ليس هناك دليل قاطع.
Dialogue: 0,0:13:00.19,0:13:02.43,Default,LILY,0,0,0,,سأرى ما ستفعله الملكة.
Dialogue: 0,0:13:02.96,0:13:05.93,Default,LILY,0,0,0,,وفي الوقت نفسه، سأكتشف أي نوع من الأشخاص هي.
Dialogue: 0,0:13:19.25,0:13:22.58,Default,LILY,0,0,0,,لقد اكتشفت من أين جاء هذا القماش،
Dialogue: 0,0:13:23.82,0:13:24.98,Default,LILY,0,0,0,,إنها من القصر.
Dialogue: 0,0:13:26.52,0:13:29.12,Default,LILY,0,0,0,,إذا حاول أحد أن يسرقها من الملك،
Dialogue: 0,0:13:29.49,0:13:31.12,Default,LILY,0,0,0,,من المؤكد أنه تم القبض عليه.
Dialogue: 0,0:13:32.53,0:13:35.39,Default,LILY,0,0,0,,أي أن مجرد بشر لا يمكنه فعل هذا.
Dialogue: 0,0:13:35.63,0:13:40.33,Default,LILY,0,0,0,,يا رب. وأتساءل كم سيدفعون لي مقابل خدماتي.
Dialogue: 0,0:13:40.57,0:13:43.00,Default,LILY,0,0,0,,لم يكن الأمر سهلاً يا سيدي.
Dialogue: 0,0:13:46.74,0:13:47.91,Default,LILY,0,0,0,,أحسنت.
Dialogue: 0,0:13:50.61,0:13:54.15,Default,LILY,0,0,0,,من الآن فصاعدا، ثق بي بالأثقل
Dialogue: 0,0:13:54.15,0:13:56.22,Default,LILY,0,0,0,,وعمل قذر.
Dialogue: 0,0:13:57.18,0:13:58.55,Default,LILY,0,0,0,,القصر.
Dialogue: 0,0:14:59.51,0:15:00.71,Default,LILY,0,0,0,,بسبب واحد
Dialogue: 0,0:15:01.58,0:15:05.72,Default,LILY,0,0,0,,لن نفوز بالملك كزوجة نبيلة.
Dialogue: 0,0:15:06.25,0:15:10.92,Default,LILY,0,0,0,,نحتاج إلى شيء يذيب قلبه.
Dialogue: 0,0:15:12.36,0:15:16.46,Default,LILY,0,0,0,,النقطة الضعيفة للمحظية هي حادثة وقعت في البحيرة.
Dialogue: 0,0:15:18.33,0:15:19.70,Default,LILY,0,0,0,,في هذه الحالة...
Dialogue: 0,0:15:20.13,0:15:22.47,Default,LILY,0,0,0,,نحن بحاجة إلى العثور على كبش فداء.
Dialogue: 0,0:15:23.00,0:15:25.74,Default,LILY,0,0,0,,ضعيف وعاجز,
Dialogue: 0,0:15:26.77,0:15:29.51,Default,LILY,0,0,0,,مثل الظبي بلا أم.
Dialogue: 0,0:15:33.15,0:15:34.51,Default,LILY,0,0,0,,شخص مشابه.
Dialogue: 0,0:16:17.89,0:16:20.09,Default,LILY,0,0,0,,أين ذهب لاعب التودجون؟
Dialogue: 0,0:16:20.09,0:16:21.66,Default,LILY,0,0,0,,ألا يمكنك وضع البطاقة؟
Dialogue: 0,0:16:21.66,0:16:25.06,Default,LILY,0,0,0,,لن تلاحظ حتى لو سرقت أنفك.
Dialogue: 0,0:16:26.00,0:16:27.07,Default,LILY,0,0,0,,الأمر هو...
Dialogue: 0,0:16:28.60,0:16:30.47,Default,LILY,0,0,0,,لا. لا شئ.
Dialogue: 0,0:16:31.14,0:16:32.94,Default,LILY,0,0,0,,هناك شيء يزعجك.
Dialogue: 0,0:16:34.21,0:16:39.08,Default,LILY,0,0,0,,هناك الكثير من الأشرار يتجولون خارج القصر.
Dialogue: 0,0:16:39.81,0:16:42.25,Default,LILY,0,0,0,,لقد كونت صداقة مع رجل واحد،
Dialogue: 0,0:16:42.25,0:16:43.38,Default,LILY,0,0,0,,لي سينمان.
Dialogue: 0,0:16:43.92,0:16:45.15,Default,LILY,0,0,0,,أعتقد،
Dialogue: 0,0:16:45.88,0:16:48.55,Default,LILY,0,0,0,,لقد هاجمه الشرير أيضًا،
Dialogue: 0,0:16:48.55,0:16:50.26,Default,LILY,0,0,0,,تمشي خارج القصر.
Dialogue: 0,0:16:50.32,0:16:52.29,Default,LILY,0,0,0,,"أيضاً"؟ من هو الآخر الذي تعرض للهجوم؟
Dialogue: 0,0:16:52.39,0:16:54.63,Default,LILY,0,0,0,,كما تعلمون، أنا شديد الإدراك.
Dialogue: 0,0:16:55.03,0:16:57.50,Default,LILY,0,0,0,,ابن عمي بنين،
Dialogue: 0,0:16:58.20,0:17:00.63,Default,LILY,0,0,0,,يبدو أنها تحاول
Dialogue: 0,0:17:00.83,0:17:05.04,Default,LILY,0,0,0,,اعثر على شخص يستخدم قطعة قماش.
Dialogue: 0,0:17:06.47,0:17:08.57,Default,LILY,0,0,0,,حدسي يخبرني،
Dialogue: 0,0:17:08.81,0:17:12.24,Default,LILY,0,0,0,,صاحب قطعة ملابس، وغد سيئ السمعة،
Dialogue: 0,0:17:12.68,0:17:13.88,Default,LILY,0,0,0,,جريح
Dialogue: 0,0:17:15.05,0:17:16.48,Default,LILY,0,0,0,,يا صديقي
Dialogue: 0,0:17:17.05,0:17:19.42,Default,LILY,0,0,0,,واصطدمت بأخي.
Dialogue: 0,0:17:21.92,0:17:23.32,Default,LILY,0,0,0,,ما رأيك؟
Dialogue: 0,0:17:25.19,0:17:27.73,Default,LILY,0,0,0,,من العبث أن تمتلك موهبة مثلك،
Dialogue: 0,0:17:27.73,0:17:29.19,Default,LILY,0,0,0,,لم يصبح عالماً.
Dialogue: 0,0:17:29.19,0:17:31.33,Default,LILY,0,0,0,,خسارة فادحة للمملكة.
Dialogue: 0,0:17:32.73,0:17:36.64,Default,LILY,0,0,0,,أنت تتمتع ببصيرة مثلي.
Dialogue: 0,0:17:40.07,0:17:45.04,Default,LILY,0,0,0,,شيء غريب يحدث خارج القصر.
Dialogue: 0,0:18:00.63,0:18:01.79,Default,LILY,0,0,0,,ارحمني.
Dialogue: 0,0:18:01.79,0:18:04.86,Default,LILY,0,0,0,,سأفعل ما تطلبه. لا تقتل.
Dialogue: 0,0:18:05.36,0:18:07.10,Default,LILY,0,0,0,,سيد.
Dialogue: 0,0:18:07.10,0:18:08.23,Default,LILY,0,0,0,,السيدة.
Dialogue: 0,0:18:09.27,0:18:12.30,Default,LILY,0,0,0,,لا أعرف من أنت، ولكني أتوسل إليك.
Dialogue: 0,0:18:12.64,0:18:13.67,Default,LILY,0,0,0,,من فضلك.
Dialogue: 0,0:18:16.84,0:18:18.51,Default,LILY,0,0,0,,لا أرى أي شيء.
Dialogue: 0,0:18:18.51,0:18:19.78,Default,LILY,0,0,0,,ارفع رأسك.
Dialogue: 0,0:18:20.05,0:18:23.02,Default,LILY,0,0,0,,لا. لا أريد أن أموت.
Dialogue: 0,0:18:31.62,0:18:33.86,Default,LILY,0,0,0,,مازلت لن ترى وجهي.
Dialogue: 0,0:18:44.34,0:18:47.11,Default,LILY,0,0,0,,شخص مؤثر ينتظر إجابتك.
Dialogue: 0,0:18:48.04,0:18:51.01,Default,LILY,0,0,0,,لا أعرف أي شيء.
Dialogue: 0,0:18:51.61,0:18:54.21,Default,LILY,0,0,0,,كيف أعرف أي شيء؟
Dialogue: 0,0:18:55.01,0:18:56.18,Default,LILY,0,0,0,,كما تعلم،
Dialogue: 0,0:18:56.18,0:18:58.98,Default,LILY,0,0,0,,التي حاولت إيذاء الملكة بدفعها إلى البحيرة.
Dialogue: 0,0:19:00.52,0:19:02.75,Default,LILY,0,0,0,,سوف تنجو إذا قلت الاسم.
Dialogue: 0,0:19:56.64,0:19:57.81,Default,LILY,0,0,0,,عذراً يا صاحب الجلالة.
Dialogue: 0,0:19:58.54,0:20:00.41,Default,LILY,0,0,0,,مذاقها فظيع،
Dialogue: 0,0:20:00.41,0:20:02.11,Default,LILY,0,0,0,,ولكنه مفيد جداً.
Dialogue: 0,0:20:09.05,0:20:12.06,Default,LILY,0,0,0,,أحضر والد الملكة شيئاً بالأمس.
Dialogue: 0,0:20:12.32,0:20:13.66,Default,LILY,0,0,0,,أشرب على معدة فارغة
Dialogue: 0,0:20:14.19,0:20:16.09,Default,LILY,0,0,0,,وأشعر بتجديد شبابي.
Dialogue: 0,0:20:17.13,0:20:20.53,Default,LILY,0,0,0,,إنه يعرف دائمًا أين يحصل على شيء غير عادي.
Dialogue: 0,0:20:21.27,0:20:23.57,Default,LILY,0,0,0,,كمستشارة للمطبخ الملكي
Dialogue: 0,0:20:23.57,0:20:25.37,Default,LILY,0,0,0,,إنها تجلب الأفضل
Dialogue: 0,0:20:25.37,0:20:26.61,Default,LILY,0,0,0,,الأشياء المناسبة.
Dialogue: 0,0:20:39.99,0:20:41.02,Default,LILY,0,0,0,,بالمناسبة،
Dialogue: 0,0:20:41.02,0:20:43.86,Default,LILY,0,0,0,,ماذا عن شؤوننا في القصر؟
Dialogue: 0,0:20:44.66,0:20:46.73,Default,LILY,0,0,0,,هناك شخص في ذهنك،
Dialogue: 0,0:20:46.73,0:20:48.23,Default,LILY,0,0,0,,الاستعداد.
Dialogue: 0,0:20:49.43,0:20:52.33,Default,LILY,0,0,0,,فهمت. بمجرد الانتهاء من ذلك،
Dialogue: 0,0:20:52.90,0:20:55.70,Default,LILY,0,0,0,,بالنسبة لي، سيكون الأمر أقل ما يدعو للقلق.
Dialogue: 0,0:20:56.40,0:20:57.44,Default,LILY,0,0,0,,نعم.
Dialogue: 0,0:20:58.24,0:21:01.01,Default,LILY,0,0,0,,لا يسمح بأي أخطاء هذه المرة.
Dialogue: 0,0:21:17.12,0:21:18.32,Default,LILY,0,0,0,,كيم بيونين
Dialogue: 0,0:21:19.56,0:21:21.13,Default,LILY,0,0,0,,أحاول العثور على شخص ما
Dialogue: 0,0:21:21.13,0:21:22.56,Default,LILY,0,0,0,,قطعة من ملابس الملك.
Dialogue: 0,0:21:29.23,0:21:30.94,Default,LILY,0,0,0,,لقد دمرت الملابس.
Dialogue: 0,0:21:31.44,0:21:34.54,Default,LILY,0,0,0,,لكن منذ أن اكتشفت الملكة الحقيقة...
Dialogue: 0,0:21:34.91,0:21:37.48,Default,LILY,0,0,0,,إذا اكتشفت بنين كل شيء وجاءت من أجلي،
Dialogue: 0,0:21:37.81,0:21:40.25,Default,LILY,0,0,0,,لذا فقد ارتكبت خطأ بشأن الملكة.
Dialogue: 0,0:21:40.25,0:21:42.45,Default,ZINA,0,0,0,,-مثل هذه الألعاب خطيرة جداً.\N-أعلم.
Dialogue: 0,0:21:43.52,0:21:46.08,Default,ZINA,0,0,0,,ولكن إذا كنت على حق،
Dialogue: 0,0:21:46.72,0:21:49.12,Default,ZINA,0,0,0,,فلن يعاني شخص بريء.
Dialogue: 0,0:21:53.96,0:21:56.93,Default,ZINA,0,0,0,,اليوم هو أول يوم لوالد زوجي في منصبه.
Dialogue: 0,0:22:07.04,0:22:08.04,Default,ZINA,0,0,0,,جلالتك.
Dialogue: 0,0:22:09.47,0:22:11.61,Default,ZINA,0,0,0,,ظننت أنك لا تزال في قاعة دايجون.
Dialogue: 0,0:22:11.88,0:22:13.58,Default,ZINA,0,0,0,,جئت هنا للتحقق.
Dialogue: 0,0:22:14.18,0:22:17.78,Default,ZINA,0,0,0,,أحتاج إلى مشاركة المعرفة المهمة مع الأمير يونبيونغ.
Dialogue: 0,0:22:22.82,0:22:24.16,Default,ZINA,0,0,0,,هل أنت مصدومة إلى هذا الحد؟
Dialogue: 0,0:22:29.69,0:22:31.00,Default,ZINA,0,0,0,,رئيس الخصي.
Dialogue: 0,0:22:33.17,0:22:34.20,Default,ZINA,0,0,0,,نعم.
Dialogue: 0,0:22:44.18,0:22:46.08,Default,ZINA,0,0,0,,يا له من مريض نفسي.
Dialogue: 0,0:22:46.24,0:22:48.81,Default,ZINA,0,0,0,,اعتقدت أنه مجرد أحمق، وهذا كله مجرد أداء.
Dialogue: 0,0:22:49.51,0:22:51.82,Default,ZINA,0,0,0,,هل حاول الملك قتل الملكة بيديه؟
Dialogue: 0,0:22:52.55,0:22:54.89,Default,ZINA,0,0,0,,إذا بدأت مثل هذه الفضيحة الضخمة،
Dialogue: 0,0:22:54.89,0:22:56.66,Default,ZINA,0,0,0,,سأجد نفسي في مركز الزلزال، وهذا أكثر خطورة.
Dialogue: 0,0:22:57.16,0:22:59.02,Default,ZINA,0,0,0,,سأنتظر حتى تمتلئ البحيرة.
Dialogue: 0,0:22:59.02,0:23:01.69,Default,ZINA,0,0,0,,وحتى ذلك الحين سأبقي رأسي منخفضًا وأعود إلى حياتي.
Dialogue: 0,0:23:03.40,0:23:04.86,Default,ZINA,0,0,0,,ربما تكون يداك مخدرتين.
Dialogue: 0,0:23:04.86,0:23:06.47,Default,ZINA,0,0,0,,استمر في التقاطع لفترة طويلة.
Dialogue: 0,0:23:07.60,0:23:09.37,Default,ZINA,0,0,0,,هذا يهدئني.
Dialogue: 0,0:23:13.87,0:23:16.21,Default,ZINA,0,0,0,,الأفكار لا تهدأ رغم أنني أريد أن أتوقف.
Dialogue: 0,0:23:17.21,0:23:18.94,Default,ZINA,0,0,0,,ماذا وضع في الشاي؟
Dialogue: 0,0:23:18.94,0:23:21.48,Default,ZINA,0,0,0,,كنت أعرف ذلك. لا يمكنك الاسترخاء لثانية واحدة.
Dialogue: 0,0:23:22.91,0:23:25.82,Default,ZINA,0,0,0,,لكن لو أراد القضاء عليّ، لكان بإمكانه ببساطة أن يسممني.
Dialogue: 0,0:23:26.55,0:23:27.62,Default,ZINA,0,0,0,,فلماذا...
Dialogue: 0,0:23:27.62,0:23:28.99,Default,ZINA,0,0,0,,إلى الجحيم.
Dialogue: 0,0:23:28.99,0:23:30.89,Default,ZINA,0,0,0,,لماذا يجب أن أقلق بشأن هذه المريضة؟
Dialogue: 0,0:23:32.76,0:23:34.59,Default,ZINA,0,0,0,,دعونا نتحقق من سير الأمور مع البحيرة.
Dialogue: 0,0:23:35.13,0:23:36.96,Default,ZINA,0,0,0,,هل لديك نوع من السوط؟
Dialogue: 0,0:23:36.96,0:23:38.46,Default,ZINA,0,0,0,,علينا أن نسرع ​​بهم.
Dialogue: 0,0:23:38.46,0:23:39.63,Default,ZINA,0,0,0,,جلالتك.
Dialogue: 0,0:23:46.40,0:23:49.04,Default,ZINA,0,0,0,,الملكة الأرملة تدعوك إلى مكانها.
Dialogue: 0,0:23:50.37,0:23:53.04,Default,ZINA,0,0,0,,لست بحاجة إليها الآن.
Dialogue: 0,0:23:53.04,0:23:54.05,Default,ZINA,0,0,0,,اللعنة.
Dialogue: 0,0:24:20.41,0:24:22.77,Default,ZINA,0,0,0,,مثير للغضب. ماذا تريد مني أكثر؟
Dialogue: 0,0:24:22.77,0:24:23.91,Default,ZINA,0,0,0,,اللعنة.
Dialogue: 0,0:24:56.17,0:24:59.28,Default,ZINA,0,0,0,,تابع. كل شيء سوف ينجح! شنق هناك.
Dialogue: 0,0:25:00.28,0:25:02.15,Default,ZINA,0,0,0,,ماذا تفعل؟ أسرع.
Dialogue: 0,0:25:02.15,0:25:04.42,Default,ZINA,0,0,0,,-هنا.\N-تحرك.
Dialogue: 0,0:25:04.72,0:25:06.12,Default,ZINA,0,0,0,,الكبد، أكثر حيوية.
Dialogue: 0,0:25:06.12,0:25:08.32,Default,ZINA,0,0,0,,أكثر حيوية. نحن بحاجة إلى عجل.
Dialogue: 0,0:25:08.32,0:25:10.06,Default,ZINA,0,0,0,,بسرعة. دعونا نسرع.
Dialogue: 0,0:25:10.06,0:25:12.26,Default,ZINA,0,0,0,,تابع.
Dialogue: 0,0:25:15.13,0:25:16.70,Default,ZINA,0,0,0,,كن حذراً. تحرك.
Dialogue: 0,0:25:18.90,0:25:21.07,Default,ZINA,0,0,0,,لا أستطيع التحمل بعد الآن.
Dialogue: 0,0:25:21.07,0:25:22.87,Default,ZINA,0,0,0,,أنا ذاهب إلى الحمام. سأعود قريبا.
Dialogue: 0,0:25:23.13,0:25:24.90,Default,ZINA,0,0,0,,هناك الكثير من العمل. أعود بسرعة.
Dialogue: 0,0:25:25.77,0:25:26.91,Default,ZINA,0,0,0,,أكثر حيوية.
Dialogue: 0,0:25:32.61,0:25:36.25,Default,ZINA,0,0,0,,سمعت أنك قادم، لذلك كنت أنتظرك.
Dialogue: 0,0:25:37.35,0:25:39.15,Default,ZINA,0,0,0,,ولكن ما الأمر؟
Dialogue: 0,0:25:39.52,0:25:43.96,Default,ZINA,0,0,0,,الملكة الأم مهتمة بك جداً.
Dialogue: 0,0:25:44.06,0:25:45.66,Default,ZINA,0,0,0,,إنه شرف لي.
Dialogue: 0,0:25:46.12,0:25:48.26,Default,ZINA,0,0,0,,سمعت أن أخاك الأصغر في العبودية
Dialogue: 0,0:25:48.26,0:25:49.96,Default,ZINA,0,0,0,,بسبب ديون الأسرة.
Dialogue: 0,0:25:49.96,0:25:52.76,Default,ZINA,0,0,0,,نعم. في العالم كله لم يبق لي سوى أخ.
Dialogue: 0,0:25:53.23,0:25:55.23,Default,ZINA,0,0,0,,سمعت أنك قلقة للغاية
Dialogue: 0,0:25:55.90,0:25:58.07,Default,ZINA,0,0,0,,وستفعل أي شيء لاستعادة
Dialogue: 0,0:25:58.07,0:25:59.37,Default,ZINA,0,0,0,,موقف أخيها.
Dialogue: 0,0:25:59.37,0:26:02.74,Default,ZINA,0,0,0,,أوفر المال بأسرع ما أستطيع.
Dialogue: 0,0:26:03.41,0:26:05.51,Default,ZINA,0,0,0,,لكن الدين كبير جداً.
Dialogue: 0,0:26:06.24,0:26:08.68,Default,ZINA,0,0,0,,لأن الملكة الأم تقدرك،
Dialogue: 0,0:26:08.68,0:26:10.12,Default,ZINA,0,0,0,,إنها تتقدم لخطبتك.
Dialogue: 0,0:26:11.15,0:26:13.89,Default,ZINA,0,0,0,,لن تتاح لك مثل هذه الفرصة مرة أخرى.
Dialogue: 0,0:26:18.42,0:26:19.72,Default,ZINA,0,0,0,,كم سيستغرق الأمر من الوقت؟
Dialogue: 0,0:26:20.99,0:26:22.49,Default,ZINA,0,0,0,,قليلاً.
Dialogue: 0,0:26:25.46,0:26:27.27,Default,ZINA,0,0,0,,اجعلها تعترف بذلك أيضاً.
Dialogue: 0,0:26:28.43,0:26:30.00,Default,ZINA,0,0,0,,الشخص الذي أرسل الرسالة،
Dialogue: 0,0:26:31.44,0:26:32.57,Default,ZINA,0,0,0,,الملكة الأم.
Dialogue: 0,0:26:34.74,0:26:35.77,Default,ZINA,0,0,0,,أنا أفهم.
Dialogue: 0,0:26:37.61,0:26:39.21,Default,ZINA,0,0,0,,إذا تحملت اللوم على هذا،
Dialogue: 0,0:26:39.21,0:26:41.91,Default,ZINA,0,0,0,,لن ننجو أنا وأخي.
Dialogue: 0,0:26:41.91,0:26:44.18,Default,ZINA,0,0,0,,لا داعي للقلق بشأن أخيك.
Dialogue: 0,0:26:44.45,0:26:45.62,Default,ZINA,0,0,0,,تفانيك
Dialogue: 0,0:26:45.62,0:26:48.39,Default,ZINA,0,0,0,,يمنحه حياة جديدة.
Dialogue: 0,0:26:48.62,0:26:49.69,Default,ZINA,0,0,0,,لكن...
Dialogue: 0,0:26:50.69,0:26:53.06,Default,ZINA,0,0,0,,إلى متى تعتقد،
Dialogue: 0,0:26:53.79,0:26:56.80,Default,ZINA,0,0,0,,هل سيتمكن من تحمل مثل هذه الحياة الصعبة؟
Dialogue: 0,0:26:57.33,0:27:00.93,Default,ZINA,0,0,0,,ماذا لو حدث شيء سيء غدًا، مثل حادث؟
Dialogue: 0,0:27:03.67,0:27:05.74,Default,ZINA,0,0,0,,هل هناك شيء سيء؟
Dialogue: 0,0:27:14.08,0:27:16.78,Default,ZINA,0,0,0,,لقد ناديتني يا صاحب الجلالة؟
Dialogue: 0,0:27:17.58,0:27:19.28,Default,ZINA,0,0,0,,لقد دعوتك،
Dialogue: 0,0:27:19.45,0:27:22.65,Default,ZINA,0,0,0,,لأنني أريد أن أعهد إليك بشيء مهم.
Dialogue: 0,0:27:22.85,0:27:25.09,Default,ZINA,0,0,0,,اللعنة، ماذا أيضاً؟ يا لها من متاعب.
Dialogue: 0,0:27:25.52,0:27:27.99,Default,ZINA,0,0,0,,من السابق لأوانه أن أتحمل المسؤولية في الأمور المهمة،
Dialogue: 0,0:27:27.99,0:27:30.46,Default,ZINA,0,0,0,,لأنه لا يزال هناك الكثير لنتعلمه.
Dialogue: 0,0:27:31.43,0:27:33.33,Default,ZINA,0,0,0,,نعم؟
Dialogue: 0,0:27:33.93,0:27:35.33,Default,ZINA,0,0,0,,يا للأسف.
Dialogue: 0,0:27:35.63,0:27:38.34,Default,ZINA,0,0,0,,أردت أن أختار أجمل المحظيات للملك،
Dialogue: 0,0:27:38.34,0:27:41.57,Default,ZINA,0,0,0,,من يستطيع أن يدهش الملك ويسحره.
Dialogue: 0,0:27:41.84,0:27:43.74,Default,ZINA,0,0,0,,أعتقد أنه ليس هناك خيار سوى اكتشاف ذلك بنفسك.
Dialogue: 0,0:27:44.78,0:27:45.81,Default,ZINA,0,0,0,,قال منجزي،
Dialogue: 0,0:27:46.08,0:27:48.38,Default,ZINA,0,0,0,,أن الأشخاص الفاضلين يتمتعون بالدعم.
Dialogue: 0,0:27:48.38,0:27:49.81,Default,ZINA,0,0,0,,طوّر الفضيلة - سوف تحصل على المساعدة.
Dialogue: 0,0:27:50.22,0:27:51.68,Default,ZINA,0,0,0,,على الرغم من أن لدي الكثير لأتعلمه،
Dialogue: 0,0:27:51.68,0:27:54.19,Default,ZINA,0,0,0,,الكثيرون مستعدون لمساعدتي\Nبفضل فضيلتي.
Dialogue: 0,0:27:55.12,0:27:57.36,Default,ZINA,0,0,0,,لذا سأبذل قصارى جهدي.
Dialogue: 0,0:27:57.96,0:27:59.06,Default,ZINA,0,0,0,,بالمناسبة،
Dialogue: 0,0:27:59.42,0:28:02.26,Default,ZINA,0,0,0,,ما هو الحد الأقصى لعدد المحظيات؟
Dialogue: 0,0:28:03.33,0:28:04.40,Default,ZINA,0,0,0,,الحد الأقصى؟
Dialogue: 0,0:28:04.66,0:28:07.13,Default,ZINA,0,0,0,,حسناً، أعني كم عددهم؟
Dialogue: 0,0:28:07.33,0:28:10.07,Default,ZINA,0,0,0,,هل يمكننا الاختيار؟
Dialogue: 0,0:28:10.74,0:28:13.34,Default,ZINA,0,0,0,,لا أعرف حتى. وفقا للكلاسيكيات ،
Dialogue: 0,0:28:13.47,0:28:16.84,Default,ZINA,0,0,0,,يجب أن يكون هناك 6 محظيات من المرتبة الأولى، و3 من الثانية،
Dialogue: 0,0:28:16.84,0:28:19.44,Default,ZINA,0,0,0,,9 الثالثة، 27 الرابعة،
Dialogue: 0,0:28:19.44,0:28:21.65,Default,ZINA,0,0,0,,و81 خامسًا،
Dialogue: 0,0:28:21.65,0:28:24.28,Default,ZINA,0,0,0,,-من سيخدم الملك.\N-هيا.
Dialogue: 0,0:28:24.72,0:28:27.42,Default,ZINA,0,0,0,,6 زائد 3.
Dialogue: 0,0:28:27.92,0:28:29.02,Default,ZINA,0,0,0,,9.
Dialogue: 0,0:28:29.55,0:28:30.76,Default,ZINA,0,0,0,,27.
Dialogue: 0,0:28:31.26,0:28:32.62,Default,ZINA,0,0,0,,و81؟
Dialogue: 0,0:28:33.53,0:28:36.16,Default,ZINA,0,0,0,,لكننا بحاجة إلى ضبط النفس، سنختار 3 فقط.
Dialogue: 0,0:28:36.33,0:28:37.63,Default,ZINA,0,0,0,,اللعنة.
Dialogue: 0,0:28:39.73,0:28:40.97,Default,ZINA,0,0,0,,ممتاز!
Dialogue: 0,0:28:41.50,0:28:43.57,Default,ZINA,0,0,0,,بالتأكيد.
Dialogue: 0,0:28:44.40,0:28:45.97,Default,ZINA,0,0,0,,جلالته لديه محظية بالفعل،
Dialogue: 0,0:28:45.97,0:28:48.04,Default,ZINA,0,0,0,,تحتاج إلى تحديد 2 آخرين، أليس كذلك؟
Dialogue: 0,0:28:48.04,0:28:50.54,Default,ZINA,0,0,0,,لا، سنختار 3.
Dialogue: 0,0:28:51.68,0:28:54.91,Default,ZINA,0,0,0,,أحضرت المحظية معها سيدة البلاط أوفول.
Dialogue: 0,0:28:55.11,0:28:57.28,Default,ZINA,0,0,0,,نعم، تلك الفتاة التي تجري خلفها.
Dialogue: 0,0:28:57.65,0:28:59.32,Default,ZINA,0,0,0,,لقد قالت شيئاً مجنوناً
Dialogue: 0,0:28:59.65,0:29:01.79,Default,ZINA,0,0,0,,من باب الإخلاص للمحظية.
Dialogue: 0,0:29:02.49,0:29:04.86,Default,ZINA,0,0,0,,لماذا قفزت إلى البحيرة
Dialogue: 0,0:29:04.86,0:29:07.29,Default,ZINA,0,0,0,,أمام تشو هواجين مباشرةً للتشهير بها.
Dialogue: 0,0:29:07.29,0:29:08.66,Default,ZINA,0,0,0,,انشروا مثل هذه الشائعات.
Dialogue: 0,0:29:09.63,0:29:13.63,Default,ZINA,0,0,0,,الملك كذب لحماية هواجين، وقد دمرت كل شيء.
Dialogue: 0,0:29:14.57,0:29:15.57,Default,ZINA,0,0,0,,ملك؟
Dialogue: 0,0:29:15.57,0:29:18.54,Default,ZINA,0,0,0,,سأحرم الملك من لعبته المفضلة،
Dialogue: 0,0:29:18.54,0:29:21.01,Default,ZINA,0,0,0,,لذلك أريد أن أعطيه أشياء جديدة.
Dialogue: 0,0:29:23.31,0:29:27.78,Default,ZINA,0,0,0,,نعم. وأريدك أيضًا أن تعد لي الغداء.
Dialogue: 0,0:29:27.78,0:29:31.05,Default,ZINA,0,0,0,,لم يعد بإمكاني تناول شيء أعده شخص آخر.
Dialogue: 0,0:29:31.98,0:29:34.15,Default,ZINA,0,0,0,,اللعنة، هذا ليس جيدًا إلى حدٍ ما.
Dialogue: 0,0:29:38.42,0:29:40.66,Default,ZINA,0,0,0,,وإذا تناولت طعاماً صحياً أحضّره كل يوم
Dialogue: 0,0:29:41.29,0:29:43.40,Default,ZINA,0,0,0,,وستبدو أصغر مني؟
Dialogue: 0,0:29:43.76,0:29:45.83,Default,ZINA,0,0,0,,لا أحب هذا.
Dialogue: 0,0:29:54.44,0:29:57.58,Default,ZINA,0,0,0,,عليك أن تحافظ على علاقات جيدة معها حتى تمتلئ البحيرة.
Dialogue: 0,0:30:02.74,0:30:05.34,Default,ZINA,0,0,0,,حدث كل شيء تمامًا كما أرادت "كيم سو يون".
Dialogue: 0,0:30:06.08,0:30:08.11,Default,ZINA,0,0,0,,لقد قادت هواجين إلى فخ حقيقي.
Dialogue: 0,0:30:09.55,0:30:11.88,Default,ZINA,0,0,0,,مرحبًا يا فتاة. وهذا سوف يعود ليطاردك.
Dialogue: 0,0:30:13.18,0:30:14.92,Default,ZINA,0,0,0,,أشعر بالأسف على هواجين.
Dialogue: 0,0:30:15.89,0:30:18.06,Default,ZINA,0,0,0,,ولكن ما الفرق؟ \NI لن أهتم عندما أعود.
Dialogue: 0,0:30:18.06,0:30:19.56,Default,ZINA,0,0,0,,ليس هناك وقت للقلق بشأن الآخرين بعد.
Dialogue: 0,0:30:19.56,0:30:21.46,Default,ZINA,0,0,0,,عليك أن ترتب نفسك أولاً.
Dialogue: 0,0:30:23.29,0:30:24.53,Default,ZINA,0,0,0,,أكثر حيوية.
Dialogue: 0,0:30:24.93,0:30:28.40,Default,ZINA,0,0,0,,يمكنكم أن تأخذوا وقتكم.
Dialogue: 0,0:30:28.53,0:30:30.20,Default,ZINA,0,0,0,,سوف تصطدم مرة أخرى وتصاب.
Dialogue: 0,0:30:33.81,0:30:35.04,Default,ZINA,0,0,0,,كبد، أكثر حيوية!
Dialogue: 0,0:30:37.21,0:30:39.78,Default,ZINA,0,0,0,,كبد، أكثر حيوية!
Dialogue: 0,0:30:40.01,0:30:42.91,Default,ZINA,0,0,0,,كبد، أكثر حيوية! نعم نعم! حتى أكثر على قيد الحياة!
Dialogue: 0,0:31:00.97,0:31:03.23,Default,ZINA,0,0,0,,هذا كل شيء!
Dialogue: 0,0:31:13.48,0:31:15.11,Default,ZINA,0,0,0,,اللعنة، هذا رائع.
Dialogue: 0,0:31:15.48,0:31:17.85,Default,ZINA,0,0,0,,فقط المجتمع الراقي لديه مثل هذه الأشياء الجيدة.
Dialogue: 0,0:31:18.75,0:31:21.25,Default,ZINA,0,0,0,,الحرس الملكي.
Dialogue: 0,0:31:23.96,0:31:25.56,Default,ZINA,0,0,0,,رائع!
Dialogue: 0,0:31:32.10,0:31:33.57,Default,ZINA,0,0,0,,مرحباً سيد كيم.
Dialogue: 0,0:31:33.57,0:31:35.97,Default,ZINA,0,0,0,,اليوم الماضي، أليس كذلك؟
Dialogue: 0,0:31:36.23,0:31:38.10,Default,ZINA,0,0,0,,كئيب على الأرجح.
Dialogue: 0,0:31:38.10,0:31:41.57,Default,ZINA,0,0,0,,لا، أنا متأكد من أنه يمكنك القيام بعمل أفضل بكثير.
Dialogue: 0,0:31:41.74,0:31:42.87,Default,ZINA,0,0,0,,أوه أنت.
Dialogue: 0,0:31:46.61,0:31:48.45,Default,ZINA,0,0,0,,يا له من حصان رائع.
Dialogue: 0,0:31:51.45,0:31:54.49,Default,ZINA,0,0,0,,هذه هدية من جلالة الملك إلى قائد الحرس الملكي.
Dialogue: 0,0:31:55.02,0:31:56.29,Default,ZINA,0,0,0,,اجلس.
Dialogue: 0,0:31:56.42,0:32:00.23,Default,ZINA,0,0,0,,هيا. كم سنة مرت منذ آخر مرة ركبت فيها حصانًا؟
Dialogue: 0,0:32:00.56,0:32:04.30,Default,ZINA,0,0,0,,والمنصب ليس ملكي رسمياً،\Nuntil سأحصل على شهادة اليوم.
Dialogue: 0,0:32:05.06,0:32:07.27,Default,ZINA,0,0,0,,-حسناً، في المرة القادمة.\N-نعم.
Dialogue: 0,0:32:08.23,0:32:12.10,Default,ZINA,0,0,0,,أوه، سيد كيم. هل تستطيع ركوب الخيل؟
Dialogue: 0,0:32:13.67,0:32:14.74,Default,ZINA,0,0,0,,من أنت؟
Dialogue: 0,0:32:17.41,0:32:19.48,Default,ZINA,0,0,0,,أنا أفضل صديق لجلالة الملك.
Dialogue: 0,0:32:19.48,0:32:22.28,Default,ZINA,0,0,0,,والخادمات تعتبرني\None من بين الخمسة الأكثر سحراً...
Dialogue: 0,0:32:22.28,0:32:25.25,Default,ZINA,0,0,0,,لست بحاجة إلى معرفة من هو.
Dialogue: 0,0:32:25.58,0:32:27.65,Default,ZINA,0,0,0,,لم يتم تضمين الأمير يونبيونغ حتى في التقييم.
Dialogue: 0,0:32:27.92,0:32:30.29,Default,ZINA,0,0,0,,لكن لياقتك البدنية
Dialogue: 0,0:32:30.29,0:32:32.79,Default,ZINA,0,0,0,,ليس مناسباً جداً لركوب الخيل.
Dialogue: 0,0:32:32.86,0:32:34.86,Default,ZINA,0,0,0,,ويا له من حصان طويل.
Dialogue: 0,0:32:34.86,0:32:36.83,Default,ZINA,0,0,0,,على الأقل تقفز عليها بساقيك القصيرتين؟
Dialogue: 0,0:32:41.37,0:32:42.43,Default,ZINA,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:32:42.67,0:32:44.00,Default,ZINA,0,0,0,,نعم في زمان
Dialogue: 0,0:32:44.70,0:32:46.44,Default,ZINA,0,0,0,,كنت أقفز دون يدي.
Dialogue: 0,0:32:46.44,0:32:48.37,Default,ZINA,0,0,0,,إلى هذا الحد كان بارعاً.
Dialogue: 0,0:32:48.37,0:32:50.01,Default,ZINA,0,0,0,,كان يجلس منفرجاً على كرسي.
Dialogue: 0,0:32:50.01,0:32:53.21,Default,ZINA,0,0,0,,في أحد الأيام نمت على حصان ورأيت أحلاماً.
Dialogue: 0,0:32:55.28,0:32:56.58,Default,ZINA,0,0,0,,نعم، أنا جاد.
Dialogue: 0,0:32:56.92,0:32:59.02,Default,ZINA,0,0,0,,سأثبت لك ذلك. ها أنت ذا.
Dialogue: 0,0:33:02.52,0:33:05.36,Default,ZINA,0,0,0,,ليس عليك أن تفعل هذا.\N لا تجبر نفسك.
Dialogue: 0,0:33:05.36,0:33:07.33,Default,ZINA,0,0,0,,أوه، اخرس!
Dialogue: 0,0:33:07.86,0:33:09.83,Default,ZINA,0,0,0,,لا يزال بإمكاني ذلك.
Dialogue: 0,0:33:14.37,0:33:15.60,Default,ZINA,0,0,0,,يبدو الأمر خاطئًا.
Dialogue: 0,0:33:17.27,0:33:20.17,Default,ZINA,0,0,0,,مرحبًا، هل يمكنك...
Dialogue: 0,0:33:20.41,0:33:22.31,Default,ZINA,0,0,0,,هذا كل شيء.
Dialogue: 0,0:33:27.15,0:33:29.75,Default,ZINA,0,0,0,,ماذا رأيت؟ لا يمكن أن يكون الأمر أكثر بساطة.
Dialogue: 0,0:33:42.86,0:33:45.23,Default,ZINA,0,0,0,,أوه يا أمهات.
Dialogue: 0,0:33:47.10,0:33:48.23,Default,ZINA,0,0,0,,تم القبض عليه.
Dialogue: 0,0:34:00.18,0:34:03.18,Default,ZINA,0,0,0,,أوه، أيتها القطة الكبيرة.
Dialogue: 0,0:34:04.05,0:34:05.48,Default,ZINA,0,0,0,,أوه يا أمهات.
Dialogue: 0,0:34:05.48,0:34:08.12,Default,ZINA,0,0,0,,-السيد. كيم!\N-My الساقين! الساقين!
Dialogue: 0,0:34:08.12,0:34:10.42,Default,ZINA,0,0,0,,أقدام صغيرة!
Dialogue: 0,0:34:10.52,0:34:13.26,Default,ZINA,0,0,0,,البطاطا والملح والحليب.
Dialogue: 0,0:34:14.29,0:34:15.36,Default,ZINA,0,0,0,,الحليب؟
Dialogue: 0,0:34:16.13,0:34:17.86,Default,ZINA,0,0,0,,لم أسمع بهذا من قبل.
Dialogue: 0,0:34:19.86,0:34:21.47,Default,ZINA,0,0,0,,يُسمى أيضًا الحليب.
Dialogue: 0,0:34:21.67,0:34:22.87,Default,ZINA,0,0,0,,فهمت.
Dialogue: 0,0:34:22.87,0:34:25.44,Default,ZINA,0,0,0,,هذا المكوّن النادر،\Nit يغوص كالماء.
Dialogue: 0,0:34:25.44,0:34:26.94,Default,ZINA,0,0,0,,لن يكون لديك نفط.
Dialogue: 0,0:34:28.41,0:34:29.47,Default,ZINA,0,0,0,,هل لديك فلفل أسود؟
Dialogue: 0,0:34:29.64,0:34:30.91,Default,ZINA,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:34:31.38,0:34:35.05,Default,ZINA,0,0,0,,أثمن من الذهب، لكنه يغوص كالرمل.
Dialogue: 0,0:34:35.05,0:34:38.02,Default,ZINA,0,0,0,,لكنها لن تستمع إلي،\Nلذلك لن أقول أي شيء.
Dialogue: 0,0:34:39.88,0:34:41.02,Default,ZINA,0,0,0,,أسمع، حسنًا؟
Dialogue: 0,0:34:43.66,0:34:46.22,Default,ZINA,0,0,0,,-جلالتك!\N-أوه، أنت.
Dialogue: 0,0:34:46.22,0:34:49.13,Default,ZINA,0,0,0,,قلت لك ألا تتعجل. لماذا ركضت؟
Dialogue: 0,0:34:51.86,0:34:54.33,Default,ZINA,0,0,0,,كانت سيدة البلاط تشوي أيضًا في عجلة من أمرها هنا.
Dialogue: 0,0:34:54.73,0:34:57.17,Default,ZINA,0,0,0,,إنها ليست صغيرة. ماذا لو أغمي عليك وانهارت أثناء الجري؟
Dialogue: 0,0:34:57.17,0:34:59.17,Default,ZINA,0,0,0,,أنا هناك!
Dialogue: 0,0:35:01.07,0:35:03.04,Default,ZINA,0,0,0,,ربما أنا بطيء بعض الشيء،
Dialogue: 0,0:35:03.04,0:35:05.14,Default,ZINA,0,0,0,,لكنني لن أُغمي عليّ أبداً.
Dialogue: 0,0:35:12.85,0:35:14.05,Default,ZINA,0,0,0,,يا لها من سيدة عنيدة.
Dialogue: 0,0:35:18.62,0:35:21.43,Default,ZINA,0,0,0,,-حسناً، اسكبها.\N-نعم يا صاحب الجلالة.
Dialogue: 0,0:35:32.84,0:35:33.87,Default,ZINA,0,0,0,,وهذا كل شيء؟
Dialogue: 0,0:35:35.04,0:35:37.91,Default,ZINA,0,0,0,,هل تمزح معي؟\N-حسناً، الأمر...
Dialogue: 0,0:35:37.94,0:35:41.71,Default,ZINA,0,0,0,,يا صاحب الجلالة، هذا شيء نادر جدًا.
Dialogue: 0,0:35:41.98,0:35:43.82,Default,ZINA,0,0,0,,لهذا السبب أحتاجه.
Dialogue: 0,0:35:44.12,0:35:45.82,Default,ZINA,0,0,0,,في الطبخ، المنتجات هي التي تقرر كل شيء.
Dialogue: 0,0:35:46.15,0:35:49.42,Default,ZINA,0,0,0,,إذا حلبت كل شيء، فإن العجول سوف تموت جوعاً.
Dialogue: 0,0:35:49.89,0:35:51.39,Default,ZINA,0,0,0,,والإهتمام أيضاً.
Dialogue: 0,0:35:51.46,0:35:53.29,Default,ZINA,0,0,0,,اللعنة أيها الحزن.
Dialogue: 0,0:35:54.56,0:35:56.13,Default,ZINA,0,0,0,,هل سمعت عن أيام الصيام؟
Dialogue: 0,0:35:56.13,0:35:58.26,Default,ZINA,0,0,0,,الصيام المتقطع مفيد لصحتك.
Dialogue: 0,0:35:59.73,0:36:01.83,Default,ZINA,0,0,0,,املأ مرجلتي من هنا.
Dialogue: 0,0:36:02.40,0:36:05.14,Default,ZINA,0,0,0,,كن أقل قطرة واحدة على الأقل... أتعلم، أليس كذلك؟
Dialogue: 0,0:36:08.91,0:36:10.24,Default,ZINA,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:36:16.08,0:36:17.18,Default,ZINA,0,0,0,,همممم.
Dialogue: 0,0:36:19.68,0:36:20.82,Default,ZINA,0,0,0,,من أنت؟
Dialogue: 0,0:36:21.22,0:36:22.82,Default,ZINA,0,0,0,,كيف تجرؤ الفتاة على الظهور...
Dialogue: 0,0:36:32.76,0:36:33.80,Default,ZINA,0,0,0,,تعال هنا.
Dialogue: 0,0:36:38.60,0:36:39.70,Default,ZINA,0,0,0,,ما اسمك؟
Dialogue: 0,0:36:39.70,0:36:41.31,Default,ZINA,0,0,0,,دمهيان.
Dialogue: 0,0:36:42.31,0:36:43.94,Default,ZINA,0,0,0,,أنت تربي جروًا في القصر.
Dialogue: 0,0:36:44.61,0:36:47.61,Default,ZINA,0,0,0,,الكلب له مكانة أعلى مني.
Dialogue: 0,0:36:48.01,0:36:50.65,Default,ZINA,0,0,0,,المبعوثون من مين. أحضر الكلب.
Dialogue: 0,0:36:50.65,0:36:53.25,Default,ZINA,0,0,0,,قالوا إنها سلالة نادرة أو شيء من هذا القبيل.
Dialogue: 0,0:36:54.79,0:36:57.12,Default,ZINA,0,0,0,,مين؟ كان هذا قبل 200 عام.
Dialogue: 0,0:36:58.32,0:37:00.73,Default,ZINA,0,0,0,,إذا اختلطت السلالة خلال هذه القرون مع الآخرين،
Dialogue: 0,0:37:00.73,0:37:03.13,Default,ZINA,0,0,0,,إذن فهو مجرد هجين.
Dialogue: 0,0:37:04.36,0:37:05.66,Default,TIRAMISU,0,0,0,,وما اسمه؟
Dialogue: 0,0:37:05.96,0:37:07.90,Default,TIRAMISU,0,0,0,,الكلب ليس له اسم بعد.
Dialogue: 0,0:37:07.90,0:37:09.57,Default,TIRAMISU,0,0,0,,حقاً؟ ثم
Dialogue: 0,0:37:10.70,0:37:13.24,Default,TIRAMISU,0,0,0,,-لنسميه الشيطان.\N-الشيطان؟
Dialogue: 0,0:37:13.50,0:37:14.51,Default,TIRAMISU,0,0,0,,انظر.
Dialogue: 0,0:37:15.17,0:37:16.94,Default,TIRAMISU,0,0,0,,لذا، دعونا نكتب.
Dialogue: 0,0:37:18.91,0:37:23.61,Default,TIRAMISU,0,0,0,,P - E - S. استبدل p بالحرف الساكن المقترن.
Dialogue: 0,0:37:23.81,0:37:25.42,Default,TIRAMISU,0,0,0,,PES
Dialogue: 0,0:37:25.44,0:37:26.52,Default,TIRAMISU,0,0,0,,B
Dialogue: 0,0:37:27.69,0:37:28.75,Default,TIRAMISU,0,0,0,,E
Dialogue: 0,0:37:29.65,0:37:31.92,Default,TIRAMISU,0,0,0,,ولدينا شيطان.
Dialogue: 0,0:37:32.36,0:37:33.69,Default,TIRAMISU,0,0,0,,لذلك شيطان.
Dialogue: 0,0:37:33.69,0:37:36.06,Default,TIRAMISU,0,0,0,,الآن فهمت.
Dialogue: 0,0:37:40.33,0:37:42.53,Default,TIRAMISU,0,0,0,,أنت تأتي إلى هنا كثيرًا، ربما جائعًا.
Dialogue: 0,0:37:44.60,0:37:45.67,Default,TIRAMISU,0,0,0,,انتظر لحظة.
Dialogue: 0,0:37:48.51,0:37:49.54,Default,TIRAMISU,0,0,0,,لذا.
Dialogue: 0,0:37:53.04,0:37:54.31,Default,TIRAMISU,0,0,0,,فويلا.
Dialogue: 0,0:37:57.92,0:37:58.98,Default,TIRAMISU,0,0,0,,جربها.
Dialogue: 0,0:38:02.02,0:38:03.09,Default,TIRAMISU,0,0,0,,هنا.
Dialogue: 0,0:38:09.03,0:38:10.19,Default,TIRAMISU,0,0,0,,لماذا لا تأكل؟
Dialogue: 0,0:38:10.19,0:38:12.90,Default,TIRAMISU,0,0,0,,لأنها جميلة جداً.
Dialogue: 0,0:38:14.43,0:38:16.17,Default,TIRAMISU,0,0,0,,لا تقلق. هذا ليس بالمجان
Dialogue: 0,0:38:16.17,0:38:18.50,Default,TIRAMISU,0,0,0,,بمجرد أن تأكلها، ساعدني في تناول البطاطس.
Dialogue: 0,0:38:18.50,0:38:19.54,Default,TIRAMISU,0,0,0,,لا يمكنك فعل ذلك.
Dialogue: 0,0:38:20.67,0:38:23.24,Default,TIRAMISU,0,0,0,,أنا مستعد لتحمل وجودك، لأنك ملكة.
Dialogue: 0,0:38:23.24,0:38:24.78,Default,TIRAMISU,0,0,0,,لفترة طويلة، لم تجرؤ النساء على ذلك
Dialogue: 0,0:38:24.78,0:38:26.81,Default,TIRAMISU,0,0,0,,المس الطعام الملكي.
Dialogue: 0,0:38:26.81,0:38:28.41,Default,TIRAMISU,0,0,0,,يُسمح لهم بتزيين الأطباق
Dialogue: 0,0:38:28.41,0:38:29.81,Default,TIRAMISU,0,0,0,,وقدمها على الطاولة.
Dialogue: 0,0:38:29.81,0:38:32.15,Default,TIRAMISU,0,0,0,,بلا جذور وبدون منصب رسمي...
Dialogue: 0,0:38:33.38,0:38:34.52,Default,TIRAMISU,0,0,0,,هذا الطفل
Dialogue: 0,0:38:34.52,0:38:38.19,Default,TIRAMISU,0,0,0,,لا يمكنه المساعدة في الطهي.
Dialogue: 0,0:38:40.79,0:38:43.36,Default,TIRAMISU,0,0,0,,يا لها من ضرطة قديمة.
Dialogue: 0,0:38:44.66,0:38:47.20,Default,TIRAMISU,0,0,0,,وأنت تحاول ذلك. "ضرطة قديمة".
Dialogue: 0,0:38:47.20,0:38:49.03,Default,TIRAMISU,0,0,0,,-ضرطة قديمة.\N-ماذا؟
Dialogue: 0,0:38:49.03,0:38:51.84,Default,TIRAMISU,0,0,0,,واو، لقد قلت ذلك بوضوح.
Dialogue: 0,0:38:52.90,0:38:54.57,Default,TIRAMISU,0,0,0,,الآن أطلق عليه الريح العجوز.
Dialogue: 0,0:38:55.37,0:38:56.57,Default,TIRAMISU,0,0,0,,لا تشتت انتباهك. يأكل.
Dialogue: 0,0:39:01.18,0:39:03.71,Default,TIRAMISU,0,0,0,,أشعر وكأنني آكل سحابة.
Dialogue: 0,0:39:05.25,0:39:07.29,Default,TIRAMISU,0,0,0,,مقارنة ممتازة.
Dialogue: 0,0:39:07.65,0:39:09.79,Default,TIRAMISU,0,0,0,,يمكنك استضافة العرض.
Dialogue: 0,0:39:10.66,0:39:11.69,Default,TIRAMISU,0,0,0,,Pf.
Dialogue: 0,0:39:13.16,0:39:15.63,Default,TIRAMISU,0,0,0,,بالمناسبة، أليست صغيرة جدًا على القصر؟
Dialogue: 0,0:39:16.69,0:39:18.86,Default,TIRAMISU,0,0,0,,والداها لم يدفعا الضرائب،
Dialogue: 0,0:39:18.86,0:39:20.10,Default,TIRAMISU,0,0,0,,فتمت إزالته.
Dialogue: 0,0:39:20.10,0:39:22.03,Default,TIRAMISU,0,0,0,,أصبح كل فرد في عائلتها عبيداً،
Dialogue: 0,0:39:22.63,0:39:25.64,Default,TIRAMISU,0,0,0,,وهرب والدها المزعوم جباناً.
Dialogue: 0,0:39:25.64,0:39:28.04,Default,TIRAMISU,0,0,0,,واو. أي نوع من الأب هذا؟
Dialogue: 0,0:39:29.41,0:39:30.51,Default,TIRAMISU,0,0,0,,Royal Chef.
Dialogue: 0,0:39:31.38,0:39:32.78,Default,TIRAMISU,0,0,0,,هل ليس لديك ضمير على الإطلاق؟
Dialogue: 0,0:39:35.51,0:39:36.65,Default,TIRAMISU,0,0,0,,دامهيان.
Dialogue: 0,0:39:36.65,0:39:39.62,Default,TIRAMISU,0,0,0,,لا تنتبه لكل الأشياء السيئة، حسنًا؟
Dialogue: 0,0:39:42.42,0:39:43.62,Default,TIRAMISU,0,0,0,,دو-سرطان.
Dialogue: 0,0:39:44.32,0:39:45.36,Default,TIRAMISU,0,0,0,,كرر.
Dialogue: 0,0:39:45.99,0:39:47.12,Default,TIRAMISU,0,0,0,,أحمق.
Dialogue: 0,0:39:47.99,0:39:50.33,Default,TIRAMISU,0,0,0,,ماذا؟ أحمق؟
Dialogue: 0,0:39:50.49,0:39:51.66,Default,TIRAMISU,0,0,0,,أحمق!
Dialogue: 0,0:40:04.68,0:40:07.24,Default,TIRAMISU,0,0,0,,لماذا كرات البطاطس كبيرة جدًا؟
Dialogue: 0,0:40:07.88,0:40:09.78,Default,TIRAMISU,0,0,0,,متى سيحضرون الحليب؟
Dialogue: 0,0:40:10.61,0:40:11.75,Default,TIRAMISU,0,0,0,,جلالتك.
Dialogue: 0,0:40:14.22,0:40:19.32,Default,TIRAMISU,0,0,0,,حلبت كل الأبقار حتى آخر قطرة.
Dialogue: 0,0:40:24.40,0:40:26.26,Default,TIRAMISU,0,0,0,,أحسنت.
Dialogue: 0,0:40:27.50,0:40:28.73,Default,TIRAMISU,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:40:36.21,0:40:37.74,Default,TIRAMISU,0,0,0,,عصيدة الحليب.
Dialogue: 0,0:40:46.05,0:40:48.49,Default,TIRAMISU,0,0,0,,لماذا تضيف البطاطس إلى عصيدةك؟
Dialogue: 0,0:40:48.49,0:40:49.62,Default,TIRAMISU,0,0,0,,كيف ذلك.
Dialogue: 0,0:40:49.79,0:40:52.06,Default,TIRAMISU,0,0,0,,هل أنت حماتي؟
Dialogue: 0,0:40:52.06,0:40:53.92,Default,TIRAMISU,0,0,0,,لا ينبغي على الحموات أن تتدخل مع زوجات أبنائهن.
Dialogue: 0,0:40:54.96,0:40:55.96,Default,TIRAMISU,0,0,0,,ماذا؟
Dialogue: 0,0:40:56.19,0:40:58.76,Default,TIRAMISU,0,0,0,,لماذا لا تعبث الحموات مع زوجات أبنائهن؟
Dialogue: 0,0:40:58.76,0:41:00.26,Default,TIRAMISU,0,0,0,,هذا خطأ.
Dialogue: 0,0:41:07.17,0:41:08.17,Default,TIRAMISU,0,0,0,,حسنًا.
Dialogue: 0,0:41:20.72,0:41:22.72,Default,TIRAMISU,0,0,0,,سأحضره لها شخصياً.
Dialogue: 0,0:41:54.79,0:41:56.02,Default,TIRAMISU,0,0,0,,ببساطة لذيذة.
Dialogue: 0,0:41:59.42,0:42:00.52,Default,TIRAMISU,0,0,0,,ومع ذلك,
Dialogue: 0,0:42:01.56,0:42:04.26,Default,TIRAMISU,0,0,0,,عندما تبرد البطاطس، تصبح قاسية.
Dialogue: 0,0:42:04.83,0:42:07.67,Default,TIRAMISU,0,0,0,,وتناثرت عصيدة الحليب على الطبق.
Dialogue: 0,0:42:07.67,0:42:09.20,Default,TIRAMISU,0,0,0,,هذا كله بالطبع غير سار.
Dialogue: 0,0:42:09.60,0:42:10.67,Default,TIRAMISU,0,0,0,,لكنني أفهم
Dialogue: 0,0:42:11.44,0:42:13.47,Default,TIRAMISU,0,0,0,,لا أحد مثالي.
Dialogue: 0,0:42:18.28,0:42:19.94,Default,TIRAMISU,0,0,0,,من المستحيل تحضير الطبق المثالي
Dialogue: 0,0:42:19.94,0:42:21.71,Default,TIRAMISU,0,0,0,,بدون خدمة مناسبة.
Dialogue: 0,0:42:22.78,0:42:24.95,Default,TIRAMISU,0,0,0,,كيف أقدم الطبق دون أن يبرد
Dialogue: 0,0:42:24.95,0:42:26.78,Default,TIRAMISU,0,0,0,,ولم ينسكب؟
Dialogue: 0,0:42:26.78,0:42:28.32,Default,TIRAMISU,0,0,0,,هذا هو السؤال الرئيسي.
Dialogue: 0,0:43:20.97,0:43:22.51,Default,TIRAMISU,0,0,0,,دعونا نسأل الخبراء.
Dialogue: 0,0:43:26.51,0:43:27.51,Default,TIRAMISU,0,0,0,,خذها.
Dialogue: 0,0:43:27.51,0:43:29.05,Default,TIRAMISU,0,0,0,,لماذا لم تلصق هذا بعد؟
Dialogue: 0,0:43:29.05,0:43:30.71,Default,TIRAMISU,0,0,0,,أما زلت لم تنته بعد؟
Dialogue: 0,0:43:30.71,0:43:32.95,Default,TIRAMISU,0,0,0,,-ماذا تفعل؟\N-أسرع.
Dialogue: 0,0:43:36.19,0:43:40.19,Default,TIRAMISU,0,0,0,,-جلالتك.\N-جلالتك.
Dialogue: 0,0:43:40.19,0:43:41.23,Default,TIRAMISU,0,0,0,,جلالتك.
Dialogue: 0,0:43:45.86,0:43:48.70,Default,TIRAMISU,0,0,0,,بالانكوين. أحتاج إلى بالانكوين للطعام.
Dialogue: 0,0:43:48.70,0:43:49.70,Default,TIRAMISU,0,0,0,,جلالتك.
Dialogue: 0,0:43:50.07,0:43:52.14,Default,TIRAMISU,0,0,0,,جلالتك.
Dialogue: 0,0:43:52.47,0:43:53.57,Default,TIRAMISU,0,0,0,,بالانكوين للطعام؟
Dialogue: 0,0:43:53.57,0:43:55.31,Default,TIRAMISU,0,0,0,,-بالانكوين للطعام؟\N-بالانكوين للطعام؟
Dialogue: 0,0:43:55.31,0:43:57.54,Default,TIRAMISU,0,0,0,,-أي نوع من المحفّة المخصصة للطعام؟\N-المحمولة المخصصة للطعام؟
Dialogue: 0,0:43:58.84,0:44:00.78,Default,TIRAMISU,0,0,0,,بالانكوين للطعام؟
Dialogue: 0,0:44:00.78,0:44:02.68,Default,TIRAMISU,0,0,0,,-ماذا؟\N-A بالانكوين للطعام؟
Dialogue: 0,0:44:02.95,0:44:04.38,Default,TIRAMISU,0,0,0,,-ماذا تهمس هناك؟\N-A palanquin للطعام؟
Dialogue: 0,0:44:05.65,0:44:06.85,Default,TIRAMISU,0,0,0,,-ماذا؟\N-A بالانكوين للطعام؟
Dialogue: 0,0:44:07.72,0:44:09.32,Default,TIRAMISU,0,0,0,,احذر.
Dialogue: 0,0:44:10.72,0:44:11.76,Default,TIRAMISU,0,0,0,,التمرير.
Dialogue: 0,0:44:12.96,0:44:13.99,Default,TIRAMISU,0,0,0,,هذا كل شيء.
Dialogue: 0,0:44:15.09,0:44:16.59,Default,TIRAMISU,0,0,0,,جلالة الملكة هنا.
Dialogue: 0,0:44:18.16,0:44:20.86,Default,TIRAMISU,0,0,0,,-مُجتمعون معًا. واحد-اثنين.\N-واحد-اثنين.
Dialogue: 0,0:44:20.86,0:44:24.50,Default,TIRAMISU,0,0,0,,-واحد-اثنان، واحد-اثنان.\N-واحد-اثنان، واحد-اثنان.
Dialogue: 0,0:44:24.50,0:44:26.30,Default,TIRAMISU,0,0,0,,-واحد-اثنان، واحد-اثنان.\N-حسناً، دعونا نرى.
Dialogue: 0,0:44:26.30,0:44:29.31,Default,TIRAMISU,0,0,0,,-واحد-اثنان، واحد-اثنان.\N-واحد-اثنان، واحد-اثنان.
Dialogue: 0,0:44:29.31,0:44:31.04,Default,TIRAMISU,0,0,0,,-ماذا؟ وهذا كل شيء؟\N-One-two.
Dialogue: 0,0:44:31.04,0:44:32.98,Default,TIRAMISU,0,0,0,,-واحد-اثنان، واحد-اثنان.\N-واحد-اثنان، واحد-اثنان.
Dialogue: 0,0:44:32.98,0:44:34.14,Default,TIRAMISU,0,0,0,,-واحد-اثنان.\N-واحد-اثنين.
Dialogue: 0,0:44:34.14,0:44:35.88,Default,TIRAMISU,0,0,0,,-هل كنت تعمل طوال الليل؟\N-نعم.
Dialogue: 0,0:44:35.88,0:44:37.25,Default,TIRAMISU,0,0,0,,كنا نعمل في نوبات.
Dialogue: 0,0:44:37.25,0:44:39.68,Default,TIRAMISU,0,0,0,,جمعوا الماء وسكبوه في البحيرة طوال الليل.
Dialogue: 0,0:44:39.68,0:44:41.29,Default,TIRAMISU,0,0,0,,لكن البحيرة كبيرة جداً.
Dialogue: 0,0:44:41.29,0:44:42.32,Default,TIRAMISU,0,0,0,,-واحد-اثنين.\N-واحد-اثنين.
Dialogue: 0,0:44:42.32,0:44:44.19,Default,TIRAMISU,0,0,0,,استغرق تجفيف البحيرة يومًا واحدًا.
Dialogue: 0,0:44:44.19,0:44:45.59,Default,TIRAMISU,0,0,0,,لماذا يستغرق ملئها وقتاً طويلاً؟
Dialogue: 0,0:44:45.59,0:44:47.59,Default,TIRAMISU,0,0,0,,البحيرة على تلة، لذا
Dialogue: 0,0:44:47.59,0:44:50.23,Default,TIRAMISU,0,0,0,,من السهل تصريفه - فقط اصنع بئراً.
Dialogue: 0,0:44:51.40,0:44:54.10,Default,TIRAMISU,0,0,0,,أراهن أنهم استرخوا،
Dialogue: 0,0:44:54.10,0:44:55.97,Default,TIRAMISU,0,0,0,,لأنه لا يوجد حارس.
Dialogue: 0,0:44:57.57,0:44:58.74,Default,TIRAMISU,0,0,0,,-واحد-اثنين.\N-واحد-اثنين.
Dialogue: 0,0:45:05.58,0:45:08.18,Default,TIRAMISU,0,0,0,,ربما بعد أن ننتهي،
Dialogue: 0,0:45:08.58,0:45:11.38,Default,TIRAMISU,0,0,0,,هل يجب أن نتناول كأساً؟
Dialogue: 0,0:45:12.68,0:45:13.75,Default,TIRAMISU,0,0,0,,
Dialogue: 0,0:45:13.75,0:45:15.72,Default,TIRAMISU,0,0,0,,ما رأيك؟ أ؟
Dialogue: 0,0:45:16.82,0:45:19.36,Default,TIRAMISU,0,0,0,,لقد طرحت عليك سؤالاً! هؤلاء هم النقانق.
Dialogue: 0,0:45:20.29,0:45:21.63,Default,TIRAMISU,0,0,0,,
Dialogue: 0,0:45:22.86,0:45:24.96,Default,TIRAMISU,0,0,0,,ما الذي أتى بك إلى هنا؟
Dialogue: 0,0:45:25.16,0:45:28.93,Default,TIRAMISU,0,0,0,,جلالتها تريد بعض المشروبات الغازية.
Dialogue: 0,0:45:29.67,0:45:30.83,Default,TIRAMISU,0,0,0,,الملكة؟
Dialogue: 0,0:45:34.44,0:45:35.47,Default,TIRAMISU,0,0,0,,هل هذا صحيح؟
Dialogue: 0,0:45:36.97,0:45:40.68,Default,TIRAMISU,0,0,0,,ثم سأصنع لكمة أزاليا بسيطة.
Dialogue: 0,0:45:41.35,0:45:42.71,Default,TIRAMISU,0,0,0,,للحصاد الأول
Dialogue: 0,0:45:42.71,0:45:45.78,Default,TIRAMISU,0,0,0,,توت شيساندرا ناضج جيدًا.
Dialogue: 0,0:45:46.15,0:45:48.92,Default,TIRAMISU,0,0,0,,تحضير الشاي من التوت وتحليته بالعسل.
Dialogue: 0,0:45:48.92,0:45:51.92,Default,TIRAMISU,0,0,0,,سأضيف الكمثرى واليوسفي من أجل النضارة.
Dialogue: 0,0:45:52.36,0:45:54.43,Default,TIRAMISU,0,0,0,,للحفاظ على هذه النضارة
Dialogue: 0,0:45:54.43,0:45:56.43,Default,TIRAMISU,0,0,0,,برد المشروب وأضف الثلج.
Dialogue: 0,0:45:57.09,0:45:59.90,Default,TIRAMISU,0,0,0,,بما أن الأزاليات لم تتفتح بعد،
Dialogue: 0,0:46:00.10,0:46:03.00,Default,TIRAMISU,0,0,0,,أنا أستخدم زهرة الربيع المسائية. نقوم بإزالة المدقة
Dialogue: 0,0:46:03.00,0:46:04.84,Default,TIRAMISU,0,0,0,,القليل من النشا،
Dialogue: 0,0:46:04.84,0:46:06.90,Default,TIRAMISU,0,0,0,,أسقطه في الماء المغلي
Dialogue: 0,0:46:06.90,0:46:08.61,Default,TIRAMISU,0,0,0,,ويبرد في الماء البارد.
Dialogue: 0,0:46:08.77,0:46:11.21,Default,TIRAMISU,0,0,0,,استخدم الزهور لتزيين اللكمة.
Dialogue: 0,0:46:11.71,0:46:15.18,Default,TIRAMISU,0,0,0,,اللمسة النهائية هي ثلاث حبات صنوبر.
Dialogue: 0,0:46:21.25,0:46:24.36,Default,TIRAMISU,0,0,0,,يمكنني تحضير مثل هذا المشروب وعيني مغمضتين.
Dialogue: 0,0:46:24.52,0:46:25.62,Default,TIRAMISU,0,0,0,,هذا كل شيء.
Dialogue: 0,0:46:28.53,0:46:32.43,Default,TIRAMISU,0,0,0,,حسناً، رأيت كيف فعلت ذلك وعيناك مفتوحتان على مصراعيهما.
Dialogue: 0,0:46:39.34,0:46:41.77,Default,TIRAMISU,0,0,0,,لماذا تنظر إليّ فقط؟
Dialogue: 0,0:46:43.07,0:46:44.21,Default,TIRAMISU,0,0,0,,كم هذا محرج.
Dialogue: 0,0:46:59.36,0:47:01.16,Default,TIRAMISU,0,0,0,,مواكبة الإيقاع.
Dialogue: 0,0:47:05.76,0:47:08.87,Default,TIRAMISU,0,0,0,,يا صاحب الجلالة، هذا مشروبك.
Dialogue: 0,0:47:09.27,0:47:13.14,Default,TIRAMISU,0,0,0,,ماذا؟ نعم. دعونا نرى.
Dialogue: 0,0:47:13.84,0:47:15.97,Default,TIRAMISU,0,0,0,,بالطبع، لست في هذا الموقف،
Dialogue: 0,0:47:16.27,0:47:17.98,Default,TIRAMISU,0,0,0,,لكن لا يمكنك تجنبه - استمتع به.
Dialogue: 0,0:47:21.55,0:47:22.61,Default,TIRAMISU,0,0,0,,حسنًا.
Dialogue: 0,0:47:25.18,0:47:26.18,Default,TIRAMISU,0,0,0,,
Dialogue: 0,0:47:30.82,0:47:32.06,Default,TIRAMISU,0,0,0,,كم عدد الآخرين؟
Dialogue: 0,0:47:32.19,0:47:34.39,Default,TIRAMISU,0,0,0,,وبهذا المعدل سننتهي بحلول الليل.
Dialogue: 0,0:47:34.39,0:47:35.49,Default,TIRAMISU,0,0,0,,حتى غروب الشمس.
Dialogue: 0,0:47:35.99,0:47:38.10,Default,TIRAMISU,0,0,0,,هذا مستحيل.
Dialogue: 0,0:47:38.10,0:47:40.40,Default,TIRAMISU,0,0,0,,كيف تجرؤ. تأكد من الانتهاء اليوم.
Dialogue: 0,0:47:40.40,0:47:42.53,Default,TIRAMISU,0,0,0,,وإلا ستتدحرج الرؤوس.
Dialogue: 0,0:47:43.60,0:47:44.64,Default,TIRAMISU,0,0,0,,أنا أطيع.
Dialogue: 0,0:47:47.94,0:47:50.47,Default,TIRAMISU,0,0,0,,-واحد-اثنان، واحد-اثنان.\N-واحد-اثنان، واحد-اثنان.
Dialogue: 0,0:47:50.47,0:47:52.01,Default,TIRAMISU,0,0,0,,-واحد-اثنان، واحد-اثنان.\N-واحد-اثنان، واحد-اثنان.
Dialogue: 0,0:47:52.01,0:47:53.14,Default,TIRAMISU,0,0,0,,أخبر الشيف الملكي
Dialogue: 0,0:47:53.31,0:47:56.31,Default,TIRAMISU,0,0,0,,-قم بتحضير هذا المشروب لكل الموجودين هنا.\N-One-two, one-two.
Dialogue: 0,0:47:56.31,0:47:58.22,Default,TIRAMISU,0,0,0,,-واحد-اثنان، واحد-اثنان.\N-واحد-اثنان، واحد-اثنان.
Dialogue: 0,0:47:58.22,0:47:59.78,Default,TIRAMISU,0,0,0,,-لكل هؤلاء الخدم؟\N-One-two, one-two.
Dialogue: 0,0:47:59.78,0:48:01.99,Default,TIRAMISU,0,0,0,,-واحد-اثنان، واحد-اثنان.\N-واحد-اثنان، واحد-اثنان.
Dialogue: 0,0:48:01.99,0:48:05.02,Default,TIRAMISU,0,0,0,,-واحد-اثنان، واحد-اثنان.\N-واحد-اثنان، واحد-اثنان.
Dialogue: 0,0:48:11.83,0:48:15.30,Default,TIRAMISU,0,0,0,,لقد أتت إلى هنا مرة أخرى، لا بد أنها وقعت في حب موهبتي.
Dialogue: 0,0:48:16.33,0:48:19.84,Default,TIRAMISU,0,0,0,,أنا متأكد من أنها ستطلب المزيد من الضربات.
Dialogue: 0,0:48:21.67,0:48:23.01,Default,TIRAMISU,0,0,0,,نعم، أنا أستمع إليك.
Dialogue: 0,0:48:23.01,0:48:25.61,Default,TIRAMISU,0,0,0,,تطلب منك الملكة إعداد المزيد من اللكمات.
Dialogue: 0,0:48:26.98,0:48:29.15,Default,TIRAMISU,0,0,0,,كنت أعلم أنها تريد المزيد.
Dialogue: 0,0:48:29.55,0:48:33.65,Default,TIRAMISU,0,0,0,,هل أسقطت الوعاء عن طريق الخطأ بسبب المذاق الرائع؟
Dialogue: 0,0:48:34.32,0:48:37.19,Default,TIRAMISU,0,0,0,,أو ربما ذرفت دمعة؟
Dialogue: 0,0:48:40.36,0:48:43.16,Default,TIRAMISU,0,0,0,,سيدة البلاط تشوي، كما ترى،
Dialogue: 0,0:48:44.16,0:48:45.33,Default,TIRAMISU,0,0,0,,أي نوع من الأشخاص أنا؟
Dialogue: 0,0:48:47.40,0:48:49.40,Default,TIRAMISU,0,0,0,,-Royal Chef.\N-Royal Chef.
Dialogue: 0,0:48:49.40,0:48:51.03,Default,TIRAMISU,0,0,0,,حسناً، حسناً، توقف عند هذا الحد.
Dialogue: 0,0:48:52.34,0:48:54.17,Default,TIRAMISU,0,0,0,,الشيف الملكي، الأمر...
Dialogue: 0,0:48:54.17,0:48:58.38,Default,TIRAMISU,0,0,0,,بالطبع سأصنع لك القليل أيضاً.
Dialogue: 0,0:48:59.31,0:49:02.88,Default,TIRAMISU,0,0,0,,أعتقد أنك أحببت المشروب أيضًا
Dialogue: 0,0:49:03.28,0:49:05.32,Default,TIRAMISU,0,0,0,,أكثر من المعتاد.
Dialogue: 0,0:49:11.29,0:49:12.59,Default,TIRAMISU,0,0,0,,هل رأيت ما فعلته؟
Dialogue: 0,0:49:12.59,0:49:14.59,Default,TIRAMISU,0,0,0,,كان ذلك مضحكاً.
Dialogue: 0,0:49:24.30,0:49:26.90,Default,TIRAMISU,0,0,0,,سأصنع واحدة أخرى. انتظر لحظة.
Dialogue: 0,0:49:27.14,0:49:31.28,Default,TIRAMISU,0,0,0,,بينما تحضر واحدة، هل ستصنع المزيد؟
Dialogue: 0,0:49:32.18,0:49:35.75,Default,TIRAMISU,0,0,0,,بالطبع. كم تحتاج؟
Dialogue: 0,0:49:37.01,0:49:39.38,Default,TIRAMISU,0,0,0,,-تفضلي.\N-كم هو لذيذ.
Dialogue: 0,0:49:39.38,0:49:41.08,Default,TIRAMISU,0,0,0,,شكرًا لك.
Dialogue: 0,0:49:41.29,0:49:43.72,Default,TIRAMISU,0,0,0,,شكرًا لك يا صاحب الجلالة.
Dialogue: 0,0:49:53.53,0:49:56.43,Default,TIRAMISU,0,0,0,,إنها باهظة الثمن. شكرا لك يا صاحب الجلالة.
Dialogue: 0,0:49:56.87,0:49:58.20,Default,TIRAMISU,0,0,0,,على الأقل أنت على علم بذلك.
Dialogue: 0,0:49:59.10,0:50:02.01,Default,TIRAMISU,0,0,0,,شكرًا لك على كرمك يا صاحب الجلالة.
Dialogue: 0,0:50:02.01,0:50:05.44,Default,TIRAMISU,0,0,0,,شكرًا لك على كرمك يا صاحب الجلالة.
Dialogue: 0,0:50:05.61,0:50:07.78,Default,TIRAMISU,0,0,0,,نعم، نعم. لا شيء خاص.
Dialogue: 0,0:50:08.28,0:50:09.61,Default,TIRAMISU,0,0,0,,لا تقف هناك واشرب.
Dialogue: 0,0:50:12.72,0:50:14.45,Default,TIRAMISU,0,0,0,,هذا لذيذ جدًا.
Dialogue: 0,0:50:15.45,0:50:17.52,Default,TIRAMISU,0,0,0,,إنها سهلة التنفيذ للغاية.
Dialogue: 0,0:50:24.36,0:50:28.23,Default,TIRAMISU,0,0,0,,أختبئ جيدًا حتى أن الطائر لن يلاحظ ذلك.
Dialogue: 0,0:50:31.37,0:50:33.44,Default,TIRAMISU,0,0,0,,لقد بذلت الكثير من الجهد،
Dialogue: 0,0:50:33.94,0:50:35.61,Default,TIRAMISU,0,0,0,,لكنني أردت الشرب الآن فقط.
Dialogue: 0,0:50:46.92,0:50:48.85,Default,TIRAMISU,0,0,0,,لقد كنت مشغولاً للغاية منذ الأمس.
Dialogue: 0,0:50:49.25,0:50:51.72,Default,TIRAMISU,0,0,0,,رغم أنني لست متأكداً مما تفعله.
Dialogue: 0,0:50:52.16,0:50:54.52,Default,TIRAMISU,0,0,0,,هل رأيتني؟
Dialogue: 0,0:50:54.96,0:50:58.40,Default,TIRAMISU,0,0,0,,بالطبع. من السهل اكتشافك.
Dialogue: 0,0:50:58.56,0:50:59.56,Default,TIRAMISU,0,0,0,,من السهل ملاحظته؟
Dialogue: 0,0:51:01.23,0:51:02.50,Default,TIRAMISU,0,0,0,,هكذا كان المقصود.
Dialogue: 0,0:51:02.50,0:51:04.77,Default,TIRAMISU,0,0,0,,قبل ذلك لم تلاحظني سيدتا البلاط
Dialogue: 0,0:51:04.77,0:51:06.50,Default,TIRAMISU,0,0,0,,وتحدثت بصراحة.
Dialogue: 0,0:51:06.50,0:51:09.31,Default,TIRAMISU,0,0,0,,يجب أن أعود إلى الملكة.
Dialogue: 0,0:51:11.94,0:51:13.01,Default,TIRAMISU,0,0,0,,الوعاء.
Dialogue: 0,0:51:58.79,0:52:00.26,Default,TIRAMISU,0,0,0,,منذ أن تم القبض عليّ،
Dialogue: 0,0:52:00.96,0:52:02.33,Default,TIRAMISU,0,0,0,,ثم سأكمل اليوم.
Dialogue: 0,0:52:08.87,0:52:11.00,Default,TIRAMISU,0,0,0,,عندما رأتني،
Dialogue: 0,0:52:11.60,0:52:15.97,Default,TIRAMISU,0,0,0,,ظهرت أمامها كالزهرة.
Dialogue: 0,0:52:27.18,0:52:28.39,Default,TIRAMISU,0,0,0,,كيف ذلك.
Dialogue: 0,0:52:35.83,0:52:36.96,Default,TIRAMISU,0,0,0,,سوف تتأذى.
Dialogue: 0,0:52:47.77,0:52:49.21,Default,TIRAMISU,0,0,0,,لا تلمسه بالأيدي العارية.
Dialogue: 0,0:53:09.56,0:53:12.96,Default,TIRAMISU,0,0,0,,شعور يجعلك ترغب في الألم، -
Dialogue: 0,0:53:13.56,0:53:14.56,Default,TIRAMISU,0,0,0,,الحب.
Dialogue: 0,0:53:31.52,0:53:33.18,Default,TIRAMISU,0,0,0,,سوف أسأل.
Dialogue: 0,0:53:33.65,0:53:36.79,Default,TIRAMISU,0,0,0,,أنا متأكد من أنه ليس هناك شيء خطير، لذا لا تقلق.
Dialogue: 0,0:53:36.79,0:53:39.19,Default,TIRAMISU,0,0,0,,أوفول ليس واحداً من أولئك الذين سيختفون دون أن يقولوا أي شيء.
Dialogue: 0,0:53:39.69,0:53:41.46,Default,TIRAMISU,0,0,0,,أنا متأكد أن شيئاً ما حدث لها.
Dialogue: 0,0:53:42.13,0:53:43.93,Default,TIRAMISU,0,0,0,,الملكة الأم قادمة.
Dialogue: 0,0:53:47.33,0:53:48.40,Default,TIRAMISU,0,0,0,,الملكة الأم.
Dialogue: 0,0:53:49.63,0:53:51.03,Default,TIRAMISU,0,0,0,,اتركنا.
Dialogue: 0,0:53:58.68,0:54:01.71,Default,TIRAMISU,0,0,0,,تذكر كل ما أقوله الآن.
Dialogue: 0,0:54:02.78,0:54:05.38,Default,TIRAMISU,0,0,0,,في القصر بأكمله لا يمكنك الوثوق إلا بي،
Dialogue: 0,0:54:05.38,0:54:07.68,Default,TIRAMISU,0,0,0,,لأنني في نفس القارب معك.
Dialogue: 0,0:54:08.39,0:54:12.59,Default,TIRAMISU,0,0,0,,يجب أن تخبرني بكل شيء، دون إخفاء أي شيء.
Dialogue: 0,0:54:13.69,0:54:16.69,Default,TIRAMISU,0,0,0,,هذه هي الطريقة الوحيدة التي يمكننا بها أنا والفتاة البقاء على قيد الحياة.
Dialogue: 0,0:54:45.36,0:54:47.09,Default,TIRAMISU,0,0,0,,جيد جداً.
Dialogue: 0,0:54:47.79,0:54:51.09,Default,TIRAMISU,0,0,0,,الأمير يونبيونغ، كبير الخصيان وأنا.
Dialogue: 0,0:54:52.93,0:54:54.06,Default,TIRAMISU,0,0,0,,رئيس الخصي.
Dialogue: 0,0:54:54.93,0:54:57.73,Default,TIRAMISU,0,0,0,,بما أن الملكة أرادت قراءة "الترجمة السبعينيّة"،
Dialogue: 0,0:54:57.73,0:54:59.97,Default,TIRAMISU,0,0,0,,طلبت منك أن تحضر لي نسخة أخرى.
Dialogue: 0,0:55:01.07,0:55:02.11,Default,TIRAMISU,0,0,0,,ماذا؟
Dialogue: 0,0:55:04.57,0:55:07.28,Default,TIRAMISU,0,0,0,,أنت لم تطلب مني هذا.
Dialogue: 0,0:55:07.38,0:55:08.41,Default,HEIN,0,0,0,,رئيس الخصي.
Dialogue: 0,0:55:08.98,0:55:11.72,Default,HEIN,0,0,0,,على مر السنين، هل أصبت بالخرف؟
Dialogue: 0,0:55:12.12,0:55:13.98,Default,HEIN,0,0,0,,أتذكر بوضوح ما طلبته.
Dialogue: 0,0:55:14.38,0:55:17.16,Default,HEIN,0,0,0,,اذهب إلى كيوجانجاك على الفور وأبلغني بطلباتي.
Dialogue: 0,0:55:17.75,0:55:19.69,Default,HEIN,0,0,0,,هل تريدني أن أغادر فوراً؟
Dialogue: 0,0:55:19.69,0:55:21.99,Default,HEIN,0,0,0,,ربما ينبغي علينا الانتظار حتى تنسى مرة أخرى؟
Dialogue: 0,0:55:21.99,0:55:26.03,Default,HEIN,0,0,0,,سأرافقك إلى قاعة دايجوجون، وسأصل إلى هناك في لمح البصر.
Dialogue: 0,0:55:27.20,0:55:30.23,Default,HEIN,0,0,0,,أنا لا أسير وحدي، الأمير يونبيونغ سوف يحميني إذا حدث أي شيء.
Dialogue: 0,0:55:30.23,0:55:31.80,Default,HEIN,0,0,0,,لماذا تقلق كثيراً؟
Dialogue: 0,0:55:32.24,0:55:33.50,Default,HEIN,0,0,0,,أنصحك بالإسراع.
Dialogue: 0,0:55:36.44,0:55:37.71,Default,HEIN,0,0,0,,نعم، حسناً.
Dialogue: 0,0:56:00.30,0:56:02.53,Default,HEIN,0,0,0,,واو، هل قُتلت للتو على يد خنزير بري؟
Dialogue: 0,0:56:03.67,0:56:04.73,Default,HEIN,0,0,0,,رئيس الخصي.
Dialogue: 0,0:56:05.44,0:56:07.64,Default,HEIN,0,0,0,,-ألم تتأذى؟\N-أنا بخير.
Dialogue: 0,0:56:09.21,0:56:11.24,Default,HEIN,0,0,0,,يبدو أن أنفك مكسور.
Dialogue: 0,0:56:11.24,0:56:12.38,Default,HEIN,0,0,0,,لا يا أنفي!
Dialogue: 0,0:56:12.68,0:56:14.28,Default,HEIN,0,0,0,,واو، هل هذا دم؟
Dialogue: 0,0:56:14.48,0:56:16.35,Default,HEIN,0,0,0,,نعم، أنفي دائماً هكذا!
Dialogue: 0,0:56:16.68,0:56:20.02,Default,HEIN,0,0,0,,هيا. هل يمكن أن يبدو أنف الإنسان هكذا؟
Dialogue: 0,0:56:20.02,0:56:21.65,Default,HEIN,0,0,0,,أسرع واذهب إلى المستوصف.
Dialogue: 0,0:56:21.65,0:56:23.82,Default,HEIN,0,0,0,,يا إلهي. قال إنه بخير.
Dialogue: 0,0:56:25.18,0:56:26.82,Default,HEIN,0,0,0,,أوفول، سيدة المحكمة المفقودة،
Dialogue: 0,0:56:26.82,0:56:28.53,Default,HEINE,0,0,0,,كان في القصر مع المحظية "تشو"
Dialogue: 0,0:56:28.53,0:56:30.69,Default,HAIN,0,0,0,,في اليوم الذي سقطت فيه الملكة في البحيرة.
Dialogue: 0,0:56:31.34,0:56:33.56,Default,HAINE,0,0,0,,سوف يجبرونها على الإدلاء بشهادة الزور.
Dialogue: 0,0:56:33.70,0:56:36.40,Default,HEIN,0,0,0,,حدث كل ذلك عندما اكتشفت الملكة الأمر
Dialogue: 0,0:56:36.40,0:56:37.57,Default,HEIN,0,0,0,,أنك هاجمتها.
Dialogue: 0,0:56:38.80,0:56:41.00,Default,HEINE,0,0,0,,هدفها هو المحظية "تشو"، وليس أنا.
Dialogue: 0,0:56:42.41,0:56:43.44,Default,HEIN,0,0,0,,الانتقام.
Dialogue: 0,0:56:44.01,0:56:45.88,Default,HEINE,0,0,0,,هل هذا ما تريده الملكة؟
Dialogue: 0,0:56:51.01,0:56:52.05,Default,HEIN,0,0,0,,جلالتك.
Dialogue: 0,0:56:53.05,0:56:54.05,Default,HEIN,0,0,0,,هواجين.
Dialogue: 0,0:57:01.59,0:57:02.69,Default,HEIN,0,0,0,,عذراً.
Dialogue: 0,0:57:03.26,0:57:05.43,Default,HEIN,0,0,0,,هواجين، ليس لديك ما تعتذر عنه.
Dialogue: 0,0:57:05.96,0:57:07.50,Default,HEINE,0,0,0,,كل هذا خطأي.
Dialogue: 0,0:57:08.50,0:57:09.60,Default,HEIN,0,0,0,,ما الذي تتحدث عنه؟
Dialogue: 0,0:57:14.16,0:57:16.77,Default,HAINE,0,0,0,,مؤخراً حاولت أيضاً التخلص من الملكة.
Dialogue: 0,0:57:18.07,0:57:19.48,Default,HEIN,0,0,0,,إنها تنتقم مني، لهذا السبب
Dialogue: 0,0:57:19.48,0:57:21.95,Default,HEIN,0,0,0,,يحاول إلقاء اللوم عليك على الحادث الذي وقع في البحيرة.
Dialogue: 0,0:57:23.71,0:57:25.45,Default,HEIN,0,0,0,,نفس الحيل باستمرار.
Dialogue: 0,0:57:25.94,0:57:28.56,Default,HEIN,0,0,0,,تزوير الأدلة،\Nمحاصرة الأبرياء.
Dialogue: 0,0:57:31.02,0:57:33.49,Default,HAINE,0,0,0,,سأخبر الجميع أنني حاولت قتل الملكة.
Dialogue: 0,0:57:34.39,0:57:35.43,Default,HEIN,0,0,0,,جلالتك.
Dialogue: 0,0:57:37.03,0:57:40.26,Default,HEIN,0,0,0,,أنت وأنا نعرف عن الانتقام أكثر من معظم الناس.
Dialogue: 0,0:57:40.46,0:57:42.03,Default,HEIN,0,0,0,,أكثر من إرجاع كل الألم والمعاناة.
Dialogue: 0,0:57:42.03,0:57:43.43,Default,HEIN,0,0,0,,هذا هو الانتقام.
Dialogue: 0,0:57:44.10,0:57:45.47,Default,HEIN,0,0,0,,الملكة عطشى أيضاً
Dialogue: 0,0:57:45.94,0:57:47.84,Default,HEIN,0,0,0,,ضع السيف على حلق هواجين.
Dialogue: 0,0:57:49.84,0:57:52.21,Default,HAINE,0,0,0,,الطريقة الوحيدة لتهدئة غضبها هي
Dialogue: 0,0:57:53.61,0:57:55.11,Default,HEIN,0,0,0,,اسقط على ركبتيك أمامها.
Dialogue: 0,0:57:56.58,0:57:57.71,Default,HEIN,0,0,0,,ليس هناك طريقة أخرى.
Dialogue: 0,0:57:59.82,0:58:02.72,Default,HEINE,0,0,0,,لقد خططت لكل شيء،
Dialogue: 0,0:58:02.72,0:58:04.19,Default,HEINE,0,0,0,,لإعدادي.
Dialogue: 0,0:58:04.72,0:58:06.46,Default,HEINE,0,0,0,,سوف أتدخل وأضع حداً لهذا.
Dialogue: 0,0:58:08.54,0:58:11.40,Default,HEIN,0,0,0,,لا تنسَ القضية\Nالعظيمة التي تسعى من أجلها.
Dialogue: 0,0:58:11.46,0:58:14.20,Default,HEIN,0,0,0,,أم أنك نسيت بالفعل عدد الإهانات التي كان عليك تحملها في المرة الأخيرة
Dialogue: 0,0:58:14.20,0:58:16.10,Default,HEINE,0,0,0,,عامان للتحضير بشكل صحيح؟
Dialogue: 0,0:58:16.33,0:58:17.53,Default,HEIN,0,0,0,,من أجل قضية عظيمة
Dialogue: 0,0:58:18.12,0:58:20.30,Default,HEIN,0,0,0,,يجب أن تفلت من العقاب.
Dialogue: 0,0:58:23.44,0:58:26.38,Default,HEIN,0,0,0,,لم أرغب قط في حياتي أن أصبح ملكاً،
Dialogue: 0,0:58:27.71,0:58:29.21,Default,HEIN,0,0,0,,دمية في الأيدي الخطأ.
Dialogue: 0,0:58:30.95,0:58:34.82,Default,HEIN,0,0,0,,لقد جئت إلى هذا القصر لسبب واحد.
Dialogue: 0,0:58:37.65,0:58:39.52,Default,HEIN,0,0,0,,لا مزيد من الهروب.
Dialogue: 0,0:58:53.50,0:58:55.64,Default,HEIN,0,0,0,,لست بحاجة إلى نصحي بالركض مرة أخرى.
Dialogue: 0,0:58:56.01,0:58:57.87,Default,HEIN,0,0,0,,بالتأكيد لن أهرب.
Dialogue: 0,0:59:00.28,0:59:02.31,Default,HEIN,0,0,0,,سأبحث في كل شق
Dialogue: 0,0:59:02.31,0:59:04.11,Default,HEIN,0,0,0,,وسوف أجد أوفول.
Dialogue: 0,0:59:05.00,0:59:07.46,Default,HEIN,0,0,0,,على الأرجح أنهم يستجوبونها في مكان ما في القصر،
Dialogue: 0,0:59:07.78,0:59:09.38,Default,HEIN,0,0,0,,بمجرد أن يتغلبوا على الاعتراف،
Dialogue: 0,0:59:09.62,0:59:11.75,Default,HEIN,0,0,0,,سوف تتم معاقبتك على الفور.
Dialogue: 0,0:59:12.59,0:59:13.92,Default,HEIN,0,0,0,,يرجى الانتظار،
Dialogue: 0,0:59:15.43,0:59:16.56,Default,HEIN,0,0,0,,حتى أجدها.
Dialogue: 0,0:59:17.39,0:59:18.46,Default,HEIN,0,0,0,,حسنًا.
Dialogue: 0,0:59:18.70,0:59:21.90,Default,HEIN,0,0,0,,ولكن إذا حدث خطأ ما، فسوف أتدخل على الفور.
Dialogue: 0,0:59:22.83,0:59:24.70,Default,HEIN,0,0,0,,ثم لا تقف في طريقي.
Dialogue: 0,0:59:25.50,0:59:27.00,Default,HEIN,0,0,0,,هذا أمر.
Dialogue: 0,0:59:27.67,0:59:29.64,Default,HEIN,0,0,0,,لقد فقدنا بالفعل الكثير من الأرواح.
Dialogue: 0,0:59:30.41,0:59:31.57,Default,HEIN,0,0,0,,اليوم
Dialogue: 0,0:59:32.78,0:59:34.61,Default,HEIN,0,0,0,,لا أريد أن أخسر أحداً.
Dialogue: 0,0:59:48.66,0:59:52.53,Default,HEIN,0,0,0,,يا صاحب الجلالة، عليك أن تعتني بنفسك.
Dialogue: 0,0:59:53.76,0:59:55.06,Default,HEIN,0,0,0,,سأحاول.
Dialogue: 0,0:59:55.63,0:59:58.06,Default,HEIN,0,0,0,,الركوع أو الزحف عند أقدامهم،
Dialogue: 0,0:59:58.06,1:00:00.34,Default,HEIN,0,0,0,,التظاهر بالغباء، كما لو كان هذا سوء فهم، -
Dialogue: 0,1:00:01.00,1:00:02.97,Default,HEIN,0,0,0,,سأفعل أي شيء لتجنب المشاكل.
Dialogue: 0,1:00:04.91,1:00:05.94,Default,HEIN,0,0,0,,جلالتك.
Dialogue: 0,1:00:24.83,1:00:27.26,Default,HEIN,0,0,0,,يجب عليكم جميعاً أن ترتديوا الزي الرسمي.
Dialogue: 0,1:00:27.92,1:00:30.20,Default,HEIN,0,0,0,,نذهب للبحث عن سيدة المحكمة.
Dialogue: 0,1:00:30.67,1:00:32.67,Default,HEIN,0,0,0,,يُعتقد أنها في القصر.
Dialogue: 0,1:00:34.54,1:00:36.71,Default,HEIN,0,0,0,,تأكد من أن لا أحد يراك.
Dialogue: 0,1:00:37.04,1:00:39.28,Default,HEIN,0,0,0,,كن حذراً للغاية.
Dialogue: 0,1:00:55.89,1:00:58.96,Default,HEIN,0,0,0,,الملل المميت.
Dialogue: 0,1:01:02.06,1:01:03.93,Default,HEIN,0,0,0,,ماذا تفعل من أجل المتعة؟
Dialogue: 0,1:01:05.64,1:01:06.74,Default,HEIN,0,0,0,,جلالتك.
Dialogue: 0,1:01:06.74,1:01:08.91,Default,HEIN,0,0,0,,في اليوم التالي تمكنت من الحصول على
Dialogue: 0,1:01:08.91,1:01:10.81,Default,HEIN,0,0,0,,هذا الغزل الحريري من أسرة تشينغ.
Dialogue: 0,1:01:12.58,1:01:14.18,Default,HEIN,0,0,0,,هل لديك مستودع في جيبك؟
Dialogue: 0,1:01:14.18,1:01:17.75,Default,HEIN,0,0,0,,اعتقدت أنك\Nسترغب في العودة إلى هوايتك يومًا ما.
Dialogue: 0,1:01:19.25,1:01:21.02,Default,HEIN,0,0,0,,آسف بالطبع، لكن لا، شكرًا.
Dialogue: 0,1:01:21.06,1:01:22.35,Default,HEIN,0,0,0,,الأمر يستحق أن تلتقط الإبرة،
Dialogue: 0,1:01:22.35,1:01:24.25,Default,HEIN,0,0,0,,لم يعد هناك مكان للعيش في أصابعي.
Dialogue: 0,1:01:24.25,1:01:25.29,افتراضي,HEIN,0,0,0,,لذلك
Dialogue: 0,1:01:26.49,1:01:28.12,Default,HEIN,0,0,0,,أنا مسلح بالكامل.
Dialogue: 0,1:01:30.53,1:01:32.36,Default,HEIN,0,0,0,,هل أظهرت لي خدعة للتو؟
Dialogue: 0,1:01:33.46,1:01:35.73,Default,HEIN,0,0,0,,ما الذي تتحدث عنه؟ وهذا ما يسمى كشتبان.
Dialogue: 0,1:01:36.07,1:01:38.30,Default,HEIN,0,0,0,,هل قررت أن هذه لعبة يا صاحب الجلالة؟
Dialogue: 0,1:01:39.44,1:01:40.54,Default,HEIN,0,0,0,,السيدة تشوي.
Dialogue: 0,1:01:41.27,1:01:42.74,Default,HEIN,0,0,0,,هل أنت حقاً خارج الموضوع؟
Dialogue: 0,1:01:47.24,1:01:48.48,Default,HEIN,0,0,0,,هونيونغ وأنت؟
Dialogue: 0,1:01:52.64,1:01:54.98,Default,HEIN,0,0,0,,هل للكشتبان معنى خفي؟
Dialogue: 0,1:01:55.28,1:01:58.42,Default,HEIN,0,0,0,,لقد أعددتها حتى لا تقوم بوخز أصابعك أثناء الخياطة.
Dialogue: 0,1:01:59.76,1:02:02.02,Default,HEIN,0,0,0,,تعذبني الشكوك الغامضة.
Dialogue: 0,1:02:13.20,1:02:16.74,Default,HEIN,0,0,0,,يا صاحب الجلالة، لقد كنت قلقة للغاية عليك.
Dialogue: 0,1:02:16.74,1:02:18.34,Default,HEIN,0,0,0,,أنت تسبقني.
Dialogue: 0,1:02:19.28,1:02:22.22,Default,HEIN,0,0,0,,لم يكن على الملك أن يركض،\Nكعب متألق، لقد تباطأ.
Dialogue: 0,1:02:25.45,1:02:26.92,Default,HAINE,0,0,0,,هل الملكة في المنزل؟
Dialogue: 0,1:02:28.28,1:02:30.52,Default,HEIN,0,0,0,,سمعت صاحبة الجلالة تمشي بجانب البحيرة.
Dialogue: 0,1:02:32.15,1:02:33.59,Default,HEIN,0,0,0,,بجانب البحيرة؟ لماذا فجأة؟
Dialogue: 0,1:02:35.16,1:02:36.83,Default,HEIN,0,0,0,,تزامنت كلمات المحظية تشو
Dialogue: 0,1:02:37.23,1:02:40.63,Default,HEIN,0,0,0,,بكلمات جلالته.
Dialogue: 0,1:02:41.30,1:02:44.33,Default,HAINE,0,0,0,,قالت إنها لم تقابل الملكة حتى ذلك المساء.
Dialogue: 0,1:02:45.33,1:02:48.67,Default,HEIN,0,0,0,,أنها هربت بعد أن سمعت صوتاً عالياً.
Dialogue: 0,1:02:49.74,1:02:53.14,Default,HEIN,0,0,0,,ولكن سواء كان ذلك صحيحاً أم خطأ، لا أعرف.
Dialogue: 0,1:02:53.71,1:02:55.04,Default,HEIN,0,0,0,,فقط تبدو كامرأة،
Dialogue: 0,1:02:55.04,1:02:58.28,Default,HEIN,0,0,0,,الذي رآه الخصي والخدم الذين كانوا يسرقون الهدايا الملكية،
Dialogue: 0,1:02:58.85,1:03:02.92,Default,HEINE,0,0,0,,كانت بالفعل خليلة تشو.
Dialogue: 0,1:03:03.59,1:03:06.96,Default,HAINE,0,0,0,,أو أنها وقعت في فخ الملكة.
Dialogue: 0,1:03:08.72,1:03:10.83,Default,HEINE,0,0,0,,قبل أن تنشر جناحيها.
Dialogue: 0,1:03:14.70,1:03:15.73,Default,HEIN,0,0,0,,جلالتك.
Dialogue: 0,1:03:16.12,1:03:18.20,Default,HAIN,0,0,0,,المحظية تشو الآن في قاعة دونغميونغجونغ.
Dialogue: 0,1:03:37.45,1:03:40.09,Default,HEIN,0,0,0,,سأحميك يا صاحب الجلالة.
Dialogue: 0,1:03:46.33,1:03:48.03,Default,HEIN,0,0,0,,لقد جاءت بمحض إرادتها.
Dialogue: 0,1:03:49.87,1:03:52.97,Default,HEIN,0,0,0,,على ما يبدو، كانت أوفول أقرب إليها مما توقعنا.
Dialogue: 0,1:03:53.30,1:03:55.91,Default,HEIN,0,0,0,,هذا رائع. وتبين أن الأمر أسهل مما كنا نظن.
Dialogue: 0,1:03:56.24,1:03:57.54,Default,HEIN,0,0,0,,منذ أن جاءت بنفسها،
Dialogue: 0,1:03:57.54,1:03:59.71,Default,HEINE,0,0,0,,يجب أن تجعلها تعترف بكل شيء.
Dialogue: 0,1:04:00.18,1:04:02.65,Default,HEIN,0,0,0,,الصحة أكثر أهمية بالنسبة لي،
Dialogue: 0,1:04:03.05,1:04:04.78,Default,HEIN,0,0,0,,سأنهي وجبتي أولاً.
Dialogue: 0,1:04:04.78,1:04:06.42,Default,HEIN,0,0,0,,أنت على حق تماماً.
Dialogue: 0,1:04:57.36,1:04:58.83,Default,HEIN,0,0,0,,كل شيء خاطئ.
Dialogue: 0,1:04:59.80,1:05:03.57,Default,HEIN,0,0,0,,لن تفعل السيدة هواجين مثل هذا الشيء أبداً.
Dialogue: 0,1:05:05.31,1:05:09.31,Default,HEIN,0,0,0,,حتى لو قتلتني، الحقيقة لن تتغير.
Dialogue: 0,1:05:17.12,1:05:18.25,Default,HEIN,0,0,0,,شيء مسكين.
Dialogue: 0,1:05:18.72,1:05:21.59,Default,HEIN,0,0,0,,أنت مثل كلب مخلص يلعق
Dialogue: 0,1:05:21.59,1:05:24.13,Default,HEIN,0,0,0,,أيدي السيدة على وشك طعنك.
Dialogue: 0,1:05:26.03,1:05:28.06,Default,HEIN,0,0,0,,لقد فات الأوان للاعتراف.
Dialogue: 0,1:05:30.07,1:05:32.77,Default,HEIN,0,0,0,,عشيقتك هواجين ألقت باللوم عليك في كل شيء.
Dialogue: 0,1:05:36.14,1:05:37.31,Default,HEIN,0,0,0,,هذا لا يمكن أن يكون.
Dialogue: 0,1:05:45.08,1:05:46.15,Default,HEIN,0,0,0,,هنا.
Dialogue: 0,1:05:47.38,1:05:48.75,Default,HEIN,0,0,0,,واو، أنت جيد.
Dialogue: 0,1:05:49.95,1:05:51.02,Default,HEIN,0,0,0,,هذا كل شيء.
Dialogue: 0,1:05:59.36,1:06:02.00,Default,HEIN,0,0,0,,-يا إلهي.\N-يا لها من خيوط قيمة.
Dialogue: 0,1:06:02.06,1:06:04.03,Default,HEIN,0,0,0,,المشكلة الأبدية مع أدوات التشوتشكس الباهظة الثمن.
Dialogue: 0,1:06:04.03,1:06:05.57,Default,HEIN,0,0,0,,هشة للغاية.
Dialogue: 0,1:06:06.40,1:06:07.47,Default,HEIN,0,0,0,,دعونا نرى.
Dialogue: 0,1:06:08.04,1:06:10.71,Default,HEIN,0,0,0,,دعونا نجد شيئاً أقوى.
Dialogue: 0,1:06:19.38,1:06:21.72,Default,HEIN,0,0,0,"اترك نفسك الزائفة"؟
Dialogue: 0,1:06:22.22,1:06:24.35,Default,HEIN,0,0,0,"اترك نفسك الزائفة"؟
Dialogue: 0,1:06:24.35,1:06:25.49,Default,HEIN,0,0,0,,ما هذا؟
Dialogue: 0,1:06:25.49,1:06:28.82,Default,HEIN,0,0,0,,لقد طرزت هذه الحروف الهيروغليفية بنفسك عندما كان لديك دقيقة مجانية.
Dialogue: 0,1:06:29.09,1:06:31.46,Default,HEIN,0,0,0,,لا أعرف ماذا يقصدون، أنا أمي،
Dialogue: 0,1:06:31.46,1:06:33.30,Default,HEINE,0,0,0,,لكنني أعتقد أن هذا بيت شعر جميل.
Dialogue: 0,1:06:33.66,1:06:35.63,Default,HEINE,0,0,0,,هذه هي المرة الأولى التي أرى فيها هذا.
Dialogue: 0,1:06:36.17,1:06:39.64,Default,HEIN,0,0,0,,يحدث أنك\Nلم تتمكن من الإمساك بالملكة وهي تقوم بهذا العمل.
Dialogue: 0,1:06:40.94,1:06:42.67,Default,HEIN,0,0,0,,أهذه قصيدة حب؟
Dialogue: 0,1:06:42.67,1:06:45.78,Default,HEINE,0,0,0,,هذه رسالة انتحار.
Dialogue: 0,1:06:47.61,1:06:49.58,Default,HEINE,0,0,0,,هل طرزتها قبل أن أسقط في البحيرة؟
Dialogue: 0,1:06:49.58,1:06:51.95,Default,HEIN,0,0,0,,هل فهمت بشكل صحيح؟
Dialogue: 0,1:06:51.95,1:06:52.98,Default,HEIN,0,0,0,,نعم.
Dialogue: 0,1:06:53.02,1:06:54.22,Default,HEIN,0,0,0,,ولم يكن لدي
Dialogue: 0,1:06:54.28,1:06:56.65,Default,HEIN,0,0,0,,مشاكل النوم وفقدان الشهية؟
Dialogue: 0,1:06:56.82,1:06:59.29,Default,HEIN,0,0,0,,كنا. وتنهدت باستمرار.
Dialogue: 0,1:06:59.29,1:07:01.09,Default,HEINE,0,0,0,,بدا مكتئباً دائماً.
Dialogue: 0,1:07:01.20,1:07:03.23,Default,HEIN,0,0,0,,أحياناً تبدأ بالبكاء بلا سبب.
Dialogue: 0,1:07:04.79,1:07:07.80,Default,HEIN,0,0,0,,جلالتك، هل تذكرت كل شيء؟
Dialogue: 0,1:07:08.03,1:07:09.20,Default,HEIN,0,0,0,,No.
Dialogue: 0,1:07:09.87,1:07:13.24,Default,HEIN,0,0,0,,ولم أتنازل عن أشياء عزيزة عليّ لدى أحد؟
Dialogue: 0,1:07:16.04,1:07:18.41,Default,HEIN,0,0,0,,لقد أعطيتني إياها،
Dialogue: 0,1:07:18.41,1:07:19.91,Default,HEIN,0,0,0,,رغم أنهم كانوا يقدرونها كثيراً.
Dialogue: 0,1:07:20.11,1:07:21.21,Default,HEIN,0,0,0,,و
Dialogue: 0,1:07:21.58,1:07:23.81,Default,HEIN,0,0,0,,أعطى خاتماً للسيدة تشوي.
Dialogue: 0,1:07:27.18,1:07:28.35,Default,HEIN,0,0,0,,كان "تشو هواجين" مخطئًا.
Dialogue: 0,1:07:28.88,1:07:31.72,Default,HAIN,0,0,0,,لم تحاول "كيم سو يون" استدراجها إلى الفخ.
Dialogue: 0,1:07:32.42,1:07:33.69,Default,HEIN,0,0,0,,وأردت الانتحار.
Dialogue: 0,1:07:37.06,1:07:38.26,Default,HEIN,0,0,0,,أليس هذا تشولجونغ؟
Dialogue: 0,1:07:38.46,1:07:40.46,Default,HEIN,0,0,0,,الملك قادم!
Dialogue: 0,1:07:40.96,1:07:43.00,Default,HEIN,0,0,0,,ألم يقل إن الملوك لا ينبغي أن يركضوا؟
Dialogue: 0,1:07:43.43,1:07:46.07,Default,HEIN,0,0,0,,فقط وجهه أدى إلى ارتفاع ضغط دمي بشكل صاروخي.
Dialogue: 0,1:07:48.17,1:07:49.27,Default,HEIN,0,0,0,,ماذا؟
Dialogue: 0,1:07:49.94,1:07:51.21,Default,HEIN,0,0,0,,هل تبحث عن قتال؟
Dialogue: 0,1:07:52.84,1:07:54.04,Default,HEIN,0,0,0,,هل نستقر مثل الرجال؟
Dialogue: 0,1:07:54.98,1:07:58.18,Default,HEIN,0,0,0,,أهذا كل شيء؟ هل هذا هو اختيارك؟
Dialogue: 0,1:07:59.08,1:08:00.38,Default,HEIN,0,0,0,,ما الأمر؟
Dialogue: 0,1:08:00.38,1:08:02.52,Default,HEIN,0,0,0,,هل تخدع نفسك مرة أخرى؟
Dialogue: 0,1:08:03.69,1:08:06.59,Default,HEIN,0,0,0,,هل حقاً لقد خدعتني عيونكم وخطاباتكم الكاذبة؟
Dialogue: 0,1:08:07.76,1:08:10.83,Default,HEIN,0,0,0,,أنت من خدعتني طوال الوقت.
Dialogue: 0,1:08:11.88,1:08:15.26,Default,HEIN,0,0,0,,لم أكن أعلم أنك أنت من حاولت قتلي، حتى أنني نمت معك في نفس الغرفة.
Dialogue: 0,1:08:15.26,1:08:17.37,Default,HEIN,0,0,0,, إذًا ألا يجب أن أكون غاضبًا الآن؟
Dialogue: 0,1:08:17.53,1:08:19.00,Default,HEIN,0,0,0,,لقد قلتها بنفسك،
Dialogue: 0,1:08:20.14,1:08:23.57,Default,HEIN,0,0,0,,أن الجبان فقط هو الذي يهاجم الأضعف.
Dialogue: 0,1:08:25.02,1:08:26.31,Default,HEIN,0,0,0,,هل تحاول الانتقام مني؟
Dialogue: 0,1:08:27.44,1:08:30.05,Default,HEIN,0,0,0,,في هذه الحالة، لن أبقى مكتوف الأيدي
Dialogue: 0,1:08:31.55,1:08:33.78,Default,HEIN,0,0,0,,وغض الطرف عن كل مكائدك.
Dialogue: 0,1:08:40.92,1:08:42.49,Default,HEIN,0,0,0,,ما الذي يتحدث عنه؟
Dialogue: 0,1:09:00.81,1:09:01.88,Default,HEIN,0,0,0,,ماذا؟
Dialogue: 0,1:09:15.12,1:09:16.73,Default,HEIN,0,0,0,,ماذا علي أن أفعل
Dialogue: 0,1:09:17.83,1:09:20.60,Default,HEIN,0,0,0,,مع هذا الضعيف الغبي؟
Dialogue: 0,1:09:43.72,1:09:45.05,Default,HAINE,0,0,0,,الملكة الأرملة.
Dialogue: 0,1:09:45.40,1:09:47.16,Default,HEIN,0,0,0,,إذا كنت تبحث عن شخص تلومه على ما حدث،
Dialogue: 0,1:09:47.16,1:09:48.62,Default,HEIN,0,0,0,,أنا مستعد لقبول العقاب.
Dialogue: 0,1:09:49.56,1:09:53.16,Default,HEIN,0,0,0,,هل يمكنك توضيح عمن أبحث؟
Dialogue: 0,1:09:54.73,1:09:58.17,Default,HEIN,0,0,0,,سيدتي المنتظرة، أوفول، اختفت.
Dialogue: 0,1:09:58.77,1:10:00.07,Default,HEIN,0,0,0,,ما علاقتي بهذا؟
Dialogue: 0,1:10:01.00,1:10:02.24,Default,HEINE,0,0,0,,هل تعتقد أنني فعلت هذا؟
Dialogue: 0,1:10:02.38,1:10:04.66,Default,HEIN,0,0,0,,لأنك كنت بحاجة إلى شيء مني.
Dialogue: 0,1:10:07.04,1:10:10.75,Default,HEIN,0,0,0,,وأنا مستعد للتعبير عما تريد سماعه حقًا.
Dialogue: 0,1:10:12.85,1:10:14.95,Default,HEIN,0,0,0,,إذن فلنستمع.
Dialogue: 0,1:10:17.12,1:10:19.36,Default,HEIN,0,0,0,,عندما سقطت الملكة في البحيرة،
Dialogue: 0,1:10:19.99,1:10:21.59,Default,HEIN,0,0,0,,كنت بالقرب.
Dialogue: 0,1:10:23.99,1:10:25.49,Default,HEIN,0,0,0,,يوماً ما ستخسر
Dialogue: 0,1:10:26.66,1:10:29.16,Default,HEIN,0,0,0,,شخص عزيز عليك.
Dialogue: 0,1:10:47.85,1:10:50.29,Default,HEIN,0,0,0,,للحظة سيطرت عليّ مشاعري،
Dialogue: 0,1:10:52.76,1:10:54.89,Default,HEIN,0,0,0,,ودفعت الملكة إلى البحيرة.
Dialogue: 0,1:11:04.62,1:11:07.04,Default,ХЕЙН,0,0,0,,أرجو أن تستمعوا إلى آخر أخبارنا\Nza في المستقبل.
Dialogue: 0,1:11:07.24,1:11:10.14,Default,HEIN,0,0,0,,من فضلك، ارحم هؤلاء\Nالذين لم يرتكبوا أي خطأ.
Dialogue: 0,1:11:12.07,1:11:15.88,Default,HEINE,0,0,0,,سوف أقبل بكل سرور أي عقوبة\Nعلى ما فعلته.
Dialogue: 0,1:11:18.21,1:11:19.28,Default,HEIN,0,0,0,,بجدية؟
Dialogue: 0,1:11:26.09,1:11:28.79,Default,HEIN,0,0,0,,أنت تعرف موضوع هذه الرسالة.
Dialogue: 0,1:11:30.19,1:11:32.90,Default,HAINE,0,0,0,,لقد تلقيتها من الملكة الأم.
Dialogue: 0,1:11:34.73,1:11:37.17,Default,HEIN,0,0,0,,أوفول أعطانا إياها.
Dialogue: 0,1:11:38.10,1:11:41.30,Default,HEIN,0,0,0,,المكان والتاريخ والوقت المشار إليهما فيه،
Dialogue: 0,1:11:41.44,1:11:44.76,Default,HAINE,0,0,0,,يتزامن مع متى وأين\Nوقع حادث الملكة.
Dialogue: 0,1:11:45.14,1:11:47.58,Default,HEINE,0,0,0,,ماذا يعني هذا في رأيك؟
Dialogue: 0,1:11:48.08,1:11:51.61,Default,HEIN,0,0,0,,هذه هي المرة الأولى التي رأيته فيها.
Dialogue: 0,1:11:53.08,1:11:57.79,Default,HEIN,0,0,0,,هل اعتقدت حقاً أنه يمكنك إخفاء كل شيء؟
Dialogue: 0,1:11:59.39,1:12:01.96,Default,HEIN,0,0,0,,ولديك رأي عالٍ جدًا في نفسك.
Dialogue: 0,1:12:02.96,1:12:05.49,Default,HEIN,0,0,0,,أنت تعلم أنك مجرد ظل.
Dialogue: 0,1:12:10.17,1:12:11.93,Default,HAINE,0,0,0,,الملكة الأرملة.
Dialogue: 0,1:12:12.37,1:12:15.77,Default,HEIN,0,0,0,,أؤكد لك أن هذه الرسالة مزيفة.
Dialogue: 0,1:12:16.04,1:12:17.47,Default,HEIN,0,0,0,,وأنا متأكد من العكس.
Dialogue: 0,1:12:17.97,1:12:19.88,Default,HEIN,0,0,0,,بما أنهم من نفس عائلة تشو،
Dialogue: 0,1:12:19.88,1:12:22.88,Default,ХЕЙН,0,0,0,,بشكل واضح، قرروا الالتزام بكل ما يخصهم.
Dialogue: 0,1:12:22.88,1:12:26.68,Default,HAINE,0,0,0,,الملكة الأم\Nلم تتآمر أبدًا مع أحد،
Dialogue: 0,1:12:26.68,1:12:30.22,Default,HEIN,0,0,0,,حتى لو كانوا من نفس العائلة.
Dialogue: 0,1:12:31.15,1:12:36.06,Default,HEIN,0,0,0,,فمن زوّر هذه الرسالة؟
Dialogue: 0,1:12:40.30,1:12:42.83,Default,HEIN,0,0,0,,على ما يبدو، كنت بحاجة إلى شخص ما ليدعمك
Dialogue: 0,1:12:43.37,1:12:45.47,Default,HEIN,0,0,0,,خططك.
Dialogue: 0,1:12:50.97,1:12:53.08,Default,HEIN,0,0,0,,الملك هنا!
Dialogue: 0,1:12:55.64,1:12:56.78,Default,HEIN,0,0,0,,جلالتك.
Dialogue: 0,1:12:58.61,1:13:00.08,Default,HAINE,0,0,0,,الملكة الأرملة.
Dialogue: 0,1:13:00.12,1:13:02.52,Default,HEIN,0,0,0,,لقد وصلت. عظيم.
Dialogue: 0,1:13:02.89,1:13:05.02,Default,XO,0,0,0,,اعترفت المحظية الملكية.
Dialogue: 0,1:13:05.79,1:13:08.36,Default,XO,0,0,0,,قالت إنها دفعت الملكة إلى البحيرة بنية شريرة.
Dialogue: 0,1:13:10.86,1:13:12.80,Default,XO,0,0,0,,كل هذا كذب.
Dialogue: 0,1:13:12.80,1:13:15.33,Default,XO,0,0,0,,جلالتك، عد إلى رشدك.
Dialogue: 0,1:13:17.77,1:13:20.14,Default,XO,0,0,0,,أعلم أنك مجنون بها،
Dialogue: 0,1:13:20.14,1:13:22.97,Default,XO,0,0,0,,لكن لا يمكنني السماح لك بالحكم،
Dialogue: 0,1:13:22.97,1:13:24.81,Default,XO,0,0,0,,مع العلم أنك متحيز.
Dialogue: 0,1:13:25.24,1:13:29.28,Default,XO,0,0,0,,هل تحاول حماية مجرم؟
Dialogue: 0,1:13:29.81,1:13:32.51,Default,XO,0,0,0,,لقد حاولت إيذاء الملكة، زوجتك.
Dialogue: 0,1:13:34.18,1:13:35.98,Default,XO,0,0,0,,أخبره بنفسك!
Dialogue: 0,1:13:36.39,1:13:39.09,Default,XO,0,0,0,,من دفع الملكة إلى البحيرة؟
Dialogue: 0,1:13:51.03,1:13:52.23,Default,XO,0,0,0,,لقد كنت أنا.
Dialogue: 0,1:13:52.70,1:13:53.77,Default,XO,0,0,0,,هواجين.
Dialogue: 0,1:13:58.11,1:13:59.27,Default,XO,0,0,0,,هل سمعت؟
Dialogue: 0,1:14:03.01,1:14:05.98,Default,XO,0,0,0,,إذا أصررت على أنها ببساطة تتحمل اللوم على شخص آخر،
Dialogue: 0,1:14:06.28,1:14:09.02,Default,XO,0,0,0,,سأعطيك الفرصة لإثبات ذلك.
Dialogue: 0,1:14:11.15,1:14:12.45,Default,XO,0,0,0,,تعال!
Dialogue: 0,1:14:39.72,1:14:43.05,Default,XO,0,0,0,,اعترفت ماذا سنفعل الآن؟
Dialogue: 0,1:14:43.19,1:14:46.36,Default,XO,0,0,0,,ستكون هناك حاجة إليها كشاهدة، اعتني بها.
Dialogue: 0,1:14:50.36,1:14:51.49,Default,XO,0,0,0,,ماذا تفعل؟
Dialogue: 0,1:15:12.45,1:15:13.48,Default,XO,0,0,0,,امسك!
Dialogue: 0,1:15:35.74,1:15:38.57,Default,XO,0,0,0,,إذا اعترفت هنا
Dialogue: 0,1:15:38.57,1:15:40.08,Default,XO,0,0,0,,وتوافق على قطع الرأس،
Dialogue: 0,1:15:40.84,1:15:43.71,Default,XO,0,0,0,,لن أشك فيها.
Dialogue: 0,1:15:54.59,1:15:56.09,Default,XO,0,0,0,,قال تشيولجونغ ذلك كل ليلة
Dialogue: 0,1:15:56.09,1:15:57.69,Default,XO,0,0,0,,يرى رأسه مقطوعاً.
Dialogue: 0,1:15:59.03,1:16:00.50,Default,XO,0,0,0,,من الواضح أنه يشعر بالسوء الآن.
Dialogue: 0,1:16:01.53,1:16:02.60,Default,XO,0,0,0,,هذا فشل.
Dialogue: 0,1:16:18.25,1:16:19.85,Default,XO,0,0,0,,سأكشف الحقيقة!
Dialogue: 0,1:16:21.25,1:16:24.12,Default,XO,0,0,0,,سأقبل إرادتك يا صاحب الجلالة!
Dialogue: 0,1:16:25.75,1:16:27.92,Default,XO,0,0,0,,ليست هي من يجب إعدامها!
Dialogue: 0,1:16:34.93,1:16:36.00,Default,XO,0,0,0,,جلالتك!
Dialogue: 0,1:16:38.53,1:16:39.60,Default,XO,0,0,0,,أتوسل إليك.
Dialogue: 0,1:16:46.61,1:16:48.68,Default,XO,0,0,0,,هل ستخالف إرادة الملك؟
Dialogue: 0,1:17:23.41,1:17:25.01,Default,XO,0,0,0,,شولجونغ، الوغد.
Dialogue: 0,1:17:26.25,1:17:27.42,Default,XO,0,0,0,,إنه رائع.
Dialogue: 0,1:17:31.99,1:17:33.66,Default,XO,0,0,0,,أي نوع من الأبطال يتظاهر بأنه؟
Dialogue: 0,1:17:37.89,1:17:38.93,Default,XO,0,0,0,,دقيقة واحدة فقط.
Dialogue: 0,1:17:39.26,1:17:41.63,Default,XO,0,0,0,,ستمتلئ البحيرة اليوم.
Dialogue: 0,1:17:42.06,1:17:43.30,Default,XO,0,0,0,,حتى أتمكن من العودة.
Dialogue: 0,1:17:44.40,1:17:46.40,Default,XO,0,0,0,,أذيت الملكة...
Dialogue: 0,1:17:47.17,1:17:48.17,Default,XO,0,0,0,,توقف!
Dialogue: 0,1:18:09.83,1:18:11.43,Default,XO,0,0,0,,أيها الآلهة!
Dialogue: 0,1:18:13.50,1:18:14.66,Default,XO,0,0,0,,ما الأمر؟
Dialogue: 0,1:18:14.66,1:18:16.87,Default,XO,0,0,0,,لقد نفد الماء.
Dialogue: 0,1:18:17.50,1:18:18.53,Default,XO,0,0,0,,ماذا؟
Dialogue: 0,1:18:21.44,1:18:22.60,Default,XO,0,0,0,,
Dialogue: 0,1:18:23.00,1:18:24.91,Default,XO,0,0,0,,لقد أخذنا الكثير من الماء،
Dialogue: 0,1:18:24.91,1:18:26.74,Default,XO,0,0,0,,أن البئر قد جفت.
Dialogue: 0,1:18:27.91,1:18:29.64,Default,XO,0,0,0,,أوه لا!
Dialogue: 0,1:18:31.11,1:18:33.55,Default,XO,0,0,0,,لقد انتهيت.
Dialogue: 0,1:19:03.75,1:19:05.85,Default,XO,0,0,0,,اسمح لي، كضحية لهذا الحادث،
Dialogue: 0,1:19:05.88,1:19:07.62,Default,XO,0,0,0,,تسليط الضوء على الأحداث.
Dialogue: 0,1:19:13.72,1:19:15.02,Default,XO,0,0,0,,أنا
Dialogue: 0,1:19:20.10,1:19:21.60,Default,XO,0,0,0,,حاول الانتحار.
Dialogue: 0,1:19:25.97,1:19:28.17,Default,XO,0,0,0,,هل تعتقد أن هناك رجلاً رائعًا واحدًا فقط هنا؟
Dialogue: 0,1:19:28.60,1:19:30.44,Default,XO,0,0,0,,أنا البطل هنا.
Dialogue: 0,1:19:37.25,1:19:39.15,Default,XO,0,0,0,,سأعود، لذا لا يهم.
Dialogue: 0,1:19:41.05,1:19:46.32,Default,XO,0,0,0,,أسألك، لا تمسّ الأبرياء من أي شيء.
Dialogue: 0,1:19:52.29,1:19:53.43,Default,XO,0,0,0,,ممتاز.
Dialogue: 0,1:20:32.40,1:20:34.97,Default,XO,0,0,0,,دخل الأمير يونبيونغ القصر مع البلطجية.
Dialogue: 0,1:20:34.97,1:20:36.87,Default,XO,0,0,0,,يبدو أنهم مدربون جيدًا.
Dialogue: 0,1:20:36.87,1:20:39.47,Default,XO,0,0,0,,يجب قطع المشاكل من جذورها.
Dialogue: 0,1:20:39.47,1:20:41.88,Default,XO,0,0,0,,لقد جفت البئر.
Dialogue: 0,1:20:41.88,1:20:43.41,Default,XO,0,0,0,,آمنت أنه ينبغي عليّ
Dialogue: 0,1:20:43.41,1:20:45.65,Default,XO,0,0,0,,أتركك لتسعدك.
Dialogue: 0,1:20:45.65,1:20:47.32,Default,XO,0,0,0,,تلك النظرة الجريئة!
Dialogue: 0,1:20:47.32,1:20:49.32,Default,XO,0,0,0,,كيف يجرؤ؟
Dialogue: 0,1:20:49.32,1:20:51.75,Default,XO,0,0,0,,حالة الملكة تزداد سوءاً كل يوم.
Dialogue: 0,1:20:51.75,1:20:53.39,Default,XO,0,0,0,,ربما يستحق الأمر السؤال
Dialogue: 0,1:20:53.39,1:20:54.76,Default,XO,0,0,0,,أقيلها؟
Dialogue: 0,1:20:56.26,1:20:58.29,Default,XO,0,0,0,,الآن سيعود كل شيء إلى مكانه.


