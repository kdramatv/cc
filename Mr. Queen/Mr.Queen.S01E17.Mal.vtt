Dialog: 0,0:00:58.00,0:01:03.98,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДДСТЕ
Dialog: 0,0:00:58.00,0:01:03.98, Lalai,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807}\fscy2007 92 38 l 0 38
Dialog: 0,0:00:58.00,0:01:03.98,berfungsi,,0,0,0,,{\pos(801,256)}Mengusahakan siri:\N Lily, Tiramisu, Biryulka, Hos, Zinger, Hazelnut
Dialog: 0,0:00:58.00,0:01:03.98,tajuk,,0,0,0,,{\fscx75\fscy75\pos(846,392)}Bagaimana saya menjadi
Dialog: 0,0:00:58.00,0:01:03.98,nama,,0,0,0,,{\fscx75\fscy75\pos(848,456)}ratu
Dialog: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialog: 0,0:01:04.09,0:01:06.37, Lalai,li,0,0,0,,Semua watak adalah rekaan,
Dialog: 0,0:01:06.37,0:01:08.54, Lalai,li,0,0,0,,dan peristiwa yang ditunjukkan adalah fiksyen.
Dialog: 0,0:01:09.80,0:01:12.30,Lalai,li,0,0,0,,Tahniah, Tuanku.
Dialog: 0,0:01:18.37,0:01:19.82,Lalai,li,0,0,0,,Permaisuri saya, terima kasih.
Dialog: 0,0:01:28.75,0:01:31.82,Lalai,li,0,0,0,,-Tahniah, Tuanku!\N-Tahniah, Tuanku!
Dialog: 0,0:01:34.60,0:01:36.69,Lalai,li,0,0,0,,Saya akan menjadi seorang bapa!
Dialog: 0,0:01:41.46,0:01:42.54,Lalai,li,0,0,0,,I
Dialog: 0,0:01:44.90,0:01:46.50,Lalai,adakah,0,0,0,, mengandung?
Dialog: 0,0:02:07.83,0:02:09.89, Lalai,li,0,0,0,, Hentikan!
Dialog: 0,0:02:23.10,0:02:24.35, Lalai,li,0,0,0,,-Tuhan.\N-Keluar dari sini.
Dialog: 0,0:02:24.47,0:02:26.08,Lalai,li,0,0,0,,-Yang Mulia.\N-Tuanku.
Dialog: 0,0:02:40.30,0:02:42.72,Lalai,li,0,0,0,,Mengapa permaisuri sangat kecewa?
Dialog: 0,0:02:43.36,0:02:45.66,Lalai,li,0,0,0,,Dia tidak kecewa.
Dialog: 0,0:02:46.07,0:02:48.21, Lalai,li,0,0,0,,Beginilah dia meluahkan kegembiraannya.
Dialog: 0,0:02:48.94,0:02:50.00, Lalai,li,0,0,0,,Ya.
Dialog: 0,0:02:53.94,0:02:57.10, Lalai, ialah,0,0,0,,Adakah ini kesan sampingan kehamilan?
Dialog: 0,0:03:00.64,0:03:03.08,Lalai,atau,0,0,0,,Ini lebih daripada kegagalan pengenalan diri.
Dialog: 0,0:03:03.08,0:03:05.98,Lalai,li,0,0,0,,Identiti saya akan hilang dan jiwa saya akan hilang.
Dialog: 0,0:03:07.82,0:03:10.22,Lalai,sama ada,0,0,0,,Beginikah pengakhiran hidup saya?
Dialog: 0,0:03:13.82,0:03:16.50,Lalai,li,0,0,0,,Saya beritahu awak yang saya menentang perkahwinan.
Dialog: 0,0:03:16.57,0:03:18.47,Lalai,atau,0,0,0,,Walaupun saya telah berkahwin,
Dialog: 0,0:03:18.47,0:03:20.07,Lalai,li,0,0,0,,Saya tidak mahu mempunyai anak.
Dialog: 0,0:03:20.44,0:03:23.10,Lalai,li,0,0,0,,Sukar untuk saya bertahan\N dalam dunia yang bermusuhan ini,
Dialog: 0,0:03:23.10,0:03:24.31, Lalai, sama ada,0,0,0,, jenis kehamilan apa?
Dialog: 0,0:03:24.54,0:03:26.44,Lalai,li,0,0,0,,Melulu seperti menanggalkan perisai badan anda
Dialog: 0,0:03:26.44,0:03:28.67, Lalai,li,0,0,0,,dan menari samba di bawah api.
Dialog: 0,0:03:29.85,0:03:30.97, Lalai,li,0,0,0,,Dan bukan itu sahaja.
Dialog: 0,0:03:31.00,0:03:33.94,Lalai,sama ada,0,0,0,,Kehamilan dan bersalin memendekkan jangka hayat.
Dialog: 0,0:03:34.04,0:03:36.54,Lalai,li,0,0,0,,Anda menyerahkan nyawa anda supaya anak anda boleh hidup.
Dialog: 0,0:03:36.88,0:03:38.69,Lalai,li,0,0,0,,Saya mesti menyerahkan hidup saya
Dialog: 0,0:03:38.69,0:03:40.62, Lalai, adakah, 0,0,0,, demi seorang kanak-kanak yang saya tidak tahu?
Dialog: 0,0:03:42.66,0:03:46.85, Lalai, atau,0,0,0,, Alam Semula Jadi Sialan, berikan orang lain zuriat!
Dialog: 0,0:03:51.54,0:03:57.20,Lalai,li,0,0,0,,Saya tidak percaya saya hamil!
Dialog: 0,0:04:02.88,0:04:05.72,Lalai,li,0,0,0,,Kehamilan itu indah
Dialog: 0,0:04:06.44,0:04:08.98,Lalai,li,0,0,0,,Tunggu, Yang Amat Mulia.
Dialog: 0,0:04:09.91,0:04:12.66, Lalai,li,0,0,0,,17 episod
Dialog: 0,0:04:17.53,0:04:19.32, Lalai,li,0,0,0,,Anda menanam badan lain.
Dialog: 0,0:04:19.42,0:04:22.40, Lalai,li,0,0,0,,Anda fikir saya tidak dapat mengenali Ovol?
Dialog: 0,0:04:23.72,0:04:27.13,Lalai,li,0,0,0,,Saya melakukan ini supaya anda tahu
Dialog: 0,0:04:27.63,0:04:30.07,Lalai,atau,0,0,0,,diri sebenar saya, yang saya tidak syak.
Dialog: 0,0:04:30.66,0:04:34.20,Lalai,li,0,0,0,,Permaisuri berpaling daripada Kim Andonian.
Dialog: 0,0:04:34.63,0:04:38.17,Lalai,li,0,0,0,,The Andonian Kims telah bersatu dengan kami.
Dialog: 0,0:04:38.97,0:04:42.72,Lalai,li,0,0,0,,Ini adalah peluang anda untuk menjadi ratu.
Dialog: 0,0:04:43.75,0:04:47.66,Lalai,li,0,0,0,,Jangan cuba kawal saya lagi.
Dialog: 0,0:04:53.19,0:04:55.90,Lalai,li,0,0,0,,Berapa lama burung yang dijinakkan oleh manusia akan hidup,
Dialog: 0,0:04:56.87,0:04:59.90, Lalai, jika,0,0,0,,jika dia meninggalkan sel?
Dialog: 0,0:05:02.94,0:05:07.44,Default,li,0,0,0,,Ada berita yang raja ingin sampaikan kepada seluruh dunia.
Dialog: 0,0:05:07.91,0:05:09.60, Lalai, atau,0,0,0,, Yang mana?
Dialog: 0,0:05:09.97,0:05:11.62,Lalai,li,0,0,0,,Ratu
Dialog: 0,0:05:13.28,0:05:15.29,Lalai,adalah,0,0,0,,hamil.
Dialog: 0,0:05:37.73,0:05:41.58,Lalai,li,0,0,0,,Ini ialah gendang yang mengumumkan acara yang menggembirakan.
Dialog: 0,0:06:16.15,0:06:18.31, Lalai,li,0,0,0,,Sekarang pantri saya kosong,
Dialog: 0,0:06:18.81,0:06:21.48,Lalai,atau,0,0,0,,tiada apa-apa untuk mengisi hati yang kosong.
Dialog: 0,0:06:22.68,0:06:26.11,Lalai,li,0,0,0,,Tiada makanan istimewa akan mengisi perut saya...
Dialog: 0,0:06:27.39,0:06:31.05, Lalai,li,0,0,0,,Tidak, jiwaku. Bagaimana untuk mengisinya?
Dialog: 0,0:06:31.85,0:06:34.20,Lalai,li,0,0,0,,Saya membelakangi keluarga saya.
Dialog: 0,0:06:35.03,0:06:37.77, Lalai,li,0,0,0,,Saya seorang penyendiri.
Dialog: 0,0:06:40.97,0:06:42.14, Lalai,li,0,0,0,, En!
Dialog: 0,0:06:42.66,0:06:43.80, Lalai,li,0,0,0,, En!
Dialog: 0,0:06:45.28,0:06:47.51,Lalai,li,0,0,0,,-Encik!\N-Apa?
Dialog: 0,0:06:47.51,0:06:49.37,Lalai,li,0,0,0,,Berita segera dari istana.
Dialog: 0,0:06:52.65,0:06:56.29,Lalai,li,0,0,0,,Sesuatu berlaku kepada permaisuri?
Dialog: 0,0:06:56.48,0:06:59.85,Lalai,li,0,0,0,,Permaisuri mengandung!
Dialog: 0,0:07:05.70,0:07:07.79,Lalai,atau,0,0,0,,Apakah sebabnya?
Dialog: 0,0:07:11.47,0:07:14.49,Lalai,li,0,0,0,,Yang Mulia, bukannya mencari sebab,
Dialog: 0,0:07:14.49,0:07:18.87,Lalai,atau,0,0,0,,mungkin anda boleh cuba buat dia berasa lebih baik?
Dialog: 0,0:07:19.01,0:07:22.01, Lalai,li,0,0,0,,Idea yang bagus. Bagaimana untuk melakukan ini?
Dialog: 0,0:07:22.01,0:07:24.21,Lalai,li,0,0,0,,Bagaimana untuk membahagiakan seorang wanita?
Dialog: 0,0:07:28.35,0:07:30.61,Lalai,li,0,0,0,,Bagaimana anda tahu itu.
Dialog: 0,0:07:32.05,0:07:34.89, Lalai,li,0,0,0,,Dan siapa yang harus saya tanya tentang perkara ini?
Dialog: 0,0:07:40.03,0:07:41.22,Lalai,li,0,0,0,,Jadi saya
Dialog: 0,0:07:41.79,0:07:45.34,Lalai,li,0,0,0,,menjemput pakar untuk membantu menyelesaikan masalah anda.
Dialog: 0,0:08:05.46,0:08:09.29,Lalai,li,0,0,0,,Kebelakangan ini, inilah satu-satunya soalan yang dia fikirkan.
Dialog: 0,0:08:16.70,0:08:18.27,Lalai,li,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:08:18.27,0:08:20.34,Lalai,li,0,0,0,,Dia mungkin akan marah sama.
Dialog: 0,0:08:21.64,0:08:23.97, Lalai,li,0,0,0,,Dan kemudian anda akan sebut.
Dialog: 0,0:08:26.64,0:08:28.71, Lalai,li,0,0,0,,"Saya menyiram bunga saya."
Dialog: 0,0:08:30.41,0:08:33.35,Lalai,li,0,0,0,,Jika saya melakukan ini, saya ragu saya akan bertahan.
Dialog: 0,0:08:33.37,0:08:35.11,Lalai,li,0,0,0,,Jadi dia seorang gadis yang berperwatakan.
Dialog: 0,0:08:35.52,0:08:37.29,Lalai,atau,0,0,0,,Dalam kes itu
Dialog: 0,0:08:37.85,0:08:39.52, Lalai, adakah terdapat cara yang berkesan?
Dialog: 0,0:08:39.72,0:08:40.98, Lalai, atau,0,0,0,, Yang mana satu?
Dialog: 0,0:08:45.66,0:08:47.90,Lalai,li,0,0,0,,Awak buat muka bodoh.
Dialog: 0,0:08:50.06,0:08:53.47,Lalai,li,0,0,0,,Saya benci diri saya kerana berfikiran sama seperti dia.
Dialog: 0,0:08:54.06,0:08:55.47,Lalai,li,0,0,0,,Maaf.
Dialog: 0,0:08:56.10,0:08:57.91, Lalai, sama ada,0,0,0,, Terdapat sekurang-kurangnya beberapa faedah.
Dialog: 0,0:08:58.16,0:08:59.21, Lalai, atau,0,0,0,,Tidak boleh.
Dialog: 0,0:08:59.21,0:09:02.91,Lalai,li,0,0,0,,Saya sedar betapa bodohnya mencari jawapan daripada orang lain.
Dialog: 0,0:09:04.08,0:09:06.97,Lalai,li,0,0,0,,Hanya saya mengenalinya lebih baik daripada orang lain.
Dialog: 0,0:09:24.33,0:09:27.04,Lalai,li,0,0,0,,Kenapa awak menangis? Saya yang mahu menangis.
Dialog: 0,0:09:27.10,0:09:28.77,Lalai,li,0,0,0,,Ini adalah air mata kebahagiaan.
Dialog: 0,0:09:30.20,0:09:32.57,Lalai,li,0,0,0,,Anda boleh menangis semahu-mahunya hari ini.
Dialog: 0,0:09:37.84,0:09:39.34,Lalai,li,0,0,0,,Baik. menangis.
Dialog: 0,0:09:40.48,0:09:43.25,Lalai,li,0,0,0,,Anda boleh menangis untuk saya.
Dialog: 0,0:09:44.79,0:09:47.21,Lalai,li,0,0,0,,Menitiskan air mata untuk hidup saya,
Dialog: 0,0:09:48.66,0:09:50.45, Lalai, atau,0,0,0,, di mana saya tiada pilihan.
Dialog: 0,0:09:55.03,0:09:56.13,Lalai,li,0,0,0,,Yang Mulia.
Dialog: 0,0:09:57.42,0:10:01.04,Lalai,li,0,0,0,,Berhenti menitiskan air mata kebahagiaan.
Dialog: 0,0:10:02.61,0:10:04.01, Lalai,li,0,0,0,,Apa lagi yang perlu saya lakukan?
Dialog: 0,0:10:04.01,0:10:08.14,Lalai,atau,0,0,0,,Anda mesti memberitahu halaman secara peribadi
Dialog: 0,0:10:08.14,0:10:10.07, Lalai,li,0,0,0,,dan terima tahniah.
Dialog: 0,0:10:11.20,0:10:14.15, Lalai, atau,0,0,0,,Saya tidak mahu. Saya bergaduh dengan saudara mara saya.
Dialog: 0,0:10:14.84,0:10:16.34, Lalai, sama ada,0,0,0,, Dibantah atau tidak,
Dialog: 0,0:10:16.89,0:10:20.55,Lalai,atau,0,0,0,,jika anda melanggar perintah yang ditetapkan, anda perlu menjawab.
Dialog: 0,0:10:21.73,0:10:23.68,Lalai,li,0,0,0,,Jadi saya lebih benci kehamilan.
Dialog: 0,0:10:25.29,0:10:28.05,Lalai,li,0,0,0,,Janda Ratu telah tiba.
Dialog: 0,0:10:28.32,0:10:30.40,Lalai,li,0,0,0,,Ibu Permaisuri ada di sini juga.
Dialog: 0,0:10:30.66,0:10:32.87,Lalai,li,0,0,0,,Mereka mendahului anda.
Dialog: 0,0:10:33.24,0:10:34.90,Lalai,atau,0,0,0,,Apa yang perlu kita lakukan?
Dialog: 0,0:10:52.02,0:10:53.29,Lalai,atau,0,0,0,,Selamat Datang.
Dialog: 0,0:10:58.26,0:11:01.79,Lalai,li,0,0,0,,Saya sepatutnya memberitahu anda secara peribadi,
Dialog: 0,0:11:02.53,0:11:06.46,Lalai,li,0,0,0,,tetapi, seperti yang anda lihat, saya tidak boleh bangun.
Dialog: 0,0:11:08.51,0:11:10.04, Lalai,li,0,0,0,,Apakah simptom saya?
Dialog: 0,0:11:13.30,0:11:16.07,Lalai,li,0,0,0,,Dia pening kerana morning sickness
Dialog: 0,0:11:16.07,0:11:18.15,Lalai,li,0,0,0,,dan sakit akibat kehamilan.
Dialog: 0,0:11:18.15,0:11:20.15,Lalai,li,0,0,0,,Ya, betul.
Dialog: 0,0:11:21.48,0:11:23.84,Lalai,li,0,0,0,,Jadi saya datang sendiri.
Dialog: 0,0:11:27.21,0:11:28.41,Lalai,li,0,0,0,,Sila
Dialog: 0,0:11:29.86,0:11:31.32, Lalai, atau,0,0,0,,duduk.
Dialog: 0,0:11:31.32,0:11:32.63, Lalai,li,0,0,0,,Semuanya baik-baik saja.
Dialog: 0,0:11:32.86,0:11:35.87,Lalai,li,0,0,0,,Mesti sukar untuk anda. Duduk dengan selesa.
Dialog: 0,0:11:36.09,0:11:37.73, Lalai,li,0,0,0,,Baiklah, sudah tentu.
Dialog: 0,0:11:46.70,0:11:49.51,Lalai,li,0,0,0,,Apabila saya mendengar berita itu, saya gembira.
Dialog: 0,0:11:49.88,0:11:52.28,Lalai,li,0,0,0,,Malah membawa azimat, walaupun dia menolaknya.
Dialog: 0,0:11:53.12,0:11:55.07,Lalai,li,0,0,0,,Mahu pastikan
Dialog: 0,0:11:55.07,0:11:58.18, Lalai, sama ada,0,0,0,, bahawa anda akan mengandung anak yang sihat.
Dialog: 0,0:11:59.52,0:12:02.45,Lalai,li,0,0,0,,Dan ia kelihatan seperti sumpahan.
Dialog: 0,0:12:04.82,0:12:08.00,Lalai,li,0,0,0,,Saya seorang ateis. Saya tidak percaya dengan jimat.
Dialog: 0,0:12:08.00,0:12:10.23,Lalai,li,0,0,0,,Anda akan sedar apabila anda bersalin.
Dialog: 0,0:12:11.09,0:12:13.90,Lalai,li,0,0,0,,Saya mahu mempercayai sesuatu yang saya tidak percayai.
Dialog: 0,0:12:14.66,0:12:16.77,Lalai,li,0,0,0,,Anda akan jatuh ke dalam keputusasaan
Dialog: 0,0:12:16.77,0:12:21.17,Lalai,atau,0,0,0,,dan anda ingin membuat hajat pada batu yang semua orang tendang.
Dialog: 0,0:12:23.84,0:12:26.52,Lalai,li,0,0,0,,Anda tidak perlu takut apa-apa.
Dialog: 0,0:12:26.78,0:12:30.91,Lalai,li,0,0,0,,Tetapi sekarang anda akan takut dengan segala-galanya.
Dialog: 0,0:12:32.26,0:12:34.62,Lalai,li,0,0,0,,Kehilangan anak memberi kesan buruk kepada ibu.
Dialog: 0,0:12:36.68,0:12:38.63,Default,li,0,0,0,,Saya minta doktor sediakan ubat,
Dialog: 0,0:12:38.63,0:12:40.36, Lalai, atau,0,0,0,,yang akan melindungi anda daripada keguguran.
Dialog: 0,0:12:40.36,0:12:42.53, Lalai,li,0,0,0,,Ambil dengan ketat setiap hari.
Dialog: 0,0:12:43.06,0:12:45.09,Lalai,atau,0,0,0,,Jika sesuatu berlaku kepada kanak-kanak itu,
Dialog: 0,0:12:45.09,0:12:47.33, Lalai, atau,0,0,0,,anda akan bertanggungjawab untuk perkara ini.
Dialog: 0,0:12:47.77,0:12:49.87,Lalai,li,0,0,0,,Mulai sekarang, jangan berkelakuan terburu-buru.
Dialog: 0,0:12:50.11,0:12:52.80,Lalai,li,0,0,0,,Berhati-hati demi anak.
Dialog: 0,0:12:53.67,0:12:56.04,Lalai,li,0,0,0,,Kedua-duanya datang untuk menakut-nakutkan saya.
Dialog: 0,0:12:57.20,0:12:58.71,Lalai,li,0,0,0,,Saya benar-benar akan sakit sekarang.
Dialog: 0,0:13:21.33,0:13:24.14,Lalai,li,0,0,0,,Terima kasih atas kebijaksanaan anda.
Dialog: 0,0:13:40.16,0:13:41.31,Lalai,lee,0,0,0,,Ini Putera Yeonpyeong.
Dialog: 0,0:13:44.99,0:13:46.09,Lalai,atau,0,0,0,,Enter.
Dialog: 0,0:13:56.01,0:13:57.91,Lalai,li,0,0,0,,Anda datang kerana bimbang.
Dialog: 0,0:13:59.91,0:14:01.07,Lalai,li,0,0,0,,Saya tidak apa-apa,
Dialog: 0,0:14:02.30,0:14:04.61,Lalai,li,0,0,0,,tetapi saya tidak boleh
Dialog: 0,0:14:04.61,0:14:06.88,Lalai,atau,0,0,0,,ucapkan tahniah kepada raja dan permaisuri.
Dialog: 0,0:14:09.02,0:14:10.89,Lalai,li,0,0,0,,Saya ada laluan sendiri.
Dialog: 0,0:14:12.91,0:14:15.92,Lalai,li,0,0,0,,Saya datang ke istana untuk membantu Baginda.
Dialog: 0,0:14:16.68,0:14:18.29,Lalai,li,0,0,0,,Saya fikir ia adalah satu-satunya cara
Dialog: 0,0:14:19.32,0:14:21.82,Lalai,jika,0,0,0,,untuk membantunya ialah memberinya keselesaan mental.
Dialog: 0,0:14:23.27,0:14:25.56,Lalai,li,0,0,0,,Tetapi apabila saya melihat permaisuri, saya menyedari bahawa saya salah.
Dialog: 0,0:14:28.74,0:14:32.54,Lalai,li,0,0,0,,Inilah peluang anda untuk menjadi ratu.
Dialog: 0,0:14:44.81,0:14:45.95,Lalai,li,0,0,0,,Ibu Permaisuri.
Dialog: 0,0:14:46.81,0:14:50.32,Lalai,li,0,0,0,,Untuk apa saya berhutang kesenangan ini?
Dialog: 0,0:14:58.23,0:15:01.59,Lalai,li,0,0,0,,Apa yang membawa awak ke sini, ketua gundik?
Dialog: 0,0:15:06.33,0:15:08.33,Lalai,li,0,0,0,,Anda telah bekerjasama dengan Andonian Kims.
Dialog: 0,0:15:10.80,0:15:13.07,Lalai,li,0,0,0,,-Ini adalah keinginan klan.\N-Jangan berdagang atas nama klan
Dialog: 0,0:15:13.07,0:15:14.67,Lalai,atau,0,0,0,,demi pergaduhan kecil.
Dialog: 0,0:15:16.25,0:15:18.25,Lalai,atau,0,0,0,,Adakah anda mahu kekal sebagai penasihat yang betul?
Dialog: 0,0:15:20.41,0:15:22.13, Lalai, atau,0,0,0,,Buat keputusan yang betul.
Dialog: 0,0:15:22.13,0:15:25.45,Lalai,atau,0,0,0,,Jika tidak, saya akan mengumpulkan ahli puak kita,
Dialog: 0,0:15:25.45,0:15:27.69,Lalai,sama ada,0,0,0,,prihatin tentang masa depan Joseon,
Dialog: 0,0:15:28.19,0:15:30.32,Lalai,li,0,0,0,,diketuai oleh bapa saya.
Dialog: 0,0:15:38.70,0:15:40.67,Lalai,atau,0,0,0,,Ayah saya hantar semua ini?
Dialog: 0,0:15:41.14,0:15:42.17, Lalai, atau,0,0,0,,Ya.
Dialog: 0,0:15:42.61,0:15:46.07,Lalai,li,0,0,0,,Hadiah untuk bayi yang anda sedang mengandung.
Dialog: 0,0:15:46.54,0:15:48.02,Lalai,li,0,0,0,,Dan banyak lagi.
Dialog: 0,0:15:48.34,0:15:49.91,Lalai,li,0,0,0,,Terdapat juga hadiah di koridor.
Dialog: 0,0:15:53.52,0:15:55.73,Lalai,li,0,0,0,,Ini lebih membingungkan saya.
Dialog: 0,0:15:56.36,0:15:59.69,Lalai,li,0,0,0,,Sudah gelap, saya akan menyalakan lilin.
Dialog: 0,0:16:04.16,0:16:06.43, Lalai, ialah,0,0,0,,Apa gunanya lilin ini?
Dialog: 0,0:16:06.87,0:16:08.56,Lalai,li,0,0,0,,Mulai saat ini, hidup saya
Dialog: 0,0:16:10.46,0:16:11.74, Lalai, atau,0,0,0,,akan menjadi hitam legam.
Dialog: 0,0:16:37.13,0:16:38.93,Lalai,zi,0,0,0,,Penasihat Kiri Kim Seok-keun
Dialog: 0,0:16:40.93,0:16:43.04,Lalai,zi,0,0,0,,Mereka menyerang pegawai itu semula.
Dialog: 0,0:16:43.24,0:16:45.24,Lalai,zi,0,0,0,,Mereka tidak memenggal kepala ketua.
Dialog: 0,0:16:45.70,0:16:47.17,Lalai,zi,0,0,0,,Kami tidak berani menyentuhnya,
Dialog: 0,0:16:47.17,0:16:50.04,Lalai,zi,0,0,0,,kerana mereka takut ia akan dianggap sebagai pengkhianatan.
Dialog: 0,0:16:50.25,0:16:52.41,Lalai,zi,0,0,0,,Adakah petani ini begitu berani?
Dialog: 0,0:16:53.17,0:16:56.08,Lalai,zi,0,0,0,,Tiada sebab untuk membuang semua usaha anda untuk menangkap mereka.
Dialog: 0,0:16:56.08,0:16:57.29,Lalai,zi,0,0,0,,Ini membimbangkan saya.
Dialog: 0,0:16:59.05,0:17:02.99,Default,zi,0,0,0,,By the way, adakah mereka menemui kod pengikut Tonhak di istana?
Dialog: 0,0:17:11.46,0:17:13.50,Lalai,zi,0,0,0,,Kim Soyeon
Dialog: 0,0:17:14.77,0:17:17.00,Lalai,zi,0,0,0,,Pengikut Tonghak dapat memasuki istana,
Dialog: 0,0:17:17.00,0:17:18.83,Lalai,zi,0,0,0,,ini serius, anda perlu cepat.
Dialog: 0,0:17:18.83,0:17:22.48,Lalai,zi,0,0,0,,Bagaimana jika kerana kita\N tidak melakukan apa-apa, akan ada lebih banyak daripada mereka?
Dialog: 0,0:17:25.15,0:17:27.65,Lalai,zi,0,0,0,,Fokus sahaja pada tugasan anda.
Dialog: 0,0:17:35.45,0:17:38.58,Lalai,zi,0,0,0,,Yang Mulia, mulai hari ini
Dialog: 0,0:17:39.42,0:17:40.59,Lalai,zi,0,0,0,,"Pendidikan pranatal"
Dialog: 0,0:17:40.59,0:17:42.23, Lalai,zi,0,0,0,,anda akan memulakan latihan pranatal.
Dialog: 0,0:17:48.64,0:17:50.56,Lalai,zi,0,0,0,,Anda tidak boleh berbaring di sisi anda.
Dialog: 0,0:17:50.77,0:17:52.70,Lalai,zi,0,0,0,,Anda tidak boleh bersandar pada tangan anda.
Dialog: 0,0:17:53.11,0:17:56.30,Lalai,zi,0,0,0,,Anda tidak boleh mengangkat kepala apabila anda berbaring.
Dialog: 0,0:17:56.30,0:17:57.30,Lalai,zi,0,0,0,,Sial!
Dialog: 0,0:18:11.19,0:18:14.46,Lalai,zi,0,0,0,,Anda tidak boleh ketawa, terkejut atau takut.
Dialog: 0,0:18:14.73,0:18:16.70,Lalai,zi,0,0,0,,berkabung, menangis
Dialog: 0,0:18:16.70,0:18:19.79, Lalai,zi,0,0,0,, dan anda juga tidak boleh bercakap banyak.
Dialog: 0,0:18:25.80,0:18:29.51,Lalai,zi,0,0,0,,Anda perlu meninggalkan makanan luar biasa itu.
Dialog: 0,0:18:31.78,0:18:34.18,Lalai,zi,0,0,0,,Seolah-olah badan saya bukan milik saya!
Dialog: 0,0:18:35.07,0:18:36.54,Lalai,zi,0,0,0,,Nah, itu benar, sudah tentu.
Dialog: 0,0:18:36.54,0:18:38.02,Lalai,zi,0,0,0,,Tetapi saya baru terbiasa!
Dialog: 0,0:18:38.81,0:18:41.26,Lalai,zi,0,0,0,,Mengapa semuanya kembali kepada asal kerana kehamilan ini\N?
Dialog: 0,0:18:42.49,0:18:43.62,Lalai,zi,0,0,0,,Terutama anda.
Dialog: 0,0:18:44.38,0:18:46.43,Lalai,zi,0,0,0,,Saya fikir awak berhenti mengganggu saya.
Dialog: 0,0:18:46.62,0:18:50.89,Lalai,zi,0,0,0,,Ini semua demi bayi anda.
Dialog: 0,0:18:50.89,0:18:52.86,Lalai,zi,0,0,0,,Untuk anak itu terus hidup,\NI perlu bertahan sendiri.
Dialog: 0,0:18:52.86,0:18:54.20,Lalai,zi,0,0,0,,Adakah saya mesin untuk mengecop kanak-kanak?
Dialog: 0,0:18:54.20,0:18:55.44,Lalai,zi,0,0,0,,Inkubator hidup, atau apa?
Dialog: 0,0:18:55.94,0:18:57.77,Lalai,zi,0,0,0,,Bukan saya seorang sahaja yang perlu menderita.
Dialog: 0,0:18:57.83,0:18:58.90,Lalai,zi,0,0,0,,Apa yang ayah sedang buat?
Dialog: 0,0:18:58.90,0:19:00.60,Lalai,zi,0,0,0,,Pergi ke Cheoljong, beritahu dia tentang latihan.
Dialog: 0,0:19:01.18,0:19:04.64,Lalai,zi,0,0,0,,Secara umum, baris 3 bab 1 mengatakan bahawa
Dialog: 0,0:19:04.64,0:19:08.07,Lalai,zi,0,0,0,,bapa juga mesti menjalani pendidikan pranatal.
Dialog: 0,0:19:08.07,0:19:10.29,Lalai,zi,0,0,0,,Sebaik sahaja Baginda selesai urusannya,
Dialog: 0,0:19:10.29,0:19:11.95,Lalai,zi,0,0,0,,anda akan belajar bersama...
Dialog: 0,0:19:11.95,0:19:13.52,Lalai,zi,0,0,0,,Hari saya bermula dengan kehamilan
Dialog: 0,0:19:13.52,0:19:15.08, Lalai,zi,0,0,0,,dan ini akan berakhir dengan sama?
Dialog: 0,0:19:18.85,0:19:20.93,Lalai,zi,0,0,0,,Hidup saya sudah hilang.
Dialog: 0,0:19:25.70,0:19:26.79,Lalai,zi,0,0,0,,Tidak, Tuanku.
Dialog: 0,0:19:28.06,0:19:30.60,Lalai,zi,0,0,0,,Mustahil, Tuanku. Ambillah.
Dialog: 0,0:19:30.60,0:19:31.63, Lalai,zi,0,0,0,,Hon Young.
Dialog: 0,0:19:33.90,0:19:35.28,Lalai,zi,0,0,0,,Selepas kejadian itu
Dialog: 0,0:19:35.98,0:19:38.45,Lalai,zi,0,0,0,,Kim Byunin dan permaisuri tidak berjumpa lagi.
Dialog: 0,0:19:38.75,0:19:41.75,Lalai,zi,0,0,0,,Selepas penolakan, dia sepatutnya mengetahui bahawa dia hamil.
Dialog: 0,0:19:42.54,0:19:44.58,Lalai,zi,0,0,0,,Saya pasti dia tidak mempunyai sesiapa untuk bergantung.
Dialog: 0,0:19:46.88,0:19:48.42,Lalai,zi,0,0,0,,Lelaki malang.
Dialog: 0,0:19:57.00,0:19:58.47,Lalai,zi,0,0,0,,Saya harap awak makan dengan baik.
Dialog: 0,0:19:59.00,0:20:00.09,Lalai,zi,0,0,0,,Selamat tinggal.
Dialog: 0,0:20:03.97,0:20:05.60,Lalai,zi,0,0,0,,Anda perlu tidur di rumah.
Dialog: 0,0:20:07.90,0:20:09.64, Lalai,zi,0,0,0,,Anda kelihatan letih.
Dialog: 0,0:20:24.29,0:20:25.96,Lalai,zi,0,0,0,,Tekanan adalah punca semua penyakit.
Dialog: 0,0:20:25.96,0:20:27.73, Lalai,zi,0,0,0,,Ia juga akan memudaratkan bayi.
Dialog: 0,0:20:29.89,0:20:31.00, Lalai, zee,0,0,0,, Bersedia.
Dialog: 0,0:20:32.39,0:20:33.63, Lalai,zi,0,0,0,,Hanya satu sudu.
Dialog: 0,0:20:38.54,0:20:39.74, Lalai,zi,0,0,0,,Wain pear saya.
Dialog: 0,0:20:43.07,0:20:45.34, Lalai,zi,0,0,0,,Chef Diraja!
Dialog: 0,0:20:51.45,0:20:52.46, Lalai,zi,0,0,0,,Di manakah wain pear?
Dialog: 0,0:20:53.29,0:20:55.76,Lalai,zi,0,0,0,,Ia rosak, saya buang.
Dialog: 0,0:21:16.10,0:21:17.40,Lalai,zi,0,0,0,,Seseorang berada dalam mood yang hebat.
Dialog: 0,0:21:17.78,0:21:20.14,Lalai,zi,0,0,0,,Saya masih sama seperti selalu.
Dialog: 0,0:21:26.38,0:21:28.11,Lalai,zi,0,0,0,,Mereka berkata bahawa mereka berhenti tersenyum lama dahulu.
Dialog: 0,0:21:28.29,0:21:29.69,Lalai,zi,0,0,0,,Dan saya dapati senyuman itu semula.
Dialog: 0,0:21:32.39,0:21:35.39,Lalai,zi,0,0,0,,Saya kehilangan wain saya,\Nanti awak jumpa senyuman saya.
Dialog: 0,0:21:38.32,0:21:39.97,Lalai,zi,0,0,0,,Sungguh kebetulan.
Dialog: 0,0:21:44.71,0:21:46.07,Lalai,zi,0,0,0,,Beritahu perkara sebenar.
Dialog: 0,0:21:46.51,0:21:47.78,Lalai,zi,0,0,0,,Anda sedang berseronok, bukan?
Dialog: 0,0:21:48.13,0:21:51.87,Lalai,zi,0,0,0,,Balaslah penderitaan anda,\Sebaik sahaja peluang itu muncul.
Dialog: 0,0:21:52.54,0:21:55.68,Lalai,zi,0,0,0,,Anda tidak boleh menggoncang saya, Yang Mulia.
Dialog: 0,0:21:55.81,0:22:00.22,Lalai,zi,0,0,0,,Biar dia muntah. Ludahkan wain saya!
Dialog: 0,0:22:00.22,0:22:01.58,Lalai,zi,0,0,0,,Tuanku, diam!
Dialog: 0,0:22:01.92,0:22:03.53,Lalai,zi,0,0,0,,Lebih baik membincangkan segala-galanya, Yang Mulia.
Dialog: 0,0:22:03.62,0:22:05.12,Lalai,zi,0,0,0,,Bincang, ya sekarang!
Dialog: 0,0:22:07.96,0:22:09.82, Lalai,zi,0,0,0,,Wain pear saya.
Dialog: 0,0:22:10.77,0:22:14.04,Lalai,zi,0,0,0,,Mereka minum semua wain.
Dialog: 0,0:22:14.29,0:22:17.24,Lalai,zi,0,0,0,,-My Vintso!\N-Yang Mulia!
Dialog: 0,0:22:20.74,0:22:22.98,Lalai,zi,0,0,0,,Beri saya wain!
Dialog: 0,0:22:25.04,0:22:28.04,Lalai,zi,0,0,0,,-Yang Mulia.\N-Wain saya!
Dialog: 0,0:22:28.04,0:22:31.04,Lalai,zi,0,0,0,,Mengapa Tuanku menangis?
Dialog: 0,0:22:41.76,0:22:43.27,Lalai,zi,0,0,0,,Saya sedang menunggu awak.
Dialog: 0,0:22:43.27,0:22:46.44,Lalai,zi,0,0,0,,Dan anda hebat, seperti putera raja di atas kuda putih.
Dialog: 0,0:22:46.59,0:22:49.71,Lalai,zi,0,0,0,,Semuanya dilarang untuk saya, dan anda menunggang kuda dan berseronok.
Dialog: 0,0:22:49.71,0:22:51.90,Lalai,zi,0,0,0,,Anda sangat kecewa hari ini, seperti biasa.
Dialog: 0,0:22:52.48,0:22:53.60,Lalai,zi,0,0,0,,Sungguh lega.
Dialog: 0,0:22:59.54,0:23:00.81,Lalai,zi,0,0,0,,Mari kita menaiki kereta bersama-sama.
Dialog: 0,0:23:02.18,0:23:04.11,Lalai,zi,0,0,0,,Ini tidak mungkin, Yang Mulia.
Dialog: 0,0:23:04.95,0:23:06.96,Lalai,zi,0,0,0,,Baginda sedang mengandung anak diraja.
Dialog: 0,0:23:07.29,0:23:10.58,Lalai,zi,0,0,0,,Anda tidak boleh menunggang dengannya, Yang Mulia.
Dialog: 0,0:23:16.70,0:23:17.97,Lalai,zi,0,0,0,,Yang Mulia!
Dialog: 0,0:23:20.04,0:23:23.06,Lalai,zi,0,0,0,,Yang Mulia, ini berbahaya!
Dialog: 0,0:23:23.21,0:23:25.87,Lalai,zi,0,0,0,,-Yang Mulia!\N-Anda tidak boleh!
Dialog: 0,0:23:26.87,0:23:27.94,Lalai,zi,0,0,0,,Oh, tidak!
Dialog: 0,0:23:46.15,0:23:47.35,Lalai,zi,0,0,0,,Di mana kita?
Dialog: 0,0:23:48.50,0:23:50.29,Lalai,zi,0,0,0,,Saya sentiasa mahu memberi anda sesuatu
Dialog: 0,0:23:50.29,0:23:52.47,Lalai,zi,0,0,0,,apa yang paling anda suka dan inginkan.
Dialog: 0,0:23:53.00,0:23:55.54,Lalai,zi,0,0,0,,Apa yang tidak boleh didapati di istana, hanya di luar.
Dialog: 0,0:23:55.54,0:23:58.24,Lalai,zi,0,0,0,,-Hiburan?\N-Saya bercakap tentang kebebasan.
Dialog: 0,0:24:02.28,0:24:03.37, Lalai,zi,0,0,0,,Tidak suka, atau apa?
Dialog: 0,0:24:06.54,0:24:09.75,Lalai,zi,0,0,0,,Jadi saya akan katakan, hanya berjalan-jalan. \NMengapa begitu hebat?
Dialog: 0,0:24:10.29,0:24:13.22,Lalai,zi,0,0,0,,Kami datang ke estet diraja untuk menghirup udara segar.
Dialog: 0,0:24:14.08,0:24:15.58,Lalai,zi,0,0,0,,Mari kita kembali jika anda tidak menyukainya.
Dialog: 0,0:24:18.19,0:24:20.53,Lalai,zi,0,0,0,,Estet diraja adalah seperti rumah musim panas, bukan?
Dialog: 0,0:24:22.12,0:24:24.56,Lalai,zi,0,0,0,,Bagus. Macam orang kaya tu main-main dengan aku.
Dialog: 0,0:24:25.23,0:24:27.17,Lalai,zi,0,0,0,,Memandangkan kita berada di sini, mari kita lihat sekeliling.
Dialog: 0,0:24:27.83,0:24:30.56,Lalai,zi,0,0,0,,Saya tahu awak akan menyukainya, permaisuri saya.
Dialog: 0,0:24:30.56,0:24:32.44, Lalai,zi,0,0,0,,Di sini.
Dialog: 0,0:24:34.18,0:24:36.01,Lalai,zi,0,0,0,,Sungguh hebat menjadi seorang raja.
Dialog: 0,0:24:36.07,0:24:39.64,Lalai,zi,0,0,0,,Dan ladang mewah dan taman.
Dialog: 0,0:24:39.92,0:24:43.45,Lalai,zi,0,0,0,,Saya tertanya-tanya sepanjang malam kenapa awak marah sangat.
Dialog: 0,0:24:43.84,0:24:46.72,Lalai,zi,0,0,0,,Biasanya bagi wanita istana\N kehamilan adalah satu rahmat.
Dialog: 0,0:24:46.72,0:24:50.08,Lalai,zi,0,0,0,,Tetapi kenapa permaisuri sangat kecewa?
Dialog: 0,0:24:50.76,0:24:53.50,Lalai,zi,0,0,0,,Dan? Adakah anda tahu mengapa?
Dialog: 0,0:24:53.89,0:24:57.50,Lalai,zi,0,0,0,,No. Tidak kira berapa banyak yang saya fikirkan, saya masih tidak faham.
Dialog: 0,0:24:58.47,0:25:02.06,Lalai,zi,0,0,0,,Saya tidak faham, jadi saya memutuskan untuk menerima.
Dialog: 0,0:25:03.36,0:25:07.60,Lalai,zi,0,0,0,,Nikmat untuk orang lain mungkin bukan untuk anda.
Dialog: 0,0:25:07.98,0:25:11.87,Lalai,zi,0,0,0,,Anda adalah orang yang sedemikian.
Dialog: 0,0:25:14.31,0:25:16.61,Lalai,zi,0,0,0,,Nampaknya kamus ratu sangat berguna.
Dialog: 0,0:25:36.13,0:25:38.56,Lalai,zi,0,0,0,,Mengapa anda melakukan ini? Memang janggal.
Dialog: 0,0:25:42.90,0:25:44.07, Lalai,zi,0,0,0,,Permaisuri saya.
Dialog: 0,0:25:53.49,0:25:54.96,Lalai,zi,0,0,0,,Adakah itu "rrr"?
Dialog: 0,0:25:57.53,0:25:58.73, Lalai,zi,0,0,0,,Rrrrr!
Dialog: 0,0:26:05.32,0:26:08.63,Lalai,zi,0,0,0,,Memandangkan saya sedang menulis kamus ratu,\NI berminat dengan sesuatu.
Dialog: 0,0:26:09.83,0:26:11.60,Lalai,zi,0,0,0,,Apakah maksud “semua masuk”?
Dialog: 0,0:26:12.33,0:26:13.78,Lalai,zi,0,0,0,,Adakah saya berkata demikian?
Dialog: 0,0:26:13.78,0:26:16.40,Lalai,zi,0,0,0,,Ini adalah perkataan yang anda laungkan semasa berjudi di pasaran.
Dialog: 0,0:26:19.72,0:26:20.95,Lalai,zi,0,0,0,,All-in -
Dialog: 0,0:26:21.04,0:26:24.45,Lalai,zi,0,0,0,,tindakan yang sangat bodoh apabila anda semua
Dialog: 0,0:26:24.88,0:26:27.11,Lalai,zi,0,0,0,,anda masukkan telur rapuh dalam satu bakul.
Dialog: 0,0:26:27.81,0:26:31.43,Lalai,zi,0,0,0,,-Telur?\N-Saya melakukan perkara bodoh ini.
Dialog: 0,0:26:33.00,0:26:35.50,Lalai,zi,0,0,0,,Sial, pada masa anda perlu berlari,
Dialog: 0,0:26:35.65,0:26:37.77,Lalai,zi,0,0,0,,Saya tersandung batu kehamilan dan jatuh.
Dialog: 0,0:26:38.89,0:26:40.50,Lalai,zi,0,0,0,,Jangan risau, permaisuriku.
Dialog: 0,0:26:41.54,0:26:46.07,Lalai,zi,0,0,0,,Saya pasti akan menyingkirkan semua kebusukan Joseon.
Dialog: 0,0:26:47.48,0:26:49.18,Lalai,zi,0,0,0,,Untuk bayi kita,
Dialog: 0,0:26:50.37,0:26:52.54,Lalai,zi,0,0,0,,siapa yang akan mewarisi negara.
Dialog: 0,0:26:54.95,0:26:56.08, Lalai,zi,0,0,0,,Okey.
Dialog: 0,0:26:57.72,0:27:00.85,Lalai,zi,0,0,0,,Jika anak ini menjadi raja\N dan mewarisi negara...
Dialog: 0,0:27:02.08,0:27:05.38,Lalai,zi,0,0,0,,Bolehkah saya mendapat kuasa mutlak?
Dialog: 0,0:27:07.96,0:27:09.67,Lalai,zi,0,0,0,,Sungwon World
Dialog: 0,0:27:09.67,0:27:13.00,Lalai,zi,0,0,0,,Soyeon's World
Dialog: 0,0:27:13.63,0:27:15.63,Lalai,zi,0,0,0,,Mengapa saya tidak memikirkan perkara ini sebelum ini?
Dialog: 0,0:27:17.17,0:27:18.44,Lalai,zi,0,0,0,,-Apa yang awak cakapkan?\N-Sayang!
Dialog: 0,0:27:18.44,0:27:19.63, Lalai,zi,0,0,0,,Lihat!
Dialog: 0,0:27:19.87,0:27:23.95,Lalai,zi,0,0,0,,Semuanya di bawah langit ini -
Dialog: 0,0:27:25.64,0:27:26.87,Lalai,zi,0,0,0,,semua milik anda.
Dialog: 0,0:27:28.98,0:27:29.99,Lalai,zi,0,0,0,,Jom balik.
Dialog: 0,0:27:29.99,0:27:32.34,Lalai,zi,0,0,0,,Sekarang saya akan memulakan latihan pranatal yang sebenar.
Dialog: 0,0:27:32.79,0:27:33.99,Lalai,zi,0,0,0,,Hadir?
Dialog: 0,0:27:33.99,0:27:35.99,Lalai,zi,0,0,0,,Saya perlu mengajarnya cara untuk menang dalam pertempuran.
Dialog: 0,0:27:36.79,0:27:39.76,Lalai,zi,0,0,0,,Bayi ini perlu tinggal di istana yang bermusuhan.
Dialog: 0,0:27:40.53,0:27:41.65,Lalai,zi,0,0,0,,Jom, mari kita mulakan.
Dialog: 0,0:27:41.65,0:27:43.73,Lalai,zi,0,0,0,,Kami baru tiba.
Dialog: 0,0:27:45.56,0:27:47.77,Lalai,zi,0,0,0,,Walaupun saya menulis 100 jilid kamus,
Dialog: 0,0:27:49.13,0:27:51.56,Lalai,zi,0,0,0,,adakah harinya saya boleh memahami dia?
Dialog: 0,0:27:51.56,0:27:54.78, Lalai,zi,0,0,0,,-Tunggu! Tunggu saya.\N-Cepat!
Dialog: 0,0:27:59.02,0:28:00.52,Lalai,peringkat 3,0,0,0,,Diari Kehamilan
Dialog: 0,0:28:16.31,0:28:17.37,Lalai,peringkat 3,0,0,0,,Bayi,
Dialog: 0,0:28:18.67,0:28:20.48, Lalai, peringkat 3,0,0,0,,untuk bertahan di istana,
Dialog: 0,0:28:20.48,0:28:23.18, Lalai, peringkat 3,0,0,0,, anda mesti mengumpulkan orang yang boleh dipercayai di sekeliling anda.
Dialog: 0,0:28:28.78,0:28:30.12,Lalai,peringkat 3,0,0,0,,Yang Mulia!
Dialog: 0,0:28:31.52,0:28:34.02, Lalai, peringkat 3,0,0,0,, Mereka benar-benar pahlawan terbaik di Joseon.
Dialog: 0,0:28:34.39,0:28:35.42,Lalai,peringkat 3,0,0,0,,Bayi,
Dialog: 0,0:28:35.52,0:28:38.63, Lalai, peringkat 3,0,0,0,, anda mesti memastikan musuh anda rapat.
Dialog: 0,0:28:39.19,0:28:40.76, Lalai, peringkat 3,0,0,0,, Katakanlah, seribu pahlawan.
Dialog: 0,0:28:41.96,0:28:43.43, Lalai, peringkat 3,0,0,0,,Dengan kuasa ketenteraan sedemikian
Dialog: 0,0:28:44.07,0:28:46.67, Lalai, julat penangkapan 3,0,0,0,, adakah anda akan menawan Dewan Seongjongjong atau apa?
Dialog: 0,0:28:47.00,0:28:48.47,Lalai,peringkat 3,0,0,0,,Adakah anda takut?
Dialog: 0,0:28:50.74,0:28:52.98, Lalai, peringkat 3,0,0,0,,Saya rasa anda seorang sahaja yang takut di sini,
Dialog: 0,0:28:52.98,0:28:55.08,Lalai,peringkat 3,0,0,0,,kali mereka menyediakan seribu pahlawan untuk saya.
Dialog: 0,0:28:55.58,0:28:57.41, Lalai, peringkat 3,0,0,0,, Pusingkan bilangan pahlawan.
Dialog: 0,0:28:57.41,0:28:59.41, Lalai, peringkat 3,0,0,0,,Selebihnya berada dalam pengawal diraja.
Dialog: 0,0:29:00.05,0:29:03.69, Lalai, peringkat 3,0,0,0,, Sayang, anda mesti mempunyai perbendaharaan rahsia anda sendiri.
Dialog: 0,0:29:05.39,0:29:07.52, Lalai, peringkat 3,0,0,0,, Syiling ini baru sahaja ditempa.
Dialog: 0,0:29:07.52,0:29:09.89, Lalai, peringkat 3,0,0,0,,-Berapa jumlah yang ada?\N-Juta.
Dialog: 0,0:29:12.23,0:29:14.73,Lalai,peringkat 3,0,0,0,,Adakah ini pelaburan anda dalam politik?
Dialog: 0,0:29:15.56,0:29:17.37,Lalai,peringkat 3,0,0,0,,Dia yang mempunyai wang mempunyai kuasa.
Dialog: 0,0:29:18.70,0:29:22.04,Lalai,peringkat 3,0,0,0,,Dan akhirnya, sayang, pelajaran yang paling penting.
Dialog: 0,0:29:22.70,0:29:25.81, Lalai, peringkat 3,0,0,0,,Singkirkan semua orang yang tidak menyebelahi anda.
Dialog: 0,0:29:26.21,0:29:28.41, Lalai, peringkat 3,0,0,0,,Hidup adalah permainan, dan dunia adalah hutan.
Dialog: 0,0:29:28.41,0:29:31.68,Lalai,peringkat 3,0,0,0,,Anda akan dimakan jika anda tidak makan yang lain dahulu. Ini parti pembunuh!
Dialog: 0,0:29:32.31,0:29:34.25,Lalai,peringkat 3,0,0,0,,Sudah tentu, anda akan cuba mewujudkan keamanan.
Dialog: 0,0:29:34.78,0:29:36.69,Lalai,peringkat 3,0,0,0,,Tetapi jika tiada harapan,
Dialog: 0,0:29:36.69,0:29:39.62, Lalai, peringkat 3,0,0,0,, anda mesti menang walau apa pun, sayang.
Dialog: 0,0:29:43.03,0:29:45.73,Lalai,peringkat 3,0,0,0,,Saya sangat gembira kerana Yang Mulia
Dialog: 0,0:29:45.86,0:29:47.76, Lalai, peringkat 3,0,0,0,, mengatasi keterujaan saya.
Dialog: 0,0:29:47.96,0:29:50.97, Lalai, peringkat 3,0,0,0,,Dia belum lahir lagi, dan anda sudah mahu memberitahunya banyak perkara?
Dialog: 0,0:29:51.77,0:29:53.67,Lalai,peringkat 3,0,0,0,,Dia akan mendengar sambil duduk di dalam perutnya.
Dialog: 0,0:29:53.94,0:29:56.27,Lalai,peringkat 3,0,0,0,,Dan ia akan berhenti sebaik sahaja ia dilahirkan.
Dialog: 0,0:29:57.81,0:30:01.11,Lalai,peringkat 3,0,0,0,,Sudah tiba masanya untuk anda tidur.
Dialog: 0,0:30:01.61,0:30:04.85, Lalai, peringkat 3,0,0,0,,Saya tidak mempunyai masa untuk tidur: banyak yang perlu dilakukan.
Dialog: 0,0:30:05.71,0:30:07.42,Lalai,peringkat 3,0,0,0,,Hidup seperti treadmill,
Dialog: 0,0:30:07.42,0:30:10.49, Lalai, peringkat 3,0,0,0,, anda hanya perlu berhenti seketika dan anda akan jatuh serta-merta.
Dialog: 0,0:30:11.92,0:30:13.82, Lalai, peringkat 3,0,0,0,, Malah kehamilan tidak akan menghalang saya.
Dialog: 0,0:30:15.82,0:30:17.39, Lalai, peringkat 3,0,0,0,,Atau ia akan berhenti.
Dialog: 0,0:30:19.60,0:30:23.17, Lalai, peringkat 3,0,0,0,,Dalam jiwa saya, saya mempunyai motor, tetapi sebenarnya saya mempunyai pedal.
Dialog: 0,0:30:38.01,0:30:39.05, Lalai, peringkat 3,0,0,0,,Lama tidak berjumpa.
Dialog: 0,0:30:39.48,0:30:40.72,Lalai,peringkat 3,0,0,0,,Ia pasti sukar untuk anda.
Dialog: 0,0:30:41.68,0:30:42.68, Lalai, peringkat 3,0,0,0,,Semuanya baik-baik saja.
Dialog: 0,0:30:51.56,0:30:52.90,Lalai,peringkat 3,0,0,0,,Anda telah melengkapkan tutorial taktik.
Dialog: 0,0:30:53.00,0:30:55.23, Lalai, peringkat 3,0,0,0,,Orang-orang ini tidak pernah memegang senjata,
Dialog: 0,0:30:55.50,0:30:57.47, Lalai, peringkat 3,0,0,0,, jadi sukar untuk dilatih.
Dialog: 0,0:30:58.20,0:30:59.33, Lalai, peringkat 3,0,0,0,,Tetapi tutorial akan membantu.
Dialog: 0,0:31:03.17,0:31:04.21, Lalai, peringkat 3,0,0,0,, Berhati-hati.
Dialog: 0,0:31:15.65,0:31:17.42,Lalai,peringkat 3,0,0,0,,Saya tidak tahu
Dialog: 0,0:31:18.39,0:31:19.89, Lalai, peringkat 3,0,0,0,, bahawa bilangan pengikut telah berkembang dengan begitu banyak.
Dialog: 0,0:31:20.66,0:31:23.03, Lalai, peringkat 3,0,0,0,,Dalam erti kata lain, ramai orang
Dialog: 0,0:31:23.03,0:31:24.96, Lalai, peringkat 3,0,0,0,, mendapati diri kita berada dalam situasi yang sukar.
Dialog: 0,0:31:25.49,0:31:28.80,Lalai,peringkat 3,0,0,0,,Kebelakangan ini mereka telah menarik pelbagai kelas:
Dialog: 0,0:31:29.23,0:31:31.07, Lalai, peringkat 3,0,0,0,, daripada bangsawan yang hancur kepada pembajak.
Dialog: 0,0:31:31.40,0:31:33.20,Lalai,peringkat 3,0,0,0,,Mungkin, seperti yang diperkatakan oleh ratu,
Dialog: 0,0:31:34.84,0:31:36.81, Lalai, peringkat 3,0,0,0,, adakah penyelesaian kami untuk memansuhkan pembahagian kelas?
Dialog: 0,0:31:37.37,0:31:39.37,Lalai,peringkat 3,0,0,0,,Kita mesti berhati-hati
Dialog: 0,0:31:40.21,0:31:41.64, Lalai, peringkat 3,0,0,0,,perubahan asas.
Dialog: 0,0:31:42.95,0:31:44.71,Lalai,peringkat 3,0,0,0,,Sudah tentu, ini masih jauh.
Dialog: 0,0:31:45.65,0:31:47.62, Lalai, peringkat 3,0,0,0,,Saya mungkin tidak akan dapat melakukan ini, tetapi,
Dialog: 0,0:31:49.32,0:31:51.65, Lalai, peringkat 3,0,0,0,,mungkin anak saya boleh.
Dialog: 0,0:31:59.96,0:32:02.56,Lalai,peringkat 3,0,0,0,,Yang Mulia...
Dialog: 0,0:32:03.87,0:32:05.10, Lalai, peringkat 3,0,0,0,, Jangan kejutkan dia.
Dialog: 0,0:32:14.44,0:32:16.35,Lalai,peringkat 3,0,0,0,,Dia seperti kanak-kanak.
Dialog: 0,0:32:25.15,0:32:28.26,Lalai,peringkat 3,0,0,0,,Log kehamilan
Dialog: 0,0:32:28.29,0:32:30.43, Lalai, peringkat 3,0,0,0,, Anda mesti memastikan musuh anda rapat.
Dialog: 0,0:32:33.86,0:32:36.30, Lalai, peringkat 3,0,0,0,, Sayang, anda mesti mempunyai perbendaharaan rahsia anda sendiri.
Dialog: 0,0:32:41.04,0:32:42.54,Lalai,peringkat 3,0,0,0,,Hidup adalah permainan, dan dunia adalah hutan.
Dialog: 0,0:32:42.54,0:32:44.57,Lalai,peringkat 3,0,0,0,,Anda akan dimakan jika anda tidak makan yang lain dahulu. Ini parti pembunuh!
Dialog: 0,0:32:45.24,0:32:46.27, Lalai, peringkat 3,0,0,0,,"Parti"?
Dialog: 0,0:32:47.68,0:32:48.68,Lalai,peringkat 3,0,0,0,,Malam...
Dialog: 0,0:32:51.35,0:32:53.45, Lalai, peringkat 3,0,0,0,,Saya tidak faham maksud "Inka".
Dialog: 0,0:32:54.05,0:32:55.35, Lalai, peringkat 3,0,0,0,, Parti.
Dialog: 0,0:33:00.26,0:33:03.13, Lalai, peringkat 3,0,0,0,,Memandangkan semuanya baik-baik saja dengan permaisuri, anda tidak cedera.
Dialog: 0,0:33:03.53,0:33:07.13, Lalai, peringkat 3,0,0,0,,Saya tahu: azimat yang saya berikan berfungsi sebagaimana mestinya.
Dialog: 0,0:33:07.50,0:33:09.70,Lalai,peringkat 3,0,0,0,,Terima kasih, Yang Mulia.
Dialog: 0,0:33:09.70,0:33:10.73,Lalai,peringkat 3,0,0,0,,Saya rasa
Dialog: 0,0:33:11.40,0:33:14.40, Lalai, peringkat 3,0,0,0,, adakah anda menyebarkan khabar angin seperti yang saya beritahu anda?
Dialog: 0,0:33:15.44,0:33:16.51,Lalai,peringkat 3,0,0,0,,Tidak boleh.
Dialog: 0,0:33:17.44,0:33:19.37,Lalai,peringkat 3,0,0,0,,Awak bergosip sejak pagi.
Dialog: 0,0:33:20.08,0:33:21.91, Lalai, peringkat 3,0,0,0,,Adakah anda sekurang-kurangnya pergi mencuci muka?
Dialog: 0,0:33:21.91,0:33:25.08,Lalai,peringkat 3,0,0,0,,Anda sepatutnya mendengar ini. Saya pasti anda akan tertidur dengan segera.
Dialog: 0,0:33:27.02,0:33:28.78,Lalai,menembak 3,0,0,0,,Anda tahu, ratu...
Dialog: 0,0:33:33.12,0:33:34.19,Lalai,peringkat 3,0,0,0,,Seperti ini.
Dialog: 0,0:33:34.19,0:33:37.93,Lalai,peringkat 3,0,0,0,,Apa? Adakah Baginda dan Permaisuri berpura-pura tidur bersama?
Dialog: 0,0:33:38.16,0:33:42.46,Lalai,peringkat 3,0,0,0,,Baginda dan Permaisuri berpura-pura tidur bersama.
Dialog: 0,0:33:49.97,0:33:52.34, Lalai, peringkat 3,0,0,0,,Saya dengar mereka sebenarnya tidak tidur bersama.
Dialog: 0,0:33:52.34,0:33:54.31, Lalai, peringkat 3,0,0,0,,Mereka baru sahaja bermalam di bilik yang sama.
Dialog: 0,0:33:56.58,0:34:00.32,Lalai,peringkat 3,0,0,0,,Apa? Lalu siapa anaknya?
Dialog: 0,0:34:01.18,0:34:03.22,Lalai,peringkat 3,0,0,0,,Siapa anaknya sejak itu?
Dialog: 0,0:34:03.22,0:34:05.45, Lalai, peringkat 3,0,0,0,,-Tidak boleh.\N-Saya dengar mereka berpura-pura.
Dialog: 0,0:34:20.30,0:34:23.64, Lalai, peringkat 3,0,0,0,,Anda pasti pernah mendengar khabar angin yang tersebar di sekitar istana.
Dialog: 0,0:34:23.64,0:34:26.01, Lalai, peringkat 3,0,0,0,, Khabar angin sentiasa selangkah di belakang kebenaran.
Dialog: 0,0:34:26.31,0:34:28.11,Lalai,peringkat 3,0,0,0,,Ini cerita lama.
Dialog: 0,0:34:28.11,0:34:31.51,Lalai,peringkat 3,0,0,0,,Khabar angin di istana\N tidak boleh dipandang ringan.
Dialog: 0,0:34:31.51,0:34:34.72,Lalai,peringkat 3,0,0,0,,Mereka boleh menggunakannya untuk menjatuhkan anda.
Dialog: 0,0:34:34.72,0:34:36.62, Lalai, peringkat 3,0,0,0,, Tepat sekali, matlamat mereka ialah pemendapan saya.
Dialog: 0,0:34:36.95,0:34:38.72,Lalai,peringkat 3,0,0,0,,Mereka bermain kotor dan remeh.
Dialog: 0,0:34:38.72,0:34:40.46,Lalai,peringkat 3,0,0,0,,Saya tidak akan biarkan mereka membuang saya.
Dialog: 0,0:34:40.99,0:34:42.32,Lalai,peringkat 3,0,0,0,,-Ya.\N- Hong Young.
Dialog: 0,0:34:47.26,0:34:48.46, Lalai, peringkat 3,0,0,0,,Mengapa anda memerlukan sepit rambut?
Dialog: 0,0:35:12.75,0:35:15.39,Lalai,peringkat 3,0,0,0,,Posisi menentang jenis apakah ini?
Dialog: 0,0:35:15.39,0:35:16.99,Lalai,peringkat 3,0,0,0,,Kita perlu menyangkal khabar angin itu.
Dialog: 0,0:35:17.49,0:35:19.69, Lalai, penangkapan 3,0,0,0,,-Lihat sahaja.\N-Tepat di hadapan orang ramai.
Dialog: 0,0:35:19.69,0:35:21.23, Lalai, penangkapan 3,0,0,0,,-Sungguh janggal.\N-Saya tidak boleh menonton.
Dialog: 0,0:35:24.43,0:35:25.53, Lalai, peringkat 3,0,0,0,,Dalam kes itu.
Dialog: 0,0:35:28.67,0:35:30.67, Lalai, peringkat 3,0,0,0,,Ini tidak mencukupi untuk memadamkan khabar angin.
Dialog: 0,0:35:31.81,0:35:33.18, Lalai, peringkat 3,0,0,0,, Mari cuba.
Dialog: 0,0:35:33.18,0:35:35.08, Lalai, peringkat 3,0,0,0,,Bukankah terlalu banyak?
Dialog: 0,0:35:35.94,0:35:37.45, Lalai, peringkat 3,0,0,0,,Tetapi saya belum menunjukkan semuanya lagi.
Dialog: 0,0:35:46.45,0:35:47.52,Lalai,peringkat 3,0,0,0,,Tidak mencukupi.
Dialog: 0,0:35:51.13,0:35:52.99,Lalai,peringkat 3,0,0,0,,Teruskan, teruskan.
Dialog: 0,0:35:52.99,0:35:56.90,Lalai,julat penangkapan 3,0,0,0,,Jika saya meneruskan, kita sudah memerlukan khemah.
Dialog: 0,0:35:57.83,0:35:59.37,Lalai,peringkat 3,0,0,0,,Adakah ini yang anda mahukan?
Dialog: 0,0:36:00.00,0:36:01.34, Lalai, peringkat 3,0,0,0,,Saya tidak berkata begitu.
Dialog: 0,0:36:01.34,0:36:03.14, Lalai, peringkat 3,0,0,0,, Kita perlu merangsang imaginasi mereka.
Dialog: 0,0:36:03.47,0:36:06.17,Lalai,peringkat 3,0,0,0,,Kemudian untuk tujuan yang sama
Dialog: 0,0:36:07.38,0:36:09.21,Lalai,peringkat 3,0,0,0,,Saya akan melawat Daejojeon hari ini.
Dialog: 0,0:36:18.39,0:36:20.72, Lalai, peringkat 3,0,0,0,,Saya tiada pilihan, kerana saya boleh dilucutkan jawatan.
Dialog: 0,0:36:20.72,0:36:21.72,Lalai,peringkat 3,0,0,0,,Kemudian
Dialog: 0,0:36:23.02,0:36:24.73,Lalai,peringkat 3,0,0,0,,jumpa lagi.
Dialog: 0,0:36:36.37,0:36:38.91,Lalai,peringkat 3,0,0,0,,-Hilang?\N-Ia sangat perlahan.
Dialog: 0,0:36:38.91,0:36:40.71,Lalai,peringkat 3,0,0,0,,Masih memandang kami.
Dialog: 0,0:36:40.71,0:36:42.98, Lalai, peringkat 3,0,0,0,, Kemudian anda tidak meninggalkan saya pilihan.
Dialog: 0,0:37:04.23,0:37:07.04,Lalai,peringkat 3,0,0,0,,Tuanku, gundik utama telah tiba.
Dialog: 0,0:37:14.68,0:37:16.28, Lalai, peringkat 3,0,0,0,,Adakah anda mengatur ini?
Dialog: 0,0:37:21.52,0:37:23.89,Lalai,peringkat 3,0,0,0,,-Apa yang awak cakapkan?\N-Saya bercakap tentang khabar angin.
Dialog: 0,0:37:25.52,0:37:27.79,Lalai,peringkat 3,0,0,0,,Semuanya terima kasih kepada anda.
Dialog: 0,0:37:28.76,0:37:31.99,Lalai,peringkat 3,0,0,0,,Saya teringat apa yang awak beritahu saya sebelum ini.
Dialog: 0,0:37:32.76,0:37:36.36,Lalai,peringkat 3,0,0,0,,Anda mengatakan bahawa malam mereka bersama hanya dipentaskan.
Dialog: 0,0:37:37.27,0:37:41.47,Lalai,peringkat 3,0,0,0,,Oleh itu, kehamilan permaisuri tidak akan diraikan.
Dialog: 0,0:37:41.94,0:37:43.77,Lalai,peringkat 3,0,0,0,,Perkataan anda
Dialog: 0,0:37:44.07,0:37:46.74, Lalai, peringkat 3,0,0,0,,menjadi anak panah dan terkena ratu.
Dialog: 0,0:37:46.94,0:37:48.61,Lalai,peringkat 3,0,0,0,,Sila hentikan ini.
Dialog: 0,0:37:48.61,0:37:50.88, Lalai, peringkat 3,0,0,0,,Saya tidak mengawal perkara ini.
Dialog: 0,0:37:51.11,0:37:53.85,Lalai,peringkat 3,0,0,0,,Setelah orang mula bergosip,
Dialog: 0,0:37:53.85,0:37:55.95, Lalai, peringkat 3,0,0,0,, dan mereka tidak boleh berhenti.
Dialog: 0,0:37:57.19,0:38:01.42, Lalai, peringkat 3,0,0,0,, Dan sudah terlambat untuk anda melepaskan diri daripada tanggungjawab.
Dialog: 0,0:38:03.26,0:38:08.03, Lalai, peringkat 3,0,0,0,, Semasa anda berada di sini, anda tidak boleh bebas.
Dialog: 0,0:38:09.73,0:38:13.87,Lalai,peringkat 3,0,0,0,,Kewujudan anda akan menjadi sokongan untuk reputasi keluarga kami.
Dialog: 0,0:38:14.57,0:38:17.84,Lalai,peringkat 3,0,0,0,,Lebih baik menjadi pemula daripada digunakan.
Dialog: 0,0:38:21.61,0:38:22.88, Lalai, peringkat 3,0,0,0,, Ini menakutkan.
Dialog: 0,0:38:23.91,0:38:25.08,Lalai,peringkat 3,0,0,0,,Saya faham.
Dialog: 0,0:38:27.62,0:38:31.62,Lalai,peringkat 3,0,0,0,,Tetapi anda tidak bersendirian, jadi jangan risau.
Dialog: 0,0:38:40.93,0:38:44.07,Lalai,peringkat 3,0,0,0,,Saya bertukar menjadi seseorang seperti awak -
Dialog: 0,0:38:44.83,0:38:46.03,Lalai,peringkat 3,0,0,0,,itulah yang menakutkan.
Dialog: 0,0:38:47.77,0:38:50.87,Lalai,peringkat 3,0,0,0,,Adakah anda tahu mengapa keluarga itu mengikut arahan anda?
Dialog: 0,0:38:51.51,0:38:54.11, Lalai, peringkat 3,0,0,0,, Kerana anda adalah mangsa yang tidak bersalah,
Dialog: 0,0:38:54.11,0:38:55.94,Lalai,peringkat 3,0,0,0,,mengalami kehilangan anak.
Dialog: 0,0:38:56.64,0:38:58.68,Lalai,peringkat 3,0,0,0,,Tetapi bagaimana jika anda seorang ibu yang tidak berjiwa,
Dialog: 0,0:38:58.68,0:39:00.92,Lalai,peringkat 3,0,0,0,,mengorbankan anaknya untuk terus hidup?
Dialog: 0,0:39:01.45,0:39:03.92, Lalai, peringkat 3,0,0,0,, Dan lebih-lebih lagi, bagaimana jika anda seorang wanita yang bodoh,
Dialog: 0,0:39:03.92,0:39:05.22,Lalai,peringkat 3,0,0,0,,bergantung pada bomoh
Dialog: 0,0:39:05.22,0:39:07.46, Lalai, peringkat 3,0,0,0,,mengenai masa depan seumpama kita?
Dialog: 0,0:39:08.16,0:39:10.13, Lalai, peringkat 3,0,0,0,,Adakah anda akan kekal bertanggungjawab?
Dialog: 0,0:39:11.76,0:39:14.66,Lalai,peringkat 3,0,0,0,,Saya akan menulis semua yang saya dengar dan lihat di sini,
Dialog: 0,0:39:14.66,0:39:16.66, Lalai, peringkat 3,0,0,0,, jadi semua orang di Joseon akan tahu siapa anda.
Dialog: 0,0:39:19.80,0:39:22.37,Lalai,peringkat 3,0,0,0,,Perkataan tidak mempunyai kuasa sedemikian.
Dialog: 0,0:39:22.37,0:39:25.41,Lalai,peringkat 3,0,0,0,,Anda masih akan mengetahui kekuatan mereka.
Dialog: 0,0:39:26.88,0:39:30.15,Lalai,peringkat 3,0,0,0,,Anda pernah memberitahu saya\N bahawa anda tidak mahu menyesal lagi.
Dialog: 0,0:39:30.65,0:39:32.05,Lalai,peringkat 3,0,0,0,,Anda tidak layak
Dialog: 0,0:39:32.05,0:39:34.42,Lalai,peringkat 3,0,0,0,,menyesali kematian mendiang raja.
Dialog: 0,0:39:34.78,0:39:37.02,Lalai,peringkat 3,0,0,0,,Anda sepatutnya menyesal kerana memijak mimpinya.
Dialog: 0,0:39:38.22,0:39:40.92,Lalai,peringkat 3,0,0,0,,Anda, sebagai ibunya, patut menyesal,
Dialog: 0,0:39:41.42,0:39:42.72, Lalai, peringkat 3,0,0,0,, yang memusnahkan impian anak saya.
Dialog: 0,0:39:43.32,0:39:45.63,Lalai,peringkat 3,0,0,0,,Mendiang raja mungkin benar-benar mahu
Dialog: 0,0:39:46.39,0:39:48.33,Lalai,peringkat 3,0,0,0,,keluar dari bayang-bayang anda.
Dialog: 0,0:39:48.33,0:39:49.33,Lalai,peringkat 3,0,0,0,,Apa?
Dialog: 0,0:39:51.47,0:39:53.17, Lalai, peringkat 3,0,0,0,, Anda tidak tahu apa-apa.
Dialog: 0,0:39:53.97,0:39:57.01,Lalai,peringkat 3,0,0,0,,Beraninya anda berkata begitu?
Dialog: 0,0:39:57.01,0:39:58.51, Lalai, peringkat 3,0,0,0,,Ini adalah kebenaran, diketahui semua orang.
Dialog: 0,0:39:59.67,0:40:01.78,Lalai,peringkat 3,0,0,0,,Dan saya pasti anda juga tahu perkara ini.
Dialog: 0,0:40:03.48,0:40:06.45,Lalai,peringkat 3,0,0,0,,Saya tidak akan membenarkan kamu memusnahkan impian Baginda.
Dialog: 0,0:40:10.29,0:40:11.42,Lalai,peringkat 3,0,0,0,,Gadis ini...
Dialog: 0,0:40:24.17,0:40:25.63,Lalai,Spillik4,0,0,0,,Saya akan pergi ke dewan Daejojon.
Dialog: 0,0:40:25.93,0:40:27.00,Lalai,Spilyk4,0,0,0,,Ya.
Dialog: 0,0:40:39.31,0:40:42.65,Lalai,Spikyulka4,0,0,0,,Mereka mengatakan bahawa mimpi menangkis khabar angin.
Dialog: 0,0:40:43.95,0:40:45.15,Lalai,Spilyk4,0,0,0,,Khabar angin?
Dialog: 0,0:40:45.45,0:40:47.02,Lalai,Spikyulka4,0,0,0,,Saya tidak memberitahu sesiapa,
Dialog: 0,0:40:47.02,0:40:49.99,Lalai,Spikyulka4,0,0,0,,lagipun, malam dengan raja adalah perkara intim,
Dialog: 0,0:40:51.49,0:40:54.80,Lalai,Spikyulka4,0,0,0,,tetapi jika anda mengetahuinya, anda akan sangat terkejut.
Dialog: 0,0:40:56.90,0:40:58.13,Lalai,Spillie4,0,0,0,,Di atas katil...
Dialog: 0,0:41:23.86,0:41:25.13,Lalai,Spilyk4,0,0,0,,Sesuatu seperti itu.
Dialog: 0,0:41:26.03,0:41:27.80,Lalai,Spikyulka4,0,0,0,,Anda tidak boleh memberitahu saya tentang malam yang panas.
Dialog: 0,0:41:27.80,0:41:29.60,Lalai,Spilyk4,0,0,0,,Sayang sekali.
Dialog: 0,0:41:29.80,0:41:33.80,Lalai,Spillik4,0,0,0,,Raja sama sekali tidak seperti yang dilihatnya.
Dialog: 0,0:41:34.34,0:41:37.54,Lalai,Spilyk4,0,0,0,,Ketahanannya akan tercatat dalam sejarah.
Dialog: 0,0:41:42.61,0:41:44.31,Lalai,Spikyulka4,0,0,0,,Jadi kerana saya ianya tercatat dalam buku teks?
Dialog: 0,0:41:44.91,0:41:48.78,Lalai,Spikyulka4,0,0,0,,Siapa yang menyebarkan gosip palsu itu?
Dialog: 0,0:41:48.78,0:41:52.65,Lalai,Spillik4,0,0,0,,Hanya gundik diraja Cho yang mampu melakukan ini.
Dialog: 0,0:42:01.66,0:42:02.96,Lalai,Spillik4,0,0,0,,Semuanya baik-baik saja.
Dialog: 0,0:42:07.00,0:42:09.87,Lalai,Spilyk4,0,0,0,,Apa? Sekarang kenapa awak datang untuk bergaduh?
Dialog: 0,0:42:17.35,0:42:18.81,Lalai,Spillik4,0,0,0,,Adakah anda pasti?
Dialog: 0,0:42:23.69,0:42:25.45,Lalai,Spikyulka4,0,0,0,,Kami pasti anda bersama raja
Dialog: 0,0:42:25.95,0:42:28.52,Lalai,Silk4,0,0,0,,bolehkah anda melawan mereka dan menang?
Dialog: 0,0:42:30.89,0:42:32.39,Lalai,Spilyk4,0,0,0,,Ini perjuangan saya juga.
Dialog: 0,0:42:32.89,0:42:34.93,Lalai,Spilyk4,0,0,0,,Dan saya juga perlukan kemenangan.
Dialog: 0,0:42:44.20,0:42:46.65,Lalai,Spilyk4,0,0,0,,Maka anda perlu berlatih memanah.
Dialog: 0,0:42:47.21,0:42:50.75,Lalai,Spikyulka4,0,0,0,,Dengan kemahiran semasa anda, anda hanya akan menjadi beban.
Dialog: 0,0:42:53.15,0:42:56.85,Lalai,Spillik4,0,0,0,,Kalau begitu boleh awak ajar saya?
Dialog: 0,0:42:59.45,0:43:00.52,Lalai,Spilyk4,0,0,0,,Saya ada
Dialog: 0,0:43:03.29,0:43:05.16,Lalai,Spilyk4,0,0,0,,tiada masa untuk ini.
Dialog: 0,0:43:08.90,0:43:11.43,Lalai,Spillik4,0,0,0,,Yang Mulia, gundik Cho ada di sini.
Dialog: 0,0:43:12.70,0:43:13.87,Lalai,Spillik4,0,0,0,,Biarkan dia masuk.
Dialog: 0,0:43:27.05,0:43:29.05,Lalai,Spilyk4,0,0,0,,Saya ingin meminta bantuan daripada anda.
Dialog: 0,0:43:29.35,0:43:30.35,Lalai,Spillik4,0,0,0,,Cakap.
Dialog: 0,0:43:30.35,0:43:32.02,Lalai,Spillik4,0,0,0,,Anda mesti memenuhinya.
Dialog: 0,0:43:33.62,0:43:35.49,Lalai,Spikyulka4,0,0,0,,Dan apakah jenis permintaan?
Dialog: 0,0:43:37.43,0:43:40.76,Lalai,Spillik4,0,0,0,,Biar saya tinggalkan istana.
Dialog: 0,0:43:45.07,0:43:46.43,Lalai,Spillik4,0,0,0,,Apakah maksud ini?
Dialog: 0,0:43:46.87,0:43:50.41,Lalai,Spillik4,0,0,0,,Saya tidak dapat menemui diri saya di dalam istana.
Dialog: 0,0:43:51.04,0:43:53.04,Lalai,Spikyulka4,0,0,0,,Tolong halau saya keluar dari istana,
Dialog: 0,0:43:53.61,0:43:55.64,Lalai,Spillik4,0,0,0,,supaya saya boleh menjalani kehidupan saya sendiri.
Dialog: 0,0:43:57.71,0:43:58.91,Lalai,Spikyulka4,0,0,0,,Saya tidak boleh membenarkan ini.
Dialog: 0,0:43:59.35,0:44:02.28,Lalai,Spikyulka4,0,0,0,,Anda tahu bagaimana rasanya hidup sebagai gundik diraja yang dibuang negeri.
Dialog: 0,0:44:02.28,0:44:04.52,Lalai,Spilyk4,0,0,0,,Saya tidak kisah apa yang mereka katakan tentang saya.
Dialog: 0,0:44:04.52,0:44:08.46,Lalai,Spilyk4,0,0,0,,Saya tidak akan terikat dengan ini lagi.
Dialog: 0,0:44:10.39,0:44:14.13,Lalai,Spikyulka4,0,0,0,,Ini permintaan terakhir saya,\Ntolong penuhinya.
Dialog: 0,0:44:20.70,0:44:23.07,Lalai,Spilyk4,0,0,0,,Saya tidak memberikan kebenaran saya. Saya tidak boleh memberikannya.
Dialog: 0,0:44:23.97,0:44:26.21,Lalai,Spikyulka4,0,0,0,,Kami menghargai satu sama lain,
Dialog: 0,0:44:27.24,0:44:29.48,Lalai,Spillik4,0,0,0,,tetapi tiada lagi cinta untuk kita.
Dialog: 0,0:44:30.14,0:44:31.55,Lalai,Spillik4,0,0,0,,Di dalam istana
Dialog: 0,0:44:32.41,0:44:34.08,Lalai,Spilyk4,0,0,0,,Saya dalam kurungan
Dialog: 0,0:44:35.15,0:44:37.75,Lalai,Spilyk4,0,0,0,,di bawah nama gundik diraja.
Dialog: 0,0:45:19.43,0:45:23.06,Lalai,Spillik4,0,0,0,,Yang Mulia. Semua pegawai berkumpul.
Dialog: 0,0:45:26.43,0:45:31.04,Lalai,Spillik4,0,0,0,,Sebab saya terpaksa mengumpulkan awak,
Dialog: 0,0:45:33.71,0:45:36.31,Lalai,Spikyulka4,0,0,0,,bahawa saya ada satu kenyataan penting untuk dibuat.
Dialog: 0,0:45:44.05,0:45:46.15,Lalai,Spillik4,0,0,0,,Mulai sekarang
Dialog: 0,0:45:46.89,0:45:49.89,Lalai,Spillik4,0,0,0,,Cho Hwajin, permaisuri diraja,
Dialog: 0,0:45:54.56,0:45:56.23,Lalai,Sutera4,0,0,0,,kehilangan status gundik diraja.
Dialog: 0,0:46:04.71,0:46:06.24,Lalai,Spikyulka4,0,0,0,,Kita mesti hentikan perkara ini.
Dialog: 0,0:46:07.38,0:46:11.78,Lalai,Sutera4,0,0,0,,Selir diraja bukan lagi salah seorang daripada kita.
Dialog: 0,0:46:17.29,0:46:20.79,Lalai,Spillik4,0,0,0,,Tuanku, sihatlah.
Dialog: 0,0:46:22.06,0:46:25.93,Lalai,Spillik4,0,0,0,,Saya akan berdoa untuk anda.
Dialog: 0,0:46:45.21,0:46:46.38,Lalai,Spillik4,0,0,0,,Yang Mulia.
Dialog: 0,0:46:53.42,0:46:56.49,Lalai,Spilyk4,0,0,0,,Tolong jangan panggil saya begitu lagi.
Dialog: 0,0:46:56.49,0:46:57.89,Lalai,Spikyulka4,0,0,0,,Ini adalah ralat.
Dialog: 0,0:46:59.06,0:47:00.46,Lalai,Spillik4,0,0,0,,Raja tidak sepatutnya melakukan ini kepada kamu.
Dialog: 0,0:47:00.46,0:47:02.23,Lalai,Spillik4,0,0,0,,Saya tanya dia sendiri.
Dialog: 0,0:47:04.13,0:47:06.93, Lalai, Spikyulka4,0,0,0,,-Mengapa?\N-Ini lebih baik untuk semua orang.
Dialog: 0,0:47:07.84,0:47:11.24,Lalai,Spillik4,0,0,0,,Semasa saya di istana, saya akan mengganggu raja,
Dialog: 0,0:47:11.71,0:47:13.84,Lalai,Spillik4,0,0,0,,tanpa menginginkannya.
Dialog: 0,0:47:13.84,0:47:15.78,Lalai,Spikyulka4,0,0,0,,Saya akan pastikan ini tidak berlaku.
Dialog: 0,0:47:16.51,0:47:18.15,Lalai,Silk4,0,0,0,,Masih belum terlambat untuk kembali.
Dialog: 0,0:47:18.15,0:47:19.88,Lalai,Spillik4,0,0,0,,Saya akan pergi beritahu raja...
Dialog: 0,0:47:21.85,0:47:23.99,Lalai,Spillik4,0,0,0,,Saya tidak percaya diri saya lagi.
Dialog: 0,0:47:25.09,0:47:29.29,Lalai,Spikyulka4,0,0,0,,Jika saya tinggal di sini lagi, saya akan kehilangan diri saya sepenuhnya.
Dialog: 0,0:47:30.99,0:47:34.53,Lalai,Spillik4,0,0,0,,Saya pura-pura tidak tahu
Dialog: 0,0:47:35.76,0:47:38.00,Lalai,Spillik4,0,0,0,,tentang perasaan awak terhadap saya.
Dialog: 0,0:47:41.67,0:47:44.37,Lalai,Spillik4,0,0,0,,-Yang Mulia.\N-Saya menggunakan awak untuk tujuan saya sendiri.
Dialog: 0,0:47:45.87,0:47:48.28,Lalai,Spillie4,0,0,0,,Apabila saya mendambakan seorang raja,
Dialog: 0,0:47:49.11,0:47:51.98,Lalai,Spillik4,0,0,0,,kekosongan kerana dia tidak merindui saya,
Dialog: 0,0:47:53.08,0:47:55.08,Lalai,Spikyulka4,0,0,0,,Saya mengisinya dengan anda.
Dialog: 0,0:47:55.45,0:47:56.62,Lalai,Spillik4,0,0,0,,I
Dialog: 0,0:47:59.52,0:48:01.96,Lalai,Spikyulka4,0,0,0,,dengan rela hati membenarkan anda menggunakan saya.
Dialog: 0,0:48:03.39,0:48:05.19,Lalai,Spikyulka4,0,0,0,,Hanya ini yang boleh saya lakukan
Dialog: 0,0:48:07.33,0:48:08.60,Lalai,Spilyk4,0,0,0,,untuk anda.
Dialog: 0,0:48:09.63,0:48:11.17,Lalai,Spillik4,0,0,0,,Terima kasih.
Dialog: 0,0:48:12.57,0:48:13.70,Lalai,Spikyulka4,0,0,0,,Dan
Dialog: 0,0:48:14.97,0:48:16.50,Lalai,Spillik4,0,0,0,,maaf.
Dialog: 0,0:48:17.51,0:48:19.31,Lalai,Spikyulka4,0,0,0,,Sudah tiba masanya untuk anda berhenti
Dialog: 0,0:48:19.67,0:48:23.01,Lalai,Sutera4,0,0,0,,sakiti diri anda dengan cinta kepada orang yang salah.
Dialog: 0,0:48:43.26,0:48:45.67,Lalai,Spillik4,0,0,0,,Jadi itulah yang dia maksudkan.
Dialog: 0,0:48:52.17,0:48:53.94,Lalai,Spilyk4,0,0,0,,Wanita keren.
Dialog: 0,0:48:57.31,0:48:58.91,Lalai,Spillik4,0,0,0,,Adakah Cheoljong okey?
Dialog: 0,0:49:00.78,0:49:02.58,Lalai,Spillik4,0,0,0,,Saya pasti tidak.
Dialog: 0,0:49:25.67,0:49:27.21, Lalai, Spilyk4,0,0,0,, Lawan saya.
Dialog: 0,0:49:27.48,0:49:28.78,Lalai,Spillik4,0,0,0,,Saya tiada mood.
Dialog: 0,0:49:28.94,0:49:29.98,Lalai,Spillik4,0,0,0,,Pada zaman kanak-kanak
Dialog: 0,0:49:31.21,0:49:33.41,Lalai,Silk4,0,0,0,,di Ganghwado kami sering bermain permainan yang sama.
Dialog: 0,0:49:35.88,0:49:38.59,Lalai,Spillkins4,0,0,0,,Di mana orang yang mula-mula melangkah pada bayang-bayang orang lain akan menang.
Dialog: 0,0:49:39.35,0:49:40.79,Lalai,Spilyk4,0,0,0,,Orang yang tidak mahu bermain,
Dialog: 0,0:49:42.79,0:49:44.33,Lalai,Spillik4,0,0,0,,kalah serta-merta.
Dialog: 0,0:50:09.12,0:50:10.52,Lalai,Spillik4,0,0,0,,Ingat?
Dialog: 0,0:50:11.22,0:50:14.66,Lalai,Silk4,0,0,0,,Sebagai seorang kanak-kanak, saya selalu menang.
Dialog: 0,0:50:17.93,0:50:20.86,Lalai,Spikyulka4,0,0,0,,Saya ingat, maka saya selalu menang.
Dialog: 0,0:50:24.23,0:50:28.34,Lalai,Spikyulka4,0,0,0,,Saya sepatutnya lebih tegas dengan hierarki kami lebih awal.
Dialog: 0,0:50:28.64,0:50:31.64,Lalai,Spillik4,0,0,0,,Hierarki tiada kaitan dengannya, anda tidak boleh menang.
Dialog: 0,0:50:40.61,0:50:44.69,Lalai,Spillik4,0,0,0,,Gunting Cho bimbang tentang kamu sehingga ke akhirnya.
Dialog: 0,0:50:44.85,0:50:47.22,Lalai,Spikyulka4,0,0,0,,Anda tidak faham betapa berharganya ini.
Dialog: 0,0:50:47.22,0:50:48.36, Lalai, Spilyk4,0,0,0,, Seperti yang saya faham.
Dialog: 0,0:50:49.16,0:50:50.59, Lalai, Spilyk4,0,0,0,,Itulah sebabnya saya sangat menderita.
Dialog: 0,0:51:02.20,0:51:03.57,Lalai,Spillik4,0,0,0,,Anda sepatutnya lebih menderita.
Dialog: 0,0:51:04.44,0:51:05.51,Lalai,Spilyk4,0,0,0,,Ini yang terbaik,
Dialog: 0,0:51:07.41,0:51:09.48,Lalai,Spillik4,0,0,0,,apa yang boleh anda lakukan untuknya.
Dialog: 0,0:51:17.45,0:51:20.09,Lalai,Spikyulka4,0,0,0,,Berapa lama lagi saya perlu menderita\N daripada kesunyian dan kebimbangan?
Dialog: 0,0:51:20.59,0:51:21.92,Lalai,Spillik4,0,0,0,,Berapa banyak lagi?
Dialog: 0,0:51:35.96,0:51:39.30,Lalai,Spillik4,0,0,0,,Adakah Cheoljung saya minum di suatu tempat?
Dialog: 0,0:51:39.83,0:51:42.07,Default,Silk4,0,0,0,,Lebih baik saya minum dengan dia, kalau bukan kerana mengandung.
Dialog: 0,0:51:47.11,0:51:51.18,Lalai,Spikyulka4,0,0,0,,Kehamilan bukan sahaja tentang melahirkan anak, tetapi juga tentang menjadi seorang?
Dialog: 0,0:51:52.35,0:51:54.32,Lalai,Spilyk4,0,0,0,,Kenapa mengantuk sepanjang masa?
Dialog: 0,0:52:10.03,0:52:11.47,Lalai,Spillik4,0,0,0,,Saya akan pergi ke dewan Dongmyeongjong.
Dialog: 0,0:52:13.03,0:52:14.20,Lalai,Spillik4,0,0,0,,Berhati-hatilah Tuanku.
Dialog: 0,0:52:14.77,0:52:16.40,Lalai,Spilyk4,0,0,0,,Khabar angin berbahaya,
Dialog: 0,0:52:16.40,0:52:19.07,Lalai,Spikyulka4,0,0,0,,jika mereka mengetahui bahawa dia datang daripada anda...
Dialog: 0,0:52:19.94,0:52:22.91,Lalai,Spillik4,0,0,0,,Sehingga Ratu Janda mengetahui,
Dialog: 0,0:52:23.41,0:52:25.31,Lalai,Spillik4,0,0,0,,Saya perlu memberitahunya sendiri.
Dialog: 0,0:52:26.21,0:52:28.35, Lalai, Silk4,0,0,0,,-Tetapi..\N-Jangan risau.
Dialog: 0,0:52:29.08,0:52:32.09,Lalai,Spilyk4,0,0,0,,Mereka tidak dapat membayangkan,
Dialog: 0,0:52:32.09,0:52:33.89,Lalai,Spikyulka4,0,0,0,,bahawa saya akan berkongsi khabar angin yang saya sendiri mulakan.
Dialog: 0,0:52:37.86,0:52:40.33, Lalai, Spillik4,0,0,0,, Muncul tanpa jemputan.
Dialog: 0,0:52:40.69,0:52:42.70,Lalai,Spikyulka4,0,0,0,,Saya rasa saya akan meminta bantuan sekali lagi.
Dialog: 0,0:52:42.70,0:52:45.00,Lalai,Spikyulka4,0,0,0,,Saya telah mendengar khabar angin yang menakjubkan.
Dialog: 0,0:52:45.00,0:52:48.14,Lalai,Spikyulka4,0,0,0,,Saya takut anda mungkin jatuh sakit akibat berita sebegitu.
Dialog: 0,0:52:48.54,0:52:50.84,Lalai,Spillik4,0,0,0,,Jadi saya datang serta-merta.
Dialog: 0,0:52:50.84,0:52:52.21,Lalai,Spillik4,0,0,0,,Khabar angin?
Dialog: 0,0:52:54.48,0:52:58.45,Lalai,Spilyk4,0,0,0,,Mengapa begitu banyak usaha?
Dialog: 0,0:52:58.45,0:53:02.38, Lalai, Spikyulka4,0,0,0,,Jika anda tahu apa yang kami bincangkan, anda tidak akan bercakap seperti itu.
Dialog: 0,0:53:03.32,0:53:04.75,Lalai,Spilyk4,0,0,0,,Malah ingin tahu.
Dialog: 0,0:53:05.09,0:53:08.49,Lalai,Spikyulka4,0,0,0,,Khabar angin apakah yang kamu tergesa-gesa seperti orang gila.
Dialog: 0,0:53:09.39,0:53:12.26,Lalai,Spillik4,0,0,0,,Dia terlalu baik untuk terlepas,
Dialog: 0,0:53:12.56,0:53:16.03,Lalai,Spill4,0,0,0,,bagaimana wajah anda akan berubah apabila anda mendengarnya.
Dialog: 0,0:53:18.30,0:53:20.40,Default,Spilyk4,0,0,0,,Tidak mungkin kerana khabar angin wajah saya akan berubah seperti ini,
Dialog: 0,0:53:20.40,0:53:22.87, Lalai, Spillik4,0,0,0,, berapa lama anda melihat.
Dialog: 0,0:53:25.14,0:53:29.81, Lalai, Tumpahan4,0,0,0,,Anak permaisuri bukan milik raja.
Dialog: 0,0:53:31.18,0:53:34.78,Lalai,Spikyulka4,0,0,0,,Ia daripada Kim Byungin.
Dialog: 0,0:53:36.92,0:53:40.19,Lalai,Spillik4,0,0,0,,Anda sangat mengambil berat tentang jenis anda.
Dialog: 0,0:53:40.45,0:53:44.86,Lalai,Spikyulka4,0,0,0,,Sekarang akan tercatat dalam sejarah bahawa puak Kim Andonian
Dialog: 0,0:53:44.86,0:53:47.29,Lalai,Spillik4,0,0,0,,mencemarkan darah diraja.
Dialog: 0,0:54:00.64,0:54:01.78,Lalai,Spilyk4,0,0,0,,Menarik.
Dialog: 0,0:54:02.88,0:54:05.05,Lalai,Spillik4,0,0,0,,Sekarang semuanya menjadi lebih menarik.
Dialog: 0,0:54:14.99,0:54:16.79,Lalai,Spikyulka4,0,0,0,,Pernahkah anda mendengar apa yang mereka bincangkan?
Dialog: 0,0:54:17.16,0:54:19.29,Lalai,Spikyulka4,0,0,0,,Ya, saya dengar. Tidak berasas.
Dialog: 0,0:54:19.66,0:54:22.50,Lalai,Spill4,0,0,0,,Raja dan permaisuri tidur bersama
Dialog: 0,0:54:23.20,0:54:26.97,Lalai,Spilyk4,0,0,0,,seperti yang dijangkakan. \NMengapa anda mula bercakap tentang perkara ini lewat?
Dialog: 0,0:54:26.97,0:54:28.34,Lalai,Spilyk4,0,0,0,,Bukan itu yang saya bincangkan sama sekali.
Dialog: 0,0:54:28.60,0:54:30.90,Lalai,Spillik4,0,0,0,,Mereka kata anak itu bukan milik raja.
Dialog: 0,0:54:31.24,0:54:32.67,Lalai,Spikyulka4,0,0,0,,Diam, anda akan membawa masalah pada diri anda sendiri.
Dialog: 0,0:54:43.28,0:54:45.92,Lalai,Silk4,0,0,0,,Seluruh halaman mentertawakan puak kami.
Dialog: 0,0:54:46.69,0:54:50.32,Lalai,Spilyk4,0,0,0,,Hubungan antara permaisuri dan menteri perang, saudara terdekat?
Dialog: 0,0:54:51.09,0:54:53.33,Lalai,Spikyulka4,0,0,0,,Saya menaruh harapan yang tinggi untuknya.
Dialog: 0,0:54:54.19,0:54:55.63,Lalai,Spillik4,0,0,0,,Sungguh memalukan.
Dialog: 0,0:54:57.13,0:54:58.70,Lalai,Spiky4,0,0,0,,Selepas pemendapan Gundik Cho,
Dialog: 0,0:54:58.70,0:55:00.93, Lalai, Spikyulka4,0,0,0,, menyangka saya sudah selesai.
Dialog: 0,0:55:00.93,0:55:04.40,Lalai,Spikyulka4,0,0,0,,Tetapi selepas khabar angin tentang permaisuri,\NI rasa seperti saya menang.
Dialog: 0,0:55:07.27,0:55:10.91,Lalai,Spikyulka4,0,0,0,,Anak itu bukan berdarah raja, tetapi seorang yang cukup makan.
Dialog: 0,0:55:31.53,0:55:34.57,Lalai,Spillik4,0,0,0,,Keluarga saya lebih penting daripada nyawa saya.
Dialog: 0,0:55:35.74,0:55:38.11,Lalai,Spilyk4,0,0,0,,Itulah sebabnya saya hidup untuk keluarga saya.
Dialog: 0,0:55:39.44,0:55:41.44,Lalai,Spillik4,0,0,0,,Untuk apa anda hidup?
Dialog: 0,0:55:41.81,0:55:44.24,Lalai,Spillik4,0,0,0,,Atas sebab yang sama seperti Tuanku.
Dialog: 0,0:55:46.05,0:55:47.08,Lalai,Spillik4,0,0,0,,Adakah begitu?
Dialog: 0,0:55:48.48,0:55:51.39,Lalai,Spilyk4,0,0,0,,Jika ya, adakah anda bersedia untuk melakukan apa sahaja demi keluarga anda?
Dialog: 0,0:55:52.35,0:55:53.39,Lalai,Spilyk4,0,0,0,,Ya.
Dialog: 0,0:55:54.35,0:55:57.49,Lalai,Spillik4,0,0,0,,Kemudian bawa saya kepala permaisuri dahulu.
Dialog: 0,0:55:58.39,0:55:59.89, Lalai,,0,0,0,,Ini adalah pesanan.
Dialog: 0,0:56:01.40,0:56:02.90, Lalai,,0,0,0,,Apakah sebabnya?
Dialog: 0,0:56:02.90,0:56:07.60,Lalai,,0,0,0,,Ratu memusnahkan reputasi keluarga kami, yang telah kami kumpulkan selama bertahun-tahun.
Dialog: 0,0:56:10.80,0:56:11.97,Lalai,,0,0,0,,Yang Mulia.
Dialog: 0,0:56:12.41,0:56:14.74,Lalai,,0,0,0,,Saya tidak tahu apa yang membuatkan awak marah,
Dialog: 0,0:56:14.74,0:56:16.21, Lalai,,0,0,0,,tetapi harap maaf.
Dialog: 0,0:56:16.21,0:56:18.11,Lalai,,0,0,0,,Semua orang dalam istana sedang bergosip
Dialog: 0,0:56:18.11,0:56:20.85, Lalai,,0,0,0,,bahawa raja dan permaisuri tidak tidur bersama.
Dialog: 0,0:56:20.85,0:56:23.75,Lalai,,0,0,0,,Sekarang mereka mengatakan bahawa anak itu adalah milik kamu.
Dialog: 0,0:56:24.45,0:56:25.49,Lalai,,0,0,0,,Apa?
Dialog: 0,0:56:26.49,0:56:28.02, Lalai,,0,0,0,,Ini tidak benar.
Dialog: 0,0:56:28.02,0:56:30.32,Lalai,,0,0,0,,Apa yang dipercayai semua orang menjadi benar.
Dialog: 0,0:56:30.89,0:56:34.29,Lalai,,0,0,0,,Sebaik sahaja pagi tiba, orang ramai akan menyebarkan khabar angin ini
Dialog: 0,0:56:34.80,0:56:37.13, Lalai,,0,0,0,,dan permaisuri akan menjadi pendosa,
Dialog: 0,0:56:37.13,0:56:38.77,Lalai,,0,0,0,,yang mengandung oleh orang lain
Dialog: 0,0:56:38.77,0:56:41.94,Lalai,,0,0,0,,dan berbohong bahawa kanak-kanak itu adalah daripada raja, dengan itu memalukan dia.
Dialog: 0,0:56:42.97,0:56:44.54, Lalai,,0,0,0,, Khabar angin itu muncul kerana kesalahan saya.
Dialog: 0,0:56:45.01,0:56:46.47, Lalai,,0,0,0,,Saya akan terima hukuman saya.
Dialog: 0,0:56:46.91,0:56:48.31, Lalai,,0,0,0,, Khabar angin boleh membahayakan lelaki,
Dialog: 0,0:56:48.31,0:56:50.64, Lalai,,0,0,0,,tetapi dia akan membunuh seorang wanita.
Dialog: 0,0:56:51.31,0:56:53.08,Lalai,,0,0,0,,Untuk menyelamatkan maruah keluarga kita,
Dialog: 0,0:56:53.08,0:56:54.65, Lalai,,0,0,0,,memerlukan kepala permaisuri.
Dialog: 0,0:56:55.02,0:56:57.72,Lalai,,0,0,0,,Jika awak bawa saya kepalanya sendiri,
Dialog: 0,0:56:58.29,0:57:00.19, Lalai,,0,0,0,,Saya tidak akan menghukum kamu.
Dialog: 0,0:57:01.42,0:57:02.92, Lalai,,0,0,0,,Saya tidak boleh.
Dialog: 0,0:57:03.72,0:57:05.89, Lalai,,0,0,0,,Lebih baik hukum saya.
Dialog: 0,0:57:05.89,0:57:07.26,Lalai,,0,0,0,,Dia berkata bahawa anda hidup untuk keluarga anda,
Dialog: 0,0:57:07.26,0:57:09.50,Lalai,,0,0,0,,tetapi semua hanya demi permaisuri!
Dialog: 0,0:57:10.93,0:57:13.03, Lalai,,0,0,0,, Kemudian saya akan amanahkan ini kepada orang lain.
Dialog: 0,0:57:13.50,0:57:15.30,Lalai,,0,0,0,,-Ada sesiapa di luar?\N-Saya akan segera
Dialog: 0,0:57:17.37,0:57:19.71,Lalai,,0,0,0,,Saya akan pulangkan regency awak.
Dialog: 0,0:57:54.61,0:57:56.64, Lalai,,0,0,0,,Idea anda berbahaya.
Dialog: 0,0:57:57.88,0:58:00.61,Lalai,,0,0,0,,Dalam buku dengan nama permaisuri
Dialog: 0,0:58:01.85,0:58:05.05,Lalai,,0,0,0,,Saya melihat kod pengikut Tonhak yang ditulis oleh anda.
Dialog: 0,0:58:10.19,0:58:13.46, Lalai,,0,0,0,,Idea berbahaya ini telah mencemarkan anda dan permaisuri.
Dialog: 0,0:58:14.73,0:58:16.80, Lalai,,0,0,0,,Mereka mahu membina semula negara.
Dialog: 0,0:58:18.07,0:58:21.10, Lalai,,0,0,0,,Apakah yang akan berlaku jika golongan bangsawan merasakan bahaya?
Dialog: 0,0:58:21.57,0:58:23.47, Lalai,,0,0,0,,Mereka akan cuba mengekalkan segala-galanya sebagaimana adanya,
Dialog: 0,0:58:23.94,0:58:26.11, Lalai,,0,0,0,, walaupun ia bermakna mengambil nyawa orang.
Dialog: 0,0:58:28.48,0:58:31.45,Default,,0,0,0,,Pembunuhan beramai-ramai pengikut Tonhak akan bermula.
Dialog: 0,0:58:34.31,0:58:37.72,Lalai,,0,0,0,,Lalu mengapa kamu datang kepada saya dan tidak mengikuti mereka?
Dialog: 0,0:58:38.62,0:58:41.19, Lalai,,0,0,0,, Kerana ia akan membahayakan permaisuri.
Dialog: 0,0:58:46.66,0:58:48.50,Lalai,,0,0,0,,Klan Kim
Dialog: 0,0:58:51.30,0:58:53.60, Lalai,,0,0,0,,ditujukan kepada Baginda.
Dialog: 0,0:58:55.97,0:58:59.14,Lalai,,0,0,0,,Menyebarkan khabar angin bahawa anaknya adalah daripada saya,
Dialog: 0,0:58:59.64,0:59:01.88, Lalai,,0,0,0,,mereka mahu membunuhnya untuk memelihara kehormatan mereka.
Dialog: 0,0:59:03.24,0:59:05.31, Lalai,,0,0,0,,Dengan ini mereka mahu menyerang saya.
Dialog: 0,0:59:05.75,0:59:08.25, Lalai,,0,0,0,,-Saya akan menghalang mereka.\N-Anda tidak boleh.
Dialog: 0,0:59:10.08,0:59:12.42, Lalai,,0,0,0,, Walaupun anda menyelamatkannya sekarang,
Dialog: 0,0:59:12.79,0:59:15.62,Lalai,,0,0,0,,keluarganya sendiri yang memulakan khabar angin,
Dialog: 0,0:59:16.86,0:59:19.49, Lalai,,0,0,0,,dia akan dipaksa untuk hidup dengan reputasi buruk.
Dialog: 0,0:59:21.03,0:59:24.16,Default,,0,0,0,,Bukan sahaja dia, kanak-kanak itu menghadapi nasib yang sama.
Dialog: 0,0:59:26.37,0:59:33.34,Lalai,,0,0,0,,Tidakkah anda faham bahawa pegawai yang mengancam kedudukan anda tidak akan meninggalkannya sendirian?
Dialog: 0,0:59:38.95,0:59:41.25, Lalai,,0,0,0,,Hanya anda boleh menyelamatkan Baginda.
Dialog: 0,0:59:42.68,0:59:43.82, Lalai,,0,0,0,,Bagaimana?
Dialog: 0,0:59:45.05,0:59:46.92, Lalai,,0,0,0,,Bagaimanakah saya boleh menyelamatkannya?
Dialog: 0,0:59:47.45,0:59:49.46,Lalai,,0,0,0,,Hancurkan pemberontakan.
Dialog: 0,0:59:51.26,0:59:53.06,Lalai,,0,0,0,,Sendiri
Dialog: 0,0:59:53.86,0:59:56.03, Lalai,,0,0,0,,hukum pengikut Tonhak.
Dialog: 0,0:59:57.40,1:00:00.90,Lalai,,0,0,0,,Fitnah terhadap wanita raja yang pergi berperang,
Dialog: 0,1:00:00.90,1:00:04.07,Lalai,,0,0,0,,untuk melindungi negara, adalah tidak wajar, ini akan menghilangkan khabar angin.
Dialog: 0,1:00:04.67,1:00:08.48,Lalai,,0,0,0,,Jika anda membuktikan anda tidak bersalah dengan membunuh pengikut Tonhak,
Dialog: 0,1:00:09.41,1:00:12.48,Lalai,,0,0,0,,sifir yang terdapat dalam buku\N tidak akan menjadi ancaman kepada anda lagi.
Dialog: 0,1:00:14.08,1:00:15.25,Lalai,,0,0,0,,Ini
Dialog: 0,1:00:17.18,1:00:20.22,Lalai,,0,0,0,,satu-satunya cara untuk menyimpan
Dialog: 0,1:00:22.12,1:00:23.79,Lalai,,0,0,0,,permaisuri dan anak anda.
Dialog: 0,1:00:28.53,1:00:30.30,Lalai,,0,0,0,,Tiada masa untuk berfikir.
Dialog: 0,1:00:31.30,1:00:33.83,Lalai,,0,0,0,,Pada waktu pagi, khabar angin akan memusnahkan permaisuri.
Dialog: 0,1:00:36.10,1:00:37.47,Lalai,,0,0,0,,Tidak mungkin
Dialog: 0,1:00:39.77,1:00:42.21,Lalai,,0,0,0,,Saya tidak akan biarkan dia menderita sendirian.
Dialog: 0,1:01:14.14,1:01:15.68,Lalai,,0,0,0,,Saya tidak tidur.
Dialog: 0,1:01:16.48,1:01:18.18,Lalai,,0,0,0,,Sekadar berfikir.
Dialog: 0,1:01:18.38,1:01:21.18,Lalai,,0,0,0,,Jadi menyusahkan, kenapa anda tidak tidur?
Dialog: 0,1:01:21.38,1:01:23.62,Lalai,,0,0,0,,Saya datang untuk menghiburkan awak.
Dialog: 0,1:01:24.75,1:01:28.02,Lalai,,0,0,0,,Tetapi saya termenung.
Dialog: 0,1:01:30.12,1:01:31.99,Lalai,,0,0,0,,Jadi saya mahu tidur.
Dialog: 0,1:01:32.36,1:01:34.33,Lalai,,0,0,0,,Saya akan menghiburkan anda esok.
Dialog: 0,1:01:44.20,1:01:46.51,Lalai,,0,0,0,,Anda adalah saguhati saya.
Dialog: 0,1:02:44.10,1:02:47.10,Lalai,,0,0,0,,Pemberontakan Sangnam meletakkan negara dalam bahaya,
Dialog: 0,1:02:48.13,1:02:50.50,Lalai,,0,0,0,,Saya perlu pergi.
Dialog: 0,1:02:51.91,1:02:55.81,Lalai,,0,0,0,,Sebaik sahaja saya pergi, saya meminta anda untuk terlibat dalam politik.
Dialog: 0,1:02:55.81,1:02:56.94,Lalai,,0,0,0,,DAN
Dialog: 0,1:03:01.01,1:03:03.35,Lalai,,0,0,0,,jaga permaisuri dan anak kita.
Dialog: 0,1:03:04.28,1:03:06.95,Lalai,,0,0,0,,Saya pasti anda akan melakukan kerja yang baik dengan ini.
Dialog: 0,1:03:07.52,1:03:10.19,Lalai,,0,0,0,,Saya berasa baik tanpa politik.
Dialog: 0,1:03:11.76,1:03:13.46,Lalai,,0,0,0,,Tetapi apa yang boleh anda lakukan?
Dialog: 0,1:03:14.26,1:03:16.63,Lalai,,0,0,0,,Jangan risau tentang permaisuri.
Dialog: 0,1:03:16.96,1:03:19.73,Lalai,,0,0,0,,Jaga orang yang suaminya pergi
Dialog: 0,1:03:20.00,1:03:24.44,Lalai,,0,0,0,,untuk berperang, mempertaruhkan nyawa saya, adalah kewajipan saya.
Dialog: 0,1:03:25.24,1:03:26.91,Lalai,,0,0,0,,Mengharapkan anda
Dialog: 0,1:03:28.14,1:03:29.78,Lalai,,0,0,0,,dan saya akan pergi.
Dialog: 0,1:03:31.04,1:03:32.71,Lalai,,0,0,0,,Jaga diri anda.
Dialog: 0,1:03:35.28,1:03:37.55,Lalai,,0,0,0,,Matahari sudah terbit.
Dialog: 0,1:04:05.91,1:04:06.95,Lalai,,0,0,0,,Yang Mulia.
Dialog: 0,1:04:09.55,1:04:11.18,Lalai,,0,0,0,,Maka itu saya.
Dialog: 0,1:04:11.99,1:04:13.15,Lalai,,0,0,0,,Yang Mulia.
Dialog: 0,1:04:23.46,1:04:27.07,Lalai,,0,0,0,,Adakah benar anda sendiri yang akan menyekat pemberontakan?
Dialog: 0,1:04:27.37,1:04:28.50,Lalai,,0,0,0,,Ya.
Dialog: 0,1:04:28.50,1:04:30.00,Lalai,,0,0,0,,Apa yang sedang berlaku?
Dialog: 0,1:04:30.00,1:04:32.71,Lalai,,0,0,0,,Anda menyokong mereka, sekarang adakah anda akan membunuh mereka?
Dialog: 0,1:04:32.71,1:04:35.58,Lalai,,0,0,0,,Kim Byonin menemui kod yang tersembunyi dalam buku ratu.
Dialog: 0,1:04:37.88,1:04:41.45,Lalai,,0,0,0,,Jika saya tidak melakukan ini, berjuta-juta orang akan menderita.
Dialog: 0,1:04:41.45,1:04:42.78,Lalai,,0,0,0,,Saya akan ikut awak.
Dialog: 0,1:04:44.75,1:04:47.09,Lalai,,0,0,0,,Saya perlu pergi sendiri.
Dialog: 0,1:04:47.85,1:04:49.82,Lalai,,0,0,0,,Tidakkah cukup untuk menjadikan saya tebusan?
Dialog: 0,1:04:51.32,1:04:52.73,Lalai,,0,0,0,,Ini adalah perangkap.
Dialog: 0,1:04:52.76,1:04:54.99,Lalai,,0,0,0,,Tidakkah anda fikir bahawa ratu itu sendiri
Dialog: 0,1:04:55.30,1:04:57.40,Lalai,,0,0,0,,berikan buku itu kepada Kim Byungin?
Dialog: 0,1:04:57.80,1:04:59.83,Lalai,,0,0,0,,Anda berjanji.
Dialog: 0,1:05:00.27,1:05:03.14,Lalai,,0,0,0,,Jika ada bukti bahawa dia adalah musuh,
Dialog: 0,1:05:03.14,1:05:04.54,Lalai,,0,0,0,,anda sendiri akan memenggal kepalanya.
Dialog: 0,1:05:05.00,1:05:08.34,Lalai,,0,0,0,,Dia patut dipancung, bukan orang lain.
Dialog: 0,1:05:08.34,1:05:10.91,Lalai,,0,0,0,,Ratu pastinya bukan musuh kita.
Dialog: 0,1:05:11.78,1:05:14.95,Lalai,,0,0,0,,Dia membelakangi semua orang hanya untuk berada di sisi saya.
Dialog: 0,1:05:14.95,1:05:17.02,Lalai,,0,0,0,,Jika saya tidak pergi sekarang,
Dialog: 0,1:05:18.35,1:05:19.95,Lalai,,0,0,0,,permaisuri akan mati.
Dialog: 0,1:05:19.99,1:05:22.59,Lalai,,0,0,0,,Bertenang. Ini bukan masanya untuk bergaduh sesama sendiri.
Dialog: 0,1:05:25.19,1:05:27.43,Lalai,,0,0,0,,Awak kata saya perlu lebih menderita.
Dialog: 0,1:05:29.06,1:05:30.20,Lalai,,0,0,0,,Betul.
Dialog: 0,1:05:32.83,1:05:34.70,Lalai,,0,0,0,,Saya akan terima semuanya.
Dialog: 0,1:05:37.24,1:05:38.44,Lalai,,0,0,0,,Hidup anda
Dialog: 0,1:05:40.51,1:05:41.71,Lalai,,0,0,0,,dalam bahaya.
Dialog: 0,1:05:44.71,1:05:46.15,Lalai,,0,0,0,,Jika saya cuba bertahan,
Dialog: 0,1:05:47.65,1:05:49.25,Lalai,,0,0,0,,semua orang di sekeliling saya akan mati.
Dialog: 0,1:06:10.97,1:06:12.64,Lalai,,0,0,0,,Saya pasti saya nampak dia.
Dialog: 0,1:06:14.61,1:06:15.78,Lalai,,0,0,0,,Adakah ini mimpi?
Dialog: 0,1:06:21.51,1:06:24.15,Lalai,,0,0,0,,Puan Mahkamah Choi, Hong Young.
Dialog: 0,1:06:30.09,1:06:32.46,Lalai,,0,0,0,,Jom ke Daejojon. Saya merindui raja.
Dialog: 0,1:06:32.56,1:06:33.93,Lalai,,0,0,0,,-Ya, Tuanku.\N-Ya, Tuanku.
Dialog: 0,1:06:35.36,1:06:36.86,Lalai,,0,0,0,,Baginda akan berangkat.
Dialog: 0,1:06:37.83,1:06:39.53,Lalai,,0,0,0,,Meninggalkan? di mana?
Dialog: 0,1:06:49.38,1:06:50.84,Lalai,,0,0,0,,Jom pergi.
Dialog: 0,1:07:14.33,1:07:15.74,Lalai,,0,0,0,,Tunggu!
Dialog: 0,1:07:25.58,1:07:28.88,Lalai,,0,0,0,,Berhenti! Tunggu!
Dialog: 0,1:07:35.82,1:07:36.96,Lalai,,0,0,0,,Kenapa?
Dialog: 0,1:07:39.59,1:07:40.59,Lalai,,0,0,0,,Kenapa?
Dialog: 0,1:07:47.37,1:07:48.64,Lalai,,0,0,0,,Adakah ini jalan yang betul?
Dialog: 0,1:07:49.74,1:07:52.21,Lalai,,0,0,0,,Saya rasa jalan ini bukan untuk orang ramai.
Dialog: 0,1:07:52.51,1:07:54.44,Lalai,,0,0,0,,Ini adalah laluan terpendek.
Dialog: 0,1:08:20.10,1:08:21.27,Lalai,,0,0,0,,Berhenti.
Dialog: 0,1:08:27.67,1:08:28.84,Lalai,,0,0,0,,Anda lambat.
Dialog: 0,1:08:30.21,1:08:34.11,Lalai,,0,0,0,,Jika anda mahu melakukannya juga, jangan teragak-agak.
Dialog: 0,1:08:34.45,1:08:38.18,Lalai,,0,0,0,,Adakah anda akan turun dari kuda sendiri atau membantu?
Dialog: 0,1:08:50.10,1:08:52.07,Lalai,,0,0,0,,Tiada tempat untuk berundur.
Dialog: 0,1:08:53.97,1:08:56.00,Lalai,,0,0,0,,Kita perlu mencuba.
Dialog: 0,1:08:56.00,1:08:57.40,Lalai,,0,0,0,,Jangan risau.
Dialog: 0,1:09:00.24,1:09:02.14,Lalai,,0,0,0,,Saya boleh menanganinya seorang diri.
Dialog: 0,1:09:05.24,1:09:07.48,Lalai,,0,0,0,,Semuanya akan baik jika saya singkirkan awak.
Dialog: 0,1:09:57.16,1:09:58.33,Lalai,,0,0,0,,Bagaimana saya menjadi seorang ratu
Dialog: 0,1:09:58.33,1:09:59.60,Lalai,,0,0,0,,
Dialog: 0,1:09:59.60,1:10:00.77,Lalai,,0,0,0,,
Dialog: 0,1:10:21.35,1:10:23.89,Lalai,,0,0,0,,{\i1}Kanak-kanak ini makan banyak sekali.{\i}
Dialog: 0,1:10:23.89,1:10:25.49,Lalai,,0,0,0,,{\i1}Kata: "Ayah, balik segera."{\i}
Dialog: 0,1:10:25.49,1:10:26.79,Lalai,,0,0,0,,{\i1}Saya rasa dia menendang.{\i}
Dialog: 0,1:10:27.33,1:10:29.86,Lalai,,0,0,0,,{\i1}Tuanku, Raja...{\i}
Dialog: 0,1:10:29.86,1:10:31.93,Lalai,,0,0,0,,{\i1}Kini pemilik tempat ini akan bertukar.{\i}
Dialog: 0,1:10:31.93,1:10:34.13,Lalai,,0,0,0,,{\i1}Apa gunanya,{\i}
Dialog: 0,1:10:34.80,1:10:36.07,Lalai,,0,0,0,,{\i1}jika anda tiada?{\i}
Dialog: 0,1:10:36.07,1:10:37.34,Lalai,,0,0,0,,{\i1}Anda kata anda tidak bersalah.{\i}
Dialog: 0,1:10:37.34,1:10:38.97,Lalai,,0,0,0,,{\i1}Berada di pihak yang lemah juga merupakan satu jenayah.{\i}
Dialog: 0,1:10:38.97,1:10:41.24,Lalai,,0,0,0,,{\i1}Benin. Sejauh manakah anda akan pergi?{\i}
Dialog: 0,1:10:41.24,1:10:44.48,Lalai,,0,0,0,,{\i1}Yang paling penting ialah dilahirkan sihat.{\i}
Dialog: 0,1:10:44.48,1:10:46.41,Lalai,,0,0,0,,{\i1}Saya akan bunuh permaisuri,{\i}
Dialog: 0,1:10:46.41,1:10:49.48,Lalai,,0,0,0,,{\i1}yang bekerjasama dengan kamu untuk membunuh raja.{\i}
Dialog: 0,0:16:11.74,0:16:13.74,Lalai,,0,0,0,,


