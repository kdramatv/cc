Dialogue: 0,0:00:58.00,0:01:03.98,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДДСТА
Dialogue: 0,0:00:58.00,0:01:03.98,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807}\fscy2007 92 38 l 0 38
Dialogue: 0,0:00:58.00,0:01:03.98,nagtrabaho,,0,0,0,,{\pos(801,256)}Gumawa sa serye:\N Lily, Tiramisu, Biryulka, Host, Singer
Dialogue: 0,0:00:58.00,0:01:03.98,title,,0,0,0,,{\fscx75\fscy75\pos(846,392)}Paano ako naging
Dialogue: 0,0:00:58.00,0:01:03.98,pangalan,,0,0,0,,{\fscx75\fscy75\pos(848,456)}reyna
Dialogue: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialogue: 0,0:01:04.12,0:01:06.52,Default,Lily,0,0,0,,Lahat ng character ay kathang-isip lang,
Dialogue: 0,0:01:06.52,0:01:08.52,Default,Lily,0,0,0,,at ang mga kaganapang ipinakita ay kathang-isip lamang.
Dialogue: 0,0:02:19.19,0:02:21.63,Default,Lily,0,0,0,,-Kamahalan!\N-Kamahalan!
Dialogue: 0,0:02:24.23,0:02:26.10,Default,Lily,0,0,0,,Isang tunay na himala para sa amin,
Dialogue: 0,0:02:26.67,0:02:28.90,Default,Lily,0,0,0,,na pagkatapos ng bawat araw ay darating ang bukas.
Dialogue: 0,0:02:30.00,0:02:32.84,Default,Lily,0,0,0,,Delikado ito. Maaaring may isa pang pagsabog.
Dialogue: 0,0:02:35.04,0:02:36.18,Default,Lily,0,0,0,,Kamahalan!
Dialogue: 0,0:02:36.91,0:02:38.81,Default,Lily,0,0,0,,Hindi. Hindi ka makakapunta doon.
Dialogue: 0,0:02:38.81,0:02:41.55,Default,Lily,0,0,0,,Kamahalan!
Dialogue: 0,0:02:41.55,0:02:43.88,Default,Lily,0,0,0,,-Kamahalan!\N-Protektahan ang hari.
Dialogue: 0,0:02:43.98,0:02:46.35,Default,Lily,0,0,0,,Kamahalan!
Dialogue: 0,0:02:47.39,0:02:50.32,Default,Lily,0,0,0,,Kamahalan, kailangan na nating umalis.
Dialogue: 0,0:02:50.92,0:02:52.49,Default,Lily,0,0,0,,-Kamahalan!\N-Mas mabilis.
Dialogue: 0,0:03:00.90,0:03:02.90,Default,Lily,0,0,0,,Hindi. Kailangan natin siyang iligtas!
Dialogue: 0,0:03:02.90,0:03:05.04,Default,Lily,0,0,0,,-Kamahalan.\N-Huwag kang pumunta doon.
Dialogue: 0,0:03:05.04,0:03:06.44,Default,Lily,0,0,0,,Huwag makialam.
Dialogue: 0,0:03:06.61,0:03:08.78,Default,Lily,0,0,0,,Ano ang sinasabi mo? Hari...
Dialogue: 0,0:03:08.91,0:03:10.21,Default,Lily,0,0,0,,Makinig ka sa akin!
Dialogue: 0,0:03:12.48,0:03:14.31,Default,Lily,0,0,0,,Ipapaliwanag ko sa iyo ang lahat mamaya.
Dialogue: 0,0:03:14.31,0:03:16.48,Default,Lily,0,0,0,,Ngayon iligtas mo ang iyong sarili.
Dialogue: 0,0:03:16.52,0:03:18.48,Default,Lily,0,0,0,,-Kamahalan!\N-Delikado dito,
Dialogue: 0,0:03:18.48,0:03:20.02,Default,Lily,0,0,0,,dalahin ang reyna sa Daejojeon.
Dialogue: 0,0:03:21.86,0:03:24.39,Default,Lily,0,0,0,,-Kamahalan, huwag kang pumunta doon.\N-Kamahalan.
Dialogue: 0,0:03:24.39,0:03:25.99,Default,Lily,0,0,0,,-Papasukin mo ako!\N-Kamahalan.
Dialogue: 0,0:03:25.99,0:03:27.69,Default,Lily,0,0,0,,-Your Majesty.\N-Your Majesty.
Dialogue: 0,0:03:27.69,0:03:29.46,Default,Lily,0,0,0,,Papasukin mo ako, please.
Dialogue: 0,0:03:29.60,0:03:31.80,Default,Lily,0,0,0,,Bitawan mo ako!
Dialogue: 0,0:03:31.80,0:03:32.97,Default,Lily,0,0,0,,Papasukin mo ako!
Dialogue: 0,0:03:32.97,0:03:34.00,Default,Lily,0,0,0,,Kamahalan!
Dialogue: 0,0:03:34.73,0:03:36.04,Default,Lily,0,0,0,,Gayunpaman
Dialogue: 0,0:03:37.24,0:03:39.74,Default,Lily,0,0,0,,hindi namin maintindihan kung gaano ito kaganda,
Dialogue: 0,0:03:40.91,0:03:43.34,Default,Lily,0,0,0,,hanggang sa dumating ang araw na wala ng bukas.
Dialogue: 0,0:03:45.14,0:03:48.05,Default,Lily,0,0,0,,Napakatanga namin na hindi namin pinahahalagahan ang isang bagay,
Dialogue: 0,0:03:48.98,0:03:50.68,Default,Lily,0,0,0,,hanggang sa matalo tayo.
Dialogue: 0,0:03:52.05,0:03:57.42,Default,Lily,0,0,0,,Hindi na darating ang bukas
Dialogue: 0,0:03:59.63,0:04:02.33,Default,Lily,0,0,0,,13 episode
Dialogue: 0,0:04:15.17,0:04:18.75,Default,Lily,0,0,0,,May nangahas na pumatay sa hari sa palasyo.
Dialogue: 0,0:04:19.18,0:04:22.12,Default,Lily,0,0,0,,Huliin ang lahat ng kahina-hinalang tao at tanungin sila.
Dialogue: 0,0:04:22.68,0:04:24.15,Default,Lily,0,0,0,,Kailangan nating malaman
Dialogue: 0,0:04:24.88,0:04:27.19,Default,Lily,0,0,0,,sino ang nasa likod nito.
Dialogue: 0,0:04:29.02,0:04:31.32,Default,Lily,0,0,0,,Nahanda mo na ba ito?
Dialogue: 0,0:04:31.72,0:04:35.33,Default,Lily,0,0,0,,Paano mo haharapin ang mga kahihinatnan pagkatapos planuhin ito?
Dialogue: 0,0:04:35.56,0:04:36.80,Default,Lily,0,0,0,,Kalmado.
Dialogue: 0,0:04:36.80,0:04:39.13,Default,Lily,0,0,0,,Para akong kumalma!
Dialogue: 0,0:04:39.13,0:04:41.90,Default,Lily,0,0,0,,Ang buhay ng hari ay pinagbantaan sa harap ng lahat,
Dialogue: 0,0:04:41.90,0:04:43.90,Default,Lily,0,0,0,,para rin sa palabas.
Dialogue: 0,0:04:44.90,0:04:48.81,Default,Lilia,0,0,0,,So, napagdesisyunan ng lahat na ako ang nagtangka sa buhay niya?
Dialogue: 0,0:04:51.61,0:04:53.58,Default,Lily,0,0,0,,Ako na ang bahala.
Dialogue: 0,0:05:00.39,0:05:03.02,Default,Lily,0,0,0,,Nakikiusap ako sa iyo. nagdadasal ako.
Dialogue: 0,0:05:03.69,0:05:07.49,Default,Lily,0,0,0,,Desperado akong nananalangin sa mga diyos ng langit at lupa.
Dialogue: 0,0:05:08.13,0:05:12.73,Default,Lily,0,0,0,,Iligtas ang aming hari.
Dialogue: 0,0:05:13.93,0:05:17.00,Default,Lily,0,0,0,,Nakikiusap ako sa iyo. nagdadasal ako.
Dialogue: 0,0:05:17.57,0:05:19.57,Default,Lily,0,0,0,,Nakikiusap ako sa iyo.
Dialogue: 0,0:05:21.81,0:05:24.41,Default,Lily,0,0,0,,I-save
Dialogue: 0,0:05:26.25,0:05:28.72,Default,Lily,0,0,0,,ang aming hari.
Dialogue: 0,0:05:34.42,0:05:36.59,Default,Lily,0,0,0,,Hindi ko alam na aabot sila hanggang dito.
Dialogue: 0,0:05:37.16,0:05:39.76,Default,Lily,0,0,0,,Sila mismo ang naglagay sa kanya sa trono,
Dialogue: 0,0:05:39.76,0:05:42.43,Default,Lilia,0,0,0,,at ngayon gusto na nilang tanggalin siya.
Dialogue: 0,0:05:44.06,0:05:48.10,Default,Lily,0,0,0,,Ano ang mangyayari kung hindi magising ang hari?
Dialogue: 0,0:05:49.07,0:05:55.02,Default,Lily,0,0,0,,Kung gayon ang royal concubine at ako ay mawawalan ng kapangyarihan.
Dialogue: 0,0:05:58.24,0:06:00.88,Default,Lily,0,0,0,,I can't believe we got it right
Dialogue: 0,0:06:01.25,0:06:03.42,Default,Lily,0,0,0,,sa isang bitag na itinakda para sa reyna.
Dialogue: 0,0:06:04.05,0:06:06.82,Default,Lily,0,0,0,,Nakikiusap ako sa iyo. nagdadasal ako.
Dialogue: 0,0:06:08.79,0:06:10.12,Default,Lily,0,0,0,,Nakikiusap ako sa iyo.
Dialogue: 0,0:06:13.89,0:06:16.20,Default,Lily,0,0,0,,Magpahinga ng kaunti.
Dialogue: 0,0:06:16.50,0:06:18.87,Default,Lily,0,0,0,,Malapit ka nang mahulog.
Dialogue: 0,0:06:21.80,0:06:25.61,Default,Lily,0,0,0,,Kung hindi mabuhay ang hari,
Dialogue: 0,0:06:26.61,0:06:28.94,Default,Lily,0,0,0,,Hindi rin ako mabubuhay.
Dialogue: 0,0:06:31.14,0:06:34.01,Default,Lily,0,0,0,,Kung kailangan mong mamatay,
Dialogue: 0,0:06:34.85,0:06:38.95,Default,Lily,0,0,0,,bago ako mamatay maghihiganti ako sa nagkasala ng hari.
Dialogue: 0,0:06:40.69,0:06:41.72,Default,Lily,0,0,0,,Palasyo
Dialogue: 0,0:06:43.66,0:06:45.39,Default,Lily,0,0,0,,at ang mga taong iyon
Dialogue: 0,0:06:47.79,0:06:50.66,Default,Lily,0,0,0,,nagalit sa amin.
Dialogue: 0,0:07:23.70,0:07:27.97,Default,Lily,0,0,0,,Kamahalan. Dumating ang pinuno ng Detective Department.
Dialogue: 0,0:07:30.57,0:07:31.64,Default,Lily,0,0,0,,At Cheoljong...
Dialogue: 0,0:07:32.97,0:07:35.74,Default,Lily,0,0,0,,Okay lang ba ang hari?
Dialogue: 0,0:07:37.44,0:07:39.51,Default,Lily,0,0,0,,Prinsipe Yeonpyeong ipinagbabawal
Dialogue: 0,0:07:39.51,0:07:41.55,Default,Lily,0,0,0,,pumasok sa Hijonjon habang ginagamot ang hari.
Dialogue: 0,0:07:42.48,0:07:45.28,Default,Lily,0,0,0,,At wala silang sinasabi tungkol sa kalagayan ng hari.
Dialogue: 0,0:07:46.12,0:07:47.25,Default,Lily,0,0,0,,Dapat ko siyang puntahan.
Dialogue: 0,0:07:47.25,0:07:48.49,Default,Lily,0,0,0,,Huwag kang pumunta.
Dialogue: 0,0:07:51.86,0:07:53.79,Default,Lily,0,0,0,,Papasukin nila ako.
Dialogue: 0,0:07:53.79,0:07:55.26,Default,Lilia,0,0,0,,Ako pa rin ang asawa niya.
Dialogue: 0,0:08:22.66,0:08:24.12,Default,Lily,0,0,0,,Huwag kang pumunta.
Dialogue: 0,0:08:24.79,0:08:26.96,Default,Lily,0,0,0,,Sinubukan niya ang buhay mo.
Dialogue: 0,0:08:27.46,0:08:30.26,Default,Lily,0,0,0,,May karapatan kang patayin siya.
Dialogue: 0,0:08:38.27,0:08:39.34,Default,Lily,0,0,0,,Soyeon.
Dialogue: 0,0:08:49.05,0:08:52.75,Default,Lily,0,0,0,,Kailangan kong magpahinga.
Dialogue: 0,0:09:48.94,0:09:51.04,Default,Lily,0,0,0,,Sigurado ka bang walang magiging problema?
Dialogue: 0,0:09:51.04,0:09:52.04,Default,Lily,0,0,0,,Siyempre.
Dialogue: 0,0:10:19.84,0:10:21.44,Default,Lily,0,0,0,,Sino ang nasa likod nito?
Dialogue: 0,0:10:22.48,0:10:24.04,Default,Lily,0,0,0,,Inosente kami.
Dialogue: 0,0:10:24.71,0:10:27.55,Default,Lily,0,0,0,,Handa kaming ibigay ang aming buhay para protektahan ang hari.
Dialogue: 0,0:10:28.65,0:10:29.92,Default,Lily,0,0,0,,Kami ang royal guard.
Dialogue: 0,0:10:35.49,0:10:38.29,Default,Lily,0,0,0,,Bakit kailangan mo ng mga pekeng dokumento?
Dialogue: 0,0:10:38.56,0:10:41.39,Default,Lily,0,0,0,,Ginamit mo itong dahilan para pigilan kami,
Dialogue: 0,0:10:42.60,0:10:44.60,Default,Lily,0,0,0,,at sa oras na ito nagdusa ang hari.
Dialogue: 0,0:10:45.23,0:10:46.50,Default,Lily,0,0,0,,Ang nasa likod nito ay,
Dialogue: 0,0:10:46.97,0:10:49.74,Default,Lily,0,0,0,,na nakakita ng mga error sa aming mga dokumento. Ang tatay mo
Dialogue: 0,0:10:50.40,0:10:51.54,Default,Lily,0,0,0,,Kim Jwageun!
Dialogue: 0,0:10:53.44,0:10:55.31,Default,Lily,0,0,0,,Ito si Kim Jwageun.
Dialogue: 0,0:10:57.21,0:10:58.71,Default,Lily,0,0,0,,Medyo matalino ka.
Dialogue: 0,0:11:05.32,0:11:06.45,Default,Lily,0,0,0,,Naisip ko.
Dialogue: 0,0:11:13.16,0:11:15.70,Default,Lily,0,0,0,,Gaya ng iyong naisip, ang insenso burner ay hindi napuno ng buhangin,
Dialogue: 0,0:11:15.70,0:11:17.60,Default,Lily,0,0,0,,at pulbura na ginamit bilang pampasabog.
Dialogue: 0,0:11:18.06,0:11:19.37,Default,Lily,0,0,0,,Paano mo nahulaan?
Dialogue: 0,0:11:27.94,0:11:29.11,Default,Lily,0,0,0,,Paano ito nangyari?
Dialogue: 0,0:11:29.44,0:11:31.24,Default,Lily,0,0,0,,Hindi madaling pilitin silang umamin.
Dialogue: 0,0:11:31.24,0:11:32.51,Default,Lily,0,0,0,,Walang alinlangan.
Dialogue: 0,0:11:33.18,0:11:34.58,Default,Lily,0,0,0,,May natutunan ka pa ba?
Dialogue: 0,0:11:35.21,0:11:36.52,Default,Lily,0,0,0,,Hindi pa.
Dialogue: 0,0:11:36.55,0:11:39.35,Default,Lily,0,0,0,,Kailangan nating hanapin ang mga kriminal para tapusin ito.
Dialogue: 0,0:11:39.75,0:11:41.65,Default,Lily,0,0,0,,Hanapin ang instigator sa lalong madaling panahon.
Dialogue: 0,0:11:41.65,0:11:42.72,Default,Lily,0,0,0,,Oo.
Dialogue: 0,0:11:48.19,0:11:50.30,Default,Lily,0,0,0,,Alamin kung saan nanggagaling ang pulbura.
Dialogue: 0,0:11:51.56,0:11:53.30,Default,Lily,0,0,0,,Ilipat nang tahimik at mag-isa.
Dialogue: 0,0:11:53.60,0:11:54.67,Default,Lily,0,0,0,,Oo.
Dialogue: 0,0:12:04.71,0:12:05.75,Default,Lily,0,0,0,,Mr.
Dialogue: 0,0:12:06.31,0:12:08.91,Default,Lily,0,0,0,,Patawarin mo ako.
Dialogue: 0,0:12:09.95,0:12:12.75,Default,Lily,0,0,0,,Anong ginagawa mo? Masyadong maraming mata.
Dialogue: 0,0:12:13.32,0:12:14.52,Default,Lily,0,0,0,,Nakikiusap ako sa iyo.
Dialogue: 0,0:12:14.69,0:12:16.36,Default,Lily,0,0,0,,Makinig ka sa akin.
Dialogue: 0,0:12:16.76,0:12:20.19,Default,Lily,0,0,0,,Hindi ito magtatagal. konti na lang.
Dialogue: 0,0:12:20.46,0:12:22.83,Default,Lily,0,0,0,,Pakiusap. Hindi nagtagal.
Dialogue: 0,0:12:25.33,0:12:26.40,Default,Lily,0,0,0,,Baka sakali
Dialogue: 0,0:12:27.83,0:12:30.47,Default,Lily,0,0,0,,iingatan ang accounting book.
Dialogue: 0,0:12:32.24,0:12:35.17,Default,Lily,0,0,0,,Hindi ko man lang naisip na gamitin ito.
Dialogue: 0,0:12:35.41,0:12:39.11,Default,Lily,0,0,0,,Bukod dito, walang alam ang reyna tungkol dito.
Dialogue: 0,0:12:39.38,0:12:40.98,Default,Lily,0,0,0,,Nasaan na ang accounting book?
Dialogue: 0,0:12:46.92,0:12:49.29,Default,Lily,0,0,0,,Hindi ba siya nasa iyo?
Dialogue: 0,0:12:50.62,0:12:52.22,Default,Lily,0,0,0,,Kung ganoon ay siya lang ang
Dialogue: 0,0:12:53.33,0:12:54.49,Default,Lily,0,0,0,,sa hari.
Dialogue: 0,0:12:56.13,0:12:57.16,Default,Lily,0,0,0,,Paano kaya.
Dialogue: 0,0:13:00.73,0:13:03.34,Default,Lily,0,0,0,,Ang mga bakas na iniwan mo ay naglagay sa aming clan sa panganib.
Dialogue: 0,0:13:03.57,0:13:05.74,Default,Lily,0,0,0,,Sapat na ito para parusahan ka.
Dialogue: 0,0:13:06.27,0:13:07.44,Default,Lily,0,0,0,,Gagawin ko lahat ng sasabihin mo.
Dialogue: 0,0:13:08.07,0:13:09.94,Default,Lily,0,0,0,,Kung sasabihin mong mamatay ako, mamamatay ako.
Dialogue: 0,0:13:14.98,0:13:16.08,Default,Lily,0,0,0,,Dito.
Dialogue: 0,0:13:19.49,0:13:21.42,Default,Lily,0,0,0,,Magbibitin ako dito mismo.
Dialogue: 0,0:13:25.39,0:13:26.86,Default,Lily,0,0,0,,I'm hanging myself.
Dialogue: 0,0:13:33.43,0:13:35.73,Default,Lily,0,0,0,,Iligtas mo ako, ginoo.
Dialogue: 0,0:13:36.90,0:13:40.11,Default,Lily,0,0,0,,Iligtas mo ako.
Dialogue: 0,0:13:50.45,0:13:52.18,Default,Lily,0,0,0,,Kamahalan.
Dialogue: 0,0:13:52.18,0:13:55.59,Default,Lily,0,0,0,,Kamahalan, natauhan ka na ba?
Dialogue: 0,0:13:57.36,0:13:58.89,Default,Lily,0,0,0,,Kapatid ko.
Dialogue: 0,0:13:58.89,0:14:01.39,Default,Lily,0,0,0,,Oo. Magpatuloy.
Dialogue: 0,0:14:02.66,0:14:04.50,Default,Lily,0,0,0,,Bakit ang ingay dito?
Dialogue: 0,0:14:05.70,0:14:08.50,Default,Lily,0,0,0,,Napakaingay kaya sumasakit ang ulo ko.
Dialogue: 0,0:14:10.80,0:14:12.81,Default,Lily,0,0,0,,Wala akong marinig.
Dialogue: 0,0:14:14.97,0:14:16.94,Default,Lily,0,0,0,,I-mute ang ingay.
Dialogue: 0,0:14:33.76,0:14:35.49,Default,Lily,0,0,0,,Dapat nagpaliwanag ako.
Dialogue: 0,0:14:37.30,0:14:40.17,Default,Lily,0,0,0,,Dapat sinabi ko sa kanya na hindi ako sinubukang patayin ng hari.
Dialogue: 0,0:14:43.34,0:14:45.17,Default,Lily,0,0,0,,Sinubukan niya ang buhay mo.
Dialogue: 0,0:14:45.37,0:14:47.87,Default,Lily,0,0,0,,May karapatan kang patayin siya.
Dialogue: 0,0:14:51.64,0:14:54.85,Default,Lily,0,0,0,,Kailangan mong bayaran ang iyong kawalang-ingat.
Dialogue: 0,0:14:55.85,0:14:57.88,Default,Lily,0,0,0,,Ang Kim clan ba ang nasa likod nito?
Dialogue: 0,0:14:59.82,0:15:01.05,Default,Lily,0,0,0,,O ibang clan?
Dialogue: 0,0:15:03.36,0:15:04.46,Default,Lily,0,0,0,,Kamahalan.
Dialogue: 0,0:15:06.29,0:15:09.06,Default,Lily,0,0,0,,Kamahalan. Namulat ang hari.
Dialogue: 0,0:15:32.69,0:15:34.02,Default,Lily,0,0,0,,Mukhang nagising siya.
Dialogue: 0,0:15:35.29,0:15:37.42,Default,Lily,0,0,0,,Nakatulog lang siya.
Dialogue: 0,0:15:47.13,0:15:49.03,Default,Lily,0,0,0,,Bakit mo siya binalot ng ganyan?
Dialogue: 0,0:15:52.00,0:15:53.44,Default,Lily,0,0,0,,Mukhang sobrang sakit.
Dialogue: 0,0:15:54.41,0:15:55.81,Default,bir,0,0,0,,Sa kasamaang palad,
Dialogue: 0,0:15:56.61,0:15:59.55,Default,bir,0,0,0,,dahil sa pagsabog, nawalan siya ng pandinig.
Dialogue: 0,0:16:03.08,0:16:04.18,Default,bir,0,0,0,,Huwag sabihin,
Dialogue: 0,0:16:07.55,0:16:09.25,Default,bir,0,0,0,,na siya ay magiging bingi habang buhay.
Dialogue: 0,0:16:09.52,0:16:12.46,Default,bir,0,0,0,,Oras lang ang magsasabi.
Dialogue: 0,0:16:27.84,0:16:29.21,Default,bir,0,0,0,,Pabayaan mo kami.
Dialogue: 0,0:16:30.71,0:16:31.78,Default,bir,0,0,0,,Oo.
Dialogue: 0,0:16:50.80,0:16:53.77,Default,bir,0,0,0,,Sasabihin mo bang hindi ito ang gawain ng iyong uri?
Dialogue: 0,0:16:55.67,0:16:56.97,Default,bir,0,0,0,,Sabi mo sa akin,
Dialogue: 0,0:16:58.24,0:17:00.21,Default,bir,0,0,0,,na mawawalan ako ng taong mahal sa puso ko.
Dialogue: 0,0:17:03.14,0:17:04.64,Default,bir,0,0,0,,Ngayon sa puso ko
Dialogue: 0,0:17:05.84,0:17:08.28,Default,bir,0,0,0,,walang natira.
Dialogue: 0,0:17:12.62,0:17:13.85,Default,bir,0,0,0,,Kaya tanong ko,
Dialogue: 0,0:17:15.59,0:17:16.76,Default,bir,0,0,0,,itigil ito.
Dialogue: 0,0:17:36.78,0:17:39.65,Default,bir,0,0,0,,Kamahalan, huwag ka nang mag-alala.
Dialogue: 0,0:18:03.77,0:18:04.87,Default,bir,0,0,0,,Sino...
Dialogue: 0,0:18:06.64,0:18:09.64,Default,bir,0,0,0,,My king, nagising ka na ba?
Dialogue: 0,0:18:10.91,0:18:12.61,Default,bir,0,0,0,,Hayaan mo akong basain ang iyong mga labi.
Dialogue: 0,0:18:23.89,0:18:25.86,Default,bir,0,0,0,,Queen's Dictionary
Dialogue: 0,0:18:54.25,0:18:56.02,Default,bir,0,0,0,,Kaya pumunta ka para bisitahin ang hari.
Dialogue: 0,0:19:02.59,0:19:05.40,Default,bir,0,0,0,,dumating ako para aliwin ka pagkatapos ng nangyari
Dialogue: 0,0:19:05.83,0:19:08.10,Default,bir,0,0,0,,at magtanong ng ilang katanungan.
Dialogue: 0,0:19:10.04,0:19:12.94,Default,bir,0,0,0,,Nawalan ng mahalagang bagay ang iyong ama.
Dialogue: 0,0:19:13.71,0:19:16.28,Default,bir,0,0,0,,Sigurado akong palihim siyang kinuha ng hari.
Dialogue: 0,0:19:17.11,0:19:18.88,Default,bir,0,0,0,,May alam ka ba tungkol dito?
Dialogue: 0,0:19:20.05,0:19:22.48,Default,bir,0,0,0,,-Nakuha ko, tumatakbo ako para humingi ng tulong.\N-Hindi.
Dialogue: 0,0:19:23.12,0:19:25.78,Default,bir,0,0,0,,Walang dapat makaalam na ako...
Dialogue: 0,0:19:26.99,0:19:29.02,Default,bir,0,0,0,,Ano ako...
Dialogue: 0,0:19:33.53,0:19:34.86,Default,bir,0,0,0,,Para may alam ka.
Dialogue: 0,0:19:36.06,0:19:37.90,Default,bir,0,0,0,,Tandaan ang sinabi ko,
Dialogue: 0,0:19:37.90,0:19:39.73,Default,bir,0,0,0,,na ang ating uri ay walang kahinaan?
Dialogue: 0,0:19:40.93,0:19:42.97,Default,bir,0,0,0,,Dahil inaalis namin sila kaagad.
Dialogue: 0,0:19:52.18,0:19:55.08,Default,bir,0,0,0,,Hayaan mong tanungin kita sa huling pagkakataon.
Dialogue: 0,0:19:56.38,0:19:58.72,Default,bir,0,0,0,,May gusto ka bang sabihin sa akin?
Dialogue: 0,0:20:01.39,0:20:02.89,Default,bir,0,0,0,,Noong nasa bahay ko kami,
Dialogue: 0,0:20:04.02,0:20:07.13,Default,bir,0,0,0,,Iniligtas ko ang hari nang mahulog siya sa balon.
Dialogue: 0,0:20:08.29,0:20:09.66,Default,bir,0,0,0,,Siguro noon...
Dialogue: 0,0:20:15.37,0:20:18.77,Default,bir,0,0,0,,Kanina pa ako nag-alok sa iyo.
Dialogue: 0,0:20:19.30,0:20:21.44,Default,bir,0,0,0,,Ang araw na nahulog ka sa lawa.
Dialogue: 0,0:20:24.61,0:20:26.68,Default,bir,0,0,0,,Papaalalahanan kita.
Dialogue: 0,0:20:27.85,0:20:30.58,Default,bir,0,0,0,,Hiniling ko sa iyo na huwag alisin ang tingin mo sa iyong asawa.
Dialogue: 0,0:20:31.85,0:20:33.09,Default,bir,0,0,0,,Tatanggapin mo
Dialogue: 0,0:20:34.45,0:20:36.76,Default,bir,0,0,0,,my suggestion?
Dialogue: 0,0:20:47.10,0:20:50.74,Default,bir,0,0,0,,At ano ang makukuha kong kapalit?
Dialogue: 0,0:20:51.34,0:20:52.84,Default,bir,0,0,0,,Ano ang gusto mo?
Dialogue: 0,0:20:54.64,0:20:56.48,Default,bir,0,0,0,,Mga garantiya ng aking kaligtasan.
Dialogue: 0,0:21:16.13,0:21:18.40,Default,bir,0,0,0,,Your Highness, oras na para bumalik ka.
Dialogue: 0,0:21:30.51,0:21:32.21,Default,bir,0,0,0,,Queen's Dictionary
Dialogue: 0,0:21:58.27,0:21:59.94,Default,bir,0,0,0,,Hindi dapat ako nakarating dito\NJang Bong-hwan
Dialogue: 0,0:22:13.12,0:22:14.19,Default,bir,0,0,0,,Cheoljong.
Dialogue: 0,0:22:15.15,0:22:16.25,Default,bir,0,0,0,,Paumanhin.
Dialogue: 0,0:22:17.66,0:22:19.32,Default,bir,0,0,0,,Matatalo ka pa rin.
Dialogue: 0,0:22:21.56,0:22:23.43,Default,bir,0,0,0,,Kampi ako sa nanalo.
Dialogue: 0,0:22:30.94,0:22:34.41,Default,bir,0,0,0,,Kim Soyeon, nagpaalam ka pa sa buhay.
Dialogue: 0,0:22:36.17,0:22:38.01,Default,bir,0,0,0,,Dahil ako na ang pumalit sa iyo,
Dialogue: 0,0:22:38.78,0:22:40.98,Default,bir,0,0,0,,hayaan kong mamuhay nang maayos sa buhay na ito.
Dialogue: 0,0:22:43.28,0:22:45.18,Default,bir,0,0,0,,Upang magtagumpay ito, kailangan kong malaman
Dialogue: 0,0:22:45.88,0:22:47.22,Default,bir,0,0,0,,ano ang nangyari noong araw na iyon.
Dialogue: 0,0:23:48.48,0:23:50.15,Default,bir,0,0,0,,Balang araw matatalo ka
Dialogue: 0,0:23:50.25,0:23:52.78,Default,bir,0,0,0,,taong mahal mo.
Dialogue: 0,0:23:54.02,0:23:56.12,Default,bir,0,0,0,,Dapat mahalin mo ako.
Dialogue: 0,0:23:56.12,0:23:58.16,Default,bir,0,0,0,,Utos ba ito?
Dialogue: 0,0:24:03.10,0:24:05.90,Default,bir,0,0,0,,Walang totoo sa akin, lahat ay kasinungalingan.
Dialogue: 0,0:24:07.40,0:24:09.33,Default,bir,0,0,0,,Ikaw si Soyeon.
Dialogue: 0,0:24:16.21,0:24:18.78,Default,bir,0,0,0,,Nakuha mo na ba ang posisyong ito?
Dialogue: 0,0:24:19.48,0:24:21.85,Default,bir,0,0,0,,Kung gusto mong mamatay, mamatay ka sa palasyo.
Dialogue: 0,0:24:23.18,0:24:25.92,Default,bir,0,0,0,,Bukas magiging reyna ka na.
Dialogue: 0,0:24:35.66,0:24:38.40,Default,bir,0,0,0,,Bukas magiging reyna ka na.
Dialogue: 0,0:24:38.53,0:24:39.60,Default,bir,0,0,0,,Mula ngayon
Dialogue: 0,0:24:40.43,0:24:43.84,Default,bir,0,0,0,,sabihin mo sa akin ang lahat tungkol sa kanya.
Dialogue: 0,0:24:43.97,0:24:46.34,Default,bir,0,0,0,,Tanungin mo ako
Dialogue: 0,0:24:47.87,0:24:49.24,Default,bir,0,0,0,,bantayan ang hari?
Dialogue: 0,0:24:49.54,0:24:52.51,Default,bir,0,0,0,,Huwag sundin ang hari,\N at huwag alisin ang tingin sa iyong asawa.
Dialogue: 0,0:24:57.18,0:24:58.32,Default,bir,0,0,0,,Ayoko.
Dialogue: 0,0:25:00.85,0:25:03.89,Default,bir,0,0,0,,Hindi mo ba kailangan ang pagiging reyna
Dialogue: 0,0:25:03.89,0:25:05.76,Default,bir,0,0,0,,at ang hari?
Dialogue: 0,0:25:06.59,0:25:09.93,Default,bir,0,0,0,,Dapat mong gawin kung ano ang iyong ipinanganak upang gawin.
Dialogue: 0,0:25:12.36,0:25:14.80,Default,bir,0,0,0,,Tulad ng ginawa nila sa nakaraan.
Dialogue: 0,0:25:20.11,0:25:23.11,Default,bir,0,0,0,,Nang sabihin nila sa akin na ang hari ay nasa balon.
Dialogue: 0,0:25:28.65,0:25:31.58,Default,bir,0,0,0,,Kung hindi mo ginagampanan ang iyong tungkulin,
Dialogue: 0,0:25:31.82,0:25:35.22,Default,bir,0,0,0,,walang silbi ang hari. Mula sa walang silbi
Dialogue: 0,0:25:36.15,0:25:37.92,Default,bir,0,0,0,,kailangan natin itong alisin.
Dialogue: 0,0:25:39.19,0:25:40.96,Default,bir,0,0,0,,Kung sasaktan mo ang hari,
Dialogue: 0,0:25:41.76,0:25:43.40,Default,bir,0,0,0,,Hindi ako tatayo.
Dialogue: 0,0:25:43.40,0:25:45.66,Default,bir,0,0,0,,So ano ang gagawin mo?
Dialogue: 0,0:25:46.30,0:25:48.40,Default,bir,0,0,0,,Masyado kang nagkakamali.
Dialogue: 0,0:25:48.70,0:25:52.37,Default,bir,0,0,0,,Sa tingin mo ba may kapangyarihan ang reyna?
Dialogue: 0,0:25:52.90,0:25:58.41,Default,bir,0,0,0,,Ang reyna ay kailangan lang upang\N makagawa ng mga tagapagmana.
Dialogue: 0,0:26:00.11,0:26:02.41,Default,bir,0,0,0,,Kung magiging reyna ka,
Dialogue: 0,0:26:02.41,0:26:04.25,Default,bir,0,0,0,,anong uri ng kapangyarihan sa tingin mo ang magkakaroon ka
Dialogue: 0,0:26:05.35,0:26:08.12,Default,bir,0,0,0,,parang simpleng babae?
Dialogue: 0,0:26:53.50,0:26:55.53,Default,bir,0,0,0,,Hindi lang ito dahil sa mga salita ni Kim Jwageun.
Dialogue: 0,0:26:57.47,0:26:59.77,Default,bir,0,0,0,,Kahit na manatili sa palasyo sa maikling panahon,
Dialogue: 0,0:27:00.97,0:27:03.68,Default,bir,0,0,0,,Sapat na ang naranasan ko para matanto ang realidad.
Dialogue: 0,0:27:10.08,0:27:11.88,Default,bir,0,0,0,,Ang buong palasyo
Dialogue: 0,0:27:13.82,0:27:15.75,Default,bir,0,0,0,,pinatay si Kim So-yeon.
Dialogue: 0,0:27:22.92,0:27:24.02,Default,bir,0,0,0,,Kamahalan.
Dialogue: 0,0:27:25.99,0:27:27.06,Default,bir,0,0,0,,Kamahalan.
Dialogue: 0,0:27:28.59,0:27:29.59,Default,bir,0,0,0,,Kamahalan.
Dialogue: 0,0:27:33.53,0:27:35.63,Default,bir,0,0,0,,Kamahalan, Kamahalan!
Dialogue: 0,0:27:37.17,0:27:39.57,Default,bir,0,0,0,,Reyna, anong ginagawa mo dito ng sobrang late?
Dialogue: 0,0:27:41.67,0:27:44.91,Default,bir,0,0,0,,Bakit basang-basa ka?
Dialogue: 0,0:27:45.98,0:27:49.41,Default,bir,0,0,0,,Talaga bang nahulog na naman sila sa lawa?
Dialogue: 0,0:27:52.08,0:27:53.65,Default,bir,0,0,0,,Bakit mo patuloy na ginagawa ito?
Dialogue: 0,0:27:54.32,0:27:56.89,Default,bir,0,0,0,,Ngayon kailangan mong tipunin ang iyong lakas.
Dialogue: 0,0:27:56.89,0:28:00.59,Default,bir,0,0,0,,Kung hindi, bakit ako nagsikap hanggang ngayon?
Dialogue: 0,0:28:01.43,0:28:05.36,Default,bir,0,0,0,,Bakit kailangan kong dumaan sa ganitong kahihiyan?
Dialogue: 0,0:28:05.36,0:28:07.23,Default,bir,0,0,0,,Bakit mo ito kailangan?
Dialogue: 0,0:28:08.23,0:28:10.60,Default,bir,0,0,0,,Para sa kanilang sariling kita,\N upang punan ang kanilang mga imbakan.
Dialogue: 0,0:28:11.64,0:28:14.51,Default,bir,0,0,0,,Ibinenta mo ang iyong anak dahil sa kasakiman.
Dialogue: 0,0:28:15.17,0:28:17.41,Default,bir,0,0,0,,-Soyeon.\N-Bakit lagi nila akong tinatanong
Dialogue: 0,0:28:17.41,0:28:19.71,Default,bir,0,0,0,,para maging reyna, ang puri ng pamilya?
Dialogue: 0,0:28:20.18,0:28:23.11,Default,bir,0,0,0,,Bakit sinabi nila na kapag naging reyna ako, magagawa ko ang lahat ng gusto ko?
Dialogue: 0,0:28:23.85,0:28:26.99,Default,bir,0,0,0,,Bakit ako, magdurusa sa pagkakasala sa pagkamatay ng aking ina,
Dialogue: 0,0:28:26.99,0:28:29.99,Default,bir,0,0,0,,naging inspirasyon mo ba ang iyong mga pangarap?
Dialogue: 0,0:28:31.72,0:28:35.09,Default,bir,0,0,0,,Alam mo ba kung ano ang iniisip ko noong tumalon ako sa lawa?
Dialogue: 0,0:28:35.89,0:28:38.73,Default,bir,0,0,0,,Ang buhay na akala ko ay akin ay isang kasinungalingan.
Dialogue: 0,0:28:40.10,0:28:42.57,Default,bir,0,0,0,,Kahit ang mga panaginip ay hindi akin.
Dialogue: 0,0:28:43.74,0:28:45.80,Default,bir,0,0,0,,Talo na ako.
Dialogue: 0,0:28:48.51,0:28:50.68,Default,bir,0,0,0,,Kaya ako tumakas.
Dialogue: 0,0:28:52.91,0:28:53.95,Default,bir,0,0,0,,Ano?
Dialogue: 0,0:28:56.35,0:28:58.15,Default,bir,0,0,0,,Sa araw na nagkatotoo ang iyong pangarap,
Dialogue: 0,0:28:59.35,0:29:01.95,Default,bir,0,0,0,,Nawalan ako ng pinakamamahal na tao.
Dialogue: 0,0:29:03.19,0:29:04.96,Default,bir,0,0,0,,Sa aking sarili.
Dialogue: 0,0:29:05.76,0:29:08.59,Default,bir,0,0,0,,Ikaw ang nagtulak sa akin sa lawa na ito.
Dialogue: 0,0:29:33.69,0:29:36.19,Default,bir,0,0,0,,Maginhawa para sa mga bata na sisihin ang kanilang mga magulang sa lahat ng bagay.
Dialogue: 0,0:29:37.32,0:29:39.22,Default,bir,0,0,0,,Hindi mo dapat sinisi ang iyong ama.
Dialogue: 0,0:29:53.64,0:29:54.71,Default,bir,0,0,0,,Kamahalan.
Dialogue: 0,0:30:04.38,0:30:06.12,Default,bir,0,0,0,,May sasabihin ako.
Dialogue: 0,0:30:08.12,0:30:10.46,Default,bir,0,0,0,,Alam kong gagawin mo ang lahat para sa akin.
Dialogue: 0,0:30:11.26,0:30:14.03,Default,bir,0,0,0,,Ibig sabihin, nalaman ko.
Dialogue: 0,0:30:14.03,0:30:15.53,Default,bir,0,0,0,,Bumalik ang alaala ko.
Dialogue: 0,0:30:23.10,0:30:24.67,Default,bir,0,0,0,,Wala nang ibang gagawin.
Dialogue: 0,0:30:25.24,0:30:28.74,Default,bir,0,0,0,,Kung nag-aalala ka sa akin, huwag kang gumawa ng anuman.
Dialogue: 0,0:30:29.81,0:30:31.34,Default,bir,0,0,0,,Ito lang ang makakatulong sa akin.
Dialogue: 0,0:30:33.21,0:30:34.28,Default,bir,0,0,0,,Soyeon.
Dialogue: 0,0:30:36.21,0:30:37.72,Default,bir,0,0,0,,Huwag mo akong tawagin sa pangalan.
Dialogue: 0,0:30:38.85,0:30:40.19,Default,bir,0,0,0,,ako lang
Dialogue: 0,0:30:41.22,0:30:43.62,Default,bir,0,0,0,,ang reyna, na pinaglilingkuran ng Detective Department.
Dialogue: 0,0:30:58.30,0:31:00.74,Default,bir,0,0,0,,Queen's Dictionary
Dialogue: 0,0:31:12.72,0:31:14.65,Default,bir,0,0,0,,arrow, lotto, special forces, kitchen police, ramen
Dialogue: 0,0:31:14.65,0:31:16.12,Default,bir,0,0,0,,Social distancing
Dialogue: 0,0:31:25.13,0:31:27.27,Default,bir,0,0,0,,nangangahulugang bawat tao para sa kanyang sarili.
Dialogue: 0,0:31:27.27,0:31:29.37,Default,beer,0,0,0,,showdown, jasmine tea, masamang ugali.
Dialogue: 0,0:31:49.69,0:31:52.09,Default,bir,0,0,0,,Sasabihin ko ang totoo, dahil hindi mo ako naririnig.
Dialogue: 0,0:31:54.69,0:31:56.66,Default,bir,0,0,0,,Nagpasya akong mabuhay ng mahabang buhay.
Dialogue: 0,0:32:00.90,0:32:02.37,Default,bir,0,0,0,,Ipagkakanulo kita.
Dialogue: 0,0:32:04.17,0:32:06.37,Default,bir,0,0,0,,Pinipili ko ang landas na magliligtas sa aking buhay.
Dialogue: 0,0:32:08.81,0:32:10.14,Default,bir,0,0,0,,At huwag kang mamatay.
Dialogue: 0,0:32:11.14,0:32:12.91,Default,bir,0,0,0,,Recover na parang walang nangyari.
Dialogue: 0,0:32:15.91,0:32:17.38,Default,bir,0,0,0,,At pagkatapos ay maaari kitang saksakin sa likod.
Dialogue: 0,0:32:56.52,0:32:57.89,Default,bir,0,0,0,,Tama ka.
Dialogue: 0,0:32:58.76,0:33:01.09,Default,bir,0,0,0,,Mas malakas ang hari kaysa sa ipinakita niya.
Dialogue: 0,0:33:02.09,0:33:03.39,Default,bir,0,0,0,,Paumanhin tungkol doon.
Dialogue: 0,0:33:03.39,0:33:05.93,Default,bir,0,0,0,,Ano sa palagay mo ang kaso ngayon?
Dialogue: 0,0:33:06.73,0:33:08.90,Default,bir,0,0,0,,Nakakita kami ng pulbura sa lugar ng pagsabog.
Dialogue: 0,0:33:09.07,0:33:10.70,Default,bir,0,0,0,,-Gunpowder?\N-Oo.
Dialogue: 0,0:33:11.24,0:33:13.34,Default,bir,0,0,0,,May dalawang uri ng pulbura sa Joseon.
Dialogue: 0,0:33:13.54,0:33:15.57,Default,bir,0,0,0,,Ang inihatid mula sa Qing Empire.
Dialogue: 0,0:33:16.01,0:33:18.21,Default,bir,0,0,0,,At lokal mula sa bodega ng pulbura.
Dialogue: 0,0:33:18.58,0:33:20.51,Default,bir,0,0,0,,Mayroon silang kaunting pagkakaiba sa istraktura.
Dialogue: 0,0:33:20.75,0:33:24.12,Default,bir,0,0,0,,Ang nakita namin ay lokal.
Dialogue: 0,0:33:24.32,0:33:27.35,Default,zina,0,0,0,,Ang powder magazine ay bahagi ng weapons room.
Dialogue: 0,0:33:28.69,0:33:31.46,Default,zina,0,0,0,,At ang ministro ng digmaan ang namamahala sa silid ng armas.
Dialogue: 0,0:33:32.36,0:33:34.16,Default,zina,0,0,0,,Siya ang kanang kamay ng aking ama.
Dialogue: 0,0:33:36.19,0:33:37.46,Default,zina,0,0,0,,Ibig sabihin...
Dialogue: 0,0:33:42.47,0:33:45.54,Default,zina,0,0,0,,Ang aking ama ang nagdala sa hari sa trono.
Dialogue: 0,0:33:46.37,0:33:47.97,Default,zina,0,0,0,,Ipinakita ng hari ang kanyang tunay na mukha,
Dialogue: 0,0:33:47.97,0:33:49.94,Default,zina,0,0,0,,gusto siyang alisin ng ama bago pa ito maging pagkakamali niya,
Dialogue: 0,0:33:49.94,0:33:52.74,Default,zina,0,0,0,,at gawing guilty sa pagsabog ang mga guwardiya na may pekeng pagkakakilanlan.
Dialogue: 0,0:33:53.04,0:33:54.81,Default,zina,0,0,0,,Ito siguro ang plano niya.
Dialogue: 0,0:33:54.81,0:33:58.22,Default,zina,0,0,0,,Nang lumapit ka sa akin sa huling pagkakataon,\N may gusto ka.
Dialogue: 0,0:34:00.05,0:34:01.72,Default,zina,0,0,0,,So ano ang gusto mo?
Dialogue: 0,0:34:02.22,0:34:04.09,Default,zina,0,0,0,,Gusto ko
Dialogue: 0,0:34:07.46,0:34:08.76,Default,zina,0,0,0,,king.
Dialogue: 0,0:34:17.84,0:34:19.64,Default,zina,0,0,0,,Hindi ko mapigilan ngayon.
Dialogue: 0,0:34:20.87,0:34:22.81,Default,zina,0,0,0,,At kung iyan ang nararamdaman mo, Soyeon,
Dialogue: 0,0:34:24.18,0:34:25.28,Default,zina,0,0,0,,ito ay isa pang dahilan.
Dialogue: 0,0:34:47.07,0:34:50.23,Default,zina,0,0,0,,Pumunta ako dito para sabihin sa iyo ang tungkol sa kung ano ang ginawa ng reyna kahapon.
Dialogue: 0,0:34:51.50,0:34:55.11,Default,zina,0,0,0,,Nagligtas siya ng isang piging na malapit nang mabigo.
Dialogue: 0,0:34:55.81,0:34:58.41,Default,zina,0,0,0,,Sa tingin mo ba maniniwala ako sa iyo?
Dialogue: 0,0:34:58.91,0:35:01.05,Default,zina,0,0,0,,Malamang iniisip mo,
Dialogue: 0,0:35:01.05,0:35:03.18,Default,zina,0,0,0,,ako ang naging sanhi ng insidente sa hari.
Dialogue: 0,0:35:03.18,0:35:05.25,Default,zina,0,0,0,,Kung susuriin mo, madali mong mahahanap ang sagot.
Dialogue: 0,0:35:05.88,0:35:09.12,Default,zina,0,0,0,,Sa pagkakaintindi ko, gusto mong sirain ang kapistahan.
Dialogue: 0,0:35:09.45,0:35:11.52,Default,zina,0,0,0,,Kahit na ang reyna ay bawian ng kanyang titulo...
Dialogue: 0,0:35:11.52,0:35:13.46,Default,zina,0,0,0,,Hindi ko kailangan ng anumang mga pamagat.
Dialogue: 0,0:35:14.03,0:35:18.00,Default,zina,0,0,0,,Gusto ko lang mawala ang reyna sa paningin ng hari.
Dialogue: 0,0:35:19.33,0:35:20.60,Default,zina,0,0,0,,Ibig sabihin,
Dialogue: 0,0:35:21.90,0:35:24.27,Default,zina,0,0,0,,na gusto ng hari ang reyna.
Dialogue: 0,0:36:36.94,0:36:39.48,Default,zina,0,0,0,,Sa hitsura nito, nahirapan ka.
Dialogue: 0,0:36:40.51,0:36:42.81,Default,zina,0,0,0,,Nababahala ka ba sa hari?
Dialogue: 0,0:36:44.32,0:36:45.35,Default,zina,0,0,0,,Oh aking Diyos.
Dialogue: 0,0:36:46.38,0:36:48.22,Default,zina,0,0,0,,Kanina lang siya naging manugang mo.
Dialogue: 0,0:36:48.62,0:36:50.46,Default,zina,0,0,0,,Mukhang naging attached ka na sa kanya.
Dialogue: 0,0:36:50.66,0:36:51.72,Default,zina,0,0,0,,Well,
Dialogue: 0,0:36:54.13,0:36:55.23,Default,zina,0,0,0,,to be honest,
Dialogue: 0,0:36:55.96,0:36:59.26,Default,zina,0,0,0,,May ginawa akong isang bagay na makakasira sa aming pamilya.
Dialogue: 0,0:37:00.63,0:37:03.47,Default,zina,0,0,0,,Iningatan ko ang mga rekord ng ilegal na nakuhang ari-arian ng aming pamilya.
Dialogue: 0,0:37:05.10,0:37:06.64,Default,zina,0,0,0,,At nawala sila.
Dialogue: 0,0:37:07.27,0:37:08.34,Default,zina,0,0,0,,Ano?
Dialogue: 0,0:37:08.34,0:37:10.14,Default,zina,0,0,0,,Nalaman ko kung nasaan na ang libro.
Dialogue: 0,0:37:10.51,0:37:12.71,Default,zina,0,0,0,,Kailangan ko lang siyang hanapin at palayasin.
Dialogue: 0,0:37:13.61,0:37:16.61,Default,zina,0,0,0,,Ngunit hinihiling ko sa iyo na iligtas ang reyna.
Dialogue: 0,0:37:17.92,0:37:20.28,Default,zina,0,0,0,,Bakit mo biglang nabanggit?
Dialogue: 0,0:37:20.28,0:37:21.62,Default,zina,0,0,0,,Ang taong may libro na,
Dialogue: 0,0:37:23.22,0:37:24.49,Default,zina,0,0,0,,ito ang hari.
Dialogue: 0,0:37:26.42,0:37:29.33,Default,zina,0,0,0,,Walang kinalaman ang Reyna sa sitwasyong ito.
Dialogue: 0,0:37:29.69,0:37:33.06,Default,zina,0,0,0,,Iniligaw siya at ako ng hari.
Dialogue: 0,0:37:35.97,0:37:38.54,Default,zina,0,0,0,,Oo, niligaw niya ang lahat.
Dialogue: 0,0:37:38.77,0:37:42.01,Default,zina,0,0,0,,Tatanggapin ko ang alinman sa iyong parusa.
Dialogue: 0,0:37:43.11,0:37:44.18,Default,zina,0,0,0,,Ngunit
Dialogue: 0,0:37:46.31,0:37:47.65,Default,zina,0,0,0,,maawa ka kay Soyeon.
Dialogue: 0,0:37:49.11,0:37:51.02,Default,zina,0,0,0,,Iligtas ang reyna.
Dialogue: 0,0:37:52.12,0:37:54.99,Default,zina,0,0,0,,Nakikiusap ako, iligtas mo ang reyna.
Dialogue: 0,0:37:59.06,0:38:00.12,Default,zina,0,0,0,,Ama.
Dialogue: 0,0:38:05.33,0:38:07.53,Default,zina,0,0,0,,Natulog ka ba sa Detective Department?
Dialogue: 0,0:38:07.53,0:38:11.14,Default,zina,0,0,0,,Oo. Malaking bagay ito, marami pa akong gagawin.
Dialogue: 0,0:38:11.74,0:38:15.44,Default,zina,0,0,0,,Lahat sa kaso ay tumuturo sa akin bilang isang kriminal.
Dialogue: 0,0:38:16.11,0:38:18.24,Default,zina,0,0,0,,Ngunit hindi mo ito pinag-usapan.
Dialogue: 0,0:38:19.04,0:38:20.31,Default,zina,0,0,0,,Huwag mag-alala.
Dialogue: 0,0:38:21.15,0:38:23.55,Default,zina,0,0,0,,Nagsagawa ng imbestigasyon ang departamento ng tiktik.
Dialogue: 0,0:38:23.55,0:38:25.22,Default,zina,0,0,0,,Kung siniraan ka,
Dialogue: 0,0:38:25.58,0:38:27.99,Default,zina,0,0,0,,Ibubunyag ko ang tunay na salarin ng insidenteng ito.
Dialogue: 0,0:38:28.62,0:38:30.02,Default,zina,0,0,0,,Ito ay pagpapatahimik.
Dialogue: 0,0:38:31.72,0:38:33.16,Default,zina,0,0,0,,Kamakailan
Dialogue: 0,0:38:33.46,0:38:37.20,Default,zina,0,0,0,,sabi mo napagdesisyunan mo\N ang laki ng pangarap mo.
Dialogue: 0,0:38:38.46,0:38:41.00,Default,zina,0,0,0,,So gaano kalaki ang pangarap mo?
Dialogue: 0,0:38:43.27,0:38:44.87,Default,zina,0,0,0,,Ang pangarap ko -
Dialogue: 0,0:38:46.34,0:38:48.94,Default,zina,0,0,0,,maging kahit kalahati ng tagumpay mo.
Dialogue: 0,0:38:55.38,0:38:57.58,Default,zina,0,0,0,,Huli na. Pahinga.
Dialogue: 0,0:39:20.91,0:39:21.97,Default,zina,0,0,0,,Huwag kang lalapit.
Dialogue: 0,0:39:22.51,0:39:24.04,Default,zina,0,0,0,,Kung susundin mo ako, papatayin ko ang sarili ko.
Dialogue: 0,0:39:28.65,0:39:29.68,Default,zina,0,0,0,,Soyeon.
Dialogue: 0,0:39:41.59,0:39:46.46,Default,zina,0,0,0,,Alam ko kung ano ang nag-uudyok sa iyo.
Dialogue: 0,0:40:14.83,0:40:18.06,Default,zina,0,0,0,,So nasaan ang reyna ng madaling araw?
Dialogue: 0,0:40:18.30,0:40:19.83,Default,zina,0,0,0,,Nasa royal kitchen siya.
Dialogue: 0,0:40:20.33,0:40:21.43,Default,zina,0,0,0,,Ngayon.
Dialogue: 0,0:40:22.60,0:40:23.60,Default,zina,0,0,0,,Wala.
Dialogue: 0,0:40:24.34,0:40:27.20,Default,zina,0,0,0,,Gusto kong ipaghanda niya ako ng almusal paggising niya.
Dialogue: 0,0:40:27.47,0:40:30.21,Default,zina,0,0,0,,At nagluluto na siya para sa kanyang lola, ganyan.
Dialogue: 0,0:40:51.50,0:40:52.70,Default,zina,0,0,0,,Natakot ako.
Dialogue: 0,0:40:52.93,0:40:55.67,Default,zina,0,0,0,,Masyado pang maaga. Anong niluluto mo?
Dialogue: 0,0:40:55.90,0:40:58.50,Default,zina,0,0,0,,Lately depressed ako.\N At hindi ako makatulog.
Dialogue: 0,0:40:58.67,0:41:00.64,Default,zina,0,0,0,,Para bang sinasabi ko ang aking panalangin sa umaga,
Dialogue: 0,0:41:00.64,0:41:02.27,Default,zina,0,0,0,,Gumagawa ako ng nakakainis na ulam,
Dialogue: 0,0:41:02.27,0:41:04.61,Default,zin,0,0,0,,na kailangang durugin at ihalo nang isang milyong beses.
Dialogue: 0,0:41:05.68,0:41:08.11,Default,zina,0,0,0,,Ngunit kakaiba ang hitsura ng sinigang na kanin.
Dialogue: 0,0:41:08.11,0:41:10.92,Default,zina,0,0,0,,Hindi ito sinigang. Ito ay potahe.
Dialogue: 0,0:41:11.28,0:41:12.85,Default,zina,0,0,0,,Tongue slurred? Maaga pa naman.
Dialogue: 0,0:41:12.85,0:41:15.15,Default,zina,0,0,0,,Ito ay nangangahulugang "carrot porridge."
Dialogue: 0,0:41:15.42,0:41:18.22,Default,zina,0,0,0,,Teka, kailangan ko itong isulat.
Dialogue: 0,0:41:19.79,0:41:20.93,Default,zina,0,0,0,,At paano ito gagawin?
Dialogue: 0,0:41:21.03,0:41:25.26,Default,zina,0,0,0,,Kailangan mong i-chop ang mga sibuyas at karot at lutuin ng isang oras sa tubig.
Dialogue: 0,0:41:25.26,0:41:26.93,Default,zina,0,0,0,,Pagkatapos ay gilingin sa isang mortar.
Dialogue: 0,0:41:26.93,0:41:29.23,Default,zina,0,0,0,,Para bang dinudurog mo ang lahat ng\N karanasan at ilusyon.
Dialogue: 0,0:41:29.77,0:41:33.47,Default,zina,0,0,0,,Pagkatapos ay haluin sa mahinang apoy upang hindi ito masunog at walang mga clots.
Dialogue: 0,0:41:33.47,0:41:35.14,Default,zina,0,0,0,,Na may pakiramdam ng pagpapabuti sa sarili.
Dialogue: 0,0:41:35.91,0:41:38.11,Default,zina,0,0,0,,Timplahan ng asin
Dialogue: 0,0:41:40.14,0:41:41.98,Default,zina,0,0,0,,at magdagdag ng kaunting gatas.
Dialogue: 0,0:41:41.98,0:41:43.41,Default,zina,0,0,0,,Kahit gatas?
Dialogue: 0,0:41:43.51,0:41:45.02,Default,zina,0,0,0,,Yun lang?
Dialogue: 0,0:41:45.22,0:41:46.32,Default,zina,0,0,0,,Hindi.
Dialogue: 0,0:41:46.78,0:41:50.82,Default,zina,0,0,0,,Kailangan mong maghanda ng gulay na sopas nang maaga.
Dialogue: 0,0:41:51.19,0:41:52.59,Default,zina,0,0,0,,Kunin ang sabaw
Dialogue: 0,0:41:53.56,0:41:56.53,Default,zina,0,0,0,,at magdagdag ng kaunti sa lugaw para sa masarap na lasa.
Dialogue: 0,0:41:56.66,0:41:59.16,Default,zina,0,0,0,,Kailangan mong maguluhan para lang magdagdag ng kaunti?
Dialogue: 0,0:41:59.16,0:42:02.10,Default,zina,0,0,0,,Sinabi na sa iyo. Parang morning prayer.
Dialogue: 0,0:42:04.90,0:42:07.14,Default,zina,0,0,0,,Inilagay mo ang iyong puso at kaluluwa dito.
Dialogue: 0,0:42:07.14,0:42:10.74,Default,zina,0,0,0,,Sigurado akong magkakamalay kaagad ang hari sa sandaling subukan niya.
Dialogue: 0,0:42:11.84,0:42:12.88,Default,zina,0,0,0,,Hindi ito para sa kanya.
Dialogue: 0,0:42:16.01,0:42:18.88,Default,zina,0,0,0,,Ano ang pagdurusa nang dalawang beses, aalamin ko ito sa isang iglap.
Dialogue: 0,0:42:19.25,0:42:21.69,Default,zina,0,0,0,,Dahil may sinabi ako sa kanya noong nakaraan,
Dialogue: 0,0:42:21.72,0:42:25.36,Default,zina,0,0,0,,pinipilit akong kumain kasama ang aking biyenan?
Dialogue: 0,0:42:26.19,0:42:30.09,Default,zina,0,0,0,,Naglakas-loob siyang sabihin sa kanyang naliligaw na bibig na ako ay matanda na,
Dialogue: 0,0:42:30.36,0:42:32.26,Default,zina,0,0,0,,Tingnan ko ba siya sa umaga?
Dialogue: 0,0:42:38.64,0:42:40.27,Default,zina,0,0,0,,Ano ito?
Dialogue: 0,0:42:40.27,0:42:41.84,Default,zina,0,0,0,,Ito ay brunch.
Dialogue: 0,0:42:42.41,0:42:43.81,Default,zina,0,0,0,,Brunch?
Dialogue: 0,0:42:43.97,0:42:46.14,Default,zina,0,0,0,,Nangangahulugan ng "kababaihang nagkikita."
Dialogue: 0,0:42:46.38,0:42:48.55,Default,zina,0,0,0,,Ito ang oras kung kailan nagtitipon ang mga babae para sa almusal
Dialogue: 0,0:42:48.55,0:42:50.65,Default,zina,0,0,0,,at maging mas malapit sa isa't isa.
Dialogue: 0,0:42:50.95,0:42:53.75,Default,zina,0,0,0,,Alam ng lahat kung ano ito.
Dialogue: 0,0:42:53.75,0:42:55.52,Default,zina,0,0,0,,Parang hindi ka taga-Gojoseon.
Dialogue: 0,0:42:55.59,0:42:56.69,Default,zina,0,0,0,,Asshole.
Dialogue: 0,0:42:57.86,0:43:00.79,Default,zina,0,0,0,,Madalas kong ginagawa ito sa bahay.
Dialogue: 0,0:43:01.19,0:43:02.46,Default,zina,0,0,0,,Matagal na ang nakalipas.
Dialogue: 0,0:43:03.36,0:43:04.63,Default,zina,0,0,0,,Asshole.
Dialogue: 0,0:43:07.47,0:43:09.57,Default,zina,0,0,0,,Ito ay sinigang na karot.
Dialogue: 0,0:43:09.83,0:43:12.37,Default,zina,0,0,0,,Naglalaman ito ng maraming produkto na\N ay makakatulong sa pagpapabuti ng paningin.
Dialogue: 0,0:43:12.37,0:43:13.44,Default,zina,0,0,0,,Oo?
Dialogue: 0,0:43:14.14,0:43:15.81,Default,zina,0,0,0,,Inang Reyna, kumain ka pa.
Dialogue: 0,0:43:15.81,0:43:18.18,Default,zina,0,0,0,,Mukhang naging bulag ka kamakailan.
Dialogue: 0,0:43:18.18,0:43:22.21,Default,zina,0,0,0,,Kung ganoon ang kaso, sa tingin ko kailangan ng reyna na kainin ang lahat.
Dialogue: 0,0:43:23.45,0:43:25.08,Default,zina,0,0,0,,What the? Bakit ba ang yabang nila?
Dialogue: 0,0:43:33.46,0:43:34.89,Default,zina,0,0,0,,Napakasarap.
Dialogue: 0,0:43:41.23,0:43:42.73,Default,zina,0,0,0,,Edible.
Dialogue: 0,0:43:44.17,0:43:45.70,Default,zina,0,0,0,,Mula ngayon
Dialogue: 0,0:43:45.70,0:43:48.24,Default,zina,0,0,0,,Sisiguraduhin kong\Nmas madalas tayong magkasama.
Dialogue: 0,0:43:48.24,0:43:50.41,Default,zina,0,0,0,,-Bastard.\N-What a bastard.
Dialogue: 0,0:43:50.47,0:43:52.48,Default,zina,0,0,0,,Pagkatapos ay humihingi ako ng paumanhin.
Dialogue: 0,0:43:54.61,0:43:56.28,Default,zina,0,0,0,,dalhan kita ng inumin.
Dialogue: 0,0:44:05.16,0:44:09.53,Default,zina,0,0,0,,Medyo exaggerated ang mga tsismis tungkol sa culinary skills ng reyna.
Dialogue: 0,0:44:09.83,0:44:12.93,Default,zina,0,0,0,,Ang kakayahang makilala ang masarap na pagkain ay bahagi ng maharlika.
Dialogue: 0,0:44:13.53,0:44:18.10,Default,zina,0,0,0,,Hinahayaan mo bang makatakas ang reyna sa lahat\N para lang sa talentong ito?
Dialogue: 0,0:44:18.10,0:44:21.01,Default,zina,0,0,0,,Dahil ikaw ang naghatid sa akin ng mga salita ng reyna,
Dialogue: 0,0:44:21.57,0:44:23.27,Default,zina,0,0,0,,Hindi ako makapaniwala.
Dialogue: 0,0:44:24.68,0:44:28.75,Default,zina,0,0,0,,Siyempre hindi ka maniniwala sa sasabihin ko.
Dialogue: 0,0:44:29.05,0:44:31.72,Default,zina,0,0,0,,Narinig ko ang hari at reyna
Dialogue: 0,0:44:32.42,0:44:35.22,Default,zina,0,0,0,,palihim kaming nagpalitan ng notes buong gabi.
Dialogue: 0,0:44:35.62,0:44:39.09,Default,zina,0,0,0,,I wonder kung ano ang isinulat nila sa isa't isa?
Dialogue: 0,0:44:40.89,0:44:43.86,Default,zina,0,0,0,,Dadalhin ko ang mga inumin mo.
Dialogue: 0,0:44:52.77,0:44:54.51,Default,zina,0,0,0,,Ito ay inuming gawa sa alak at iba't ibang prutas,
Dialogue: 0,0:44:54.51,0:44:57.68,Default,zina,0,0,0,,pinakuluang may anise at cinnamon.
Dialogue: 0,0:44:58.58,0:45:00.38,Default,zina,0,0,0,,Alak sa umaga?
Dialogue: 0,0:45:00.41,0:45:02.01,Default,zina,0,0,0,,Lahat ng alak ay sumingaw,
Dialogue: 0,0:45:02.01,0:45:04.85,Default,zina,0,0,0,,may mga natitirang produkto na lang na nakakatulong sa pagpapanatili ng kabataan.
Dialogue: 0,0:45:05.45,0:45:09.02,Default,zina,0,0,0,,Ito ay higit na gamot kaysa inumin.
Dialogue: 0,0:45:16.99,0:45:19.13,Default,zina,0,0,0,,Hindi ako makapaniwala na naisipan mong gumawa ng alak.
Dialogue: 0,0:45:19.60,0:45:22.50,Default,zina,0,0,0,,Paano mo naisip ang ideyang ito?
Dialogue: 0,0:45:22.83,0:45:27.07,Default,zina,0,0,0,,Saan ka kumukuha ng inspirasyon para sa iyong mga pagkain?
Dialogue: 0,0:45:27.07,0:45:31.38,Default,zina,0,0,0,,Hindi ko alam kung inspirasyon o paglikha ang tatawagin ko.
Dialogue: 0,0:45:31.38,0:45:34.45,Default,zina,0,0,0,,Kapag nakita ko ang mga sangkap, iniisip ko agad
Dialogue: 0,0:45:34.45,0:45:36.01,Default,zina,0,0,0,,kung paano panatilihin ang kanilang orihinal na lasa.
Dialogue: 0,0:45:36.45,0:45:38.88,Default,zina,0,0,0,,Sa mga panahong ito ay maingat sila sa Kanluran,
Dialogue: 0,0:45:38.88,0:45:40.65,Default,zina,0,0,0,,kaya hindi ko sasabihin na French cuisine ito.
Dialogue: 0,0:45:46.92,0:45:47.93,Default,shooting,0,0,0,,Mrs.
Dialogue: 0,0:45:53.90,0:45:55.43,Default,shooting,0,0,0,,Hello, sir.
Dialogue: 0,0:45:56.90,0:45:59.74,Default,shooting,0,0,0,,Hinihintay kitang magsalita.
Dialogue: 0,0:45:59.74,0:46:02.74,Default,shooting,0,0,0,,Ano? Ano ang gusto mong pag-usapan?
Dialogue: 0,0:46:02.74,0:46:05.01,Default,shooting,0,0,0,,Pagkatapos ng insidente sa hari
Dialogue: 0,0:46:05.74,0:46:07.54,Default,shooting,0,0,0,,Nadaig ako ng iba't ibang pag-iisip.
Dialogue: 0,0:46:09.15,0:46:11.32,Default,shooting,0,0,0,,Walang nakakaalam kung ano ang susunod na mangyayari,
Dialogue: 0,0:46:11.88,0:46:14.75,Default,shooting,0,0,0,,at maaaring huli na ang bukas.
Dialogue: 0,0:46:14.95,0:46:18.12,Default,shooting,0,0,0,,Kung magtatapos ang buhay ko bukas,
Dialogue: 0,0:46:19.36,0:46:21.63,Default,shooting,0,0,0,,ano ang higit kong pagsisisihan?
Dialogue: 0,0:46:21.89,0:46:25.13,Default,tira,0,0,0,,Tungkol sa mga damdaming hindi ko maipahayag,
Dialogue: 0,0:46:25.70,0:46:27.16,Default,shooting,0,0,0,,dahil nagduda ako.
Dialogue: 0,0:46:27.53,0:46:28.87,Default,tira,0,0,0,,Isang taos-pusong salita
Dialogue: 0,0:46:29.37,0:46:31.50,Default,shooting,0,0,0,,mas mahusay kaysa sa anumang sopistikadong pag-amin.
Dialogue: 0,0:46:33.70,0:46:34.87,Default,gitling,0,0,0,,Samakatuwid
Dialogue: 0,0:46:37.81,0:46:39.31,Default,shooting,0,0,0,,Gusto kong sabihin sa iyo,
Dialogue: 0,0:46:40.61,0:46:41.75,Default,shooting,0,0,0,,na mahal kita.
Dialogue: 0,0:46:51.49,0:46:53.06,Default,shooting,0,0,0,,Hindi kita gusto.
Dialogue: 0,0:46:53.49,0:46:54.53,Default,shooting,0,0,0,,Ano?
Dialogue: 0,0:46:55.59,0:46:56.79,Default,shooting range,0,0,0,,Tungkol sa pulbura.
Dialogue: 0,0:46:57.39,0:46:59.50,Default,shooting range,0,0,0,,Halaga ng pulbura na ginawa sa timog
Dialogue: 0,0:46:59.50,0:47:00.76,Default,shooting gallery,0,0,0,,Gyeongsang Province,
Dialogue: 0,0:47:01.10,0:47:03.73,Default,dash,0,0,0,,at iba ang dami ng dumarating sa bodega.
Dialogue: 0,0:47:05.17,0:47:06.47,Default,shooting,0,0,0,,Alam ko.
Dialogue: 0,0:47:12.11,0:47:13.94,Default,shooting,0,0,0,,Wala pa bang malay ang hari?
Dialogue: 0,0:47:14.48,0:47:15.55,Default,shooting,0,0,0,,Oo.
Dialogue: 0,0:47:16.21,0:47:19.32,Default,shooting,0,0,0,,Narinig kong nawalan siya ng pandinig. Magiging problema ito sa hinaharap.
Dialogue: 0,0:47:22.95,0:47:25.12,Default,shooting,0,0,0,,Tungkol sa pangyayaring ito sa hari.
Dialogue: 0,0:47:25.72,0:47:27.83,Default,shooting range,0,0,0,,Para sa pagsabog na ganito kalaki
Dialogue: 0,0:47:29.16,0:47:30.83,Default,shooting range,0,0,0,,gamit na pulbura?
Dialogue: 0,0:47:31.76,0:47:32.83,Default,shooting,0,0,0,,Hindi ako sigurado.
Dialogue: 0,0:47:33.26,0:47:36.93,Default,shooting,0,0,0,,Ito ay maaaring sulfur o explosive gas.
Dialogue: 0,0:47:37.63,0:47:39.57,Default,shooting,0,0,0,,Kung ito ay asupre, magkakaroon ng amoy,
Dialogue: 0,0:47:39.57,0:47:41.51,Default,shooting,0,0,0,,para mapansin siya ng hari.
Dialogue: 0,0:47:41.61,0:47:43.61,Default,shooting,0,0,0,,Kung gas, mahirap
Dialogue: 0,0:47:43.61,0:47:46.18,Default,shooting gallery,0,0,0,,pigilan itong tumulo at pumutok nang sabay-sabay.
Dialogue: 0,0:47:46.28,0:47:48.95,Default,shooting gallery,0,0,0,,Ang mga salarin ay itinatanong, ngunit hindi sila umamin.
Dialogue: 0,0:47:48.95,0:47:50.48,Default,shooting,0,0,0,,Mahirap malaman kung sino ang nasa likod nito.
Dialogue: 0,0:48:21.75,0:48:24.72,Default,tyra,0,0,0,,Kapag nakita ko ang mga sangkap, naiisip ko agad
Dialogue: 0,0:48:24.72,0:48:26.55,Default,tyra,0,0,0,,kung paano panatilihin ang kanilang orihinal na lasa.
Dialogue: 0,0:48:29.79,0:48:31.22,Default,shooting,0,0,0,,Hindi pwede.
Dialogue: 0,0:48:31.72,0:48:33.82,Default,shooting,0,0,0,,Guilty of treason
Dialogue: 0,0:48:33.82,0:48:35.89,Default,shooting gallery,0,0,0,,ipinahayag ang pinuno?
Dialogue: 0,0:48:36.69,0:48:39.96,Default,shooting range,0,0,0,,Mukhang mababa ang ranggo na mga guwardiya\N na sumasalungat sa Royal Court,
Dialogue: 0,0:48:39.96,0:48:41.93,Default,shooting gallery,0,0,0,,nagsama-sama at nagdulot ng pagsabog.
Dialogue: 0,0:48:41.97,0:48:43.07,Default,shooting,0,0,0,,Talaga?
Dialogue: 0,0:48:43.63,0:48:46.97,Default,shooting gallery,0,0,0,,Sabihin mong walang tao sa likod nila?
Dialogue: 0,0:48:47.70,0:48:50.41,Default,shooting,0,0,0,,Sa isang malaking bagay gaya ng pagpatay sa isang hari?
Dialogue: 0,0:48:50.41,0:48:51.78,Default,shooting,0,0,0,,Ito ay imposible.
Dialogue: 0,0:48:52.38,0:48:55.48,Default,shooting,0,0,0,,Dapat nating katakutan ang karamihan sa mga walang mawawala.
Dialogue: 0,0:48:55.48,0:48:57.71,Default,shooting range,0,0,0,,Marahil naniwala sila\Nna hindi sila makakataas,
Dialogue: 0,0:48:57.71,0:48:59.98,Default,shooting,0,0,0,,kaya nagpasya kaming baguhin ang sitwasyon.
Dialogue: 0,0:48:59.98,0:49:01.69,Default,shooting,0,0,0,,Marahil ito ang dahilan.
Dialogue: 0,0:49:02.82,0:49:05.79,Default,shooting,0,0,0,,Iyan ang akma. Act of treason para sa layunin ng enthronement
Dialogue: 0,0:49:05.79,0:49:08.89,Default,shooting,0,0,0,,kapatid sa ama ng hari, si Lee Wong-gyong,
Dialogue: 0,0:49:08.89,0:49:11.36,Default,shooting,0,0,0,,na ginawa rin ng mga mababang-ranggong guwardiya.
Dialogue: 0,0:49:12.36,0:49:14.20,Default,shooting,0,0,0,,Isinasaalang-alang na ang hari ay walang malay,
Dialogue: 0,0:49:14.20,0:49:16.73,Default,shooting,0,0,0,,sa mas matagal tayong maaantala dito, mas magkakaroon ng kalituhan.
Dialogue: 0,0:49:16.83,0:49:17.97,Default,gitling,0,0,0,,Samakatuwid
Dialogue: 0,0:49:18.34,0:49:21.24,Default,shooting,0,0,0,,pitong salarin ang buong responsibilidad
Dialogue: 0,0:49:23.41,0:49:26.11,Default,shooting,0,0,0,,at hahatulan ng kamatayan.
Dialogue: 0,0:49:34.45,0:49:37.72,Default,pagbaril,0,0,0,,Para sa pagtatangkang patayin ang hari\Nand na nagbabalak ng pagtataksil
Dialogue: 0,0:49:39.19,0:49:40.96,Default,shooting,0,0,0,,nasentensiyahan ka ng kamatayan.
Dialogue: 0,0:49:42.56,0:49:44.53,Default,shooting,0,0,0,,Mayroon ka bang huling salita?
Dialogue: 0,0:49:49.70,0:49:51.97,Default,shooting,0,0,0,,Kung hahatulan mo sila ng kamatayan,
Dialogue: 0,0:49:52.34,0:49:55.37,Default,shooting,0,0,0,,hindi mo malalaman kung sino ang nasa likod ng lahat ng ito.
Dialogue: 0,0:49:55.87,0:49:58.08,Default,shooting,0,0,0,,Sabi nila walang tao sa likod nito.
Dialogue: 0,0:49:58.91,0:50:00.24,Default,shooting,0,0,0,,Ito ay isang walang ingat na desisyon...
Dialogue: 0,0:50:00.24,0:50:03.65,Default,shooting,0,0,0,,Ang desisyong ito ay ginawa pagkatapos ng isang gabi ng pagsisiyasat.
Dialogue: 0,0:50:06.08,0:50:07.25,Default,gitling,0,0,0,,
Dialogue: 0,0:51:02.84,0:51:03.91,Default,shooting gallery,0,0,0,,Pugutan ng ulo.
Dialogue: 0,0:51:05.84,0:51:06.84,Default,shooting range,0,0,0,,Stop.
Dialogue: 0,0:51:14.22,0:51:16.65,Default,shooting,0,0,0,,Isinagawa ang imbestigasyon\N sa pamamagitan ng royal order.
Dialogue: 0,0:51:17.22,0:51:18.92,Default,shooting gallery,0,0,0,,Abalahin mo ba kami?
Dialogue: 0,0:51:19.12,0:51:21.39,Default,shooting gallery,0,0,0,,Bitawan kaagad ang inosente.
Dialogue: 0,0:51:23.43,0:51:25.03,Default,shooting,0,0,0,,Ito ay isang tunay na order.
Dialogue: 0,0:51:35.84,0:51:36.97,Default,shooting,0,0,0,,Sorry late ako.
Dialogue: 0,0:51:37.67,0:51:38.71,Default,shooting,0,0,0,,Ikaw...
Dialogue: 0,0:51:41.78,0:51:45.98,Default,shooting,0,0,0,,Nabalitaan kong wala kang malay.
Dialogue: 0,0:51:46.32,0:51:48.99,Default,shooting,0,0,0,,Bata ako at puno ng lakas,
Dialogue: 0,0:51:49.35,0:51:50.99,Default,shooting,0,0,0,,kaya mabilis itong nakabawi.
Dialogue: 0,0:51:55.23,0:51:57.49,Default,shooting,0,0,0,,Ayokong mahiga doon ng walang kabuluhan
Dialogue: 0,0:51:57.49,0:51:59.53,Default,shooting,0,0,0,,at makabawi sa kama.
Dialogue: 0,0:51:59.76,0:52:01.13,Default,shooting,0,0,0,,Kaya hinanap ko ang mga iyon
Dialogue: 0,0:52:01.13,0:52:03.83,Default,shooting,0,0,0,,na nagbalak na patayin ako.
Dialogue: 0,0:52:04.30,0:52:08.07,Default,shooting,0,0,0,,Una kong nalaman ang tungkol sayo.
Dialogue: 0,0:52:08.64,0:52:12.64,Default,shooting range,0,0,0,,Gusto mo bang sabihin na sinuri mo kami?
Dialogue: 0,0:52:13.21,0:52:15.28,Default,shooting,0,0,0,,May nagpaplano ng pagtataksil.
Dialogue: 0,0:52:16.25,0:52:18.32,Default,shooting,0,0,0,,Sabihin na mas mahalaga ang iyong personal na buhay,
Dialogue: 0,0:52:19.38,0:52:23.45,Default,shooting,0,0,0,,kaysa sa buhay ng isang hari?
Dialogue: 0,0:52:24.39,0:52:26.49,Default,shooting,0,0,0,,Hindi, hindi iyon totoo.
Dialogue: 0,0:52:28.33,0:52:31.16,Default,shooting,0,0,0,,Kung wala kang dapat itago, walang dapat ikatakot.
Dialogue: 0,0:52:35.00,0:52:36.33,Default,shooting range,0,0,0,,Huwag mag-alala.
Dialogue: 0,0:52:37.50,0:52:39.70,Default,shooting gallery,0,0,0,,Nahanap ko ang pinuno.
Dialogue: 0,0:52:40.94,0:52:42.57,Default,shooting,0,0,0,,-Ano ang sinasabi niya?\N-Ano ang nangyayari?
Dialogue: 0,0:52:48.01,0:52:50.51,Default,tyra,0,0,0,,Sa bakhurnitsa na ginamit sa seremonya,
Dialogue: 0,0:52:51.11,0:52:53.55,Default,shooting range,0,0,0,,may nakitang pulbura, sa maraming dami.
Dialogue: 0,0:52:53.82,0:52:56.39,Default,shooting range,0,0,0,,-Gunpowder?\N-Gunpowder?
Dialogue: 0,0:52:59.26,0:53:00.32,Default,shooting range,0,0,0,,Malaking dami?
Dialogue: 0,0:53:06.16,0:53:08.63,Default,shooting gallery,0,0,0,,Ang Mellow ay magiging isang malaking bomba.
Dialogue: 0,0:53:09.03,0:53:11.67,Default,shooting gallery,0,0,0,,-Masyadong mapanganib ito.\N-Napagdesisyunan na ang lahat.
Dialogue: 0,0:53:12.10,0:53:14.04,Default,shooting,0,0,0,,Pagsubaybay sa pinagmulan ng pulbura,
Dialogue: 0,0:53:14.67,0:53:16.31,Default,shooting,0,0,0,,Nakatanggap ako ng impormasyon,
Dialogue: 0,0:53:16.31,0:53:19.88,Default,shooting,0,0,0,,na ang pulbura\N na ito ay hindi opisyal na ipinagpalit sa daungan ng Tonne.
Dialogue: 0,0:53:26.05,0:53:29.25,Default,shooting range,0,0,0,,Nga pala, bakit kailangan mo ng napakaraming pulbura?
Dialogue: 0,0:53:29.45,0:53:33.22,Default,shooting,0,0,0,,Upang atakihin muli si Joseon mamaya.
Dialogue: 0,0:53:36.86,0:53:38.13,Default,shooting,0,0,0,,Salamat.
Dialogue: 0,0:53:38.93,0:53:40.73,Default,shooting,0,0,0,,-Salamat?\N-Salamat.
Dialogue: 0,0:53:42.53,0:53:44.73,Default,shooting,0,0,0,,-Salamat.\N-Salamat.
Dialogue: 0,0:53:45.57,0:53:47.87,Default,shooting,0,0,0,,Salamat.
Dialogue: 0,0:53:48.54,0:53:51.21,Default,shooting range,0,0,0,,Saan nanggaling ang pulbura na ito?
Dialogue: 0,0:53:51.54,0:53:53.41,Default,shooting,0,0,0,,Ginagawa lamang ito para sa mga layuning militar.
Dialogue: 0,0:53:53.41,0:53:56.18,Default,shooting,0,0,0,,Hindi ito maaaring gawin sa anumang paraan para sa personal na paggamit,
Dialogue: 0,0:53:56.55,0:53:58.68,Default,shooting,0,0,0,,pagkatapos ng lahat, ito ay isang mapanganib at mahalagang produkto.
Dialogue: 0,0:54:00.22,0:54:04.29,Default,shooting range,0,0,0,,So, tiningnan ko lahat ng lugar kung saan ginagawa ang pulbura sa Joseon.
Dialogue: 0,0:54:04.96,0:54:06.72,Default,shooting,0,0,0,,At may natuklasan akong kakaiba.
Dialogue: 0,0:54:08.33,0:54:10.86,Default,shooting,0,0,0,,Sa ilang lugar sa production area
Dialogue: 0,0:54:10.86,0:54:15.23,Default,shooting gallery,0,0,0,,ay patuloy na nagbubulsa ng ilang pulbura.
Dialogue: 0,0:54:17.57,0:54:19.64,Default,shooting range,0,0,0,,Halaga ng nakatagong pulbura
Dialogue: 0,0:54:19.64,0:54:23.41,Default,dash,0,0,0,,maliit sa una, ngunit lumaki sa paglipas ng panahon.
Dialogue: 0,0:54:23.77,0:54:24.84,Default,gitling,0,0,0,,Direkta
Dialogue: 0,0:54:26.08,0:54:28.04,Default,shooting,0,0,0,,kung paano lumalaki ang kasakiman.
Dialogue: 0,0:54:29.35,0:54:31.28,Default,shooting,0,0,0,,-Ano?\N-Totoo ba ito?
Dialogue: 0,0:54:31.58,0:54:35.25,Default,shooting range,0,0,0,,Alam mo, noong nagsimula ang pagnanakaw ng pulbura,
Dialogue: 0,0:54:36.02,0:54:37.55,Default,shooting range,0,0,0,,troop commander Kim Jwageun?
Dialogue: 0,0:54:42.56,0:54:46.23,Default,dash,0,0,0,,Sa parehong taon na umakyat ako sa trono.
Dialogue: 0,0:54:47.93,0:54:52.10,Default,shooting,0,0,0,,Sa parehong taon, naging commander ng tropa si Mr. Kim Jwageun.
Dialogue: 0,0:54:53.70,0:54:56.04,Default,shooting,0,0,0,,Kamahalan, ito ay isang maling akusasyon.
Dialogue: 0,0:54:56.04,0:54:57.44,Default,shooting gallery,0,0,0,,Tahimik!
Dialogue: 0,0:54:58.24,0:55:01.01,Default,shooting range,0,0,0,,Minister of War, responsable sa paggawa ng pulbura,
Dialogue: 0,0:55:01.01,0:55:04.45,Default,shooting,0,0,0,,taksil din, nagplano ng pagtataksil kay Kim Jwageun!
Dialogue: 0,0:55:05.58,0:55:08.05,Default,shooting,0,0,0,,Ginagamit ko ang mga pekeng identity ng royal guard bilang pain.
Dialogue: 0,0:55:08.32,0:55:12.09,Default,shooting,0,0,0,,Dapat nalaman na ni Kim Jwageun ang tungkol dito.
Dialogue: 0,0:55:17.56,0:55:19.93,Default,shooting,0,0,0,,Dadaanan mo ang hindi mabata na pagpapahirap,
Dialogue: 0,0:55:20.33,0:55:21.63,Default,shooting,0,0,0,,pero tiisin mo sila.
Dialogue: 0,0:55:23.67,0:55:25.14,Default,shooting,0,0,0,,Talagang ililigtas kita.
Dialogue: 0,0:55:30.64,0:55:35.25,Default,shooting,0,0,0,,Ito ay isang maling akusasyon,\Nintindihan mo ito, Kamahalan!
Dialogue: 0,0:55:38.95,0:55:41.58,Default,dash,0,0,0,,Kung sasabihin mong muli na ikaw ay maling inaakusahan,
Dialogue: 0,0:55:43.02,0:55:45.42,Default,shooting,0,0,0,,Bibigyan kita agad ng lason na maiinom.
Dialogue: 0,0:55:49.96,0:55:51.96,Default,shooting range,0,0,0,,Ibinenta ito ng mga mangangalakal ng pulbura
Dialogue: 0,0:55:51.96,0:55:54.03,Default,dash,0,0,0,,sinumang nagbayad.
Dialogue: 0,0:55:54.23,0:55:56.97,Default,shooting gallery,0,0,0,,Mga bandido, maging ang mga Japanese!
Dialogue: 0,0:55:57.17,0:56:00.24,Default,shooting,0,0,0,,Kung hindi ito para sa kapakanan ng pagkawasak ni Joseon, para saan?
Dialogue: 0,0:56:01.20,0:56:04.11,Default,shooting gallery,0,0,0,,Sino pa ang kasama nila dito?
Dialogue: 0,0:56:15.39,0:56:17.25,Default,shooting,0,0,0,,Kumander ng tropa Kim Jwageun.
Dialogue: 0,0:56:17.79,0:56:20.09,Default,shooting,0,0,0,,Minister of War Kim Chang-hyuk.
Dialogue: 0,0:56:21.42,0:56:22.69,Default,shooting,0,0,0,,Ang dalawang ito
Dialogue: 0,0:56:23.99,0:56:27.06,Default,shooting,0,0,0,,nagnakaw ng pambansang armas para pahinain ang hukbo,
Dialogue: 0,0:56:27.63,0:56:31.77,Default,shooting,0,0,0,,at nagplano ng tangkang pagpatay sa akin, ang hari,
Dialogue: 0,0:56:34.50,0:56:35.91,Default,tyra,0,0,0,,na nangangahulugan na sila ay nagkasala ng pagtataksil.
Dialogue: 0,0:56:36.67,0:56:39.88,Default,dash,0,0,0,,Ano ang dapat nating tawagan sa operasyong ito?
Dialogue: 0,0:56:41.98,0:56:42.98,Default,shooting,0,0,0,,Phoenix.
Dialogue: 0,0:56:45.72,0:56:47.28,Default,shooting,0,0,0,,Pangalan ng operasyon -
Dialogue: 0,0:56:48.42,0:56:50.42,Default,shooting gallery,0,0,0,,nasusunog na Phoenix.
Dialogue: 0,0:56:55.43,0:56:57.33,Default,shooting,0,0,0,,Para sa lahat ng krimen
Dialogue: 0,0:56:58.93,0:57:01.00,Default,shooting,0,0,0,,aalisin sa pwesto ang mga salarin
Dialogue: 0,0:57:02.53,0:57:04.00,Default,shooting,0,0,0,,at ipinatapon.
Dialogue: 0,0:57:05.97,0:57:07.04,Default,shooting,0,0,0,,Kamahalan.
Dialogue: 0,0:57:11.27,0:57:14.11,Default,tyra,0,0,0,,-The Dowager Queen.\N-The Dowager Queen.
Dialogue: 0,0:57:14.54,0:57:16.51,Default,shooting,0,0,0,,Ano ang ginagawa mo?
Dialogue: 0,0:57:16.98,0:57:18.72,Default,shooting,0,0,0,,Bakit ka humahatol nang walang dahilan?
Dialogue: 0,0:57:19.15,0:57:21.82,Default,shooting gallery,0,0,0,,Siguro nawalan ka ng malay pagkatapos ng pagsabog.
Dialogue: 0,0:57:22.42,0:57:25.05,Default,shooting range,0,0,0,,Tandaan ang mga limitasyon ng kung ano ang pinahihintulutan!
Dialogue: 0,0:57:25.72,0:57:26.92,Default,shooting,0,0,0,,Ganun ba?
Dialogue: 0,0:57:28.63,0:57:30.36,Default,dash,0,0,0,,Kung sasabihin mo,
Dialogue: 0,0:57:37.60,0:57:42.31,Default,dash,0,0,0,,siguro nasiraan ka na ng isip dahil sa katandaan.
Dialogue: 0,0:57:43.67,0:57:48.55,Default,dash,0,0,0,,Hindi ko maipagpatuloy ang pagtalakay sa mga isyung pampulitika habang nasa ganitong estado ka.
Dialogue: 0,0:57:49.61,0:57:52.92,Default,tyra,0,0,0,,Mangyaring umalis sa iyong regency.
Dialogue: 0,0:57:55.05,0:57:56.39,Default,shooting,0,0,0,,-Ano?\N-Ano ang sinasabi niya?
Dialogue: 0,0:57:58.86,0:58:02.86,Default,shooting gallery,0,0,0,,Panahon na para gumawa ako ng sarili kong mga desisyon.
Dialogue: 0,0:58:03.43,0:58:04.59,Default,shooting gallery,0,0,0,,Kamahalan!
Dialogue: 0,0:58:04.59,0:58:07.70,Default,shooting,0,0,0,,Dapat ay pinainom ko agad si Kim Jwageun ng lason
Dialogue: 0,0:58:07.70,0:58:09.50,Default,shooting,0,0,0,,at i-execute ang kanyang buong pamilya.
Dialogue: 0,0:58:09.73,0:58:12.27,Default,shooting,0,0,0,,Pero dahil sa iyo at sa reyna
Dialogue: 0,0:58:13.04,0:58:15.31,Default,shooting,0,0,0,,Napagdesisyunan kong bawian na lang siya ng titulo.
Dialogue: 0,0:58:16.67,0:58:17.84,Default,shooting,0,0,0,,Hindi mo gusto?
Dialogue: 0,0:58:18.31,0:58:22.75,Default,shooting,0,0,0,,Sinusubukan mo bang makipag-deal sa akin kapalit ng buhay ng kapatid ko?
Dialogue: 0,0:58:23.25,0:58:26.62,Default,dash,0,0,0,,Matatawag mo lang itong deal kung mayroon kang pagpipilian.
Dialogue: 0,0:58:30.32,0:58:31.39,Default,shooting,0,0,0,,Kamahalan.
Dialogue: 0,0:58:33.96,0:58:37.09,Default,shooting,0,0,0,,Ako, si Kim Jwageun, ay maling inakusahan,
Dialogue: 0,0:58:37.33,0:58:38.73,Default,shooting,0,0,0,,ngunit patutunayan ko ang aking katapatan,
Dialogue: 0,0:58:38.73,0:58:41.13,Default,tyra,0,0,0,,pagsunod sa royal order.
Dialogue: 0,0:58:41.60,0:58:42.93,Default,shooting,0,0,0,,Nakakaginhawa.
Dialogue: 0,0:58:43.57,0:58:46.77,Default,dash,0,0,0,,Natatakot ako na dahil sa iyong katandaan, baka lamunin ka ng kasakiman.
Dialogue: 0,0:58:46.97,0:58:48.84,Default,shooting,0,0,0,,Hindi ako tutol sa pagtanggal sa pwesto.
Dialogue: 0,0:58:49.07,0:58:51.34,Default,shooting,0,0,0,,Ngunit hinihiling kong bigyan mo ako ng pagkakataon
Dialogue: 0,0:58:51.34,0:58:53.81,Default,dash,0,0,0,,clear ang iyong pangalan.
Dialogue: 0,0:58:54.11,0:58:56.61,Default,shooting,0,0,0,,Hinihiling ko na alisin si Sakhonbu sa kanyang posisyon.
Dialogue: 0,0:58:58.01,0:58:59.08,Default,dash,0,0,0,,Tinatanggap ko ang iyong kahilingan.
Dialogue: 0,0:58:59.38,0:59:04.02,Default,shooting,0,0,0,,Ngunit kung hindi siya tanggalin ni Sakhonbu sa opisina bukas,
Dialogue: 0,0:59:04.35,0:59:07.99,Default,shooting,0,0,0,,Agad kong tatanggalin sa pwesto ang commander ng tropa na si Kim Jwageun.
Dialogue: 0,0:59:08.56,0:59:11.33,Default,shooting,0,0,0,,at lulunawin ko hindi lang si Sakhonbu mismo,
Dialogue: 0,0:59:11.33,0:59:14.73,Default,shooting,0,0,0,,kundi pati lahat ng mga opisyal na naroroon!
Dialogue: 0,0:59:15.40,0:59:19.90,Default,shooting,0,0,0,,-Humihingi kami ng iyong awa!\N-Humihingi kami ng iyong awa!
Dialogue: 0,0:59:36.72,0:59:38.32,Default,shooting range,0,0,0,,Natalo ka.
Dialogue: 0,0:59:38.72,0:59:41.69,Default,shooting,0,0,0,,Ikaw ay pinalayas ng hari kung saan ikaw mismo ang nagbigay ng trono!
Dialogue: 0,0:59:42.09,0:59:45.19,Default,shooting,0,0,0,,Hindi ko alam na plano ng hari ang sarili niyang tangkang pagpatay.
Dialogue: 0,0:59:45.80,0:59:48.73,Default,shooting gallery,0,0,0,,Sino sa tingin mo ang naglagay ng bitag?
Dialogue: 0,0:59:50.27,0:59:52.74,Default,shooting gallery,0,0,0,,Ipinagkatiwala ko sa iyo ang pagpili ng mga maharlikang babae.
Dialogue: 0,0:59:53.10,0:59:55.57,Default,shooting,0,0,0,,Ngunit hindi mo masyadong naiintindihan ang mga tao.
Dialogue: 0,0:59:57.87,1:00:01.71,Default,tyra,0,0,0,,Sinabi ni Confucius na ang puso ay mas kumplikado kaysa kalikasan,
Dialogue: 0,1:00:01.81,1:00:04.65,Default,dash,0,0,0,,at mas mahirap makita ang puso ng ibang tao kaysa makita kung ano ang nasa likod ng mga ulap.
Dialogue: 0,1:00:05.21,1:00:06.58,Default,shooting gallery,0,0,0,,Nagkamali ako sa pagpili ng mga maharlikang babae
Dialogue: 0,1:00:06.58,1:00:08.72,Default,shooting gallery,0,0,0,,kapwa sa palasyo at sa labas nito.
Dialogue: 0,1:00:09.89,1:00:12.76,Default,tyra,0,0,0,,Nagtiwala ka rin sa reyna
Dialogue: 0,1:00:12.76,1:00:15.16,Default,tyra,0,0,0,,bahala sa pagpili ng mga maharlikang asawa.
Dialogue: 0,1:00:15.76,1:00:18.43,Default,shooting,0,0,0,,Ngunit gumawa siya ng pagpili pabor sa hari.
Dialogue: 0,1:00:18.66,1:00:20.93,Default,shooting,0,0,0,,At ang reyna ang nagligtas sa kapistahan,
Dialogue: 0,1:00:20.93,1:00:22.40,Default,shooting,0,0,0,,na sinira ko.
Dialogue: 0,1:00:23.93,1:00:27.34,Default,shooting range,0,0,0,,Ang kaaway ay kakila-kilabot kapag siya ay kabilang sa kanyang sarili.
Dialogue: 0,1:00:40.05,1:00:41.12,Default,shooting,0,0,0,,Your Highness.
Dialogue: 0,1:00:48.36,1:00:51.09,Default,shooting,0,0,0,,Tiyak na nagkamalay ang kanyang Kamahalan.
Dialogue: 0,1:00:53.46,1:00:57.10,Default,shooting,0,0,0,,Maaari kong bantayan ang aking asawa\N kapag siya ay nagkamalay.
Dialogue: 0,1:00:57.77,1:01:00.94,Default,shooting,0,0,0,,Kung hindi siya magising, magiging inutil ako.
Dialogue: 0,1:01:01.50,1:01:04.27,Default,shooting,0,0,0,,Kung ako ay naging inutil, ako ay ibagsak.
Dialogue: 0,1:01:04.27,1:01:06.78,Default,shooting,0,0,0,,Kung ako ay mapatalsik, ibibigay ko ang mga saloobin ng paghihiganti
Dialogue: 0,1:01:06.78,1:01:09.25,Default,shooting,0,0,0,,at magbubukas ako ng restaurant para maghanap-buhay.
Dialogue: 0,1:01:10.78,1:01:12.58,Default,shooting,0,0,0,,Hindi masyadong masama.
Dialogue: 0,1:01:13.02,1:01:14.05,Default,shooting gallery,0,0,0,,Reyna!
Dialogue: 0,1:01:15.25,1:01:18.32,Default,shooting,0,0,0,,Kamahalan...
Dialogue: 0,1:01:21.52,1:01:23.26,Default,shooting,0,0,0,,Siya ay nagkamalay.
Dialogue: 0,1:01:23.86,1:01:25.03,Default,shooting,0,0,0,,Talaga?
Dialogue: 0,1:01:25.03,1:01:27.33,Default,dash,0,0,0,,Oo. Bumalik na ang kanyang pandinig
Dialogue: 0,1:01:27.33,1:01:29.47,Default,shooting,0,0,0,,at pumunta siya sa royal council.
Dialogue: 0,1:01:29.47,1:01:31.67,Default,shooting range,0,0,0,,Natakot talaga ako.
Dialogue: 0,1:01:32.37,1:01:33.60,Default,shooting,0,0,0,,Kailangan ko nang umalis.
Dialogue: 0,1:01:35.54,1:01:36.84,Default,shooting,0,0,0,,-Kamahalan!\N-Kamahalan!
Dialogue: 0,1:01:38.94,1:01:40.21,Default,shooting,0,0,0,,Wala akong oras.
Dialogue: 0,1:01:45.21,1:01:46.78,Default,shooting gallery,0,0,0,,-Kamahalan!\N-Kamahalan!
Dialogue: 0,1:01:48.25,1:01:49.65,Default,shooting,0,0,0,,Natutuwa ako.
Dialogue: 0,1:01:51.69,1:01:53.46,Default,shooting,0,0,0,,Talaga, natutuwa ako.
Dialogue: 0,1:01:59.36,1:02:01.80,Default,shooting,0,0,0,,Huwag umiyak. Bakit ka umiiyak?
Dialogue: 0,1:02:02.27,1:02:03.80,Default,shooting,0,0,0,,Napakaluwag nito.
Dialogue: 0,1:02:03.80,1:02:05.60,Default,shooting,0,0,0,,Court lady Choi.
Dialogue: 0,1:02:09.17,1:02:11.94,Default,shooting,0,0,0,,-Gagawin ko.\N-Oo, Kamahalan.
Dialogue: 0,1:02:17.98,1:02:19.15,Default,shooting,0,0,0,,Kamahalan.
Dialogue: 0,1:02:24.35,1:02:25.82,Default,shooting,0,0,0,,Okay na ang lahat ngayon.
Dialogue: 0,1:02:26.76,1:02:29.79,Default,dash,0,0,0,,Lahat ay maayos, dahil gising ka at malusog.
Dialogue: 0,1:02:31.49,1:02:35.57,Default,shooting,0,0,0,,Hinding hindi na kita mawawala.
Dialogue: 0,1:02:37.53,1:02:38.57,Default,shooting,0,0,0,,Hwajin.
Dialogue: 0,1:02:41.47,1:02:43.01,Default,shooting,0,0,0,,Queen's Dictionary
Dialogue: 0,1:02:50.25,1:02:51.35,Default,shooting,0,0,0,,Kamahalan.
Dialogue: 0,1:02:51.35,1:02:54.42,Default,shooting,0,0,0,,Bibisitahin mo daw ang hari. Bakit ka nakaupo dito?
Dialogue: 0,1:02:54.98,1:02:56.22,Default,shooting gallery,0,0,0,,Isa pang baso.
Dialogue: 0,1:02:56.69,1:02:59.92,Default,shooting,0,0,0,,Awkward na makita siyang matino.
Dialogue: 0,1:03:01.02,1:03:05.03,Default,dash,0,0,0,,Tumigil sa pag-inom. Hindi mo kailangang gawin ito, Kamahalan.
Dialogue: 0,1:03:05.03,1:03:07.66,Default,shooting,0,0,0,,Sapat na trabaho para sa iyo. umuwi ka na!
Dialogue: 0,1:03:11.07,1:03:13.37,Default,shooting,0,0,0,,Iinumin kita nito.
Dialogue: 0,1:03:15.44,1:03:16.94,Default,shooting,0,0,0,,Court lady Choi.
Dialogue: 0,1:03:17.84,1:03:19.28,Default,shooting,0,0,0,,Court lady Choi.
Dialogue: 0,1:03:23.65,1:03:26.15,Default,shooting range,0,0,0,,Sa royal kitchen, ang supply ng alak ay walang limitasyon.
Dialogue: 0,1:03:29.12,1:03:31.15,Default,shooting,0,0,0,,Bakit ka nahihiya?
Dialogue: 0,1:03:33.46,1:03:35.59,Default,shooting,0,0,0,,Awkward kasi...
Dialogue: 0,1:03:38.29,1:03:40.93,Default,shooting,0,0,0,,Tama ka. Bakit ang awkward nito?
Dialogue: 0,1:03:42.13,1:03:44.40,Default,shooting,0,0,0,,Kumpiyansa ako! Pumunta tayo sa hari.
Dialogue: 0,1:03:44.67,1:03:46.84,Default,shooting gallery,0,0,0,,Hindi ka makakapunta ngayon,
Dialogue: 0,1:03:46.84,1:03:48.50,Default,shooting,0,0,0,,go kapag matino ka na.
Dialogue: 0,1:03:49.57,1:03:50.87,Default,shooting,0,0,0,,Okay. Punta tayo bukas.
Dialogue: 0,1:03:51.21,1:03:52.44,Default,shooting,0,0,0,,Ipagpaliban natin ito hanggang bukas.
Dialogue: 0,1:03:52.44,1:03:53.64,Default,dash,0,0,0,,Parang nagda-diet.
Dialogue: 0,1:03:53.88,1:03:55.81,Default,shooting,0,0,0,,Meron tayo bukas!
Dialogue: 0,1:03:56.35,1:03:58.65,Default,shooting gallery,0,0,0,,Royal chef. Isa pang bote.
Dialogue: 0,1:03:59.55,1:04:01.92,Default,shooting,0,0,0,,Sa tingin ba niya pumunta siya sa tavern o ano?
Dialogue: 0,1:04:03.75,1:04:04.79,Default,shooting,0,0,0,,Mas mabilis.
Dialogue: 0,1:04:41.96,1:04:43.09,Default,shooting,0,0,0,,Court lady Kan.
Dialogue: 0,1:04:46.73,1:04:48.90,Default,shooting range,0,0,0,,Secret
Dialogue: 0,1:04:48.90,1:04:50.00,Default,shooting gallery,0,0,0,,Kamahalan!
Dialogue: 0,1:04:54.50,1:04:55.54,Default,shooting,0,0,0,,Kamahalan.
Dialogue: 0,1:05:15.76,1:05:18.23,Default,shooting gallery,0,0,0,,Nakita ito sa Daejojon hall.
Dialogue: 0,1:05:18.23,1:05:21.36,Default,shooting,0,0,0,,Gaya ng inaasahan, nagtutulungan ang hari at reyna.
Dialogue: 0,1:05:21.36,1:05:24.37,Default,shooting,0,0,0,,Ganap na sira ang Reyna.
Dialogue: 0,1:05:25.33,1:05:28.87,Default,shooting range,0,0,0,,Ang mga sirang bagay ay kailangang palitan ng mga bago.
Dialogue: 0,1:05:29.81,1:05:34.21,Default,shooting,0,0,0,,Ngunit maaari mong patagalin ang sirang bagay hanggang sa huli
Dialogue: 0,1:05:35.78,1:05:37.91,Default,shooting gallery,0,0,0,,at ipadala ito sa apoy.
Dialogue: 0,1:05:39.58,1:05:42.35,Default,dash,0,0,0,,Siguro gumagamit tayo ng totoong arsenic?
Dialogue: 0,1:05:49.76,1:05:52.36,Default,shooting,0,0,0,,Mahilig kumain ang Reyna.
Dialogue: 0,1:05:52.96,1:05:55.46,Default,shooting,0,0,0,,Kaya ayusin natin ang table para sa kanya.
Dialogue: 0,1:05:56.73,1:05:59.34,Default,shooting gallery,0,0,0,,Aalis ka ba sa hari?
Dialogue: 0,1:05:59.70,1:06:03.51,Default,shooting,0,0,0,,Kailangan natin itong sirain\N upang maipagpatuloy ang paggamit nito.
Dialogue: 0,1:06:03.97,1:06:08.54,Default,dash,0,0,0,,Kung mangyari ito, sa sandaling ibinigay niya ang kanyang puso sa reyna, maiintindihan niya,
Dialogue: 0,1:06:09.11,1:06:11.68,Default,shooting,0,0,0,,na lahat ng kakampi niya ay magiging malungkot.
Dialogue: 0,1:06:58.06,1:07:00.56,Default,shooting,0,0,0,,Hindi ba ito isang himala,
Dialogue: 0,1:07:02.23,1:07:04.50,Default,shooting,0,0,0,,anong bukas araw-araw?
Dialogue: 0,1:07:11.91,1:07:14.14,Default,shooting gallery,0,0,0,,Punta tayo sa second round sa Songjeongjong hall.
Dialogue: 0,1:07:14.51,1:07:17.98,Default,shooting,0,0,0,,Kailangan nating ipagdiwang ang pagbawi ng hari.
Dialogue: 0,1:07:17.98,1:07:20.78,Default,shooting gallery,0,0,0,,Huwag kang sumigaw, Kamahalan.
Dialogue: 0,1:07:20.78,1:07:22.42,Default,shooting gallery,0,0,0,,Kamahalan!
Dialogue: 0,1:07:22.92,1:07:24.65,Default,shooting,0,0,0,,Kamahalan!
Dialogue: 0,1:07:24.65,1:07:27.72,Default,shooting,0,0,0,,Hindi mo siya matatawag na ganyan.
Dialogue: 0,1:07:29.46,1:07:30.66,Default,shooting,0,0,0,,Buksan.
Dialogue: 0,1:07:34.36,1:07:35.56,Default,shooting,0,0,0,,Buksan.
Dialogue: 0,1:07:42.34,1:07:45.27,Default,shooting,0,0,0,,Spiral Potatoes
Dialogue: 0,1:07:49.48,1:07:53.28,Default,shooting,0,0,0,,Natutulog ka ba?
Dialogue: 0,1:08:13.84,1:08:15.81,Default,shooting,0,0,0,,Nakatulog yata ako.
Dialogue: 0,1:08:22.04,1:08:24.45,Default,shooting,0,0,0,,Binabantayan mo ba ako?
Dialogue: 0,1:08:26.52,1:08:28.92,Default,shooting,0,0,0,,Bakit mo ito ginagawa?
Dialogue: 0,1:08:30.12,1:08:34.12,Default,shooting,0,0,0,,Nag-aalala tungkol sa akin, sinusubukang intindihin ako.
Dialogue: 0,1:08:36.03,1:08:39.86,Default,dash,0,0,0,,Pag-isipan mo, ikaw ang unang taong nakita ko nang pumunta ako rito.
Dialogue: 0,1:08:44.13,1:08:46.77,Default,shooting,0,0,0,,Malaki ang utang ko sa iyo.
Dialogue: 0,1:08:48.20,1:08:50.94,Default,shooting,0,0,0,,Naisip kita noong sinubukan kong umalis sa palasyo.
Dialogue: 0,1:08:52.54,1:08:54.68,Default,shooting,0,0,0,,Akala ko hindi na kita makikita.
Dialogue: 0,1:09:34.35,1:09:36.22,Default,tyra,0,0,0,,Hon Young.
Dialogue: 0,1:09:58.21,1:09:59.64,Default,shooting,0,0,0,,Gising ka na ba?
Dialogue: 0,1:10:08.82,1:10:13.66,Default,gitling,0,0,0,,
Dialogue: 0,1:10:28.97,1:10:31.14,Default,tyra,0,0,0,,Sigurado ako na ang kaluluwa ng babaeng ito ang nagmamay-ari sa aking katawan.
Dialogue: 0,1:10:31.14,1:10:33.14,Default,shooting,0,0,0,,Bakit lagi mo akong iniiwasan?
Dialogue: 0,1:10:33.14,1:10:35.21,Default,shooting,0,0,0,,-Teka.\N-Ano bang gusto niyang itanong sa akin?
Dialogue: 0,1:10:35.21,1:10:36.25,Default,shooting,0,0,0,,Nagustuhan mo ba?
Dialogue: 0,1:10:36.25,1:10:38.15,Default,shooting range,0,0,0,,Hindi mo ba sinabi na ito ay ipinagbabawal?
Dialogue: 0,1:10:38.15,1:10:40.22,Default,tyra,0,0,0,,Sabi niya sabay yakap, nakangiti at nakahiga sa tabi mo -
Dialogue: 0,1:10:40.22,1:10:41.88,Default,shooting range,0,0,0,,lahat ng ito ay ipinagbabawal.
Dialogue: 0,1:10:42.25,1:10:44.02,Default,shooting,0,0,0,,Pinagbabawalan kitang sabihin na ito ay ipinagbabawal.
Dialogue: 0,1:10:44.39,1:10:45.75,Default,shooting range,0,0,0,,Inihanda ko na ang lahat.
Dialogue: 0,1:10:45.75,1:10:46.86,Default,shooting,0,0,0,,Ano ang nakikita mo?
Dialogue: 0,1:10:46.86,1:10:49.26,Default,shooting gallery,0,0,0,,May mamamatay sa palasyo ngayon.
Dialogue: 0,1:10:49.26,1:10:50.73,Default,shooting,0,0,0,,Hindi ako makapaniwalang sinubukan nilang tanggalin ang reyna.
Dialogue: 0,1:10:50.73,1:10:55.26,Default,dash,0,0,0,, Espesyal akong naghanda ng yelo, na mas mahal kaysa sa ginto ngayon.
Dialogue: 0,1:10:55.26,1:10:56.87,Default,shooting,0,0,0,,-Your Majesty.\N-My queen.
Dialogue: 0,0:15:53.44,0:15:55.44,Default,,0,0,0,,

Puna: 0,0:12:33.43,0:12:34.53,Default,Lily,0,0,0,,Lord.
