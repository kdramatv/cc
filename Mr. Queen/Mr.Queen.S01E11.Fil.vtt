Dialogue: 0,0:00:58.00,0:01:03.98,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДДСТА
Dialogue: 0,0:00:58.00,0:01:03.98,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807}\fscy2007 92 38 l 0 38
Dialogue: 0,0:00:58.00,0:01:03.98,nagtrabaho,,0,0,0,,{\pos(801,256)}Gumawa sa serye:\N Lily, Tiramisu, Biryulka, Host, Singer, February
Dialogue: 0,0:00:58.00,0:01:03.98,title,,0,0,0,,{\fscx75\fscy75\pos(846,392)}Paano ako naging
Dialogue: 0,0:00:58.00,0:01:03.98,pangalan,,0,0,0,,{\fscx75\fscy75\pos(848,456)}reyna
Dialogue: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialogue: 0,0:01:03.96,0:01:06.46,Default,Lily,0,0,0,,Lahat ng character ay kathang-isip lang,
Dialogue: 0,0:01:06.46,0:01:08.66,Default,Lily,0,0,0,,at ang mga kaganapang ipinakita ay kathang-isip lamang.
Dialogue: 0,0:01:15.70,0:01:18.84,Default,Lily,0,0,0,,Sabi nila hindi diretsong lumilipad ang arrow kapag nababalisa ka.
Dialogue: 0,0:01:20.07,0:01:22.94,Default,Lily,0,0,0,,11 episode
Dialogue: 0,0:01:34.39,0:01:37.26,Default,Lily,0,0,0,,Humihingi ako ng paumanhin sa paghingi ng ganoong late meeting.
Dialogue: 0,0:01:37.42,0:01:39.33,Default,Lily,0,0,0,,Ano ang sinasabi mo?
Dialogue: 0,0:01:39.66,0:01:41.09,Default,Lily,0,0,0,,Kailangan mo ako,
Dialogue: 0,0:01:41.09,0:01:42.56,Default,Lily,0,0,0,,at nagpapasalamat ako para doon.
Dialogue: 0,0:01:43.70,0:01:46.73,Default,Lily,0,0,0,,Kung panaginip lang ito.
Dialogue: 0,0:01:47.73,0:01:51.57,Default,Lily,0,0,0,,Kung mawawala na lang ang lahat paggising ko.
Dialogue: 0,0:01:56.68,0:01:58.25,Default,Lily,0,0,0,,Mayroon akong para sa iyo.
Dialogue: 0,0:02:14.03,0:02:15.76,Default,Lily,0,0,0,,Sikreto
Dialogue: 0,0:02:33.08,0:02:37.15,Default,Lily,0,0,0,,Ilubog ang reyna sa bangungot kung saan ako nakatira.
Dialogue: 0,0:02:48.46,0:02:49.70,Default,Lily,0,0,0,,Aking hari.
Dialogue: 0,0:02:52.00,0:02:56.27,Default,Lily,0,0,0,,Kagabi pumunta ka sa akin sa panaginip
Dialogue: 0,0:02:56.97,0:03:00.51,Default,Lily,0,0,0,,at isang malaking kapangyarihan ang nahulog sa aking mga kamay.
Dialogue: 0,0:03:15.16,0:03:18.53,Default,Lily,0,0,0,,Queen's Dictionary
Dialogue: 0,0:03:24.50,0:03:26.40,Default,Lily,0,0,0,,Social distancing
Dialogue: 0,0:03:30.17,0:03:32.84,Default,Lily,0,0,0,,kamangha-manghang, oras ng mahika, gutom sa atensyon,
Dialogue: 0,0:03:32.84,0:03:36.34,Default,Lily,0,0,0,,showdown, jasmine tea, bastos
Dialogue: 0,0:03:51.36,0:03:53.03,Default,Lily,0,0,0,,Cuties.
Dialogue: 0,0:03:56.43,0:03:57.46,Default,Lily,0,0,0,,Kamahalan.
Dialogue: 0,0:03:59.60,0:04:03.14,Default,Lily,0,0,0,,Nawalan ng boses, tawagin mo akong paos?
Dialogue: 0,0:04:08.71,0:04:09.78,Default,Lily,0,0,0,,Kamahalan.
Dialogue: 0,0:04:13.81,0:04:14.85,Default,Lily,0,0,0,,Kamahalan.
Dialogue: 0,0:04:17.52,0:04:19.05,Default,Lily,0,0,0,,Sapat bang mainit ang tubig?
Dialogue: 0,0:04:20.22,0:04:21.96,Default,Lily,0,0,0,,Sapat ba ang init ng tubig?
Dialogue: 0,0:04:24.46,0:04:26.19,Default,Lily,0,0,0,,Gusto ko.
Dialogue: 0,0:04:26.19,0:04:28.70,Default,Lily,0,0,0,,Bakit nakalimutan mo dito?
Dialogue: 0,0:04:33.47,0:04:34.60,Default,Lily,0,0,0,,My queen.
Dialogue: 0,0:04:37.74,0:04:38.97,Default,Lily,0,0,0,,Ngayon
Dialogue: 0,0:04:40.34,0:04:42.18,Default,Lily,0,0,0,,walang social distancing.
Dialogue: 0,0:04:52.72,0:04:55.42,Default,Lily,0,0,0,,Kamahalan, gising ka na ba?
Dialogue: 0,0:04:59.66,0:05:00.69,Default,Lily,0,0,0,,Lord.
Dialogue: 0,0:05:01.19,0:05:03.70,Default,Lily,0,0,0,,Bakit parang nakakatakot ka?
Dialogue: 0,0:05:04.00,0:05:06.73,Default,Lily,0,0,0,,Ang lakas ng loob mong sirain ang erotikong panaginip ko?
Dialogue: 0,0:05:07.93,0:05:09.37,Default,Lily,0,0,0,,Tawagan siya agad!
Dialogue: 0,0:05:09.74,0:05:10.90,Default,Lily,0,0,0,,Okay.
Dialogue: 0,0:05:11.81,0:05:12.97,Default,Lily,0,0,0,,Tumawag...
Dialogue: 0,0:05:15.58,0:05:16.71,Default,Lily,0,0,0,,Sino ang dapat nating tawagan?
Dialogue: 0,0:05:27.05,0:05:28.49,Default,Lily,0,0,0,,Queen's Dictionary
Dialogue: 0,0:05:29.19,0:05:31.42,Default,Lily,0,0,0,,Maganda ang mood mo, Kamahalan.
Dialogue: 0,0:05:32.86,0:05:35.13,Default,Lily,0,0,0,,Natulog buong gabi nang hindi nagigising.
Dialogue: 0,0:05:36.33,0:05:38.63,Default,Lily,0,0,0,,Simulan ang paghahanda para sa kapistahan.
Dialogue: 0,0:05:39.87,0:05:40.93,Default,Lily,0,0,0,,Okay.
Dialogue: 0,0:05:47.07,0:05:50.44,Default,Lily,0,0,0,,11 episode. Yung hindi mapapatawad
Dialogue: 0,0:05:51.55,0:05:52.61,Default,Lily,0,0,0,,Dr.
Dialogue: 0,0:05:53.85,0:05:55.42,Default,Lily,0,0,0,,Nagkaroon ako ng bangungot.
Dialogue: 0,0:05:55.85,0:05:57.95,Default,Lily,0,0,0,,Ngunit mas masahol pa sa bangungot na ito,
Dialogue: 0,0:05:57.95,0:05:59.49,Default,Lily,0,0,0,,na hindi ko siya gusto
Dialogue: 0,0:06:00.89,0:06:03.02,Default,Lily,0,0,0,,at nagustuhan ito nang sabay.
Dialogue: 0,0:06:03.39,0:06:06.29,Default,Lily,0,0,0,,Hindi ko alam kung nararamdaman ko ba o katawan ko.
Dialogue: 0,0:06:07.16,0:06:10.53,Default,Lily,0,0,0,,Para akong pinagsama-sama.
Dialogue: 0,0:06:11.43,0:06:12.50,Default,Lily,0,0,0,,Eksakto.
Dialogue: 0,0:06:13.63,0:06:16.90,Default,Lily,0,0,0,,Para akong naging Lego constructor.
Dialogue: 0,0:06:17.30,0:06:20.57,Default,Lily,0,0,0,,Sino ako?
Dialogue: 0,0:06:22.71,0:06:24.61,Default,Lily,0,0,0,,Pero bakit
Dialogue: 0,0:06:25.45,0:06:28.42,Default,Lily,0,0,0,,tinatawag mo ba akong "doktor"?
Dialogue: 0,0:06:29.25,0:06:31.08,Default,Lily,0,0,0,,Nagambala mo ako.
Dialogue: 0,0:06:31.08,0:06:33.49,Default,Lily,0,0,0,,Makinig ka lang. Ito ay sa paraang kinakailangan.
Dialogue: 0,0:06:37.19,0:06:40.16,Default,Lily,0,0,0,,So ano ang opinyon ng eksperto?
Dialogue: 0,0:06:40.53,0:06:45.07,Default,Lily,0,0,0,,Ang mga pagbabago sa katawan ay mga side effect ng isang vegetative state.
Dialogue: 0,0:06:46.33,0:06:47.40,Default,Lily,0,0,0,,So normal ba ito?
Dialogue: 0,0:06:50.70,0:06:52.71,Default,Lily,0,0,0,,Walang kakaiba.
Dialogue: 0,0:06:54.21,0:06:57.48,Default,Lily,0,0,0,,Medyo nakakaaliw, actually.
Dialogue: 0,0:06:57.91,0:07:01.75,Default,Lily,0,0,0,,Sa iyong mga salita, nagsimulang mawala ang pagkabalisa.
Dialogue: 0,0:07:03.58,0:07:06.22,Default,Lily,0,0,0,,Siya na nagpapagaling nang walang acupuncture -
Dialogue: 0,0:07:06.52,0:07:08.25,Default,Lily,0,0,0,,mahusay na manggagamot.
Dialogue: 0,0:07:09.16,0:07:10.19,Default,Lily,0,0,0,,Iyon pala
Dialogue: 0,0:07:10.92,0:07:14.13,Default,Lily,0,0,0,,royal na manggagamot at eksperto sa sikolohiya.
Dialogue: 0,0:07:15.56,0:07:19.17,Default,Lily,0,0,0,,So kailan ang aking pinaghalong dalawang mukha na estado
Dialogue: 0,0:07:19.17,0:07:20.53,Default,Lily,0,0,0,,bitawan mo ba ako?
Dialogue: 0,0:07:20.77,0:07:23.27,Default,Lily,0,0,0,,Lahat ng problema ay konektado sa iyong puso.
Dialogue: 0,0:07:23.40,0:07:26.67,Default,Lily,0,0,0,,Sa sandaling tanggapin mo ito, mawawala ang mga alalahanin.
Dialogue: 0,0:07:26.67,0:07:29.81,Default,Lily,0,0,0,,Maaari kang magsimulang mabuhay muli nang walang pag-aalala.
Dialogue: 0,0:07:29.81,0:07:33.58,Default,Lily,0,0,0,,Dapat ko bang tanggapin ang aking sarili bilang ako?
Dialogue: 0,0:07:36.22,0:07:40.09,Default,Lily,0,0,0,,Reasonable. Ang tanging palaging bagay tungkol sa akin ay ang aking kontradiksyon.
Dialogue: 0,0:07:41.22,0:07:42.26,Default,Lily,0,0,0,,Nga pala.
Dialogue: 0,0:07:42.99,0:07:45.56,Default,Lily,0,0,0,,Ang mga halamang gamot para sa pabalat ng kagandahan ay kahanga-hanga.
Dialogue: 0,0:07:47.29,0:07:48.53,Default,Lily,0,0,0,,Gamitin sila,
Dialogue: 0,0:07:48.53,0:07:50.73,Default,Lily,0,0,0,,upang gumawa ng facial product.
Dialogue: 0,0:07:51.50,0:07:53.20,Default,Lily,0,0,0,,Elasticity, ningning at ningning.
Dialogue: 0,0:07:53.20,0:07:55.57,Default,Lily,0,0,0,,Dapat makaakit ng pansin ang layunin.
Dialogue: 0,0:07:55.57,0:07:57.60,Default,Lily,0,0,0,,Kailangan tuwing 28 araw, gumawa ng higit pa.
Dialogue: 0,0:07:58.74,0:08:01.17,Default,Lily,0,0,0,,Bakit 28 araw?
Dialogue: 0,0:08:01.17,0:08:02.48,Default,Lily,0,0,0,,Ganito ang pag-renew ng balat.
Dialogue: 0,0:08:02.98,0:08:04.61,Default,Lily,0,0,0,,Kapag naging keratinized ang kanyang balat,
Dialogue: 0,0:08:04.61,0:08:05.98,Default,Lily,0,0,0,,kailangan niya ako.
Dialogue: 0,0:08:06.81,0:08:08.21,Default,Lily,0,0,0,,Kamahalan.
Dialogue: 0,0:08:08.45,0:08:11.45,Default,Lily,0,0,0,,Mr. Lumapit sa iyo si Youngjin.
Dialogue: 0,0:08:17.56,0:08:19.59,Default,Lily,0,0,0,,Ito ba talaga ang maid na si Hwajin?
Dialogue: 0,0:08:19.89,0:08:21.80,Default,Lily,0,0,0,,Sigurado siya.
Dialogue: 0,0:08:23.06,0:08:26.97,Default,Lilia,0,0,0,,Pero umaasa ako na si Ovol mismo ang nagbenta ng noriga.
Dialogue: 0,0:08:27.20,0:08:28.94,Default,Lilia,0,0,0,,Malamang nagalit si Hwajin.
Dialogue: 0,0:08:30.37,0:08:32.07,Default,Lily,0,0,0,,Kailangan natin siyang bisitahin.
Dialogue: 0,0:08:34.37,0:08:37.34,Default,Lily,0,0,0,,Kamahalan. Ang pangunahing babae ay humihiling ng madla.
Dialogue: 0,0:08:37.38,0:08:38.51,Default,Lily,0,0,0,,Papasukin mo siya.
Dialogue: 0,0:08:42.48,0:08:43.48,Default,Lily,0,0,0,,Concubine.
Dialogue: 0,0:08:51.49,0:08:52.59,Default,Lily,0,0,0,,Paumanhin.
Dialogue: 0,0:08:55.50,0:08:57.70,Default,Lily,0,0,0,,Iginuhit ko ang Ovol.
Dialogue: 0,0:08:58.43,0:09:01.60,Default,Lily,0,0,0,,Ganyan ko siya naalala.
Dialogue: 0,0:09:01.97,0:09:03.07,Default,Lily,0,0,0,,Sigurado ako,
Dialogue: 0,0:09:03.94,0:09:05.77,Default,Lilia,0,0,0,,na si Ovol mismo ang nagbenta kay noriga.
Dialogue: 0,0:09:06.17,0:09:08.01,Default,Lily,0,0,0,,Hindi siya hahantong sa ganoon sa palasyo.
Dialogue: 0,0:09:09.61,0:09:11.28,Default,Lily,0,0,0,,Masisiguro mo ang larawan.
Dialogue: 0,0:09:16.05,0:09:17.32,Default,Lily,0,0,0,,Excuse me.
Dialogue: 0,0:09:18.08,0:09:19.15,Default,Lily,0,0,0,,Siyempre.
Dialogue: 0,0:09:26.66,0:09:28.16,Default,Lily,0,0,0,,Ngayon ko lang nalaman.
Dialogue: 0,0:09:29.03,0:09:31.46,Default,Lily,0,0,0,,Nahirapan ka kagabi.
Dialogue: 0,0:09:33.13,0:09:36.34,Default,Lily,0,0,0,,Gumugol ako ng buong gabi sa pag-iipon ng aking mga iniisip, huwag mag-alala.
Dialogue: 0,0:09:39.77,0:09:41.88,Default,Lily,0,0,0,,May kailangan akong sabihin sa iyo.
Dialogue: 0,0:09:45.04,0:09:47.68,Default,Lily,0,0,0,,Ito ay may kinalaman sa iyong nararamdaman para sa reyna.
Dialogue: 0,0:09:48.31,0:09:49.68,Default,Lily,0,0,0,,Mas mahirap pagtagumpayan ang iyong sarili,
Dialogue: 0,0:09:50.45,0:09:53.72,Default,Lily,0,0,0,,kaysa sa pagdaig sa ibang tao. Samakatuwid
Dialogue: 0,0:09:55.02,0:09:56.56,Default,Lily,0,0,0,,pagbigyan mo ang iyong nararamdaman.
Dialogue: 0,0:09:58.06,0:10:01.69,Default,Lily,0,0,0,,Hindi ko kailangan ng sorry mo.
Dialogue: 0,0:10:18.34,0:10:20.21,Default,Lily,0,0,0,,Ayos ka lang ba?
Dialogue: 0,0:10:21.65,0:10:23.25,Default,Lily,0,0,0,,Isang araw na lang mula nang bumalik ako sa palasyo,
Dialogue: 0,0:10:23.25,0:10:24.85,Default,Lily,0,0,0,,kaya okay.
Dialogue: 0,0:10:24.85,0:10:27.72,Default,Lily,0,0,0,,Gayunpaman, magiging abala ako sa pagpili ng mga concubines.
Dialogue: 0,0:10:27.72,0:10:29.56,Default,Lily,0,0,0,,Pagpili ng mga concubines.
Dialogue: 0,0:10:33.43,0:10:36.90,Default,Lily,0,0,0,,Pagdating sa aking silid,
Dialogue: 0,0:10:37.50,0:10:40.13,Default,Lily,0,0,0,,may napansin ka bang kakaiba?
Dialogue: 0,0:10:41.67,0:10:43.67,Default,Lily,0,0,0,,May kakaiba?
Dialogue: 0,0:10:44.54,0:10:47.31,Default,Lily,0,0,0,,Kinaladkad ko ang hari mula sa balon, ngunit...
Dialogue: 0,0:10:47.71,0:10:49.51,Default,Lily,0,0,0,,No. May nangyari ba?
Dialogue: 0,0:10:50.68,0:10:51.85,Default,Lily,0,0,0,,Well...
Dialogue: 0,0:10:53.88,0:10:57.02,Default,Lily,0,0,0,,Binisita ninyo akong dalawa,
Dialogue: 0,0:10:57.02,0:10:58.92,Default,Lily,0,0,0,,parang walang laman ang bahay kung wala ka.
Dialogue: 0,0:10:58.92,0:11:00.95,Default,Lily,0,0,0,,Mukhang ito ang buong punto.
Dialogue: 0,0:11:02.19,0:11:04.02,Default,Lily,0,0,0,,Makikita mo ba ang Kanyang Kamahalan?
Dialogue: 0,0:11:04.22,0:11:06.36,Default,Lily,0,0,0,,Pagbukud-bukurin ito sa inyong sarili.
Dialogue: 0,0:11:06.36,0:11:07.46,Default,Lily,0,0,0,,Hindi sulit.
Dialogue: 0,0:11:08.33,0:11:10.16,Default,Lily,0,0,0,,Abala yata siya sa paghahanda ng handaan.
Dialogue: 0,0:11:10.16,0:11:13.37,Default,Lily,0,0,0,,Kamahalan, nagdala ako\N ng sulat sa bahay ng nobya.
Dialogue: 0,0:11:13.60,0:11:16.24,Default,Lily,0,0,0,,Kailangan mong asikasuhin ang negosyo. pupunta ako.
Dialogue: 0,0:11:25.61,0:11:26.68,Default,Lily,0,0,0,,Kamahalan.
Dialogue: 0,0:11:27.95,0:11:30.15,Default,Lily,0,0,0,,Kahit may 100 concubines,
Dialogue: 0,0:11:31.48,0:11:33.09,Default,Lily,0,0,0,,hindi sila mangangahas
Dialogue: 0,0:11:34.65,0:11:37.06,Default,Lily,0,0,0,,kuhain ang lugar ng reyna.
Dialogue: 0,0:11:37.66,0:11:39.59,Default,Lily,0,0,0,,Oo. tiyak.
Dialogue: 0,0:11:40.73,0:11:42.70,Default,Lily,0,0,0,,Pakialagaan ang iyong sarili.
Dialogue: 0,0:11:45.27,0:11:46.90,Default,Lily,0,0,0,,Paalam.
Dialogue: 0,0:11:54.71,0:11:56.74,Default,Lily,0,0,0,,Han Siok
Dialogue: 0,0:11:59.35,0:12:00.51,Default,Lily,0,0,0,,Itapon ang pamilya Khan.
Dialogue: 0,0:12:00.81,0:12:02.52,Default,Lily,0,0,0,,We can do without Romeo and Juliet.
Dialogue: 0,0:12:02.95,0:12:05.39,Default,Lily,0,0,0,,Nadala mo na ba ang mga talaangkanan ng mga pamilyang Han?
Dialogue: 0,0:12:07.99,0:12:09.36,Default,Lily,0,0,0,,Han mula sa Pyeongsan.
Dialogue: 0,0:12:11.56,0:12:12.99,Default,Lily,0,0,0,,Khan mula sa Hanyang.
Dialogue: 0,0:12:13.46,0:12:14.76,Default,Lily,0,0,0,,Han mula sa Anbyon.
Dialogue: 0,0:12:15.16,0:12:17.56,Default,Lily,0,0,0,,-Khan mula sa Yangju.\N-Teka.
Dialogue: 0,0:12:18.70,0:12:21.43,Default,Lily,0,0,0,,Ito ba ang lahat ng bloodline ng mga pamilyang Han?
Dialogue: 0,0:12:22.70,0:12:24.00,Default,Lily,0,0,0,,Oo, Kamahalan.
Dialogue: 0,0:12:24.10,0:12:26.61,Default,Lily,0,0,0,,Damn it, marami sila.
Dialogue: 0,0:12:28.61,0:12:32.58,Default,Lily,0,0,0,,Hindi ito gagana. Kailangan kong makuha ang pabor niya.
Dialogue: 0,0:12:34.41,0:12:37.12,Default,Lily,0,0,0,,Traveling Salesman. Ganun din ang kailangan ko.
Dialogue: 0,0:12:37.82,0:12:40.45,Default,Lily,0,0,0,,-Salesman.\N-Bentahan ng bahay.
Dialogue: 0,0:12:44.19,0:12:46.09,Default,Lily,0,0,0,,Lunch na ba?
Dialogue: 0,0:12:47.59,0:12:51.90,Default,Lily,0,0,0,,Oras na para alagaan ang iyong balat.
Dialogue: 0,0:13:03.14,0:13:04.51,Default,Lily,0,0,0,,Nakakasilaw ka.
Dialogue: 0,0:13:05.71,0:13:09.32,Default,Lily,0,0,0,,Isang hindi makalupa na glow.
Dialogue: 0,0:13:09.48,0:13:13.12,Default,Lily,0,0,0,,Salamat sa iyo, ang araw ko ay puno ng pangangalaga sa sarili.
Dialogue: 0,0:13:13.39,0:13:15.86,Default,Lily,0,0,0,,Nakalimutan ko ang pagpili ng mga concubines.
Dialogue: 0,0:13:16.92,0:13:18.49,Default,Lily,0,0,0,,Kumusta ka na?
Dialogue: 0,0:13:19.06,0:13:21.43,Default,Lily,0,0,0,,I'm trying my best.
Dialogue: 0,0:13:21.43,0:13:24.40,Default,Lily,0,0,0,,Siyempre. Talented sa isang bagay, talented sa lahat.
Dialogue: 0,0:13:24.40,0:13:27.20,Default,Lily,0,0,0,,Magaling ka,
Dialogue: 0,0:13:27.20,0:13:28.97,Default,Lily,0,0,0,,na pinagkakatiwalaan kita.
Dialogue: 0,0:13:30.97,0:13:32.57,Default,Lily,0,0,0,,May isang bagay na ako
Dialogue: 0,0:13:32.57,0:13:35.48,Default,Lily,0,0,0,,inihanda ito lalo na para sa iyo.
Dialogue: 0,0:13:37.71,0:13:39.51,Default,Lily,0,0,0,,Kung pulbos mo ang iyong buhok gamit ito,
Dialogue: 0,0:13:39.51,0:13:41.28,Default,Lily,0,0,0,,magiging mas bata ka ng 10 taon.
Dialogue: 0,0:13:41.65,0:13:43.05,Default,Lily,0,0,0,,Purba ng buhok.
Dialogue: 0,0:13:45.28,0:13:49.22,Default,Lily,0,0,0,,Hindi na kailangang maglagay ng mulberry juice
Dialogue: 0,0:13:49.22,0:13:51.26,Default,Lily,0,0,0,,sa ulo ko tuwing umaga.
Dialogue: 0,0:13:52.16,0:13:53.83,Default,Lily,0,0,0,,Wow.
Dialogue: 0,0:13:55.60,0:13:58.23,Default,Lily,0,0,0,,Powder malumanay.
Dialogue: 0,0:13:58.33,0:13:59.93,Default,Lily,0,0,0,,Powder.
Dialogue: 0,0:14:04.27,0:14:05.91,Default,Pangalawa,0,0,0,,Isa itong ganap na kakaibang tao.
Dialogue: 0,0:14:06.61,0:14:10.31,Default,Second,0,0,0,,Mas slanted ang mga mata niya.
Dialogue: 0,0:14:10.61,0:14:12.98,Default,Second,0,0,0,,O baka kaliwang mata lang ang duling?
Dialogue: 0,0:14:12.98,0:14:15.38,Default,Pangalawa,0,0,0,,Gaano ako kagutom.
Dialogue: 0,0:14:21.65,0:14:23.12,Default,Ikalawa,0,0,0,,Mahusay.
Dialogue: 0,0:14:24.32,0:14:27.43,Default,Second,0,0,0,,Payat ang mukha na may chubby cheeks.
Dialogue: 0,0:14:27.83,0:14:29.50,Default,Ikalawa,0,0,0,,Na may malapad na noo
Dialogue: 0,0:14:29.60,0:14:31.26,Default,Ikalawa,0,0,0,,at nagniningning na mga mata.
Dialogue: 0,0:14:31.36,0:14:32.97,Default,Pangalawa,0,0,0,,Isang bagay na ganyan.
Dialogue: 0,0:14:33.10,0:14:35.47,Default,Ikalawa,0,0,0,,Tuwid na spout na may bilugan na dulo.
Dialogue: 0,0:15:12.97,0:15:15.91,Default,Second,0,0,0,,Kamahalan, dumating na ang royal cook.
Dialogue: 0,0:15:17.68,0:15:20.28,Default,Pangalawa,0,0,0,,Sa tingin ko, ang calamus liqueur ay gagawin. Ano sa tingin mo?
Dialogue: 0,0:15:20.75,0:15:21.81,Default,Ikalawa,0,0,0,,Ano?
Dialogue: 0,0:15:22.18,0:15:25.49,Default,Second,0,0,0,,Nadala ako ng sobra sa mga iniisip ko.
Dialogue: 0,0:15:25.79,0:15:27.95,Default,Second,0,0,0,,Iniisip ko kung aling liqueur ang pipiliin para sa handaan.
Dialogue: 0,0:15:29.69,0:15:33.99,Default,Second,0,0,0,,Kamahalan, may inihanda ako dito.
Dialogue: 0,0:15:43.04,0:15:45.00,Default,Pangalawa,0,0,0,,Nararapat akong mamatay.
Dialogue: 0,0:16:01.65,0:16:02.86,Default,Pangalawa,0,0,0,,Relax.
Dialogue: 0,0:16:03.59,0:16:05.29,Default,Pangalawa,0,0,0,,Kung gayon ang lahat ay magiging maayos.
Dialogue: 0,0:16:06.56,0:16:07.99,Default,Ikalawa,0,0,0,,Gaya ng sinasabi mo.
Dialogue: 0,0:16:13.93,0:16:16.07,Default,Pangalawa,0,0,0,,Kumportable ka ba? Pagkatapos ay manood.
Dialogue: 0,0:16:17.40,0:16:18.64,Default,Ikalawa,0,0,0,,Ano?
Dialogue: 0,0:16:21.01,0:16:23.21,Default,Ikalawa,0,0,0,,Ito ay isang tradisyonal na plano ng kapistahan.
Dialogue: 0,0:16:23.68,0:16:25.91,Default,Second,0,0,0,,Gusto kong baguhin ito ng kaunti.
Dialogue: 0,0:16:26.28,0:16:30.05,Default,Ikalawa,0,0,0,,Gusto kong bawasan ang bilang ng mga ulam at alisin
Dialogue: 0,0:16:30.05,0:16:32.59,Default,Second,0,0,0,,isang malaking hindi kailangang mesa na may pagkain sa gitna.
Dialogue: 0,0:16:32.99,0:16:34.89,Default,Second,0,0,0,,-Excuse me, king.\N-Yes?
Dialogue: 0,0:16:35.39,0:16:37.86,Default,Ikalawa,0,0,0,,Royal feast
Dialogue: 0,0:16:37.86,0:16:40.66,Default,Ikalawa,0,0,0,,dapat engrande at maluho.
Dialogue: 0,0:16:40.66,0:16:42.43,Default,Ikalawa,0,0,0,,Gaano man ito hindi kailangan...
Dialogue: 0,0:16:43.80,0:16:45.06,Default,Pangalawa,0,0,0,,Nasisiraan ka na ba ng bait?
Dialogue: 0,0:16:49.47,0:16:51.90,Default,Ikalawa,0,0,0,,Ang aking mga tao ay nagdurusa sa gutom.
Dialogue: 0,0:16:52.21,0:16:54.07,Default,Second,0,0,0,,Isasalin ko ba ang pagkain para masaya?
Dialogue: 0,0:16:54.27,0:16:56.58,Default,Second,0,0,0,,Tapos yung pagkain na ihahanda namin,
Dialogue: 0,0:16:57.68,0:17:00.48,Default,Ang pangalawa,0,0,0,,ibibigay natin sa mga nagugutom sa labas ng palasyo.
Dialogue: 0,0:17:04.28,0:17:06.29,Default,Ikalawa,0,0,0,,Mahinhin, ngunit hindi maramot.
Dialogue: 0,0:17:06.85,0:17:09.62,Default,Ikalawa,0,0,0,,Maganda, ngunit hindi mapagpanggap.
Dialogue: 0,0:17:09.99,0:17:11.52,Default,Pangalawa,0,0,0,,Gusto ko ng ganoong kapistahan.
Dialogue: 0,0:17:16.63,0:17:20.83,Default,Pangalawa,0,0,0,,Gagawin ko ang aking makakaya sa susunod na 2 linggo.
Dialogue: 0,0:17:24.60,0:17:25.67,Default,Second,0,0,0,,Sana magtulungan tayo.
Dialogue: 0,0:17:32.14,0:17:33.18,Default,Ikalawa,0,0,0,,Kamahalan.
Dialogue: 0,0:17:38.12,0:17:40.39,Default,Second,0,0,0,,Napakadali bang paiyakin ang isang lalaki?
Dialogue: 0,0:17:48.43,0:17:50.76,Default,Pangalawa,0,0,0,,Hindi ako makapaniwala,
Dialogue: 0,0:17:50.76,0:17:53.07,Default,Ikalawa,0,0,0,,gayong detalyadong accounting ng mga pinagmumulan ng mga suhol.
Dialogue: 0,0:17:54.63,0:17:57.94,Default,Second,0,0,0,,Mas metikuloso ang ama ng reyna kaysa sa inaakala ko.
Dialogue: 0,0:17:58.37,0:18:02.34,Default,Second,0,0,0,,Ang kaaway ng royal concubine na si Cho\N ay hindi ang Kim clan, kundi ang reyna.
Dialogue: 0,0:18:04.08,0:18:06.48,Default,Second,0,0,0,,Kaya hindi niya makita ang malaking larawan.
Dialogue: 0,0:18:15.39,0:18:19.19,Default,Ikalawa,0,0,0,,Dapat nating maayos na pamahalaan ang ledger.
Dialogue: 0,0:18:19.19,0:18:21.66,Default,Pangalawa,0,0,0,,At pagkatapos ay sisirain natin ang pamilya Kim
Dialogue: 0,0:18:22.09,0:18:25.06,Default,Second,0,0,0,,at ibabagsak natin ang reyna mula sa trono.
Dialogue: 0,0:18:31.27,0:18:32.41,Default,Ikalawa,0,0,0,,Account book?
Dialogue: 0,0:18:33.91,0:18:36.51,Default,Second,0,0,0,,Ano ang iniisip niya? Paano niya maiimbak ang isang bagay na napakapanganib?
Dialogue: 0,0:18:36.51,0:18:37.68,Default,Pangalawa,0,0,0,,Dapat...
Dialogue: 0,0:18:40.78,0:18:42.38,Default,Pangalawa,0,0,0,,Itago ito sa ngayon.
Dialogue: 0,0:18:42.38,0:18:44.38,Default,Second,0,0,0,,Kung malaman ng iba sa pamilya, magkakagulo sila.
Dialogue: 0,0:18:44.38,0:18:47.15,Default,Ikalawa,0,0,0,,Paano. Anong tanga.
Dialogue: 0,0:18:48.79,0:18:49.89,Default,Ikalawa,0,0,0,,At gayon pa man,
Dialogue: 0,0:18:50.99,0:18:52.83,Default,Pangalawa,0,0,0,,Sino sa tingin mo ang may libro?
Dialogue: 0,0:18:52.83,0:18:55.49,Default,Ikalawa,0,0,0,,Ang hari ay gumugol ng 2 araw sa kanyang bahay,
Dialogue: 0,0:18:55.49,0:18:57.66,Default,Second,0,0,0,,binalewala niya ang kahilingang bumalik sa palasyo.
Dialogue: 0,0:18:57.66,0:18:58.70,Default,Ikalawa,0,0,0,,So,
Dialogue: 0,0:19:00.30,0:19:01.33,Default,Ikalawa,0,0,0,,king?
Dialogue: 0,0:19:03.20,0:19:06.61,Default,Ikalawa,0,0,0,,Gusto niyang ibunyag tayo sa kapistahan sa Araw ng Cart.
Dialogue: 0,0:19:07.01,0:19:08.91,Default,Second,0,0,0,,Baka nasa kamay niya ang armas,
Dialogue: 0,0:19:09.81,0:19:12.88,Default,Second,0,0,0,,pero dapat natin itong pahinain para hindi ito mapakinabangan.
Dialogue: 0,0:19:14.45,0:19:15.75,Default,Ikalawa,0,0,0,,Sa tingin ni Kim Moon-geun,
Dialogue: 0,0:19:16.75,0:19:19.55,Default,Second,0,0,0,,na ako na lang ang natitirang suspek.
Dialogue: 0,0:19:19.55,0:19:22.15,Default,Second,0,0,0,,Ngunit hindi niya maitanong sa hari kung ninakaw niya ang libro.
Dialogue: 0,0:19:22.52,0:19:23.76,Default,Second,0,0,0,,Mahirap para sa kanya.
Dialogue: 0,0:19:24.59,0:19:27.36,Default,Second,0,0,0,,Nalaman na ba natin kung sino ang nagtatago sa likod ng maskara?
Dialogue: 0,0:19:27.36,0:19:28.83,Default,Ikalawa,0,0,0,,Sa Detective Department
Dialogue: 0,0:19:28.83,0:19:30.70,Default,Second,0,0,0,,walang peklat sa pisngi.
Dialogue: 0,0:19:31.50,0:19:33.87,Default,Ikalawa,0,0,0,,Kahit hindi namin natatanggap ang ledger,
Dialogue: 0,0:19:34.37,0:19:37.37,Default,Ikalawa,0,0,0,,dapat tayong maghanda ng isang pagsasabwatan upang makamit ang ating layunin.
Dialogue: 0,0:19:38.30,0:19:40.84,Default,Second,0,0,0,,Napag-aralan mo na ba ang posisyon ng ibang genera?
Dialogue: 0,0:19:51.88,0:19:53.32,Default,Ikalawa,0,0,0,,Ang Batas ng Limang Segundo.
Dialogue: 0,0:19:53.82,0:19:56.59,Default,Second,0,0,0,,Limang segundo ay sapat na para umibig.
Dialogue: 0,0:19:59.13,0:20:01.59,Default,Ikalawa,0,0,0,,Kamahalan, narito ang lahat.
Dialogue: 0,0:20:01.59,0:20:03.13,Default,Second,0,0,0,,-Yun lang ba?\N-Oo.
Dialogue: 0,0:20:08.40,0:20:09.50,Default,Pangalawa,0,0,0,,Ikinagagalak na makilala ka.
Dialogue: 0,0:20:11.00,0:20:12.04,Default,Pangalawa,0,0,0,,Ikinagagalak na makilala ka.
Dialogue: 0,0:20:12.71,0:20:17.08,Default,Pangalawa,0,0,0,,Ikinagagalak na makilala ka.
Dialogue: 0,0:20:17.81,0:20:19.11,Default,Ikalawa,0,0,0,,Tingnan natin.
Dialogue: 0,0:20:19.11,0:20:21.48,Default,Ikalawa,0,0,0,,Isang spark ang tumalon sa pagitan ko at...
Dialogue: 0,0:20:29.66,0:20:30.86,Default,Second,0,0,0,,Nagustuhan ko rin ang isang ito.
Dialogue: 0,0:20:36.66,0:20:41.60,Default,Second,0,0,0,,Miss Yun, napakaganda mo, baka sabihin sa amin ang higit pa tungkol sa iyong sarili?
Dialogue: 0,0:20:43.50,0:20:47.71,Default,Ikalawa,0,0,0,,May isang magandang bundok sa aking bayan.
Dialogue: 0,0:20:48.17,0:20:50.01,Default,Ikalawa,0,0,0,,Tinawag na Bundok Kamaksan.
Dialogue: 0,0:20:50.21,0:20:52.38,Default,Second,0,0,0,,-Kamaksan?\N-Oo, reyna.
Dialogue: 0,0:20:54.51,0:20:56.12,Default,Ikalawa,0,0,0,,Nakakamangha lang.
Dialogue: 0,0:20:56.12,0:20:57.22,Default,Ikalawa,0,0,0,,-Nakakamangha?\N-Nakakamangha?
Dialogue: 0,0:20:59.59,0:21:00.65,Default,Second,0,0,0,,-Your Majesty.\N-Yes?
Dialogue: 0,0:21:00.65,0:21:03.59,Default,Ikalawa,0,0,0,,May isang malaking palasyo sa aking lungsod.
Dialogue: 0,0:21:03.59,0:21:05.76,Default,Ikalawa,0,0,0,,Ito ay itinayo ni Haring Jeongjo.
Dialogue: 0,0:21:05.76,0:21:08.29,Default,Second,0,0,0,,Hwaseong Palace lang ang pwede mong ipagmalaki?
Dialogue: 0,0:21:09.83,0:21:12.13,Default,Pangalawa,0,0,0,,Pag-usapan lang siya.
Dialogue: 0,0:21:12.63,0:21:15.07,Default,Ikalawa,0,0,0,,Maaari mong ipagmalaki ang isa pang bagay,
Dialogue: 0,0:21:15.07,0:21:17.90,Default,Second,0,0,0,,kung magiging concubine ka, Mrs. Hong.
Dialogue: 0,0:21:19.17,0:21:21.07,Default,Ikalawa,0,0,0,,Reyna, salamat!
Dialogue: 0,0:21:23.98,0:21:27.18,Default,Ikalawa,0,0,0,,Sa aking bayan ay may mga buong bukirin ng mga puno ng peach.
Dialogue: 0,0:21:27.18,0:21:29.38,Default,Ikalawa,0,0,0,,Sa panahon ng pamumulaklak
Dialogue: 0,0:21:30.12,0:21:31.75,Default,Ikalawa,0,0,0,,walang lugar na mas kahanga-hanga.
Dialogue: 0,0:21:33.89,0:21:36.62,Default,Second,0,0,0,,Nangarap ng mga peach ang nanay ko noong ipinanganak ako.
Dialogue: 0,0:21:37.12,0:21:39.06,Default,Ikalawa,0,0,0,,Hindi nakakagulat.
Dialogue: 0,0:21:39.06,0:21:41.23,Default,Second,0,0,0,,Kung maikukumpara mo ang isang tao sa isang peach,
Dialogue: 0,0:21:41.59,0:21:44.60,Default,Second,0,0,0,,kaya ikaw lang Mrs. Min.
Dialogue: 0,0:21:46.73,0:21:48.63,Default,Pangalawa,0,0,0,,My peach.
Dialogue: 0,0:21:49.24,0:21:52.40,Default,Ikalawa,0,0,0,,Kung nanalo ka sa tatlong uri na ito sa iyong panig,
Dialogue: 0,0:21:53.81,0:21:57.78,Default,Second,0,0,0,,pagkatapos ay magkakaroon ng dragon at dalawang phoenix sa gilid mo.
Dialogue: 0,0:21:59.18,0:22:01.21,Default,Ikalawa,0,0,0,,At pagkatapos ay maaari mong talunin ang puting tigre.
Dialogue: 0,0:22:08.29,0:22:10.49,Default,Ikalawa,0,0,0,,Habang ang Hwaseong Palace ay nagbabantay sa mga tarangkahan,
Dialogue: 0,0:22:11.62,0:22:13.86,Default,Ikalawa,0,0,0,,natutuwa sa aking mga mata ang mga tanawin ng Bundok Camaksan,
Dialogue: 0,0:22:14.56,0:22:19.23,Default,Second,0,0,0,,at ang matamis na aroma ng peach ay pumupuno sa aking mga silid.
Dialogue: 0,0:22:37.12,0:22:39.99,Default,Second,0,0,0,,Phapyeong clan Yun. Namyan clan Hon.
Dialogue: 0,0:22:40.55,0:22:41.79,Default,Ikalawa,0,0,0,,Johyn clan Min.
Dialogue: 0,0:22:42.19,0:22:44.06,Default,Ikalawa,0,0,0,,Mahusay na balanse ng kapangyarihan.
Dialogue: 0,0:22:46.83,0:22:50.06,Default,Pangalawa,0,0,0,,Inosente, sexy at sweet.
Dialogue: 0,0:22:50.50,0:22:51.93,Default,Ikalawa,0,0,0,,Tunay na pagkakaisa.
Dialogue: 0,0:22:58.84,0:23:00.67,Default,Second,0,0,0,,Yun Gyonok mula sa Phapyeong family ni Yun.
Dialogue: 0,0:23:01.44,0:23:03.21,Default,Second,0,0,0,,Min Jayon mula sa Yohyn clan of Min.
Dialogue: 0,0:23:03.94,0:23:06.01,Default,Second,0,0,0,,Khon Simkhyan mula sa Namyang family of Khon.
Dialogue: 0,0:23:06.75,0:23:10.18,Default,Ikalawa,0,0,0,,Itinatalaga kita bilang mga concubine ng pangalawang ranggo.
Dialogue: 0,0:23:13.82,0:23:18.09,Default,Second,0,0,0,,Ang tatlong concubines na ito at ang kanilang mga pamilya ay sumali sa royal family.
Dialogue: 0,0:23:18.66,0:23:21.33,Default,Pangalawa,0,0,0,,Sabihin sa iyong mga pamilya
Dialogue: 0,0:23:21.33,0:23:23.93,Default,Ikalawa,0,0,0,,imbitasyon sa isang piging sa Araw ng Cart.
Dialogue: 0,0:23:24.40,0:23:27.50,Default,Second,0,0,0,,-Salamat, Kamahalan.\N-Salamat, Kamahalan.
Dialogue: 0,0:23:32.74,0:23:34.27,Default,Pangalawa,0,0,0,,Well, finally.
Dialogue: 0,0:23:35.07,0:23:37.74,Default,Ikalawa,0,0,0,,Nagsimulang magtipon ang hari ng mga kaalyado sa paligid niya.
Dialogue: 0,0:23:38.28,0:23:40.45,Default,Ikalawa,0,0,0,,Ngunit sisirain nila ang lahat ng ugnayan sa kanya,
Dialogue: 0,0:23:40.45,0:23:42.62,Default,Second,0,0,0,,sa sandaling malaman nila kung gaano siya kahina.
Dialogue: 0,0:23:44.68,0:23:48.62,Default,Ikalawa,0,0,0,,Ipinilit ng hari na magdaos ng piging.
Dialogue: 0,0:23:48.89,0:23:50.16,Default,Second,0,0,0,,Ito ba ang gusto niya?
Dialogue: 0,0:23:51.42,0:23:54.33,Default,Second,0,0,0,,-Sana ay naghahanda ka na.\N-Huwag kang mag-alala.
Dialogue: 0,0:24:04.20,0:24:05.24,Default,Ikalawa,0,0,0,,Higit pa!
Dialogue: 0,0:24:08.74,0:24:11.28,Default,Second,0,0,0,,Malamang na gustong malaman ng lahat kung ano ang nasa likod ng dingding.
Dialogue: 0,0:24:12.88,0:24:15.38,Default,Pangalawa,0,0,0,,Nagagawa nila ito nang napakahusay.
Dialogue: 0,0:24:16.58,0:24:17.88,Default,Pangalawa,0,0,0,,Darating na ang Inang Reyna.
Dialogue: 0,0:24:22.05,0:24:24.79,Default,Pangalawa,0,0,0,,Sana ay nasa mabuti kang kalagayan, Inang Reyna.
Dialogue: 0,0:24:27.29,0:24:29.63,Default,Second,0,0,0,,Matagal nang hindi nagkita, royal concubine Cho.
Dialogue: 0,0:24:30.96,0:24:33.43,Default,Ikatlo,0,0,0,,Kumusta, Kamahalan.
Dialogue: 0,0:24:36.14,0:24:39.10,Default,Third,0,0,0,,Kung papayag ka, iiwan kita, gusto kong magpractice ng shooting.
Dialogue: 0,0:24:48.45,0:24:49.52,Default,Pangatlo,0,0,0,,Matagal ka na rito
Dialogue: 0,0:24:49.52,0:24:51.22,Default,Ikatlo,0,0,0,,namulat siya pagkatapos ng sakit.
Dialogue: 0,0:24:51.22,0:24:53.19,Default,Third,0,0,0,,Pero hindi niya ako binisita.
Dialogue: 0,0:24:54.89,0:24:56.36,Default,Ikatlo,0,0,0,,Abala ako sa pagpili ng mga mapapangasawa
Dialogue: 0,0:24:56.36,0:24:57.79,Default,Ikatlo,0,0,0,,para sa Kanyang Kamahalan.
Dialogue: 0,0:24:58.79,0:25:00.46,Default,Pangatlo,0,0,0,,Patawarin mo ako.
Dialogue: 0,0:25:01.06,0:25:04.70,Default,Ikatlo,0,0,0,,Para sa isang taong nahaharap sa kamatayan, ikaw ay sariwa.
Dialogue: 0,0:25:06.20,0:25:08.30,Default,Pangatlo,0,0,0,,Hindi ako nagreklamo tungkol sa aking kalusugan.
Dialogue: 0,0:25:09.97,0:25:12.62,Default,Third,0,0,0,,Kaya sumuko ka na,\Hindi ka manghuhuli sa Cart Day?
Dialogue: 0,0:25:13.04,0:25:15.31,Default,Ikatlo,0,0,0,,Sa halip na pagsasanay na may busog
Dialogue: 0,0:25:15.47,0:25:17.28,Default,Third,0,0,0,,nakakatuwa ka dito.
Dialogue: 0,0:25:17.28,0:25:19.28,Default,Ikatlo,0,0,0,,Ang Royal consort na si Cho ay mananalo pa rin.
Dialogue: 0,0:25:19.28,0:25:21.41,Default,Ikatlo,0,0,0,,Napagpasyahan kong i-enjoy ang holiday.
Dialogue: 0,0:25:22.25,0:25:24.35,Default,Pangatlo,0,0,0,,Siguro magaling akong mang-stalk ng "biktima"
Dialogue: 0,0:25:24.35,0:25:26.39,Default,Ikatlo,0,0,0,,ngunit hindi bagay sa akin ang pangangaso.
Dialogue: 0,0:25:27.32,0:25:28.49,Default,Ikatlo,0,0,0,,Pag-uusig?
Dialogue: 0,0:25:28.49,0:25:29.96,Default,Ikatlo,0,0,0,,Alam mo,
Dialogue: 0,0:25:29.96,0:25:33.03,Default,Ikatlo,0,0,0,,bakit sumasali sa pangangaso ang mga batang babae ng courtyard
Dialogue: 0,0:25:33.03,0:25:34.63,Default,Ikatlo,0,0,0,,sa Araw ng Cart?
Dialogue: 0,0:25:35.63,0:25:37.96,Default,Pangatlo,0,0,0,,Hindi, hindi talaga.
Dialogue: 0,0:25:42.00,0:25:45.64,Default,Ikatlo,0,0,0,,Sa araw na ito itinataboy natin ang masasamang espiritu.
Dialogue: 0,0:25:46.17,0:25:47.91,Default,Ikatlo,0,0,0,,Noon, ang masamang espiritu ay pinalayas
Dialogue: 0,0:25:47.91,0:25:49.61,Default,Ikatlo,0,0,0,,dugo ng mga pinaslang.
Dialogue: 0,0:25:50.11,0:25:53.48,Default,Ikatlo,0,0,0,,Ngunit sa halip ay nangangaso kami ng mga hayop.
Dialogue: 0,0:26:02.52,0:26:06.13,Default,Ikatlo,0,0,0,,Actually, may nakitang bangkay sa balon ng palasyo.
Dialogue: 0,0:26:06.73,0:26:08.84,Default,Ikatlo,0,0,0,,Itong court lady na \Nserved Concubine Cho.
Dialogue: 0,0:26:09.53,0:26:10.63,Default,Ikatlo,0,0,0,,Sa balon?
Dialogue: 0,0:26:12.36,0:26:13.90,Default,Ikatlo,0,0,0,,Paano?
Dialogue: 0,0:26:15.33,0:26:16.37,Default,Ikatlo,0,0,0,,Kamahalan.
Dialogue: 0,0:26:16.37,0:26:18.20,Default,Ikatlo,0,0,0,,-Halika sa amin.\N-Pumunta sa amin.
Dialogue: 0,0:26:18.67,0:26:19.91,Default,Ikatlo,0,0,0,,Okay.
Dialogue: 0,0:26:26.75,0:26:29.11,Default,Ikatlo,0,0,0,,-Wow.\N-Hindi kapani-paniwala.
Dialogue: 0,0:26:29.58,0:26:31.95,Default,Ikatlo,0,0,0,,Ang kanyang Kamahalan ay isang master.
Dialogue: 0,0:26:35.02,0:26:36.32,Default,Ikatlo,0,0,0,,Triple Axel.
Dialogue: 0,0:26:49.51,0:26:52.41,Default,Pangatlo,0,0,0,,Hindi ako makatulog at umikot-ikot.
Dialogue: 0,0:26:55.88,0:26:58.09,Default,Ikatlo,0,0,0,,Marahil ay dapat akong sumulat ng mensahe sa aking mga mahal na asawa?
Dialogue: 0,0:27:01.39,0:27:03.13,Default,Ikatlo,0,0,0,,Ano ang dapat kong isulat?
Dialogue: 0,0:27:04.06,0:27:08.13,Default,Ikatlo,0,0,0,,Ang isang simpleng simula ay hindi nag-oobliga sa iyo sa anuman, ngunit pumukaw ng emosyon.
Dialogue: 0,0:27:09.40,0:27:10.47,Default,Ikatlo,0,0,0,,Eksakto.
Dialogue: 0,0:27:32.19,0:27:34.12,Default,Ikatlo,0,0,0,,Ihatid ito sa kanila.
Dialogue: 0,0:27:34.72,0:27:35.76,Default,Ikatlo,0,0,0,,Oo.
Dialogue: 0,0:27:36.39,0:27:37.39,Default,Ikatlo,0,0,0,,Maghintay ng isang minuto.
Dialogue: 0,0:27:38.06,0:27:40.76,Default,Ikatlo,0,0,0,,Utos na panatilihing nakapikit ang iyong mga mata upang makita kung ang hari ay lilitaw.
Dialogue: 0,0:27:41.50,0:27:42.53,Default,Ikatlo,0,0,0,,Oo.
Dialogue: 0,0:27:47.14,0:27:49.14,Default,Ikatlo,0,0,0,,Isang mensahe para sa bawat asawa.
Dialogue: 0,0:27:49.14,0:27:50.97,Default,Ikatlo,0,0,0,,-At tingnan kung nasaan ang hari.\N-At tingnan kung nasaan ang hari.
Dialogue: 0,0:27:50.97,0:27:52.71,Default,Ikatlo,0,0,0,,Isang mensahe para sa asawa.
Dialogue: 0,0:27:52.71,0:27:54.14,Default,Ikatlo,0,0,0,,At tingnan kung nasaan ang hari.
Dialogue: 0,0:27:59.25,0:28:00.38,Default,Ikatlo,0,0,0,,Sa iyo.
Dialogue: 0,0:28:03.05,0:28:04.59,Default,Ikatlo,0,0,0,,Pumasok ka na.
Dialogue: 0,0:28:05.42,0:28:07.22,Default,Ikatlo,0,0,0,,Isang mensahe para sa hari.
Dialogue: 0,0:28:07.22,0:28:08.99,Default,Ikatlo,0,0,0,,At tingnan kung nasaan ang mga mag-asawa.
Dialogue: 0,0:28:08.99,0:28:10.06,Default,Ikatlo,0,0,0,,Ano?
Dialogue: 0,0:28:10.06,0:28:12.06,Default,Ikatlo,0,0,0,,-Isang mensahe para sa hari.\N-May nagbago.
Dialogue: 0,0:28:12.06,0:28:13.86,Default,Ikatlo,0,0,0,,At tingnan kung nasaan ang mga mag-asawa.
Dialogue: 0,0:28:19.13,0:28:20.44,Default,Pangatlo,0,0,0,,"Natutulog ka ba?"
Dialogue: 0,0:28:21.17,0:28:22.30,Default,Pangatlo,0,0,0,,Natutulog ka ba?
Dialogue: 0,0:28:24.14,0:28:25.21,Default,Ikatlo,0,0,0,,Well...
Dialogue: 0,0:28:29.01,0:28:30.05,Default,Pangatlo,0,0,0,,"Natutulog ka ba?"
Dialogue: 0,0:28:36.22,0:28:37.32,Default,Pangatlo,0,0,0,,"Natutulog ka ba?"
Dialogue: 0,0:28:40.89,0:28:44.43,Default,Third,0,0,0,,Bakit interesado siya kung natutulog ako o hindi?
Dialogue: 0,0:28:45.33,0:28:46.93,Default,Pangatlo,0,0,0,,Tatlong beses akong nagtanong.
Dialogue: 0,0:28:53.34,0:28:54.80,Default,Ikatlo,0,0,0,,Dumating na ang sagot.
Dialogue: 0,0:28:55.64,0:28:58.64,Default,Third,0,0,0,,Nagsend ako ng 3, bakit isa lang ang sagot?
Dialogue: 0,0:29:00.41,0:29:02.64,Default,Pangatlo,0,0,0,,Nagsusulat ba sila ng mga nobela para sa akin doon?
Dialogue: 0,0:29:06.95,0:29:09.38,Default,Pangatlo,0,0,0,,Well, tingnan natin.
Dialogue: 0,0:29:11.29,0:29:14.39,Default,Ikatlo,0,0,0,,Napakagandang sulat-kamay.\NTiyan ang ibig sabihin ng pagiging mula sa isang mabuting pamilya.
Dialogue: 0,0:29:17.03,0:29:19.66,Default,Pangatlo,0,0,0,,Sa gabing walang tulog ako naglalakad.
Dialogue: 0,0:29:20.93,0:29:24.07,Default,Ikatlo,0,0,0,,Ang liwanag ay bumabagsak sa madilim na kalangitan sa gabi.
Dialogue: 0,0:29:25.03,0:29:28.74,Default,Third,0,0,0,,Inangat ko ang aking ulo - marahil ito ang buwan?\NO, ito ang aking mahal na kaibigan.
Dialogue: 0,0:29:30.74,0:29:32.91,Default,Ikatlo,0,0,0,,Spanish na kahihiyan.\Nbat nakakaantig ito sa kaluluwa.
Dialogue: 0,0:29:33.64,0:29:35.64,Default,Ikatlo,0,0,0,,Dapat din tayo...
Dialogue: 0,0:30:00.54,0:30:02.30,Default,Ikatlo,0,0,0,,-Hon Young.\N-Oo, Kamahalan.
Dialogue: 0,0:30:03.54,0:30:05.87,Default,Ikatlo,0,0,0,,Ito ang sagot. Ihatid ito sa nagpadala ng liham na iyon.
Dialogue: 0,0:30:06.48,0:30:09.11,Default,Pangatlo,0,0,0,,Iniisip ko ang maraming bagay.
Dialogue: 0,0:30:09.11,0:30:11.21,Default,Ikatlo,0,0,0,,Na may masayang puso, nalulunod ako sa mga iniisip mo.
Dialogue: 0,0:30:11.21,0:30:13.92,Default,Ikatlo,0,0,0,,Pakiusap, i-row sa akin.
Dialogue: 0,0:30:14.52,0:30:18.99,Default,Third,0,0,0,,Hindi ko binitawan ang mga iniisip tungkol sa iyo.
Dialogue: 0,0:30:21.86,0:30:22.96,Default,Ikatlo,0,0,0,,My queen.
Dialogue: 0,0:30:28.23,0:30:30.47,Default,Ikatlo,0,0,0,,Kaya ang kaalaman mula sa panimulang kurso ay naging kapaki-pakinabang.
Dialogue: 0,0:30:30.93,0:30:34.00,Default,Third,0,0,0,,Great, ganyan ko ibabalik ang pagkalalaki ko.
Dialogue: 0,0:30:36.14,0:30:37.21,Default,Ikatlo,0,0,0,,Okay.
Dialogue: 0,0:31:25.95,0:31:27.39,Default,Ikatlo,0,0,0,,Sundin ang parehong recipe,
Dialogue: 0,0:31:27.89,0:31:29.73,Default,Ikatlo,0,0,0,,pero mas magandang palitan ang croaker
Dialogue: 0,0:31:31.16,0:31:32.23,Default,Ikatlo,0,0,0,,para sa bream.
Dialogue: 0,0:31:32.23,0:31:33.23,Default,Ikatlo,0,0,0,,
Dialogue: 0,0:31:35.26,0:31:38.23,Default,Ikatlo,0,0,0,,Kumuha ng inspirasyon para sa iyong mga tula at liham?
Dialogue: 0,0:31:38.90,0:31:40.04,Default,Ikatlo,0,0,0,,My queen.
Dialogue: 0,0:31:40.60,0:31:41.70,Default,Ikatlo,0,0,0,,Holy shit.
Dialogue: 0,0:31:42.07,0:31:43.14,Default,Ikatlo,0,0,0,,Reyna.
Dialogue: 0,0:31:43.81,0:31:45.64,Default,Ikatlo,0,0,0,,Ikaw! Sabi ko sayo hindi ka makakapunta dito.
Dialogue: 0,0:31:46.14,0:31:47.24,Default,Ikatlo,0,0,0,,Pero...
Dialogue: 0,0:31:47.38,0:31:48.74,Default,Third,0,0,0,,Nag-act ako na parang mag-asawa kami,
Dialogue: 0,0:31:48.74,0:31:50.65,Default,Ikatlo,0,0,0,,dahil isa itong opisyal na kaganapan.
Dialogue: 0,0:31:50.65,0:31:53.02,Default,Ikatlo,0,0,0,,Para sa akin ngayon napakahalagang mahanap muli ang aking sarili.
Dialogue: 0,0:31:53.02,0:31:54.12,Default,Ikatlo,0,0,0,,Mangyaring huwag makialam.
Dialogue: 0,0:31:54.62,0:31:55.62,Default,Pangatlo,0,0,0,,Bastos.
Dialogue: 0,0:31:55.62,0:31:56.65,Default,Ikatlo,0,0,0,,Ano ito.
Dialogue: 0,0:31:58.49,0:32:00.22,Default,Third,0,0,0,,Paano siya mag-transform ng ganun?
Dialogue: 0,0:32:02.62,0:32:04.73,Default,Ikatlo,0,0,0,,Ang Reyna ay mas mahiyain kaysa sa kanyang nakikita.
Dialogue: 0,0:32:09.90,0:32:11.80,Default,Ikatlo,0,0,0,,Handa na ang listahan ng mga pagkain para sa seremonya.
Dialogue: 0,0:32:12.67,0:32:13.77,Default,Ikatlo,0,0,0,,Magandang trabaho.
Dialogue: 0,0:32:15.77,0:32:18.57,Default,Ikatlo,0,0,0,,Nasuri mo na ba ang listahan ng mga handog para sa seremonya?
Dialogue: 0,0:32:18.94,0:32:20.48,Default,Ikatlo,0,0,0,,Narito ang listahan.
Dialogue: 0,0:32:20.48,0:32:22.41,Default,Ikatlo,0,0,0,,Bakit lahat sila ay nagsasabing "bone-on"?
Dialogue: 0,0:32:23.71,0:32:26.95,Default,Ikatlo,0,0,0,,Ang listahan ng mga pagkain ay ang menu.
Dialogue: 0,0:32:27.18,0:32:30.29,Default,Ikatlo,0,0,0,,Ang listahan ng mga handog ay isang listahan ng mga bagay para sa ritwal.
Dialogue: 0,0:32:30.85,0:32:32.15,Default,Ikatlo,0,0,0,,Ano ang problema mo, Kamahalan?
Dialogue: 0,0:32:32.25,0:32:34.39,Default,Ikatlo,0,0,0,,Talaga? So deaf pervert ba ako?
Dialogue: 0,0:32:37.56,0:32:39.29,Default,Ikatlo,0,0,0,,Kamahalan!
Dialogue: 0,0:32:43.30,0:32:45.27,Default,Pangatlo,0,0,0,,Masyado kang nagtatrabaho.
Dialogue: 0,0:32:45.27,0:32:47.87,Default,Ikatlo,0,0,0,,Magpahinga ka na, Kamahalan.
Dialogue: 0,0:32:48.64,0:32:49.77,Default,Ikatlo,0,0,0,,Hindi.
Dialogue: 0,0:32:50.71,0:32:52.27,Default,Ikatlo,0,0,0,,Walang oras. Ituloy natin.
Dialogue: 0,0:32:54.48,0:32:55.74,Default,Third,0,0,0,,halos naawa ako sa kanya.
Dialogue: 0,0:32:56.81,0:32:58.91,Default,Ikatlo,0,0,0,,Hindi ang punto. Ngayon ay susulat ako ng isang liham nang mas galit.
Dialogue: 0,0:32:59.55,0:33:01.02,Default,Ikatlo,0,0,0,,Ang Boner ay isang mapanganib na salita ayon kay Freud.
Dialogue: 0,0:33:01.02,0:33:03.15,Default,Third,0,0,0,,Ang kanyang nosebleed ay malinaw na hindi mula sa trabaho.
Dialogue: 0,0:33:07.32,0:33:09.96,Default,Ikatlo,0,0,0,,Sa pangalan mo sa aking labi mamamatay ako!
Dialogue: 0,0:33:10.29,0:33:13.33,Default,Ikatlo,0,0,0,,Mananatili ito sa aking alaala - huwag itong kalimutan.
Dialogue: 0,0:33:15.00,0:33:17.07,Default,Ikatlo,0,0,0,,Paano siya isang gabi at isa pa sa araw?
Dialogue: 0,0:33:17.73,0:33:20.34,Default,Ikatlo,0,0,0,,Hindi makapagpasya kung patawarin ako
Dialogue: 0,0:33:20.34,0:33:21.90,Default,Ikatlo,0,0,0,,o hindi?
Dialogue: 0,0:33:30.65,0:33:33.15,Default,Ikatlo,0,0,0,,Hindi ako nagsisisi sa aking nasirang puso.
Dialogue: 0,0:33:33.85,0:33:36.32,Default,Ikatlo,0,0,0,,Mayroon bang daan na maaari nating lakaran nang magkasama?
Dialogue: 0,0:33:44.63,0:33:48.20,Default,Ikatlo,0,0,0,,Sana sa susunod ay sundan natin ito sa simula pa lang.
Dialogue: 0,0:33:48.63,0:33:51.20,Default,Ikatlo,0,0,0,,Kahit sa panaginip.
Dialogue: 0,0:34:06.48,0:34:08.22,Default,Ikatlo,0,0,0,,Nagsasanay gamit ang espada sa gabi?
Dialogue: 0,0:34:08.45,0:34:10.32,Default,Pangatlo,0,0,0,,Sapat na sa amin ang isang abnormal na tao.
Dialogue: 0,0:34:10.32,0:34:12.65,Default,Ikatlo,0,0,0,,Kailangan nating maghanda para sa laban para sa holiday.
Dialogue: 0,0:34:13.12,0:34:14.96,Default,Ikatlo,0,0,0,,Buweno, pagkatapos ay magsanay kasama ang isang tao mula sa Syskny.
Dialogue: 0,0:34:17.49,0:34:20.60,Default,Ikatlo,0,0,0,,Paano mo nire-rate ang iyong kakayahan sa espada?
Dialogue: 0,0:34:20.80,0:34:21.96,Default,Pangatlo,0,0,0,,Hindi ko alam.
Dialogue: 0,0:34:22.10,0:34:24.27,Default,Pangatlo,0,0,0,,Hindi ko ibinigay ang lahat.
Dialogue: 0,0:34:25.80,0:34:27.50,Default,Pangatlo,0,0,0,,Kaya kailangan kita.
Dialogue: 0,0:34:28.34,0:34:30.17,Default,Ikatlo,0,0,0,,Isang kaaway na hindi ko alam ang lakas.
Dialogue: 0,0:35:04.34,0:35:07.34,Default,Ikatlo,0,0,0,,Araw ng Cart
Dialogue: 0,0:35:07.44,0:35:08.94,Default,Ikatlo,0,0,0,,Mahabang buhay at good luck
Dialogue: 0,0:35:14.68,0:35:17.72,Default,Ikatlo,0,0,0,,
Dialogue: 0,0:35:29.83,0:35:31.53,Default,Ikatlo,0,0,0,,Maganda ang panahon, Kamahalan.
Dialogue: 0,0:35:31.53,0:35:32.97,Default,Pangatlo,0,0,0,,Talaga? Ito ay mabuti.
Dialogue: 0,0:35:32.97,0:35:35.43,Default,Ikatlo,0,0,0,,Ayaw ko kapag umuulan sa mga araw ng mga laban sa palakasan.
Dialogue: 0,0:35:38.24,0:35:41.11,Default,Ikaapat,0,0,0,,Darating ang aking ama. Samakatuwid, kailangan mong maging mas chic.
Dialogue: 0,0:35:41.28,0:35:44.05,Default,Ikaapat,0,0,0,,Ito ang unang araw na lalabas ako sa harap ng lahat.
Dialogue: 0,0:35:44.05,0:35:45.48,Default,Ikaapat,0,0,0,,Bigyang pansin.
Dialogue: 0,0:35:49.22,0:35:50.92,Default,Ikaapat,0,0,0,,Oo. maganda ako.
Dialogue: 0,0:35:52.02,0:35:53.42,Default,Fourth,0,0,0,,Titigan ako ng lahat diba?
Dialogue: 0,0:36:06.27,0:36:09.24,Default,Ikaapat,0,0,0,,Gagamitin mo ba ang \Nmetal tips?
Dialogue: 0,0:36:10.41,0:36:11.54,Default,Ikaapat,0,0,0,,Ngayon kailangan ko
Dialogue: 0,0:36:15.48,0:36:16.88,Default,Ikaapat,0,0,0,,huli ng malaking hayop.
Dialogue: 0,0:36:20.25,0:36:22.25,Default,Fourth,0,0,0,,Okay, kailangan nating maihatid ito nang mabilis.
Dialogue: 0,0:36:22.25,0:36:23.65,Default,Ikaapat,0,0,0,,Ilipat.
Dialogue: 0,0:36:26.02,0:36:27.42,Default,Ikaapat,0,0,0,,Hello, sir.
Dialogue: 0,0:36:27.62,0:36:31.09,Default,Ikaapat,0,0,0,,Mayroon kaming sariwang pagkain para sa handaan bilang paggalang sa Araw ng Cart
Dialogue: 0,0:36:31.09,0:36:32.96,Default,Ikaapat,0,0,0,,at mga maharlikang handog.
Dialogue: 0,0:36:33.13,0:36:36.03,Default,Ikaapat,0,0,0,,Kailangan nating magmadali sa palasyo. Paumanhin.
Dialogue: 0,0:36:36.53,0:36:38.90,Default,Fourth,0,0,0,,-May mga dokumento ka ba para sa kanila?\N-Siyempre.
Dialogue: 0,0:36:39.73,0:36:40.84,Default,Ikaapat,0,0,0,,Narito.
Dialogue: 0,0:37:17.01,0:37:18.81,Default,Ikaapat,0,0,0,,Oras na para magpalit ng damit, Kamahalan.
Dialogue: 0,0:37:19.71,0:37:20.71,Default,Ikaapat,0,0,0,,Maghintay ng kaunti.
Dialogue: 0,0:37:22.14,0:37:24.05,Default,Ikaapat,0,0,0,, Ngayon ay isang napakahalagang araw.
Dialogue: 0,0:37:24.78,0:37:28.42,Default,Ikaapat,0,0,0,,Dapat nating subukang hulaan ang kapalaran ng mga taong ito.
Dialogue: 0,0:37:30.89,0:37:35.09,Default,Ikaapat,0,0,0,,Well, tingnan natin. Mapa para sa angkan ng Cho.
Dialogue: 0,0:37:44.97,0:37:46.20,Default,Ikaapat,0,0,0,,Si Thojang ang pinakamababang card sa larong Thujong.
Dialogue: 0,0:37:46.20,0:37:47.60,Default,Ikaapat,0,0,0,,Kuneho card.
Dialogue: 0,0:37:53.34,0:37:57.01,Default,Ikaapat,0,0,0,,Well, ang swerte ay kamag-anak.
Dialogue: 0,0:37:58.31,0:38:02.58,Default,Ikaapat,0,0,0,,Halika. Isang card para sa ating hari.
Dialogue: 0,0:38:09.36,0:38:10.43,Default,Ikaapat,0,0,0,,Ano?
Dialogue: 0,0:38:17.37,0:38:19.93,Default,Ikaapat,0,0,0,,"Injeong." Ikasiyam na kard.
Dialogue: 0,0:38:20.44,0:38:21.74,Default,Ikaapat,0,0,0,,Babaliktad ba ang lahat?
Dialogue: 0,0:38:26.07,0:38:27.71,Default,Ikaapat,0,0,0,,At ngayon ang card para sa reyna.
Dialogue: 0,0:38:36.58,0:38:37.75,Default,Ikaapat,0,0,0,,Dragon?
Dialogue: 0,0:38:39.49,0:38:41.49,Default,Ikaapat,0,0,0,,Ojan, ikawalong card.
Dialogue: 0,0:38:44.76,0:38:47.43,Default,Ika-apat,0,0,0,,Ayaw ko sa kapalaran ko ngayon.
Dialogue: 0,0:38:54.20,0:38:55.94,Default,Ikaapat,0,0,0,,Reyna
Dialogue: 0,0:38:56.87,0:39:01.14,Default,Ikaapat,0,0,0,,hanggang sa isang bagay muli?
Dialogue: 0,0:39:02.98,0:39:04.65,Default,Ikaapat,0,0,0,,Dumating na ang Inang Reyna.
Dialogue: 0,0:39:05.15,0:39:08.32,Default,Ikaapat,0,0,0,,Maaari mong ipaalam sa amin nang maaga na bibisita ka.
Dialogue: 0,0:39:08.32,0:39:11.05,Default,Fourth,0,0,0,,Hindi mo man lang tinatago ang ayaw mo sa akin.
Dialogue: 0,0:39:11.52,0:39:14.09,Default,Ikaapat,0,0,0,,Noong reyna ako,\Nung ganyang pag-uugali ay hindi naririnig.
Dialogue: 0,0:39:14.52,0:39:15.66,Default,Ikaapat,0,0,0,,Anuman ang panahon
Dialogue: 0,0:39:15.66,0:39:18.63,Default,Ikaapat,0,0,0,,walang manugang na gustong mabigla ng kanyang biyenan.
Dialogue: 0,0:39:18.63,0:39:20.93,Default,Fourth,0,0,0,,Well, tingnan mo siya, pumikit siya sa akin.
Dialogue: 0,0:39:23.06,0:39:27.14,Default,Fourth,0,0,0,,Nabalitaan kong nagluluto ka para sa Dowager Queen.
Dialogue: 0,0:39:27.74,0:39:31.54,Default,Fourth,0,0,0,,At hindi man lang niya ako inalok ng meryenda.
Dialogue: 0,0:39:32.24,0:39:33.51,Default,Ikaapat,0,0,0,,Dapat kang matakot
Dialogue: 0,0:39:33.51,0:39:36.41,Default,Fourth,0,0,0,,mas malaki sa akin ang lola ng asawa ko.
Dialogue: 0,0:39:37.11,0:39:39.18,Default,Fourth,0,0,0,,Ano ang sinasabi mo, hindi ganito.
Dialogue: 0,0:39:39.18,0:39:42.42,Default,Ikaapat,0,0,0,,Ang Queen Dowager ay nag-aalaga ng kanyang sarili,
Dialogue: 0,0:39:42.42,0:39:43.72,Default,Fourth,0,0,0,,kaya mukha siyang bata.
Dialogue: 0,0:39:44.19,0:39:46.39,Default,Ika-apat,0,0,0,,Hindi mo maloloko ang oras.
Dialogue: 0,0:39:47.79,0:39:49.46,Default,Ikaapat,0,0,0,,Kailangan mong mag-isip ng mabuti.
Dialogue: 0,0:39:49.89,0:39:52.99,Default,Ikaapat,0,0,0,,Mabubuhay ako nang mas matagal kaysa sa Dowager Queen.
Dialogue: 0,0:39:56.66,0:39:58.47,Default,Ikaapat,0,0,0,,Ihahain ko sa iyo ang aking pagkain balang araw.
Dialogue: 0,0:39:58.47,0:40:00.07,Default,Ikaapat,0,0,0,,Dapat kong subukan ito ngayon.
Dialogue: 0,0:40:00.90,0:40:04.87,Default,Ikaapat,0,0,0,,Nacurious ako sa luto mo,\N na ngayon ko lang narinig.
Dialogue: 0,0:40:04.87,0:40:07.04,Default,Ikaapat,0,0,0,,Walang lakas na maghintay.
Dialogue: 0,0:40:08.24,0:40:10.81,Default,Ikaapat,0,0,0,,Ngayon?
Dialogue: 0,0:40:11.71,0:40:14.65,Default,Ikaapat,0,0,0,,Kaya nagsimula ang pag-uusig ko ng aking biyenan?
Dialogue: 0,0:40:29.50,0:40:31.37,Default,Ikaapat,0,0,0,,Damn, nakakagalit ito.
Dialogue: 0,0:40:35.87,0:40:39.41,Default,Pangapat,0,0,0,,Saan siya nagtatago?
Dialogue: 0,0:40:42.51,0:40:44.11,Default,Ikaapat,0,0,0,,Royal Chef. Kailangan ko ng corn syrup.
Dialogue: 0,0:40:44.11,0:40:47.28,Default,Ikaapat,0,0,0,,At ano ang dapat kong gawin sa isang piging na walang sariwang pagkain?
Dialogue: 0,0:40:47.68,0:40:50.62,Default,Pangapat,0,0,0,,Patay na ang lahat ng bantay malapit sa cart.
Dialogue: 0,0:40:50.62,0:40:51.75,Default,Ikaapat,0,0,0,,Ano ang magagawa ko?
Dialogue: 0,0:40:51.75,0:40:54.19,Default,Ikaapat,0,0,0,,Oh Diyos ko. Halika na.
Dialogue: 0,0:40:55.62,0:40:57.83,Default,Ikaapat,0,0,0,,-Tuyong isda.\N-Ano?
Dialogue: 0,0:40:58.23,0:41:01.16,Default,Ikaapat,0,0,0,,Tuyong isda. Tuyong isda!
Dialogue: 0,0:41:03.80,0:41:06.07,Default,Ikaapat,0,0,0,,Masyadong abala ang royal chef.
Dialogue: 0,0:41:06.47,0:41:08.10,Default,Fourth,0,0,0,,Hindi ko siya mautusan.
Dialogue: 0,0:41:10.54,0:41:12.57,Default,Ikaapat,0,0,0,,Nasaan ang grain syrup?
Dialogue: 0,0:41:29.79,0:41:32.23,Default,Ikaapat,0,0,0,,Sa gabing walang tulog ako naglalakad.
Dialogue: 0,0:41:32.83,0:41:34.50,Default,Ikaapat,0,0,0,,"Sa gabing walang tulog ako ay naglalakad"
Dialogue: 0,0:41:34.90,0:41:37.53,Default,Ikaapat,0,0,0,,Royal Chef! Royal Chef!
Dialogue: 0,0:41:37.53,0:41:39.80,Default,Ikaapat,0,0,0,,-Kamahalan.\N-Kamahalan.
Dialogue: 0,0:41:39.80,0:41:41.00,Default,Ikaapat,0,0,0,,Ano ang nangyari?
Dialogue: 0,0:41:42.94,0:41:44.01,Default,Ikaapat,0,0,0,,Kamahalan.
Dialogue: 0,0:41:57.52,0:42:02.42,Default,Ikaapat,0,0,0,,Ito ay mga mahahalagang produkto. Lahat bulok!
Dialogue: 0,0:42:02.66,0:42:04.63,Default,Ikaapat,0,0,0,,Malamang na hindi tama ang mga ito.
Dialogue: 0,0:42:05.03,0:42:08.30,Default,Ikaapat,0,0,0,,Nararapat akong mamatay, Kamahalan.
Dialogue: 0,0:42:09.20,0:42:10.50,Default,Ikaapat,0,0,0,,Hindi ito maaaring.
Dialogue: 0,0:42:11.23,0:42:14.64,Default,Ikaapat,0,0,0,,Walang sinuman ang sisira sa kanila,\N kung ang kanilang kaligtasan ay natiyak.
Dialogue: 0,0:42:17.51,0:42:18.54,Default,Ikaapat,0,0,0,,Royal Chef!
Dialogue: 0,0:42:19.51,0:42:20.51,Default,Ikaapat,0,0,0,,Kamahalan.
Dialogue: 0,0:42:21.14,0:42:22.18,Default,Pangapat,0,0,0,,May mga problema tayo.
Dialogue: 0,0:42:22.18,0:42:24.28,Default,Ikaapat,0,0,0,,May nagdagdag ng mga bato sa kanin.
Dialogue: 0,0:42:24.51,0:42:27.32,Default,Fourth,0,0,0,,-Ano?\N-Hindi kami makakapagsumite ng anuman.
Dialogue: 0,0:42:29.38,0:42:32.09,Default,Ikaapat,0,0,0,,Huwag mag-alala. Gawin ang lahat ng iyong makakaya sa iyong bahagi.
Dialogue: 0,0:42:32.85,0:42:36.52,Default,Ikaapat,0,0,0,,Gagawin ko ang lahat para makuha ang mga produktong iyon.
Dialogue: 0,0:42:38.99,0:42:40.03,Default,Ikaapat,0,0,0,,Oo.
Dialogue: 0,0:42:49.24,0:42:51.47,Default,Pangapat,0,0,0,,Diyos, ano ang ginagawa mo?
Dialogue: 0,0:42:52.51,0:42:55.21,Default,Ikaapat,0,0,0,,Royal Chef! Hoy!
Dialogue: 0,0:42:55.48,0:42:58.98,Default,Fourth,0,0,0,,Kailangan kong ipakita sa kanya kung paano ako nagdadala ng pagkain sa sarili ko.
Dialogue: 0,0:42:59.41,0:43:01.55,Default,Fourth,0,0,0,,Ito ay magpapagaan sa kanyang pakiramdam, tama ba?
Dialogue: 0,0:43:10.22,0:43:12.46,Default,Ikaapat,0,0,0,,Ang kumbinasyon ng matamis na syrup at asin ang ginagawa
Dialogue: 0,0:43:12.46,0:43:13.83,Default,Ikaapat,0,0,0,,perpektong matamis at maalat na ulam.
Dialogue: 0,0:43:24.64,0:43:32.51,Default,Ikaapat,0,0,0,,Doon ko nakikita ang isang magandang bundok...
Dialogue: 0,0:43:44.53,0:43:45.73,Default,Ikaapat,0,0,0,,Direktor Han?
Dialogue: 0,0:43:47.50,0:43:48.50,Default,Pangapat,0,0,0,,Bastos ka!
Dialogue: 0,0:43:49.50,0:43:50.50,Default,Ikaapat,0,0,0,,Paano mo magagawa?
Dialogue: 0,0:44:06.38,0:44:09.88,Default,Ikaapat,0,0,0,,Aking popcorn!
Dialogue: 0,0:44:13.05,0:44:14.12,Default,Ikaapat,0,0,0,,Damn!
Dialogue: 0,0:44:17.49,0:44:19.13,Default,Pangapat,0,0,0,,Nakakaloka!
Dialogue: 0,0:44:38.18,0:44:40.11,Default,Ikaapat,0,0,0,,Nasaan ang treat?
Dialogue: 0,0:44:40.48,0:44:41.68,Default,Ikaapat,0,0,0,,Well...
Dialogue: 0,0:44:51.69,0:44:52.76,Default,Ikaapat,0,0,0,,Narito.
Dialogue: 0,0:44:56.13,0:44:58.67,Default,Ikaapat,0,0,0,,Abangan ang iyong buhay sa palasyo.
Dialogue: 0,0:45:08.34,0:45:09.61,Default,Ikaapat,0,0,0,,Dahil sa nangyayari,
Dialogue: 0,0:45:09.61,0:45:11.28,Default,Ikaapat,0,0,0,,dapat kang kumuha ng pagkain,
Dialogue: 0,0:45:11.28,0:45:13.41,Default,Ikaapat,0,0,0,,kapag tapos ka na sa martial arts.
Dialogue: 0,0:45:13.95,0:45:14.95,Default,Ikaapat,0,0,0,,Oo.
Dialogue: 0,0:45:23.09,0:45:26.69,Default,Ikaapat,0,0,0,,Salamat sa pag-imbita sa amin sa handaan.
Dialogue: 0,0:45:27.90,0:45:29.90,Default,Ikaapat,0,0,0,,Nararapat kang narito.
Dialogue: 0,0:45:30.97,0:45:32.83,Default,Ikaapat,0,0,0,,Magaling ang mga concubines.
Dialogue: 0,0:45:33.50,0:45:35.20,Default,Fourth,0,0,0,,Sana maging okay din sa iyo ang lahat.
Dialogue: 0,0:45:35.34,0:45:36.60,Default,Ikaapat,0,0,0,,-Oo.\N-Oo.
Dialogue: 0,0:45:37.07,0:45:40.07,Default,Ikaapat,0,0,0,,Sa anumang kaso, magkaroon ng magandang araw ngayon.
Dialogue: 0,0:46:54.85,0:46:56.58,Default,Ikaapat,0,0,0,,Dumating na ba ang Inang Reyna?
Dialogue: 0,0:46:57.12,0:46:58.62,Default,Ikaapat,0,0,0,,Aalamin ko.
Dialogue: 0,0:47:09.33,0:47:11.90,Default,Ikaapat,0,0,0,,Akala mo tumakas.
Dialogue: 0,0:47:12.00,0:47:13.20,Default,Ikaapat,0,0,0,,Siyempre hindi.
Dialogue: 0,0:47:13.70,0:47:17.41,Default,Ikaapat,0,0,0,,Kung may nakagawa ng krimen,\Ndapat siyang parusahan nang naaayon.
Dialogue: 0,0:47:17.57,0:47:19.74,Default,Ikaapat,0,0,0,,Natutuwa kang alam mo.
Dialogue: 0,0:47:21.18,0:47:23.71,Default,Ikaapat,0,0,0,,Pinadalhan ako ng reyna ng meryenda kaninang umaga,
Dialogue: 0,0:47:23.71,0:47:26.58,Default,Fourth,0,0,0,,at nagsimula akong maghanda nang huli dahil sinubukan ko sila.
Dialogue: 0,0:47:27.72,0:47:28.98,Default,Ikaapat,0,0,0,,Reyna?
Dialogue: 0,0:47:36.92,0:47:39.03,Default,Ikaapat,0,0,0,,Pakiramdam ko ay mamamatay ako, naipit sa pagitan ng dalawang apoy.
Dialogue: 0,0:47:44.33,0:47:46.60,Default,Ikaapat,0,0,0,,Ilang uri ng hindi pagkakaunawaan muli?
Dialogue: 0,0:47:49.97,0:47:51.81,Default,Ikaapat,0,0,0,,Halika.
Dialogue: 0,0:48:26.17,0:48:29.91,Default,Ikaapat,0,0,0,,Ang royal guards ay naghanda\N ng martial arts display.
Dialogue: 0,0:48:48.23,0:48:49.60,Default,Ikaapat,0,0,0,,Atensyon!
Dialogue: 0,0:48:50.46,0:48:51.70,Default,Ikaapat,0,0,0,,Unang round.
Dialogue: 0,0:48:55.84,0:48:59.87,Default,Ika-apat,0,0,0,,Gaano kalakas ang loob niyang subukang \N saktan ang reyna gamit ang espadang iyon?
Dialogue: 0,0:49:04.95,0:49:06.08,Default,Ikaapat,0,0,0,,Labanan.
Dialogue: 0,0:50:34.44,0:50:38.17,Default,Ikaapat,0,0,0,,Wow. Napakahusay ng paghahanda ng hari.
Dialogue: 0,0:50:54.05,0:50:58.23,Default,Ikaapat,0,0,0,,Ang Dowager Queen. Oras na para manghuli.
Dialogue: 0,0:51:00.49,0:51:03.30,Default,Ikaapat,0,0,0,,Kamahalan. \NIOras na para magpalit ng damit sa pangangaso.
Dialogue: 0,0:51:08.57,0:51:10.77,Default,Ikaapat,0,0,0,,Babalik ako, Dowager Queen.
Dialogue: 0,0:51:12.77,0:51:14.88,Default,Ikaapat,0,0,0,,Babalik ako.
Dialogue: 0,0:52:05.59,0:52:08.53,Default,Ikaapat,0,0,0,,Unang linya, handang magpaputok.
Dialogue: 0,0:52:11.93,0:52:13.10,Default,Ikaapat,0,0,0,,Sunog!
Dialogue: 0,0:52:22.34,0:52:23.44,Default,Ikaapat,0,0,0,,Sunog!
Dialogue: 0,0:52:28.38,0:52:29.48,Default,Ikaapat,0,0,0,,Sunog!
Dialogue: 0,0:52:44.00,0:52:45.67,Default,Fourth,0,0,0,,Akala ko for show lang.
Dialogue: 0,0:53:09.82,0:53:12.06,Default,Ikaapat,0,0,0,,Ang mga bagay ang pangunahing bagay.
Dialogue: 0,0:53:15.33,0:53:16.80,Default,Ikaapat,0,0,0,,Sa tingin ko ay mukhang cool ako.
Dialogue: 0,0:53:17.03,0:53:19.53,Default,Ikaapat,0,0,0,,Gusto ko. Mukha akong cool.
Dialogue: 0,0:53:27.31,0:53:29.21,Default,Fifth,0,0,0,,Bakit napakalaban niya?
Dialogue: 0,0:53:29.44,0:53:32.15,Default,Fifth,0,0,0,,Palaging may mga taong sineseryoso ang mga kumpetisyon.
Dialogue: 0,0:53:33.51,0:53:34.82,Default,Fifth,0,0,0,,Anong klaseng hitsura ito?
Dialogue: 0,0:53:36.42,0:53:39.49,Default,Ikalimang,0,0,0,,1 puntos para sa isang ibon, 2 puntos para sa isang kuneho,
Dialogue: 0,0:53:39.79,0:53:42.92,Default,Ikalimang,0,0,0,,para sa badger - 3 puntos, para sa bulugan - 4,
Dialogue: 0,0:53:43.19,0:53:46.09,Default,Ikalimang,0,0,0,,usa - 5 puntos, lobo - 7,
Dialogue: 0,0:53:46.16,0:53:50.20,Default,Ikalimang,0,0,0,,bear - 9 at tigre - 10 puntos.
Dialogue: 0,0:53:50.20,0:53:51.23,Default,Ikalimang,0,0,0,,Lobo, tigre, kuneho, usa.
Dialogue: 0,0:53:51.23,0:53:52.97,Default,Ikalimang,0,0,0,,Bibigyan ang bawat isa ng 10 arrow.
Dialogue: 0,0:53:53.43,0:53:56.37,Default,Ikalimang,0,0,0,,Para sa kapakanan ng isang patas na laban, ang iyong mga babae sa hukuman at mga kasambahay
Dialogue: 0,0:53:56.37,0:53:57.67,Default,Ikalimang,0,0,0,,hindi sasali.
Dialogue: 0,0:53:58.61,0:54:00.21,Default,Ikalimang,0,0,0,,Mahirap iyon.
Dialogue: 0,0:54:00.64,0:54:02.04,Default,Ikalimang,0,0,0,,Ngayon ay gagawin nito ang mga tao
Dialogue: 0,0:54:02.04,0:54:03.48,Default,Ikalimang,0,0,0,,pirmahan ang pambansang petisyon.
Dialogue: 0,0:54:03.91,0:54:06.65,Default,Ikalimang,0,0,0,,Pagkatapos ay oras na para magsimula.
Dialogue: 0,0:54:17.06,0:54:19.46,Default,Ikalimang,0,0,0,,Maaari ka nang umalis.
Dialogue: 0,0:54:26.17,0:54:28.90,Default,Fifth,0,0,0,,Kailangan na lang nating pumatay ng oras dito at bumalik.
Dialogue: 0,0:54:46.09,0:54:49.29,Default,Ikalimang,0,0,0,,Nahuhulaan ang shooting match ngayon.
Dialogue: 0,0:54:50.26,0:54:52.59,Default,Ikalimang,0,0,0,,Ito ay isang laban para sa karangalan ng pamilya,
Dialogue: 0,0:54:53.06,0:54:55.80,Default,Fifth,0,0,0,,pero mukhang hindi interesado ang reyna.
Dialogue: 0,0:54:56.03,0:54:59.63,Default,Fifth,0,0,0,,Hindi ko alam na may oras ka pang mag-alala tungkol sa isang joke fight.
Dialogue: 0,0:55:00.07,0:55:03.14,Default,Fifth,0,0,0,,Maaaring makita mo ang iyong anak ngayon.
Dialogue: 0,0:55:08.58,0:55:10.94,Default,Ikalimang,0,0,0,,Dumating na ang oras para iharap ang aking regalo.
Dialogue: 0,0:55:12.35,0:55:14.58,Default,Ikalimang,0,0,0,,Nang gabing iyon nang ang reyna ay nahulog sa isang vegetative state,
Dialogue: 0,0:55:14.58,0:55:17.55,Default,Fifth,0,0,0,,magsasalo sa kama ang royal concubine at ang hari.
Dialogue: 0,0:55:17.95,0:55:19.95,Default,Ikalimang,0,0,0,,Nagising na ang Reyna
Dialogue: 0,0:55:19.95,0:55:22.66,Default,Ikalimang,0,0,0,,isang araw lang pagkatapos noon.
Dialogue: 0,0:55:25.29,0:55:26.66,Default,Ikalimang,0,0,0,,Ibig mong sabihin nagkunwari siya,
Dialogue: 0,0:55:26.66,0:55:29.66,Default,Fifth,0,0,0,,para pigilan sila?
Dialogue: 0,0:55:31.23,0:55:33.97,Default,Ikalimang,0,0,0,,Inilagay ng Reyna ang lahat sa linya,
Dialogue: 0,0:55:33.97,0:55:35.67,Default,Ikalimang,0,0,0,,upang makuha ang puso ng hari.
Dialogue: 0,0:55:36.24,0:55:37.87,Default,Ikalimang,0,0,0,,Itinapon ang sarili sa lawa,
Dialogue: 0,0:55:37.87,0:55:40.24,Default,Fifth,0,0,0,,protektahan ang royal concubine mula sa espada.
Dialogue: 0,0:55:40.97,0:55:43.81,Default,Ikalimang,0,0,0,,Isinakripisyo ang huling bagay na naiwan niya.
Dialogue: 0,0:55:47.05,0:55:49.88,Default,Ikalimang,0,0,0,,Tinanggihan ng reyna ang kanyang pamilya.
Dialogue: 0,0:55:59.16,0:56:02.63,Default,Fifth,0,0,0,,Nainis ako, at nilibang mo ako.
Dialogue: 0,0:56:03.43,0:56:07.43,Default,Ikalimang,0,0,0,,Naghagis ng piging ang hari nang walang dahilan.
Dialogue: 0,0:56:07.87,0:56:10.04,Default,Ikalimang,0,0,0,,At nagmadali ang reyna para kunin ang mga babae
Dialogue: 0,0:56:10.04,0:56:12.54,Default,Ikalimang,0,0,0,,sa mga pinaka-maimpluwensyang pamilya.
Dialogue: 0,0:56:12.71,0:56:15.84,Default,Fifth,0,0,0,,Pinili ko ang mga makakasuporta sa hari.
Dialogue: 0,0:56:16.64,0:56:19.78,Default,Ikalimang,0,0,0,,Ngayon ay ibubunyag ng hari ang kanyang tunay na mukha,
Dialogue: 0,0:56:19.78,0:56:22.28,Default,Ikalimang,0,0,0,,na nakatago pa rin sa mga opisyal.
Dialogue: 0,0:56:22.62,0:56:25.09,Default,Ikalimang,0,0,0,,Ang mukha ng isang malakas na pinuno.
Dialogue: 0,0:56:28.56,0:56:30.49,Default,Ikalimang,0,0,0,,Naiintindihan mo na ba ngayon?
Dialogue: 0,0:56:31.16,0:56:33.86,Default,Ikalimang,0,0,0,,Ang reyna ay kaisa ng hari.
Dialogue: 0,0:56:33.86,0:56:37.50,Default,Fifth,0,0,0,,Hindi ka ba natatakot para sa iyong buhay, na sinasabi ito?
Dialogue: 0,0:56:37.86,0:56:41.03,Default,Fifth,0,0,0,,At malamang na naniniwala ka na hinding-hindi ka magtataksil ang reyna.
Dialogue: 0,0:56:42.30,0:56:44.50,Default,Ikalimang,0,0,0,,Sobrang disappointed ako.
Dialogue: 0,0:56:44.91,0:56:47.21,Default,Ikalimang,0,0,0,,Nahulog sa kanyang murang mga trick
Dialogue: 0,0:56:47.21,0:56:48.84,Default,Ikalimang,0,0,0,,at hayaan ang kanilang sarili na lokohin.
Dialogue: 0,0:56:49.48,0:56:52.21,Default,Fifth,0,0,0,,Mukhang tumanda na sila.
Dialogue: 0,0:56:53.98,0:56:56.38,Default,Ikalimang,0,0,0,,Puputulin ko itong masasamang labi.
Dialogue: 0,0:56:56.38,0:56:59.65,Default,Fifth,0,0,0,,Nagkunwaring nahimatay ang Reyna, walang kasalanan sa akin.
Dialogue: 0,0:56:59.65,0:57:03.46,Default,Fifth,0,0,0,,At wala na akong dapat katakutan!
Dialogue: 0,0:57:08.46,0:57:10.46,Default,Fifth,0,0,0,,Bakit ka huminto sa paglalaro?
Dialogue: 0,0:57:10.76,0:57:13.83,Default,Fifth,0,0,0,,Ginagalit mo ang dowager queen.
Dialogue: 0,0:57:27.75,0:57:29.15,Default,Ikalimang,0,0,0,,At ngayon
Dialogue: 0,0:57:29.15,0:57:33.45,Default,Fifth,0,0,0,,ibibigay sa iyo ng hari ang mga tagahanga.
Dialogue: 0,0:57:55.38,0:57:58.61,Default,Ikalimang,0,0,0,,Magaling ang ginawa mo. Inaasahan ko ang kapistahan.
Dialogue: 0,0:57:59.68,0:58:02.35,Default,Fifth,0,0,0,,Magaling ka rin.
Dialogue: 0,0:58:08.62,0:58:11.26,Default,Fifth,0,0,0,,Dumating na ang Dowager Queen.
Dialogue: 0,0:58:16.10,0:58:17.20,Default,Ikalimang,0,0,0,,Nandito ka.
Dialogue: 0,0:58:21.20,0:58:23.47,Default,Fifth,0,0,0,,Nakakabagot doon.
Dialogue: 0,0:58:23.47,0:58:24.87,Default,Fifth,0,0,0,,Hindi ako nakatiis.
Dialogue: 0,0:58:26.87,0:58:29.51,Default,Fifth,0,0,0,,I wonder if it will be better here.
Dialogue: 0,0:58:30.21,0:58:32.51,Default,Fifth,0,0,0,,Paumanhin hindi kita mapasaya.
Dialogue: 0,0:58:34.55,0:58:37.25,Default,Fifth,0,0,0,,Gusto kong tumingin sa martial arts, pero huli na ako.
Dialogue: 0,0:58:39.75,0:58:43.59,Default,Fifth,0,0,0,, Bagama't nakakainip din ang panonood ng mga palabas.
Dialogue: 0,0:58:45.93,0:58:49.10,Default,Ikalimang,0,0,0,,Mas gusto ko ang mga totoong laban.
Dialogue: 0,0:58:50.53,0:58:52.63,Default,Fifth,0,0,0,,Uutusan ko ang royal guard na makipagkumpitensya sa isa't isa.
Dialogue: 0,0:58:53.53,0:58:55.24,Default,Ikalimang,0,0,0,,Paano kung magsalita ang iyong sarili?
Dialogue: 0,0:58:59.44,0:59:01.58,Default,Ikalimang,0,0,0,,Narinig kong nagpuputol ka ng kahoy sa Ganghwado
Dialogue: 0,0:59:01.58,0:59:04.31,Default,Fifth,0,0,0,,at siya mismo ang nagdala ng tubig.
Dialogue: 0,0:59:05.18,0:59:08.05,Default,Fifth,0,0,0,,Sa ganito at ganoong powerhouse hindi ito magiging mahirap.
Dialogue: 0,0:59:11.12,0:59:13.79,Default,Ikalimang,0,0,0,,Ibang-iba ang manual labor at martial arts.
Dialogue: 0,0:59:14.39,0:59:17.49,Default,Ikalimang,0,0,0,,At sa mga nakalipas na taon ay lalo akong nakaupo sa trono.
Dialogue: 0,0:59:17.49,0:59:18.89,Default,Ikalimang,0,0,0,,Ang katawan ay naging ganap na kahoy.
Dialogue: 0,0:59:18.89,0:59:21.26,Default,Fifth,0,0,0,,Well, gumamit ng fan sa halip na armas.
Dialogue: 0,0:59:24.80,0:59:27.70,Default,Fifth,0,0,0,,Paano ang isang kompetisyon sa pinuno ng Detective Department?
Dialogue: 0,0:59:27.70,0:59:29.20,Default,Fifth,0,0,0,,Magkasing edad lang kayo.
Dialogue: 0,0:59:32.41,0:59:33.64,Default,Ikalimang,0,0,0,,Head ng Detective Department -
Dialogue: 0,0:59:33.64,0:59:35.91,Default,Ikalimang,0,0,0,,isang propesyonal na mandirigma na nagsanay sa loob ng maraming taon.
Dialogue: 0,0:59:36.88,0:59:38.95,Default,Fifth,0,0,0,,Natatakot ako na baka masaktan ang hari.
Dialogue: 0,0:59:38.95,0:59:40.35,Default,Fifth,0,0,0,,Kung gusto mong makita ang laban, iimbitahan ko...
Dialogue: 0,0:59:40.35,0:59:43.22,Default,Fifth,0,0,0,,Gusto kong makitang lumaban ang hari.
Dialogue: 0,0:59:48.92,0:59:50.26,Default,Ikalimang,0,0,0,,Ano ang masasabi mo?
Dialogue: 0,0:59:53.39,0:59:55.40,Default,Ikalimang,0,0,0,,Mali si Itay.
Dialogue: 0,0:59:57.03,1:00:00.93,Default,Ikalimang,0,0,0,,Pakitingnan ang kanyang totoong mukha sa Cart Day.
Dialogue: 0,1:00:11.81,1:00:13.21,Default,Ikalimang,0,0,0,,Deer.
Dialogue: 0,1:00:21.42,1:00:22.46,Default,Ikalimang,0,0,0,,Paano kaya?
Dialogue: 0,1:00:23.62,1:00:24.66,Default,Ikalimang,0,0,0,, Bear.
Dialogue: 0,1:00:54.02,1:00:55.16,Default,Ikalimang,0,0,0,,Go.
Dialogue: 0,1:00:55.16,1:00:57.32,Default,Fifth,0,0,0,,Hindi ikaw ang biktima na hinahanap ko.
Dialogue: 0,1:01:10.97,1:01:12.11,Default,Ikalimang,0,0,0,,Napunta sa maling lugar?
Dialogue: 0,1:01:16.08,1:01:17.64,Default,Fifth,0,0,0,,Mukhang nakita ko na itong puno.
Dialogue: 0,1:01:19.75,1:01:21.68,Default,Ikalimang,0,0,0,,At saan ako pupunta?
Dialogue: 0,1:01:25.82,1:01:27.52,Default,Ikalimang,0,0,0,,Magkakaroon tayo ng mga tagahanga sa ating mga kamay.
Dialogue: 0,1:01:27.89,1:01:30.72,Default,Fifth,0,0,0,,Ang kukuha ng fan sa kalaban ang mananalo.
Dialogue: 0,1:01:34.19,1:01:35.53,Default,Ikalimang,0,0,0,,Madali.
Dialogue: 0,1:02:04.19,1:02:06.36,Default,Ikalimang,0,0,0,,Ano ang nangyayari?
Dialogue: 0,1:02:08.19,1:02:10.06,Default,Fifth,0,0,0,,Sabi ko, dahan-dahan lang.
Dialogue: 0,1:02:11.16,1:02:13.73,Default,Fifth,0,0,0,,Paano ka tutugon kung nasaktan mo ang hari?
Dialogue: 0,1:02:15.70,1:02:18.31,Default,Ikalimang,0,0,0,,Ito ang utos ng Dowager Queen.
Dialogue: 0,1:02:18.31,1:02:20.07,Default,Ikalimang,0,0,0,,Wala nang magagawa kundi kumpletuhin ito.
Dialogue: 0,1:02:25.11,1:02:28.11,Default,Fifth,0,0,0,,Kaya ang dowager queen ay nasa likod mo.
Dialogue: 0,1:02:32.69,1:02:35.22,Default,Fifth,0,0,0,,Kaya kailangan kitang turuan ng leksyon.
Dialogue: 0,1:02:35.22,1:02:37.32,Default,Fifth,0,0,0,,Ipapakita ko sa iyo kung sino ang boss sa palasyo.
Dialogue: 0,1:03:00.78,1:03:02.42,Default,Fifth,0,0,0,,Sabi mo iba siya sa yumaong hari.
Dialogue: 0,1:03:02.98,1:03:04.58,Default,Ikalimang,0,0,0,,At iba ang katotohanan.
Dialogue: 0,1:03:08.79,1:03:10.42,Default,Ikalimang,0,0,0,,Well, okay.
Dialogue: 0,1:03:10.42,1:03:13.13,Default,Fifth,0,0,0,,Kailangan kong umidlip. Hahanapin nila ako kapag natapos na ang lahat.
Dialogue: 0,1:03:16.26,1:03:17.36,Default,Fifth,0,0,0,,Damn, tinakot kita!
Dialogue: 0,1:03:19.07,1:03:20.23,Default,Fifth,0,0,0,,Anong ginagawa mo dito?
Dialogue: 0,1:03:22.04,1:03:25.14,Default,Ikalimang,0,0,0,,Ano sa tingin mo? Nagtatago ako para mabuhay.
Dialogue: 0,1:03:25.71,1:03:28.17,Default,Fifth,0,0,0,,Well, hindi ka talaga mamamatay. Bakit takot na takot ka?
Dialogue: 0,1:03:28.41,1:03:32.31,Default,Fifth,0,0,0,,Alam ko, pero masakit pa rin ang mga arrow.
Dialogue: 0,1:03:32.91,1:03:34.95,Default,Fifth,0,0,0,,May mga pasa pa ako noong nakaraang taon.
Dialogue: 0,1:03:34.95,1:03:36.12,Default,Ikalimang,0,0,0,,Nakakatuwa.
Dialogue: 0,1:03:37.78,1:03:39.85,Default,Fifth,0,0,0,,Huwag kang matakot, hindi ako tinutukso ng pangangaso.
Dialogue: 0,1:03:40.45,1:03:43.86,Default,Fifth,0,0,0,,Well, tatamaan ako ng iba.
Dialogue: 0,1:03:55.50,1:03:56.87,Default,Ikalimang,0,0,0,,Narito.
Dialogue: 0,1:03:57.20,1:03:59.31,Default,Fifth,0,0,0,,Paano ka nakabalik ng ganyan?
Dialogue: 0,1:04:00.44,1:04:01.47,Default,Ikalimang,0,0,0,,Tigre.
Dialogue: 0,1:04:06.88,1:04:07.95,Default,Ikalimang,0,0,0,,So?
Dialogue: 0,1:04:08.88,1:04:11.62,Default,Ikalimang,0,0,0,,Salamat, Kamahalan.
Dialogue: 0,1:04:11.62,1:04:12.89,Default,Ikalimang,0,0,0,,Itago ang souvenir.
Dialogue: 0,1:04:14.12,1:04:15.22,Default,Ikalimang,0,0,0,,Go.
Dialogue: 0,1:04:17.19,1:04:18.96,Default,Ikalimang,0,0,0,,Na?
Dialogue: 0,1:04:20.83,1:04:22.60,Default,Fifth,0,0,0,,Hindi ko alam na magaling pala ang reyna sa shooting,
Dialogue: 0,1:04:22.60,1:04:25.30,Default,Ikalimang,0,0,0,,upang tamaan ang tigre nang napakabilis.
Dialogue: 0,1:04:25.30,1:04:27.57,Default,Ikalimang,0,0,0,,Oo, siya ay ipinanganak na mamamana.
Dialogue: 0,1:04:27.57,1:04:30.87,Default,Fifth,0,0,0,,Hindi ko man lang siya nakita, hangin lang ang sumipol sa tenga ko.
Dialogue: 0,1:04:30.87,1:04:33.47,Default,Fifth,0,0,0,,Kaya binaril nila ako.
Dialogue: 0,1:04:33.47,1:04:34.57,Default,Ikalimang,0,0,0,,Talaga?
Dialogue: 0,1:06:13.11,1:06:14.21,Default,Ikalimang,0,0,0,,Kaya ikaw iyon.
Dialogue: 0,1:06:14.97,1:06:16.91,Default,Ikalimang,0,0,0,,Ikaw ang taong iyon.
Dialogue: 0,1:06:20.21,1:06:22.05,Default,Fifth,0,0,0,,Hindi kita patatawarin.
Dialogue: 0,1:06:42.00,1:06:44.97,Default,Ikalimang,0,0,0,,Papatayin kita.
Dialogue: 0,1:07:05.53,1:07:10.00,Default,Ikalimang,0,0,0,,Paano ako naging reyna
Dialogue: 0,1:07:25.41,1:07:27.68,Default,Ikalimang,0,0,0,,Mayroon akong malungkot na balita.
Dialogue: 0,1:07:27.68,1:07:29.05,Default,Ikalimang,0,0,0,, Nanginginig ang kamay ko
Dialogue: 0,1:07:29.05,1:07:30.98,Default,Fifth,0,0,0,,at ako ang gumanap na reyna.
Dialogue: 0,1:07:30.98,1:07:33.25,Default,Ikalimang,0,0,0,,Magsisimula na ang kapistahan, ngunit hindi pa dumarating ang mga sangkap.
Dialogue: 0,1:07:33.25,1:07:34.32,Default,Ikalimang,0,0,0,,Yun lang ba?
Dialogue: 0,1:07:34.32,1:07:35.89,Default,Ikalimang,0,0,0,,Nagdagdag ka ba ng lason?
Dialogue: 0,1:07:36.06,1:07:37.56,Default,Ikalimang,0,0,0,,Pangalan - Lee Senman.
Dialogue: 0,1:07:37.89,1:07:39.76,Default,Ikalimang,0,0,0,,Gawa ako ng bagong menu mula sa mga sangkap na available.
Dialogue: 0,1:07:39.76,1:07:41.93,Default,Ikalimang,0,0,0,,Ang lakas ng loob mong iprito ang aking mahalagang karayom.
Dialogue: 0,1:07:41.93,1:07:44.40,Default,Fifth,0,0,0,,Hindi simpleng pagkain ang lulutuin natin ngayon.
Dialogue: 0,1:07:44.40,1:07:45.67,Default,Ikalimang,0,0,0,,Siya ay karapat-dapat sa isang presidente.
Dialogue: 0,1:07:45.93,1:07:47.97,Default,Fifth,0,0,0,,Gaano ka kalakas-loob na sumuway sa utos ng iyong amo?
Dialogue: 0,1:07:47.97,1:07:50.40,Default,Fifth,0,0,0,,{\i1}-Kunin sila!\N-Hindi ito pagtataksil, kundi pagrerebelde!{\i}
Dialogue: 0,1:07:50.40,1:07:53.67,Default,Ikalimang,0,0,0,,Kailangan mong magbayad para sa kakayahang kontrolin ang iyong karakter.
Dialogue: 0,0:13:59.93,0:14:01.93,Default,,0,0,0,,


