Dialog: 0,0:00:58.00,0:01:03.98,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДСТАВЛЯЕТ
Dialog: 0,0:00:58.00,0:01:03.98,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807\fscy277}m 0 0 l 0 0 l 92 0 aku 92 38 aku 0 38
Dialog: 0,0:00:58.00,0:01:03.98,работали,,0,0,0,,{\pos(801,256)}Над серией работали:\N Лилия, Тирамису, Бирюлька, Хозяин, Зингер
Dialogue: 0,0:00:58.00,0:01:03.98,title,,0,0,0,,{\fscx75\fscy75\pos(846,392)}Bagaimana jadinya aku
Dialog: 0,0:00:58.00,0:01:03.98,nama,,0,0,0,,{\fscx75\fscy75\pos(848,456)}ratu
Dialog: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialog: 0,0:01:24.85,0:01:25.88,Default,Spillik1,0,0,0,,Hwajin.
Dialog: 0,0:01:26.78,0:01:27.78,Default,Spillik1,0,0,0,,Hwajin.
Dialogue: 0,0:01:38.66,0:01:40.03,Default,Spillik1,0,0,0,,Apa yang tergeletak disana?
Dialog: 0,0:01:43.40,0:01:45.70,Default,Spikyulka1,0,0,0,,-Baiklah, saya sedang mencari bantuan.\N-Tidak.
Dialogue: 0,0:01:46.90,0:01:49.44,Default,Spillik1,0,0,0,,Tak seorang pun boleh tahu kalau aku...
Dialog: 0,0:01:50.67,0:01:52.77,Default,Spilyk1,0,0,0,,Apa aku...
Dialog: 0,0:01:54.17,0:01:55.18,Default,Spilyk1,0,0,0,,Tunggu.
Dialog: 0,0:01:59.38,0:02:02.28,Default,Spillik1,0,0,0,,10 episode.
Dialog: 0,0:02:03.42,0:02:06.49,Default,Spikyulka1,0,0,0,,Mengapa kamu pergi ke sana, di mana terdapat kenangan yang begitu buruk?
Dialog: 0,0:02:07.29,0:02:08.86,Default,Spilyk1,0,0,0,,Apakah kamu yakin tidak bisa menelepon siapa pun?
Dialog: 0,0:02:09.72,0:02:11.29,Default,Spikyulka1,0,0,0,,Bagaimana jika dia mati pada akhirnya?
Dialog: 0,0:02:15.06,0:02:16.46,Default,Spillik1,0,0,0,,Apakah kamu mengalami mimpi buruk lagi?
Dialog: 0,0:02:16.66,0:02:19.03,Default,Spillik1,0,0,0,,Hei, bangun.
Dialog: 0,0:02:25.34,0:02:26.34,Default,Spillik1,0,0,0,,Hwajin.
Dialog: 0,0:02:28.14,0:02:30.91,Default,Spillik1,0,0,0,,Luar Biasa. Pikirkan apa yang Anda inginkan.
Dialog: 0,0:02:38.29,0:02:40.39,Default,Spillik1,0,0,0,,Itu tidak bagus. Aku akan pergi mencari seseorang.
Dialog: 0,0:02:43.96,0:02:45.03,Default,Spillik1,0,0,0,,Nah, ini dia lagi.
Dialog: 0,0:02:45.23,0:02:46.83,Default,Spillik1,0,0,0,,Saya bermimpi buruk,
Dialog: 0,0:02:50.10,0:02:52.23,Default,Spillik1,0,0,0,,bahwa aku mati sebagai raja yang tidak berharga.
Dialog: 0,0:02:53.37,0:02:55.07,Default,Spillik1,0,0,0,,Mimpi buruk yang menakutkan, di mana aku
Dialog: 0,0:02:56.64,0:02:59.87,Default,Spilyk1,0,0,0,,melihat dunia runtuh
Dialog: 0,0:03:00.67,0:03:03.91,Default,Spillik1,0,0,0,,dan tidak bisa berbuat apa-apa.
Dialog: 0,0:03:07.45,0:03:08.82,Default,Spilyk1,0,0,0,,Tidak ada yang bertanya.
Dialog: 0,0:03:11.15,0:03:13.65,Default,Spillik1,0,0,0,,Mari kita berbaring di sana sebentar.
Dialog: 0,0:03:15.79,0:03:17.02,Default,Spillik1,0,0,0,,Tunggu sebentar.
Dialog: 0,0:03:24.76,0:03:28.27,Default,Spillik1,0,0,0,,Aku akan berpura-pura menjadi Hwajin sejenak.
Dialog: 0,0:03:40.15,0:03:42.95,Default,Spillik1,0,0,0,,10 episode: Kehidupan dalam Mimpi Buruk
Dialog: 0,0:03:44.78,0:03:46.52,Default,Spillik1,0,0,0,,Akhirnya, kamu telah menjadi seorang ratu.
Dialog: 0,0:03:47.12,0:03:49.12,Default,Spillik1,0,0,0,,Tahu akan seperti ini.
Dialog: 0,0:04:44.84,0:04:46.55,Default,Spilyk1,0,0,0,,Rahasia
Dialog: 0,0:04:53.89,0:04:55.66,Default,Spillik1,0,0,0,,Saya akan menceritakan segalanya kepada Yang Mulia.
Dialog: 0,0:04:56.42,0:04:58.26,Default,Spillik1,0,0,0,,Agar masa lalu tidak lagi mempengaruhi kita.
Dialog: 0,0:05:06.80,0:05:07.83,Default,Spillik1,0,0,0,,Yang Mulia.
Dialog: 0,0:05:09.60,0:05:11.24,Default,Spillik1,0,0,0,,Saya perlu bicara dengan Yang Mulia.
Dialog: 0,0:05:11.67,0:05:14.71,Default,Spillik1,0,0,0,,Raja dan ratu keluar,
Dialog: 0,0:05:15.04,0:05:17.01,Default,Spikyulka1,0,0,0,,dan bahkan Tuan Kim tidak ada di rumah.
Dialog: 0,0:06:07.96,0:06:09.00,Default,Spilyk1,0,0,0,,Ovol.
Dialog: 0,0:06:09.46,0:06:13.30,Default,Spillik1,0,0,0,,Saya dapat membantu raja dan menghancurkan ratu.
Dialogue: 0,0:06:14.50,0:06:15.80,Default,Spillik1,0,0,0,,Apa yang harus kulakukan?
Dialog: 0,0:07:00.91,0:07:02.02,Default,Spillik1,0,0,0,,Yang Mulia.
Dialog: 0,0:07:06.65,0:07:09.59,Default,Spilyk1,0,0,0,,Waktunya mencuci.
Dialog: 0,0:07:58.57,0:07:59.71,Default,Spillik1,0,0,0,,Selamat pagi.
Dialog: 0,0:08:02.98,0:08:05.31,Default,Spikyulka1,0,0,0,,-Apa yang terjadi?\N-Pertanyaan bagus.
Dialog: 0,0:08:05.31,0:08:08.28,Default,Silk1,0,0,0,,Aku hampir menyentuhmu... Artinya, aku hampir mati.
Dialog: 0,0:08:08.78,0:08:10.45,Default,Spilyk1,0,0,0,,Kamu berat sekali.
Dialog: 0,0:08:13.42,0:08:14.62,Default,Spillik1,0,0,0,,Itu berbahaya.
Dialog: 0,0:08:17.16,0:08:19.03,Default,Spikyulka1,0,0,0,,Buku akuntansi tidak ada.
Dialog: 0,0:08:20.43,0:08:22.13,Default,Spillik1,0,0,0,,Kamu menyelamatkanku
Dialog: 0,0:08:22.63,0:08:23.70,Default,Spillik1,0,0,0,,dirinya sendiri?
Dialog: 0,0:08:26.53,0:08:28.13,Default,Spillik1,0,0,0,,Kamu tidak ingin aku memanggil bantuan.
Dialog: 0,0:08:30.34,0:08:33.24,Default,Spikyulka1,0,0,0,,Aku harus mengerahkan seluruh kekuatanku.
Dialog: 0,0:08:37.84,0:08:40.75,Default,Spilyk1,0,0,0,,Saya bisa. Ingatlah hari ketika Anda harus mengangkat 150 kg.
Dialog: 0,0:08:41.61,0:08:43.35,Default,Spillik1,0,0,0,,Kekuatan bukan pada otot,
Dialog: 0,0:08:43.72,0:08:46.95,Default,Spillik1,0,0,0,,dan dalam penentuan.
Dialog: 0,0:08:53.09,0:08:56.06,Default,Spikyulka1,0,0,0,,Kenapa kamu naik ke dalam sumur di saat seperti itu?
Dialog: 0,0:08:58.70,0:09:02.90,Default,Spikyulka1,0,0,0,,Saat itu gelap, aku tidak bisa melihat dengan baik dan terjatuh.
Dialog: 0,0:09:04.30,0:09:06.04,Default,Spillik1,0,0,0,,Apakah kamu buta malam?
Dialog: 0,0:09:06.04,0:09:07.84,Default,Spillik1,0,0,0,,Sulit untuk keluar dari sumur.
Dialog: 0,0:09:10.58,0:09:12.15,Default,Spillik1,0,0,0,,Apakah kamu sudah bangun?
Dialog: 0,0:09:13.25,0:09:14.51,Default,Spillik1,0,0,0,,Tunggu.
Dialog: 0,0:09:16.15,0:09:19.29,Default,Spillik1,0,0,0,,Kemarilah. Lebih cepat.
Dialog: 0,0:09:20.15,0:09:21.62,Default,Spillik1,0,0,0,,Tunggu sebentar.
Dialog: 0,0:09:23.79,0:09:25.96,Default,Spillik1,0,0,0,,Masuk.
Dialog: 0,0:09:40.47,0:09:43.74,Default,Spikyulka1,0,0,0,,Saya akan tahu bahwa Anda akan tinggal di rumah utama,
Dialog: 0,0:09:43.78,0:09:46.58,Default,Spilyk1,0,0,0,,akan menyiapkan tempat tidur yang lebih besar.
Dialog: 0,0:09:46.78,0:09:50.42,Default,Spillie1,0,0,0,,Ayah, tidak! Tidak perlu, ayah!
Dialog: 0,0:09:50.42,0:09:53.25,Default,Spilyk1,0,0,0,,Ayah! Jangan lakukan ini!
Dialog: 0,0:09:53.25,0:09:55.72,Default,Spillik1,0,0,0,,Tidak! Ayah!
Dialog: 0,0:09:55.72,0:09:56.99,Default,Spillie1,0,0,0,,Ayah!
Dialog: 0,0:09:57.06,0:09:58.62,Default,Spillik1,0,0,0,,Maaf.
Dialog: 0,0:09:59.06,0:10:00.49,Default,Spillit1,0,0,0,,Tidak perlu.
Dialog: 0,0:10:00.89,0:10:03.06,Default,Spillik1,0,0,0,,Terima kasih atas usahamu
Dialog: 0,0:10:03.06,0:10:04.60,Default,Spilyk1,0,0,0,,Saya merasa nyaman di sini.
Dialog: 0,0:10:05.23,0:10:08.63,Default,Spillik1,0,0,0,,Tidak perlu merepotkanmu lagi,\NI akan kembali ke istana.
Dialogue: 0,0:10:09.10,0:10:12.71,Default,Spilyk1,0,0,0,,Apa yang dimaksud dengan “masalah”? Jangan katakan itu.
Dialog: 0,0:10:13.04,0:10:16.18,Default,Spillik1,0,0,0,,Saya datang untuk menyampaikan pesan
Dialog: 0,0:10:16.18,0:10:18.64,Default,Spillik1,0,0,0,,ratu janda.
Dialog: 0,0:10:22.32,0:10:27.02,Default,Spilyk1,0,0,0,,Dia mengirimkan untukmu setiap hari, yang artinya
Dialog: 0,0:10:27.02,0:10:29.72,Default,Spillik1,0,0,0,,dia sangat membutuhkanmu.
Dialog: 0,0:10:30.02,0:10:33.89,Default,Spikyulka1,0,0,0,,Semuanya menjadi tidak beres di istana tanpa aku.
Dialog: 0,0:10:36.16,0:10:37.23,Default,Spilyk1,0,0,0,,Yah.
Dialog: 0,0:10:38.33,0:10:41.10,Default,Spillik1,0,0,0,,Bahkan jika Anda sibuk dan lelah, ini bagus.
Dialog: 0,0:10:41.50,0:10:45.84,Default,Spillik1,0,0,0,,Jangan khawatir tentang apa pun, fokuslah pada peran ratu.
Dialog: 0,0:10:46.67,0:10:49.61,Default,Spillik1,0,0,0,,Saya mungkin bukan ayah terbaik, tapi ingat,
Dialogue: 0,0:10:49.61,0:10:51.38,Default,Spillik1,0,0,0,,Saya akan selalu mendukungmu.
Dialog: 0,0:10:54.45,0:10:55.55,Default,Spilyk1,0,0,0,,Ya.
Dialog: 0,0:10:58.52,0:11:00.59,Default,Spillik1,0,0,0,,Sampai dengan selamat ke istana.
Dialog: 0,0:11:01.12,0:11:04.96,Default,Spillik1,0,0,0,,Saya mengerti bahwa ini kurang ajar, tapi saya meminta Anda untuk menjaga ratu.
Dialog: 0,0:11:07.03,0:11:11.63,Default,Spiky1,0,0,0,,Aku akan lebih memperhatikannya, dia tidak akan kesepian.
Dialog: 0,0:11:12.13,0:11:15.64,Default,Spillik1,0,0,0,,Sungguh bahagia. Saya sangat bersyukur dan malu.
Dialog: 0,0:11:17.30,0:11:18.54,Default,Spilyk1,0,0,0,,Bisakah kita berangkat?
Dialog: 0,0:11:33.62,0:11:35.92,Default,Spillik1,0,0,0,,Menggambarkan ayah yang penuh perhatian,
Dialog: 0,0:11:36.22,0:11:39.43,Default,Spikyulka1,0,0,0,,dan dia sendiri hanyalah seorang perampok yang memanfaatkan anaknya sendiri untuk mendapatkan keuntungan.
Dialog: 0,0:11:41.69,0:11:44.46,Default,Spikyulka1,0,0,0,,Dia memberikan putrinya kepada seseorang yang dia coba bunuh.
Dialog: 0,0:11:47.07,0:11:49.20,Default,Spillik1,0,0,0,,Jadi raja ingin membunuh Kim So-yeon?
Dialogue: 0,0:11:53.07,0:11:54.81,Default,Spikyulka1,0,0,0,,Kenapa kamu terlihat seperti kehilangan negaramu?
Dialog: 0,0:11:55.54,0:11:56.61,Default,Spillik1,0,0,0,,Ini tidak benar.
Dialog: 0,0:11:57.08,0:12:00.35,Default,Spikyulka1,0,0,0,,Jika bukan negara, lalu yang lain?
Dialog: 0,0:12:01.61,0:12:03.48,Default,Spikyulka1,0,0,0,,Tunggu, benar-benar hilang?
Dialog: 0,0:12:03.48,0:12:04.68,Default,Spillik1,0,0,0,,Tentu saja tidak.
Dialog: 0,0:12:05.92,0:12:08.75,Default,Spillik1,0,0,0,,Pada hari yang indah kamu kembali dengan selamat ke istana.
Dialog: 0,0:12:09.39,0:12:12.49,Default,Spillik1,0,0,0,,Meskipun wajahku, aku sangat senang.
Dialogue: 0,0:12:13.93,0:12:15.16,Default,Spillik1,0,0,0,,Oke, kalau iya.
Dialog: 0,0:12:17.96,0:12:20.63,Default,Spikyulka1,0,0,0,,Bukankah sudah waktunya pertikaian berdarah dimulai?
Dialogue: 0,0:12:21.63,0:12:26.44,Default,Spikyulka1,0,0,0,,Tapi sepertinya aku lupa sesuatu yang penting.
Dialog: 0,0:12:27.87,0:12:30.28,Default,Spillik1,0,0,0,,Sepertinya saya punya misi penting...
Dialogue: 0,0:12:31.44,0:12:32.85,Default,Spillik1,0,0,0,,Pria yang tampan.
Dialog: 0,0:12:33.61,0:12:35.01,Default,Spillik1,0,0,0,,Dia sangat tampan.
Dialog: 0,0:12:35.08,0:12:36.92,Default,Spillik1,0,0,0,,Sangat tampan.
Dialog: 0,0:12:46.49,0:12:47.76,Default,Spilyk1,0,0,0,,Pemilihan selir kerajaan.
Dialogue: 0,0:12:48.26,0:12:50.06,Default,Spikyulka1,0,0,0,,Bagaimana aku bisa melupakan hal hebat seperti itu?
Dialog: 0,0:12:50.33,0:12:52.06,Default,Spikyulka1,0,0,0,,Saya perlu melakukan sesuatu yang penting, jadi untuk saat ini.
Dialog: 0,0:12:52.10,0:12:53.60,Default,Spillik1,0,0,0,,Hon Young, ayo berangkat. Lebih cepat.
Dialog: 0,0:12:53.77,0:12:55.84,Default,Spillik1,0,0,0,,Tunggu. Mengapa kamu melarikan diri?
Dialog: 0,0:12:55.97,0:12:57.14,Default,Spillik1,0,0,0,,Maaf.
Dialogue: 0,0:12:58.54,0:13:00.17,Default,Spillik1,0,0,0,,Luangkan waktumu.
Dialog: 0,0:13:00.51,0:13:03.04,Default,Spilyk1,0,0,0,,Ini penjelasan singkatnya. Ratu.
Dialog: 0,0:13:05.85,0:13:06.91,Default,Spillik1,0,0,0,,Yang Mulia.
Dialog: 0,0:13:16.42,0:13:17.62,Default,Spillik1,0,0,0,,Ayo berangkat.
Dialog: 0,0:13:32.51,0:13:34.54,Default,Silk1,0,0,0,,-Di mana kepala kasim?\N-Saya sudah memeriksa, dia sedang sibuk.
Dialog: 0,0:13:35.07,0:13:36.48,Default,Spikyulka1,0,0,0,,Kamu tidak dapat menemukannya?
Dialog: 0,0:13:36.54,0:13:38.14,Default,Spillik1,0,0,0,,Buku menghilang begitu saja.
Dialog: 0,0:13:39.95,0:13:41.68,Default,Spikyulka1,0,0,0,,Mungkin ayah mertuaku yang menebak dan menyembunyikannya?
Dialog: 0,0:13:43.02,0:13:44.35,Default,Spillik1,0,0,0,,Tidak demikian.
Dialog: 0,0:13:44.35,0:13:46.89,Default,Spikyulka1,0,0,0,,Perilakunya tidak berubah sampai kepergianku.
Dialog: 0,0:13:47.55,0:13:50.26,Default,Spikyulka1,0,0,0,,Dan dia pasti tidak tahu cara menyembunyikan perasaannya.
Dialogue: 0,0:13:50.79,0:13:52.19,Default,Spikyulka1,0,0,0,,Jadi yang itu?
Dialog: 0,0:13:52.99,0:13:54.56,Default,Spillik1,0,0,0,,Dalam topeng dari Departemen Detektif.
Dialog: 0,0:13:54.56,0:13:58.63,Default,Spiky1,0,0,0,,Jika buku akuntansi jatuh ke tangan Kim Jwagyn, kita tidak akan melihatnya lagi.
Dialog: 0,0:13:58.63,0:14:00.63,Default,Spillik1,0,0,0,,Dia tidak tahu ke mana dia dipindahkan.
Dialog: 0,0:14:00.63,0:14:02.50,Default,Spillik1,0,0,0,,Ini adalah hal yang seperti itu,
Dialog: 0,0:14:02.50,0:14:04.90,Default,Spiky1,0,0,0,,bahwa ayah mertuamu tidak akan bisa memberi tahu siapa pun bahwa dia kehilangannya.
Dialog: 0,0:14:05.17,0:14:07.17,Default,Spillik1,0,0,0,,Dia harus menderita sendirian.
Dialog: 0,0:14:07.37,0:14:10.88,Default,Spikyulka1,0,0,0,,Dia akan mulai mencari buku akuntansi.
Dialog: 0,0:14:12.31,0:14:13.75,Default,Spikyulka1,0,0,0,,Dan akan melakukannya sendiri.
Dialog: 0,0:14:13.75,0:14:15.38,Default,Spikyulka1,0,0,0,,Biarkan mereka mengikutinya.
Dialog: 0,0:14:15.48,0:14:16.52,Default,Spillik1,0,0,0,,Ya.
Dialog: 0,0:14:16.62,0:14:18.99,Default,Spikyulka1,0,0,0,,Menurutku menemukannya adalah hal yang sia-sia.
Dialog: 0,0:14:19.22,0:14:20.45,Default,Spillik1,0,0,0,,Saatnya menyerah.
Dialog: 0,0:14:20.45,0:14:22.82,Default,Spikyulka1,0,0,0,,Tanpa buku besar, semua rencana kita sia-sia.
Dialog: 0,0:14:24.32,0:14:26.19,Default,Spikyulka1,0,0,0,,Aku tidak akan menyerah begitu saja.
Dialog: 0,0:14:28.13,0:14:31.06,Default,Spillik1,0,0,0,,Bertingkahlah seperti ratu di sini, sopanlah.
Dialog: 0,0:14:31.13,0:14:32.93,Default,Spilyk1,0,0,0,,Cepat, ayo berangkat.
Dialog: 0,0:14:34.70,0:14:35.77,Default,Spillik1,0,0,0,,Yang Mulia!
Dialog: 0,0:14:36.47,0:14:37.67,Default,Spillik1,0,0,0,,Halo, nyonya istana Choi!
Dialog: 0,0:14:43.08,0:14:44.08,Default,Spilyk1,0,0,0,,Yang Mulia.
Dialog: 0,0:14:44.94,0:14:46.78,Default,Spillik1,0,0,0,,Aku sangat merindukanmu.
Dialog: 0,0:14:47.11,0:14:50.48,Default,Spillit1,0,0,0,,Nyonya Choi. \NBBawa semua gadis Joseon ke sini.
Dialog: 0,0:14:51.12,0:14:53.75,Default,Spillik1,0,0,0,,Dan jangan lewatkan daftar keluarga klan Khan,
Dialog: 0,0:14:53.75,0:14:54.85,Default,Spillik1,0,0,0,, bawakan padaku.
Dialog: 0,0:14:56.09,0:14:58.89,Default,Spillik1,0,0,0,,Saya mulai memilih selir kerajaan.
Dialogue: 0,0:15:00.19,0:15:02.86,Default,Silk1,0,0,0,,Dengan dalih memilih selir, aku akan mempelajari keluarga ini.
Dialog: 0,0:15:03.73,0:15:05.90,Default,Spillik1,0,0,0,,Pilihan selir kerajaan adalah solusinya.
Dialog: 0,0:15:07.20,0:15:11.27,Default,Spillik1,0,0,0,,Ya, tepatnya, saya perlu menyapa Janda Ratu.
Dialogue: 0,0:15:11.84,0:15:13.67,Default,Spillik1,0,0,0,,Baiklah, tunggu.
Dialog: 0,0:15:13.77,0:15:16.48,Default,Spillit1,0,0,0,,Jiwa Jang Bong-hwan dan kenangan Kim So-yeon -
Dialog: 0,0:15:16.48,0:15:19.88,Default,Spillik1,0,0,0,,campuran ideal untuk menciptakan\N ratu yang sempurna.
Dialog: 0,0:15:23.62,0:15:25.02,Default,Spillik1,0,0,0,,Yang Mulia.
Dialog: 0,0:15:25.35,0:15:27.72,Default,Spillik1,0,0,0,,Apakah kamu baik-baik saja?
Dialog: 0,0:15:28.39,0:15:30.79,Default,Spillik1,0,0,0,,Apakah ada yang berubah?
Dialog: 0,0:15:30.99,0:15:33.23,Default,Spilyk1,0,0,0,,Kamu terlihat berbeda.
Dialog: 0,0:15:33.36,0:15:37.03,Default,Spikyulka1,0,0,0,,Saya bisa memulai dari awal lagi setelah kembali ke rumah.
Dialogue: 0,0:15:37.33,0:15:39.40,Default,Spillik1,0,0,0,,Ini bagus.
Dialogue: 0,0:15:39.40,0:15:41.83,Default,Spillik1,0,0,0,,Maaf sudah membuatmu sangat khawatir.
Dialog: 0,0:15:42.03,0:15:46.11,Default,Spikyulka1,0,0,0,,Dan terima kasih meskipun demikian,
Dialog: 0,0:15:46.11,0:15:47.77,Default,Spikyulka1,0,0,0,,kamu sangat memahamiku.
Dialog: 0,0:15:49.68,0:15:52.24,Default,Spillik1,0,0,0,,Untuk menebus apa yang terjadi di masa lalu,
Dialog: 0,0:15:52.24,0:15:55.25,Default,Spillik1,0,0,0,,Saya akan berusaha keras
Dialog: 0,0:15:55.25,0:15:57.32,Default,Spilyk1,0,0,0,,berperan sebagai ratu.
Dialog: 0,0:15:57.62,0:16:01.12,Default,Spikyulka1,0,0,0,,Jadi, Anda akan segera membahas hal terpenting?
Dialog: 0,0:16:01.69,0:16:02.92,Default,Spikyulka1,0,0,0,,Sekarang saya tahu persis tentang apa ini.
Dialogue: 0,0:16:03.49,0:16:06.29,Default,Spikyulka1,0,0,0,,Segera setelah aku merasa lebih baik, aku datang,
Dialog: 0,0:16:06.29,0:16:09.03,Default,Spillik1,0,0,0,,untuk melakukan ini.
Dialog: 0,0:16:09.26,0:16:10.80,Default,Spillik1,0,0,0,,Seperti yang diharapkan.
Dialog: 0,0:16:10.80,0:16:12.73,Default,Spilyk1,0,0,0,,Saya hanya pergi selama beberapa hari,
Dialogue: 0,0:16:12.90,0:16:15.77,Default,Spikyulka1,0,0,0,,tapi mau tak mau aku memikirkannya.
Dialog: 0,0:16:15.77,0:16:18.74,Default,Spillik1,0,0,0,,Jadi kita mempunyai perasaan yang sama?
Dialog: 0,0:16:19.71,0:16:20.94,Default,Spillik1,0,0,0,,-Lalu...\N-Sekarang...
Dialog: 0,0:16:20.94,0:16:22.21,Default,Spillik1,0,0,0,,-Mulai saat ini?\N-Bagaimana kalau kita mulai?
Dialog: 0,0:16:22.21,0:16:24.21,Default,Spillie1,0,0,0,,-Queen.\N-Kerja bagus!
Dialog: 0,0:16:29.78,0:16:32.25,Default,Spikyulka1,0,0,0,,Aku tidak memikirkan hal itu sama sekali.
Dialog: 0,0:16:40.36,0:16:41.43,Default,,0,0,0,,Yang Mulia.
Dialogue: 0,0:16:41.66,0:16:45.06,Default,,0,0,0,,Menantikan pelatihanmu.
Dialog: 0,0:16:47.83,0:16:50.47,Default,,0,0,0,,Rupanya, aku tak tergantikan.
Dialog: 0,0:16:50.47,0:16:51.97,Default,,0,0,0,,Saya tidak percaya saya berbagi resep.
Dialog: 0,0:16:52.37,0:16:55.21,Default,,0,0,0,,Saya belum siap menjadi guru.
Dialog: 0,0:16:57.78,0:16:59.15,Default,,0,0,0,,Ada apa? Minggir.
Dialog: 0,0:17:03.82,0:17:04.85,Default,,0,0,0,,Ibu.
Dialog: 0,0:17:06.79,0:17:09.19,Default,,0,0,0,,Kamu bisa datang ke sini kapan pun kamu mau.
Dialog: 0,0:17:09.19,0:17:11.52,Default,,0,0,0,,Tapi, sayangnya, ini tidak akan berhasil dengan rilisnya.
Dialog: 0,0:17:35.38,0:17:36.38,Default,,0,0,0,,Yang Mulia.
Dialog: 0,0:17:36.92,0:17:39.32,Default,,0,0,0,,Yang Mulia kembali ke istana.
Dialog: 0,0:17:40.09,0:17:41.09,Default,,0,0,0,,Benarkah?
Dialogue: 0,0:17:41.09,0:17:42.82,Default,,0,0,0,,Haruskah kita pergi ke Aula Seongjeongjong?
Dialog: 0,0:17:43.59,0:17:45.62,Default,,0,0,0,,Tidak. Ayo pergi ke istana kerajaan.
Dialog: 0,0:17:55.10,0:17:57.14,Default,,0,0,0,,Hei, apinya terlalu lemah.
Dialogue: 0,0:17:57.14,0:17:58.60,Default,,0,0,0,,Jadi semuanya akan jadi bubur.
Dialog: 0,0:18:04.38,0:18:05.95,Default,,0,0,0,,Hei, api ada dimana-mana.
Dialog: 0,0:18:08.68,0:18:11.18,Default,,0,0,0,,Kamu juga dapat melihat nyala api di matamu.
Dialog: 0,0:18:11.18,0:18:13.09,Default,,0,0,0,,Ini tidak mungkin.
Dialog: 0,0:18:13.09,0:18:14.82,Default,,0,0,0,,Saya berkomitmen untuk belajar dari Anda,
Dialog: 0,0:18:14.82,0:18:17.49,Default,,0,0,0,,jadi mataku berbinar gembira.
Dialog: 0,0:18:18.59,0:18:20.33,Default,,0,0,0,,Ngomong-ngomong, kapan kamu akan mengajarkan resepnya?
Dialog: 0,0:18:20.63,0:18:23.13,Default,,0,0,0,,Saya yakin Anda tahu cara kerja segala sesuatu di dapur\N. Jangan lakukan itu.
Dialog: 0,0:18:23.53,0:18:24.80,Default,,0,0,0,,Untuk pendatang baru di restoran Cina
Dialog: 0,0:18:24.80,0:18:26.63,Default,,0,0,0,,untuk bulan pertama hanya diperbolehkan mengupas bawang bombay.
Dialogue: 0,0:18:26.63,0:18:27.83,Default,,0,0,0,,Awasi apinya.
Dialog: 0,0:18:29.13,0:18:31.34,Default,,0,0,0,,Bagaimanapun, saya telah bekerja di dapur kerajaan selama 30 tahun.
Dialog: 0,0:18:31.34,0:18:33.51,Default,,0,0,0,,Dan 12 tahun sebagai koki kerajaan.
Dialog: 0,0:18:33.51,0:18:35.24,Default,,0,0,0,,Saya tidak memerlukan resume.
Dialogue: 0,0:18:35.71,0:18:37.44,Default,,0,0,0,,Kalau begitu, kenapa tidak mulai menghitung hari?
Dialog: 0,0:18:39.95,0:18:41.75,Default,,0,0,0,,Aku tidak suka sikapmu.
Dialog: 0,0:18:42.18,0:18:43.48,Default,,0,0,0,,Lupakan saja.
Dialog: 0,0:18:43.48,0:18:45.08,Default,,0,0,0,,Yang Mulia.
Dialog: 0,0:18:45.08,0:18:46.55,Default,,0,0,0,,Dan seperti ini? Apakah itu lebih baik?
Dialog: 0,0:18:47.45,0:18:50.22,Default,,0,0,0,,Lebih baik? Seperti ini.
Dialog: 0,0:18:50.22,0:18:51.56,Default,,0,0,0,,Hei, buka.
Dialog: 0,0:18:53.93,0:18:55.09,Default,,0,0,0,,Selain.
Dialogue: 0,0:19:04.44,0:19:05.77,Default,,0,0,0,,Sudahkah kamu melihatnya sekarang?
Dialog: 0,0:19:06.14,0:19:07.77,Default,,0,0,0,,Ini adalah mata-mata industri.
Dialog: 0,0:19:08.07,0:19:10.61,Default,,0,0,0,,Saya ingin tahu apakah panasnya telah diatur dengan benar.
Dialog: 0,0:19:10.61,0:19:12.95,Default,,0,0,0,,Anda tidak perlu berpikir.\NI bisa mengatasinya sendiri.
Dialogue: 0,0:19:14.08,0:19:15.92,Default,,0,0,0,,Kenapa kamu selalu bertindak terlalu jauh?
Dialog: 0,0:19:30.00,0:19:32.20,Default,,0,0,0,,Gukbap adalah makanan tradisional rakyat jelata.
Dialog: 0,0:19:32.20,0:19:34.50,Default,,0,0,0,,Dan komandannya adalah masyarakat kelas atas.
Dialog: 0,0:19:39.87,0:19:43.44,Default,,0,0,0,,Saya akan tambahkan kaldu daging,\N kukbap daging sapi Perancis.
Dialog: 0,0:19:45.61,0:19:47.95,Default,,0,0,0,,Saya akan menghilangkan rasa gamey dengan bantuan protein.
Dialogue: 0,0:19:51.15,0:19:54.39,Default,,0,0,0,,Menggunakan putih telur dengan cara yang benar-benar baru.
Dialog: 0,0:19:55.29,0:19:57.82,Default,,0,0,0,,Yang Mulia.
Dialog: 0,0:19:58.89,0:20:00.56,Default,,0,0,0,,Apakah ini oke?
Dialog: 0,0:20:00.56,0:20:02.19,Default,,0,0,0,,Luar Biasa.
Dialog: 0,0:20:02.19,0:20:06.00,Default,,0,0,0,,Bolehkah saya tahu jenis makanan\N apa yang ingin Anda masak?
Dialogue: 0,0:20:06.40,0:20:08.23,Default,,0,0,0,,Makanan yang menyentuh jiwa.
Dialog: 0,0:20:10.14,0:20:11.50,Default,,0,0,0,,Jiwa?
Dialog: 0,0:20:27.55,0:20:28.85,Default,,0,0,0,,Luar Biasa.
Dialog: 0,0:20:28.85,0:20:31.22,Default,,0,0,0,,Dan sentuhan akhir.
Dialog: 0,0:20:34.03,0:20:36.80,Default,,0,0,0,,-Mereka sudah siap, kan?\N-Ya, Yang Mulia.
Dialogue: 0,0:20:40.80,0:20:42.97,Default,,0,0,0,,"Kalau busanya mati, aku juga mati."
Dialog: 0,0:20:43.87,0:20:46.97,Default,,0,0,0,,Dengan sikap ini, cobalah menghemat makanan dan bertindak cepat.
Dialog: 0,0:20:46.97,0:20:48.91,Default,,0,0,0,,Jadi. Maju!
Dialog: 0,0:20:49.14,0:20:50.28,Default,,0,0,0,,-Ya, Yang Mulia.\N-Ya, Yang Mulia.
Dialog: 0,0:20:51.11,0:20:52.21,Default,,0,0,0,,Lebih cepat.
Dialogue: 0,0:20:56.15,0:20:58.15,Default,,0,0,0,,Dia akan semakin menyukainya,\N karena dia tahu rasanya.
Dialog: 0,0:21:01.79,0:21:02.86,Default,,0,0,0,,Yang Mulia!
Dialog: 0,0:21:04.02,0:21:07.29,Default,,0,0,0,,Damhyang!
Dialog: 0,0:21:09.46,0:21:14.33,Default,,0,0,0,,Aku sangat takut\N hingga aku tidak bisa bertemu denganmu lagi.
Dialog: 0,0:21:16.30,0:21:19.67,Default,,0,0,0,,Benar. Terima kasih banyak.
Dialog: 0,0:21:22.11,0:21:23.88,Default,,0,0,0,,Aku membuatmu khawatir.
Dialog: 0,0:21:24.61,0:21:26.85,Default,,0,0,0,,Saya harus dimarahi.
Dialog: 0,0:21:28.45,0:21:30.62,Default,,0,0,0,,Permisi.
Dialog: 0,0:21:42.03,0:21:43.06,Default,,0,0,0,,Apa...
Dialogue: 0,0:21:44.83,0:21:47.17,Default,,0,0,0,,Aku tidak membayangkannya?
Dialog: 0,0:21:47.83,0:21:49.80,Default,,0,0,0,,Apakah ini nasi dan sup?
Dialog: 0,0:21:49.80,0:21:53.94,Default,,0,0,0,,Sepertinya ini juga nasi.
Dialogue: 0,0:21:55.11,0:21:57.71,Default,,0,0,0,,Apakah dia memberiku kukbap?
Dialog: 0,0:21:58.68,0:22:01.41,Default,,0,0,0,,Untuk makanan kerajaan\N Anda perlu memisahkan nasi dan sup.
Dialogue: 0,0:22:01.41,0:22:03.85,Default,,0,0,0,,Beraninya kamu memasukkan nasi ke dalam sup,\N seperti petani?
Dialogue: 0,0:22:04.62,0:22:05.95,Default,,0,0,0,,Haruskah aku mengambilnya?
Dialog: 0,0:22:05.95,0:22:07.09,Default,,0,0,0,,Tentu saja!
Dialog: 0,0:22:10.19,0:22:11.29,Default,,0,0,0,,Tapi
Dialogue: 0,0:22:12.93,0:22:15.09,Default,,0,0,0,,ratu berupaya keras dalam hal ini.
Dialogue: 0,0:22:17.60,0:22:19.60,Default,,0,0,0,,Setidaknya aku akan mencoba.
Dialog: 0,0:22:20.10,0:22:21.13,Default,,0,0,0,,Ya, Yang Mulia.
Dialogue: 0,0:22:36.62,0:22:40.12,Default,,0,0,0,,Aku sedang menghitung hari-hari dalam karirku
Dialog: 0,0:22:41.02,0:22:43.16,Default,,0,0,0,,di dapur kerajaan.
Dialog: 0,0:22:43.62,0:22:46.23,Default,,0,0,0,,Dan menjalani kehidupan yang mulia sebagai juru masak kerajaan.
Dialog: 0,0:22:47.89,0:22:52.87,Default,,0,0,0,,Tapi aku menjadi pelayan biasa yang menjaga api sepanjang malam.
Dialog: 0,0:22:54.90,0:22:57.07,Default,,0,0,0,,Semua karena ratu.
Dialogue: 0,0:22:57.94,0:22:59.67,Default,,0,0,0,,Ini bukan karena aku juru masak yang buruk.
Dialog: 0,0:23:00.14,0:23:03.04,Default,,0,0,0,,Ini karena ratunya luar biasa baik.
Dialog: 0,0:23:03.04,0:23:04.08,Default,,0,0,0,,Sialan.
Dialog: 0,0:23:04.08,0:23:06.61,Default,,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialog: 0,0:23:12.62,0:23:13.82,Default,,0,0,0,,Sialan.
Dialog: 0,0:23:14.19,0:23:16.76,Default,,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialog: 0,0:23:25.80,0:23:27.80,Default,,0,0,0,,-Dan kamu?\N-Dan kamu?
Dialog: 0,0:23:33.21,0:23:35.01,Default,,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialog: 0,0:23:35.01,0:23:37.11,Default,,0,0,0,,Kamu terlalu kejam!
Dialogue: 0,0:23:37.11,0:23:39.08,Default,,0,0,0,,Susu belum mengering di bibirmu!
Dialog: 0,0:23:39.08,0:23:40.28,Default,,0,0,0,,Sedikit sekali...
Dialogue: 0,0:23:40.95,0:23:42.55,Default,,0,0,0,,Sialan kau!
Dialog: 0,0:23:42.55,0:23:44.42,Default,,0,0,0,,Apakah menurutmu aku ini lelucon?
Dialogue: 0,0:23:44.42,0:23:46.75,Default,,0,0,0,,Aku juru masak yang hebat!
Dialog: 0,0:23:50.76,0:23:52.93,Default,,0,0,0,,Wow, persis seperti yang kita perlukan.
Dialogue: 0,0:23:59.57,0:24:01.13,Default,,0,0,0,,Kapan kamu bisa sedekat ini?
Dialog: 0,0:24:01.83,0:24:03.47,Default,,0,0,0,,Aku tidak terlalu membencinya.
Dialogue: 0,0:24:06.14,0:24:07.74,Default,,0,0,0,,Dia baru saja menyerangku.
Dialogue: 0,0:24:07.74,0:24:10.28,Default,,0,0,0,,Aku pasti busuk,\Nseperti sayuran busuk di musim panas.
Dialog: 0,0:24:11.08,0:24:13.21,Default,,0,0,0,,Api berkobar sepanjang hari.
Dialog: 0,0:24:18.32,0:24:19.69,Default,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:24:20.19,0:24:22.49,Default,,0,0,0,,Tidak. Aku tidak mencoba menciumnya.
Dialog: 0,0:24:22.49,0:24:24.52,Default,,0,0,0,,-Saya mencoba menjelaskan kepada Anda...\N-Keluar!
Dialog: 0,0:24:25.92,0:24:27.53,Default,,0,0,0,,-I...\N-Keluar.
Dialog: 0,0:24:30.76,0:24:31.83,Default,,0,0,0,,Oke.
Dialog: 0,0:24:32.87,0:24:33.93,Default,,0,0,0,,Maaf.
Dialog: 0,0:24:34.93,0:24:36.24,Default,,0,0,0,,Di Sini.
Dialog: 0,0:24:41.31,0:24:43.34,Default,,0,0,0,,Saya tidak bisa menghina Yang Mulia,
Dialog: 0,0:24:43.91,0:24:45.91,Default,,0,0,0,,agar tidak sejajar dengannya.
Dialogue: 0,0:24:46.48,0:24:48.61,Default,,0,0,0,,Tapi aku perlu melampiaskannya.
Dialogue: 0,0:24:50.32,0:24:54.12,Default,,0,0,0,,Aku benar-benar akan menghentikan ini.
Dialogue: 0,0:25:17.48,0:25:19.85,Default,,0,0,0,,Wajahnya dari mana?
Dialog: 0,0:25:30.89,0:25:33.93,Default,,0,0,0,,Tidak, tidak!
Dialog: 0,0:25:33.93,0:25:36.03,Default,,0,0,0,,Tidak. Tidak perlu.
Dialog: 0,0:25:37.43,0:25:40.23,Default,,0,0,0,,Tidak! TIDAK! Ini tidak mungkin!
Dialog: 0,0:25:42.51,0:25:45.85,Default,,0,0,0,,Janda Ratu, \NRatu meminta bertemu.
Dialog: 0,0:25:46.05,0:25:47.25,Default,,0,0,0,,Biarkan dia masuk.
Dialog: 0,0:25:57.43,0:25:58.70,Default,,0,0,0,,Saya sudah selesai.
Dialog: 0,0:25:59.36,0:26:02.30,Default,,0,0,0,,Tentu saja, orang yang tidak berperasaan seperti itu\N tidak akan menghargai makanan untuk jiwa.
Dialog: 0,0:26:05.54,0:26:07.74,Default,,0,0,0,,Yang Mulia.
Dialog: 0,0:26:08.81,0:26:11.54,Default,,0,0,0,,Aku pasti kehilangan keahlianku karena
Dialog: 0,0:26:11.54,0:26:14.15,Default,,0,0,0,,absen dari dapur selama beberapa waktu.
Dialog: 0,0:26:18.15,0:26:20.02,Default,,0,0,0,,Rasanya familier sekaligus eksotik.
Dialog: 0,0:26:20.55,0:26:22.45,Default,,0,0,0,,Akrab, tapi eksotik.
Dialogue: 0,0:26:23.42,0:26:25.92,Default,,0,0,0,,Bakat kulinermu yang luar biasa mulai membuatku takut.
Dialogue: 0,0:26:27.16,0:26:29.96,Default,,0,0,0,,Kau bahkan membawa kembali kenangan yang sudah lama terlupakan bagiku.
Dialog: 0,0:26:30.96,0:26:32.13,Default,,0,0,0,,Di Sini.
Dialogue: 0,0:26:36.80,0:26:39.00,Default,,0,0,0,,Gadis baik, makanlah.
Dialog: 0,0:26:40.91,0:26:41.97,Default,,0,0,0,,Bu.
Dialog: 0,0:26:45.41,0:26:46.48,Default,,0,0,0,,Yang Mulia.
Dialogue: 0,0:26:48.31,0:26:51.02,Default,,0,0,0,,-Kamu punya sebutir beras di sini.\N-Beraninya kamu!
Dialog: 0,0:26:57.92,0:27:01.36,Default,,0,0,0,,Tetapi saya dengar Anda tidak ingin \Nberbagi keahlian Anda.
Dialog: 0,0:27:01.59,0:27:04.50,Default,,0,0,0,,Kamu pikir kamu tidak bisa \Nmelatih koki kerajaan?
Dialog: 0,0:27:05.10,0:27:06.16,Default,,0,0,0,,Yah...
Dialogue: 0,0:27:06.83,0:27:09.57,Default,,0,0,0,,Orang tua ini membuatku sedikit jengkel.
Dialog: 0,0:27:09.67,0:27:12.47,Default,,0,0,0,,Maka Anda harus segera membuangnya.
Dialog: 0,0:27:12.80,0:27:14.74,Default,,0,0,0,,Selain itu, ada insiden dengan arsenik.
Dialog: 0,0:27:16.01,0:27:17.24,Default,,0,0,0,,Arsenik?
Dialog: 0,0:27:17.54,0:27:18.98,Default,,0,0,0,,Kamu tidak tahu?
Dialog: 0,0:27:18.98,0:27:20.75,Default,,0,0,0,,Anda telah jatuh ke kondisi vegetatif,
Dialogue: 0,0:27:20.75,0:27:23.12,Default,,0,0,0,,karena aku menelan \Nracun di dapur kerajaan.
Dialog: 0,0:27:23.52,0:27:24.55,Default,,0,0,0,,Racun?
Dialogue: 0,0:27:24.95,0:27:27.59,Default,,0,0,0,,Maka aku tidak akan pulih secepat ini.
Dialog: 0,0:27:27.59,0:27:29.59,Default,,0,0,0,,
Dialog: 0,0:27:28.42,0:27:30.42,Default,,0,0,0,,Si juru masak kerajaan adalah orang tua yang bodoh,
Dialog: 0,0:27:30.99,0:27:33.56,Default,,0,0,0,,tetapi jika Anda melepaskan dia dari posisinya...
Dialogue: 0,0:27:33.56,0:27:35.09,Default,,0,0,0,,Apakah aku akan melepaskanmu dari posisimu?
Dialog: 0,0:27:36.46,0:27:38.56,Default,,0,0,0,,Kami akan memenggal kepalanya.
Dialog: 0,0:27:47.11,0:27:49.57,Default,,0,0,0,,Saya ingin tahu siapa yang memiliki buku akuntansi sekarang?
Dialog: 0,0:27:50.64,0:27:51.78,Default,,0,0,0,,Dan yang lebih penting,
Dialog: 0,0:27:52.41,0:27:54.48,Default,,0,0,0,,kenapa dia membawanya?
Dialogue: 0,0:27:56.48,0:27:58.42,Default,,0,0,0,,Apakah ini akan menjadi bumerang bagi kita?
Dialog: 0,0:27:59.22,0:28:00.82,Default,,0,0,0,,Atau akankah itu membantu kita?
Dialog: 0,0:28:02.32,0:28:04.72,Default,,0,0,0,,Dia akan kehilangan posisi atau kepalanya,
Dialogue: 0,0:28:05.12,0:28:06.39,Default,,0,0,0,,apa peduliku?
Dialog: 0,0:28:07.93,0:28:10.26,Default,,0,0,0,,Mereka meminta saya untuk berbagi resep,
Dialog: 0,0:28:10.26,0:28:12.23,Default,,0,0,0,,yang berarti pembicaraan tentang penggulingan bukanlah lelucon.
Dialogue: 0,0:28:13.40,0:28:15.60,Default,,0,0,0,,Bukan orang tua yang perlu kukhawatirkan.
Dialog: 0,0:28:15.60,0:28:17.10,Default,,0,0,0,,Aku hampir kehilangan akal.
Dialog: 0,0:28:19.94,0:28:22.61,Default,,0,0,0,,Oh, Cheoljong!
Dialog: 0,0:28:27.08,0:28:30.12,Default,,0,0,0,,Yang Mulia, ratu ada di sini.
Dialog: 0,0:28:49.94,0:28:51.30,Default,,0,0,0,,Apa yang kamu lakukan?
Dialogue: 0,0:28:51.30,0:28:53.74,Default,,0,0,0,,Aku diberitahu beginilah cara berjalan bangsawan.
Dialogue: 0,0:28:54.07,0:28:57.21,Default,,0,0,0,,Aku adalah ratu idamanmu.
Dialog: 0,0:28:57.74,0:28:59.54,Default,,0,0,0,,Apa? Siapa bilang?
Dialog: 0,0:29:00.75,0:29:02.75,Default,,0,0,0,,Nyonya Choi. Ditipu?
Dialog: 0,0:29:02.75,0:29:03.85,Default,,0,0,0,,Tidak, maksudku...
Dialogue: 0,0:29:04.18,0:29:06.65,Default,,0,0,0,,Siapa ratu idealku?
Dialog: 0,0:29:07.89,0:29:10.76,Default,,0,0,0,,Saya, seperti yang Anda lihat.
Dialogue: 0,0:29:14.09,0:29:16.80,Default,,0,0,0,,Kau membuatku takut. Jadilah sama seperti biasanya.
Dialogue: 0,0:29:18.26,0:29:21.60,Default,,0,0,0,,Ngomong-ngomong, wanita seperti apa yang kamu suka?
Dialog: 0,0:29:21.70,0:29:24.44,Default,,0,0,0,,Seksual? Cantik? Tidak bersalah?
Dialog: 0,0:29:25.94,0:29:27.24,Default,,0,0,0,,Apa yang kamu bicarakan?
Dialog: 0,0:29:28.47,0:29:29.84,Default,,0,0,0,,Kata Janda Ratu
Dialog: 0,0:29:29.84,0:29:31.21,Default,,0,0,0,,pilih selir untukmu.
Dialogue: 0,0:29:31.84,0:29:33.48,Default,,0,0,0,,Selir-selir itu milikmu,
Dialog: 0,0:29:33.48,0:29:35.11,Default,,0,0,0,,jadi mana yang lebih kamu suka?
Dialogue: 0,0:29:35.71,0:29:36.82,Default,,0,0,0,,Selir?
Dialog: 0,0:29:37.75,0:29:38.92,Default,,0,0,0,,Selir kerajaan...
Dialog: 0,0:29:39.35,0:29:40.92,Default,,0,0,0,,Bodoh sekali.
Dialog: 0,0:29:41.65,0:29:44.29,Default,,0,0,0,,Menampilkan warna aslimu?
Dialog: 0,0:29:48.53,0:29:50.43,Default,,0,0,0,,Ide bagus.
Dialog: 0,0:30:11.55,0:30:14.09,Default,,0,0,0,,Maaf. Saya terlalu senang.
Dialog: 0,0:30:14.55,0:30:15.59,Default,,0,0,0,,Baiklah.
Dialog: 0,0:30:16.22,0:30:17.89,Default,,0,0,0,,Mari kita perjelas.
Dialog: 0,0:30:18.46,0:30:19.89,Default,,0,0,0,,Kamu adalah raja, tapi bukan berarti
Dialogue: 0,0:30:19.89,0:30:22.89,Default,,0,0,0,,bahwa itu milikmu. Itu kuno.
Dialog: 0,0:30:22.89,0:30:24.56,Default,,0,0,0,,Itu bukan milikmu.
Dialog: 0,0:30:26.40,0:30:27.63,Default,,0,0,0,,Saran bagus.
Dialog: 0,0:30:27.83,0:30:29.97,Default,,0,0,0,,-Ini berarti...\N-Itu milikku.
Dialog: 0,0:30:30.20,0:30:31.87,Default,,0,0,0,,-Apa?\N-Itu milikku.
Dialog: 0,0:30:32.64,0:30:34.81,Default,,0,0,0,,Jangan mendekati harem.
Dialogue: 0,0:30:35.44,0:30:37.41,Default,,0,0,0,,Kamu mempunyai selir utama.
Dialogue: 0,0:30:37.91,0:30:39.14,Default,,0,0,0,,Mengerti.
Dialog: 0,0:30:40.38,0:30:43.05,Default,,0,0,0,,Dalam satu kondisi.
Dialog: 0,0:30:44.38,0:30:45.98,Default,,0,0,0,,-Di telingamu.\N-Apa? Untuk apa?
Dialog: 0,0:30:45.98,0:30:47.35,Default,,0,0,0,,Semuanya baik-baik saja.
Dialog: 0,0:30:49.92,0:30:51.46,Default,,0,0,0,,Saya akan memilih jenis kelamin mereka.
Dialog: 0,0:30:52.09,0:30:53.16,Default,,0,0,0,,Apa?
Dialog: 0,0:30:53.53,0:30:57.40,Default,,0,0,0,,Tidak! Aku butuh penampilan, bukan silsilah.
Dialog: 0,0:30:57.90,0:31:01.13,Default,,0,0,0,,Kalau begitu aku akan memberitahu ratu janda,
Dialog: 0,0:31:01.13,0:31:03.94,Default,,0,0,0,,bahwa aku tidak membutuhkan selir.
Dialog: 0,0:31:03.94,0:31:05.34,Default,,0,0,0,,Oke.
Dialogue: 0,0:31:05.34,0:31:07.94,Default,,0,0,0,,Jangan melanggar batasan orang lain.
Dialog: 0,0:31:08.27,0:31:10.61,Default,,0,0,0,,Di balik penampilanku, kamu memeriksa keluarga mereka.
Dialogue: 0,0:31:11.68,0:31:14.51,Default,,0,0,0,,Kamu adalah anti-penggemar sejatiku.
Dialog: 0,0:31:16.18,0:31:19.72,Default,,0,0,0,,Saya khawatir, tapi sekarang saya menemukan jalan keluar.
Dialog: 0,0:31:24.76,0:31:25.86,Default,,0,0,0,,Jangan tersenyum.
Dialog: 0,0:31:27.76,0:31:29.19,Default,,0,0,0,,Kamu tidak diperbolehkan tersenyum.
Dialog: 0,0:31:29.29,0:31:31.56,Default,,0,0,0,,Dan kamu tidak bisa meraih tanganku
Dialog: 0,0:31:31.56,0:31:33.13,Default,,0,0,0,,dan berbaring tengkurap!
Dialog: 0,0:31:35.03,0:31:36.57,Default,,0,0,0,,Jadi saya tidak bisa berbuat apa-apa?
Dialog: 0,0:31:36.57,0:31:38.30,Default,,0,0,0,,Tepat. Semuanya dilarang.
Dialog: 0,0:31:38.30,0:31:39.87,Default,,0,0,0,,Jangan lakukan apa pun!
Dialog: 0,0:31:42.21,0:31:43.71,Default,,0,0,0,,Tidak ada waktu untuk ini.
Dialog: 0,0:31:46.08,0:31:47.11,Default,,0,0,0,,Ayo berangkat.
Dialog: 0,0:31:50.68,0:31:52.48,Default,,0,0,0,,Ini ratuku.
Dialog: 0,0:31:53.69,0:31:56.49,Default,,0,0,0,,Bicara dengan Yang Mulia?
Dialog: 0,0:31:58.42,0:32:00.13,Default,,0,0,0,,Kembali ke diriku sendiri.
Dialogue: 0,0:32:04.83,0:32:06.60,Default,,0,0,0,,Apakah kamu mencari ini?
Dialogue: 0,0:32:10.54,0:32:12.34,Default,,0,0,0,,Apakah pelayan istana menjualmu?
Dialog: 0,0:32:12.34,0:32:15.21,Default,,0,0,0,,Ya, dia masih sangat muda.
Dialog: 0,0:32:16.27,0:32:18.84,Default,,0,0,0,,Berpakaian seperti pelayan istana.
Dialogue: 0,0:32:18.84,0:32:20.18,Default,,0,0,0,,Ingat seperti apa rupanya?
Dialogue: 0,0:32:20.51,0:32:23.75,Default,,0,0,0,,Tergantung berapa banyak yang kamu bayar.
Dialogue: 0,0:32:25.35,0:32:26.95,Default,,0,0,0,,Aku akan kembali bersama artisnya.
Dialogue: 0,0:32:26.95,0:32:29.09,Default,,0,0,0,,Semakin jelas ingatanmu,
Dialog: 0,0:32:29.65,0:32:31.16,Default,,0,0,0,,semakin banyak yang akan saya tawarkan.
Dialog: 0,0:32:44.27,0:32:45.40,Default,,0,0,0,,Selamat datang.
Dialog: 0,0:32:51.74,0:32:53.41,Default,,0,0,0,,
Dialog: 0,0:32:53.41,0:32:55.08,Default,,0,0,0,,Istirahat
Dialogue: 0,0:33:00.49,0:33:02.82,Default,,0,0,0,,Palsu, aku yakin itu.
Dialogue: 0,0:33:02.99,0:33:05.12,Default,,0,0,0,,Apakah ini dokumen palsu?
Dialogue: 0,0:33:05.12,0:33:07.49,Default,,0,0,0,,Ini bukan identitas yang sepenuhnya palsu.
Dialog: 0,0:33:07.49,0:33:11.23,Default,,0,0,0,,Ini adalah dokumen yang ditemukan dari orang yang meninggal atau hilang.
Dialog: 0,0:33:12.20,0:33:14.83,Default,,0,0,0,,Tidak dilakukan dengan kikuk.
Dialogue: 0,0:33:15.93,0:33:18.80,Default,,0,0,0,,Mungkin sangat mahal.
Dialog: 0,0:33:25.11,0:33:26.71,Default,,0,0,0,,Terima kasih.
Dialogue: 0,0:33:31.85,0:33:33.75,Default,,0,0,0,,Berusaha keras,
Dialog: 0,0:33:34.92,0:33:37.16,Default,,0,0,0,,untuk menjadi pejabat rendahan?
Dialog: 0,0:33:55.84,0:33:59.98,Default,,0,0,0,,Yang Mulia, saya harus memberi Anda sesuatu secara diam-diam.
Dialogue: 0,0:34:00.48,0:34:02.71,Default,,0,0,0,,Aku akan menunggu di tempat biasa kita.
Dialog: 0,0:34:04.28,0:34:05.45,Default,,0,0,0,,Yang Mulia.
Dialog: 0,0:34:12.62,0:34:15.49,Default,,0,0,0,,Pangeran Yeonpyeong meninggalkan istana.
Dialog: 0,0:34:18.93,0:34:22.50,Default,,0,0,0,,Kalau begitu bawa ini pada Yang Mulia.
Dialog: 0,0:34:22.87,0:34:23.90,Default,,0,0,0,,Ya.
Dialog: 0,0:34:28.47,0:34:30.24,Default,,0,0,0,,Apakah dia punya sesuatu untuk raja?
Dialog: 0,0:34:31.24,0:34:34.75,Default,,0,0,0,,Karena dia tidak bisa memberikannya padanya setelah melihat seberapa baik dia bergaul dengan ratu,
Dialog: 0,0:34:35.31,0:34:38.02,Default,,0,0,0,,sepertinya sesuatu yang istimewa.
Dialog: 0,0:34:40.65,0:34:43.66,Default,,0,0,0,,Penonton kerajaan dalam 15 menit?
Dialog: 0,0:34:43.99,0:34:44.99,Default,,0,0,0,,Ya.
Dialog: 0,0:34:45.02,0:34:46.59,Default,,0,0,0,,Istirahat sebentar.
Dialog: 0,0:34:47.13,0:34:48.16,Default,,0,0,0,,Oke.
Dialog: 0,0:34:56.17,0:34:58.90,Default,,0,0,0,,Selir utama menulis surat untukmu.
Dialog: 0,0:35:31.54,0:35:33.17,Default,,0,0,0,,Secara langsung
Dialogue: 0,0:35:42.51,0:35:45.98,Default,,0,0,0,,Saat aku pergi, kamu tidak berhenti bekerja.
Dialog: 0,0:35:45.98,0:35:47.99,Default,,0,0,0,,Terima kasih, tidak ada urusanku di sini.
Dialog: 0,0:35:48.25,0:35:51.56,Default,,0,0,0,,-Terima kasih, Yang Mulia.\N-Terima kasih, Yang Mulia.
Dialog: 0,0:35:52.39,0:35:54.46,Default,,0,0,0,,Untuk mengungkapkan rasa terima kasihku,
Dialogue: 0,0:35:54.46,0:35:56.86,Default,,0,0,0,,Aku akan mengadakan pesta di Hari Kereta.
Dialog: 0,0:35:57.46,0:35:59.66,Default,,0,0,0,,Banyak keluhan masyarakat, termasuk tentang bencana alam.
Dialogue: 0,0:35:59.66,0:36:02.23,Default,,0,0,0,,Kemurahan hatimu akan membuat orang berpikir,
Dialog: 0,0:36:02.23,0:36:04.44,Default,,0,0,0,,bahwa kami tidak tertarik dengan pesanannya
Dialog: 0,0:36:04.44,0:36:07.17,Default,,0,0,0,,dan kami hanya ingin mengadakan pesta.
Dialog: 0,0:36:07.17,0:36:10.91,Default,,0,0,0,,Menurutku seorang raja seharusnya tidak berperilaku seperti ini.
Dialog: 0,0:36:11.08,0:36:12.91,Default,,0,0,0,,Yongjo namun
Dialog: 0,0:36:12.91,0:36:15.41,Default,,0,0,0,,pemulihan yang dirayakan,
Dialog: 0,0:36:15.41,0:36:17.65,Default,,0,0,0,,mengatur pesta mewah.
Dialog: 0,0:36:18.68,0:36:21.95,Default,,0,0,0,,Ratu kelelahan karena kerja keras
Dialog: 0,0:36:21.95,0:36:23.66,Default,,0,0,0,,dan keluar dari keadaan vegetatif.
Dialogue: 0,0:36:24.02,0:36:25.52,Default,,0,0,0,,Kita perlu merayakan ini.
Dialog: 0,0:36:25.72,0:36:29.23,Default,,0,0,0,,Kami masih mencari penyebab penyakitnya.
Dialog: 0,0:36:29.46,0:36:31.90,Default,,0,0,0,,Saat ini belum terpasang.
Dialog: 0,0:36:31.90,0:36:34.77,Default,,0,0,0,,Dia pulih sepenuhnya setelah dua hari.
Dialog: 0,0:36:34.77,0:36:36.30,Default,,0,0,0,,Hanya butuh istirahat.
Dialog: 0,0:36:36.30,0:36:38.60,Default,,0,0,0,,-Namun...\N-Ratu
Dialog: 0,0:36:39.67,0:36:43.34,Default,,0,0,0,,mengatasi penyakit serius dan sembuh.
Dialogue: 0,0:36:43.78,0:36:47.65,Default,,0,0,0,,Kita perlu merayakan acara bagus ini.
Dialog: 0,0:36:48.48,0:36:50.85,Default,,0,0,0,,Kasusnya cukup cocok.
Dialog: 0,0:36:51.42,0:36:52.45,Default,,0,0,0,,Ya.
Dialog: 0,0:36:52.45,0:36:56.25,Default,,0,0,0,,Itu adalah tugasku sebagai raja dan sebagai suaminya.
Dialog: 0,0:36:56.69,0:36:59.32,Default,,0,0,0,,Yang Mulia, ini tidak akan berhasil.
Dialog: 0,0:36:59.76,0:37:02.63,Default,,0,0,0,,Upaya membunuh ratu adalah kejahatan serius.
Dialog: 0,0:37:02.96,0:37:05.23,Default,,0,0,0,,Jika Anda terburu-buru mengatur pesta...
Dialog: 0,0:37:05.23,0:37:06.50,Default,,0,0,0,,Menteri Perang.
Dialogue: 0,0:37:07.33,0:37:09.67,Default,,0,0,0,,Tidakkah kamu senang ratu telah pulih?
Dialogue: 0,0:37:10.17,0:37:11.44,Default,,0,0,0,,Benarkah
Dialogue: 0,0:37:11.44,0:37:14.81,Default,,0,0,0,,apa kamu ingin ratu terluka?
Dialog: 0,0:37:15.31,0:37:17.71,Default,,0,0,0,,Tidak, tentu saja tidak.
Dialog: 0,0:37:18.04,0:37:19.78,Default,,0,0,0,,Gunakan kasus ini
Dialogue: 0,0:37:20.18,0:37:23.08,Default,,0,0,0,,apakah lebih penting untuk tujuan politik daripada kesehatan ratu?
Dialog: 0,0:37:29.42,0:37:31.29,Default,,0,0,0,,Tenang, Yang Mulia.
Dialogue: 0,0:37:31.29,0:37:36.06,Default,,0,0,0,,Jika ini keinginanmu,\N kami dengan senang hati akan menerima keinginanmu.
Dialog: 0,0:37:36.59,0:37:38.06,Default,,0,0,0,,Lalu tunggu.
Dialogue: 0,0:37:39.90,0:37:43.00,Default,,0,0,0,,Istirahatmu cukup. Penuh dengan energi.
Dialogue: 0,0:37:56.38,0:37:57.55,Default,,0,0,0,,Musuh dari musuhku.
Dialog: 0,0:37:58.05,0:38:00.22,Default,,0,0,0,,Saya akan mengalahkan orang barbar dengan orang barbar lainnya.
Dialog: 0,0:38:00.82,0:38:02.22,Default,,0,0,0,,Perlu membuat klan,
Dialog: 0,0:38:02.22,0:38:03.79,Default,,0,0,0,,melawan Kim.
Dialog: 0,0:38:04.06,0:38:05.62,Default,,0,0,0,,-Buat?\N-Gunakan
Dialog: 0,0:38:05.62,0:38:07.49,Default,,0,0,0,,selir yang dipilih oleh ratu.
Dialog: 0,0:38:10.19,0:38:11.86,Default,galeri tembak,0,0,0,,Koki kerajaan, lihat?
Dialog: 0,0:38:11.86,0:38:14.20,Default,,0,0,0,,Ya, ayolah. Apakah rasanya sama?
Dialog: 0,0:38:14.20,0:38:15.80,Default,,0,0,0,,Biar saya coba.
Dialogue: 0,0:38:18.70,0:38:20.04,Default,,0,0,0,,Bawakan bumbu lagi.
Dialog: 0,0:38:20.04,0:38:21.37,Default,,0,0,0,,Ya. Saya akan menambahkan sedikit lagi.
Dialog: 0,0:38:22.37,0:38:24.78,Default,,0,0,0,,Tidak, itu tidak akan berhasil, itu encer. Ulangi.
Dialogue: 0,0:38:25.61,0:38:27.98,Default,,0,0,0,,Dan kenapa kamu berusaha sekuat tenaga?
Dialog: 0,0:38:30.35,0:38:33.85,Default,,0,0,0,,Popularitas hidangan susu akan semakin meningkat.
Dialogue: 0,0:38:34.15,0:38:36.82,Default,,0,0,0,,Kita tidak bisa membuat anak sapi kelaparan.
Dialog: 0,0:38:37.66,0:38:41.76,Default,,0,0,0,,Jadi saya ingin mengganti susu dengan sesuatu yang rasanya serupa.
Dialogue: 0,0:38:43.96,0:38:46.23,Default,,0,0,0,,Gastronomi molekuler di Joseon?
Dialogue: 0,0:38:48.57,0:38:50.94,Default,,0,0,0,,Dia berusaha keras, terutama hari ini.
Dialog: 0,0:38:52.97,0:38:54.11,Default,,0,0,0,,Koki Kerajaan.
Dialogue: 0,0:38:56.21,0:38:57.81,Default,,0,0,0,,Begitu banyak kesedihan di mata ini.
Dialogue: 0,0:38:58.71,0:39:01.61,Default,,0,0,0,,Aku yakin dia punya seluruh keluarga yang harus diberi makan.
Dialogue: 0,0:39:02.35,0:39:03.48,Default,,0,0,0,,Aku mendengarkanmu.
Dialogue: 0,0:39:05.15,0:39:06.68,Default,,0,0,0,,Nyalakan apinya.
Dialog: 0,0:39:13.86,0:39:15.39,Default,,0,0,0,,
Dialog: 0,0:39:17.13,0:39:19.66,Default,,0,0,0,,Di pundak kecil kepala keluarga ini
Dialog: 0,0:39:19.66,0:39:21.40,Default,,0,0,0,,ada beban berat.
Dialogue: 0,0:39:23.90,0:39:25.80,Default,,0,0,0,,Jadi kalau dipikir-pikir, aku masih belum tahu namamu.
Dialog: 0,0:39:25.80,0:39:26.90,Default,,0,0,0,,Siapa namamu?
Dialog: 0,0:39:28.51,0:39:29.67,Default,,0,0,0,,Manbok.
Dialog: 0,0:39:30.91,0:39:32.28,Default,,0,0,0,,Ceritakan tentang keluargamu.
Dialogue: 0,0:39:32.84,0:39:35.38,Default,,0,0,0,,Menurutku ada 10 orang di keluargamu,\Ndan setiap orang perlu diberi makan.
Dialogue: 0,0:39:36.31,0:39:37.45,Default,,0,0,0,,Aku kesepian.
Dialog: 0,0:39:38.52,0:39:39.55,Default,,0,0,0,,Apa?
Dialog: 0,0:39:39.55,0:39:42.39,Default,,0,0,0,,Saya sudah lama menikmati kehidupan bujangan.
Dialogue: 0,0:39:46.92,0:39:49.29,Default,,0,0,0,,Apakah kamu tidak mempunyai keluarga yang harus diberi makan?
Dialog: 0,0:39:49.96,0:39:51.13,Default,,0,0,0,,Pikirkan lagi.
Dialogue: 0,0:39:53.36,0:39:56.57,Default,,0,0,0,,Yah, terkadang aku memberi makan kepala ikan pada kucing liar.
Dialog: 0,0:39:56.70,0:39:58.80,Default,,0,0,0,,Benar. Apakah kamu melihat?
Dialog: 0,0:39:59.24,0:40:01.91,Default,,0,0,0,,Tanpamu, kucing liar akan kelaparan.
Dialogue: 0,0:40:03.14,0:40:06.18,Default,,0,0,0,,Aku melakukan ini bukan untukmu, tapi untuk kucing-kucing liar itu.
Dialog: 0,0:40:08.68,0:40:10.01,Default,,0,0,0,,Saya akan berbagi resepnya dengan Anda.
Dialog: 0,0:40:10.41,0:40:13.48,Default,,0,0,0,,Terima kasih, Yang Mulia.
Dialog: 0,0:40:14.65,0:40:16.05,Default,,0,0,0,,Apa yang kamu bicarakan. Kamu menakutkan.
Dialog: 0,0:40:18.56,0:40:21.29,Default,,0,0,0,,Oke, bawakan aku kertasnya.
Dialog: 0,0:40:32.04,0:40:33.14,Default,,0,0,0,,Hon Young.
Dialog: 0,0:40:33.14,0:40:35.17,Default,,0,0,0,,Kirimkan ini ke tabib kerajaan.
Dialog: 0,0:40:35.57,0:40:36.61,Default,,0,0,0,,Ya.
Dialog: 0,0:40:44.05,0:40:46.68,Default,,0,0,0,,Rekomendasikan herbal aromatik yang baik untuk kulit.
Dialog: 0,0:40:47.65,0:40:50.25,Default,,0,0,0,,Jika saya tidak menyukainya, dapatkan tugas baru.
Dialog: 0,0:40:52.42,0:40:54.39,Default,,0,0,0,,Tugas baru?
Dialogue: 0,0:40:54.73,0:40:56.43,Default,,0,0,0,,Ada juga di sisi belakang.
Dialog: 0,0:40:58.60,0:41:01.50,Default,,0,0,0,,Saya memerlukan seorang kasim di sini untuk memilih selir kerajaan.
Dialogue: 0,0:41:02.60,0:41:06.50,Default,,0,0,0,,Kenapa dia selalu berusaha menjadikanku kasim?
Dialog: 0,0:41:17.75,0:41:18.78,Default,,0,0,0,,Yang Mulia.
Dialogue: 0,0:41:19.45,0:41:22.05,Default,,0,0,0,,Luangkan waktumu. Anda bisa melukai diri sendiri dengan cara ini.
Dialogue: 0,0:41:26.79,0:41:29.29,Default,,0,0,0,,Di mana saya bisa menemukan buku tentang pesta kerajaan?
Dialogue: 0,0:41:30.66,0:41:32.90,Default,,0,0,0,,Aku akan mencarikannya untukmu.
Dialog: 0,0:41:40.74,0:41:43.61,Default,,0,0,0,,Saya tertarik dengan pesta kerajaan di Yeongjo.
Dialog: 0,0:41:44.58,0:41:45.61,Default,,0,0,0,,Ya.
Dialog: 0,0:41:58.36,0:42:00.29,Default,,0,0,0,,Saya pergi ke aula Seongwonjong,
Dialog: 0,0:42:00.29,0:42:01.93,Default,,0,0,0,,dan saya diberitahu bahwa Anda sedang menuju ke sini.
Dialogue: 0,0:42:02.96,0:42:05.33,Default,,0,0,0,,Untuk apa aku senang bertemu denganmu?
Dialog: 0,0:42:05.83,0:42:09.87,Default,,0,0,0,,Aku hanya berpikir kita jarang bertemu.
Dialog: 0,0:42:10.50,0:42:12.67,Default,,0,0,0,,Saya ingin berbicara dengan Anda.
Dialog: 0,0:42:28.19,0:42:29.29,Default,,0,0,0,,Bantu dirimu sendiri.
Dialogue: 0,0:42:42.93,0:42:45.94,Default,,0,0,0,,Apakah karena kamu membuat tehnya sendiri?
Dialog: 0,0:42:46.87,0:42:48.67,Default,,0,0,0,,Rasanya lebih halus.
Dialog: 0,0:42:50.94,0:42:54.21,Default,,0,0,0,,Saat aku melihatmu, aku teringat mendiang raja.
Dialogue: 0,0:42:54.75,0:42:59.18,Default,,0,0,0,,Jadi sulit bagiku untuk tetap dekat denganmu.
Dialog: 0,0:43:00.05,0:43:03.29,Default,,0,0,0,,Maaf karena tidak menyadarinya sebelumnya.
Dialog: 0,0:43:03.85,0:43:08.43,Default,,0,0,0,,Kupikir aku tahu banyak tentang mendiang raja.
Dialog: 0,0:43:09.33,0:43:11.16,Default,,0,0,0,,Tapi mungkin mendiang raja,
Dialog: 0,0:43:13.73,0:43:15.07,Default,,0,0,0,,anakku,
Dialog: 0,0:43:15.73,0:43:19.27,Default,,0,0,0,,adalah raja yang lebih hebat dari yang kukira,
Dialog: 0,0:43:20.30,0:43:21.84,Default,,0,0,0,,dilihat dari faktanya
Dialog: 0,0:43:21.84,0:43:24.74,Default,,0,0,0,,bagaimana dia bertarung dengan Kim untuk mendapatkan kekuasaan tertinggi.
Dialog: 0,0:43:26.94,0:43:28.78,Default,,0,0,0,,Aku mencela diriku sendiri karena
Dialog: 0,0:43:29.31,0:43:32.42,Default,,0,0,0,,bahwa dia tidak bisa memanggil jenisnya
Dialog: 0,0:43:33.18,0:43:35.59,Default,,0,0,0,,dukung raja dan perjuangannya.
Dialog: 0,0:43:38.42,0:43:40.56,Default,,0,0,0,,Jangan salahkan dirimu sendiri.
Dialog: 0,0:43:40.96,0:43:44.86,Default,,0,0,0,,Saya yakin mendiang raja tidak menginginkan ini.
Dialog: 0,0:43:45.96,0:43:49.23,Default,,0,0,0,,Saya pikir jika saya bisa
Dialogue: 0,0:43:49.97,0:43:53.97,Default,,0,0,0,,perbaiki kesalahanku dengan bantuanmu?
Dialog: 0,0:44:18.03,0:44:21.10,Default,,0,0,0,,Saya dalam banyak hal lebih rendah daripada mendiang raja.
Dialog: 0,0:44:24.47,0:44:25.97,Default,,0,0,0,,Benarkah?
Dialog: 0,0:44:27.67,0:44:30.57,Default,,0,0,0,,Jika Anda berbagi tujuan mendiang raja,
Dialogue: 0,0:44:31.21,0:44:35.18,Default,,0,0,0,,biarkan aku membantumu.
Dialog: 0,0:44:36.95,0:44:40.48,Default,,0,0,0,,Saya tidak akan mengulangi kesalahan saya.
Dialog: 0,0:44:41.42,0:44:43.12,Default,,0,0,0,,Saya akan mengingatnya.
Dialogue: 0,0:44:46.22,0:44:50.53,Default,,0,0,0,,Aku sangat senang bisa sedikit mengenalmu hari ini.
Dialog: 0,0:44:50.53,0:44:52.56,Default,,0,0,0,,Tidak, terima kasih.
Dialog: 0,0:44:53.16,0:44:54.43,Default,,0,0,0,,Aku akan meninggalkanmu.
Dialogue: 0,0:45:07.78,0:45:09.68,Default,,0,0,0,,Aku akan menunggu di tempat biasa kita.
Dialog: 0,0:45:31.37,0:45:33.60,Default,,0,0,0,,Yang Mulia telah tiba.
Dialog: 0,0:45:40.54,0:45:43.11,Default,,0,0,0,,Maaf. Sudah berapa lama kamu menungguku?
Dialog: 0,0:45:43.98,0:45:45.35,Default,,0,0,0,,Tunggu di luar.
Dialogue: 0,0:45:49.12,0:45:52.26,Default,,0,0,0,,Saya pikir kamu tidak akan datang, jadi saya kembali.
Dialog: 0,0:45:52.89,0:45:54.53,Default,,0,0,0,,Saya terlambat membaca surat itu.
Dialog: 0,0:45:55.09,0:45:56.33,Default,,0,0,0,,Jadi kamu sedang sibuk.
Dialog: 0,0:45:57.29,0:45:59.06,Default,,0,0,0,,Sampai-sampai mereka lupa tentang surat itu.
Dialog: 0,0:45:59.06,0:46:01.57,Default,,0,0,0,,Sebenarnya, Ibu Suri datang
Dialog: 0,0:46:01.57,0:46:03.00,Default,,0,0,0,,bicara padaku.
Dialog: 0,0:46:05.00,0:46:06.97,Default,,0,0,0,,Apa yang tadi kamu bicarakan?
Dialog: 0,0:46:07.47,0:46:08.94,Default,,0,0,0,,Hanya percakapan biasa.
Dialog: 0,0:46:11.38,0:46:12.61,Default,,0,0,0,,Sepertinya sudah
Dialogue: 0,0:46:13.81,0:46:16.85,Default,,0,0,0,,semakin banyak rahasia dariku.
Dialog: 0,0:46:17.85,0:46:20.92,Default,,0,0,0,,Lalu apa yang kamu diskusikan dengan ratu?
Dialog: 0,0:46:21.55,0:46:23.59,Default,,0,0,0,,Saat kamu berada di danau.
Dialogue: 0,0:46:25.12,0:46:27.73,Default,,0,0,0,,-Apakah kamu melihatnya?\N-Benarkah?
Dialog: 0,0:46:28.16,0:46:29.33,Default,,0,0,0,,Tidak.
Dialog: 0,0:46:29.86,0:46:32.43,Default,,0,0,0,,Kita membahas pemilihan selir kerajaan.
Dialogue: 0,0:46:33.96,0:46:35.03,Default,,0,0,0,,Selir.
Dialog: 0,0:46:37.13,0:46:38.57,Default,,0,0,0,,Saya yakin Anda menolak.
Dialogue: 0,0:46:38.97,0:46:41.31,Default,,0,0,0,,Kita perlu mengalihkan perhatian Kim.
Dialog: 0,0:46:41.31,0:46:43.67,Default,,0,0,0,,Jika kita bertabrakan dengan musuh lain,
Dialog: 0,0:46:43.67,0:46:45.68,Default,,0,0,0,,mereka akan melupakan takhta untuk sementara waktu.
Dialogue: 0,0:46:45.68,0:46:48.71,Default,,0,0,0,,Jadi kamu setuju dengan ini?
Dialog: 0,0:46:49.15,0:46:51.92,Default,,0,0,0,,-Ya.\N-Ini semua intrik ratu!
Dialog: 0,0:46:52.88,0:46:53.95,Default,,0,0,0,,Permaisuri Kerajaan.
Dialog: 0,0:46:53.95,0:46:56.25,Default,,0,0,0,,Mengapa kamu memanggilku permaisuri?
Dialogue: 0,0:46:56.49,0:46:59.19,Default,,0,0,0,,Kenapa kamu tidak memanggilku dengan nama lagi?
Dialog: 0,0:47:00.06,0:47:04.76,Default,,0,0,0,,Kamu bilang hanya aku yang bisa membuatmu bahagia atau sedih.
Dialog: 0,0:47:05.50,0:47:06.90,Default,,0,0,0,,Tapi sekarang
Dialogue: 0,0:47:07.26,0:47:09.97,Default,,0,0,0,,ini bukan tentang aku lagi, kan?
Dialog: 0,0:47:11.17,0:47:14.51,Default,,0,0,0,,-Hwajin.\N-Tolong beritahu saya bagaimana perasaan Anda.
Dialogue: 0,0:47:15.57,0:47:16.81,Default,,0,0,0,,Benarkah
Dialogue: 0,0:47:18.78,0:47:21.15,Default,,0,0,0,,apakah kamu sudah jatuh cinta pada ratu?
Dialog: 0,0:47:30.82,0:47:32.82,Default,,0,0,0,,Dasar masakan Barat adalah saus dan saus.
Dialog: 0,0:47:33.09,0:47:35.03,Default,,0,0,0,,Pada saat yang sama, pengisian bahan bakar adalah sorotan utama.
Dialog: 0,0:47:35.86,0:47:36.89,Default,,0,0,0,,Coba.
Dialogue: 0,0:47:38.46,0:47:41.80,Default,,0,0,0,,Jika saya menggunakan ini, bisakah saya membuat susu dari kacang?
Dialog: 0,0:47:43.90,0:47:45.04,Default,,0,0,0,,Tapi kenapa kamu sendirian?
Dialog: 0,0:47:45.67,0:47:46.70,Default,,0,0,0,,Apa?
Dialogue: 0,0:47:49.11,0:47:51.61,Default,,0,0,0,,Saya tidak punya waktu untuk menikah karena pekerjaan penuh waktu saya.
Dialog: 0,0:47:52.64,0:47:53.91,Default,,0,0,0,,Bagaimana dengan orang tua dan kerabat lainnya?
Dialog: 0,0:47:55.68,0:47:58.35,Default,,0,0,0,,Pada tahun 1839, semua umat Katolik dibunuh.
Dialog: 0,0:47:58.35,0:47:59.68,Default,,0,0,0,,Jadi aku ditinggal sendirian.
Dialogue: 0,0:48:01.92,0:48:04.05,Default,,0,0,0,,Mengapa mereka menjadi Katolik?
Dialogue: 0,0:48:04.76,0:48:07.22,Default,,0,0,0,,Itulah sebabnya aku tidak percaya pada apa pun.
Dialog: 0,0:48:08.43,0:48:09.73,Default,,0,0,0,,Penganiayaan Katolik.
Dialog: 0,0:48:12.43,0:48:13.53,Default,,0,0,0,,Kamu pasti kesepian.
Dialogue: 0,0:48:14.70,0:48:16.97,Default,,0,0,0,,Bukan hanya aku saja yang berakhir seperti ini.
Dialogue: 0,0:48:18.84,0:48:21.64,Default,,0,0,0,,Agak sedih menghabiskan liburan sendirian,
Dialog: 0,0:48:22.81,0:48:24.17,Default,,0,0,0,,tapi kelebihannya adalah,
Dialog: 0,0:48:25.61,0:48:29.61,Default,,0,0,0,,bahwa mereka mati di hari yang sama,\Njadi kebangkitannya hanya setahun sekali.
Dialog: 0,0:48:37.62,0:48:39.22,Default,,0,0,0,,Ada apa dengan kalian semua?
Dialogue: 0,0:48:39.36,0:48:41.93,Default,,0,0,0,,Bagaimana kamu tahu kalau aku rentan terhadap bau kesedihan?
Dialogue: 0,0:48:43.43,0:48:45.43,Default,,0,0,0,,-Bau kesedihan?\N-Makanannya berbau kesedihan.
Dialog: 0,0:48:46.56,0:48:48.90,Default,,0,0,0,,Saat juru masak sedih dan makanan dipenuhi kesedihan.
Dialog: 0,0:48:50.20,0:48:51.27,Default,,0,0,0,,Saya tahu.
Dialog: 0,0:48:51.57,0:48:53.84,Default,,0,0,0,,Oleh karena itu, entah itu kebahagiaan atau kesedihan,
Dialog: 0,0:48:53.84,0:48:57.04,Default,,0,0,0,,Aku meninggalkan semua emosiku di depan pintu,
Dialog: 0,0:48:57.04,0:48:58.94,Default,,0,0,0,,sebelum memasuki dapur.
Dialogue: 0,0:48:59.41,0:49:00.91,Default,,0,0,0,,Tapi kamu selalu marah.
Dialogue: 0,0:49:00.91,0:49:04.52,Default,,0,0,0,,Itu karena setiap kali kamu datang, kamu membuatku kesal.
Dialog: 0,0:49:06.38,0:49:09.29,Default,,0,0,0,,Salahkan diri sendiri karena kurang latihan. Tidak ada orang lain yang diperlukan.
Dialog: 0,0:49:09.49,0:49:11.76,Default,,0,0,0,,Lihat saja yang ini.
Dialog: 0,0:49:11.76,0:49:12.99,Default,,0,0,0,,Lihat yang ini?
Dialog: 0,0:49:13.56,0:49:14.73,Default,,0,0,0,,Apakah kamu mengatakan "ini"?
Dialog: 0,0:49:14.93,0:49:16.49,Default,,0,0,0,,Lihat dirimu.
Dialog: 0,0:49:17.96,0:49:19.20,Default,,0,0,0,,Lebih buruk lagi!
Dialog: 0,0:49:19.80,0:49:21.90,Default,,0,0,0,,Kami seharusnya membiarkanmu terbunuh.
Dialog: 0,0:49:23.03,0:49:25.27,Default,,0,0,0,,Saya baik sekali.
Dialog: 0,0:49:38.12,0:49:40.45,Default,,0,0,0,,Saya baru saja makan.
Dialog: 0,0:49:41.42,0:49:42.75,Default,,0,0,0,,Saya tidak tahu kenapa.
Dialogue: 0,0:49:54.43,0:49:57.23,Default,,0,0,0,,Ini bukan untuk makanan. Lampirkan
Dialog: 0,0:49:57.97,0:49:59.44,Default,,0,0,0,,di depan wajahmu.
Dialog: 0,0:50:01.91,0:50:04.38,Default,,0,0,0,,Jadi saya akan menjadi sangat diperlukan:
Dialog: 0,0:50:05.28,0:50:07.95,Default,,0,0,0,,Makanan Korea dan perawatan pribadi Korea.
Dialog: 0,0:50:13.52,0:50:15.89,Default,,0,0,0,,Cuaca tepat untuk mengeringkan sayuran.
Dialog: 0,0:50:36.07,0:50:37.17,Default,,0,0,0,,Yang Mulia.
Dialogue: 0,0:50:38.18,0:50:40.54,Default,,0,0,0,,Aku tidak melihatmu kemarin.
Dialogue: 0,0:50:40.54,0:50:43.11,Default,,0,0,0,,Saya harap kamu tidak mengalami mabuk parah.
Dialog: 0,0:50:50.75,0:50:52.66,Default,,0,0,0,,Maaf meninggalkan postingan saya.
Dialog: 0,0:50:54.19,0:50:56.19,Default,,0,0,0,,Saya ingin berbicara dengan Anda.
Dialogue: 0,0:50:58.10,0:51:00.96,Default,,0,0,0,,Ingat apa yang terjadi sebelum kamu jatuh ke kondisi vegetatif?
Dialog: 0,0:51:01.37,0:51:04.60,Default,,0,0,0,,Tidak melihat sesuatu atau seseorang yang mencurigakan?
Dialog: 0,0:51:05.10,0:51:07.20,Default,,0,0,0,,Di bawah seseorang yang mencurigakan
Dialog: 0,0:51:07.37,0:51:09.54,Default,,0,0,0,,siapa maksudmu?
Dialog: 0,0:51:09.64,0:51:10.97,Default,,0,0,0,,Siapapun.
Dialog: 0,0:51:11.21,0:51:13.71,Default,,0,0,0,,Sejujurnya,
Dialog: 0,0:51:13.71,0:51:16.51,Default,,0,0,0,,Saya pikir kondisi saya dikaitkan dengan kekuatan dunia lain.
Dialogue: 0,0:51:16.51,0:51:19.28,Default,,0,0,0,,Dengan kekuatan dunia lain\N maksudmu musuh?
Dialog: 0,0:51:19.28,0:51:20.48,Default,,0,0,0,,Tidak.
Dialog: 0,0:51:22.22,0:51:26.69,Default,dash,0,0,0,,Maksud saya, itu terjadi secara alami.
Dialog: 0,0:51:27.69,0:51:30.19,Default,,0,0,0,,Kamu akan terkejut, tapi aku akan tetap mengatakannya.
Dialog: 0,0:51:30.86,0:51:33.43,Default,,0,0,0,,Saya curiga raja terlibat dalam hal ini.
Dialog: 0,0:51:34.20,0:51:36.20,Default,,0,0,0,,Menurut penyelidikan,
Dialog: 0,0:51:36.20,0:51:38.20,Default,,0,0,0,,orang yang menyerangmu di Octajeon,
Dialog: 0,0:51:39.27,0:51:41.47,Default,,0,0,0,,dikirim oleh Yang Mulia.
Dialogue: 0,0:51:42.64,0:51:44.44,Default,,0,0,0,,Tahu kamu akan terkejut.
Dialog: 0,0:51:44.94,0:51:46.11,Default,,0,0,0,,Bagaimana kamu tahu?
Dialog: 0,0:51:46.81,0:51:48.25,Default,,0,0,0,,Hanya saya yang tahu tentang ini.
Dialog: 0,0:51:49.28,0:51:50.95,Default,,0,0,0,,Tahukah kamu?
Dialogue: 0,0:51:51.92,0:51:53.38,Default,,0,0,0,,Nah, itu masalahnya.
Dialog: 0,0:51:54.08,0:51:56.09,Default,,0,0,0,,Semuanya sangat membingungkan,
Dialog: 0,0:51:56.09,0:51:58.12,Default,,0,0,0,,jadi kami memutuskan untuk melupakan kejadian ini.
Dialogue: 0,0:51:58.12,0:52:01.06,Default,,0,0,0,,Dan kamu bersikap seolah-olah tidak terjadi apa-apa?
Dialogue: 0,0:52:01.56,0:52:04.76,Default,,0,0,0,,Apakah kamu terus mencintainya meskipun dia telah berbuat apa?
Dialog: 0,0:52:05.13,0:52:07.33,Default,,0,0,0,,Apa? Cinta?
Dialogue: 0,0:52:07.87,0:52:10.50,Default,,0,0,0,,Sungguh menjijikkan!
Dialog: 0,0:52:11.13,0:52:14.40,Default,,0,0,0,,Aku ingin hidup bahagia di sini,\N Aku harus rukun dengan raja.
Dialog: 0,0:52:14.51,0:52:16.61,Default,,0,0,0,,Saya tidak punya pilihan!
Dialog: 0,0:52:16.61,0:52:17.88,Default,,0,0,0,,Lalu bagaimana kamu bisa...
Dialog: 0,0:52:17.88,0:52:18.98,Default,,0,0,0,,saya sudah bingung,
Dialogue: 0,0:52:18.98,0:52:20.48,Default,,0,0,0,,dan yang kamu bicarakan di sini adalah cinta.
Dialog: 0,0:52:22.35,0:52:24.21,Default,,0,0,0,,Bagaimana pilihan selirnya?
Dialog: 0,0:52:24.55,0:52:25.75,Default,,0,0,0,,Nyonya Choi!
Dialog: 0,0:52:25.98,0:52:27.28,Default,,0,0,0,,Nyonya Choi!
Dialog: 0,0:52:35.32,0:52:37.72,Default,,0,0,0,,Anak-anak, aku di sini!..
Dialog: 0,0:52:40.16,0:52:41.96,Default,,0,0,0,,Di mana kandidatnya?
Dialog: 0,0:52:42.63,0:52:45.30,Default,,0,0,0,,Mereka ada di sini.
Dialog: 0,0:52:56.78,0:52:57.78,Default,,0,0,0,,Apa ini?
Dialog: 0,0:52:57.78,0:52:59.91,Default,,0,0,0,,Saya sangat menantikan ini.
Dialogue: 0,0:53:01.68,0:53:04.92,Default,,0,0,0,,Ada apa?
Dialog: 0,0:53:22.17,0:53:26.04,Default,,0,0,0,,Saya tidak bisa menolak kaleidoskop.
Dialogue: 0,0:53:35.05,0:53:37.92,Default,,0,0,0,,Dia bertindak sejauh ini demi keluarga kita?
Dialog: 0,0:53:47.03,0:53:49.10,Default,,0,0,0,,Sekali lagi, apa namanya?
Dialogue: 0,0:53:50.03,0:53:52.23,Default,,0,0,0,,Dia menyebutnya tabir keindahan.
Dialog: 0,0:53:52.70,0:53:54.77,Default,,0,0,0,,Saya sedang mencari seseorang untuk menggantikannya,
Dialogue: 0,0:53:55.17,0:53:57.47,Default,,0,0,0,,dan dia memberiku perlakuan baru.
Dialog: 0,0:54:00.11,0:54:01.74,Default,,0,0,0,,Yang Mulia.
Dialog: 0,0:54:01.74,0:54:03.38,Default,,0,0,0,,Ini adalah kepala Departemen Detektif, Kim Byungin.
Dialogue: 0,0:54:05.31,0:54:06.58,Default,,0,0,0,,Pada jam segini?
Dialog: 0,0:54:08.98,0:54:10.12,Default,,0,0,0,,Enter.
Dialog: 0,0:54:26.37,0:54:28.84,Default,,0,0,0,,Aku menyebutmu dalam percakapan dengan saudaraku, jadi dia menyuruhmu datang,
Dialog: 0,0:54:29.27,0:54:31.04,Default,,0,0,0,,tapi sekarang sudah terlambat.
Dialog: 0,0:54:31.24,0:54:33.37,Default,,0,0,0,,Saya tidak menerima pesan seperti itu.
Dialog: 0,0:54:34.84,0:54:37.18,Default,,0,0,0,,Aku berani bersikeras untuk bertemu denganmu, karena aku harus melakukannya
Dialog: 0,0:54:37.54,0:54:40.18,Default,,0,0,0,,ucapkan sesuatu untuk melewati ayahmu.
Dialogue: 0,0:54:42.45,0:54:43.65,Default,,0,0,0,,Mungkin ayahku
Dialogue: 0,0:54:44.85,0:54:47.19,Default,,0,0,0,,mengatakan bahwa Yang Mulia berbeda dengan pendahulunya.
Dialogue: 0,0:54:49.99,0:54:51.89,Default,,0,0,0,,Tapi dia salah.
Dialog: 0,0:55:08.24,0:55:09.28,Default,,0,0,0,,Apa?
Dialog: 0,0:55:12.48,0:55:13.48,Default,,0,0,0,,Tidak...
Dialogue: 0,0:55:17.05,0:55:18.92,Default,,0,0,0,,Jangan ikuti aku.
Dialogue: 0,0:55:24.12,0:55:25.53,Default,,0,0,0,,Itu hanya hal sepele.
Dialogue: 0,0:55:26.96,0:55:28.33,Default,,0,0,0,,Sedikit ginseng merah.
Dialog: 0,0:55:28.93,0:55:31.36,Default,,0,0,0,,-Ini, ambillah.\N-Terima kasih.
Dialog: 0,0:55:34.00,0:55:38.11,Default,,0,0,0,,Ngomong-ngomong, apakah semuanya baik-baik saja?
Dialogue: 0,0:55:38.11,0:55:39.91,Default,,0,0,0,,Dengan apa?
Dialog: 0,0:55:40.71,0:55:43.04,Default,,0,0,0,,Tak perlu bicara teka-teki, langsung ke intinya.
Dialog: 0,0:55:43.04,0:55:44.98,Default,,0,0,0,,Apa yang kamu bicarakan?
Dialog: 0,0:55:45.65,0:55:48.88,Default,,0,0,0,,Aku hanya ingin tahu bagaimana keadaannya.
Dialog: 0,0:55:50.55,0:55:55.46,Default,,0,0,0,,Saya berasumsi Benin masih di istana?
Dialog: 0,0:56:03.56,0:56:05.13,Default,,0,0,0,,Salam.
Dialogue: 0,0:56:06.43,0:56:08.90,Default,,0,0,0,,-Aku kembali.\N-Kamu terlambat hari ini.
Dialog: 0,0:56:08.90,0:56:12.37,Default,,0,0,0,,Tidak pernah ada waktu untuk hanya bersama rekan kerja,
Dialogue: 0,0:56:12.37,0:56:14.04,Default,,0,0,0,,jadi aku minum bersama mereka di Departemen Detektif.
Dialog: 0,0:56:14.51,0:56:15.58,Default,,0,0,0,,Oke.
Dialogue: 0,0:56:16.18,0:56:18.51,Default,,0,0,0,,Sudah terlambat. Istirahatlah.
Dialog: 0,0:56:19.01,0:56:21.68,Default,,0,0,0,,Oke, kembali ke percakapanmu.
Dialog: 0,0:56:22.78,0:56:25.25,Default,,0,0,0,,Oke. Selamat malam.
Dialog: 0,0:56:30.49,0:56:32.23,Default,,0,0,0,,-Menteri\N-Ya.
Dialog: 0,0:56:32.99,0:56:34.49,Default,,0,0,0,,Terlihat khawatir.
Dialogue: 0,0:56:35.90,0:56:39.33,Default,,0,0,0,,Menggigit lebih dari yang bisa dikunyah akan membuatmu gugup.
Dialog: 0,0:56:39.33,0:56:42.40,Default,,0,0,0,,Apa... Saya tidak begitu mengerti.
Dialog: 0,0:56:42.94,0:56:44.27,Default,,0,0,0,,Kamu tidak mengerti bahwa kamu bisa
Dialogue: 0,0:56:44.27,0:56:48.11,Default,,0,0,0,,membawa bencana pada dirimu dan ratu dengan kecerobohanmu?
Dialogue: 0,0:56:48.34,0:56:49.94,Default,,0,0,0,,Kalau aku khawatir, itu karena
Dialog: 0,0:56:51.11,0:56:53.88,Default,,0,0,0,,bahwa tidak mungkin menangkap orang yang menyerang ratu.
Dialogue: 0,0:56:55.28,0:56:58.32,Default,,0,0,0,,-Benarkah begitu?\N-Yah, sudah terlambat.
Dialog: 0,0:56:58.32,0:56:59.89,Default,,0,0,0,,Kamu pasti lelah.
Dialog: 0,0:57:00.65,0:57:03.02,Default,,0,0,0,,Saya baru saja masuk untuk memberikan hadiah,
Dialog: 0,0:57:03.49,0:57:04.86,Default,,0,0,0,,Saya harus pergi.
Dialog: 0,0:57:12.33,0:57:14.40,Default,,0,0,0,,Dia kehilangan buku besar.
Dialog: 0,0:57:15.07,0:57:17.30,Default,,0,0,0,,Jika dia tidak ada hubungannya dengan itu, apakah itu berarti Byonin bertindak sendiri?
Dialog: 0,0:57:18.27,0:57:19.44,Default,,0,0,0,,Dan jika tidak...
Dialog: 0,0:57:20.67,0:57:21.71,Default,,0,0,0,,Benarkah?
Dialogue: 0,0:57:49.07,0:57:52.01,Default,,0,0,0,,Terima kasih, ini bukan aku.
Dialog: 0,0:57:53.81,0:57:56.34,Default,,0,0,0,,Butuh waktu lama
Dialog: 0,0:57:56.88,0:57:58.85,Default,,0,0,0,,temukan benda serupa.
Dialogue: 0,0:57:59.08,0:58:00.78,Default,,0,0,0,,Ceritakan padaku.
Dialogue: 0,0:58:00.78,0:58:02.55,Default,,0,0,0,,Dia tenggelam.
Dialog: 0,0:58:02.55,0:58:06.75,Default,,0,0,0,,Wajah tidak dapat dikenali karena sudah lama berada di dalam air.
Dialog: 0,0:58:11.16,0:58:13.93,Default,,0,0,0,,Tolong beritahu saya bagaimana perasaan Anda.
Dialog: 0,0:58:15.96,0:58:17.13,Default,,0,0,0,,Apakah kamu
Dialogue: 0,0:58:19.17,0:58:21.33,Default,,0,0,0,,jatuh cinta pada ratu?
Dialog: 0,0:58:27.34,0:58:28.38,Default,,0,0,0,,I
Dialog: 0,0:58:30.94,0:58:33.21,Default,,0,0,0,,tidak boleh mencintai ratu.
Dialog: 0,0:58:35.68,0:58:37.42,Default,,0,0,0,,Kamu tidak menyangkal bahwa kamu sedang jatuh cinta.
Dialog: 0,0:58:38.65,0:58:40.39,Default,,0,0,0,,Katakan saja kamu tidak boleh mencintai.
Dialog: 0,0:58:55.17,0:58:57.30,Default,,0,0,0,,Yang Mulia, Pangeran Yeonpyeong ada di sini.
Dialog: 0,0:58:58.17,0:58:59.64,Default,,0,0,0,,Ya, masuk.
Dialog: 0,0:59:08.18,0:59:09.92,Default,,0,0,0,,Maaf atas kunjungan yang terlambat.
Dialog: 0,0:59:09.92,0:59:11.18,Default,,0,0,0,,Saya punya berita yang Anda tunggu-tunggu.
Dialogue: 0,0:59:12.19,0:59:13.69,Default,,0,0,0,,Sudahkah kamu menemukan Ovol?
Dialogue: 0,0:59:25.00,0:59:27.23,Default,,0,0,0,,Apakah kamu memberikan ini padanya?
Dialog: 0,0:59:28.77,0:59:31.34,Default,,0,0,0,,Ya, ini hadiahku.
Dialogue: 0,0:59:31.34,0:59:34.17,Default,,0,0,0,,Nyonya istana menjualnya.
Dialog: 0,0:59:37.14,0:59:40.11,Default,,0,0,0,,Jadi Ovol masih hidup. Sungguh sebuah berkah.
Dialog: 0,0:59:41.92,0:59:44.72,Default,,0,0,0,,Mengapa mengirimku untuk mengambil air di tengah malam?
Dialog: 0,0:59:45.95,0:59:47.55,Default,,0,0,0,,Mereka tidak bisa bertanya sebelumnya.
Dialog: 0,0:59:57.06,0:59:58.30,Default,,0,0,0,,Apakah ada yang macet di sana?
Dialog: 0,1:00:02.60,1:00:03.94,Default,,0,0,0,,Apa ini?
Dialog: 0,1:00:17.68,1:00:20.29,Default,,0,0,0,,Saya menyewa seorang seniman untuk melukis potret wanita itu.
Dialog: 0,1:00:20.62,1:00:22.32,Default,,0,0,0,,Begitu kita melihatnya, kita akan tahu pasti.
Dialog: 0,1:00:29.66,1:00:32.50,Default,,0,0,0,,Saya benar-benar memikirkan cara untuk membantu raja...
Dialog: 0,1:00:32.50,1:00:33.53,Default,,0,0,0,,Yang Mulia.
Dialog: 0,1:00:35.54,1:00:36.70,Default,,0,0,0,,Di dalam sumur...
Dialog: 0,1:00:37.67,1:00:40.11,Default,,0,0,0,,-Di dalam sumur?\N-Mereka menemukan mayat di sana.
Dialog: 0,1:00:40.11,1:00:43.54,Default,,0,0,0,,Sepertinya Ovol, pelayanmu.
Dialog: 0,1:00:44.18,1:00:45.18,Default,,0,0,0,,Ovol?
Dialog: 0,1:00:48.25,1:00:49.35,Default,,0,0,0,,-Apa yang harus kita lakukan?\N-Itulah masalahnya.
Dialog: 0,1:00:59.76,1:01:01.19,Default,,0,0,0,,Ini mungkin menyakitimu.
Dialog: 0,1:01:01.66,1:01:03.46,Default,,0,0,0,,-Biarkan aku...\N-Tidak.
Dialog: 0,1:01:04.30,1:01:06.40,Default,,0,0,0,,Saya harus melihatnya sendiri.
Dialog: 0,1:01:42.00,1:01:43.34,Default,,0,0,0,,-Pernahkah Anda melihat ini?\N-Ini mengerikan.
Dialog: 0,1:01:45.54,1:01:47.84,Default,,0,0,0,,Sepertinya dia berada di bawah air untuk waktu yang lama.
Dialog: 0,1:01:48.98,1:01:52.95,Default,,0,0,0,,Saya mengerti betapa menyakitkannya hal ini.
Dialog: 0,1:02:19.94,1:02:21.07,Default,,0,0,0,,Tolong hentikan.
Dialog: 0,1:02:22.81,1:02:24.54,Default,,0,0,0,,Saya baru saja memulai.
Dialog: 0,1:02:24.94,1:02:25.95,Default,,0,0,0,,Yang Mulia.
Dialog: 0,1:02:27.48,1:02:28.98,Default,,0,0,0,,Aku ingin sendiri.
Dialog: 0,1:03:11.66,1:03:12.86,Default,,0,0,0,,Itu,
Dialog: 0,1:03:14.09,1:03:16.16,Default,,0,0,0,,yang membuatku senang dan sedih.
Dialog: 0,1:03:17.70,1:03:20.73,Default,,0,0,0,,Yang Mulia, Janda Ratu ada di sini.
Dialog: 0,1:03:29.81,1:03:31.01,Default,,0,0,0,,Apa yang membawamu?
Dialog: 0,1:03:42.32,1:03:44.39,Default,,0,0,0,,Apa yang kamu baca?
Dialog: 0,1:03:44.99,1:03:47.93,Default,,0,0,0,,Jadi, salah satu permintaan yang saya lewatkan.
Dialog: 0,1:03:47.93,1:03:50.60,Default,,0,0,0,,Kamu terlihat lebih bersemangat dari biasanya,
Dialog: 0,1:03:51.30,1:03:53.33,Default,,0,0,0,,jadi aku penasaran bagaimana aku menghabiskan waktuku di luar istana.
Dialogue: 0,1:03:53.33,1:03:54.87,Default,,0,0,0,,Itulah yang ingin kutanyakan.
Dialog: 0,1:03:55.20,1:03:56.97,Default,,0,0,0,,Senang rasanya melupakan sejenak
Dialog: 0,1:03:56.97,1:03:58.71,Default,,0,0,0,,tentang urusan istana.
Dialog: 0,1:04:00.11,1:04:01.24,Default,,0,0,0,,Senang mendengarnya.
Dialog: 0,1:04:04.48,1:04:05.48,Default,,0,0,0,,Kau tahu,
Dialogue: 0,1:04:06.41,1:04:08.98,Default,,0,0,0,,Semoga kamu bahagia.
Dialog: 0,1:04:12.39,1:04:13.62,Default,,0,0,0,,Terima kasih banyak.
Dialogue: 0,1:04:14.35,1:04:17.29,Default,,0,0,0,,Kamu telah melalui begitu banyak hal.
Dialog: 0,1:04:18.83,1:04:20.29,Default,,0,0,0,,Apakah kamu sudah melupakan semuanya?
Dialogue: 0,1:04:21.63,1:04:24.50,Default,,0,0,0,,Nasib bisa diwariskan.
Dialog: 0,1:04:25.57,1:04:28.13,Default,,0,0,0,,Kamu akan belajar mensyukuri keadaanmu dan tidak melakukan apa pun,
Dialog: 0,1:04:28.13,1:04:32.34,Default,,0,0,0,,kamu dan orang yang kamu cintai akan tetap aman.
Dialog: 0,1:04:33.51,1:04:36.91,Default,,0,0,0,,Jadi kenapa kamu tidak bisa duduk saja dan tidak melakukan apa pun?
Dialog: 0,1:04:40.25,1:04:43.18,Default,,0,0,0,,Jadilah cerdas, raja.
Dialog: 0,1:04:46.25,1:04:48.76,Default,,0,0,0,,Saya akan melakukannya, Yang Mulia.
Dialog: 0,1:05:20.29,1:05:21.95,Default,,0,0,0,,Rahasia
Dialog: 0,1:05:49.28,1:05:50.88,Default,,0,0,0,,Jadilah cerdas,
Dialog: 0,1:05:51.62,1:05:52.79,Default,,0,0,0,,sayangku.
Dialogue: 0,1:06:35.23,1:06:37.76,Default,,0,0,0,,Beberapa orang hidup dalam mimpi buruk.
Dialog: 0,1:07:02.02,1:07:05.19,Default,,0,0,0,,Kamus Ratu.
Dialog: 0,1:07:11.30,1:07:14.43,Default,,0,0,0,,Jarak sosial
Dialog: 0,1:07:18.87,1:07:23.08,Default,,0,0,0,,jadi semua orang sendirian.
Dialog: 0,1:07:25.31,1:07:29.12,Default,,0,0,0,,Antifan: pembimbing spiritual yang kuat
Dialog: 0,1:07:29.12,1:07:31.52,Default,,0,0,0,,kipas, jejaring sosial, telepon,
Dialog: 0,1:07:31.52,1:07:33.12,Default,,0,0,0,,showdown, ayo menyala,
Dialog: 0,1:07:33.12,1:07:34.89,Default,,0,0,0,,pasukan khusus, lotere, jackpot.
Dialog: 0,1:07:38.49,1:07:39.83,Default,,0,0,0,,Tetapi mereka sering menemukan
Dialog: 0,1:07:40.26,1:07:42.86,Default,,0,0,0,,milikmu sendiri bisa mengatasi mimpi buruk.
Dialog: 0,1:08:13.69,1:08:15.90,Default,,0,0,0,,-Yang Mulia.\N-Yang Mulia.
Dialog: 0,1:08:16.06,1:08:17.60,Default,,0,0,0,,Datanglah kepada kami.
Dialog: 0,1:08:17.60,1:08:18.73,Default,,0,0,0,,Cepat ke kami.
Dialog: 0,1:08:18.73,1:08:19.87,Default,,0,0,0,,Baiklah, kemarilah.
Dialog: 0,1:08:33.98,1:08:35.95,Default,,0,0,0,,Tetapi hanya untuk mimpi indah
Dialog: 0,1:08:36.42,1:08:38.62,Default,,0,0,0,,usir mimpi burukmu...
Dialog: 0,1:08:45.06,1:08:47.43,Default,,0,0,0,,-Aku ingin pelukan juga.\N-Dan kamu?
Dialog: 0,1:08:47.89,1:08:49.36,Default,,0,0,0,,Oke.
Dialog: 0,1:08:52.00,1:08:53.17,Default,,0,0,0,,-Bliss!\N-Ratu.
Dialog: 0,1:08:56.10,1:08:58.30,Default,,0,0,0,,Mimpi buruk baru
Dialog: 0,1:08:59.31,1:09:01.51,Default,,0,0,0,,menemukanmu.
Dialog: 0,1:09:02.34,1:09:03.44,Default,,0,0,0,,Yang Mulia.
Dialog: 0,1:09:04.64,1:09:09.25,Default,,0,0,0,,Kehilangan suaramu, apakah kamu serak, haruskah kamu meneleponku?
Dialogue: 0,1:09:13.52,1:09:15.66,Default,,0,0,0,,Kenapa kamu lupa disini?
Dialogue: 0,1:09:18.16,1:09:19.33,Default,,0,0,0,,Ratuku.
Dialog: 0,1:09:23.23,1:09:24.56,Default,,0,0,0,,Hari ini
Dialog: 0,1:09:25.93,1:09:27.90,Default,,0,0,0,,tidak ada jarak sosial.
Dialog: 0,1:10:01.40,1:10:04.20,Default,,0,0,0,,Apakah ini hatiku? Atau tubuh bertanya?
Dialog: 0,1:10:05.47,1:10:06.67,Default,,0,0,0,,Direktur Han?
Dialog: 0,1:10:06.84,1:10:08.37,Default,,0,0,0,,Semuanya busuk!
Dialog: 0,1:10:08.37,1:10:11.28,Default,,0,0,0,,Kami akan melakukan segalanya untuk mendapatkan bahan-bahannya.
Dialog: 0,1:10:11.28,1:10:15.35,Default,,0,0,0,,Raja di Hari Kereta ingin tampil kuat.
Dialog: 0,1:10:15.35,1:10:16.52,Default,,0,0,0,,Api!
Dialog: 0,1:10:17.55,1:10:20.49,Default,,0,0,0,,Selalu ada orang yang menganggap serius kompetisi.
Dialog: 0,1:10:20.49,1:10:21.49,Default,,0,0,0,,Silau macam apa ini?
Dialog: 0,1:10:21.49,1:10:23.66,Default,,0,0,0,,Jadi aku harus memberimu pelajaran.
Dialog: 0,1:10:23.66,1:10:25.16,Default,,0,0,0,,Akan kutunjukkan siapa bos di istana.
Dialog: 0,1:10:25.16,1:10:26.83,Default,,0,0,0,,Aku tidak akan memaafkanmu.
Dialog: 0,0:00:58.00,0:01:03.00,Default,,0,0,0,,


