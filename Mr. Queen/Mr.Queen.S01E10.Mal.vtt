Dialog: 0,0:00:58.00,0:01:03.98,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДДСТЕ
Dialog: 0,0:00:58.00,0:01:03.98, Lalai,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807}\fscy2007 92 38 l 0 38
Dialog: 0,0:00:58.00,0:01:03.98,работали,,0,0,0,,{\pos(801,256)}Над серией работали:\N Лилия, Тирамису, Биря, Бирю Зингер
Dialog: 0,0:00:58.00,0:01:03.98,tajuk,,0,0,0,,{\fscx75\fscy75\pos(846,392)}Bagaimana saya menjadi
Dialog: 0,0:00:58.00,0:01:03.98,nama,,0,0,0,,{\fscx75\fscy75\pos(848,456)}ratu
Dialog: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialog: 0,0:01:24.85,0:01:25.88, Lalai,Spillik1,0,0,0,,Hwajin.
Dialog: 0,0:01:26.78,0:01:27.78,Lalai,Spillik1,0,0,0,,Hwajin.
Dialog: 0,0:01:38.66,0:01:40.03, Lalai, Spillik1,0,0,0,,Apa yang ada di sana?
Dialog: 0,0:01:43.40,0:01:45.70, Lalai, Spikyulka1,0,0,0,,-Faham, saya berlari untuk mendapatkan bantuan.\N-Tidak.
Dialog: 0,0:01:46.90,0:01:49.44,Lalai,Spillik1,0,0,0,,Tiada sesiapa sepatutnya tahu bahawa saya...
Dialog: 0,0:01:50.67,0:01:52.77,Lalai,Spilyk1,0,0,0,,Apakah saya...
Dialog: 0,0:01:54.17,0:01:55.18,Lalai,Spilyk1,0,0,0,,Tahan.
Dialog: 0,0:01:59.38,0:02:02.28, Lalai,Spillik1,0,0,0,,10 episod.
Dialog: 0,0:02:03.42,0:02:06.49,Lalai,Spikyulka1,0,0,0,,Mengapa anda pergi ke sana, di mana terdapat kenangan yang begitu dahsyat?
Dialog: 0,0:02:07.29,0:02:08.86, Lalai, Spilyk1,0,0,0,,Adakah anda pasti anda tidak boleh menghubungi sesiapa?
Dialog: 0,0:02:09.72,0:02:11.29,Lalai,Spikyulka1,0,0,0,,Bagaimana jika dia mati akhirnya?
Dialog: 0,0:02:15.06,0:02:16.46,Lalai,Spillik1,0,0,0,,Adakah anda mengalami mimpi ngeri lagi?
Dialog: 0,0:02:16.66,0:02:19.03,Lalai,Spillik1,0,0,0,,Hei, bangun.
Dialog: 0,0:02:25.34,0:02:26.34, Lalai,Spillik1,0,0,0,,Hwajin.
Dialog: 0,0:02:28.14,0:02:30.91,Lalai,Spillik1,0,0,0,,Cemerlang. Fikirkan apa yang anda mahu.
Dialog: 0,0:02:38.29,0:02:40.39,Lalai,Spillik1,0,0,0,,Itu tidak bagus. Saya akan pergi mencari seseorang.
Dialog: 0,0:02:43.96,0:02:45.03,Lalai,Spillik1,0,0,0,,Nah, di sini anda sekali lagi.
Dialog: 0,0:02:45.23,0:02:46.83,Lalai,Spillik1,0,0,0,,Saya mengalami mimpi ngeri,
Dialog: 0,0:02:50.10,0:02:52.23,Lalai,Spillik1,0,0,0,,bahawa saya mati sebagai raja yang tidak berharga.
Dialog: 0,0:02:53.37,0:02:55.07,Lalai,Spillik1,0,0,0,,Mimpi ngeri yang menakutkan, di manakah saya
Dialog: 0,0:02:56.64,0:02:59.87,Lalai,Spilyk1,0,0,0,,melihat dunia runtuh
Dialog: 0,0:03:00.67,0:03:03.91, Lalai, Spillik1,0,0,0,, dan tidak dapat berbuat apa-apa.
Dialog: 0,0:03:07.45,0:03:08.82,Lalai,Spilyk1,0,0,0,,Tiada siapa yang bertanya.
Dialog: 0,0:03:11.15,0:03:13.65,Lalai,Spillik1,0,0,0,,Mari kita baring di sana sebentar.
Dialog: 0,0:03:15.79,0:03:17.02,Lalai,Spillik1,0,0,0,,Sekejap.
Dialog: 0,0:03:24.76,0:03:28.27,Lalai,Spillik1,0,0,0,,Saya akan berpura-pura menjadi Hwajin sebentar.
Dialog: 0,0:03:40.15,0:03:42.95,Lalai,Spillik1,0,0,0,,10 episod: Life in a Nightmare
Dialog: 0,0:03:44.78,0:03:46.52,Lalai,Spillik1,0,0,0,,Akhirnya, anda telah menjadi seorang ratu.
Dialog: 0,0:03:47.12,0:03:49.12,Lalai,Spillik1,0,0,0,,Tahu ia akan menjadi seperti ini.
Dialog: 0,0:04:44.84,0:04:46.55,Lalai,Spilyk1,0,0,0,,Rahsia
Dialog: 0,0:04:53.89,0:04:55.66,Lalai,Spillik1,0,0,0,,Saya akan memberitahu segala-galanya kepada Baginda.
Dialog: 0,0:04:56.42,0:04:58.26,Lalai,Spillik1,0,0,0,,Supaya masa lalu tidak lagi mempengaruhi kita.
Dialog: 0,0:05:06.80,0:05:07.83,Lalai,Spillik1,0,0,0,,Yang Mulia.
Dialog: 0,0:05:09.60,0:05:11.24,Lalai,Spillik1,0,0,0,,Saya perlu bercakap dengan Baginda.
Dialog: 0,0:05:11.67,0:05:14.71,Lalai,Spillik1,0,0,0,,Raja dan permaisuri keluar,
Dialog: 0,0:05:15.04,0:05:17.01, Lalai, Spikyulka1,0,0,0,, malah Encik Kim tiada di rumah.
Dialog: 0,0:06:07.96,0:06:09.00, Lalai, Spilyk1,0,0,0,, Ovol.
Dialog: 0,0:06:09.46,0:06:13.30,Lalai,Spillik1,0,0,0,,Saya boleh membantu raja dan memusnahkan permaisuri.
Dialog: 0,0:06:14.50,0:06:15.80,Lalai,Spillik1,0,0,0,,Apa yang perlu saya lakukan?
Dialog: 0,0:07:00.91,0:07:02.02,Lalai,Spillik1,0,0,0,,Yang Mulia.
Dialog: 0,0:07:06.65,0:07:09.59,Lalai,Spilyk1,0,0,0,,Masa untuk mencuci.
Dialog: 0,0:07:58.57,0:07:59.71,Lalai,Spillik1,0,0,0,,Selamat pagi.
Dialog: 0,0:08:02.98,0:08:05.31, Lalai, Spikyulka1,0,0,0,,-Apa yang berlaku?\N-Soalan yang bagus.
Dialog: 0,0:08:05.31,0:08:08.28,Lalai,Sutera1,0,0,0,,Saya hampir menyentuh awak... Iaitu, saya hampir mati.
Dialog: 0,0:08:08.78,0:08:10.45,Lalai,Spilyk1,0,0,0,,Anda sangat berat.
Dialog: 0,0:08:13.42,0:08:14.62,Lalai,Spillik1,0,0,0,,Ia berbahaya.
Dialog: 0,0:08:17.16,0:08:19.03, Lalai, Spikyulka1,0,0,0,,Buku perakaunan tiada di situ.
Dialog: 0,0:08:20.43,0:08:22.13,Lalai,Spillik1,0,0,0,,Anda menyelamatkan saya
Dialog: 0,0:08:22.63,0:08:23.70, Lalai, Spillik1,0,0,0,, dirinya?
Dialog: 0,0:08:26.53,0:08:28.13,Lalai,Spillik1,0,0,0,,Anda tidak mahu saya menghubungi untuk mendapatkan bantuan.
Dialog: 0,0:08:30.34,0:08:33.24,Lalai,Spikyulka1,0,0,0,,Saya terpaksa meneran semua kekuatan saya.
Dialog: 0,0:08:37.84,0:08:40.75,Lalai,Spilyk1,0,0,0,,Saya boleh. Ingat hari ketika anda terpaksa mengangkat 150 kg.
Dialog: 0,0:08:41.61,0:08:43.35,Lalai,Spillik1,0,0,0,,Kekuatan bukan pada otot,
Dialog: 0,0:08:43.72,0:08:46.95, Lalai, Spillik1,0,0,0,, dan dalam penentuan.
Dialog: 0,0:08:53.09,0:08:56.06,Lalai,Spikyulka1,0,0,0,,Mengapa anda naik ke dalam perigi pada masa sedemikian?
Dialog: 0,0:08:58.70,0:09:02.90,Lalai,Spikyulka1,0,0,0,,Ia gelap, saya tidak dapat melihat dengan baik dan jatuh.
Dialog: 0,0:09:04.30,0:09:06.04,Lalai,Spillik1,0,0,0,,Adakah anda buta malam?
Dialog: 0,0:09:06.04,0:09:07.84, Lalai, Spillik1,0,0,0,,Sukar untuk keluar dari perigi.
Dialog: 0,0:09:10.58,0:09:12.15,Lalai,Spillik1,0,0,0,,Adakah anda terjaga?
Dialog: 0,0:09:13.25,0:09:14.51,Lalai,Spillik1,0,0,0,,Tunggu.
Dialog: 0,0:09:16.15,0:09:19.29,Lalai,Spillik1,0,0,0,,Datang ke sini. Lebih cepat.
Dialog: 0,0:09:20.15,0:09:21.62,Lalai,Spillik1,0,0,0,,Tunggu sebentar.
Dialog: 0,0:09:23.79,0:09:25.96,Lalai,Spillik1,0,0,0,,Log masuk.
Dialog: 0,0:09:40.47,0:09:43.74,Lalai,Spikyulka1,0,0,0,,Saya akan tahu bahawa anda akan tinggal di rumah utama,
Dialog: 0,0:09:43.78,0:09:46.58, Lalai, Spilyk1,0,0,0,, akan menyediakan katil yang lebih besar.
Dialog: 0,0:09:46.78,0:09:50.42,Lalai,Spillie1,0,0,0,,Ayah, tidak! Tidak perlu, ayah!
Dialog: 0,0:09:50.42,0:09:53.25,Lalai,Spilyk1,0,0,0,,Ayah! Jangan buat begini!
Dialog: 0,0:09:53.25,0:09:55.72,Lalai,Spillik1,0,0,0,,Tidak! Ayah!
Dialog: 0,0:09:55.72,0:09:56.99,Lalai,Spillie1,0,0,0,,Ayah!
Dialog: 0,0:09:57.06,0:09:58.62,Lalai,Spillik1,0,0,0,,Saya mohon maaf.
Dialog: 0,0:09:59.06,0:10:00.49,Lalai,Spillit1,0,0,0,,Tidak perlu.
Dialog: 0,0:10:00.89,0:10:03.06,Lalai,Spillik1,0,0,0,,Terima kasih atas usaha anda
Dialog: 0,0:10:03.06,0:10:04.60,Lalai,Spilyk1,0,0,0,,Saya berasa selesa di sini.
Dialog: 0,0:10:05.23,0:10:08.63,Lalai,Spillik1,0,0,0,,Tidak perlu menyusahkan kamu lagi,\NI akan kembali ke istana.
Dialog: 0,0:10:09.10,0:10:12.71, Lalai, Spilyk1,0,0,0,,Apakah maksud "masalah"? Jangan cakap macam tu.
Dialog: 0,0:10:13.04,0:10:16.18,Lalai,Spillik1,0,0,0,,Saya datang untuk menyampaikan mesej
Dialog: 0,0:10:16.18,0:10:18.64, Lalai, Spillik1,0,0,0,, ratu janda.
Dialog: 0,0:10:22.32,0:10:27.02,Lalai,Spilyk1,0,0,0,,Dia menghantar untuk anda setiap hari, yang bermaksud
Dialog: 0,0:10:27.02,0:10:29.72,Lalai,Spillik1,0,0,0,,dia sangat memerlukan anda.
Dialog: 0,0:10:30.02,0:10:33.89,Lalai,Spikyulka1,0,0,0,,Semuanya menjadi salah di istana tanpa saya.
Dialog: 0,0:10:36.16,0:10:37.23,Lalai,Spilyk1,0,0,0,,Nah.
Dialog: 0,0:10:38.33,0:10:41.10,Lalai,Spillik1,0,0,0,,Walaupun anda sibuk dan letih, ini bagus.
Dialog: 0,0:10:41.50,0:10:45.84,Lalai,Spillik1,0,0,0,,Jangan risau tentang apa-apa, fokus pada peranan ratu.
Dialog: 0,0:10:46.67,0:10:49.61,Lalai,Spillik1,0,0,0,,Saya mungkin bukan bapa yang terbaik, tetapi ingat,
Dialog: 0,0:10:49.61,0:10:51.38,Lalai,Spillik1,0,0,0,,Saya akan sentiasa menyokong anda.
Dialog: 0,0:10:54.45,0:10:55.55,Lalai,Spilyk1,0,0,0,,Ya.
Dialog: 0,0:10:58.52,0:11:00.59, Lalai, Spillik1,0,0,0,, Sampai ke istana dengan selamat.
Dialog: 0,0:11:01.12,0:11:04.96,Lalai,Spillik1,0,0,0,,Saya faham ini kurang ajar, tetapi saya minta awak jaga permaisuri.
Dialog: 0,0:11:07.03,0:11:11.63,Lalai,Spiky1,0,0,0,,Saya akan memberi lebih perhatian kepadanya, dia tidak akan kesepian.
Dialog: 0,0:11:12.13,0:11:15.64,Lalai,Spillik1,0,0,0,,Alangkah bahagianya. Saya sangat bersyukur dan malu.
Dialog: 0,0:11:17.30,0:11:18.54,Lalai,Spilyk1,0,0,0,,Bolehkah kita pergi?
Dialog: 0,0:11:33.62,0:11:35.92,Lalai,Spillik1,0,0,0,,Menggambarkan ayah yang penyayang,
Dialog: 0,0:11:36.22,0:11:39.43,Lalai,Spikyulka1,0,0,0,,dan dia sendiri hanyalah seorang peragut yang menggunakan anak sendiri untuk keuntungan.
Dialog: 0,0:11:41.69,0:11:44.46,Lalai,Spikyulka1,0,0,0,,Dia memberikan anak perempuannya kepada seseorang yang cuba dibunuhnya.
Dialog: 0,0:11:47.07,0:11:49.20,Lalai,Spillik1,0,0,0,,Jadi raja mahu membunuh Kim So-yeon?
Dialog: 0,0:11:53.07,0:11:54.81, Lalai, Spikyulka1,0,0,0,,Mengapa anda kelihatan seperti kehilangan negara anda?
Dialog: 0,0:11:55.54,0:11:56.61,Lalai,Spillik1,0,0,0,,Ini tidak begitu.
Dialog: 0,0:11:57.08,0:12:00.35, Lalai, Spikyulka1,0,0,0,,Jika bukan sebuah negara, maka sesuatu yang lain?
Dialog: 0,0:12:01.61,0:12:03.48, Lalai, Spikyulka1,0,0,0,,Tunggu, benar-benar hilang?
Dialog: 0,0:12:03.48,0:12:04.68,Lalai,Spillik1,0,0,0,,Sudah tentu tidak.
Dialog: 0,0:12:05.92,0:12:08.75,Lalai,Spillik1,0,0,0,,Pada hari yang begitu indah anda kembali dengan selamat ke istana.
Dialog: 0,0:12:09.39,0:12:12.49,Lalai,Spillik1,0,0,0,,Walaupun wajah saya, saya sangat gembira.
Dialog: 0,0:12:13.93,0:12:15.16,Lalai,Spillik1,0,0,0,,Baiklah, jika ya.
Dialog: 0,0:12:17.96,0:12:20.63,Lalai,Spikyulka1,0,0,0,,Bukankah sudah tiba masanya untuk pertelingkahan darah bermula?
Dialog: 0,0:12:21.63,0:12:26.44,Lalai,Spikyulka1,0,0,0,,Tetapi nampaknya saya terlupa sesuatu yang penting.
Dialog: 0,0:12:27.87,0:12:30.28,Lalai,Spillik1,0,0,0,,Nampaknya saya ada misi penting...
Dialog: 0,0:12:31.44,0:12:32.85,Lalai,Spillik1,0,0,0,,Kacak sungguh lelaki itu.
Dialog: 0,0:12:33.61,0:12:35.01,Lalai,Spillik1,0,0,0,,Dia sangat kacak.
Dialog: 0,0:12:35.08,0:12:36.92,Lalai,Spillik1,0,0,0,,Sungguh kacak.
Dialog: 0,0:12:46.49,0:12:47.76,Lalai,Spilyk1,0,0,0,,Pemilihan gundik diraja.
Dialog: 0,0:12:48.26,0:12:50.06,Lalai,Spikyulka1,0,0,0,,Bagaimanakah saya boleh melupakan perkara yang begitu hebat?
Dialog: 0,0:12:50.33,0:12:52.06,Lalai,Spikyulka1,0,0,0,,Saya perlu melakukan sesuatu yang penting, jadi buat masa ini.
Dialog: 0,0:12:52.10,0:12:53.60,Lalai,Spillik1,0,0,0,,Hon Young, mari pergi. Lebih cepat.
Dialog: 0,0:12:53.77,0:12:55.84,Lalai,Spillik1,0,0,0,,Tunggu. Kenapa awak lari?
Dialog: 0,0:12:55.97,0:12:57.14,Lalai,Spillik1,0,0,0,,Saya mohon maaf.
Dialog: 0,0:12:58.54,0:13:00.17,Lalai,Spillik1,0,0,0,,Luangkan masa anda.
Dialog: 0,0:13:00.51,0:13:03.04, Lalai, Spilyk1,0,0,0,,Ini adalah yang cepat. Ratu.
Dialog: 0,0:13:05.85,0:13:06.91,Lalai,Spillik1,0,0,0,,Yang Mulia.
Dialog: 0,0:13:16.42,0:13:17.62,Lalai,Spillik1,0,0,0,,Jom.
Dialog: 0,0:13:32.51,0:13:34.54,Lalai,Sutera1,0,0,0,,-Mana ketua sida-sida?\N-Saya periksa, dia sibuk.
Dialog: 0,0:13:35.07,0:13:36.48, Lalai, Spikyulka1,0,0,0,,Anda tidak dapat mencarinya?
Dialog: 0,0:13:36.54,0:13:38.14,Lalai,Spillik1,0,0,0,,Buku itu hilang ke udara.
Dialog: 0,0:13:39.95,0:13:41.68,Lalai,Spikyulka1,0,0,0,,Mungkin bapa mertua saya meneka dan menyembunyikannya?
Dialog: 0,0:13:43.02,0:13:44.35,Lalai,Spillik1,0,0,0,,Tidak begitu.
Dialog: 0,0:13:44.35,0:13:46.89,Lalai,Spikyulka1,0,0,0,,Tingkah lakunya tidak berubah sehingga saya pergi.
Dialog: 0,0:13:47.55,0:13:50.26,Lalai,Spikyulka1,0,0,0,,Dan dia pasti tidak tahu cara menyembunyikan perasaannya.
Dialog: 0,0:13:50.79,0:13:52.19,Lalai,Spikyulka1,0,0,0,,Jadi yang itu?
Dialog: 0,0:13:52.99,0:13:54.56,Lalai,Spillik1,0,0,0,,Dalam topeng dari Jabatan Detektif.
Dialog: 0,0:13:54.56,0:13:58.63,Lalai,Spiky1,0,0,0,,Jika buku perakaunan jatuh ke tangan Kim Jwagyn, kita tidak akan melihatnya lagi.
Dialog: 0,0:13:58.63,0:14:00.63,Lalai,Spillik1,0,0,0,,Dia tidak tahu ke mana dia dipindahkan.
Dialog: 0,0:14:00.63,0:14:02.50,Lalai,Spillik1,0,0,0,,Ini adalah perkara seperti itu,
Dialog: 0,0:14:02.50,0:14:04.90,Lalai,Spiky1,0,0,0,,bahawa bapa mertua kamu tidak akan dapat memberitahu sesiapa bahawa dia kehilangannya.
Dialog: 0,0:14:05.17,0:14:07.17,Lalai,Spillik1,0,0,0,,Dia perlu menderita sendirian.
Dialog: 0,0:14:07.37,0:14:10.88,Lalai,Spikyulka1,0,0,0,,Dia akan mula mencari buku perakaunan.
Dialog: 0,0:14:12.31,0:14:13.75,Lalai,Spikyulka1,0,0,0,,Dan akan melakukannya sendiri.
Dialog: 0,0:14:13.75,0:14:15.38,Lalai,Spikyulka1,0,0,0,,Biarkan mereka mengikutinya.
Dialog: 0,0:14:15.48,0:14:16.52,Lalai,Spillik1,0,0,0,,Ya.
Dialog: 0,0:14:16.62,0:14:18.99,Lalai,Spikyulka1,0,0,0,,Saya rasa mencari dia adalah perkara yang sia-sia.
Dialog: 0,0:14:19.22,0:14:20.45,Lalai,Spillik1,0,0,0,,Sudah tiba masanya untuk menyerah.
Dialog: 0,0:14:20.45,0:14:22.82,Lalai,Spikyulka1,0,0,0,,Tanpa lejar, semua rancangan kita adalah sia-sia.
Dialog: 0,0:14:24.32,0:14:26.19, Lalai, Spikyulka1,0,0,0,,Saya tidak akan berputus asa dengan begitu mudah.
Dialog: 0,0:14:28.13,0:14:31.06,Lalai,Spillik1,0,0,0,,Bertindak seperti seorang ratu di sini, bersikap sopan.
Dialog: 0,0:14:31.13,0:14:32.93,Lalai,Spilyk1,0,0,0,,Cepat, mari pergi.
Dialog: 0,0:14:34.70,0:14:35.77,Lalai,Spillik1,0,0,0,,Yang Mulia!
Dialog: 0,0:14:36.47,0:14:37.67,Lalai,Spillik1,0,0,0,,Hello, wanita mahkamah Choi!
Dialog: 0,0:14:43.08,0:14:44.08,Lalai,Spilyk1,0,0,0,,Yang Mulia.
Dialog: 0,0:14:44.94,0:14:46.78,Lalai,Spillik1,0,0,0,,Saya sangat merindui awak.
Dialog: 0,0:14:47.11,0:14:50.48,Lalai,Spillit1,0,0,0,,Puan Mahkamah Choi. \NBawak semua gadis Joseon di sini.
Dialog: 0,0:14:51.12,0:14:53.75,Lalai,Spillik1,0,0,0,,Dan jangan ketinggalan daftar keluarga klan Khan,
Dialog: 0,0:14:53.75,0:14:54.85,Lalai,Spillik1,0,0,0,,bawakan kepada saya.
Dialog: 0,0:14:56.09,0:14:58.89,Lalai,Spillik1,0,0,0,,Saya mula memilih gundik diraja.
Dialog: 0,0:15:00.19,0:15:02.86,Lalai,Sutera1,0,0,0,,Dengan alasan memilih gundik, saya akan mengkaji keluarga ini.
Dialog: 0,0:15:03.73,0:15:05.90,Lalai,Spillik1,0,0,0,,Pilihan gundik diraja adalah penyelesaiannya.
Dialog: 0,0:15:07.20,0:15:11.27,Lalai,Spillik1,0,0,0,,Ya, betul-betul, saya perlu menyapa Ratu Janda.
Dialog: 0,0:15:11.84,0:15:13.67,Lalai,Spillik1,0,0,0,,Nah, tunggu.
Dialog: 0,0:15:13.77,0:15:16.48,Lalai,Spillit1,0,0,0,,Jiwa Jang Bong-hwan dan kenangan Kim So-yeon -
Dialog: 0,0:15:16.48,0:15:19.88,Lalai,Spillik1,0,0,0,,campuran yang sesuai untuk mencipta\N ratu yang sempurna.
Dialog: 0,0:15:23.62,0:15:25.02,Lalai,Spillik1,0,0,0,,Yang Mulia.
Dialog: 0,0:15:25.35,0:15:27.72,Lalai,Spillik1,0,0,0,,Adakah anda baik-baik saja?
Dialog: 0,0:15:28.39,0:15:30.79,Lalai,Spillik1,0,0,0,,Adakah sesuatu berubah?
Dialog: 0,0:15:30.99,0:15:33.23,Lalai,Spilyk1,0,0,0,,Anda kelihatan berbeza.
Dialog: 0,0:15:33.36,0:15:37.03,Lalai,Spikyulka1,0,0,0,,Saya dapat bermula sekali lagi selepas pulang ke rumah.
Dialog: 0,0:15:37.33,0:15:39.40,Lalai,Spillik1,0,0,0,,Ini bagus.
Dialog: 0,0:15:39.40,0:15:41.83,Lalai,Spillik1,0,0,0,,Maaf kerana membuat anda risau.
Dialog: 0,0:15:42.03,0:15:46.11, Lalai, Spikyulka1,0,0,0,, Dan terima kasih kerana walaupun ini,
Dialog: 0,0:15:46.11,0:15:47.77,Lalai,Spikyulka1,0,0,0,,anda memahami saya dengan baik.
Dialog: 0,0:15:49.68,0:15:52.24,Lalai,Spillik1,0,0,0,,Untuk menebus apa yang berlaku pada masa lalu,
Dialog: 0,0:15:52.24,0:15:55.25,Lalai,Spillik1,0,0,0,,Saya akan cuba bersungguh-sungguh
Dialog: 0,0:15:55.25,0:15:57.32,Lalai,Spilyk1,0,0,0,,mainkan watak ratu.
Dialog: 0,0:15:57.62,0:16:01.12,Lalai,Spikyulka1,0,0,0,,Jadi anda akan sampai kepada perkara yang paling penting dengan segera?
Dialog: 0,0:16:01.69,0:16:02.92,Lalai,Spikyulka1,0,0,0,,Sekarang saya tahu sebenarnya tentang perkara ini.
Dialog: 0,0:16:03.49,0:16:06.29,Lalai,Spikyulka1,0,0,0,,Sebaik sahaja saya berasa lebih baik, saya datang,
Dialog: 0,0:16:06.29,0:16:09.03, Lalai, Spillik1,0,0,0,,untuk melakukan ini.
Dialog: 0,0:16:09.26,0:16:10.80,Lalai,Spillik1,0,0,0,,Seperti yang dijangkakan.
Dialog: 0,0:16:10.80,0:16:12.73,Lalai,Spilyk1,0,0,0,,Saya hanya pergi selama beberapa hari,
Dialog: 0,0:16:12.90,0:16:15.77, Lalai, Spikyulka1,0,0,0,,tetapi saya tidak dapat mengelak daripada memikirkannya.
Dialog: 0,0:16:15.77,0:16:18.74,Lalai,Spillik1,0,0,0,,Jadi kami mempunyai perasaan yang sama?
Dialog: 0,0:16:19.71,0:16:20.94,Lalai,Spillik1,0,0,0,,-Kemudian...\N-Sekarang...
Dialog: 0,0:16:20.94,0:16:22.21,Lalai,Spillik1,0,0,0,,-Dari minit ini?\N-Bolehkah kita mulakan?
Dialog: 0,0:16:22.21,0:16:24.21,Lalai,Spillie1,0,0,0,,-Ratu.\N-Selamat bekerja!
Dialog: 0,0:16:29.78,0:16:32.25, Lalai, Spikyulka1,0,0,0,,Saya tidak memikirkan tentang itu sama sekali.
Dialog: 0,0:16:40.36,0:16:41.43,Lalai,,0,0,0,,Yang Mulia.
Dialog: 0,0:16:41.66,0:16:45.06, Lalai,,0,0,0,,Nantikan latihan anda.
Dialog: 0,0:16:47.83,0:16:50.47,Lalai,,0,0,0,,Nampaknya, saya tiada gantinya.
Dialog: 0,0:16:50.47,0:16:51.97, Lalai,,0,0,0,,Saya tidak percaya saya berkongsi resipi.
Dialog: 0,0:16:52.37,0:16:55.21,Lalai,,0,0,0,,Saya belum bersedia untuk menjadi seorang guru.
Dialog: 0,0:16:57.78,0:16:59.15, Lalai,,0,0,0,,Ada apa? Keluar dari jalan.
Dialog: 0,0:17:03.82,0:17:04.85,Lalai,,0,0,0,,Mommies.
Dialog: 0,0:17:06.79,0:17:09.19, Lalai,,0,0,0,,Anda boleh datang ke sini bila-bila masa anda mahu.
Dialog: 0,0:17:09.19,0:17:11.52, Lalai,,0,0,0,,Tetapi, saya takut, ini tidak akan berfungsi dengan keluaran.
Dialog: 0,0:17:35.38,0:17:36.38,Lalai,,0,0,0,,Yang Mulia.
Dialog: 0,0:17:36.92,0:17:39.32,Lalai,,0,0,0,,Baginda pulang ke istana.
Dialog: 0,0:17:40.09,0:17:41.09, Lalai,,0,0,0,, Betulkah?
Dialog: 0,0:17:41.09,0:17:42.82, Lalai,,0,0,0,, Patutkah kita pergi ke Dewan Seongjeongjong?
Dialog: 0,0:17:43.59,0:17:45.62, Lalai,,0,0,0,,No. Jom ke estet diraja.
Dialog: 0,0:17:55.10,0:17:57.14, Lalai,,0,0,0,,Hei, api terlalu lemah.
Dialog: 0,0:17:57.14,0:17:58.60,Lalai,,0,0,0,,Jadi semuanya akan bertukar menjadi bubur.
Dialog: 0,0:18:04.38,0:18:05.95, Lalai,,0,0,0,,Hei, api ada di mana-mana.
Dialog: 0,0:18:08.68,0:18:11.18, Lalai,,0,0,0,,Anda juga boleh melihat nyalaan di mata anda.
Dialog: 0,0:18:11.18,0:18:13.09, Lalai,,0,0,0,,Ini tidak boleh.
Dialog: 0,0:18:13.09,0:18:14.82,Lalai,,0,0,0,,Saya komited untuk belajar daripada anda,
Dialog: 0,0:18:14.82,0:18:17.49,Lalai,,0,0,0,,jadi mata saya berkilauan gembira.
Dialog: 0,0:18:18.59,0:18:20.33,Lalai,,0,0,0,,By the way, bila awak nak ajar resipi?
Dialog: 0,0:18:20.63,0:18:23.13, Lalai,,0,0,0,,Saya pasti anda tahu cara semuanya berfungsi di dapur\N. Jangan buat begitu.
Dialog: 0,0:18:23.53,0:18:24.80, Lalai,,0,0,0,,Untuk pendatang baru ke restoran Cina
Dialog: 0,0:18:24.80,0:18:26.63, Lalai,,0,0,0,,untuk bulan pertama anda hanya dibenarkan mengupas bawang.
Dialog: 0,0:18:26.63,0:18:27.83, Lalai,,0,0,0,, Perhatikan api.
Dialog: 0,0:18:29.13,0:18:31.34,Lalai,,0,0,0,,Lagipun, saya telah bekerja di dapur diraja selama 30 tahun.
Dialog: 0,0:18:31.34,0:18:33.51, Lalai,,0,0,0,,Dan 12 tahun sebagai chef diraja.
Dialog: 0,0:18:33.51,0:18:35.24, Lalai,,0,0,0,,Saya tidak memerlukan resume.
Dialog: 0,0:18:35.71,0:18:37.44, Lalai,,0,0,0,, Mengapa tidak mula mengira hari itu?
Dialog: 0,0:18:39.95,0:18:41.75, Lalai,,0,0,0,,Saya tidak suka sikap awak.
Dialog: 0,0:18:42.18,0:18:43.48, Lalai,,0,0,0,,Lupakan.
Dialog: 0,0:18:43.48,0:18:45.08,Lalai,,0,0,0,,Yang Mulia.
Dialog: 0,0:18:45.08,0:18:46.55, Lalai,,0,0,0,,Dan seperti ini? Adakah itu lebih baik?
Dialog: 0,0:18:47.45,0:18:50.22,Lalai,,0,0,0,,Lebih baik? macam ni.
Dialog: 0,0:18:50.22,0:18:51.56, Lalai,,0,0,0,,Hei, buka.
Dialog: 0,0:18:53.93,0:18:55.09, Lalai,,0,0,0,, Ketepikan.
Dialog: 0,0:19:04.44,0:19:05.77, Lalai,,0,0,0,, Pernahkah anda melihat sekarang?
Dialog: 0,0:19:06.14,0:19:07.77, Lalai,,0,0,0,,Ini adalah pengintip industri.
Dialog: 0,0:19:08.07,0:19:10.61, Lalai,,0,0,0,,Saya tertanya-tanya sama ada haba telah dilaraskan dengan betul.
Dialog: 0,0:19:10.61,0:19:12.95, Lalai,,0,0,0,,Anda tidak perlu berfikir.\NI boleh menangani perkara ini sendiri.
Dialog: 0,0:19:14.08,0:19:15.92, Lalai,,0,0,0,,Mengapa anda sentiasa pergi terlalu jauh?
Dialog: 0,0:19:30.00,0:19:32.20,Lalai,,0,0,0,,Gukbap ialah makanan tradisional orang biasa.
Dialog: 0,0:19:32.20,0:19:34.50,Lalai,,0,0,0,,Dan komander adalah masyarakat tinggi.
Dialog: 0,0:19:39.87,0:19:43.44, Lalai,,0,0,0,,Saya akan tambah sedikit sup daging,\N kukbap daging lembu Perancis.
Dialog: 0,0:19:45.61,0:19:47.95,Lalai,,0,0,0,,Saya akan menghilangkan rasa yang suka bermain dengan bantuan protein.
Dialog: 0,0:19:51.15,0:19:54.39, Lalai,,0,0,0,,Menggunakan putih telur dengan cara yang baharu.
Dialog: 0,0:19:55.29,0:19:57.82,Lalai,,0,0,0,,Yang Mulia.
Dialog: 0,0:19:58.89,0:20:00.56, Lalai,,0,0,0,,Adakah ini okey?
Dialog: 0,0:20:00.56,0:20:02.19, Lalai,,0,0,0,, Cemerlang.
Dialog: 0,0:20:02.19,0:20:06.00, Lalai,,0,0,0,,Boleh saya tahu jenis makanan\N yang anda cuba masak?
Dialog: 0,0:20:06.40,0:20:08.23,Lalai,,0,0,0,,Makanan yang menyentuh jiwa.
Dialog: 0,0:20:10.14,0:20:11.50, Lalai,,0,0,0,, Jiwa?
Dialog: 0,0:20:27.55,0:20:28.85, Lalai,,0,0,0,, Cemerlang.
Dialog: 0,0:20:28.85,0:20:31.22, Lalai,,0,0,0,,Dan sentuhan penamat.
Dialog: 0,0:20:34.03,0:20:36.80,Lalai,,0,0,0,,-Mereka sudah bersedia, kan?\N-Ya, Tuanku.
Dialog: 0,0:20:40.80,0:20:42.97, Lalai,,0,0,0,,"Jika buih mati, saya juga akan mati."
Dialog: 0,0:20:43.87,0:20:46.97,Lalai,,0,0,0,,Dengan sikap ini, cuba simpan makanan dan bertindak segera.
Dialog: 0,0:20:46.97,0:20:48.91, Lalai,,0,0,0,,Jadi. ke hadapan!
Dialog: 0,0:20:49.14,0:20:50.28,Lalai,,0,0,0,,-Ya, Tuanku.\N-Ya, Tuanku.
Dialog: 0,0:20:51.11,0:20:52.21, Lalai,,0,0,0,,Lebih pantas.
Dialog: 0,0:20:56.15,0:20:58.15,Lalai,,0,0,0,,Dia akan lebih menyukainya,\N kerana dia tahu rasanya.
Dialog: 0,0:21:01.79,0:21:02.86, Lalai,,0,0,0,,Yang Mulia!
Dialog: 0,0:21:04.02,0:21:07.29,Lalai,,0,0,0,,Damhyang!
Dialog: 0,0:21:09.46,0:21:14.33, Lalai,,0,0,0,,Saya sangat takut\N sehingga saya tidak dapat melihat anda lagi.
Dialog: 0,0:21:16.30,0:21:19.67, Lalai,,0,0,0,, Benar. Terima kasih banyak-banyak.
Dialog: 0,0:21:22.11,0:21:23.88, Lalai,,0,0,0,,Saya buat awak risau.
Dialog: 0,0:21:24.61,0:21:26.85,Lalai,,0,0,0,,Saya patut dimarahi.
Dialog: 0,0:21:28.45,0:21:30.62, Lalai,,0,0,0,,Maafkan saya.
Dialog: 0,0:21:42.03,0:21:43.06,Lalai,,0,0,0,,Apa...
Dialog: 0,0:21:44.83,0:21:47.17, Lalai,,0,0,0,,Saya tidak membayangkannya?
Dialog: 0,0:21:47.83,0:21:49.80,Lalai,,0,0,0,,Adakah ini nasi dan sup?
Dialog: 0,0:21:49.80,0:21:53.94, Lalai,,0,0,0,,Saya juga nampaknya ini nasi.
Dialog: 0,0:21:55.11,0:21:57.71, Lalai,,0,0,0,,Adakah dia memberi saya kukbap?
Dialog: 0,0:21:58.68,0:22:01.41, Lalai,,0,0,0,,Untuk hidangan diraja\N anda perlu mengasingkan nasi dan sup.
Dialog: 0,0:22:01.41,0:22:03.85, Lalai,,0,0,0,,Beraninya awak masukkan nasi ke dalam sup,\N seperti petani?
Dialog: 0,0:22:04.62,0:22:05.95, Lalai,,0,0,0,, Patutkah saya membuangnya?
Dialog: 0,0:22:05.95,0:22:07.09, Lalai,,0,0,0,,Sudah tentu!
Dialog: 0,0:22:10.19,0:22:11.29,Lalai,,0,0,0,,Tetapi
Dialog: 0,0:22:12.93,0:22:15.09, Lalai,,0,0,0,, permaisuri meletakkan banyak usaha untuk ini.
Dialog: 0,0:22:17.60,0:22:19.60, Lalai,,0,0,0,,Sekurang-kurangnya saya akan cuba.
Dialog: 0,0:22:20.10,0:22:21.13, Lalai,,0,0,0,,Ya, Tuanku.
Dialog: 0,0:22:36.62,0:22:40.12,Lalai,,0,0,0,,Saya sedang menghitung hari kerjaya saya
Dialog: 0,0:22:41.02,0:22:43.16, Lalai,,0,0,0,,di dapur diraja.
Dialog: 0,0:22:43.62,0:22:46.23, Lalai,,0,0,0,,Dan menjalani kehidupan yang mulia sebagai tukang masak diraja.
Dialog: 0,0:22:47.89,0:22:52.87,Lalai,,0,0,0,,Tetapi saya menjadi hamba biasa yang menonton api sepanjang malam.
Dialog: 0,0:22:54.90,0:22:57.07, Lalai,,0,0,0,,Semuanya kerana permaisuri.
Dialog: 0,0:22:57.94,0:22:59.67, Lalai,,0,0,0,,Ini bukan kerana saya seorang tukang masak yang tidak baik.
Dialog: 0,0:23:00.14,0:23:03.04, Lalai,,0,0,0,,Ini kerana permaisuri luar biasa baik.
Dialog: 0,0:23:03.04,0:23:04.08, Lalai,,0,0,0,,Sial.
Dialog: 0,0:23:04.08,0:23:06.61,Lalai,,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialog: 0,0:23:12.62,0:23:13.82, Lalai,,0,0,0,,Sial.
Dialog: 0,0:23:14.19,0:23:16.76,Lalai,,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialog: 0,0:23:25.80,0:23:27.80,Lalai,,0,0,0,,-Dan awak?\N-Dan awak?
Dialog: 0,0:23:33.21,0:23:35.01,Lalai,,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialog: 0,0:23:35.01,0:23:37.11, Lalai,,0,0,0,,Anda terlalu kejam!
Dialog: 0,0:23:37.11,0:23:39.08, Lalai,,0,0,0,,Susu belum kering di bibir anda!
Dialog: 0,0:23:39.08,0:23:40.28,Lalai,,0,0,0,,Agaknya...
Dialog: 0,0:23:40.95,0:23:42.55, Lalai,,0,0,0,, Sial!
Dialog: 0,0:23:42.55,0:23:44.42,Lalai,,0,0,0,,Adakah anda fikir saya bergurau?
Dialog: 0,0:23:44.42,0:23:46.75,Lalai,,0,0,0,,Saya seorang tukang masak yang hebat!
Dialog: 0,0:23:50.76,0:23:52.93, Lalai,,0,0,0,,Wah, betul-betul apa yang kita perlukan.
Dialog: 0,0:23:59.57,0:24:01.13, Lalai,,0,0,0,,Bila anda berjaya menjadi begitu rapat?
Dialog: 0,0:24:01.83,0:24:03.47, Lalai,,0,0,0,,Saya tidak begitu membencinya.
Dialog: 0,0:24:06.14,0:24:07.74, Lalai,,0,0,0,,Dia menyerang saya sebentar tadi.
Dialog: 0,0:24:07.74,0:24:10.28,Lalai,,0,0,0,,Saya mesti busuk,\Nseperti sayur-sayuran yang rosak pada musim panas.
Dialog: 0,0:24:11.08,0:24:13.21, Lalai,,0,0,0,,Api bertiup sepanjang hari.
Dialog: 0,0:24:18.32,0:24:19.69, Lalai,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:24:20.19,0:24:22.49, Lalai,,0,0,0,,No. Saya tidak cuba untuk mencium.
Dialog: 0,0:24:22.49,0:24:24.52,Lalai,,0,0,0,,-Saya cuba menerangkan kepada anda...\N-Keluar!
Dialog: 0,0:24:25.92,0:24:27.53, Lalai,,0,0,0,,-Saya...\N-Tinggalkan.
Dialog: 0,0:24:30.76,0:24:31.83, Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:24:32.87,0:24:33.93, Lalai,,0,0,0,,Maaf.
Dialog: 0,0:24:34.93,0:24:36.24, Lalai,,0,0,0,,Di sini.
Dialog: 0,0:24:41.31,0:24:43.34,Lalai,,0,0,0,,Saya tidak boleh menghina Baginda,
Dialog: 0,0:24:43.91,0:24:45.91,Lalai,,0,0,0,,supaya tidak berada pada tahap yang sama dengannya.
Dialog: 0,0:24:46.48,0:24:48.61, Lalai,,0,0,0,,Tetapi saya perlu melepaskan diri.
Dialog: 0,0:24:50.32,0:24:54.12, Lalai,,0,0,0,,Saya benar-benar akan menghentikan perkara ini.
Dialog: 0,0:25:17.48,0:25:19.85,Lalai,,0,0,0,,Dari manakah wajahnya?
Dialog: 0,0:25:30.89,0:25:33.93, Lalai,,0,0,0,,Tidak, tidak!
Dialog: 0,0:25:33.93,0:25:36.03, Lalai,,0,0,0,,No. tak perlu.
Dialog: 0,0:25:37.43,0:25:40.23, Lalai,,0,0,0,,Tidak! Tidak! Ini tidak boleh!
Dialog: 0,0:25:42.51,0:25:45.85,Lalai,,0,0,0,,Permaisuri Janda, \NPermaisuri meminta penonton.
Dialog: 0,0:25:46.05,0:25:47.25, Lalai,,0,0,0,,Biarkan dia masuk.
Dialog: 0,0:25:57.43,0:25:58.70,Lalai,,0,0,0,,Saya sudah selesai.
Dialog: 0,0:25:59.36,0:26:02.30,Lalai,,0,0,0,,Sudah tentu, orang yang tidak berhati perut\N tidak akan menghargai makanan untuk jiwa.
Dialog: 0,0:26:05.54,0:26:07.74,Lalai,,0,0,0,,Yang Mulia.
Dialog: 0,0:26:08.81,0:26:11.54, Lalai,,0,0,0,,Saya pasti hilang kemahiran kerana
Dialog: 0,0:26:11.54,0:26:14.15, Lalai,,0,0,0,,tidak hadir di dapur untuk beberapa lama.
Dialog: 0,0:26:18.15,0:26:20.02, Lalai,,0,0,0,,Rasanya biasa dan eksotik.
Dialog: 0,0:26:20.55,0:26:22.45, Lalai,,0,0,0,, Biasa, tetapi eksotik.
Dialog: 0,0:26:23.42,0:26:25.92, Lalai,,0,0,0,,Bakat masakan anda yang luar biasa mula menakutkan saya.
Dialog: 0,0:26:27.16,0:26:29.96,Lalai,,0,0,0,,Anda malah membawa kembali kenangan yang telah lama dilupakan kepada saya.
Dialog: 0,0:26:30.96,0:26:32.13, Lalai,,0,0,0,,Di sini.
Dialog: 0,0:26:36.80,0:26:39.00, Lalai,,0,0,0,,Gadis baik, makan.
Dialog: 0,0:26:40.91,0:26:41.97, Lalai,,0,0,0,,Mama.
Dialog: 0,0:26:45.41,0:26:46.48,Lalai,,0,0,0,,Yang Mulia.
Dialog: 0,0:26:48.31,0:26:51.02,Lalai,,0,0,0,,-Awak ada sebutir nasi di sini.\N-Beraninya awak!
Dialog: 0,0:26:57.92,0:27:01.36, Lalai,,0,0,0,,Tetapi saya dengar anda tidak mahu \Nberkongsi kemahiran anda.
Dialog: 0,0:27:01.59,0:27:04.50,Lalai,,0,0,0,,Anda fikir anda tidak boleh \Nlatih chef diraja?
Dialog: 0,0:27:05.10,0:27:06.16,Lalai,,0,0,0,,Nah...
Dialog: 0,0:27:06.83,0:27:09.57, Lalai,,0,0,0,,Orang tua ini agak menggegarkan saya.
Dialog: 0,0:27:09.67,0:27:12.47,Lalai,,0,0,0,,Maka anda perlu segera menyingkirkannya.
Dialog: 0,0:27:12.80,0:27:14.74,Lalai,,0,0,0,,Selain itu, terdapat insiden arsenik.
Dialog: 0,0:27:16.01,0:27:17.24, Lalai,,0,0,0,,Arsenik?
Dialog: 0,0:27:17.54,0:27:18.98, Lalai,,0,0,0,,Anda tidak tahu?
Dialog: 0,0:27:18.98,0:27:20.75, Lalai,,0,0,0,,Anda telah jatuh ke dalam keadaan vegetatif,
Dialog: 0,0:27:20.75,0:27:23.12,Lalai,,0,0,0,,kerana saya menelan \Nracun di dapur diraja.
Dialog: 0,0:27:23.52,0:27:24.55,Lalai,,0,0,0,,Racun?
Dialog: 0,0:27:24.95,0:27:27.59, Lalai,,0,0,0,, Maka saya tidak akan pulih secepat ini.
Dialog: 0,0:27:27.59,0:27:29.59,Lalai,,0,0,0,,
Dialog: 0,0:27:28.42,0:27:30.42, Lalai,,0,0,0,, Tukang masak diraja adalah orang tua yang bodoh,
Dialog: 0,0:27:30.99,0:27:33.56,Lalai,,0,0,0,,tetapi jika anda melepaskan dia daripada kedudukannya...
Dialog: 0,0:27:33.56,0:27:35.09,Lalai,,0,0,0,,Adakah saya akan melepaskan anda daripada kedudukan anda?
Dialog: 0,0:27:36.46,0:27:38.56,Lalai,,0,0,0,,Kami akan pancung kepalanya.
Dialog: 0,0:27:47.11,0:27:49.57, Lalai,,0,0,0,,Saya tertanya-tanya siapa yang mempunyai buku perakaunan sekarang?
Dialog: 0,0:27:50.64,0:27:51.78, Lalai,,0,0,0,,Dan yang lebih penting,
Dialog: 0,0:27:52.41,0:27:54.48,Lalai,,0,0,0,,kenapa dia ambil dia?
Dialog: 0,0:27:56.48,0:27:58.42, Lalai,,0,0,0,,Adakah ini akan merugikan kita?
Dialog: 0,0:27:59.22,0:28:00.82, Lalai,,0,0,0,,Atau adakah ia akan membantu kita?
Dialog: 0,0:28:02.32,0:28:04.72,Lalai,,0,0,0,,Dia akan kehilangan kedudukan atau kepalanya,
Dialog: 0,0:28:05.12,0:28:06.39, Lalai,,0,0,0,,apa saya peduli?
Dialog: 0,0:28:07.93,0:28:10.26,Lalai,,0,0,0,,Mereka meminta saya berkongsi resipi,
Dialog: 0,0:28:10.26,0:28:12.23, Lalai,,0,0,0,, yang bermaksud bahawa bercakap tentang penggulingan bukanlah gurauan.
Dialog: 0,0:28:13.40,0:28:15.60,Lalai,,0,0,0,,Bukan lelaki tua yang perlu saya risaukan.
Dialog: 0,0:28:15.60,0:28:17.10, Lalai,,0,0,0,,Saya hampir kehilangan kepala.
Dialog: 0,0:28:19.94,0:28:22.61, Lalai,,0,0,0,,Oh, Cheoljong!
Dialog: 0,0:28:27.08,0:28:30.12, Lalai,,0,0,0,,Yang Mulia, permaisuri di sini.
Dialog: 0,0:28:49.94,0:28:51.30, Lalai,,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:28:51.30,0:28:53.74, Lalai,,0,0,0,,Saya diberitahu begini cara orang diraja berjalan.
Dialog: 0,0:28:54.07,0:28:57.21,Lalai,,0,0,0,,Saya adalah permaisuri ideal awak.
Dialog: 0,0:28:57.74,0:28:59.54,Lalai,,0,0,0,,Apa? Siapa kata?
Dialog: 0,0:29:00.75,0:29:02.75, Lalai,,0,0,0,,Puan Choi. Tertipu?
Dialog: 0,0:29:02.75,0:29:03.85, Lalai,,0,0,0,,Tidak, maksud saya...
Dialog: 0,0:29:04.18,0:29:06.65, Lalai,,0,0,0,,Siapakah ratu ideal saya?
Dialog: 0,0:29:07.89,0:29:10.76, Lalai,,0,0,0,,Saya, seperti yang anda lihat.
Dialog: 0,0:29:14.09,0:29:16.80, Lalai,,0,0,0,,Anda menakutkan saya. Jadilah sama seperti selalu.
Dialog: 0,0:29:18.26,0:29:21.60,Lalai,,0,0,0,,By the way, jenis perempuan yang awak suka?
Dialog: 0,0:29:21.70,0:29:24.44, Lalai,,0,0,0,, Seksual? Cantik? tak bersalah?
Dialog: 0,0:29:25.94,0:29:27.24, Lalai,,0,0,0,,Apa yang kamu cakapkan?
Dialog: 0,0:29:28.47,0:29:29.84,Lalai,,0,0,0,,Janda Ratu berkata
Dialog: 0,0:29:29.84,0:29:31.21, Lalai,,0,0,0,,pilih gundik untuk anda.
Dialog: 0,0:29:31.84,0:29:33.48,Lalai,,0,0,0,,gundik-gundik itu milik kamu,
Dialog: 0,0:29:33.48,0:29:35.11, Lalai,,0,0,0,,jadi yang manakah anda lebih suka?
Dialog: 0,0:29:35.71,0:29:36.82, Lalai,,0,0,0,, Gundik?
Dialog: 0,0:29:37.75,0:29:38.92, Lalai,,0,0,0,,Gunting diraja...
Dialog: 0,0:29:39.35,0:29:40.92,Lalai,,0,0,0,,Bodoh sekali.
Dialog: 0,0:29:41.65,0:29:44.29, Lalai,,0,0,0,,Menunjukkan warna sebenar anda?
Dialog: 0,0:29:48.53,0:29:50.43, Lalai,,0,0,0,,Idea yang bagus.
Dialog: 0,0:30:11.55,0:30:14.09, Lalai,,0,0,0,,Maaf. Saya terlalu gembira.
Dialog: 0,0:30:14.55,0:30:15.59,Lalai,,0,0,0,,Nah.
Dialog: 0,0:30:16.22,0:30:17.89,Lalai,,0,0,0,,Mari kita jelaskan.
Dialog: 0,0:30:18.46,0:30:19.89, Lalai,,0,0,0,,Anda seorang raja, tetapi itu tidak bermakna
Dialog: 0,0:30:19.89,0:30:22.89,Lalai,,0,0,0,,bahawa ia milik anda. Ia adalah cara lama.
Dialog: 0,0:30:22.89,0:30:24.56, Lalai,,0,0,0,,Itu bukan milik anda.
Dialog: 0,0:30:26.40,0:30:27.63, Lalai,,0,0,0,,Nasihat yang bagus.
Dialog: 0,0:30:27.83,0:30:29.97,Lalai,,0,0,0,,-Ini bermakna...\N-Itu milik saya.
Dialog: 0,0:30:30.20,0:30:31.87, Lalai,,0,0,0,,-Apa?\N-Itu milik saya.
Dialog: 0,0:30:32.64,0:30:34.81, Lalai,,0,0,0,,Jangan dekat harem.
Dialog: 0,0:30:35.44,0:30:37.41,Lalai,,0,0,0,,Anda mempunyai gundik utama.
Dialog: 0,0:30:37.91,0:30:39.14, Lalai,,0,0,0,, Faham.
Dialog: 0,0:30:40.38,0:30:43.05, Lalai,,0,0,0,,Di bawah satu syarat.
Dialog: 0,0:30:44.38,0:30:45.98, Lalai,,0,0,0,,-Di telinga anda.\N-Apa? Untuk apa?
Dialog: 0,0:30:45.98,0:30:47.35, Lalai,,0,0,0,,Semuanya baik-baik saja.
Dialog: 0,0:30:49.92,0:30:51.46, Lalai,,0,0,0,,Saya akan memilih jantina mereka.
Dialog: 0,0:30:52.09,0:30:53.16,Lalai,,0,0,0,,Apa?
Dialog: 0,0:30:53.53,0:30:57.40,Lalai,,0,0,0,,Tidak! Saya perlukan rupa, bukan keturunan.
Dialog: 0,0:30:57.90,0:31:01.13, Lalai,,0,0,0,, Kemudian saya akan memberitahu ratu janda,
Dialog: 0,0:31:01.13,0:31:03.94, Lalai,,0,0,0,, bahawa saya tidak memerlukan gundik.
Dialog: 0,0:31:03.94,0:31:05.34, Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:31:05.34,0:31:07.94,Lalai,,0,0,0,,Cuma kita jangan langgar sempadan orang lain.
Dialog: 0,0:31:08.27,0:31:10.61,Lalai,,0,0,0,,Di sebalik penampilan saya, anda periksa keluarga mereka.
Dialog: 0,0:31:11.68,0:31:14.51, Lalai,,0,0,0,,Anda adalah anti-peminat sebenar saya.
Dialog: 0,0:31:16.18,0:31:19.72,Lalai,,0,0,0,,Saya bimbang, tetapi sekarang saya menemui jalan keluar.
Dialog: 0,0:31:24.76,0:31:25.86, Lalai,,0,0,0,,Jangan senyum.
Dialog: 0,0:31:27.76,0:31:29.19, Lalai,,0,0,0,,Anda tidak dibenarkan tersenyum.
Dialog: 0,0:31:29.29,0:31:31.56, Lalai,,0,0,0,,Dan anda tidak boleh memegang tangan saya
Dialog: 0,0:31:31.56,0:31:33.13, Lalai,,0,0,0,, dan baring di atas perut saya!
Dialog: 0,0:31:35.03,0:31:36.57, Lalai,,0,0,0,,Jadi saya tidak boleh berbuat apa-apa?
Dialog: 0,0:31:36.57,0:31:38.30,Lalai,,0,0,0,,Tepat sekali. Semuanya dilarang.
Dialog: 0,0:31:38.30,0:31:39.87, Lalai,,0,0,0,,Buat apa-apa!
Dialog: 0,0:31:42.21,0:31:43.71, Lalai,,0,0,0,,Tiada masa untuk ini.
Dialog: 0,0:31:46.08,0:31:47.11,Lalai,,0,0,0,,Jom.
Dialog: 0,0:31:50.68,0:31:52.48, Lalai,,0,0,0,,Ini permaisuri saya.
Dialog: 0,0:31:53.69,0:31:56.49,Lalai,,0,0,0,,Bercakap dengan Baginda?
Dialog: 0,0:31:58.42,0:32:00.13, Lalai,,0,0,0,,Kembali kepada diri saya sendiri.
Dialog: 0,0:32:04.83,0:32:06.60,Lalai,,0,0,0,,Adakah anda mencari ini?
Dialog: 0,0:32:10.54,0:32:12.34,Lalai,,0,0,0,,Adakah pembantu mahkamah menjual awak?
Dialog: 0,0:32:12.34,0:32:15.21, Lalai,,0,0,0,,Ya, dia sangat muda.
Dialog: 0,0:32:16.27,0:32:18.84,Lalai,,0,0,0,,Telah berpakaian seperti pembantu istana.
Dialog: 0,0:32:18.84,0:32:20.18, Lalai,,0,0,0,,Ingat rupa dia?
Dialog: 0,0:32:20.51,0:32:23.75, Lalai,,0,0,0,,Bergantung pada jumlah yang anda bayar.
Dialog: 0,0:32:25.35,0:32:26.95,Lalai,,0,0,0,,Saya akan kembali bersama artis.
Dialog: 0,0:32:26.95,0:32:29.09,Lalai,,0,0,0,,Semakin jelas ingatan anda,
Dialog: 0,0:32:29.65,0:32:31.16,Lalai,,0,0,0,,semakin banyak yang saya akan tawarkan.
Dialog: 0,0:32:44.27,0:32:45.40,Lalai,,0,0,0,,Selamat Datang.
Dialog: 0,0:32:51.74,0:32:53.41,Lalai,,0,0,0,,
Dialog: 0,0:32:53.41,0:32:55.08,Lalai,,0,0,0,,Pecah
Dialog: 0,0:33:00.49,0:33:02.82, Lalai,,0,0,0,, Palsu, saya pasti.
Dialog: 0,0:33:02.99,0:33:05.12, Lalai,,0,0,0,,Adakah ini dokumen palsu?
Dialog: 0,0:33:05.12,0:33:07.49, Lalai,,0,0,0,,Ini bukan identiti palsu sepenuhnya.
Dialog: 0,0:33:07.49,0:33:11.23,Lalai,,0,0,0,,Ini adalah dokumen si mati atau hilang.
Dialog: 0,0:33:12.20,0:33:14.83, Lalai,,0,0,0,,Tidak dilakukan dengan kekok.
Dialog: 0,0:33:15.93,0:33:18.80, Lalai,,0,0,0,,Ia mungkin sangat mahal.
Dialog: 0,0:33:25.11,0:33:26.71, Lalai,,0,0,0,,Terima kasih.
Dialog: 0,0:33:31.85,0:33:33.75,Lalai,,0,0,0,,Begitu banyak usaha,
Dialog: 0,0:33:34.92,0:33:37.16,Lalai,,0,0,0,,untuk menjadi pegawai berpangkat rendah?
Dialog: 0,0:33:55.84,0:33:59.98,Lalai,,0,0,0,,Yang Mulia, saya mesti memberikan sesuatu secara rahsia.
Dialog: 0,0:34:00.48,0:34:02.71,Lalai,,0,0,0,,Saya akan tunggu di tempat biasa kita.
Dialog: 0,0:34:04.28,0:34:05.45,Lalai,,0,0,0,,Yang Mulia.
Dialog: 0,0:34:12.62,0:34:15.49,Lalai,,0,0,0,,Putera Yeonpyeong meninggalkan istana.
Dialog: 0,0:34:18.93,0:34:22.50,Lalai,,0,0,0,,Kemudian bawa ini kepada Baginda.
Dialog: 0,0:34:22.87,0:34:23.90,Lalai,,0,0,0,,Ya.
Dialog: 0,0:34:28.47,0:34:30.24, Lalai,,0,0,0,,Adakah dia mempunyai sesuatu untuk raja?
Dialog: 0,0:34:31.24,0:34:34.75, Lalai,,0,0,0,,Oleh kerana dia tidak dapat memberikannya kepadanya setelah melihat betapa baiknya dia bergaul dengan permaisuri,
Dialog: 0,0:34:35.31,0:34:38.02, Lalai,,0,0,0,,kelihatan seperti sesuatu yang istimewa.
Dialog: 0,0:34:40.65,0:34:43.66, Lalai,,0,0,0,,Penonton diraja dalam masa 15 minit?
Dialog: 0,0:34:43.99,0:34:44.99,Lalai,,0,0,0,,Ya.
Dialog: 0,0:34:45.02,0:34:46.59,Lalai,,0,0,0,,Rehat sebentar.
Dialog: 0,0:34:47.13,0:34:48.16,Lalai,,0,0,0,,Baiklah.
Dialog: 0,0:34:56.17,0:34:58.90,Lalai,,0,0,0,,Gunting utama menulis surat kepada anda.
Dialog: 0,0:35:31.54,0:35:33.17, Lalai,,0,0,0,, Secara peribadi
Dialog: 0,0:35:42.51,0:35:45.98, Lalai,,0,0,0,, Semasa saya tiada, anda tidak berhenti bekerja.
Dialog: 0,0:35:45.98,0:35:47.99,Lalai,,0,0,0,,Terima kasih kepada anda, saya tiada apa-apa nak buat di sini.
Dialog: 0,0:35:48.25,0:35:51.56,Lalai,,0,0,0,,-Terima kasih, Yang Mulia.\N-Terima kasih, Yang Mulia.
Dialog: 0,0:35:52.39,0:35:54.46, Lalai,,0,0,0,,Untuk menyatakan rasa terima kasih saya,
Dialog: 0,0:35:54.46,0:35:56.86, Lalai,,0,0,0,,Saya akan mengadakan jamuan pada Hari Troli.
Dialog: 0,0:35:57.46,0:35:59.66,Lalai,,0,0,0,,Orang ramai mempunyai banyak aduan, termasuk tentang bencana alam.
Dialog: 0,0:35:59.66,0:36:02.23,Lalai,,0,0,0,,Kemurahan hati anda akan membuatkan orang berfikir,
Dialog: 0,0:36:02.23,0:36:04.44,Lalai,,0,0,0,,bahawa kami tidak berminat dengan pesanan itu
Dialog: 0,0:36:04.44,0:36:07.17, Lalai,,0,0,0,, dan kami hanya mahu mengadakan jamuan.
Dialog: 0,0:36:07.17,0:36:10.91, Lalai,,0,0,0,,Saya rasa seorang raja tidak sepatutnya berkelakuan seperti ini.
Dialog: 0,0:36:11.08,0:36:12.91,Lalai,,0,0,0,,Yongjo walau bagaimanapun
Dialog: 0,0:36:12.91,0:36:15.41, Lalai,,0,0,0,,pemulihan yang diraikan,
Dialog: 0,0:36:15.41,0:36:17.65,Lalai,,0,0,0,,mengatur jamuan mewah.
Dialog: 0,0:36:18.68,0:36:21.95,Lalai,,0,0,0,,Ratu letih akibat kerja keras
Dialog: 0,0:36:21.95,0:36:23.66, Lalai,,0,0,0,, dan keluar daripada keadaan vegetatif.
Dialog: 0,0:36:24.02,0:36:25.52,Lalai,,0,0,0,,Kita perlu meraikannya.
Dialog: 0,0:36:25.72,0:36:29.23,Lalai,,0,0,0,,Kami masih mencari punca penyakitnya.
Dialog: 0,0:36:29.46,0:36:31.90,Lalai,,0,0,0,,Ia tidak dipasang pada masa ini.
Dialog: 0,0:36:31.90,0:36:34.77, Lalai,,0,0,0,,Dia pulih sepenuhnya selepas dua hari.
Dialog: 0,0:36:34.77,0:36:36.30, Lalai,,0,0,0,,Hanya perlu berehat.
Dialog: 0,0:36:36.30,0:36:38.60,Lalai,,0,0,0,,-Namun...\N-Ratu
Dialog: 0,0:36:39.67,0:36:43.34,Lalai,,0,0,0,,mengatasi penyakit serius dan pulih.
Dialog: 0,0:36:43.78,0:36:47.65,Lalai,,0,0,0,,Kita perlu meraikan acara yang baik ini.
Dialog: 0,0:36:48.48,0:36:50.85,Lalai,,0,0,0,,Kes ini agak sesuai.
Dialog: 0,0:36:51.42,0:36:52.45,Lalai,,0,0,0,,Ya.
Dialog: 0,0:36:52.45,0:36:56.25,Lalai,,0,0,0,,Adalah tugas saya sebagai raja dan sebagai suaminya.
Dialog: 0,0:36:56.69,0:36:59.32,Lalai,,0,0,0,,Yang Mulia, ini tidak akan berfungsi.
Dialog: 0,0:36:59.76,0:37:02.63, Lalai,,0,0,0,,Percubaan untuk membunuh ratu adalah jenayah yang serius.
Dialog: 0,0:37:02.96,0:37:05.23,Lalai,,0,0,0,,Jika anda tergesa-gesa mengatur jamuan...
Dialog: 0,0:37:05.23,0:37:06.50, Lalai,,0,0,0,,Menteri Perang.
Dialog: 0,0:37:07.33,0:37:09.67,Lalai,,0,0,0,,Adakah anda tidak gembira bahawa permaisuri telah pulih?
Dialog: 0,0:37:10.17,0:37:11.44,Lalai,,0,0,0,,Sungguh
Dialog: 0,0:37:11.44,0:37:14.81, Lalai,,0,0,0,, adakah anda mahu permaisuri cedera?
Dialog: 0,0:37:15.31,0:37:17.71, Lalai,,0,0,0,,Tidak, sudah tentu tidak.
Dialog: 0,0:37:18.04,0:37:19.78,Lalai,,0,0,0,,Gunakan kes ini
Dialog: 0,0:37:20.18,0:37:23.08, Lalai,,0,0,0,, lebih penting untuk tujuan politik daripada kesihatan permaisuri?
Dialog: 0,0:37:29.42,0:37:31.29,Lalai,,0,0,0,,Bertenang, Tuanku.
Dialog: 0,0:37:31.29,0:37:36.06,Lalai,,0,0,0,,Jika ini kehendak anda,\N kami dengan senang hati akan menerima kehendak anda.
Dialog: 0,0:37:36.59,0:37:38.06, Lalai,,0,0,0,, Kemudian tunggu.
Dialog: 0,0:37:39.90,0:37:43.00, Lalai,,0,0,0,,Anda berehat dengan baik. Hanya melimpah dengan tenaga.
Dialog: 0,0:37:56.38,0:37:57.55,Lalai,,0,0,0,,Musuh musuh saya.
Dialog: 0,0:37:58.05,0:38:00.22,Lalai,,0,0,0,,Saya akan mengalahkan seorang barbarian dengan barbarian lain.
Dialog: 0,0:38:00.82,0:38:02.22,Lalai,,0,0,0,,Perlu mencipta klan,
Dialog: 0,0:38:02.22,0:38:03.79, Lalai,,0,0,0,,menentang Kims.
Dialog: 0,0:38:04.06,0:38:05.62, Lalai,,0,0,0,,-Buat?\N-Gunakan
Dialog: 0,0:38:05.62,0:38:07.49,Lalai,,0,0,0,,seorang gundik yang dipilih oleh permaisuri.
Dialog: 0,0:38:10.19,0:38:11.86, Lalai, galeri menembak,0,0,0,, Chef diraja, lihat?
Dialog: 0,0:38:11.86,0:38:14.20, Lalai,,0,0,0,,Ya, ayuh. Adakah rasanya sama?
Dialog: 0,0:38:14.20,0:38:15.80, Lalai,,0,0,0,,Biar saya cuba.
Dialog: 0,0:38:18.70,0:38:20.04, Lalai,,0,0,0,, Bawa lagi perasa.
Dialog: 0,0:38:20.04,0:38:21.37, Lalai,,0,0,0,,Ya. Saya akan menambah sedikit lagi.
Dialog: 0,0:38:22.37,0:38:24.78, Lalai,,0,0,0,,Tidak, itu tidak akan berfungsi, ia berair. Buat semula.
Dialog: 0,0:38:25.61,0:38:27.98, Lalai,,0,0,0,,Dan mengapa anda berusaha keras?
Dialog: 0,0:38:30.35,0:38:33.85, Lalai,,0,0,0,, Populariti hidangan susu hanya akan berkembang.
Dialog: 0,0:38:34.15,0:38:36.82, Lalai,,0,0,0,,Kami tidak boleh kelaparan anak lembu.
Dialog: 0,0:38:37.66,0:38:41.76,Lalai,,0,0,0,,Jadi saya mahu menggantikan susu dengan rasa yang serupa.
Dialog: 0,0:38:43.96,0:38:46.23, Lalai,,0,0,0,, Gastronomi molekul di Joseon?
Dialog: 0,0:38:48.57,0:38:50.94, Lalai,,0,0,0,,Dia berusaha keras, terutamanya hari ini.
Dialog: 0,0:38:52.97,0:38:54.11, Lalai,,0,0,0,, Chef Diraja.
Dialog: 0,0:38:56.21,0:38:57.81, Lalai,,0,0,0,,Sangat sedih di mata ini.
Dialog: 0,0:38:58.71,0:39:01.61, Lalai,,0,0,0,,Saya pasti dia mempunyai seisi keluarga untuk diberi makan.
Dialog: 0,0:39:02.35,0:39:03.48, Lalai,,0,0,0,,Saya sedang mendengar anda.
Dialog: 0,0:39:05.15,0:39:06.68, Lalai,,0,0,0,,Nyalakan api.
Dialog: 0,0:39:13.86,0:39:15.39,Lalai,,0,0,0,,
Dialog: 0,0:39:17.13,0:39:19.66,Lalai,,0,0,0,,Di bahu kecil ketua keluarga ini
Dialog: 0,0:39:19.66,0:39:21.40,Lalai,,0,0,0,,beban berat terletak.
Dialog: 0,0:39:23.90,0:39:25.80,Lalai,,0,0,0,,Jadi untuk difikirkan, saya masih tidak tahu nama awak.
Dialog: 0,0:39:25.80,0:39:26.90,Lalai,,0,0,0,,Siapa nama awak?
Dialog: 0,0:39:28.51,0:39:29.67, Lalai,,0,0,0,,Manbok.
Dialog: 0,0:39:30.91,0:39:32.28,Lalai,,0,0,0,,Beritahu saya tentang keluarga anda.
Dialog: 0,0:39:32.84,0:39:35.38,Lalai,,0,0,0,,Saya rasa terdapat 10 orang dalam keluarga anda,\Nad semua orang perlu diberi makan.
Dialog: 0,0:39:36.31,0:39:37.45, Lalai,,0,0,0,,Saya kesepian.
Dialog: 0,0:39:38.52,0:39:39.55,Lalai,,0,0,0,,Apa?
Dialog: 0,0:39:39.55,0:39:42.39,Default,,0,0,0,,Saya sudah lama menikmati kehidupan bujang.
Dialog: 0,0:39:46.92,0:39:49.29, Lalai,,0,0,0,,Adakah anda tidak mempunyai keluarga untuk diberi makan?
Dialog: 0,0:39:49.96,0:39:51.13, Lalai,,0,0,0,, Fikir semula.
Dialog: 0,0:39:53.36,0:39:56.57,Lalai,,0,0,0,,Saya kadang-kadang memberi makan kepala ikan kucing terbiar.
Dialog: 0,0:39:56.70,0:39:58.80,Lalai,,0,0,0,,Betul. Nampak tak
Dialog: 0,0:39:59.24,0:40:01.91,Lalai,,0,0,0,,Tanpa anda, kucing terbiar akan kelaparan.
Dialog: 0,0:40:03.14,0:40:06.18, Lalai,,0,0,0,,Saya tidak melakukan ini untuk anda, tetapi untuk kucing terbiar itu.
Dialog: 0,0:40:08.68,0:40:10.01, Lalai,,0,0,0,,Saya akan berkongsi resipi dengan anda.
Dialog: 0,0:40:10.41,0:40:13.48, Lalai,,0,0,0,,Terima kasih, Yang Mulia.
Dialog: 0,0:40:14.65,0:40:16.05, Lalai,,0,0,0,,Apa yang awak cakapkan. Awak menakutkan.
Dialog: 0,0:40:18.56,0:40:21.29, Lalai,,0,0,0,,Baiklah, bawa saya kertas itu.
Dialog: 0,0:40:32.04,0:40:33.14, Lalai,,0,0,0,,Hon Young.
Dialog: 0,0:40:33.14,0:40:35.17, Lalai,,0,0,0,, Sampaikan ini kepada doktor diraja.
Dialog: 0,0:40:35.57,0:40:36.61,Lalai,,0,0,0,,Ya.
Dialog: 0,0:40:44.05,0:40:46.68,Lalai,,0,0,0,,Cadangkan herba aromatik yang baik untuk kulit.
Dialog: 0,0:40:47.65,0:40:50.25, Lalai,,0,0,0,,Jika saya tidak menyukainya, dapatkan tugasan baharu.
Dialog: 0,0:40:52.42,0:40:54.39, Lalai,,0,0,0,,Tugasan baharu?
Dialog: 0,0:40:54.73,0:40:56.43, Lalai,,0,0,0,,Ia juga di bahagian belakang.
Dialog: 0,0:40:58.60,0:41:01.50,Lalai,,0,0,0,,Saya memerlukan seorang sida di sini untuk memilih gundik diraja.
Dialog: 0,0:41:02.60,0:41:06.50,Lalai,,0,0,0,,Mengapa dia selalu cuba membuat sida-sida daripada saya?
Dialog: 0,0:41:17.75,0:41:18.78,Lalai,,0,0,0,,Yang Mulia.
Dialog: 0,0:41:19.45,0:41:22.05, Lalai,,0,0,0,,Luangkan masa anda. Anda boleh menyakiti diri anda dengan cara ini.
Dialog: 0,0:41:26.79,0:41:29.29, Lalai,,0,0,0,,Di manakah saya boleh mencari buku tentang perayaan diraja?
Dialog: 0,0:41:30.66,0:41:32.90, Lalai,,0,0,0,,Saya akan mencarinya untuk anda.
Dialog: 0,0:41:40.74,0:41:43.61,Lalai,,0,0,0,,Saya berminat dengan jamuan diraja di Yeongjo.
Dialog: 0,0:41:44.58,0:41:45.61,Lalai,,0,0,0,,Ya.
Dialog: 0,0:41:58.36,0:42:00.29,Lalai,,0,0,0,,Saya pergi ke dewan Seongwonjong,
Dialog: 0,0:42:00.29,0:42:01.93, Lalai,,0,0,0,, dan saya diberitahu bahawa anda sedang menuju ke sini.
Dialog: 0,0:42:02.96,0:42:05.33,Lalai,,0,0,0,,Untuk apa saya berhutang gembira melihat awak?
Dialog: 0,0:42:05.83,0:42:09.87,Lalai,,0,0,0,,Saya cuma fikir kita jarang berjumpa.
Dialog: 0,0:42:10.50,0:42:12.67, Lalai,,0,0,0,,Saya mahu bercakap dengan awak.
Dialog: 0,0:42:28.19,0:42:29.29,Lalai,,0,0,0,,Bantu diri sendiri.
Dialog: 0,0:42:42.93,0:42:45.94,Lalai,,0,0,0,,Adakah kerana anda membuat teh sendiri?
Dialog: 0,0:42:46.87,0:42:48.67, Lalai,,0,0,0,,Rasanya lebih halus.
Dialog: 0,0:42:50.94,0:42:54.21,Lalai,,0,0,0,,Apabila saya melihat awak, saya teringat mendiang raja.
Dialog: 0,0:42:54.75,0:42:59.18,Lalai,,0,0,0,,Jadi sukar untuk saya kekal dekat dengan awak.
Dialog: 0,0:43:00.05,0:43:03.29, Lalai,,0,0,0,,Maaf kerana tidak menyedari perkara ini lebih awal.
Dialog: 0,0:43:03.85,0:43:08.43,Lalai,,0,0,0,,Saya fikir saya tahu banyak tentang mendiang raja.
Dialog: 0,0:43:09.33,0:43:11.16,Lalai,,0,0,0,,Tetapi mungkin mendiang raja,
Dialog: 0,0:43:13.73,0:43:15.07,Lalai,,0,0,0,,anakku,
Dialog: 0,0:43:15.73,0:43:19.27,Lalai,,0,0,0,,adalah raja yang lebih hebat daripada yang saya sangka,
Dialog: 0,0:43:20.30,0:43:21.84,Lalai,,0,0,0,,berdasarkan fakta
Dialog: 0,0:43:21.84,0:43:24.74,Lalai,,0,0,0,,bagaimana dia bertarung dengan Kim untuk kuasa tertinggi.
Dialog: 0,0:43:26.94,0:43:28.78,Lalai,,0,0,0,,Saya mencela diri saya kerana
Dialog: 0,0:43:29.31,0:43:32.42,Lalai,,0,0,0,,bahawa dia tidak dapat memanggil jenisnya
Dialog: 0,0:43:33.18,0:43:35.59,Lalai,,0,0,0,,menyokong raja dan perjuangannya.
Dialog: 0,0:43:38.42,0:43:40.56, Lalai,,0,0,0,,Jangan salahkan diri sendiri.
Dialog: 0,0:43:40.96,0:43:44.86,Lalai,,0,0,0,,Saya pasti mendiang raja tidak mahu perkara ini.
Dialog: 0,0:43:45.96,0:43:49.23,Lalai,,0,0,0,,Saya fikir jika saya boleh
Dialog: 0,0:43:49.97,0:43:53.97,Lalai,,0,0,0,,betulkan kesilapan saya dengan bantuan anda?
Dialog: 0,0:44:18.03,0:44:21.10,Lalai,,0,0,0,,Saya dalam banyak hal lebih rendah daripada mendiang raja.
Dialog: 0,0:44:24.47,0:44:25.97,Lalai,,0,0,0,,Betulkah?
Dialog: 0,0:44:27.67,0:44:30.57,Lalai,,0,0,0,,Jika anda berkongsi matlamat mendiang raja,
Dialog: 0,0:44:31.21,0:44:35.18,Lalai,,0,0,0,,biar saya bantu anda.
Dialog: 0,0:44:36.95,0:44:40.48,Lalai,,0,0,0,,Saya tidak akan mengulangi kesilapan saya.
Dialog: 0,0:44:41.42,0:44:43.12, Lalai,,0,0,0,,Saya akan ingat perkara itu.
Dialog: 0,0:44:46.22,0:44:50.53,Lalai,,0,0,0,,Saya sangat gembira kerana saya dapat mengenali anda sedikit hari ini.
Dialog: 0,0:44:50.53,0:44:52.56, Lalai,,0,0,0,,Tidak, terima kasih.
Dialog: 0,0:44:53.16,0:44:54.43, Lalai,,0,0,0,,Saya akan tinggalkan awak.
Dialog: 0,0:45:07.78,0:45:09.68,Lalai,,0,0,0,,Saya akan tunggu di tempat biasa kita.
Dialog: 0,0:45:31.37,0:45:33.60,Lalai,,0,0,0,,Baginda telah tiba.
Dialog: 0,0:45:40.54,0:45:43.11, Lalai,,0,0,0,,Maaf. Berapa lama awak tunggu saya?
Dialog: 0,0:45:43.98,0:45:45.35, Lalai,,0,0,0,,Tunggu di luar.
Dialog: 0,0:45:49.12,0:45:52.26,Lalai,,0,0,0,,Saya fikir awak tidak akan datang, jadi saya kembali.
Dialog: 0,0:45:52.89,0:45:54.53,Lalai,,0,0,0,,Saya lewat membaca surat itu.
Dialog: 0,0:45:55.09,0:45:56.33, Lalai,,0,0,0,,Jadi anda sibuk.
Dialog: 0,0:45:57.29,0:45:59.06,Lalai,,0,0,0,,Sehinggakan mereka terlupa tentang surat itu.
Dialog: 0,0:45:59.06,0:46:01.57,Lalai,,0,0,0,,Sebenarnya, Ibu Permaisuri datang
Dialog: 0,0:46:01.57,0:46:03.00, Lalai,,0,0,0,,cakap dengan saya.
Dialog: 0,0:46:05.00,0:46:06.97, Lalai,,0,0,0,,Apa yang awak cakapkan?
Dialog: 0,0:46:07.47,0:46:08.94, Lalai,,0,0,0,,Hanya perbualan biasa.
Dialog: 0,0:46:11.38,0:46:12.61, Lalai,,0,0,0,,Nampaknya anda ada
Dialog: 0,0:46:13.81,0:46:16.85, Lalai,,0,0,0,, semakin banyak rahsia daripada saya.
Dialog: 0,0:46:17.85,0:46:20.92,Lalai,,0,0,0,,Kemudian apa yang kamu bincangkan dengan permaisuri?
Dialog: 0,0:46:21.55,0:46:23.59, Lalai,,0,0,0,,Semasa anda berada di tasik.
Dialog: 0,0:46:25.12,0:46:27.73, Lalai,,0,0,0,,-Adakah anda melihat?\N-Sepatutnya anda tidak?
Dialog: 0,0:46:28.16,0:46:29.33, Lalai,,0,0,0,,No.
Dialog: 0,0:46:29.86,0:46:32.43,Lalai,,0,0,0,,Kami membincangkan pemilihan gundik diraja.
Dialog: 0,0:46:33.96,0:46:35.03, Lalai,,0,0,0,,Gunting.
Dialog: 0,0:46:37.13,0:46:38.57,Lalai,,0,0,0,,Saya pasti anda menolak.
Dialog: 0,0:46:38.97,0:46:41.31,Lalai,,0,0,0,,Kita perlu mengalih perhatian perhatian Kim.
Dialog: 0,0:46:41.31,0:46:43.67,Lalai,,0,0,0,,Jika kita bertembung dengan mereka dengan musuh lain,
Dialog: 0,0:46:43.67,0:46:45.68,Lalai,,0,0,0,,mereka akan melupakan takhta buat seketika.
Dialog: 0,0:46:45.68,0:46:48.71, Lalai,,0,0,0,,Jadi anda bersetuju dengan ini?
Dialog: 0,0:46:49.15,0:46:51.92,Lalai,,0,0,0,,-Ya.\N-Ini semua tipu daya ratu!
Dialog: 0,0:46:52.88,0:46:53.95,Lalai,,0,0,0,,Permaisuri Diraja.
Dialog: 0,0:46:53.95,0:46:56.25,Lalai,,0,0,0,,Kenapa awak panggil saya permaisuri diraja?
Dialog: 0,0:46:56.49,0:46:59.19, Lalai,,0,0,0,,Mengapa awak tidak memanggil saya dengan nama lagi?
Dialog: 0,0:47:00.06,0:47:04.76,Lalai,,0,0,0,,Awak kata hanya saya yang boleh buat awak gembira atau sedih.
Dialog: 0,0:47:05.50,0:47:06.90,Lalai,,0,0,0,,Tetapi sekarang
Dialog: 0,0:47:07.26,0:47:09.97, Lalai,,0,0,0,,ini bukan tentang saya lagi, bukan?
Dialog: 0,0:47:11.17,0:47:14.51,Lalai,,0,0,0,,-Hwajin.\N-Sila beritahu saya perasaan anda.
Dialog: 0,0:47:15.57,0:47:16.81,Lalai,,0,0,0,,Sungguh
Dialog: 0,0:47:18.78,0:47:21.15,Lalai,,0,0,0,, adakah anda telah jatuh cinta dengan permaisuri?
Dialog: 0,0:47:30.82,0:47:32.82, Lalai,,0,0,0,,Asas masakan Barat ialah sos dan sos.
Dialog: 0,0:47:33.09,0:47:35.03, Lalai,,0,0,0,,Pada masa yang sama, mengisi minyak ialah sorotan utama.
Dialog: 0,0:47:35.86,0:47:36.89,Lalai,,0,0,0,,Cuba.
Dialog: 0,0:47:38.46,0:47:41.80,Lalai,,0,0,0,,Jika saya menggunakan ini, bolehkah saya membuat susu daripada kacang?
Dialog: 0,0:47:43.90,0:47:45.04, Lalai,,0,0,0,,Tetapi kenapa kamu bersendirian?
Dialog: 0,0:47:45.67,0:47:46.70,Lalai,,0,0,0,,Apa?
Dialog: 0,0:47:49.11,0:47:51.61,Lalai,,0,0,0,,Saya tidak sempat berkahwin kerana kerja sepenuh masa saya.
Dialog: 0,0:47:52.64,0:47:53.91, Lalai,,0,0,0,,Bagaimana pula dengan ibu bapa dan saudara mara yang lain?
Dialog: 0,0:47:55.68,0:47:58.35,Lalai,,0,0,0,,Pada tahun 1839, semua umat Katolik dibunuh.
Dialog: 0,0:47:58.35,0:47:59.68, Lalai,,0,0,0,,Jadi saya ditinggalkan sendirian.
Dialog: 0,0:48:01.92,0:48:04.05, Lalai,,0,0,0,,Kenapa mereka menjadi Katolik?
Dialog: 0,0:48:04.76,0:48:07.22, Lalai,,0,0,0,,Itulah sebabnya saya tidak percaya pada apa-apa.
Dialog: 0,0:48:08.43,0:48:09.73, Lalai,,0,0,0,,Penganiayaan Katolik.
Dialog: 0,0:48:12.43,0:48:13.53, Lalai,,0,0,0,,Anda pasti kesepian.
Dialog: 0,0:48:14.70,0:48:16.97,Lalai,,0,0,0,,Bukan saya seorang sahaja yang berakhir seperti ini.
Dialog: 0,0:48:18.84,0:48:21.64,Lalai,,0,0,0,,Agak sedih untuk menghabiskan cuti seorang diri,
Dialog: 0,0:48:22.81,0:48:24.17, Lalai,,0,0,0,,tetapi tambahnya ialah,
Dialog: 0,0:48:25.61,0:48:29.61,Lalai,,0,0,0,,bahawa mereka meninggal dunia pada hari yang sama,\Njadi kebangkitan hanya sekali setahun.
Dialog: 0,0:48:37.62,0:48:39.22,Lalai,,0,0,0,,Apa yang salah dengan kamu semua?
Dialog: 0,0:48:39.36,0:48:41.93,Lalai,,0,0,0,,Bagaimana anda tahu bahawa saya terdedah kepada bau kesedihan?
Dialog: 0,0:48:43.43,0:48:45.43,Lalai,,0,0,0,,-Bau kesedihan?\N-Makanan berbau kesedihan.
Dialog: 0,0:48:46.56,0:48:48.90,Lalai,,0,0,0,,Apabila tukang masak sedih dan makanannya tepu dengan kesedihan.
Dialog: 0,0:48:50.20,0:48:51.27, Lalai,,0,0,0,,Saya tahu.
Dialog: 0,0:48:51.57,0:48:53.84,Lalai,,0,0,0,,Oleh itu, sama ada kegembiraan atau kesedihan,
Dialog: 0,0:48:53.84,0:48:57.04,Lalai,,0,0,0,,Saya tinggalkan semua emosi saya di depan pintu,
Dialog: 0,0:48:57.04,0:48:58.94, Lalai,,0,0,0,,sebelum masuk ke dapur.
Dialog: 0,0:48:59.41,0:49:00.91, Lalai,,0,0,0,,Tetapi anda sentiasa marah.
Dialog: 0,0:49:00.91,0:49:04.52,Lalai,,0,0,0,,Itu kerana setiap kali awak datang, awak marahkan saya.
Dialog: 0,0:49:06.38,0:49:09.29,Lalai,,0,0,0,,Salahkan diri anda kerana kurang berlatih. Tiada yang lain diperlukan.
Dialog: 0,0:49:09.49,0:49:11.76, Lalai,,0,0,0,,Lihat sahaja yang ini.
Dialog: 0,0:49:11.76,0:49:12.99, Lalai,,0,0,0,, Tengok yang ini?
Dialog: 0,0:49:13.56,0:49:14.73, Lalai,,0,0,0,,Adakah anda menyebut “ini”?
Dialog: 0,0:49:14.93,0:49:16.49, Lalai,,0,0,0,, Tengok awak.
Dialog: 0,0:49:17.96,0:49:19.20, Lalai,,0,0,0,,Lebih teruk lagi!
Dialog: 0,0:49:19.80,0:49:21.90,Lalai,,0,0,0,,Kami sepatutnya membiarkan kamu dibunuh.
Dialog: 0,0:49:23.03,0:49:25.27,Lalai,,0,0,0,,Saya sangat baik.
Dialog: 0,0:49:38.12,0:49:40.45,Lalai,,0,0,0,,Saya baru makan.
Dialog: 0,0:49:41.42,0:49:42.75, Lalai,,0,0,0,,Saya tidak tahu kenapa.
Dialog: 0,0:49:54.43,0:49:57.23, Lalai,,0,0,0,,Ini bukan untuk makanan. Lampirkan
Dialog: 0,0:49:57.97,0:49:59.44, Lalai,,0,0,0,,ke muka anda.
Dialog: 0,0:50:01.91,0:50:04.38, Lalai,,0,0,0,,Jadi saya akan menjadi amat diperlukan:
Dialog: 0,0:50:05.28,0:50:07.95, Lalai,,0,0,0,, Makanan Korea dan penjagaan diri Korea.
Dialog: 0,0:50:13.52,0:50:15.89, Lalai,,0,0,0,,Cuaca yang sesuai untuk mengeringkan sayur-sayuran.
Dialog: 0,0:50:36.07,0:50:37.17, Lalai,,0,0,0,,Yang Mulia.
Dialog: 0,0:50:38.18,0:50:40.54, Lalai,,0,0,0,,Saya tak jumpa awak semalam.
Dialog: 0,0:50:40.54,0:50:43.11, Lalai,,0,0,0,,Saya harap anda tidak mengalami mabuk teruk.
Dialog: 0,0:50:50.75,0:50:52.66, Lalai,,0,0,0,,Maaf kerana meninggalkan siaran saya.
Dialog: 0,0:50:54.19,0:50:56.19, Lalai,,0,0,0,,Saya ingin bercakap dengan anda.
Dialog: 0,0:50:58.10,0:51:00.96, Lalai,,0,0,0,,Ingat apa yang berlaku sebelum anda jatuh ke dalam keadaan vegetatif?
Dialog: 0,0:51:01.37,0:51:04.60, Lalai,,0,0,0,,Tidak perasan apa-apa atau sesiapa yang mencurigakan?
Dialog: 0,0:51:05.10,0:51:07.20, Lalai,,0,0,0,,Di bawah seseorang yang mencurigakan
Dialog: 0,0:51:07.37,0:51:09.54, Lalai,,0,0,0,,siapa yang anda maksudkan?
Dialog: 0,0:51:09.64,0:51:10.97, Lalai,,0,0,0,, Sesiapa sahaja.
Dialog: 0,0:51:11.21,0:51:13.71, Lalai,,0,0,0,,Sejujurnya,
Dialog: 0,0:51:13.71,0:51:16.51, Lalai,,0,0,0,,Saya rasa keadaan saya dikaitkan dengan kuasa dunia lain.
Dialog: 0,0:51:16.51,0:51:19.28, Lalai,,0,0,0,,Dengan kuasa dunia lain\N adakah anda maksudkan musuh?
Dialog: 0,0:51:19.28,0:51:20.48, Lalai,,0,0,0,,No.
Dialog: 0,0:51:22.22,0:51:26.69, Lalai, sempang,0,0,0,,Maksud saya, ia berlaku secara semula jadi.
Dialog: 0,0:51:27.69,0:51:30.19, Lalai,,0,0,0,,Anda akan terkejut, tetapi saya akan tetap mengatakannya.
Dialog: 0,0:51:30.86,0:51:33.43, Lalai,,0,0,0,,Saya syak raja terlibat dalam perkara ini.
Dialog: 0,0:51:34.20,0:51:36.20, Lalai,,0,0,0,,Menurut penyiasatan,
Dialog: 0,0:51:36.20,0:51:38.20,Lalai,,0,0,0,,lelaki yang menyerang kamu di Octajeon,
Dialog: 0,0:51:39.27,0:51:41.47,Lalai,,0,0,0,, telah dihantar oleh Baginda.
Dialog: 0,0:51:42.64,0:51:44.44, Lalai,,0,0,0,, Tahu anda akan terkejut.
Dialog: 0,0:51:44.94,0:51:46.11, Lalai,,0,0,0,,Bagaimana anda tahu?
Dialog: 0,0:51:46.81,0:51:48.25, Lalai,,0,0,0,,Hanya saya yang tahu tentang ini.
Dialog: 0,0:51:49.28,0:51:50.95,Lalai,,0,0,0,,Tahukah anda?
Dialog: 0,0:51:51.92,0:51:53.38, Lalai,,0,0,0,,Nah, itulah perkaranya.
Dialog: 0,0:51:54.08,0:51:56.09, Lalai,,0,0,0,,Semuanya sangat mengelirukan,
Dialog: 0,0:51:56.09,0:51:58.12,Lalai,,0,0,0,,jadi kami memutuskan untuk melupakan kejadian ini.
Dialog: 0,0:51:58.12,0:52:01.06, Lalai,,0,0,0,,Dan anda berkelakuan seolah-olah tiada apa-apa yang berlaku?
Dialog: 0,0:52:01.56,0:52:04.76,Lalai,,0,0,0,,Adakah anda terus menyayanginya walaupun apa yang dia lakukan?
Dialog: 0,0:52:05.13,0:52:07.33, Lalai,,0,0,0,,Apa? Cinta?
Dialog: 0,0:52:07.87,0:52:10.50,Lalai,,0,0,0,,Sungguh keji!
Dialog: 0,0:52:11.13,0:52:14.40,Lalai,,0,0,0,,Saya mahu tinggal di sini dengan gembira,\N Saya mesti berbaik-baik dengan raja.
Dialog: 0,0:52:14.51,0:52:16.61, Lalai,,0,0,0,,Saya tiada pilihan!
Dialog: 0,0:52:16.61,0:52:17.88, Lalai,,0,0,0,,Lalu bagaimana anda boleh...
Dialog: 0,0:52:17.88,0:52:18.98,Lalai,,0,0,0,,Saya sudah keliru,
Dialog: 0,0:52:18.98,0:52:20.48, Lalai,,0,0,0,, dan anda bercakap tentang cinta di sini.
Dialog: 0,0:52:22.35,0:52:24.21,Lalai,,0,0,0,,Bagaimanakah pilihan gundik?
Dialog: 0,0:52:24.55,0:52:25.75,Lalai,,0,0,0,,Puan Choi!
Dialog: 0,0:52:25.98,0:52:27.28, Lalai,,0,0,0,,Puan Choi!
Dialog: 0,0:52:35.32,0:52:37.72,Lalai,,0,0,0,,Gadis, saya di sini!..
Dialog: 0,0:52:40.16,0:52:41.96, Lalai,,0,0,0,,Di manakah calon?
Dialog: 0,0:52:42.63,0:52:45.30, Lalai,,0,0,0,,Mereka ada di sini.
Dialog: 0,0:52:56.78,0:52:57.78, Lalai,,0,0,0,,Apakah ini?
Dialog: 0,0:52:57.78,0:52:59.91, Lalai,,0,0,0,,Saya sangat menantikan ini.
Dialog: 0,0:53:01.68,0:53:04.92, Lalai,,0,0,0,,Ada apa?
Dialog: 0,0:53:22.17,0:53:26.04, Lalai,,0,0,0,,Saya tidak boleh menolak kaleidoskop.
Dialog: 0,0:53:35.05,0:53:37.92, Lalai,,0,0,0,,Dia pergi sejauh ini untuk keluarga kita?
Dialog: 0,0:53:47.03,0:53:49.10,Lalai,,0,0,0,,Sekali lagi, apakah namanya?
Dialog: 0,0:53:50.03,0:53:52.23, Lalai,,0,0,0,,Dia memanggilnya sebagai tabir kecantikan.
Dialog: 0,0:53:52.70,0:53:54.77,Lalai,,0,0,0,,Saya sedang mencari seseorang untuk menggantikannya,
Dialog: 0,0:53:55.17,0:53:57.47, Lalai,,0,0,0,, dan dia memberi saya rawatan baharu.
Dialog: 0,0:54:00.11,0:54:01.74, Lalai,,0,0,0,,Yang Mulia.
Dialog: 0,0:54:01.74,0:54:03.38, Lalai,,0,0,0,,Ini ialah ketua Jabatan Detektif, Kim Byungin.
Dialog: 0,0:54:05.31,0:54:06.58, Lalai,,0,0,0,,Pada jam ini?
Dialog: 0,0:54:08.98,0:54:10.12, Lalai,,0,0,0,,Enter.
Dialog: 0,0:54:26.37,0:54:28.84,Lalai,,0,0,0,,Saya sebut awak dalam perbualan dengan abang saya, jadi dia suruh awak datang,
Dialog: 0,0:54:29.27,0:54:31.04, Lalai,,0,0,0,,tetapi sudah terlambat sekarang.
Dialog: 0,0:54:31.24,0:54:33.37, Lalai,,0,0,0,,Saya tidak menerima mesej sedemikian.
Dialog: 0,0:54:34.84,0:54:37.18,Lalai,,0,0,0,,Saya berani bertegas untuk bertemu dengan awak, kerana saya mesti
Dialog: 0,0:54:37.54,0:54:40.18,Lalai,,0,0,0,,katakan sesuatu untuk memintas ayah kamu.
Dialog: 0,0:54:42.45,0:54:43.65, Lalai,,0,0,0,,Mungkin ayah saya
Dialog: 0,0:54:44.85,0:54:47.19,Lalai,,0,0,0,,berkata bahawa Baginda berbeza daripada pendahulunya.
Dialog: 0,0:54:49.99,0:54:51.89, Lalai,,0,0,0,,Tetapi dia silap.
Dialog: 0,0:55:08.24,0:55:09.28, Lalai,,0,0,0,,Apa?
Dialog: 0,0:55:12.48,0:55:13.48,Lalai,,0,0,0,,Tidak...
Dialog: 0,0:55:17.05,0:55:18.92, Lalai,,0,0,0,,Jangan ikut saya.
Dialog: 0,0:55:24.12,0:55:25.53, Lalai,,0,0,0,,Ini hanya perkara kecil.
Dialog: 0,0:55:26.96,0:55:28.33, Lalai,,0,0,0,,Sedikit ginseng merah.
Dialog: 0,0:55:28.93,0:55:31.36, Lalai,,0,0,0,,-Sini, ambil.\N-Terima kasih.
Dialog: 0,0:55:34.00,0:55:38.11, Lalai,,0,0,0,,By the way, adakah semuanya baik-baik saja?
Dialog: 0,0:55:38.11,0:55:39.91, Lalai,,0,0,0,,Dengan apa?
Dialog: 0,0:55:40.71,0:55:43.04, Lalai,,0,0,0,,Tidak perlu bercakap dalam teka-teki, sampaikan kepada intipati.
Dialog: 0,0:55:43.04,0:55:44.98, Lalai,,0,0,0,,Apa yang kamu cakapkan?
Dialog: 0,0:55:45.65,0:55:48.88, Lalai,,0,0,0,,Saya hanya tertanya-tanya bagaimana keadaannya.
Dialog: 0,0:55:50.55,0:55:55.46, Lalai,,0,0,0,,Saya rasa Benin masih di dalam istana?
Dialog: 0,0:56:03.56,0:56:05.13, Lalai,,0,0,0,,Salam.
Dialog: 0,0:56:06.43,0:56:08.90,Lalai,,0,0,0,,-Saya kembali.\N-Anda lambat hari ini.
Dialog: 0,0:56:08.90,0:56:12.37,Lalai,,0,0,0,,Tiada masa untuk hanya bersama rakan sekerja,
Dialog: 0,0:56:12.37,0:56:14.04,Lalai,,0,0,0,,jadi saya minum bersama mereka di Jabatan Detektif.
Dialog: 0,0:56:14.51,0:56:15.58,Lalai,,0,0,0,,Okey.
Dialog: 0,0:56:16.18,0:56:18.51, Lalai,,0,0,0,,Sudah terlambat. Pergi berehat.
Dialog: 0,0:56:19.01,0:56:21.68, Lalai,,0,0,0,,Baiklah, kembali ke perbualan anda.
Dialog: 0,0:56:22.78,0:56:25.25,Lalai,,0,0,0,,Okey. selamat malam.
Dialog: 0,0:56:30.49,0:56:32.23, Lalai,,0,0,0,,-Menteri\N-Ya.
Dialog: 0,0:56:32.99,0:56:34.49, Lalai,,0,0,0,,Kelihatan risau.
Dialog: 0,0:56:35.90,0:56:39.33, Lalai,,0,0,0,,Menggigit lebih daripada yang anda boleh kunyah akan membuatkan anda gementar.
Dialog: 0,0:56:39.33,0:56:42.40, Lalai,,0,0,0,,Apa... Saya tidak begitu faham.
Dialog: 0,0:56:42.94,0:56:44.27, Lalai,,0,0,0,,Anda tidak faham bahawa anda boleh
Dialog: 0,0:56:44.27,0:56:48.11, Lalai,,0,0,0,,membawa malapetaka kepada diri sendiri dan ratu dengan kecuaian kamu?
Dialog: 0,0:56:48.34,0:56:49.94,Lalai,,0,0,0,,Jika saya bimbang, itu kerana
Dialog: 0,0:56:51.11,0:56:53.88, Lalai,,0,0,0,, bahawa tidak mungkin untuk menangkap orang yang menyerang ratu.
Dialog: 0,0:56:55.28,0:56:58.32, Lalai,,0,0,0,,-Adakah ini?\N-Nah, sudah terlambat.
Dialog: 0,0:56:58.32,0:56:59.89, Lalai,,0,0,0,,Anda pasti penat.
Dialog: 0,0:57:00.65,0:57:03.02,Lalai,,0,0,0,,Saya baru masuk nak bagi hadiah,
Dialog: 0,0:57:03.49,0:57:04.86, Lalai,,0,0,0,,Saya perlu pergi.
Dialog: 0,0:57:12.33,0:57:14.40, Lalai,,0,0,0,,Dia kehilangan lejar.
Dialog: 0,0:57:15.07,0:57:17.30,Lalai,,0,0,0,,Jika dia tiada kaitan dengannya, adakah itu bermakna Byonin bertindak sendiri?
Dialog: 0,0:57:18.27,0:57:19.44, Lalai,,0,0,0,,Dan jika tidak...
Dialog: 0,0:57:20.67,0:57:21.71, Lalai,,0,0,0,, Betulkah?
Dialog: 0,0:57:49.07,0:57:52.01, Lalai,,0,0,0,,Terima kasih, itu bukan saya.
Dialog: 0,0:57:53.81,0:57:56.34, Lalai,,0,0,0,,Mengambil masa yang lama
Dialog: 0,0:57:56.88,0:57:58.85, Lalai,,0,0,0,,cari badan yang serupa.
Dialog: 0,0:57:59.08,0:58:00.78, Lalai,,0,0,0,, Beritahu saya mengenainya.
Dialog: 0,0:58:00.78,0:58:02.55, Lalai,,0,0,0,,Dia lemas.
Dialog: 0,0:58:02.55,0:58:06.75,Default,,0,0,0,,Wajah tidak dapat dikenali kerana sudah lama berada di dalam air.
Dialog: 0,0:58:11.16,0:58:13.93, Lalai,,0,0,0,,Sila beritahu saya perasaan anda.
Dialog: 0,0:58:15.96,0:58:17.13, Lalai,,0,0,0,,Adakah anda
Dialog: 0,0:58:19.17,0:58:21.33,Lalai,,0,0,0,,jatuh cinta dengan permaisuri?
Dialog: 0,0:58:27.34,0:58:28.38,Lalai,,0,0,0,,I
Dialog: 0,0:58:30.94,0:58:33.21,Lalai,,0,0,0,,mesti tidak cintakan permaisuri.
Dialog: 0,0:58:35.68,0:58:37.42,Lalai,,0,0,0,,Anda tidak menafikan bahawa anda sedang jatuh cinta.
Dialog: 0,0:58:38.65,0:58:40.39, Lalai,,0,0,0,, Katakan sahaja bahawa anda tidak sepatutnya mencintai.
Dialog: 0,0:58:55.17,0:58:57.30, Lalai,,0,0,0,,Yang Mulia, Putera Yeonpyeong ada di sini.
Dialog: 0,0:58:58.17,0:58:59.64, Lalai,,0,0,0,,Ya, log masuk.
Dialog: 0,0:59:08.18,0:59:09.92, Lalai,,0,0,0,,Maaf atas lawatan lewat.
Dialog: 0,0:59:09.92,0:59:11.18, Lalai,,0,0,0,,Saya ada berita yang anda tunggu-tunggu.
Dialog: 0,0:59:12.19,0:59:13.69,Lalai,,0,0,0,,Adakah anda menemui Ovol?
Dialog: 0,0:59:25.00,0:59:27.23, Lalai,,0,0,0,,Adakah anda memberikan ini kepadanya?
Dialog: 0,0:59:28.77,0:59:31.34, Lalai,,0,0,0,,Ya, ini hadiah saya.
Dialog: 0,0:59:31.34,0:59:34.17, Lalai,,0,0,0,,Puan mahkamah menjualnya.
Dialog: 0,0:59:37.14,0:59:40.11, Lalai,,0,0,0,,Jadi Ovol masih hidup. Alangkah nikmatnya.
Dialog: 0,0:59:41.92,0:59:44.72, Lalai,,0,0,0,,Kenapa hantar saya minta air tengah malam?
Dialog: 0,0:59:45.95,0:59:47.55, Lalai,,0,0,0,, Mereka tidak boleh bertanya sebelum ini.
Dialog: 0,0:59:57.06,0:59:58.30, Lalai,,0,0,0,,Adakah sesuatu tersekat di sana?
Dialog: 0,1:00:02.60,1:00:03.94,Lalai,,0,0,0,,Apakah ini?
Dialog: 0,1:00:17.68,1:00:20.29,Lalai,,0,0,0,,Saya mengupah seorang artis untuk melukis potret wanita itu.
Dialog: 0,1:00:20.62,1:00:22.32,Lalai,,0,0,0,,Sebaik sahaja kami melihatnya, kami akan tahu dengan pasti.
Dialog: 0,1:00:29.66,1:00:32.50,Lalai,,0,0,0,,Saya benar-benar memikirkan cara untuk membantu raja...
Dialog: 0,1:00:32.50,1:00:33.53,Lalai,,0,0,0,,Yang Mulia.
Dialog: 0,1:00:35.54,1:00:36.70,Lalai,,0,0,0,,Dalam perigi...
Dialog: 0,1:00:37.67,1:00:40.11,Lalai,,0,0,0,,-Di dalam perigi?\N-Mereka menemui mayat di sana.
Dialog: 0,1:00:40.11,1:00:43.54,Lalai,,0,0,0,,Nampaknya Ovol, pembantu rumah awak.
Dialog: 0,1:00:44.18,1:00:45.18,Lalai,,0,0,0,,Ovol?
Dialog: 0,1:00:48.25,1:00:49.35,Lalai,,0,0,0,,-Apa yang perlu kita lakukan?\N-Itulah masalahnya.
Dialog: 0,1:00:59.76,1:01:01.19,Lalai,,0,0,0,,Ini mungkin menyakiti anda.
Dialog: 0,1:01:01.66,1:01:03.46,Lalai,,0,0,0,,-Biar saya...\N-Tidak.
Dialog: 0,1:01:04.30,1:01:06.40,Lalai,,0,0,0,,Saya perlu lihat sendiri.
Dialog: 0,1:01:42.00,1:01:43.34,Lalai,,0,0,0,,-Pernahkah anda melihat ini?\N-Ini mengerikan.
Dialog: 0,1:01:45.54,1:01:47.84,Lalai,,0,0,0,,Nampaknya dia berada di bawah air untuk masa yang lama.
Dialog: 0,1:01:48.98,1:01:52.95,Lalai,,0,0,0,,Saya faham betapa menyakitkannya ini.
Dialog: 0,1:02:19.94,1:02:21.07,Lalai,,0,0,0,,Sila berhenti.
Dialog: 0,1:02:22.81,1:02:24.54,Lalai,,0,0,0,,Saya baru mula.
Dialog: 0,1:02:24.94,1:02:25.95,Lalai,,0,0,0,,Yang Mulia.
Dialog: 0,1:02:27.48,1:02:28.98,Lalai,,0,0,0,,Saya mahu bersendirian.
Dialog: 0,1:03:11.66,1:03:12.86,Lalai,,0,0,0,,Itu,
Dialog: 0,1:03:14.09,1:03:16.16,Lalai,,0,0,0,,yang membuat saya gembira dan sedih.
Dialog: 0,1:03:17.70,1:03:20.73,Lalai,,0,0,0,,Yang Mulia, Permaisuri Janda ada di sini.
Dialog: 0,1:03:29.81,1:03:31.01,Lalai,,0,0,0,,Apa yang membawa anda?
Dialog: 0,1:03:42.32,1:03:44.39,Lalai,,0,0,0,,Apa yang anda baca?
Dialog: 0,1:03:44.99,1:03:47.93,Lalai,,0,0,0,,Jadi, salah satu permintaan yang saya terlepas.
Dialog: 0,1:03:47.93,1:03:50.60,Lalai,,0,0,0,,Anda kelihatan lebih animasi daripada biasa,
Dialog: 0,1:03:51.30,1:03:53.33,Lalai,,0,0,0,,jadi saya ingin tahu bagaimana saya menghabiskan masa saya di luar istana.
Dialog: 0,1:03:53.33,1:03:54.87,Lalai,,0,0,0,,Itulah yang saya datang untuk bertanya.
Dialog: 0,1:03:55.20,1:03:56.97,Lalai,,0,0,0,,Senang lupakan seketika
Dialog: 0,1:03:56.97,1:03:58.71,Lalai,,0,0,0,,tentang hal ehwal istana.
Dialog: 0,1:04:00.11,1:04:01.24,Lalai,,0,0,0,,Gembira mendengarnya.
Dialog: 0,1:04:04.48,1:04:05.48,Lalai,,0,0,0,,Anda tahu,
Dialog: 0,1:04:06.41,1:04:08.98,Lalai,,0,0,0,,Saya doakan awak bahagia.
Dialog: 0,1:04:12.39,1:04:13.62,Lalai,,0,0,0,,Terima kasih banyak.
Dialog: 0,1:04:14.35,1:04:17.29,Lalai,,0,0,0,,Anda telah melalui banyak perkara.
Dialog: 0,1:04:18.83,1:04:20.29,Lalai,,0,0,0,,Adakah anda sudah lupa tentang segala-galanya?
Dialog: 0,1:04:21.63,1:04:24.50,Lalai,,0,0,0,,Nasib boleh diwarisi.
Dialog: 0,1:04:25.57,1:04:28.13,Lalai,,0,0,0,,Anda akan belajar untuk bersyukur dengan keadaan anda dan tidak melakukan apa-apa,
Dialog: 0,1:04:28.13,1:04:32.34,Lalai,,0,0,0,,anda dan orang yang anda sayangi akan kekal selamat.
Dialog: 0,1:04:33.51,1:04:36.91,Lalai,,0,0,0,,Jadi mengapa anda tidak boleh duduk dan berbuat apa-apa?
Dialog: 0,1:04:40.25,1:04:43.18,Lalai,,0,0,0,,Jadilah bijak, raja.
Dialog: 0,1:04:46.25,1:04:48.76,Lalai,,0,0,0,,Saya akan, Tuanku.
Dialog: 0,1:05:20.29,1:05:21.95,Lalai,,0,0,0,,Rahsia
Dialog: 0,1:05:49.28,1:05:50.88,Lalai,,0,0,0,,Jadilah bijak,
Dialog: 0,1:05:51.62,1:05:52.79,Lalai,,0,0,0,,sayang saya.
Dialog: 0,1:06:35.23,1:06:37.76,Lalai,,0,0,0,,Sesetengah orang hidup dalam mimpi ngeri.
Dialog: 0,1:07:02.02,1:07:05.19,Lalai,,0,0,0,,Kamus Ratu.
Dialog: 0,1:07:11.30,1:07:14.43,Lalai,,0,0,0,,Jarak sosial
Dialog: 0,1:07:18.87,1:07:23.08,Lalai,,0,0,0,,jadi semua orang bersendirian.
Dialog: 0,1:07:25.31,1:07:29.12,Lalai,,0,0,0,,Antifan: panduan rohani yang berkuasa
Dialog: 0,1:07:29.12,1:07:31.52,Lalai,,0,0,0,,kipas, rangkaian sosial, telefon,
Dialog: 0,1:07:31.52,1:07:33.12,Lalai,,0,0,0,,pertarungan, mari kita nyalakan,
Dialog: 0,1:07:33.12,1:07:34.89,Lalai,,0,0,0,,pasukan khas, loteri, jackpot.
Dialog: 0,1:07:38.49,1:07:39.83,Lalai,,0,0,0,,Tetapi mereka sering mendapati
Dialog: 0,1:07:40.26,1:07:42.86, Lalai,,0,0,0,, anda sendiri boleh mengatasi mimpi buruk.
Dialog: 0,1:08:13.69,1:08:15.90,Lalai,,0,0,0,,-Yang Mulia.\N-Yang Mulia.
Dialog: 0,1:08:16.06,1:08:17.60,Lalai,,0,0,0,,Datang kepada kami.
Dialog: 0,1:08:17.60,1:08:18.73,Lalai,,0,0,0,,Cepat kepada kami.
Dialog: 0,1:08:18.73,1:08:19.87,Lalai,,0,0,0,,Nah, kemari.
Dialog: 0,1:08:33.98,1:08:35.95,Lalai,,0,0,0,,Tetapi hanya untuk mimpi yang menyenangkan
Dialog: 0,1:08:36.42,1:08:38.62,Lalai,,0,0,0,,usir mimpi ngeri anda...
Dialog: 0,1:08:45.06,1:08:47.43,Lalai,,0,0,0,,-Saya juga mahukan pelukan.\N-Dan awak?
Dialog: 0,1:08:47.89,1:08:49.36,Lalai,,0,0,0,,Baiklah.
Dialog: 0,1:08:52.00,1:08:53.17,Lalai,,0,0,0,,-Bliss!\N-Queen.
Dialog: 0,1:08:56.10,1:08:58.30,Lalai,,0,0,0,,Mimpi ngeri baharu
Dialog: 0,1:08:59.31,1:09:01.51,Lalai,,0,0,0,,mencari anda.
Dialog: 0,1:09:02.34,1:09:03.44,Lalai,,0,0,0,,Yang Mulia.
Dialog: 0,1:09:04.64,1:09:09.25,Lalai,,0,0,0,,Hilang suara awak, adakah awak serak, patutkah awak hubungi saya?
Dialog: 0,1:09:13.52,1:09:15.66,Lalai,,0,0,0,,Kenapa awak terlupa di sini?
Dialog: 0,1:09:18.16,1:09:19.33,Lalai,,0,0,0,,Permaisuriku.
Dialog: 0,1:09:23.23,1:09:24.56,Lalai,,0,0,0,,Hari ini
Dialog: 0,1:09:25.93,1:09:27.90,Lalai,,0,0,0,,tiada penjarakan sosial.
Dialog: 0,1:10:01.40,1:10:04.20,Lalai,,0,0,0,,Adakah ini hati saya? Atau badan bertanya?
Dialog: 0,1:10:05.47,1:10:06.67,Lalai,,0,0,0,,Pengarah Han?
Dialog: 0,1:10:06.84,1:10:08.37,Lalai,,0,0,0,,Semuanya busuk!
Dialog: 0,1:10:08.37,1:10:11.28,Lalai,,0,0,0,,Kami akan melakukan segala-galanya untuk mendapatkan bahan-bahan.
Dialog: 0,1:10:11.28,1:10:15.35,Lalai,,0,0,0,,Raja pada Hari Troli mahu kelihatan gagah.
Dialog: 0,1:10:15.35,1:10:16.52,Lalai,,0,0,0,,Kebakaran!
Dialog: 0,1:10:17.55,1:10:20.49,Lalai,,0,0,0,,Selalu ada mereka yang mengambil pertandingan dengan begitu serius.
Dialog: 0,1:10:20.49,1:10:21.49,Lalai,,0,0,0,,Silauan jenis apakah ini?
Dialog: 0,1:10:21.49,1:10:23.66,Lalai,,0,0,0,,Jadi saya perlu mengajar anda satu pengajaran.
