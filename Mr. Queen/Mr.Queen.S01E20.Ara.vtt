Dialogue: 0,0:36:37.90,0:36:41.44,Default,معرض الرماية2,0,0,0,,أعطى الملك الأمر بتحركك إلى القصر الغربي.
Dialogue: 0,0:36:41.64,0:36:42.70,Default,معرض التصوير2,0,0,0,,ماذا؟
Dialogue: 0,0:36:42.84,0:36:46.31,Default,معرض الرماية2,0,0,0,,كيف يجرؤ على إرسالي إلى القصر الغربي؟
Dialogue: 0,0:36:48.01,0:36:50.14,Default,معرض الرماية2,0,0,0,,لمن يأخذني؟
Dialogue: 0,0:36:57.25,0:36:59.32,Default,معرض التصوير2,0,0,0,,ماذا تفعل؟ افتح الباب الآن.
Dialogue: 0,0:36:59.82,0:37:02.62,Default,معرض التصوير2,0,0,0,,لا أستطيع فتح الباب يا صاحب الجلالة.
Dialogue: 0,0:37:12.60,0:37:15.67,Default,معرض التصوير2,0,0,0,,افتح هذا الباب على الفور!
Dialogue: 0,0:37:16.60,0:37:19.04,Default,معرض التصوير2,0,0,0,,لقد جاءت الملكة.
Dialogue: 0,0:37:43.03,0:37:44.07,افتراضي,معرض التصوير2,0,0,0,,مفتوح.
Dialogue: 0,0:37:55.94,0:37:57.58,Default,shoot2,0,0,0,,سمعت أنك بالأمس كنت على وشك الموت،
Dialogue: 0,0:37:57.58,0:37:58.95,Default,tier2,0,0,0,,ولكن يبدو أن كل شيء على ما يرام معك.
Dialogue: 0,0:37:59.21,0:38:01.28,Default,معرض التصوير2,0,0,0,,كل الشكر لك.
Dialogue: 0,0:38:02.65,0:38:04.25,Default,معرض التصوير2,0,0,0,,إلى أين أنت ذاهب؟
Dialogue: 0,0:38:04.25,0:38:07.59,Default,shooting2,0,0,0,,منذ متى يجب أن أخبرك بموقعي؟
Dialogue: 0,0:38:07.59,0:38:10.49,Default,معرض الرماية2,0,0,0,,تقرر إرسالك إلى القصر الغربي.
Dialogue: 0,0:38:10.96,0:38:13.26,Default,معرض التصوير2,0,0,0,,حتى ذلك الحين، ابق في Dongmyeongjong.
Dialogue: 0,0:38:13.63,0:38:15.46,Default,معرض التصوير2,0,0,0,,غير مسموح لك بالمغادرة.
Dialogue: 0,0:38:16.10,0:38:19.73,Default,معرض التصوير2,0,0,0,,هل تقول أنك تحبسني هنا؟
Dialogue: 0,0:38:20.77,0:38:22.40,Default,معرض التصوير2,0,0,0,,لا تجعلني أضحك.
Dialogue: 0,0:38:24.51,0:38:25.57,Default,معرض التصوير2,0,0,0,,ابتعد عن الطريق!
Dialogue: 0,0:38:26.97,0:38:28.51,Default,معرض التصوير2,0,0,0,,لا يمكنك الخروج.
Dialogue: 0,0:38:29.24,0:38:31.21,Default,معرض التصوير2,0,0,0,,لقد طلبت منك الابتعاد عن الطريق!
Dialogue: 0,0:38:33.92,0:38:35.15,Default,معرض التصوير2,0,0,0,,الملكة الأرملة.
Dialogue: 0,0:38:39.12,0:38:42.09,Default,معرض الرماية2,0,0,0,,سوف تقضي يومك الأخير في القصر.
Dialogue: 0,0:38:44.49,0:38:46.59,Default,معرض الرماية2,0,0,0,,سيدة المحكمة تشون، لماذا تقفين؟
Dialogue: 0,0:38:46.59,0:38:47.70,Default,معرض التصوير2,0,0,0,,نعم يا صاحب الجلالة.
Dialogue: 0,0:38:52.47,0:38:54.44,Default,معرض التصوير2,0,0,0,,كيف تجرؤ؟
Dialogue: 0,0:38:54.44,0:38:56.44,Default,tier2,0,0,0,,لم يعودوا يطيعونك.
Dialogue: 0,0:38:58.57,0:39:00.27,Default,معرض الرماية2,0,0,0,,المسؤول عن الفناء
Dialogue: 0,0:39:01.18,0:39:02.21,Default,معرض التصوير2,0,0,0,,الآن أنا.
Dialogue: 0,0:39:02.78,0:39:04.38,Default,معرض الرماية2,0,0,0,,أنا المسؤول عن الفناء.
Dialogue: 0,0:39:04.55,0:39:06.61,Default,معرض التصوير2,0,0,0,,مازلت هنا!
Dialogue: 0,0:39:06.61,0:39:08.55,Default,معرض التصوير2,0,0,0,,هذا مكاني!
Dialogue: 0,0:39:08.55,0:39:10.59,Default,معرض التصوير2,0,0,0,,من هذا اليوم فصاعداً، سيتغير كل شيء،
Dialogue: 0,0:39:11.25,0:39:13.19,Default,tyra2,0,0,0,,وخاصة قواعد الآداب،
Dialogue: 0,0:39:13.19,0:39:15.12,Default,tier2,0,0,0,,الذي قمت بتعيينه.
Dialogue: 0,0:39:15.32,0:39:18.93,Default,معرض الرماية2,0,0,0,,لقد كانت موجودة منذ آلاف السنين!
Dialogue: 0,0:39:19.29,0:39:22.56,Default,معرض التصوير2,0,0,0,,هل تعتقد أنه يمكنك التخلي عنهم بين عشية وضحاها؟
Dialogue: 0,0:39:23.66,0:39:25.43,Default,tier2,0,0,0,,إنهم يضعفون بالفعل.
Dialogue: 0,0:39:26.30,0:39:28.04,Default,shooting2,0,0,0,,التغييرات التي كنت خائفًا منها جدًا،
Dialogue: 0,0:39:29.14,0:39:30.71,Default,معرض التصوير2,0,0,0,,بدأ بالفعل.
Dialogue: 0,0:39:46.85,0:39:49.66,Default,معرض التصوير2,0,0,0,,اللعنة، كم هو منعش!
Dialogue: 0,0:39:51.03,0:39:52.06,Default,المستوى2,0,0,0,,
Dialogue: 0,0:39:52.79,0:39:55.93,Default,معرض الرماية2,0,0,0,,سيدة المحكمة تشوي، ماذا قلت للتو؟
Dialogue: 0,0:39:56.60,0:39:59.57,Default,shooting2,0,0,0,"اللعنة، كم هو منعش!" -
Dialogue: 0,0:40:00.27,0:40:01.80,Default,تصويب2,0,0,0,,هذا ما قلته.
Dialogue: 0,0:40:05.17,0:40:08.08,Default,معرض الرماية2,0,0,0,,على ما يبدو، لقد استيقظت غرائزي الخفية.
Dialogue: 0,0:40:08.88,0:40:10.58,Default,معرض التصوير2,0,0,0,,هذا منعش حقًا.
Dialogue: 0,0:40:11.78,0:40:13.68,Default,معرض التصوير2,0,0,0,,لا أستطيع التوقف، اللعنة.
Dialogue: 0,0:40:16.02,0:40:17.05,Default,معرض التصوير2,0,0,0,,اللعنة.
Dialogue: 0,0:40:18.69,0:40:19.89,Default,معرض التصوير2,0,0,0,,أعجبني.
Dialogue: 0,0:40:21.72,0:40:24.76,Default,معرض التصوير2,0,0,0,,لك! الأوغاد!
Dialogue: 0,0:40:26.63,0:40:27.66,Default,معرض التصوير2,0,0,0,,اللعنة.
Dialogue: 0,0:40:32.50,0:40:33.80,Default,معرض التصوير2,0,0,0,,ماذا يحدث هنا؟
Dialogue: 0,0:40:47.95,0:40:49.52,Default,tira2,0,0,0,"الملكة الأم لعائلة تشو،"
Dialogue: 0,0:40:49.52,0:40:51.52,Default,tyra2,0,0,0,,مذنب بنشر الشائعات،
Dialogue: 0,0:40:51.72,0:40:53.42,Default,tyra2,0,0,0,,الذي شوه اسم الملكة
Dialogue: 0,0:40:53.62,0:40:55.36,Default,tyra2,0,0,0,,وإهانة العائلة المالكة،
Dialogue: 0,0:40:56.26,0:40:58.36,Default,إطلاق النار2,0,0,0,,عقاباً على زرع القلاقل في البلاد
Dialogue: 0,0:40:59.36,0:41:01.16,Default,معرض الرماية2,0,0,0,,سيتم نفيهم إلى القصر الغربي."
Dialogue: 0,0:41:03.30,0:41:05.30,Default,معرض التصوير2,0,0,0,,هذه مؤامرة أخرى.
Dialogue: 0,0:41:06.27,0:41:09.47,Default,معرض التصوير2,0,0,0,,لم أفعل شيئاً كهذا.
Dialogue: 0,0:41:09.47,0:41:12.47,Default,معرض التصوير2,0,0,0,,هل تقول الحقيقة؟
Dialogue: 0,0:41:14.91,0:41:17.21,Default,shooting2,0,0,0,,أقسم بشرف الملك الراحل.
Dialogue: 0,0:41:17.58,0:41:20.75,Default,التصويب2,0,0,0,,لم أفعل شيئاً كهذا.
Dialogue: 0,0:41:24.72,0:41:25.82,Default,معرض التصوير2,0,0,0,,أدخل.
Dialogue: 0,0:41:46.14,0:41:48.71,Default,معرض الرماية2,0,0,0,,"ستتم مصادرة ممتلكات المجرمين التاليين،"
Dialogue: 0,0:41:49.01,0:41:50.38,Default,معرض الرماية2,0,0,0,,وسيجلدون هم أنفسهم 100 جلدة
Dialogue: 0,0:41:50.38,0:41:52.11,Default,tyra2,0,0,0,,وسيتم إرسالهم كعبيد إلى جزيرة جيجو.
Dialogue: 0,0:41:52.31,0:41:54.85,Default,tyra2,0,0,0,,لن يُعاقب أطفالهم وزوجاتهم.
Dialogue: 0,0:41:56.25,0:41:58.02,Default,tira2,0,0,0,,مستشار الدولة السابق كيم بيونغ هاك,
Dialogue: 0,0:41:58.49,0:42:00.02,Default,tyra2,0,0,0,,المستشار الأيمن السابق تشو مان هيون،
Dialogue: 0,0:42:00.45,0:42:02.19,Default,tyra2,0,0,0,,المستشار الأيسر السابق كيم سيوك كيون،
Dialogue: 0,0:42:02.19,0:42:03.96,Default,tira2,0,0,0,,وزير الحرب السابق كيم تشانغ هيوك،
Dialogue: 0,0:42:04.43,0:42:06.13,Default,tira2,0,0,0,,السكرتير الرئيسي السابق كيم سوهيون،
Dialogue: 0,0:42:06.49,0:42:08.20,Default,tyra2,0,0,0,,وزير المسؤولين السابق جو دونغ مون
Dialogue: 0,0:42:08.80,0:42:10.13,Default,معرض التصوير2,0,0,0,,وآخرون من هذه القائمة
Dialogue: 0,0:42:10.13,0:42:11.87,Default,معرض التصوير2,0,0,0,,لن يتم تنفيذه.
Dialogue: 0,0:42:11.87,0:42:13.53,Default,معرض الرماية2,0,0,0,,ستتم مصادرة ممتلكاتهم.
Dialogue: 0,0:42:13.53,0:42:15.87,Default,tyra2,0,0,0,,ستكون مدة سجنهم 3 سنوات."
Dialogue: 0,0:42:16.74,0:42:20.11,Default,shooting2,0,0,0,,-ارحمنا يا صاحب الجلالة.\N-ارحمنا يا صاحب الجلالة.
Dialogue: 0,0:42:21.28,0:42:23.28,Default,الأناناس 3,0,0,0,,لم يكن لدينا خيار آخر!
Dialogue: 0,0:42:23.74,0:42:26.41,Default,الأناناس 3,0,0,0,,كيم بيونغين هددنا!
Dialogue: 0,0:42:26.41,0:42:29.62,Default,الأناناس 3,0,0,0,,إلى عقولنا
Dialogue: 0,0:42:30.15,0:42:33.82,Default,الأناناس 3,0,0,0,,لم يخطر ببالي قط أن أخطط للخيانة!
Dialogue: 0,0:42:34.19,0:42:36.96,Default,الأناناس 3,0,0,0,,اعف عنا يا صاحب الجلالة!
Dialogue: 0,0:42:37.12,0:42:38.89,Default,الأناناس 3,0,0,0,,كل شيء على ما يرام يا سيدي!
Dialogue: 0,0:42:38.89,0:42:41.16,Default,الأناناس 3,0,0,0,,خطأنا الوحيد هو،
Dialogue: 0,0:42:41.16,0:42:44.07,Default,الأناناس 3,0,0,0,,أننا صدقنا خبر وفاتك.
Dialogue: 0,0:42:44.37,0:42:47.54,Default,الأناناس 3,0,0,0,,سذاجتنا هي خطيئتنا!
Dialogue: 0,0:42:48.60,0:42:49.70,Default,الأناناس 3,0,0,0,,هل هذا صحيح؟
Dialogue: 0,0:42:50.61,0:42:53.57,Default,الأناناس 3,0,0,0,,ثم سأخبرك بالخطأ الآخر الذي ارتكبته.
Dialogue: 0,0:42:58.41,0:42:59.68,Default,الأناناس 3,0,0,0,,في جوسون
Dialogue: 0,0:43:01.18,0:43:03.32,Default,الأناناس 3,0,0,0,,أولئك الذين امتلأت محافظهم بالعملات المعدنية هم المسؤولون.
Dialogue: 0,0:43:04.05,0:43:07.36,Default,الأناناس 3,0,0,0,,هل أحدكم فقير؟
Dialogue: 0,0:43:09.09,0:43:12.56,Default,الأناناس 3,0,0,0,,إجبار عامة الناس على العمل\Nحتى الإرهاق، ملأت بطونكم.
Dialogue: 0,0:43:12.96,0:43:15.06,Default,الأناناس 3,0,0,0,,لقد نسيت أن مهمتك الرئيسية هي
Dialogue: 0,0:43:15.06,0:43:16.80,Default,الأناناس 3,0,0,0,,افعل كل شيء من أجل الشعب.
Dialogue: 0,0:43:17.03,0:43:19.80,Default,الأناناس 3,0,0,0,,تتخيل نفسك فوق هذا،\Nلا تهتم بديونك.
Dialogue: 0,0:43:20.33,0:43:22.10,Default,الأناناس 3,0,0,0,,الناس العاديون أُجبروا
Dialogue: 0,0:43:22.10,0:43:24.14,Default,الأناناس 3,0,0,0,,يحرث الأرض الجبلية.
Dialogue: 0,0:43:24.51,0:43:26.84,Default,الأناناس 3,0,0,0,,ولقد واصلتم زيادة الضرائب.
Dialogue: 0,0:43:27.68,0:43:30.85,Default,الأناناس 3,0,0,0,,بينما كنت تعيش في ترف ولم تعرف أي متاعب،
Dialogue: 0,0:43:30.85,0:43:33.55,Default,الأناناس 3,0,0,0,,هلك شعب جوسون ليلاً ونهاراً
Dialogue: 0,0:43:33.55,0:43:34.98,Default,الأناناس 3,0,0,0,,من الفقر والجوع.
Dialogue: 0,0:43:35.32,0:43:36.88,Default,الأناناس 3,0,0,0,,كيف تكسب المزيد؟
Dialogue: 0,0:43:36.88,0:43:38.35,Default,الأناناس 3,0,0,0,,كيف ترتفع؟
Dialogue: 0,0:43:38.35,0:43:39.89,Default,الأناناس 3,0,0,0,,كيف تصبح أكثر تأثيراً؟
Dialogue: 0,0:43:39.89,0:43:41.29,Default,الأناناس 3,0,0,0,,هل فكرت في هذا،
Dialogue: 0,0:43:41.29,0:43:43.76,Default,الأناناس 3,0,0,0,,ليست معاناة شعبي!
Dialogue: 0,0:43:44.33,0:43:45.93,Default,الأناناس 3,0,0,0,,أنت لا تهتم به!
Dialogue: 0,0:43:47.23,0:43:49.36,Default,الأناناس 3,0,0,0,,كانت حياة الناس مليئة بالعذاب.
Dialogue: 0,0:43:53.03,0:43:54.70,Default,الأناناس 3,0,0,0,,خطيئتك الأولى هي،
Dialogue: 0,0:43:54.70,0:43:57.57,Default,الأناناس 3,0,0,0,,أن تتخيل أن حياتك أغلى من حياتهم.
Dialogue: 0,0:43:58.14,0:43:59.54,Default,الأناناس 3,0,0,0,,خطيئتك الثانية هي أنك
Dialogue: 0,0:43:59.54,0:44:01.91,Default,الأناناس 3,0,0,0,,لقد سخروا من الناس،\Nإزالة أي أمل في المستقبل.
Dialogue: 0,0:44:02.41,0:44:04.55,Default,الأناناس 3,0,0,0,,يأس الآباء لأنهم لا حول لهم ولا قوة،\Nيأس الملك،
Dialogue: 0,0:44:04.55,0:44:06.51,Default,الأناناس 3,0,0,0,,لأنه عديم الفائدة للبلد،
Dialogue: 0,0:44:06.51,0:44:08.58,Default,الأناناس 3,0,0,0,,ها هي خطيئتك الثالثة!
Dialogue: 0,0:44:10.38,0:44:12.39,Default,الأناناس 3,0,0,0,,إذا افتروا عليك،
Dialogue: 0,0:44:13.89,0:44:15.16,Default,الأناناس 3,0,0,0,,تقدم.
Dialogue: 0,0:44:21.16,0:44:23.66,Default,الأناناس 3,0,0,0,,تذكر ذنوبك.
Dialogue: 0,0:44:25.57,0:44:26.73,Default,الأناناس 3,0,0,0,,توبة.
Dialogue: 0,0:44:27.87,0:44:29.20,Default,الأناناس 3,0,0,0,,أنت مجرد
Dialogue: 0,0:44:30.74,0:44:32.91,Default,الأناناس 3,0,0,0,,لصوص عديمي الضمير.
Dialogue: 0,0:44:33.34,0:44:35.28,Default,الأناناس 3,0,0,0,,ولكن بالطبع!
Dialogue: 0,0:44:41.32,0:44:43.22,Default,الأناناس 3,0,0,0,,-مخلوق!\N-Die!
Dialogue: 0,0:44:43.22,0:44:46.42,Default,الأناناس 3,0,0,0,,-الوحش!\N-قم بتمزيقه إلى أجزاء!
Dialogue: 0,0:44:46.42,0:44:48.19,Default,الأناناس 3,0,0,0,,-مت!\N-مخلوق!
Dialogue: 0,0:44:48.19,0:44:49.59,Default,الأناناس 3,0,0,0,,-لقيط!\N-عاقبه!
Dialogue: 0,0:44:49.59,0:44:52.19,Default,الأناناس 3,0,0,0,,-مت!\N-مخلوق!
Dialogue: 0,0:44:52.19,0:44:53.53,Default,الأناناس 3,0,0,0,,-إذن أنت!\N-ادفع ثمن خطاياك!
Dialogue: 0,0:44:53.53,0:44:56.36,Default,الأناناس 3,0,0,0,,-أنت تستحق الموت!\N-يا له من لقيط!
Dialogue: 0,0:44:56.36,0:44:58.50,Default,الأناناس 3,0,0,0,,-يخدمك بشكل صحيح!\N-Die!
Dialogue: 0,0:45:21.96,0:45:23.62,Default,الأناناس 3,0,0,0,,فقط اترك الأمر هنا.
Dialogue: 0,0:45:24.53,0:45:26.46,Default,الأناناس 3,0,0,0,,لكنك تضعين المكياج دائماً.
Dialogue: 0,0:45:27.46,0:45:29.53,Default,الأناناس 3,0,0,0,,أعلم أنه ممنوع عليك مغادرة القصر الغربي
Dialogue: 0,0:45:29.53,0:45:31.50,Default,الأناناس 3,0,0,0,,أو تقابل شخصًا ما.
Dialogue: 0,0:45:31.77,0:45:32.97,Default,الأناناس 3,0,0,0,,ولكن لا يزال...
Dialogue: 0,0:45:36.50,0:45:38.84,Default,الأناناس 3,0,0,0,,لقد أبقيتك معي،
Dialogue: 0,0:45:39.61,0:45:42.21,Default,الأناناس 3,0,0,0,,لأنك ثرثار بلا عقل.
Dialogue: 0,0:45:42.74,0:45:45.38,Default,الأناناس 3,0,0,0,,أنت لست من أولئك الذين يمكنهم التخطيط لشيء ما سراً.
Dialogue: 0,0:45:47.08,0:45:48.22,Default,الأناناس 3,0,0,0,,صحيح.
Dialogue: 0,0:45:49.38,0:45:52.65,Default,الأناناس 3,0,0,0,,كلنا نعيش حياتنا بشكل مختلف.
Dialogue: 0,0:45:52.82,0:45:53.89,Default,الأناناس 3,0,0,0,,جلالتك,
Dialogue: 0,0:45:55.19,0:45:57.89,Default,الأناناس 3,0,0,0,,لماذا لا تصرخ في وجهي؟
Dialogue: 0,0:45:59.63,0:46:02.73,Default,الأناناس 3,0,0,0,,لم أتعلم قط أن أبقي فمي مغلقاً.
Dialogue: 0,0:46:03.40,0:46:08.07,Default,الأناناس 3,0,0,0,,حتى لو لم أكن أبكي،\Nلماذا تبكين؟
Dialogue: 0,0:46:08.50,0:46:10.07,Default,الأناناس 3,0,0,0,,جلالتك!
Dialogue: 0,0:46:20.68,0:46:22.68,Default,الأناناس 3,0,0,0,,سأنجو من كل شيء.
Dialogue: 0,0:46:28.79,0:46:30.42,Default,الأناناس 3,0,0,0,,البقاء على قيد الحياة بالنسبة لي -
Dialogue: 0,0:46:31.69,0:46:33.99,Default,الأناناس 3,0,0,0,,تعني الفوز.
Dialogue: 0,0:47:27.88,0:47:30.58,Default,الأناناس 3,0,0,0,,امسك بيدي حتى نخرج من هنا.
Dialogue: 0,0:47:31.19,0:47:32.22,Default,الأناناس 3,0,0,0,,ما الذي تنوي فعله؟
Dialogue: 0,0:47:32.29,0:47:33.55,Default,الأناناس 3,0,0,0,,إذا كانت هناك ذكرياتها،
Dialogue: 0,0:47:36.02,0:47:38.29,Default,الأناناس 3,0,0,0,,لذا لا تزال سويون بداخلك.
Dialogue: 0,0:47:41.66,0:47:44.13,Default,الأناناس 3,0,0,0,,لقد وجدتني مرة أخرى يا بنين.
Dialogue: 0,0:47:46.67,0:47:48.77,Default,الأناناس 3,0,0,0,,ولقد اختبأت جيداً.
Dialogue: 0,0:48:34.08,0:48:35.52,Default,الأناناس 3,0,0,0,,-عذراً، ملكة.\N-عذراً، ملكة.
Dialogue: 0,0:48:36.48,0:48:38.89,Default,الأناناس 3,0,0,0,,سعيد لسماع أنك تستمتع بوقتك.
Dialogue: 0,0:48:41.56,0:48:43.02,Default,الأناناس 3,0,0,0,,-عذراً، ملكة.\N-عذراً، ملكة.
Dialogue: 0,0:48:48.56,0:48:50.63,Default,الأناناس 3,0,0,0,,لقد تغيرت كثيرًا يا صاحب الجلالة.
Dialogue: 0,0:48:52.17,0:48:54.64,Default,الأناناس 3,0,0,0,,بعد الزفاف، لم أعد نفسي، أليس كذلك؟
Dialogue: 0,0:48:56.50,0:48:57.61,Default,الأناناس 3,0,0,0,,كل هذا بسبب،
Dialogue: 0,0:48:59.74,0:49:02.81,Default,الأناناس 3,0,0,0,,أن هذا العنوان\Nأصبح اختباراً عظيماً بالنسبة لي.
Dialogue: 0,0:49:02.81,0:49:07.25,Default,الأناناس 3,0,0,0,,لقد تغيرت حتى قبل زفافك يا صاحب الجلالة.
Dialogue: 0,0:49:15.69,0:49:18.13,Default,الأناناس 3,0,0,0,,ثم اعتقدت أن المخرج الوحيد هو
Dialogue: 0,0:49:19.86,0:49:22.00,Default,الأناناس 3,0,0,0,,هذا هو الموت.
Dialogue: 0,0:49:40.51,0:49:44.89,Default,الأناناس 3,0,0,0,,لم يكن ينبغي أن أصل إلى هنا\NJang Bong-hwan
Dialogue: 0,0:49:46.89,0:49:49.09,Default,الأناناس 3,0,0,0,,هل وصلت إلى المنزل دون أي مشاكل؟
Dialogue: 0,0:49:58.73,0:50:00.53,Default,الأناناس 3,0,0,0,,جلالتك!
Dialogue: 0,0:50:03.40,0:50:05.04,Default,الأناناس 3,0,0,0,,-أبي!\N-لا مفر!
Dialogue: 0,0:50:05.47,0:50:07.34,Default,الأناناس 3,0,0,0,,من الصعب عليك المشي، ابق ساكناً!
Dialogue: 0,0:50:07.61,0:50:09.78,Default,الأناناس 3,0,0,0,,سأصعد بنفسي!
Dialogue: 0,0:50:14.82,0:50:16.58,Default,الأناناس 3,0,0,0,,-كيف تشعر؟\N-كيف تشعر؟
Dialogue: 0,0:50:17.95,0:50:19.65,Default,الأناناس 3,0,0,0,,تكلم أولاً يا أبي.
Dialogue: 0,0:50:19.65,0:50:21.79,Default,الأناناس 3,0,0,0,,كل شيء على ما يرام! تعال!
Dialogue: 0,0:50:22.56,0:50:23.82,Default,الأناناس 3,0,0,0,,-أنا بخير.\N-أنا بخير.
Dialogue: 0,0:50:30.36,0:50:31.67,Default,الأناناس 3,0,0,0,,كيف حالك؟
Dialogue: 0,0:50:31.67,0:50:33.17,Default,الأناناس 3,0,0,0,,ببطء.
Dialogue: 0,0:50:33.17,0:50:34.80,Default,الأناناس 3,0,0,0,,أعيش على صلواتك.
Dialogue: 0,0:50:35.20,0:50:36.84,Default,الأناناس 3,0,0,0,,متى أثناء الحفل
Dialogue: 0,0:50:36.84,0:50:38.44,Default,الأناناس 3,0,0,0,,اقتحم المتمردون البوابة،
Dialogue: 0,0:50:38.44,0:50:40.97,Default,الأناناس 3,0,0,0,,أصيب جميع النبلاء بالرعب.
Dialogue: 0,0:50:41.24,0:50:44.88,Default,الأناناس 3,0,0,0,,لكن القرويين جاءوا إلى منزلي لحمايتنا.
Dialogue: 0,0:50:45.31,0:50:47.25,Default,الأناناس 3,0,0,0,,قالوا إنني كنت شخصاً طيباً
Dialogue: 0,0:50:47.25,0:50:49.15,Default,الأناناس 3,0,0,0,,وساعدتهم كثيرًا!
Dialogue: 0,0:50:51.05,0:50:54.29,Default,الأناناس 3,0,0,0,,كنت أتبع تعليماتك فحسب،
Dialogue: 0,0:50:54.52,0:50:57.16,Default,الأناناس 3,0,0,0,,لذا أشعر بالحرج الشديد.
Dialogue: 0,0:50:58.83,0:51:00.83,Default,الأناناس 3,0,0,0,,من الآن فصاعداً، يمكنك أن تكون لطيفاً.
Dialogue: 0,0:51:00.99,0:51:02.90,Default,الأناناس 3,0,0,0,,بالطبع.
Dialogue: 0,0:51:03.86,0:51:06.07,Default,الأناناس 3,0,0,0,,سأكون جداً محترماً
Dialogue: 0,0:51:06.07,0:51:08.34,Default,الأناناس 3,0,0,0,,لطفلك.
Dialogue: 0,0:51:11.11,0:51:13.34,Default,الأناناس 3,0,0,0,,أوه، الطفل يدفع.
Dialogue: 0,0:51:14.31,0:51:15.84,Default,الأناناس 3,0,0,0,,هل تدفع بالفعل؟
Dialogue: 0,0:51:21.52,0:51:24.19,Default,الأناناس 3,0,0,0,,ستصبح حفيدتي عبقرية!
Dialogue: 0,0:51:34.10,0:51:36.24,Default,الأناناس 3,0,0,0,,ربما رائحة البصل قوية جداً؟
Dialogue: 0,0:51:36.58,0:51:39.12,Default,الأناناس 3,0,0,0,,ما الذي تطبخه بهذه الحماس؟
Dialogue: 0,0:51:40.72,0:51:44.45,Default,الأناناس 3,0,0,0,,أردت أن أحاول تكرار الرامن،
Dialogue: 0,0:51:44.45,0:51:45.78,Default,الأناناس 3,0,0,0,,الذي كانت الملكة تحضره.
Dialogue: 0,0:51:47.66,0:51:51.35,Default,الأناناس 3,0,0,0,,هل يمكنني الحصول على بعض الرامن؟
Dialogue: 0,0:52:04.41,0:52:05.87,Default,الأناناس 3,0,0,0,,كن صبوراً.
Dialogue: 0,0:52:09.08,0:52:11.37,Default,الأناناس 3,0,0,0,,ظننت أننا سنفوز وستبدأ الحياة،
Dialogue: 0,0:52:12.05,0:52:13.22,Default,الأناناس 3,0,0,0,,والمزيد من العمل.
Dialogue: 0,0:52:14.72,0:52:16.01,Default,الأناناس 3,0,0,0,,لا أحد.
Dialogue: 0,0:52:16.64,0:52:18.89,Default,الأناناس 3,0,0,0,,عزيزي دويل!
Dialogue: 0,0:52:18.89,0:52:20.58,Default,الأناناس 3,0,0,0,,أنا مشغول! ثم سنلعب!
Dialogue: 0,0:52:21.76,0:52:23.45,Default,الأناناس 3,0,0,0,,لقد سئمت من القمار.
Dialogue: 0,0:52:24.95,0:52:26.03,Default,الأناناس 3,0,0,0,,حقاً؟
Dialogue: 0,0:52:29.62,0:52:32.87,Default,الأناناس 3,0,0,0,,لمساهمتي في النصر
Dialogue: 0,0:52:32.87,0:52:36.43,Default,الأناناس 3,0,0,0,,لقد منحني الملك منصباً في البلاط.
Dialogue: 0,0:52:37.93,0:52:39.01,Default,الأناناس 3,0,0,0,,وأنا هنا
Dialogue: 0,0:52:39.74,0:52:41.64,Default,الأناناس 3,0,0,0,,بقي في نفس المنشور.
Dialogue: 0,0:52:42.85,0:52:44.74,Default,الأناناس 3,0,0,0,,أسأل عن منصب الوزير؟
Dialogue: 0,0:52:54.49,0:52:56.16,Default,الأناناس 3,0,0,0,,ما هذا الوحش الذي على وجهك؟
Dialogue: 0,0:52:57.28,0:52:59.49,Default,الأناناس 3,0,0,0,,كم أنت من الطراز القديم.
Dialogue: 0,0:53:02.53,0:53:06.39,Default,الأناناس 3,0,0,0,,أنا الآن أعمل في قسم العلاقات الخارجية.
Dialogue: 0,0:53:06.80,0:53:11.07,Default,الأناناس 3,0,0,0,,لمثل هذا الشخص الموهوب\Nجوسون وحده لن يكون كافياً.
Dialogue: 0,0:53:18.58,0:53:20.97,Default,الأناناس 3,0,0,0,,تهانينا على ترك الألعاب.
Dialogue: 0,0:53:21.51,0:53:22.64,Default,الأناناس 3,0,0,0,,ماذا عن الغرض؟
Dialogue: 0,0:53:22.64,0:53:24.35,Default,الأناناس 3,0,0,0,,أهنئك على ما ستفعله
Dialogue: 0,0:53:24.35,0:53:26.05,Default,الأناناس 3,0,0,0,,تمشي حتى تبلى ساقيك؟
Dialogue: 0,0:53:28.18,0:53:32.93,Default,الأناناس 3,0,0,0,,مازلت مصدوماً لأن لي سينمان هي ملكتنا.
Dialogue: 0,0:53:32.93,0:53:35.87,Default,الأناناس 3,0,0,0,,وما زلت مصدوماً لأنك لم تفهم الأمر على الفور.
Dialogue: 0,0:53:36.10,0:53:38.43,Default,الأناناس 3,0,0,0,,دويل، لقد انتهيت بالفعل...
Dialogue: 0,0:53:39.87,0:53:41.87,Default,الأناناس 3,0,0,0,,أوه! وأنت هنا.
Dialogue: 0,0:53:43.01,0:53:45.03,Default,الأناناس 3,0,0,0,,لم أراك منذ وقت طويل يا جيونغ تشول!
Dialogue: 0,0:53:47.85,0:53:50.87,Default,الأناناس 3,0,0,0,,إذا كانت لي سينمان هي الملكة، فأنت...
Dialogue: 0,0:53:57.41,0:53:59.32,Default,الأناناس 3,0,0,0,,أنت امرأة أيضاً.
Dialogue: 0,0:54:01.33,0:54:03.05,Default,الأناناس 3,0,0,0,,كيم هوان، أنا أعشقك.
Dialogue: 0,0:54:03.45,0:54:04.85,Default,الأناناس 3,0,0,0,,أنت ذكي جدًا!
Dialogue: 0,0:54:07.39,0:54:10.07,Default,الأناناس 3,0,0,0,,سمعت أنك حصلت على منصب في المحكمة.
Dialogue: 0,0:54:10.62,0:54:12.37,Default,الأناناس 3,0,0,0,,لقد أعطاني إياها الملك بنفسه.
Dialogue: 0,0:54:14.53,0:54:15.91,Default,الأناناس 3,0,0,0,,ما هي خطاياي؟
Dialogue: 0,0:54:23.41,0:54:26.32,Default,li,0,0,0,,-سامفول، اذهب إلى المنزل.\N-حسناً.
Dialogue: 0,0:54:30.82,0:54:31.91,Default,li,0,0,0,,لماذا أنت هنا؟
Dialogue: 0,0:54:32.16,0:54:34.78,Default,li,0,0,0,,الجو بارد في الخارج. كم من الوقت انتظرت؟
Dialogue: 0,0:54:34.78,0:54:37.39,Default,أو,0,0,0,,لا. أنا فقط...
Dialogue: 0,0:54:39.89,0:54:41.12,Default,li,0,0,0,,ماذا حدث؟
Dialogue: 0,0:54:49.03,0:54:51.47,Default,أو,0,0,0,,مجرد تشنج.
Dialogue: 0,0:54:55.95,0:54:57.58,Default,li,0,0,0,,كيف حالك؟
Dialogue: 0,0:54:59.01,0:55:00.01,Default,li,0,0,0,,حسنًا.
Dialogue: 0,0:55:00.62,0:55:02.55,Default,li,0,0,0,,جلالة الملك بخير.
Dialogue: 0,0:55:02.55,0:55:03.55,Default,أو,0,0,0,,لا.
Dialogue: 0,0:55:04.68,0:55:05.99,Default,li,0,0,0,,كنت أسأل عنك.
Dialogue: 0,0:55:09.28,0:55:10.43,Default,li,0,0,0,,أنا...
Dialogue: 0,0:55:22.74,0:55:26.24,Default,li,0,0,0,,لقد استقر الوضع مع قسم إيجيونغتشون.
Dialogue: 0,0:55:26.43,0:55:28.64,Default,li,0,0,0,,شكراً له، أنا غارق في العمل.
Dialogue: 0,0:55:31.14,0:55:33.97,Default,li,0,0,0,,إذن، ما هي الخطوة التالية؟
Dialogue: 0,0:55:34.32,0:55:35.39,Default,li,0,0,0,,أريد
Dialogue: 0,0:55:36.45,0:55:39.16,Default,سواء,0,0,0,,منح السلطة لكل شخص،
Dialogue: 0,0:55:39.82,0:55:42.12,Default,أو,0,0,0,,لذلك عندما يجتمع الناس، تكون لديهم قوة أكبر مني.
Dialogue: 0,0:55:42.85,0:55:46.70,Default,أو,0,0,0,,بهذه الطريقة لن يتمكن المسؤولون الفاسدون من استغلالهم بعد الآن.
Dialogue: 0,0:55:47.39,0:55:49.89,Default,li,0,0,0,,أعتقد أن هذه هي الطريقة التي يجب أن تنتهي بها الأمور
Dialogue: 0,0:55:51.80,0:55:53.49,Default,li,0,0,0,,هذه معركة صعبة
Dialogue: 0,0:55:54.64,0:55:56.07,Default,li,0,0,0,,ورحلة رائعة.
Dialogue: 0,0:55:56.74,0:55:58.87,Default,li,0,0,0,,تريد أن تقول إن لدي المزيد من المخاوف.
Dialogue: 0,0:55:58.87,0:56:00.74,Default,li,0,0,0,,دعونا ننهي هذا.
Dialogue: 0,0:56:00.74,0:56:02.30,Default,li,0,0,0,,يا إلهي.
Dialogue: 0,0:56:05.08,0:56:07.01,Default,li,0,0,0,,دعونا نعود للمنزل.
Dialogue: 0,0:56:07.01,0:56:08.74,Default,أو,0,0,0,,يمكنك المتابعة صباح الغد.
Dialogue: 0,0:56:09.45,0:56:10.99,Default,li,0,0,0,,لن نتفق.
Dialogue: 0,0:56:13.16,0:56:14.55,Default,li,0,0,0,,أولاً، رتّب الأمور...
Dialogue: 0,0:56:14.72,0:56:16.22,Default,li,0,0,0,,-ليلة سعيدة.\N-حسناً.
Dialogue: 0,0:56:17.39,0:56:20.10,Default,li,0,0,0,,مبارزة، أنت بحاجة إلى إنشاء...
Dialogue: 0,0:56:20.35,0:56:21.39,Default,li,0,0,0,,المبارزة!
Dialogue: 0,0:56:21.72,0:56:23.66,Default,li,0,0,0,,يا له من أحمق.
Dialogue: 0,0:56:47.51,0:56:50.26,Default,li,0,0,0,,قاموس الملكة
Dialogue: 0,0:56:59.33,0:57:01.53,Default,أو,0,0,0,,هل فاتني شيء ما؟
Dialogue: 0,0:57:04.97,0:57:06.91,Default,li,0,0,0,,أحياناً أشعر وكأنني...
Dialogue: 0,0:57:10.37,0:57:11.51,Default,li,0,0,0,,لقد فعلها.
Dialogue: 0,0:57:12.22,0:57:13.41,Default,li,0,0,0,,لقد نجح.
Dialogue: 0,0:57:13.41,0:57:14.45,Default,li,0,0,0,,عصر حكم الملك تشيولجو
Dialogue: 0,0:57:27.26,0:57:30.99,Default,li,0,0,0,,سجلات الملك تشيولجو
Dialogue: 0,0:57:35.20,0:57:36.20,Default,li,0,0,0,,ملكتي.
Dialogue: 0,0:57:41.14,0:57:42.45,Default,أو,0,0,0,,ليس مضحكاً؟
Dialogue: 0,0:58:04.12,0:58:05.20,Default,lee,0,0,0,,جانغ بونغ هوان!
Dialogue: 0,0:58:09.64,0:58:10.70,Default,li,0,0,0,,لا تقترب.
Dialogue: 0,0:58:12.93,0:58:14.68,Default,li,0,0,0,,عليك أن تجد خان أولاً.
Dialogue: 0,0:58:15.08,0:58:17.74,Default,هل هو كذلك,0,0,0,,لا، هل من الأسرع الاتصال بوسائل الإعلام على الفور؟
Dialogue: 0,0:58:18.64,0:58:21.64,Default,li,0,0,0,,لماذا تهرب؟ لقد فعل مثل هذا العمل الصالح!
Dialogue: 0,0:58:22.89,0:58:23.95,Default,أو,0,0,0,,عمل جيد؟
Dialogue: 0,0:58:25.41,0:58:27.45,Default,li,0,0,0,,إذاً لماذا تتبعني؟
Dialogue: 0,0:58:28.08,0:58:29.45,Default,أو,0,0,0,,نحن نحميك لأننا
Dialogue: 0,0:58:29.45,0:58:31.22,Default,أو,0,0,0,,لقد قدمت نصيحة من أجل الصالح العام.
Dialogue: 0,0:58:31.55,0:58:32.55,Default,أليس كذلك,0,0,0,,جيد؟
Dialogue: 0,0:58:32.55,0:58:35.87,Default,li,0,0,0,,هل تتذكر الكاميرا الموجودة في المستودع؟
Dialogue: 0,0:58:35.87,0:58:37.62,Default,li,0,0,0,,لقد أصلحته سراً.
Dialogue: 0,0:58:38.10,0:58:39.16,Default,li,0,0,0,,أنا؟
Dialogue: 0,0:58:45.93,0:58:46.93,Default,li,0,0,0,,انتظر.
Dialogue: 0,0:58:55.18,0:58:56.99,Default,أو,0,0,0,,هل تتحكم في الكاميرا؟
Dialogue: 0,0:58:57.91,0:58:59.95,Default,li,0,0,0,,من الغريب أنها لا تزال مكسورة.
Dialogue: 0,0:59:00.35,0:59:01.55,Default,li,0,0,0,,نحن بحاجة للقبض على اللص.
Dialogue: 0,0:59:03.18,0:59:05.16,Default,li,0,0,0,,لماذا تفعل هذا الهراء؟
Dialogue: 0,0:59:05.45,0:59:06.85,Default,li,0,0,0,,هذا لا يبدو مثلك.
Dialogue: 0,0:59:06.85,0:59:09.66,افتراضي,أو,0,0,0,,بالضبط. لماذا لم يخبروني في وقت سابق؟
Dialogue: 0,0:59:10.26,0:59:11.80,Default,li,0,0,0,,لقد قمت بأشياء بالفعل.
Dialogue: 0,0:59:12.57,0:59:14.14,Default,li,0,0,0,,-ماذا؟\N-لقد أرسلت لقطات الكاميرا
Dialogue: 0,0:59:14.14,0:59:17.24,Default,أو,0,0,0,,مجاني في وسائل الإعلام، وهو أمر غير معتاد بالنسبة لي.
Dialogue: 0,0:59:19.43,0:59:21.47,Default,li,0,0,0,,إنه يكذب.
Dialogue: 0,0:59:21.85,0:59:22.95,Default,li,0,0,0,,نعم بالضبط.
Dialogue: 0,0:59:23.45,0:59:26.78,Default,lee,0,0,0,,البونغهوان الذي أعرفه لا يهتم بالعدالة.
Dialogue: 0,0:59:26.78,0:59:28.62,Default,li,0,0,0,,كان سيأتي إليّ أولاً
Dialogue: 0,0:59:28.62,0:59:32.05,Default,أو,0,0,0,,وتم الاتفاق عليه قبل إرسال السجلات. هل انا مخطئ؟
Dialogue: 0,0:59:34.22,0:59:35.22,افتراضي,أو,0,0,0,,صحيح.
Dialogue: 0,0:59:36.18,0:59:37.43,Default,li,0,0,0,,أنا وغد.
Dialogue: 0,0:59:38.20,0:59:39.22,Default,li,0,0,0,,لكن هل تعلم ماذا؟
Dialogue: 0,0:59:40.49,0:59:42.33,Default,li,0,0,0,,-لقد تغيرت.\N-حقاً؟
Dialogue: 0,0:59:43.16,0:59:44.62,Default,سواء,0,0,0,,-لماذا؟\N-لا أعرف.
Dialogue: 0,0:59:45.33,0:59:46.57,Default,li,0,0,0,,أردت ذلك فقط.
Dialogue: 0,0:59:50.87,0:59:52.08,Default,li,0,0,0,,أيها الوغد!
Dialogue: 0,0:59:58.45,0:59:59.47,Default,lee,0,0,0,,الرئيس براز!
Dialogue: 0,1:00:01.12,1:00:02.18,Default,li,0,0,0,,الرئيس براز!
Dialogue: 0,1:00:04.32,1:00:06.68,Default,li,0,0,0,,-اللعنة.\N-Moron.
Dialogue: 0,1:00:17.26,1:00:19.97,Default,li,0,0,0,,تمكن تشيولجونغ من تغيير مصيره،
Dialogue: 0,1:00:20.26,1:00:21.47,Default,li,0,0,0,,ولقد تغيرت أيضاً.
Dialogue: 0,1:00:23.30,1:00:25.10,Default,li,0,0,0,,ولكن لماذا لا يزال المدير هان كما هو؟
Dialogue: 0,1:00:29.35,1:00:30.78,Default,أو,0,0,0,,
Dialogue: 0,1:00:32.91,1:00:34.82,Default,li,0,0,0,,شولجو
Dialogue: 0,1:00:35.91,1:00:38.85,Default,li,0,0,0,,ألم يتغير العالم حقاً على الإطلاق؟
Dialogue: 0,1:00:39.49,1:00:41.66,Default,أليس كذلك,0,0,0,,فقط أنا وتشيولجونغ تغيّرنا؟
Dialogue: 0,1:00:42.76,1:00:44.72,Default,lee,0,0,0,,إنجازات تشولجو
Dialogue: 0,1:00:44.72,1:00:46.70,Default,lee,0,0,0,,كاريزما تشولزدو هزت جوسون حتى النخاع
Dialogue: 0,1:00:46.70,1:00:48.72,Default,li,0,0,0,,شولجو نفذ الإصلاح الشعبي
Dialogue: 0,1:00:48.72,1:00:51.10,Default,li,0,0,0,,إنجازات الملك تشولجو والملكة تشورين
Dialogue: 0,1:00:51.10,1:00:52.66,Default,li,0,0,0,,كان نموذجاً لإصلاح الملوك
Dialogue: 0,1:00:52.66,1:00:55.03,Default,li,0,0,0,,وضع "تشولجو" الأساس للديمقراطية
Dialogue: 0,1:00:57.26,1:00:59.30,Default,li,0,0,0,,-علق.\N-قل بضع كلمات!
Dialogue: 0,1:00:59.30,1:01:01.47,Default,li,0,0,0,,-فقط بضع كلمات!\N-هل تعترف بالتهم؟
Dialogue: 0,1:01:01.47,1:01:03.45,Default,li,0,0,0,,-هنا!\N-Comment!
Dialogue: 0,1:01:03.45,1:01:05.87,Default، هل هذا صحيح؟\N-هل تعترف بالتهم؟
Dialogue: 0,1:01:05.87,1:01:08.12,Default,is,0,0,0,,-هل كل العبارات صحيحة؟\N-هل هذا صحيح؟
Dialogue: 0,1:01:08.12,1:01:14.16,Default,سواء,0,0,0,,لقد كان المخرج "هان" يختلس الأموال لسنوات عديدة.
Dialogue: 0,1:01:18.05,1:01:19.53,Default,أو,0,0,0,,الزمن يتغير.
Dialogue: 0,1:01:19.53,1:01:23.20,Default,li,0,0,0,,لكن المسؤولين الفاسدين الماكرين يظلون على قيد الحياة دائمًا.
Dialogue: 0,1:01:25.26,1:01:27.87,Default,li,0,0,0,,رغم أن هناك أجزاء فاسدة في العالم،
Dialogue: 0,1:01:27.87,1:01:30.60,Default,أو,0,0,0,,لكنه يسمح لك بقطع هذه الأجزاء الفاسدة.
Dialogue: 0,1:01:32.10,1:01:34.64,Default,أو,0,0,0,,إذا حاولت تغيير حياتك للأفضل،
Dialogue: 0,1:01:34.64,1:01:36.51,Default,li,0,0,0,,سوف تنجح،
Dialogue: 0,1:01:37.55,1:01:39.68,Default,li,0,0,0,,مثلي وتشيولجونغ.
Dialogue: 0,1:01:58.99,1:02:01.03,Default,li,0,0,0,,-جلالتك.\N-ماذا؟
Dialogue: 0,1:02:01.03,1:02:02.33,Default,أو,0,0,0,,اقلب.
Dialogue: 0,1:02:03.10,1:02:04.14,افتراضي,أو,0,0,0,,بالضبط.
Dialogue: 0,1:02:09.20,1:02:12.22,Default,أو,0,0,0,,جلالتك، هل يصعب عليك التركيز؟
Dialogue: 0,1:02:12.74,1:02:14.85,Default,li,0,0,0,,أريد رؤية الملكة بشدة،
Dialogue: 0,1:02:15.49,1:02:17.01,Default,أو,0,0,0,,أنني لا أستطيع التفكير في أي شيء.
Dialogue: 0,1:02:20.51,1:02:21.66,Default,أو,0,0,0,,هذا لن ينجح.
Dialogue: 0,1:02:22.33,1:02:24.68,Default,li,0,0,0,,سأرى الملكة ثم أتولى الأمر.
Dialogue: 0,1:02:26.39,1:02:27.39,Default,أو,0,0,0,,التالي.
Dialogue: 0,1:02:28.33,1:02:30.70,Default,li,0,0,0,,جميع نساء المحكمة فوق 18 عامًا
Dialogue: 0,1:02:31.74,1:02:33.26,Default,سواء,0,0,0,,الزواج مسموح به.
Dialogue: 0,1:02:39.30,1:02:40.30,Default,أو,0,0,0,,نعم.
Dialogue: 0,1:02:40.30,1:02:43.28,Default,أو,0,0,0,,بالإضافة إلى ذلك، الأطفال دون سن 10 سنوات
Dialogue: 0,1:02:43.28,1:02:45.47,الافتراضي,أو,0,0,0,,لا ينبغي أن يكونوا خدمًا في الفناء.
Dialogue: 0,1:02:47.87,1:02:48.99,Default,li,0,0,0,,والمزيد...
Dialogue: 0,1:02:52.89,1:02:55.26,Default,li,0,0,0,,وماذا بعد يا صاحب الجلالة؟
Dialogue: 0,1:02:59.35,1:03:00.39,Default,أليس كذلك,0,0,0,,جلالتك؟
Dialogue: 0,1:03:03.26,1:03:04.53,Default,lee,0,0,0,,عذراً يا سيدة تشوي.
Dialogue: 0,1:03:04.53,1:03:07.37,Default,li,0,0,0,,تجد صعوبة في التركيز.
Dialogue: 0,1:03:07.66,1:03:10.03,Default,li,0,0,0,,لقد التقيت مؤخراً بجلالته.
Dialogue: 0,1:03:10.64,1:03:12.53,Default,li,0,0,0,,هذا ليس أنا. إنه الطفل الذي يفتقده.
Dialogue: 0,1:03:13.24,1:03:14.58,Default,أو,0,0,0,,من أجل رفاهية الطفل،
Dialogue: 0,1:03:14.87,1:03:18.20,Default، هلا،0,0,0,,تذهب لرؤية الملك لبعض الوقت؟
Dialogue: 0,1:03:18.55,1:03:19.68,Default,أو,0,0,0,,أوافق.
Dialogue: 0,1:03:24.55,1:03:25.62,Default,li,0,0,0,,-جلالتك.\N-ماذا؟
Dialogue: 0,1:03:25.62,1:03:28.93,Default,li,0,0,0,,توجهت صاحبة الجلالة إلى قاعة سونغ جونغجونغ.
Dialogue: 0,1:03:29.85,1:03:32.35,Default,أو,0,0,0,,واو. لقد افتقدنا بعضنا البعض.
Dialogue: 0,1:03:35.30,1:03:36.93,Default,is,0,0,0,,جلالته في دايجوجون؟
Dialogue: 0,1:03:37.22,1:03:38.26,Default,li,0,0,0,,نعم.
Dialogue: 0,1:03:45.87,1:03:47.87,Default,li,0,0,0,,انتظر يا صاحب الجلالة!
Dialogue: 0,1:03:48.60,1:03:50.85,Default,li,0,0,0,,كم هي متحمسة. تعال.
Dialogue: 0,1:03:58.68,1:04:01.32,Default,li,0,0,0,,ما هذا. هل افتقدنا بعضنا البعض مرة أخرى؟
Dialogue: 0,1:04:02.39,1:04:05.45,Default,أو,0,0,0,,يا رب، هل نلعب الغميضة؟
Dialogue: 0,1:04:13.49,1:04:14.60,Default,أو,0,0,0,,هذا لن ينجح.
Dialogue: 0,1:04:15.64,1:04:16.74,Default,li,0,0,0,,ثم...
Dialogue: 0,1:04:30.39,1:04:31.89,Default,li,0,0,0,,لقد التقينا أخيرًا.
Dialogue: 0,1:04:32.41,1:04:33.45,Default,أو,0,0,0,,بعد,
Dialogue: 0,1:04:35.43,1:04:37.39,Default,أو,0,0,0,,كم مرة افتقدنا بعضنا البعض.
Dialogue: 0,1:04:37.89,1:04:42.39,Default,li,0,0,0,,تبدو هذه اللحظات العابرة وكأنها أبدية.
Dialogue: 0,1:05:14.35,1:05:18.39,Default,li,0,0,0,,بالمناسبة، لماذا تتحدث معي بشكل رسمي؟
Dialogue: 0,1:05:19.03,1:05:21.20,Default,هل أنت,0,0,0,,هل تحضر لمفاجأة ما مرة أخرى؟
Dialogue: 0,1:06:15.33,1:06:18.04,Default,li,0,0,0,,شكرًا على المشاهدة مع Azaleas
Dialogue: 0,1:06:18.77,1:06:20.60,Default,lee,0,0,0,,شكر خاص لتشوي جينهيوك
Dialogue: 0,0:20:00.72,0:20:02.72,Default,,0,0,0,,

