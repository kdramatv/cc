Dialogue: 0,0:01:13.16,2:01:37.16,الحاضر,,0,0,0,,{\fs40\pos(1181,4)}أزاليا
Dialogue: 0,0:01:04.19,0:01:06.63,Default,Spilik,0,0,0,,جميع الشخصيات وهمية،
Dialogue: 0,0:01:06.63,0:01:08.90,Default,Spilik,0,0,0,,والأحداث المعروضة هي من الخيال.
Dialogue: 0,0:01:10.46,0:01:13.30,Default,Spilik,0,0,0,,الحلقة الأخيرة
Dialogue: 0,0:01:13.82,0:01:14.96,Default,Spilik,0,0,0,,توقف.
Dialogue: 0,0:01:20.03,0:01:21.44,Default,Spilik,0,0,0,,-Search.\N-نعم!
Dialogue: 0,0:01:38.15,0:01:39.58,Default,Spilik,0,0,0,,لا يوجد شيء مريب.
Dialogue: 0,0:02:19.80,0:02:20.93,Default,Spilik,0,0,0,,الربح.
Dialogue: 0,0:02:29.68,0:02:32.41,Default,Spilik,0,0,0,,فتش بعناية كل عربات الهدايا الملكية.
Dialogue: 0,0:02:32.85,0:02:33.91,Default,Spilik,0,0,0,,نعم.
Dialogue: 0,0:02:42.58,0:02:44.82,Default,Spilik,0,0,0,,-جلالتك!\N-مرحباً.
Dialogue: 0,0:02:45.66,0:02:46.69,Default,Spilik,0,0,0,,كيف...
Dialogue: 0,0:02:47.78,0:02:49.83,Default,Spillit,0,0,0,,ملك!
Dialogue: 0,0:02:53.63,0:02:56.24,Default,Spillie,0,0,0,,أخيرًا، أمسكت بهذا الجرذ الصغير.
Dialogue: 0,0:02:57.16,0:02:58.61,Default,Spilik,0,0,0,,متى يبدأ الحفل؟
Dialogue: 0,0:02:59.30,0:03:01.80,Default,Spilik,0,0,0,,-بعد الظهر.\N-إذن لدينا بعض الوقت؟
Dialogue: 0,0:03:02.21,0:03:04.53,Default,Spilik,0,0,0,,لا يمكنك الاسترخاء. دعونا نسرع.
Dialogue: 0,0:03:05.27,0:03:06.34,Default,Spillit,0,0,0,,انتظر.
Dialogue: 0,0:03:12.34,0:03:14.79,Default,Spilik,0,0,0,,-ماذا كان ذلك؟\N-لا أعرف.
Dialogue: 0,0:03:21.99,0:03:23.99,Default,Spilik,0,0,0,,لدينا وقت لهذا.
Dialogue: 0,0:03:24.52,0:03:26.89,Default,Spilik,0,0,0,,-الآن دعنا نذهب.\N-حسناً.
Dialogue: 0,0:03:35.77,0:03:38.68,Default,Spilik,0,0,0,,حياتي بدوني
Dialogue: 0,0:04:01.23,0:04:02.30,Default,Spilik,0,0,0,,جلالتك.
Dialogue: 0,0:04:10.48,0:04:13.51,Default,Spillit,0,0,0,,انتظر، لم أنتهي من التنظيف.
Dialogue: 0,0:04:17.58,0:04:18.58,Default,Spillie,0,0,0,,أوه يا أمهات!
Dialogue: 0,0:04:24.21,0:04:25.26,Default,Spilik,0,0,0,,جلالتك.
Dialogue: 0,0:04:28.23,0:04:29.73,Default,Spilik,0,0,0,,أنت مستاء للغاية،
Dialogue: 0,0:04:30.15,0:04:32.73,Default,Spilik,0,0,0,,ما هي روحك التي تتجول في القصر؟
Dialogue: 0,0:04:35.20,0:04:36.46,Default,Spilik,0,0,0,,جلالتك.
Dialogue: 0,0:04:40.01,0:04:41.04,Default,Spillit,0,0,0,,رئيس الخصي.
Dialogue: 0,0:04:42.21,0:04:43.71,Default,Spilik,0,0,0,,تعال معي.
Dialogue: 0,0:04:44.71,0:04:46.87,Default,Spilik,0,0,0,,معك؟
Dialogue: 0,0:04:47.51,0:04:49.24,Default,Spillie,0,0,0,,تضيع!
Dialogue: 0,0:04:52.89,0:04:55.71,Default,Spilik,0,0,0,,يا صاحب الجلالة، اذهب إلى الجنة.
Dialogue: 0,0:04:56.31,0:04:58.15,Default,Spilik,0,0,0,,يجب أن تأتي معي.
Dialogue: 0,0:04:59.79,0:05:00.86,Default,Spillit,0,0,0,,الملكة.
Dialogue: 0,0:05:02.86,0:05:03.89,Default,Spillit,0,0,0,,ملك.
Dialogue: 0,0:05:05.33,0:05:07.12,Default,Spilik,0,0,0,,جلالتك! أنت على قيد الحياة!
Dialogue: 0,0:05:09.46,0:05:12.80,Default,Spilik,0,0,0,,يا صاحب الجلالة، ماذا حدث لك؟
Dialogue: 0,0:05:33.66,0:05:35.69,Default,Spillit,0,0,0,,يتناسب بشكل جيد مع الملابس الملكية.
Dialogue: 0,0:05:35.99,0:05:37.86,Default,Spilik,0,0,0,,لدي ذوق رائع.
Dialogue: 0,0:05:41.60,0:05:42.60,Default,Spilik,0,0,0,,هناك!
Dialogue: 0,0:05:49.68,0:05:50.74,Default,Spilik,0,0,0,,هناك!
Dialogue: 0,0:06:03.38,0:06:04.68,Default,Spillit,0,0,0,,الزواحف الزاحفة.
Dialogue: 0,0:06:11.93,0:06:13.17,Default,Spilik,0,0,0,,نعم!
Dialogue: 0,0:06:14.19,0:06:15.74,Default,Spilik,0,0,0,,لماذا أنت جيد جداً؟
Dialogue: 0,0:06:15.93,0:06:19.47,Default,Spilik,0,0,0,,ربما هذه أجواء وليدة الخبرة؟
Dialogue: 0,0:06:19.97,0:06:21.93,Default,Spilik,0,0,0,,ولدت من تجربة ماذا؟
Dialogue: 0,0:06:21.93,0:06:23.78,Default,Spilik,0,0,0,,أنا رائع في استخدام السكاكين.
Dialogue: 0,0:06:31.28,0:06:32.92,Default,Spilik,0,0,0,,لا تقوم بحركات عديمة الفائدة.
Dialogue: 0,0:06:33.42,0:06:35.59,Default,Spilik,0,0,0,,كم عدد المحاربين الذين يحرسون القصر؟
Dialogue: 0,0:06:40.53,0:06:41.55,Default,Spilik,0,0,0,,لقد تأخرت.
Dialogue: 0,0:06:41.82,0:06:43.75,Default,Spilik,0,0,0,,هذا الصوت يعني بداية التتويج.
Dialogue: 0,0:06:45.60,0:06:47.49,Default,Spilik,0,0,0,,كيف تجرؤ على تحديي؟
Dialogue: 0,0:06:58.28,0:07:00.07,Default,Spilik,0,0,0,,هل بدأ حفل التتويج بعد؟
Dialogue: 0,0:07:04.28,0:07:06.22,Default,Spillit,0,0,0,,انحنِ باحترام
Dialogue: 0,0:07:09.25,0:07:11.01,Default,Spilyk,0,0,0,,أربع مرات
Dialogue: 0,0:07:26.67,0:07:28.56,Default,Split,0,0,0,,واجلس مستقيماً.
Dialogue: 0,0:07:35.44,0:07:36.98,Default,Spilik,0,0,0,,لا أستطيع أن أصدق أنهم بدأوا مبكراً.
Dialogue: 0,0:07:40.68,0:07:42.25,Default,Spilik,0,0,0,,مرحبًا، أريد أن أخبرك بشيء.
Dialogue: 0,0:07:43.01,0:07:46.55,Default,Spilik,0,0,0,,لدي خطة احتياطية.
Dialogue: 0,0:08:18.95,0:08:21.82,Default,Spilik,0,0,0,,ماذا تفعل؟ اسرع واستمر.
Dialogue: 0,0:08:22.73,0:08:23.82,Default,Spilik,0,0,0,,الأمر هو،
Dialogue: 0,0:08:25.99,0:08:28.49,Default,Spilik,0,0,0,,أن الختم الملكي مفقود!
Dialogue: 0,0:08:35.68,0:08:37.57,Default,Spillit,0,0,0,,لا يوجد ختم ملكي!
Dialogue: 0,0:09:00.12,0:09:01.60,Default,Spilik,0,0,0,,لابد أنني مجنون.
Dialogue: 0,0:09:02.36,0:09:05.93,Default,Spilik,0,0,0,,أو فقد رأسه لأن هذه مهمة خاصة.
Dialogue: 0,0:09:09.24,0:09:10.63,Default,Spillie,0,0,0,,ارفع رأسك.
Dialogue: 0,0:09:11.34,0:09:14.68,Default,Spilik,0,0,0,,تحياتي لك...
Dialogue: 0,0:09:17.51,0:09:18.51,Default,Spillit,0,0,0,,جلالتك؟
Dialogue: 0,0:09:21.24,0:09:22.49,Default,Spilik,0,0,0,,لي سينمان.
Dialogue: 0,0:09:22.79,0:09:25.93,Default,Spilik,0,0,0,,أنت لي سينمان.\NAهل أنت مجنون تماماً؟
Dialogue: 0,0:09:26.43,0:09:27.68,Default,Spilik,0,0,0,,أم أنني مجنون؟
Dialogue: 0,0:09:32.56,0:09:34.17,Default,Spillit,0,0,0,,هل سرقت الختم الملكي؟
Dialogue: 0,0:09:34.96,0:09:36.46,Default,Spilik,0,0,0,,أنا مجنون قليلاً.
Dialogue: 0,0:09:37.27,0:09:39.27,Default,Spilik,0,0,0,,لذا لا تزال لدينا فرصة.
Dialogue: 0,0:09:51.57,0:09:53.44,Default,Spillit,0,0,0,,-لنذهب.\N-إلى الأمام.
Dialogue: 0,0:10:00.22,0:10:02.05,Default,Spilik,0,0,0,,آخر مرة نجح الأمر معي.
Dialogue: 0,0:10:02.05,0:10:04.00,Default,Spilyk,0,0,0,,-حاول.\N-Hush.
Dialogue: 0,0:10:04.03,0:10:05.46,Default,Spilik,0,0,0,,لماذا أنت...
Dialogue: 0,0:10:10.59,0:10:11.73,Default,Spilik,0,0,0,,حضرة.
Dialogue: 0,0:10:15.73,0:10:16.97,Default,Spilik,0,0,0,,أنت مرة أخرى؟
Dialogue: 0,0:10:16.97,0:10:18.41,Default,Spilik,0,0,0,,قلت لك ألا تأتي!
Dialogue: 0,0:10:18.54,0:10:19.75,Default,Spilik,0,0,0,,فقط لأجلي
Dialogue: 0,0:10:20.25,0:10:22.71,Default,Spilik,0,0,0,,لا أحد آخر ليسأل.
Dialogue: 0,0:10:25.68,0:10:30.89,Default,Spillie,0,0,0,,طلبت مني الملكة أن أسرق شيئاً لها.
Dialogue: 0,0:10:40.87,0:10:42.83,Default,Spillie,0,0,0,,هذا العنصر المشرق والمكلف
Dialogue: 0,0:10:42.83,0:10:44.83,Default,Spilik,0,0,0,,يبدو مشؤوماً.
Dialogue: 0,0:10:45.00,0:10:46.17,Default,Spilik,0,0,0,,ما هذا؟
Dialogue: 0,0:10:47.83,0:10:49.60,Default,Spillit,0,0,0,,الختم الملكي.
Dialogue: 0,0:10:50.54,0:10:51.54,Default,Spilik,0,0,0,,هل تفكر،
Dialogue: 0,0:10:52.91,0:10:55.28,Default,Spilyk,0,0,0,,أين ظهرت بخاتم مسروق؟
Dialogue: 0,0:10:55.38,0:10:56.68,Default,Spilik,0,0,0,,هذا هو قسم المباحث.
Dialogue: 0,0:11:01.02,0:11:04.29,Default,Spilik,0,0,0,,هل أتيت إلى السجن طوعاً؟
Dialogue: 0,0:11:08.90,0:11:10.09,Default,Spillie,0,0,0,,لماذا تعطيني إياها؟
Dialogue: 0,0:11:14.09,0:11:15.50,Default,Spilik,0,0,0,,ماذا تفعل هنا؟
Dialogue: 0,0:11:15.80,0:11:18.04,Default,Spilik,0,0,0,,جئت لرؤية صديق.
Dialogue: 0,0:11:18.23,0:11:20.70,Default,Spilik,0,0,0,,لا يمكنك أن تكون هنا. غادر على الفور.
Dialogue: 0,0:11:21.17,0:11:22.18,Default,Spillit,0,0,0,,انتظر!
Dialogue: 0,0:11:23.78,0:11:26.28,Default,Spilik,0,0,0,,كيف تجرؤ على الاستيلاء على صديقي المفضل؟
Dialogue: 0,0:11:31.38,0:11:32.55,Default,Spilik,0,0,0,,هل فقدت عقلك؟
Dialogue: 0,0:11:32.68,0:11:34.15,Default,Spilik,0,0,0,,لماذا أظهرت الختم الملكي؟
Dialogue: 0,0:11:35.55,0:11:36.79,Default,Spillit,0,0,0,,الختم الملكي؟
Dialogue: 0,0:11:37.39,0:11:38.81,Default,Spillie,0,0,0,,هل تريد النظر إليه؟
Dialogue: 0,0:11:45.32,0:11:47.56,Default,Spilik,0,0,0,,-إنها قنبلة!\N-Run!
Dialogue: 0,0:13:02.43,0:13:05.30,Default,Biryulka,0,0,0,,لقد مروا بجميع أبواب العاصمة؟
Dialogue: 0,0:13:05.30,0:13:07.51,Default,Spilik,0,0,0,,نعم. إذا أمرتنا باستخدام الأسلحة...
Dialogue: 0,0:13:07.51,0:13:10.78,Default,Spilik,0,0,0,,الآن الأهم هو إكمال مراسم التتويج،
Dialogue: 0,0:13:10.78,0:13:12.07,Default,Spilik,0,0,0,,علينا أن ننتظر بعض الوقت مع الأسلحة.
Dialogue: 0,0:13:12.68,0:13:15.52,Default,Spilik,0,0,0,,وأرسل حراسًا إلى جميع البوابات.
Dialogue: 0,0:13:15.52,0:13:16.68,Default,Spillit,0,0,0,,أسرع!
Dialogue: 0,0:13:20.48,0:13:22.82,Default,Spillit,0,0,0,,بمجرد انتهاء الحفل،
Dialogue: 0,0:13:24.32,0:13:26.37,Default,Spilik,0,0,0,,سوف أتخلص منهم.
Dialogue: 0,0:13:28.46,0:13:31.93,Default,Spilik,0,0,0,,كيف يمكننا مواصلة الحفل بدون الختم الملكي؟
Dialogue: 0,0:13:32.23,0:13:34.73,Default,Spilik,0,0,0,,يا إلهي، كيف يمكن أن يحدث هذا؟
Dialogue: 0,0:13:35.93,0:13:38.28,Default,Spilik,0,0,0,,ماذا تفعل بحق الجحيم؟
Dialogue: 0,0:13:38.64,0:13:41.75,Default,Spilik,0,0,0,,لماذا لا فائدة منك؟
Dialogue: 0,0:13:49.66,0:13:50.76,Default,Spilik,0,0,0,,ما الأمر؟
Dialogue: 0,0:13:54.35,0:13:55.39,Default,Spilik,0,0,0,,وماذا في ذلك؟
Dialogue: 0,0:13:55.39,0:13:58.35,Default,Spilyk,0,0,0,,لا يمكننا الهجوم الآن
Dialogue: 0,0:13:58.35,0:14:00.06,Default,Spilik,0,0,0,,بسبب دخان لاذع غير معروف.
Dialogue: 0,0:14:01.63,0:14:03.50,Default,Spilik,0,0,0,,وبما أن الحفل يجب أن ينتهي بنجاح،
Dialogue: 0,0:14:03.50,0:14:06.73,Default,Spilik,0,0,0,,أرسلت حراسًا إلى البوابة لإيقافهم.
Dialogue: 0,0:14:08.80,0:14:10.64,Default,Spilik,0,0,0,,تكتيكات خادعة.
Dialogue: 0,0:14:10.73,0:14:11.73,Default,Spilik,0,0,0,,ما هذا؟
Dialogue: 0,0:14:13.94,0:14:15.01,Default,Spilik,0,0,0,,لا شيء.
Dialogue: 0,0:14:15.10,0:14:17.12,Default,Spilik,0,0,0,,سأحضر الختم الملكي بنفسي.
Dialogue: 0,0:14:19.52,0:14:21.48,Default,Spilik,0,0,0,,استدعاء جميع الحراس على الفور للعودة إلى القصر.
Dialogue: 0,0:14:22.15,0:14:23.81,Default,Spilik,0,0,0,,-ماذا؟\N-ألا تسمع؟
Dialogue: 0,0:14:24.68,0:14:25.72,Default,Spilik,0,0,0,,نعم.
Dialogue: 0,0:14:38.54,0:14:39.93,Default,Spilik,0,0,0,,الجو هادئ للغاية هنا.
Dialogue: 0,0:14:41.37,0:14:43.23,Default,Spilik,0,0,0,,يبدو أن كل شيء يسير حسب الخطة.
Dialogue: 0,0:14:46.84,0:14:48.44,Default,Spilik,0,0,0,,لقد قطعنا هذا الطريق.
Dialogue: 0,0:14:57.05,0:14:58.12,Default,Spilik,0,0,0,,هل أنت خائف؟
Dialogue: 0,0:14:58.95,0:15:00.93,Default,Spilik,0,0,0,,نعم وأنا أيضاً
Dialogue: 0,0:15:01.85,0:15:03.00,Default,Spilik,0,0,0,,suppressed.
Dialogue: 0,0:15:03.13,0:15:05.53,Default,Spilik,0,0,0,,بالضبط. هذا هو ما تشعر به
Dialogue: 0,0:15:05.53,0:15:07.59,Default,Spilik,0,0,0,,قبل قتال الزعيم في اللعبة.
Dialogue: 0,0:15:08.63,0:15:10.83,Default,Spilik,0,0,0,,صحيح. رئيس.
Dialogue: 0,0:15:10.83,0:15:13.37,Default,Spilik,0,0,0,,إذا مت قبل أن تهزمه، ستلعن كل شيء في العالم،
