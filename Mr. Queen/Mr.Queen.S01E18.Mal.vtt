Dialog: 0,0:00:58.00,0:01:03.98,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДДСТЕ
Dialog: 0,0:00:58.00,0:01:03.98, Lalai,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807}\fscy2007 92 38 l 0 38
Dialog: 0,0:00:58.00,0:01:03.98,berfungsi,,0,0,0,,{\pos(801,256)}Mengusahakan siri:\N Lily, Tiramisu, Biryulka, Hos, Nanas
Dialog: 0,0:00:58.00,0:01:03.98,tajuk,,0,0,0,,{\fscx75\fscy75\pos(846,392)}Bagaimana saya menjadi
Dialog: 0,0:00:58.00,0:01:03.98,nama,,0,0,0,,{\fscx75\fscy75\pos(848,456)}ratu
Dialog: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialog: 0,0:01:04.09,0:01:06.37, Lalai, nanas 1,0,0,0,,Semua watak adalah rekaan,
Dialog: 0,0:01:06.37,0:01:08.54, Lalai, nanas 1,0,0,0, dan acara yang ditunjukkan adalah fiksyen.
Dialog: 0,0:01:10.32,0:01:13.13, Lalai, nanas 1,0,0,0,,18 episod
Dialog: 0,0:01:14.74,0:01:15.81, Lalai, nanas 1,0,0,0,, Tunggu!
Dialog: 0,0:01:16.41,0:01:17.71, Lalai, nanas 1,0,0,0,, Berhenti!
Dialog: 0,0:01:24.01,0:01:25.08,Lalai,nanas 1,0,0,0,,Jom.
Dialog: 0,0:01:27.72,0:01:30.79, Lalai, nanas 1,0,0,0,, Berhenti! Tunggu!
Dialog: 0,0:01:37.09,0:01:38.13, Lalai, nanas 1,0,0,0,,Kenapa?
Dialog: 0,0:01:47.74,0:01:49.81, Lalai, nanas 1,0,0,0,,Adakah raja datang kepada saya semasa saya sedang tidur?
Dialog: 0,0:01:50.41,0:01:51.68, Lalai, nanas 1,0,0,0,,Ya, Tuanku.
Dialog: 0,0:01:52.48,0:01:53.71, Lalai, nanas 1,0,0,0,,Itu bukan mimpi.
Dialog: 0,0:01:54.44,0:01:56.68, Lalai, nanas 1,0,0,0,,Tetapi kenapa dia berkelakuan begini?
Dialog: 0,0:01:56.68,0:01:57.95, Lalai, nanas 1,0,0,0,,Seolah-olah seseorang mengejarnya.
Dialog: 0,0:01:59.28,0:02:01.42,Lalai,nanas 1,0,0,0,,Donghak menjadi semakin berpengaruh.
Dialog: 0,0:02:03.12,0:02:04.86, Lalai, nanas 1,0,0,0,,Saya faham, tetapi masih...
Dialog: 0,0:02:05.02,0:02:06.99,Lalai,nanas 1,0,0,0,,Jangan risau, Yang Mulia.
Dialog: 0,0:02:07.36,0:02:10.13, Lalai, nanas 1,0,0,0,,Betul, raja akan kembali tidak lama lagi.
Dialog: 0,0:02:11.23,0:02:12.26, Lalai, nanas 1,0,0,0,, Okay.
Dialog: 0,0:02:13.23,0:02:15.50,Lalai,nanas 1,0,0,0,,Mesti ada sebab mengapa dia pergi begitu cepat.
Dialog: 0,0:02:17.67,0:02:19.44, Lalai, nanas 1,0,0,0,,Pastikan semuanya baik-baik saja,\Nand kembali.
Dialog: 0,0:02:19.74,0:02:22.64,Lalai,nanas 1,0,0,0,,Sudah tentu, lebih baik pergi dengan cepat daripada menunggu sehingga saya datang untuk mengucapkan selamat tinggal kepadanya.
Dialog: 0,0:02:23.57,0:02:25.44, Lalai, nanas 1,0,0,0,,Itulah sebabnya dia pergi tanpa amaran.
Dialog: 0,0:02:36.92,0:02:39.59, Lalai, nanas 1,0,0,0,,Takhta ini kini mempunyai pemilik baharu.
Dialog: 0,0:02:41.09,0:02:43.49, Lalai, nanas 1,0,0,0,, Anda boleh memikirkannya dengan segera.
Dialog: 0,0:02:43.86,0:02:46.66, Lalai, nanas 1,0,0,0,,Semuanya kerana ratu membuat pilihan yang tepat.
Dialog: 0,0:02:49.00,0:02:50.10, Lalai, nanas 1,0,0,0,, Ratu?
Dialog: 0,0:02:50.43,0:02:52.20,Lalai,nanas 1,0,0,0,,Demi anak anda
Dialog: 0,0:02:52.20,0:02:54.74, Lalai, nanas 1,0,0,0,,dia berpihak kepada keluarga, bukan raja.
Dialog: 0,0:02:55.71,0:02:58.24,Lalai,nanas 1,0,0,0,,Jika ya, maka demi pewaris takhta
Dialog: 0,0:02:59.88,0:03:02.35, Lalai, nanas 1,0,0,0,,Saya akan menutup mata saya terhadap dosa permaisuri.
Dialog: 0,0:03:04.98,0:03:09.02,Lalai,nanas 1,0,0,0,,Saya akan pastikan anda tidak perlu risau untuk berebut takhta lagi.
Dialog: 0,0:05:21.55,0:05:23.09, Lalai, nanas 1,0,0,0,, Berputus asa.
Dialog: 0,0:06:09.03,0:06:10.40,Lalai,nanas 1,0,0,0,,Saya mahukan lagi.
Dialog: 0,0:06:12.37,0:06:14.37, Lalai, nanas 1,0,0,0,, Adakah anda tidak makan banyak?
Dialog: 0,0:06:14.91,0:06:17.07, Lalai, nanas 1,0,0,0,,Seseorang membiasakan diri dengan segala-galanya.
Dialog: 0,0:06:17.07,0:06:19.28, Lalai, nanas 1,0,0,0,,Makanan dulu hambar,
Dialog: 0,0:06:19.28,0:06:20.64, Lalai, nanas 1,0,0,0,, tetapi sekarang saya menyukainya.
Dialog: 0,0:06:20.78,0:06:22.45, Lalai, nanas 1,0,0,0,, Tidak kira berapa banyak kita makan, kita tidak boleh kenyang.
Dialog: 0,0:06:22.45,0:06:24.11,Lalai,nanas 1,0,0,0,,Sebaliknya, rasa lapar semakin teruk.
Dialog: 0,0:06:25.15,0:06:26.88, Lalai, nanas 1,0,0,0,, Putera Kecil seorang pelahap.
Dialog: 0,0:06:36.43,0:06:38.26, Lalai, nanas 1,0,0,0,, Okay. Saya tidak akan melakukannya lagi.
Dialog: 0,0:06:38.26,0:06:40.70, Lalai, nanas 1,0,0,0,,Semuanya baik dengan saya.\NMengapa awak kelihatan seperti itu?
Dialog: 0,0:06:41.70,0:06:44.77, Lalai, nanas 1,0,0,0,,Anda perlu berjalan-jalan.\NI bagus untuk penghadaman.
Dialog: 0,0:06:45.87,0:06:47.17, Lalai, nanas 1,0,0,0,,Tetapi saya akan selesaikan dahulu.
Dialog: 0,0:07:00.58,0:07:02.55, Lalai, nanas 1,0,0,0,,Cuacanya teruk.
Dialog: 0,0:07:05.69,0:07:07.46, Lalai, nanas 1,0,0,0,,Saya ingin mengambil gambar dan meletakkannya dalam bingkai dan menggantungnya di dinding.
Dialog: 0,0:07:09.59,0:07:11.29, Lalai, nanas 1,0,0,0,, Masih belum terlambat untuk diselesaikan
Dialog: 0,0:07:11.60,0:07:13.23, Lalai, nanas 1,0,0,0,,semua salah faham.
Dialog: 0,0:07:14.30,0:07:15.87,Lalai,nanas 1,0,0,0,,Mari kita hidup seperti yang anda mahukan.
Dialog: 0,0:07:17.80,0:07:18.87, Lalai, nanas 1,0,0,0,,Jarak sosial.
Dialog: 0,0:07:20.27,0:07:22.64, Lalai, nanas 1,0,0,0,, Anda adalah anti-peminat sebenar saya.
Dialog: 0,0:07:23.97,0:07:27.48,Lalai,nanas 1,0,0,0,,Saya bimbang, tetapi sekarang saya menemui jalan keluar.
Dialog: 0,0:07:27.48,0:07:28.91, Lalai, nanas 1,0,0,0,, Jadi jangan sayang saya.
Dialog: 0,0:07:28.91,0:07:30.78, Lalai, nanas 1,0,0,0,,Tetapi saya masih menyukainya.
Dialog: 0,0:07:30.78,0:07:33.85, Lalai, nanas 1,0,0,0,, Dan saya akan suka, biarkan anda mempunyai
Dialog: 0,0:07:34.62,0:07:36.12, Lalai, nanas 1,0,0,0,,semua kekurangan dunia.
Dialog: 0,0:07:38.19,0:07:39.72, Lalai, nanas 1,0,0,0,,Saya tidak boleh tidak berfikir tentang dia!
Dialog: 0,0:07:39.96,0:07:41.56, Lalai, nanas 1,0,0,0,,Tempat yang mengerikan! Jom pergi cepat!
Dialog: 0,0:07:41.56,0:07:42.59,Lalai,nanas 1,0,0,0,,-Yang Mulia!\N-Yang Mulia!
Dialog: 0,0:07:46.16,0:07:47.46, Lalai, nanas 1,0,0,0,, Hampir tidak berjaya.
Dialog: 0,0:07:48.10,0:07:50.20, Lalai, nanas 1,0,0,0,,Bukan tasik, tetapi jurang kenangan.
Dialog: 0,0:08:02.18,0:08:05.25,Lalai,nanas 1,0,0,0,,Maka hari ini adalah hari pertama kami.
Dialog: 0,0:08:05.95,0:08:07.28, Lalai, nanas 1,0,0,0,,Saya mencadangkan satu pakatan.
Dialog: 0,0:08:10.59,0:08:11.76, Lalai, nanas 1,0,0,0,, Okay.
Dialog: 0,0:08:13.92,0:08:17.13, Lalai, nanas 1,0,0,0,,Tiada penjarakan sosial mulai sekarang.
Dialog: 0,0:08:26.44,0:08:27.90, Lalai, nanas 1,0,0,0,, Sial.
Dialog: 0,0:08:28.74,0:08:31.37, Lalai, nanas 1,0,0,0,,Ya, seluruh istana ini adalah satu ingatan yang berterusan.
Dialog: 0,0:08:33.78,0:08:35.55, Lalai, nanas 1,0,0,0,,Mengapa terdapat begitu sedikit orang?
Dialog: 0,0:08:36.45,0:08:38.25, Lalai, nanas 1,0,0,0,, Berapa lamakah istana itu menjadi begitu besar?
Dialog: 0,0:08:46.65,0:08:49.95,Lalai,nanas 1,0,0,0,,Memories Strike Back
Dialog: 0,0:08:52.90,0:08:54.26,Lalai,nanas 1,0,0,0,,Yang Mulia.
Dialog: 0,0:09:01.27,0:09:04.74,Lalai,nanas 1,0,0,0,,Yang Mulia,\NMenteri Perang telah datang kepada anda.
Dialog: 0,0:09:07.21,0:09:09.28, Lalai, nanas 1,0,0,0,,Saya tidak jumpa awak dalam bilik awak.
Dialog: 0,0:09:12.15,0:09:14.28, Lalai, nanas 1,0,0,0,,Adakah sesuatu berlaku kepada raja?
Dialog: 0,0:09:14.68,0:09:15.75, Lalai, nanas 1,0,0,0,,No.
Dialog: 0,0:09:20.96,0:09:23.26, Lalai, nanas 1,0,0,0,, Anda berdarah!
Dialog: 0,0:09:25.40,0:09:26.73, Lalai, nanas 1,0,0,0,, Cederakan diri anda di suatu tempat?
Dialog: 0,0:09:27.06,0:09:30.53, Lalai, nanas 1,0,0,0,, Hanya kecederaan kecil\Selepas latihan.
Dialog: 0,0:09:31.84,0:09:34.77, Lalai, nanas 1,0,0,0,,Saya tahu sudah lewat,\Ntetapi saya datang untuk mengucapkan tahniah atas kehamilan anda.
Dialog: 0,0:09:36.64,0:09:37.84, Lalai, nanas 1,0,0,0,, Terima kasih.
Dialog: 0,0:09:37.84,0:09:41.34, Lalai, nanas 1,0,0,0,, Jangan fikir untuk menyertai semula klan
Dialog: 0,0:09:41.34,0:09:44.05, Lalai, nanas 1,0,0,0,,untuk kesejahteraan anak anda?
Dialog: 0,0:09:45.35,0:09:47.22, Lalai, nanas 1,0,0,0,,Saya fikir kita telah membincangkan semuanya kali terakhir.
Dialog: 0,0:09:47.65,0:09:49.79, Lalai, nanas 1,0,0,0,,Saya tidak kisah anda meninggalkan saya.
Dialog: 0,0:09:50.72,0:09:52.86, Lalai, nanas 1,0,0,0,,Saya masih tidak akan meninggalkan anda sepenuhnya tanpa bantuan.
Dialog: 0,0:09:53.09,0:09:54.32, Lalai, nanas 1,0,0,0,,Anda dan diri sendiri
Dialog: 0,0:09:55.13,0:09:57.99, Lalai, nanas 1,0,0,0,, anda tahu bahawa anda tidak boleh mengatasi seorang diri di istana.
Dialog: 0,0:09:59.63,0:10:02.90, Lalai, nanas 1,0,0,0,,Terima kasih atas nasihat, tetapi saya tidak bersendirian.
Dialog: 0,0:10:03.73,0:10:05.27, Lalai, nanas 1,0,0,0,,Dan anda tahu perkara ini dengan baik.
Dialog: 0,0:10:06.27,0:10:08.44, Lalai, nanas 1,0,0,0,,Jika anda memerlukan bantuan,
Dialog: 0,0:10:08.44,0:10:10.31, Lalai, nanas 1,0,0,0,,Saya sentiasa bersedia untuk menghulurkan tangan saya.
Dialog: 0,0:10:10.57,0:10:12.48, Lalai, nanas 1,0,0,0,,Untuk anda dan anak anda
Dialog: 0,0:10:13.01,0:10:15.45, Lalai, nanas 1,0,0,0,,Saya akan lakukan apa sahaja.
Dialog: 0,0:10:28.73,0:10:31.83, Lalai, nanas 1,0,0,0,,Baru-baru ini\Nkemarahan popular telah meningkat.
Dialog: 0,0:10:32.23,0:10:35.13,Lalai,nanas 1,0,0,0,,Berita sampai kepada saya tentang pemberontakan petani,
Dialog: 0,0:10:35.63,0:10:39.27,Lalai,nanas 1,0,0,0,,Saya berhasrat untuk secara peribadi\Nmenyiasat keadaan di negara ini.
Dialog: 0,0:10:40.04,0:10:43.27, Lalai, nanas 1,0,0,0,,Semua yang berkaitan dengan orang adalah penting,\Nand sementara saya tiada di sini,
Dialog: 0,0:10:44.07,0:10:46.64, Lalai, nanas 1,0,0,0,,anda mesti mematuhi\Nperintah Ratu Janda.
Dialog: 0,0:10:46.94,0:10:50.45,Lalai,nanas 1,0,0,0,,Ini adalah titah raja.
Dialog: 0,0:10:55.45,0:10:59.69,Lalai,nanas 1,0,0,0,,Oleh kerana saya kini menggantikan raja dalam jawatan, saya akan menggantikan beberapa pegawai,
Dialog: 0,0:10:59.92,0:11:02.19, Lalai, nanas 1,0,0,0,,untuk melaksanakan perintahnya dengan betul.
Dialog: 0,0:11:02.46,0:11:03.93,Lalai,nanas 1,0,0,0,,Kim Seokkeun akan kembali
Dialog: 0,0:11:03.93,0:11:05.43, Lalai, nanas 1,0,0,0,,pada siaran anda,
Dialog: 0,0:11:05.80,0:11:07.66, Lalai, nanas 1,0,0,0,, dan bekas Menteri Perang Kim Changhyup
Dialog: 0,0:11:07.66,0:11:09.57,Lalai,nanas 1,0,0,0,,akan menggantikan ketua pengawal diraja.
Dialog: 0,0:11:10.03,0:11:12.20,Lalai,nanas 1,0,0,0,,Putera Yeonpyeong, yang memegang jawatan ini,
Dialog: 0,0:11:12.20,0:11:15.31,Lalai,nanas 1,0,0,0,,fokus\Bukan tugasnya sebagai ketua Ijeongcheon.
Dialog: 0,0:11:37.96,0:11:40.43,Lalai,nanas 1,0,0,0,,Raja telah memulakan jalan yang sukar.
Dialog: 0,0:11:41.26,0:11:45.07,Lalai,nanas 1,0,0,0,,Jika seseorang cuba\Nmencemarkan nama baiknya,
Dialog: 0,0:11:45.70,0:11:49.61, Lalai, nanas 1,0,0,0,,orang ini harus\Ntakut akan keselamatan bahasanya.
Dialog: 0,0:12:24.21,0:12:25.38,Lalai,nanas 1,0,0,0,,Bayi,
Dialog: 0,0:12:26.48,0:12:27.74, Lalai, nanas 1,0,0,0,, awak sangat comel.
Dialog: 0,0:12:30.55,0:12:31.95,Lalai,nanas 1,0,0,0,,Dalam kehidupan ini
Dialog: 0,0:12:32.25,0:12:33.65,Lalai,nanas 1,0,0,0,,jangan menafikan diri sendiri apa-apa.
Dialog: 0,0:12:41.09,0:12:44.53,Lalai,nanas 1,0,0,0,,Surat tulisan tangan hanyalah perkara\Nuntuk menenangkan hati yang memberontak.
Dialog: 0,0:12:50.47,0:12:52.97,Lalai,nanas 1,0,0,0,,Baby, adakah kamu juga merindui ayah?
Dialog: 0,0:12:53.24,0:12:55.07,Lalai,nanas 1,0,0,0,,Kata: “Ayah, balik segera!”
Dialog: 0,0:12:57.04,0:12:59.64, Lalai, nanas 1,0,0,0,,Adakah ia benar-benar menyepak? Adakah ini cara anda menjawab saya?
Dialog: 0,0:13:00.71,0:13:02.51, Lalai, nanas 1,0,0,0,,Bukankah buah itu bergerak terlalu awal?
Dialog: 0,0:13:02.51,0:13:03.71, Lalai, nanas 1,0,0,0,, Sangat awal.
Dialog: 0,0:13:05.75,0:13:07.08,Lalai,nanas 1,0,0,0,,Adakah kanak-kanak itu genius?
Dialog: 0,0:13:07.62,0:13:10.32, Lalai, nanas 1,0,0,0,,Ya Tuhanku! Saya akan melahirkan seorang genius!
Dialog: 0,0:13:12.26,0:13:14.72, Lalai, nanas 1,0,0,0,, Dan kenapa saya sangat gembira?
Dialog: 0,0:13:20.06,0:13:21.10,Lalai,nanas 1,0,0,0,,Yang Mulia.
Dialog: 0,0:13:21.93,0:13:25.50, Lalai, nanas 1,0,0,0,,Sesuatu memberitahu saya\Nbahawa ini akan menjadi mimpi ngeri.
Dialog: 0,0:13:25.84,0:13:27.60,Lalai,nanas 1,0,0,0,,Saya akan menjadi ibu bapa yang teruk,
Dialog: 0,0:13:27.60,0:13:30.37, Lalai, nanas 1,0,0,0,, persilangan yang mengerikan antara ayah penyayang dan ibu gila.
Dialog: 0,0:13:30.64,0:13:32.34, Lalai, nanas 1,0,0,0,,Anak anda sangat berharga.
Dialog: 0,0:13:32.34,0:13:34.21, Lalai, nanas 1,0,0,0,, Tidak pernah terlalu berhati-hati.
Dialog: 0,0:13:34.51,0:13:38.18,Lalai,nanas 1,0,0,0,,Saya pasti bayi itu akan sama seperti anda...
Dialog: 0,0:13:38.92,0:13:40.88, Lalai, nanas 1,0,0,0,,Apakah jenis seram yang anda cakapkan?
Dialog: 0,0:13:41.15,0:13:42.22,Lalai,nanas 1,0,0,0,,Apa?
Dialog: 0,0:13:43.02,0:13:46.82,Lalai,nanas 1,0,0,0,,Kenapa, jika anak saya seperti saya, adakah ia mengerikan?
Dialog: 0,0:13:46.82,0:13:49.29, Lalai, nanas 1,0,0,0,, Masa untuk mengambil ubat, Yang Mulia.
Dialog: 0,0:13:56.87,0:13:58.47, Lalai, nanas 1,0,0,0,, Ke bawah.
Dialog: 0,0:13:59.07,0:14:00.80, Lalai, nanas 1,0,0,0,, Itu sahaja.
Dialog: 0,0:14:01.57,0:14:03.71,Lalai,nanas 1,0,0,0,,Baginda memanggil kanak-kanak itu miliknya.
Dialog: 0,0:14:07.98,0:14:09.78, Lalai, nanas 1,0,0,0,, Itu sahaja.
Dialog: 0,0:14:19.89,0:14:21.99, Lalai, nanas 1,0,0,0,, Dan apakah yang mereka campurkan dalam air rebusan mereka?
Dialog: 0,0:14:23.29,0:14:26.63, Lalai, nanas 1,0,0,0,,Ubat ini pastinya menentang keguguran,\Nad bukan untuk demensia?
Dialog: 0,0:14:29.40,0:14:32.34, Lalai, nanas 1,0,0,0,, Seram! Apakah jenis serangan mental ini?\NMengapa saya terus memikirkannya?
Dialog: 0,0:14:34.20,0:14:36.54, Lalai, nanas 1,0,0,0,,Segala-galanya di istana mengingatkan dia.
Dialog: 0,0:14:52.89,0:14:56.06,Lalai,nanas 1,0,0,0,,Raja kami ialah Cheoljong,\Di sini saya menyulam CJ.
Dialog: 0,0:14:56.43,0:14:59.00, Lalai, nanas 1,0,0,0,,Adakah anda benar-benar menyulam ini hanya dalam satu malam?
Dialog: 0,0:14:59.16,0:15:01.16, Lalai, nanas 1,0,0,0,,Ia sentiasa menarik\Napa yang semua orang temui dalam sulaman.
Dialog: 0,0:15:01.16,0:15:03.40, Lalai, nanas 1,0,0,0,, Semasa tangan saya sibuk, kepala saya kosong daripada fikiran.
Dialog: 0,0:15:03.40,0:15:04.47,Lalai,nanas 1,0,0,0,,Saya sukakannya.
Dialog: 0,0:15:05.03,0:15:06.84, Lalai, nanas 1,0,0,0,,Anda adalah seorang tukang.
Dialog: 0,0:15:07.20,0:15:08.71, Lalai, nanas 1,0,0,0,, Sangat cantik.
Dialog: 0,0:15:08.71,0:15:11.07, Lalai, nanas 1,0,0,0,,Ini sutera dari Jinju, Gyeongsangnam-do.
Dialog: 0,0:15:11.07,0:15:12.81, Lalai, nanas 1,0,0,0,,Saya fikir, pada hari berangin
Dialog: 0,0:15:12.81,0:15:14.64,Lalai,nanas 1,0,0,0,,perkara terbaik untuk dipakai ialah selendang.
Dialog: 0,0:15:14.98,0:15:17.85,Lalai,nanas 1,0,0,0,,Saya pasti Duli Yang Maha Mulia\Nakan menyukai pemberian anda.
Dialog: 0,0:15:18.95,0:15:21.15, Lalai, nanas 1,0,0,0,, Ini satu lagi selendang untuk saya.
Dialog: 0,0:15:22.22,0:15:24.52,Lalai,nanas 1,0,0,0,,Semua otot menjadi kaku kerana duduk lama.
Dialog: 0,0:15:25.66,0:15:27.92, Lalai, nanas 1,0,0,0,, Adakah anda ingin bermain sesuatu yang menyeronokkan?
Dialog: 0,0:15:28.49,0:15:29.89,Lalai,nanas 1,0,0,0,,-Sudah tentu Tuanku!\N-Sudah tentu Tuanku!
Dialog: 0,0:15:30.89,0:15:32.13,Lalai,nanas 1,0,0,0,,Ketua Kasim
Dialog: 0,0:15:37.23,0:15:38.67, Lalai, nanas 1,0,0,0,,Saya tahu! Raja!
Dialog: 0,0:15:42.14,0:15:43.41,Lalai,Spilyk2,0,0,0,,Di sana.
Dialog: 0,0:15:43.87,0:15:44.91,Lalai,Spillik2,0,0,0,,Ketua Kasim?
Dialog: 0,0:15:45.58,0:15:48.11,Lalai,Spikyulka2,0,0,0,,Ya, ada seorang ketua sida yang berkhidmat kepada raja.
Dialog: 0,0:15:48.58,0:15:50.78,Lalai,Spikyulka2,0,0,0,,Ya, ini jawapannya - ketua sida-sida.
Dialog: 0,0:15:54.15,0:15:56.39,Lalai,Spillik2,0,0,0,,Jadi, maksudnya? Tidak faham.
Dialog: 0,0:15:57.09,0:15:58.09,Lalai,Spillik2,0,0,0,,Seterusnya.
Dialog: 0,0:15:58.45,0:16:00.69,Lalai,Spillik2,0,0,0,,Harimau.
Dialog: 0,0:16:00.69,0:16:01.72,Lalai,Spillik2,0,0,0,,Raja!
Dialog: 0,0:16:01.72,0:16:02.79,Lalai,Spillit2,0,0,0,,Monyet.
Dialog: 0,0:16:02.79,0:16:03.79,Lalai,Spillik2,0,0,0,,Raja.
Dialog: 0,0:16:03.79,0:16:04.96,Lalai,Spillit2,0,0,0,,Arnab.
Dialog: 0,0:16:04.96,0:16:06.00,Lalai,Spillik2,0,0,0,,Raja.
Dialog: 0,0:16:06.00,0:16:08.23,Lalai,Spillie2,0,0,0,,Anjing.
Dialog: 0,0:16:11.23,0:16:13.30,Lalai,Spilyk2,0,0,0,,Ini agak mudah.
Dialog: 0,0:16:13.30,0:16:15.41,Lalai,Spillik2,0,0,0,,Merengek seperti anak anjing yang ditinggalkan.
Dialog: 0,0:16:15.91,0:16:16.94,Lalai,Spillik2,0,0,0,,Raja?
Dialog: 0,0:16:18.88,0:16:19.91,Lalai,Spillik2,0,0,0,,Yang Mulia.
Dialog: 0,0:16:20.88,0:16:23.51,Lalai,Spikyulka2,0,0,0,,Adakah anda begitu merinduinya?
Dialog: 0,0:16:24.71,0:16:26.78,Lalai,Spillik2,0,0,0,,Hubungan tinggi.
Dialog: 0,0:16:29.42,0:16:31.62,Lalai,Spillik2,0,0,0,,Tiada seperti itu. Jangan berlebih-lebihan.
Dialog: 0,0:16:31.89,0:16:32.96,Lalai,Spikyulka2,0,0,0,,Tuhan, apa yang kamu lakukan?
Dialog: 0,0:16:33.52,0:16:36.13,Lalai,Spillik2,0,0,0,,Entah bagaimana ia tidak menyeronokkan. Beri saya jarum dan benang.
Dialog: 0,0:16:41.93,0:16:44.23,Lalai,Spillik2,0,0,0,,Ratu, awak okay?
Dialog: 0,0:16:44.87,0:16:45.87,Lalai,Spillik2,0,0,0,,No.
Dialog: 0,0:16:47.87,0:16:49.14,Lalai,Spillik2,0,0,0,,Tidak sama sekali.
Dialog: 0,0:16:50.01,0:16:51.61, Lalai,Spillik2,0,0,0,,Ini sangat menyakitkan.
Dialog: 0,0:16:53.01,0:16:55.41, Lalai, Spikyulka2,0,0,0,,Bagaimanakah jarum nipis boleh menyakitkan?
Dialog: 0,0:16:58.51,0:17:00.42,Lalai,Spillik2,0,0,0,,Semuanya kerana hormon.
Dialog: 0,0:17:01.25,0:17:02.35,Lalai,Spilyk2,0,0,0,,Kerana kehamilan
Dialog: 0,0:17:02.35,0:17:04.62,Lalai,Spillik2,0,0,0,,Saya mudah marah. Dan saya mempunyai banyak kebimbangan.
Dialog: 0,0:17:05.02,0:17:06.42,Lalai,Spikyulka2,0,0,0,,Jadi saya sentiasa meraung.
Dialog: 0,0:17:07.46,0:17:09.59,Lalai,Spillik2,0,0,0,,Ini bukan saya.
Dialog: 0,0:17:10.43,0:17:11.96,Lalai,Spillik2,0,0,0,,Ini adalah hormon.
Dialog: 0,0:17:14.56,0:17:18.30,Lalai,Spillik2,0,0,0,,Hati saya sangat sakit.
Dialog: 0,0:17:21.30,0:17:25.44,Lalai,Spikyulka2,0,0,0,,Seolah-olah ditusuk jarum.
Dialog: 0,0:17:25.88,0:17:27.01,Lalai,Spillik2,0,0,0,,Yang Mulia.
Dialog: 0,0:17:31.11,0:17:33.15,Lalai,Spillik2,0,0,0,,Oh, tidak.
Dialog: 0,0:17:34.82,0:17:36.45,Lalai,Spikyulka2,0,0,0,,Apa yang salah dengan saya?
Dialog: 0,0:17:39.72,0:17:41.62,Lalai,Sutera2,0,0,0,,Kami masih mencari mayat.
Dialog: 0,0:17:42.16,0:17:43.59,Lalai,Spikyulka2,0,0,0,,Tolong beri saya lebih masa.
Dialog: 0,0:17:43.79,0:17:45.03,Lalai,Spillik2,0,0,0,,Saya tidak sabar.
Dialog: 0,0:17:46.10,0:17:49.40,Lalai,Spikyulka2,0,0,0,,Lebih-lebih lagi sebab untuk tergesa-gesa,\Sekiranya raja masih hidup.
Dialog: 0,0:17:50.50,0:17:53.00,Default,Spillik2,0,0,0,,Saya akan umumkan nasib yang menimpa raja. Bersedialah.
Dialog: 0,0:17:54.50,0:17:55.57,Lalai,Spilyk2,0,0,0,,Ya.
Dialog: 0,0:17:58.57,0:18:00.04,Lalai,Spillik2,0,0,0,,Sekarang saya sudah bersedia.
Dialog: 0,0:18:00.44,0:18:02.31,Lalai,Spillik2,0,0,0,,Sesetengah jarum tidak akan membuat saya menangis lagi.
Dialog: 0,0:18:04.11,0:18:05.21,Lalai,Spillik2,0,0,0,,Sungguh mimpi ngeri!
Dialog: 0,0:18:05.95,0:18:07.65,Lalai,Spillik2,0,0,0,,-Yang Mulia.\N-Itu menakutkan saya.
Dialog: 0,0:18:07.65,0:18:09.35,Lalai,Spikyulka2,0,0,0,,Saya hampir keguguran.
Dialog: 0,0:18:09.35,0:18:11.25,Lalai,Spilyk2,0,0,0,,Bolehkah anda berkata sedemikian?
Dialog: 0,0:18:14.12,0:18:15.16,Lalai,Spillie2,0,0,0,,Ratu.
Dialog: 0,0:18:16.89,0:18:18.26,Lalai,Spillik2,0,0,0,,Ada apa? Awak menakutkan saya.
Dialog: 0,0:18:21.76,0:18:23.07,Lalai,Spikyulka2,0,0,0,,Adakah raja menderita?
Dialog: 0,0:18:25.54,0:18:27.27,Lalai,Spillik2,0,0,0,,Baginda...
Dialog: 0,0:18:29.37,0:18:31.81,Lalai,Spillik2,0,0,0,,Raja
Dialog: 0,0:18:32.28,0:18:35.98,Lalai,Spikyulka2,0,0,0,,meninggalkan dunia ini.
Dialog: 0,0:18:53.03,0:18:57.20,Lalai,Spikyulka2,0,0,0,,Dan jika saya tidak tertidur malam itu?
Dialog: 0,0:18:59.34,0:19:00.44,Lalai,Spillik2,0,0,0,,Raja
Dialog: 0,0:19:03.01,0:19:05.07,Lalai,Spikyulka2,0,0,0,,meninggalkan dunia ini.
Dialog: 0,0:19:13.52,0:19:16.42,Lalai,Spikyulka2,0,0,0,,Bagaimana jika saya meminta anda untuk tinggal?
Dialog: 0,0:19:17.89,0:19:21.12,Lalai,Sutera2,0,0,0,,Yang Mulia, kembali kepada kami!
Dialog: 0,0:19:22.33,0:19:25.93,Lalai,Sutera2,0,0,0,,Yang Mulia, kembali kepada kami!
Dialog: 0,0:19:28.13,0:19:31.67,Lalai,Sutera2,0,0,0,,Yang Mulia, kembali kepada kami!
Dialog: 0,0:19:32.57,0:19:35.77,Lalai,Spillik2,0,0,0,,Jika saya tidak pernah sampai ke Joseon
Dialog: 0,0:19:37.14,0:19:38.91, Lalai, Spilyk2,0,0,0, dan kami tidak akan berjumpa?
Dialog: 0,0:19:40.28,0:19:43.28,Lalai,Spillik2,0,0,0,,Anda pasti masih hidup.
Dialog: 0,0:19:43.28,0:19:46.58,Lalai,Spilyk2,0,0,0,,5 hari sebelum menaiki takhta
Dialog: 0,0:19:46.58,0:19:48.18,Lalai,Spillik2,0,0,0,,Kembali?
Dialog: 0,0:19:48.68,0:19:50.52,Lalai,Spikyulka2,0,0,0,,Adakah mungkin untuk meminta orang mati kembali?
Dialog: 0,0:19:50.52,0:19:52.99,Lalai,Spillik2,0,0,0,,Permintaan yang teruk.
Dialog: 0,0:19:53.42,0:19:55.66,Lalai,Spikyulka2,0,0,0,,Dan mayatnya masih belum ditemui.
Dialog: 0,0:19:55.66,0:19:58.49,Lalai,Spikyulka2,0,0,0,,Laungan meminta saya kembali membuatkan bulu roma saya berdiri tegak.
Dialog: 0,0:19:59.10,0:20:02.23,Lalai,Sutera2,0,0,0,,Jika saya boleh, saya akan menobatkan raja baru.
Dialog: 0,0:20:02.40,0:20:04.23, Lalai, Spilyk2,0,0,0,,Tetapi jika saya tidak mengikut tradisi
Dialog: 0,0:20:04.23,0:20:06.14,Lalai,Spikyulka2,0,0,0,,dan tunggu kebangkitan raja yang telah mati,
Dialog: 0,0:20:06.14,0:20:09.44, Lalai, Spikyulka2,0,0,0,,Saya pasti ini akan menjadi bumerang kepada saya dan merosakkan semua rancangan politik saya.
Dialog: 0,0:20:09.44,0:20:11.47,Lalai,Spillik2,0,0,0,,Walaupun raja masih hidup,
Dialog: 0,0:20:11.87,0:20:13.94,Lalai,Spikyulka2,0,0,0,,dia tidak akan dapat kembali ke istana.
Dialog: 0,0:20:15.41,0:20:16.95,Lalai,Spikyulka2,0,0,0,,Saya menutup semua pintu
Dialog: 0,0:20:16.95,0:20:18.65, Lalai, Spilyk2,0,0,0,,sehingga pertabalan baharu.
Dialog: 0,0:20:19.28,0:20:20.28,Lalai,Spillik2,0,0,0,,Ya.
Dialog: 0,0:20:20.62,0:20:23.45,Lalai,Spikyulka2,0,0,0,,Jika dalam masa lima hari kita boleh mengadakan pertabalan,
Dialog: 0,0:20:24.49,0:20:26.16,Lalai,Spikyulka2,0,0,0,,dia tidak akan menjadi raja lagi.
Dialog: 0,0:20:26.59,0:20:28.49,Lalai,Spikyulka2,0,0,0,,Jadi, jika kita membunuhnya, ia bukan lagi pengkhianatan.
Dialog: 0,0:20:35.87,0:20:38.40,Lalai,Sutera2,0,0,0,,Berapa lama saya perlu menunggu sehingga permaisuri sedar?
Dialog: 0,0:20:39.87,0:20:42.64,Lalai,Silk2,0,0,0,,Tidakkah dia benar-benar mahu bersatu semula dengan klan itu?
Dialog: 0,0:20:42.64,0:20:45.51,Lalai,Spikyulka2,0,0,0,,Saya akan beritahu dia supaya bersedia dan melawat anda
Dialog: 0,0:20:45.51,0:20:46.98,Lalai,Spillik2,0,0,0,,asap.
Dialog: 0,0:21:08.20,0:21:10.70,Lalai,Spilyk2,0,0,0,,Diari Kehamilan
Dialog: 0,0:21:14.87,0:21:17.01, Lalai, Spikyulka2,0,0,0,,Dan mengapa ini diperlukan sekarang,
Dialog: 0,0:21:20.28,0:21:21.54, Lalai, Spillik2,0,0,0,,apabila anda tiada di sini?
Dialog: 0,0:21:46.80,0:21:47.97,Lalai,Spikyulka2,0,0,0,,Kuasa dibeli dengan wang.
Dialog: 0,0:21:56.95,0:21:57.98,Lalai,Spillik2,0,0,0,,Anak saya.
Dialog: 0,0:21:58.58,0:22:01.08, Lalai, Spillit2,0,0,0,,Jangan sensitif terhadap bau makanan.
Dialog: 0,0:22:01.25,0:22:03.32,Lalai,Spikyulka2,0,0,0,,Jangan rumitkan kehidupan ibu cantik anda.
Dialog: 0,0:22:04.99,0:22:07.16,Lalai,Spikyulka2,0,0,0,,Diam sebanyak yang anda mahu pada siang hari.
Dialog: 0,0:22:07.49,0:22:11.09,Lalai,Spikyulka2,0,0,0,,Tetapi apabila ibu anda mahu tidur, berhenti.
Dialog: 0,0:22:12.80,0:22:14.56,Lalai,Spilyk2,0,0,0,,Apabila tiba masanya untuk keluar ke dunia,
Dialog: 0,0:22:14.56,0:22:16.83,Lalai,Spilyk2,0,0,0,,keluar cepat,
Dialog: 0,0:22:16.83,0:22:19.10,Lalai,Spikyulka2,0,0,0,,jangan buat ibu anda terlalu menderita.
Dialog: 0,0:22:20.77,0:22:24.47,Lalai,Spikyulka2,0,0,0,,Perkara yang paling penting ialah datang ke dunia dengan sihat.
Dialog: 0,0:22:27.08,0:22:31.98,Lalai,Spikyulka2,0,0,0,,Saya sangat menantikan hari apabila kita bertemu.
Dialog: 0,0:22:38.92,0:22:41.02,Lalai,Spilyk2,0,0,0,,Saya berjanji akan berada di sisi awak,
Dialog: 0,0:22:41.02,0:22:43.16,Lalai,Spikyulka2,0,0,0,,apabila anda menarik nafas pertama di dunia ini.
Dialog: 0,0:22:43.79,0:22:47.76,Lalai,Spillik2,0,0,0,,Walaupun dunia kelihatan aneh kepada anda, jangan takut apa-apa.
Dialog: 0,0:23:33.32,0:23:34.98,Lalai,Spillik2,0,0,0,,Tunjukkan rasa hormat.
Dialog: 0,0:23:36.45,0:23:38.32,Lalai,Spikyulka2,0,0,0,,Jadi ini rancangan anda pada mulanya?
Dialog: 0,0:23:39.89,0:23:42.23,Lalai,Spikyulka2,0,0,0,,Raja tahu tentang bahaya yang mengancamnya.
Dialog: 0,0:23:42.83,0:23:44.83,Lalai,Spikyulka2,0,0,0,,Tetapi demi keselamatanmu
Dialog: 0,0:23:44.83,0:23:46.73, Lalai, Spikyulka2,0,0,0,, mempertaruhkan nyawanya dan meninggalkan istana.
Dialog: 0,0:23:48.06,0:23:49.40,Lalai,Spillik2,0,0,0,,Apa yang anda cakapkan?
Dialog: 0,0:23:58.01,0:23:59.78,Lalai,Spillie2,0,0,0,,Letakkan Putera Yeonpyeong ke dalam penjara.
Dialog: 0,0:24:01.84,0:24:02.88,Lalai,Spikyulka2,0,0,0,,-Tidak!\N-Yang Mulia!
Dialog: 0,0:24:03.15,0:24:04.88,Lalai,Spillik2,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:24:07.02,0:24:09.55,Lalai,Spikyulka2,0,0,0,,Mengapa kamu melampiaskan kemarahan kamu kepada permaisuri?
Dialog: 0,0:24:09.55,0:24:12.69,Lalai,Spillik2,0,0,0,,Raja meninggalkan dunia kerana pengikut Tonhak.
Dialog: 0,0:24:17.06,0:24:20.06, Lalai, Spilyk2,0,0,0,,Pemberontak langsung tidak menyentuh gabenor.
Dialog: 0,0:24:20.96,0:24:23.77,Lalai,Spikyulka2,0,0,0,,Anda kata mereka berani membunuh raja?
Dialog: 0,0:24:24.93,0:24:27.24,Lalai,Spikyulka2,0,0,0,,Adakah anda fikir saya akan percaya pembohongan yang menyedihkan itu?
Dialog: 0,0:24:28.24,0:24:32.44,Lalai,Spikyulka2,0,0,0,,Kim Byonin, pahlawan kamu membunuh raja.
Dialog: 0,0:24:34.84,0:24:38.18,Lalai,Spillik2,0,0,0,,Anda dan permaisuri menghukumnya mati,
Dialog: 0,0:24:39.32,0:24:41.48,Lalai,Spikyulka2,0,0,0,,jadi saya sendiri mesti mengambil nyawanya.
Dialog: 0,0:24:45.02,0:24:46.22,Lalai,Spillik2,0,0,0,,Sila, tidak!
Dialog: 0,0:24:46.52,0:24:47.66,Lalai,Spillie2,0,0,0,,Ratu.
Dialog: 0,0:24:48.56,0:24:50.73,Lalai,Spillie2,0,0,0,,Demi anak di dalam perutnya,
Dialog: 0,0:24:51.63,0:24:53.86,Lalai,Spillik2,0,0,0,,tolong jangan ganggu dia.
Dialog: 0,0:24:54.70,0:24:57.20,Lalai,Spillik2,0,0,0,,Baginda tidak tahu apa-apa.
Dialog: 0,0:24:57.63,0:24:58.80,Lalai,Spilyk2,0,0,0,,Sila...
Dialog: 0,0:25:01.04,0:25:02.54,Lalai,Spilyk2,0,0,0,,Saya mohon...
Dialog: 0,0:25:12.55,0:25:14.55,Lalai,Spillik2,0,0,0,,Tuhan! Ratu!
Dialog: 0,0:25:20.89,0:25:22.19,Lalai,Spilyk2,0,0,0,,Bawa dia pergi.
Dialog: 0,0:25:37.64,0:25:39.21,Lalai,Spillik2,0,0,0,,Awak okay?
Dialog: 0,0:25:43.05,0:25:44.58,Lalai,Spilyk2,0,0,0,,Apa yang dia cakapkan?
Dialog: 0,0:25:45.31,0:25:47.48,Lalai,Spikyulka2,0,0,0,,Askar kamu membunuh raja?
Dialog: 0,0:25:49.09,0:25:50.45,Lalai,Spillik2,0,0,0,,Kamu berdua, keluar dari bilik.
Dialog: 0,0:25:52.89,0:25:54.36,Lalai,Spillik2,0,0,0,,-Yang Mulia.\N-Semuanya baik-baik saja.
Dialog: 0,0:26:07.60,0:26:10.51,Lalai,Spikyulka2,0,0,0,,Seseorang mesti dipersalahkan atas musibah yang berlaku.
Dialog: 0,0:26:12.68,0:26:14.68,Lalai,Spillie2,0,0,0,,Putera Yeonpyeong mengigau,
Dialog: 0,0:26:15.31,0:26:17.15, Lalai, Spikyulka2,0,0,0,,jangan ambil berat perkara ini.
Dialog: 0,0:26:18.38,0:26:20.78,Lalai,Spillik2,0,0,0,,Mengapa Putera Yeonpyeong dihantar ke penjara?
Dialog: 0,0:26:21.05,0:26:23.02,Lalai,Spikyulka2,0,0,0,,Saya mempunyai bukti bahawa dia melepaskan
Dialog: 0,0:26:23.02,0:26:24.79,Lalai,Spikyulka2,0,0,0,,pengikut Tonhak, menyelinap masuk
Dialog: 0,0:26:24.92,0:26:27.79,Lalai,Sutera2,0,0,0,,kepada pengawal diraja, dan membantu mereka melarikan diri.
Dialog: 0,0:26:27.99,0:26:30.53,Lalai,Spillik2,0,0,0,,Nampaknya mereka ada kaitan dengan kejadian yang berlaku dengan raja,
Dialog: 0,0:26:30.53,0:26:32.56,Lalai,Spikyulka2,0,0,0,,kerana saya akan menyoal siasat Putera Yeonpyeong.
Dialog: 0,0:26:33.76,0:26:35.23,Lalai,Spikyulka2,0,0,0,,Saya sepatutnya melakukan ini lebih awal.
Dialog: 0,0:26:35.80,0:26:37.67,Lalai,Spilyk2,0,0,0,,Apa sebenarnya yang anda cakapkan?
Dialog: 0,0:26:38.20,0:26:40.60,Lalai,Spikyulka2,0,0,0,,Anda bercakap seolah-olah Putera Yeonpyeong membunuh raja.
Dialog: 0,0:26:40.60,0:26:43.47,Lalai,Spillik2,0,0,0,,Seseorang di istana pasti telah menyerahkan kepada pengikut Tonhak
Dialog: 0,0:26:43.47,0:26:46.48,Lalai,Spikyulka2,0,0,0,,maklumat tentang bila raja akan meninggalkan istana.
Dialog: 0,0:26:47.64,0:26:51.01,Lalai,Spikyulka2,0,0,0,,Ia mestilah seseorang yang mempunyai akses kepada maklumat,
Dialog: 0,0:26:51.71,0:26:53.78,Lalai,Spikyulka2,0,0,0,,yang bermaksud ini kemungkinan besar Putera Yeonpyeong.
Dialog: 0,0:26:55.72,0:26:57.99,Lalai,Spillik2,0,0,0,,Adakah anda pasti bahawa pengikut Tonhak yang menyerang raja?
Dialog: 0,0:26:58.25,0:27:01.76,Lalai,Spillik2,0,0,0,,Anda mesti fokus pada perkara yang lebih penting.
Dialog: 0,0:27:02.46,0:27:06.06,Lalai,Spilyk2,0,0,0,,Kini hanya puak anda boleh melindungi anda
Dialog: 0,0:27:06.06,0:27:07.43, Lalai, Spilyk2,0,0,0,, dan anak anda.
Dialog: 0,0:27:08.30,0:27:10.60,Lalai,Spikyulka2,0,0,0,,Tidak ada gunanya risau tentang perkara lain.
Dialog: 0,0:27:10.63,0:27:13.34,Lalai,Spillik2,0,0,0,,Mula-mula anda mesti berdamai dengan permaisuri janda.
Dialog: 0,0:27:14.00,0:27:15.24,Lalai,Spilyk2,0,0,0,,Jika anda terlepas peluang ini,
Dialog: 0,0:27:17.74,0:27:20.84,Lalai,Sutera2,0,0,0,,anda mungkin kehilangan peluang untuk memperbaiki hubungan dengan klan selamanya.
Dialog: 0,0:27:42.00,0:27:45.30,Lalai,Silk2,0,0,0,,Yeonpyeong, saya ingin menjadi awak dalam kehidupan seterusnya.
Dialog: 0,0:27:45.73,0:27:48.77,Lalai,Spillik2,0,0,0,,"Cari bukti." Kedengaran mudah
Dialog: 0,0:27:48.77,0:27:51.41, Lalai, Spikyulka2,0,0,0,, dan berapa banyak kerja yang diperlukan.
Dialog: 0,0:27:59.32,0:28:00.78,Lalai,Lily3,0,0,0,,Saya lihat semua orang ada di sini.
Dialog: 0,0:28:05.09,0:28:06.79, Lalai, Lily3,0,0,0,,Saya rasa ia tidak sesuai
Dialog: 0,0:28:06.92,0:28:10.86,Default,Lily3,0,0,0,,berkumpul di rumah kisaeng ketika raja mangkat.
Dialog: 0,0:28:10.86,0:28:13.00,Lalai,Lily3,0,0,0,,Saya sengaja memilih tempat ini untuk berehat.
Dialog: 0,0:28:14.83,0:28:18.33,Lalai,Lily3,0,0,0,,Kita semua boleh jujur ​​semasa berada di sini.
Dialog: 0,0:28:20.04,0:28:21.34,Lalai,Lily3,0,0,0,,Kematian Raja
Dialog: 0,0:28:23.01,0:28:25.27,Lalai,Lily3,0,0,0,,kita perlu raikan.
Dialog: 0,0:28:30.51,0:28:31.85,Lalai,Lily3,0,0,0,,Mari kita minum.
Dialog: 0,0:28:32.18,0:28:35.89,Lalai,Lily3,0,0,0,,Kerumunan pemberontak menjadi gila.
Dialog: 0,0:28:36.15,0:28:38.65,Lalai,Lily3,0,0,0,,Saya bimbang tentang masa depan Joseon.
Dialog: 0,0:28:40.09,0:28:41.66,Lalai,Lily3,0,0,0,,Pada kadar ini, Tonkhakovites
Dialog: 0,0:28:41.66,0:28:44.86,Lalai,Lilia3,0,0,0,,Khanyan akan ditangkap tidak lama lagi.
Dialog: 0,0:28:45.13,0:28:47.83,Lalai,Lily3,0,0,0,,Jika ini berlaku, semua orang duduk di sini
Dialog: 0,0:28:48.16,0:28:49.87, Lalai, Lily3,0,0,0,,akan menderita.
Dialog: 0,0:28:52.03,0:28:54.60,Lalai,Lily3,0,0,0,,Oleh itu, kita perlu mengukuhkan keselamatan istana
Dialog: 0,0:28:54.90,0:28:57.84, Lalai, Lily3,0,0,0,,dan tembok kubu di sekeliling Khanyang.
Dialog: 0,0:28:58.94,0:29:01.44, Lalai, Lily3,0,0,0,,Kami akan mengisytiharkan keadaan kecemasan dan menyekat kemasukan.
Dialog: 0,0:29:01.81,0:29:04.05,Lalai,Lily3,0,0,0,,Semua orang yang mencurigakan akan ditahan.
Dialog: 0,0:29:05.25,0:29:07.85,Lalai,Lily3,0,0,0,,Jadi kita akan singkirkan semua orang Tonhakit.
Dialog: 0,0:29:11.19,0:29:14.09,Lalai,Lily3,0,0,0,,Idea bernas.
Dialog: 0,0:29:23.33,0:29:26.74,Lalai,Lily3,0,0,0,,Nampaknya ratu sudah hilang akal.
Dialog: 0,0:29:27.84,0:29:29.81,Lalai,Lily3,0,0,0,,Dia selalu begini.
Dialog: 0,0:29:32.47,0:29:35.78,Lalai,Lilia3,0,0,0,,Dia fikir semua kuasa ada di tangannya kerana mengandung,
Dialog: 0,0:29:35.98,0:29:39.11,Lalai,Lily3,0,0,0,,tetapi raja mati. Saya yakin dia takut.
Dialog: 0,0:29:40.65,0:29:43.25,Lalai,Lily3,0,0,0,,Jika dia melahirkan putera raja,
Dialog: 0,0:29:43.25,0:29:46.52,Lalai,Lily3,0,0,0,,ini akan menamatkan dia.
Dialog: 0,0:29:48.26,0:29:50.36,Lalai,Lily3,0,0,0,,Akhirnya, kata-kata yang masuk akal daripada anda.
Dialog: 0,0:30:04.64,0:30:07.81, Lalai, Lily3,0,0,0,,Lilin dan batang kemenyan perlu ditukar.
Dialog: 0,0:30:30.83,0:30:34.30,Lalai,Lily3,0,0,0,,Yang Mulia, saya akan mati kerana serangan jantung.
Dialog: 0,0:30:34.47,0:30:37.51,Lalai,Lily3,0,0,0,,Kenapa mereka menjaga si mati begitu?
Dialog: 0,0:30:39.41,0:30:41.34, Lalai, Lily3,0,0,0,,Adakah terdapat sesuatu yang pelik dalam hal ini?
Dialog: 0,0:30:44.15,0:30:45.35,Lalai,Lily3,0,0,0,,Kita perlu cepat.
Dialog: 0,0:30:48.25,0:30:49.65,Lalai,Lily3,0,0,0,,Terima kasih.
Dialog: 0,0:31:06.14,0:31:09.34, Lalai, Lily3,0,0,0,,Dia cedera teruk.
Dialog: 0,0:31:10.11,0:31:12.17,Lalai,Lily3,0,0,0,,Terutama muka.
Dialog: 0,0:31:12.27,0:31:16.81,Lalai,Lily3,0,0,0,,Sangat kuat sehingga dia tidak dapat dikenali.
Dialog: 0,0:31:40.34,0:31:42.07,Lalai,Lily3,0,0,0,,Eureka!
Dialog: 0,0:31:52.92,0:31:55.45,Lalai,Lily3,0,0,0,,Hei tikus, saya tak buat apa-apa.
Dialog: 0,0:31:55.45,0:31:57.82,Lalai,Lily3,0,0,0,,Semua orang yang layak dikurung berkata demikian.
Dialog: 0,0:31:57.92,0:32:00.62,Lalai,Lily3,0,0,0,,Anda bersalah kerana kehilangan senjata anda.
Dialog: 0,0:32:01.82,0:32:04.66,Lalai,Lily3,0,0,0,,Bagaimana anda boleh menyalahkan saya dalam hal ini?
Dialog: 0,0:32:04.83,0:32:07.53,Lalai,Lily3,0,0,0,,Si bodoh mana yang mampu kehilangan senjata?
Dialog: 0,0:32:07.53,0:32:10.23,Lalai,Lily3,0,0,0,,Sama seperti di hadapan saya.
Dialog: 0,0:32:11.23,0:32:12.97,Lalai,Lily3,0,0,0,,Depot senjata telah dirompak.
Dialog: 0,0:32:16.14,0:32:17.57,Lalai,Lily3,0,0,0,,Saya rasa anda tidak berminat,
Dialog: 0,0:32:20.11,0:32:21.54,Lalai,Lily3,0,0,0,,apa yang Putera Yeonpyeong bersalah.
Dialog: 0,0:32:21.91,0:32:24.91,Lalai,Lily3,0,0,0,,Jangan risau. Awak tidak berada di sini lama.
Dialog: 0,0:32:26.05,0:32:27.05,Lalai,Lily3,0,0,0,,Apa?
Dialog: 0,0:32:28.85,0:32:31.22,Lalai,Lily3,0,0,0,,Apakah maksud ini? Kami
Dialog: 0,0:32:31.85,0:32:32.86, Lalai, Lily3,0,0,0,, dilaksanakan?
Dialog: 0,0:32:33.96,0:32:36.13,Lalai,Lily3,0,0,0,,Saya boleh duduk lebih lama.
Dialog: 0,0:32:36.13,0:32:37.13,Lalai,Lily3,0,0,0,,Saya suka tidur di atas lantai.
Dialog: 0,0:32:37.13,0:32:38.46,Lalai,Lily3,0,0,0,,Hei, tunggu!
Dialog: 0,0:32:44.63,0:32:45.70,Lalai,Lily3,0,0,0,,Baiklah.
Dialog: 0,0:32:46.60,0:32:49.97,Lalai,Lily3,0,0,0,,Mari kita bincang. Kita boleh buat.
Dialog: 0,0:32:58.58,0:33:00.45,Lalai,Lily3,0,0,0,,Byonin menghantar Cheoljong kepada pemberontak,
Dialog: 0,0:33:00.45,0:33:02.35,Lalai,Lily3,0,0,0,,menggunakan saya sebagai umpan untuk membunuh.
Dialog: 0,0:33:04.65,0:33:06.82,Lalai,Lily3,0,0,0,,Tetapi ada mayat orang lain di sana, yang bermaksud
Dialog: 0,0:33:06.82,0:33:08.62,Lalai,Lily3,0,0,0,,rancangan tidak berjaya.
Dialog: 0,0:33:11.13,0:33:14.96,Lalai,Lily3,0,0,0,,Dia menahan orang Cheoljong supaya mereka tidak membantu dia kembali.
Dialog: 0,0:33:21.90,0:33:25.47,Lalai,Lily3,0,0,0,,Saya tidak dapat menumpukan perhatian kerana esakan awak.
Dialog: 0,0:33:31.65,0:33:33.18, Lalai, Lily3,0,0,0,, Pergi lebih dekat.
Dialog: 0,0:33:36.65,0:33:39.22,Lalai,Lily3,0,0,0,,Saya akan beritahu satu rahsia.
Dialog: 0,0:33:40.49,0:33:43.13,Lalai,Lily3,0,0,0,,Kamu mesti bawa dia ke kubur kamu.
Dialog: 0,0:33:48.13,0:33:49.46,Lalai,Lily3,0,0,0,,Raja
Dialog: 0,0:33:51.83,0:33:53.00,Lalai,Lily3,0,0,0,,hidup.
Dialog: 0,0:33:54.87,0:33:56.91,Lalai,Lily3,0,0,0,,Ya, sudah tentu.
Dialog: 0,0:33:57.11,0:34:02.28,Lalai,Lily3,0,0,0,,Baginda akan tinggal di hati anda.
Dialog: 0,0:34:03.15,0:34:04.55,Lalai,Lily3,0,0,0,,Anda...
Dialog: 0,0:34:05.91,0:34:07.92,Lalai,Lily3,0,0,0,,Saya rasa badan dari kepala hingga kaki.
Dialog: 0,0:34:09.02,0:34:10.22,Lalai,Lily3,0,0,0,,Bukan dia.
Dialog: 0,0:34:10.42,0:34:12.39,Lalai,Lily3,0,0,0,,Dari kepala hingga kaki?
Dialog: 0,0:34:13.82,0:34:15.69,Lalai,Lily3,0,0,0,,Saya akan melangkau butirannya.
Dialog: 0,0:34:18.36,0:34:21.06,Lalai,Lily3,0,0,0,,-Tuhan.\N-Jika dia masih hidup,
Dialog: 0,0:34:21.73,0:34:24.23,Lalai,Lily3,0,0,0,,kenapa awak belum balik lagi?
Dialog: 0,0:34:25.30,0:34:27.57,Lalai,Lily3,0,0,0,,Dia sama ada cedera atau diikat di suatu tempat.
Dialog: 0,0:34:29.14,0:34:30.47,Lalai,Lily3,0,0,0,,-Lady Choi.\N-Ya.
Dialog: 0,0:34:30.64,0:34:32.98,Lalai,Lily3,0,0,0,,Terdapat undang-undang yang melarang naik takhta,
Dialog: 0,0:34:32.98,0:34:35.08,Lalai,Lily3,0,0,0,,sejurus selepas kematian raja?
Dialog: 0,0:34:35.54,0:34:38.28,Lalai,Lily3,0,0,0,,Ya. Adat ini dipanggil Sanibok.
Dialog: 0,0:34:38.28,0:34:42.15,Lalai,Lily3,0,0,0,,Anda mesti menunggu kepulangan roh si mati dalam masa lima hari.
Dialog: 0,0:34:42.15,0:34:44.59,Lalai,Lily3,0,0,0,,Raja baharu boleh naik takhta hanya dalam masa lima hari.
Dialog: 0,0:34:44.89,0:34:47.79,Lalai,Lily3,0,0,0,,Kemudian kita mempunyai enam hari, termasuk hari pertabalan.
Dialog: 0,0:34:49.19,0:34:51.23,Lalai,Lily3,0,0,0,,Mereka akan melakukan apa sahaja,
Dialog: 0,0:34:51.23,0:34:53.30,Lalai,Lily3,0,0,0,,supaya selama enam hari ini raja tidak kembali.
Dialog: 0,0:34:55.20,0:34:56.57,Lalai,Lily3,0,0,0,,Berapa ramai pembantu rumah yang ada di istana?
Dialog: 0,0:34:57.03,0:35:01.44,Lalai,Lily3,0,0,0,,Kira-kira 250 pembantu rumah.
Dialog: 0,0:35:01.44,0:35:03.47,Lalai,Lily3,0,0,0,,Jika anda termasuk penjawat mahkamah,
Dialog: 0,0:35:03.47,0:35:05.51,Lalai,Lily3,0,0,0,,akan melebihi 600.
Dialog: 0,0:35:06.11,0:35:08.74, Lalai,Lily3,0,0,0,,600 kamera pengawasan langsung.
Dialog: 0,0:35:09.51,0:35:11.85,Lalai,Lily3,0,0,0,,Jika setiap daripada mereka menyebut satu perkataan, akan ada 600 perkataan.
Dialog: 0,0:35:13.52,0:35:15.08,Lalai,Lily3,0,0,0,,Mari kita gunakannya.
Dialog: 0,0:35:16.05,0:35:17.09,Lalai,Lily3,0,0,0,,-Apa?\N-Apa?
Dialog: 0,0:35:17.09,0:35:19.15,Lalai,Lily3,0,0,0,,Saya akan mengganggu pertabalan.
Dialog: 0,0:35:21.29,0:35:22.56,Lalai,Lily3,0,0,0,,Adakah anda bersama saya?
Dialog: 0,0:35:23.06,0:35:24.06,Lalai,Lily3,0,0,0,,Semoga berjaya.
Dialog: 0,0:35:24.46,0:35:26.86,Lalai,Lily3,0,0,0,,-Ya.\N-Ya.
Dialog: 0,0:35:27.83,0:35:28.93,Lalai,Lily3,0,0,0,,Ya.
Dialog: 0,0:35:30.23,0:35:32.10,Lalai,Lily3,0,0,0,,Jika Baginda masih hidup...
Dialog: 0,0:35:35.37,0:35:38.07,Lalai,Lily3,0,0,0,,Negeri kita sedang melalui kesukaran,
Dialog: 0,0:35:38.47,0:35:40.48,Lalai,Lily3,0,0,0,,pelantikan raja baharu tidak boleh ditangguhkan.
Dialog: 0,0:35:40.84,0:35:43.65,Lalai,Lily3,0,0,0,,Sebagai raja yang menjalankan tugas diraja,
Dialog: 0,0:35:44.35,0:35:46.25,Lalai,Lily3,0,0,0,,Saya umumkan keturunan ke-32
Dialog: 0,0:35:46.25,0:35:48.82,Lalai,Lily3,0,0,0,,Putera Minheung, Lee Kyungwon.
Dialog: 0,0:35:50.22,0:35:52.49,Lalai,Lily3,0,0,0,,Raja telah meninggalkan dunia ini
Dialog: 0,0:35:53.26,0:35:54.96, Lalai, Lily3,0,0,0,, akibat pemberontakan pemberontak...
Dialog: 0,0:35:55.39,0:35:56.86,Lalai,Lily3,0,0,0,,Pengikut Tonghak yang merampas
Dialog: 0,0:35:56.86,0:35:59.16,Lalai,Lily3,0,0,0,,kehidupan raja kita, tidak patut dikasihani.
Dialog: 0,0:35:59.63,0:36:01.53,Lalai,Lily3,0,0,0,,Saya mengisytiharkan bahawa setiap
Dialog: 0,0:36:01.53,0:36:04.33,Lalai,Lily3,0,0,0,,Pengikut Tonghak akan dimusnahkan.
Dialog: 0,0:36:05.40,0:36:07.44,Lalai,Lily3,0,0,0,,The Tonhakovians telah membawa masalah kepada diri mereka sendiri.
Dialog: 0,0:36:07.44,0:36:08.80,Lalai,Lily3,0,0,0,,Pencaji.
Dialog: 0,0:36:18.38,0:36:19.38,Lalai,Lily3,0,0,0,,Benin.
Dialog: 0,0:36:25.89,0:36:26.96,Lalai,Lily3,0,0,0,,Mengapa anda berlengah
Dialog: 0,0:36:26.96,0:36:28.26,Lalai,Lily3,0,0,0,,Yeonpyeong dan Hong?
Dialog: 0,0:36:29.36,0:36:30.73, Lalai, Lily3,0,0,0,,Imbangan kuasa sedang berubah
Dialog: 0,0:36:30.73,0:36:32.26,Lalai,Lily3,0,0,0,,bergantung pada siapa yang berada di atas takhta.
Dialog: 0,0:36:32.26,0:36:34.00,Lalai,Lily3,0,0,0,,Ini bukan kali pertama perkara ini berlaku.
Dialog: 0,0:36:34.00,0:36:36.40,Lalai,Lily3,0,0,0,,Jadi begitu. Raja meninggal baru-baru ini.
Dialog: 0,0:36:36.40,0:36:38.30,Lalai,Lily3,0,0,0,,Bagaimana anda boleh menahan orang yang tidak bersalah?
Dialog: 0,0:36:38.73,0:36:40.34,Lalai,Lily3,0,0,0,,Innocent?
Dialog: 0,0:36:42.20,0:36:44.17,Lalai,Lily3,0,0,0,,Berada di pihak yang lemah juga merupakan satu jenayah.
Dialog: 0,0:36:44.34,0:36:48.08,Lalai,Lilia3,0,0,0,,Benin, sejauh mana anda sanggup pergi?
Dialog: 0,0:36:50.65,0:36:52.55,Lalai,Lily3,0,0,0,,Saya mahu menjadi lebih berkuasa.
Dialog: 0,0:36:53.08,0:36:55.28,Lalai,Lily3,0,0,0,,Untuk melindungi mereka yang saya sayang,
Dialog: 0,0:36:57.12,0:36:58.85, Lalai, Lily3,0,0,0,,Saya perlukan lebih kuasa.
Dialog: 0,0:37:05.73,0:37:07.10,Lalai,Lily3,0,0,0,,Jadikan bibir anda tidak bermaya.
Dialog: 0,0:37:07.76,0:37:09.60,Lalai,Lily3,0,0,0,,Anda sudah menjadi mayat hidup.
Dialog: 0,0:37:09.87,0:37:12.57,Lalai,Lily3,0,0,0,,Kemudian jadikan ia kelihatan seperti mayat sebenar.
Dialog: 0,0:37:17.27,0:37:19.04,Lalai,Lily3,0,0,0,,Mengapa pergi sejauh ini?
Dialog: 0,0:37:20.71,0:37:22.94,Lalai,Lily3,0,0,0,,Raja hanya tinggal saya.
Dialog: 0,0:37:24.88,0:37:27.38,Lalai,Lily3,0,0,0,,Walaupun mereka mahu menyingkirkan saya,
Dialog: 0,0:37:27.38,0:37:29.68,Lalai,Lily3,0,0,0,,mereka tidak akan meletakkan wanita hamil di dalam sangkar.
Dialog: 0,0:37:32.49,0:37:33.72,Lalai,Lily3,0,0,0,,Apakah rupa saya?
Dialog: 0,0:37:37.56,0:37:39.76,Lalai,Lily3,0,0,0,,-Seperti mayat sebenar.\N-Betul ke?
Dialog: 0,0:37:59.51,0:38:02.22,Lalai,Lily3,0,0,0,,Permaisuri Janda telah tiba.
Dialog: 0,0:38:32.38,0:38:35.55,Lalai,Lily3,0,0,0,,Kedua-duanya akan membuat persembahan yang agak menarik di sini.
Dialog: 0,0:38:40.09,0:38:42.69,Lalai,Lily3,0,0,0,,Hanya hadiah utama akan menjadi milik saya.
Dialog: 0,0:38:44.63,0:38:48.43,Lalai,Lily3,0,0,0,,Yang Mulia.
Dialog: 0,0:38:50.50,0:38:54.44,Lalai,Lily3,0,0,0,,Macam mana awak boleh tinggalkan saya?
Dialog: 0,0:38:55.67,0:38:58.61,Lalai,Lily3,0,0,0,,Bagaimana dengan anak kita?
Dialog: 0,0:39:00.11,0:39:01.14, Lalai, Lily3,0,0,0,,Anda...
Dialog: 0,0:39:01.61,0:39:06.01,Lalai,Lily3,0,0,0,,Yang Mulia.
Dialog: 0,0:39:10.55,0:39:13.32,Lalai,Lily3,0,0,0,,-Yang Mulia.\N-Yang Mulia.
Dialog: 0,0:39:13.46,0:39:14.86,Lalai,Lily3,0,0,0,,Yang Mulia.
Dialog: 0,0:39:15.89,0:39:17.66,Lalai,Lily3,0,0,0,,Yang Mulia.
Dialog: 0,0:39:17.93,0:39:21.06,Lalai,Lily3,0,0,0,,Panggil doktor diraja. Segera!
Dialog: 0,0:39:23.60,0:39:26.23,Lalai,Lily3,0,0,0,,-Yang Mulia.\N-Yang Mulia.
Dialog: 0,0:39:26.23,0:39:28.17,Lalai,Lily3,0,0,0,,Jika saya terlewat walaupun untuk seketika, saya akan mengutuk mereka.
Dialog: 0,0:39:28.17,0:39:29.24,Lalai,Lily3,0,0,0,,Seret, seret.
Dialog: 0,0:39:29.24,0:39:32.87,Lalai,Lily3,0,0,0,,-Yang Mulia.\N-Yang Mulia.
Dialog: 0,0:39:34.11,0:39:36.55,Lalai,Lily3,0,0,0,,-Yang Mulia.\N-Yang Mulia.
Dialog: 0,0:39:40.92,0:39:43.42,Lalai,Lily3,0,0,0,,Macam mana.
Dialog: 0,0:39:44.69,0:39:46.72,Lalai,Lily3,0,0,0,,Bagaimana ya.
Dialog: 0,0:39:47.26,0:39:49.49,Lalai,Lily3,0,0,0,,Tuhan.
Dialog: 0,0:39:49.82,0:39:54.10,Lalai,Lily3,0,0,0,,Macam mana.
Dialog: 0,0:39:57.37,0:39:58.57,Lalai,Lily3,0,0,0,,Adakah anda menghubungi saya?
Dialog: 0,0:40:00.54,0:40:02.17,Lalai,Lily3,0,0,0,,Adakah anda ngeri apabila anda mendengar berita itu?
Dialog: 0,0:40:02.34,0:40:05.57,Lalai,Lily3,0,0,0,,Apa yang berlaku kepadanya pada hari-hari terakhir?
Dialog: 0,0:40:06.78,0:40:09.38,Lalai,Lily3,0,0,0,,Bagaimana dia boleh pergi begitu tiba-tiba?
Dialog: 0,0:40:11.71,0:40:12.81,Lalai,Lily3,0,0,0,,Raja
Dialog: 0,0:40:16.59,0:40:17.72,Lalai,Lily3,0,0,0,,hidup.
Dialog: 0,0:40:19.59,0:40:21.02,Lalai,Lily3,0,0,0,,Saya menelefon untuk memberitahu anda perkara ini.
Dialog: 0,0:40:27.23,0:40:28.33,Lalai,Lily3,0,0,0,,Terima kasih.
Dialog: 0,0:40:29.70,0:40:31.40,Lalai,Lily3,0,0,0,,Terima kasih banyak.
Dialog: 0,0:40:36.27,0:40:37.37,Lalai,Lily3,0,0,0,,Dengar.
Dialog: 0,0:40:38.67,0:40:40.31,Lalai,Lily3,0,0,0,,Ini hanyalah permulaan.
Dialog: 0,0:40:45.78,0:40:49.62,Lalai,Lily3,0,0,0,,Kami akan meredakan pergolakan di negara ini dalam masa empat hari.
Dialog: 0,0:40:50.75,0:40:53.49,Lalai,Lily3,0,0,0,,Terima kasih kepada raja, kita akan menyingkirkan Tonhakites.
Dialog: 0,0:40:53.89,0:40:56.79,Lalai,Lily3,0,0,0,,Selebihnya sampah akan mempertahankan diri.
Dialog: 0,0:40:57.39,0:40:59.76,Lalai,Lily3,0,0,0,,Memandangkan apa yang berlaku, kita boleh katakan,
Dialog: 0,0:40:59.76,0:41:01.83,Lalai,Lilia3,0,0,0,,bahawa dia memberikan nyawanya untuk menyelamatkan negara.
Dialog: 0,0:41:07.10,0:41:08.57,Lalai,Lily3,0,0,0,,Sehingga semuanya tenang,
Dialog: 0,0:41:10.57,0:41:13.21,Lalai,Lily3,0,0,0,,terdapat beberapa kebimbangan,
Dialog: 0,0:41:13.41,0:41:16.38,Lalai,Lily3,0,0,0,,sebab itu saya kumpulkan awak di sini.
Dialog: 0,0:41:18.71,0:41:20.62,Lalai,Lily3,0,0,0,,Andong Kims dan Phunyang Chos
Dialog: 0,0:41:20.62,0:41:22.45,Lalai,Lilia3,0,0,0,,bermusuhan sejak sekian lama.
Dialog: 0,0:41:23.15,0:41:25.75,Lalai,Lily3,0,0,0,,Kami bersatu untuk seketika,
Dialog: 0,0:41:25.75,0:41:27.69,Lalai,Lily3,0,0,0,,untuk menghadapi musuh bersama - raja.
Dialog: 0,0:41:27.96,0:41:29.86,Lalai,Lily3,0,0,0,,Tetapi kini raja telah meninggalkan permainan,
Dialog: 0,0:41:29.86,0:41:32.23,Lalai,Lily3,0,0,0,,dan saya takut kedua-dua puak akan mula bergaduh semula
Dialog: 0,0:41:32.23,0:41:34.00,Lalai,Lily3,0,0,0,,dan bersaing antara satu sama lain.
Dialog: 0,0:41:35.20,0:41:36.23,Lalai,Lily3,0,0,0,,Sebelumnya
Dialog: 0,0:41:37.33,0:41:39.20,Lalai,Lily3,0,0,0,,mari kita teruskan ke agenda,
Dialog: 0,0:41:40.04,0:41:41.97,Lalai,Lily3,0,0,0,,Saya menyediakan sesuatu untuk menguatkan
Dialog: 0,0:41:41.97,0:41:43.64,Lalai,Lily3,0,0,0,,penyatuan dua keluarga.
Dialog: 0,0:41:52.28,0:41:55.58,Lalai,Lily3,0,0,0,,Pemberontakan di mahkamah...
Dialog: 0,0:41:59.55,0:42:00.82, Lalai, Lily3,0,0,0,, Pindah atau tumbangkan?
Dialog: 0,0:42:02.22,0:42:03.22,Lalai,Lily3,0,0,0,,Ini bermakna,
Dialog: 0,0:42:04.73,0:42:06.09,Lalai,Lilia3,0,0,0,,bahawa kamu sedang merancang pengkhianatan.
Dialog: 0,0:42:07.33,0:42:10.23,Lalai,Lily3,0,0,0,,Ia tersembunyi di lubuk jiwa anda.
Dialog: 0,0:42:10.90,0:42:12.90,Lalai,Lily3,0,0,0,,Raja sudah mati,
Dialog: 0,0:42:12.90,0:42:15.20,Lalai,Lily3,0,0,0,,kenapa tinggalkan dokumen sedemikian?
Dialog: 0,0:42:15.20,0:42:17.61,Lalai,Lily3,0,0,0,,Untuk berkongsi tanggungjawab.
Dialog: 0,0:42:18.34,0:42:22.08,Lalai,Lily3,0,0,0,,Ini akan menghalang mana-mana keluarga daripada melanggar syarat pakatan.
Dialog: 0,0:42:22.38,0:42:24.71,Lalai,Lily3,0,0,0,,Saya akan meninggalkan bukti untuk menekankan bahawa kita berada dalam bot yang sama.
Dialog: 0,0:42:26.11,0:42:27.75,Lalai,Lily3,0,0,0,,Selagi anda bersetuju dengan ini,
Dialog: 0,0:42:28.35,0:42:31.92,Lalai,Lily3,0,0,0,,Saya jamin dua keluarga boleh
Dialog: 0,0:42:32.99,0:42:34.96, Lalai, Lily3,0,0,0,, wujud bersama dalam kuasa.
Dialog: 0,0:42:35.49,0:42:36.79,Lalai,Lily3,0,0,0,,Ini bermakna,
Dialog: 0,0:42:37.46,0:42:40.53,Lalai,Lily3,0,0,0,,yang anda mahu mengawal hidup kami.
Dialog: 0,0:42:46.33,0:42:49.10,Lalai,Lily3,0,0,0,,Kami tidak boleh melakukan ini.
Dialog: 0,0:42:55.01,0:42:57.05,Lalai,Lily3,0,0,0,,Apa yang anda benarkan?
Dialog: 0,0:42:57.05,0:42:58.81,Lalai,Lily3,0,0,0,,Beraninya awak kumpulkan askar?
Dialog: 0,0:43:00.62,0:43:02.48,Lalai,Lily3,0,0,0,,Anda mesti bersetuju dengan saya,
Dialog: 0,0:43:03.99,0:43:06.05,Lalai,Lily3,0,0,0,,untuk keluar dari sini hidup-hidup.
Dialog: 0,0:43:14.10,0:43:15.53,Lalai,Lily3,0,0,0,,Kim Byunin
Dialog: 0,0:43:37.72,0:43:38.72,Lalai,galeri penangkapan4,0,0,0,,Yang Mulia.
Dialog: 0,0:43:38.85,0:43:41.76,Lalai,tier4,0,0,0,,Ya. Masuklah.
Dialog: 0,0:43:48.43,0:43:50.57,Lalai,galeri penangkapan4,0,0,0,,-Yang Mulia.\N-Adakah anda mengetahui sesuatu?
Dialog: 0,0:43:50.57,0:43:53.77, Lalai, galeri menembak4,0,0,0,,Seperti yang anda katakan, pintu gerbang istana
Dialog: 0,0:43:54.97,0:43:58.14, Lalai,galeri penangkapan4,0,0,0,,dan semua pintu di sekitar Hanyang ditutup.
Dialog: 0,0:43:59.17,0:44:00.24,Lalai,galeri penangkapan4,0,0,0,,Saya tahu.
Dialog: 0,0:44:01.14,0:44:02.31, Lalai, galeri menembak4,0,0,0,,Bagaimana pula dengan pahlawan?
Dialog: 0,0:44:02.31,0:44:03.58, Lalai, galeri rakaman4,0,0,0,,Tinggal satu tempat,
Dialog: 0,0:44:03.58,0:44:05.35, Lalai, galeri menembak4,0,0,0,, tempat pahlawan meneruskan pencarian mereka.
Dialog: 0,0:44:06.05,0:44:07.82, Lalai, galeri menembak4,0,0,0,,Ini di sebelah tebing.
Dialog: 0,0:44:08.62,0:44:11.75,Lalai,tyra4,0,0,0,,Saya jumpa awak, Cheoljong. Saya akan selamatkan awak.
Dialog: 0,0:44:16.32,0:44:18.99, Lalai, galeri penggambaran4,0,0,0,,Sesuatu membuat saya mengantuk. Anda perlu pergi juga.
Dialog: 0,0:44:22.96,0:44:24.50,Lalai,galeri penangkapan4,0,0,0,,Saya mahu tidur!
Dialog: 0,0:44:27.94,0:44:29.34, Lalai, galeri penangkapan4,0,0,0,,Saya akan pengsan sekarang.
Dialog: 0,0:44:29.34,0:44:31.57,Lalai,tyra4,0,0,0,,Selamat malam, Tuanku.
Dialog: 0,0:44:31.97,0:44:33.74,Lalai,tyra4,0,0,0,,Mimpi indah, ratu.
Dialog: 0,0:44:34.21,0:44:36.34,Lalai,tier4,0,0,0,,Ya. Selamat malam awak juga.
Dialog: 0,0:44:36.54,0:44:37.65,Lalai,tier4,0,0,0,,Ya.
Dialog: 0,0:44:41.38,0:44:42.72,Lalai,tier4,0,0,0,,Sihat.
Dialog: 0,0:44:44.49,0:44:45.65,Lalai,galeri penangkapan4,0,0,0,,Apa?
Dialog: 0,0:44:45.92,0:44:49.39,Lalai,tyra4,0,0,0,,Apabila bercakap tentang kesihatan, anda tidak seharusnya cuai.
Dialog: 0,0:44:51.73,0:44:52.99,Lalai,tyra4,0,0,0,,-Ya, ratu.\N-Ya, ratu.
Dialog: 0,0:45:25.99,0:45:27.00,Lalai,galeri menembak4,0,0,0,,Di manakah permaisuri?
Dialog: 0,0:45:27.03,0:45:29.10,Lalai,tyra4,0,0,0,,Dia tidak sedarkan diri kerana terkejut,
Dialog: 0,0:45:29.10,0:45:30.27, Lalai, galeri penggambaran4,0,0,0,,tetapi dia sedar dengan cepat.
Dialog: 0,0:45:30.60,0:45:31.70, Lalai, galeri menembak4,0,0,0,, Hilang kesedaran?
Dialog: 0,0:45:37.94,0:45:39.37, Lalai,galeri penangkapan4,0,0,0,,Nak ke mana?
Dialog: 0,0:45:52.52,0:45:56.02, Lalai, galeri rakaman4,0,0,0,,Bukan itu yang saya fikirkan, bukan?
Dialog: 0,0:45:57.43,0:45:59.66,Lalai,galeri penangkapan4,0,0,0,,Adakah anda benar-benar bersedia untuk pergi sejauh itu?
Dialog: 0,0:46:02.33,0:46:04.20, Lalai, galeri rakaman4,0,0,0,,-Teruskan sahaja.\N-Anda tidak akan pergi.
Dialog: 0,0:46:04.87,0:46:07.20, Lalai, galeri menembak4,0,0,0,,Jika anda meninggalkan istana, anda akan berada dalam bahaya.
Dialog: 0,0:46:07.27,0:46:08.70, Lalai, galeri rakaman4,0,0,0,,Anda fikir saya tidak tahu ini?
Dialog: 0,0:46:09.20,0:46:10.41, Lalai, galeri rakaman4,0,0,0,,Saya tahu segala-galanya.
Dialog: 0,0:46:10.41,0:46:12.71,Lalai,tyra4,0,0,0,,Anda menggunakan saya sebagai umpan untuk raja,
Dialog: 0,0:46:12.71,0:46:15.08,Lalai,tyra4,0,0,0,,dan kamulah yang mengacukan pedang ke arahnya.
Dialog: 0,0:46:16.21,0:46:17.45,Lalai,galeri penangkapan4,0,0,0,,Saya tahu segala-galanya.
Dialog: 0,0:46:17.65,0:46:19.88,Lalai,galeri penangkapan4,0,0,0,,Selagi anda selamat,
Dialog: 0,0:46:19.88,0:46:21.85,Lalai,tyra4,0,0,0,,Saya bersedia untuk menahan kebencian anda.
Dialog: 0,0:46:22.15,0:46:24.05, Lalai, galeri penangkapan4,0,0,0,, Marah pada saya seperti yang anda mahu.
Dialog: 0,0:46:24.32,0:46:25.99, Lalai, galeri menembak4,0,0,0,,Dan berputus asa sudah.
Dialog: 0,0:46:26.42,0:46:28.26, Lalai, galeri menembak4,0,0,0,,Raja sudah mati.
Dialog: 0,0:46:28.26,0:46:30.79,Lalai,tier4,0,0,0,,No. Dia masih hidup.
Dialog: 0,0:46:31.79,0:46:34.30,Lalai,galeri menembak4,0,0,0,,Anda tahu, raja bukanlah salah seorang yang akan mati dengan mudah.
Dialog: 0,0:46:34.66,0:46:37.07,Lalai,tyra4,0,0,0,,Bukankah itu sebabnya anda tergesa-gesa dengan pertabalan?
Dialog: 0,0:46:37.07,0:46:38.17,Lalai,galeri penangkapan4,0,0,0,,Yang Mulia.
Dialog: 0,0:46:39.37,0:46:40.37,Lalai,galeri penangkapan4,0,0,0,,Sila.
Dialog: 0,0:46:42.07,0:46:44.51, Lalai, galeri menembak4,0,0,0,,Anda mesti membelakangi raja untuk terus hidup.
Dialog: 0,0:46:47.68,0:46:49.51, Lalai, galeri menembak4,0,0,0,,Anda ingin tahu mengapa saya memilih raja?
Dialog: 0,0:46:50.61,0:46:52.58,Lalai,galeri penangkapan4,0,0,0,,Saya akan menjawab anda.
Dialog: 0,0:46:53.18,0:46:55.25, Lalai, galeri menembak4,0,0,0,,Jika sesiapa layak menjadi raja,
Dialog: 0,0:46:55.62,0:46:57.52,Lalai,tier4,0,0,0,,kemudian hanya Baginda.
Dialog: 0,0:46:58.32,0:47:00.49,Lalai,galeri menembak4,0,0,0,,Dia adalah calon yang paling sesuai.
Dialog: 0,0:47:01.12,0:47:04.86, Lalai, galeri penangkapan4,0,0,0,, Jadi jangan cuba membuat pilihan untuk saya.
Dialog: 0,0:47:04.86,0:47:05.99,Lalai,galeri penangkapan4,0,0,0,,Jika anda meneruskan,
Dialog: 0,0:47:12.63,0:47:14.20, Lalai, galeri menembak4,0,0,0,, anda tidak akan meninggalkan saya pilihan.
Dialog: 0,0:47:15.94,0:47:18.94, Lalai, galeri menembak4,0,0,0,,Soyeon, bagaimana awak boleh halakan anak panah ke arah saya?
Dialog: 0,0:47:19.17,0:47:20.64,Lalai,menembak4,0,0,0,,Anda tahu perasaan saya.
Dialog: 0,0:47:21.88,0:47:24.11,Lalai,tyra4,0,0,0,,Jika anda sangat mencintainya,
Dialog: 0,0:47:24.81,0:47:26.88,Lalai,tyra4,0,0,0,,bukankah saya sepatutnya faham,
Dialog: 0,0:47:26.88,0:47:28.72,Lalai,tyra4,0,0,0,,bahawa Kim So-yeon telah berubah?
Dialog: 0,0:47:31.39,0:47:32.42, Lalai, galeri menembak4,0,0,0,, Tengok saya.
Dialog: 0,0:47:32.69,0:47:35.69,Default,tyra4,0,0,0,, Adakah saya benar-benar wanita yang awak impikan selama ini?
Dialog: 0,0:47:35.69,0:47:38.23,Lalai,tyra4,0,0,0,,Saya adalah orang yang berbeza sama sekali, tetapi anda tidak tahu itu.
Dialog: 0,0:47:38.76,0:47:40.06,Lalai,tyra4,0,0,0,,Orang yang anda sayangi, -
Dialog: 0,0:47:41.20,0:47:42.83,Lalai,menembak4,0,0,0,,hanya cangkerang.
Dialog: 0,0:47:42.86,0:47:44.80,Lalai,tyra4,0,0,0,,-Soyeon.\N-Soyeon sebenar, yang anda sayangi,
Dialog: 0,0:47:44.80,0:47:46.17, Lalai,galeri penangkapan4,0,0,0,,tiada lagi.
Dialog: 0,0:47:47.44,0:47:49.44,Lalai,galeri menembak4,0,0,0,,Apa yang awak cakapkan?
Dialog: 0,0:47:54.74,0:47:57.25,Lalai,galeri penggambaran4,0,0,0,,Soyeon sebenar tidak dapat menembak anda,
Dialog: 0,0:47:57.91,0:47:59.98,Lalai,tira4,0,0,0,,kerana saya menyayangi awak seperti abang.
Dialog: 0,0:48:01.12,0:48:02.42, Lalai, galeri rakaman4,0,0,0,,Tetapi saya berbeza.
Dialog: 0,0:48:05.02,0:48:07.12,Lalai,galeri penangkapan4,0,0,0,,Saya boleh menembak awak seberapa banyak yang saya mahu.
Dialog: 0,0:48:18.77,0:48:20.10,Lalai,galeri penangkapan4,0,0,0,,Saya memberi amaran kepada anda!
Dialog: 0,0:48:21.67,0:48:23.37,Lalai,tyra4,0,0,0,,Saya tidak mahu menyakitinya.
Dialog: 0,0:49:03.95,0:49:04.98,Lalai,galeri penangkapan4,0,0,0,,Apa yang kamu lakukan?
Dialog: 0,0:49:06.35,0:49:08.92,Lalai,galeri penangkapan4,0,0,0,,Ia sangat jelas sehingga kami memutuskan ia adalah petunjuk.
Dialog: 0,0:49:09.42,0:49:11.52,Lalai,bilik menembak4,0,0,0,,Saya datang kerana saya mahu hidup.
Dialog: 0,0:49:11.82,0:49:15.06,Lalai,tyra4,0,0,0,,Apabila saya tidak melihat awak, saya rasa saya akan mati kerana cemas.
Dialog: 0,0:49:16.96,0:49:18.43, Lalai,galeri penangkapan4,0,0,0,,Lupakan dan kembali.
Dialog: 0,0:49:19.69,0:49:20.90, Lalai, galeri menembak4,0,0,0,,Tidak, ratu.
Dialog: 0,0:49:21.00,0:49:23.36, Lalai, galeri menembak4,0,0,0,,Jika anda mahu pergi bersendirian, anda perlu memijak saya.
Dialog: 0,0:49:32.91,0:49:34.51,Lalai,galeri penangkapan4,0,0,0,,Empat hari lagi.
Dialog: 0,0:49:36.94,0:49:38.68, Lalai, galeri penggambaran4,0,0,0,, Pertabalan dalam empat hari.
Dialog: 0,0:49:38.68,0:49:40.95, Lalai, galeri menembak4,0,0,0,,Bagaimana anda mencari seluruh hutan
Dialog: 0,0:49:40.95,0:49:43.05, Lalai, galeri menembak4,0,0,0,,dan adakah anda akan menemui raja seorang diri?
Dialog: 0,0:49:45.92,0:49:47.16,Lalai,galeri penangkapan4,0,0,0,,Adakah anda menyeringai sekarang?
Dialog: 0,0:49:47.39,0:49:48.59,Lalai,galeri penangkapan4,0,0,0,,Ya, Tuanku.
Dialog: 0,0:49:49.02,0:49:50.93, Lalai, galeri menembak4,0,0,0,,Terdapat banyak haiwan liar di pergunungan.
Dialog: 0,0:49:50.93,0:49:52.63, Lalai,galeri penangkapan4,0,0,0,,Anda tidak akan bertahan lama di sana.
Dialog: 0,0:49:52.86,0:49:54.60, Lalai, galeri menembak4,0,0,0,, Serigala boleh memakan anda.
Dialog: 0,0:49:55.30,0:49:57.97, Lalai,galeri menembak4,0,0,0,,Atau pahlawan mungkin menemui badan beku anda.
Dialog: 0,0:49:58.70,0:50:02.47,Lalai,galeri penangkapan4,0,0,0,,Bagaimana boleh. Sangat menakutkan! Saya benar-benar menggeletar ketakutan.
Dialog: 0,0:50:02.47,0:50:04.01, Lalai, galeri penangkapan4,0,0,0,, Katakan apa yang anda mahu: jangan takut saya.
Dialog: 0,0:50:05.17,0:50:06.21,Lalai,galeri penangkapan4,0,0,0,,Jom balik.
Dialog: 0,0:50:06.41,0:50:08.58,Lalai,tyra4,0,0,0,,Oleh kerana permaisuri tidak mahu kami pergi bersamanya,
Dialog: 0,0:50:08.58,0:50:11.48, Lalai, galeri menembak4,0,0,0,,kami akan dihukum kerana tidak dapat menghalangnya,
Dialog: 0,0:50:11.71,0:50:14.52,Lalai,tyra4,0,0,0,,akan memaksa kita untuk meminum secawan racun,
Dialog: 0,0:50:15.28,0:50:17.85, Lalai, galeri penggambaran4,0,0,0,, dan kita akan jatuh ke dalam tidur abadi.
Dialog: 0,0:50:32.33,0:50:34.30,Lalai,galeri penangkapan4,0,0,0,,Baik. Awak boleh ikut saya.
Dialog: 0,0:50:38.11,0:50:39.37, Lalai, galeri menembak4,0,0,0,,Ini bukan percutian,
Dialog: 0,0:50:39.37,0:50:40.41, Lalai, galeri penangkapan4,0,0,0,,mengapa anda memerlukannya?
Dialog: 0,0:50:40.74,0:50:43.08, Lalai, galeri menembak4,0,0,0,,Bagaimanakah anda akan melepasi kubu di Hanyang?
Dialog: 0,0:50:44.21,0:50:47.22, Lalai, galeri menembak4,0,0,0,,Saya fikir saya boleh melompat ke atas dinding,
Dialog: 0,0:50:47.22,0:50:49.15, Lalai, galeri penangkapan4,0,0,0,, tetapi sekarang kerana anda ia tidak akan berjaya seperti itu.
Dialog: 0,0:50:49.22,0:50:53.59, Lalai, galeri menembak4,0,0,0,,Kubu di Hanyang sangat tinggi, bagaimana anda akan melompat ke atasnya?
Dialog: 0,0:50:55.19,0:50:56.52, Lalai, galeri menembak4,0,0,0,,Adakah anda mentertawakan saya lagi?
Dialog: 0,0:50:58.36,0:51:01.43,Lalai,galeri penangkapan4,0,0,0,,Kami sudah uruskan semuanya. Anda tidak perlu risau.
Dialog: 0,0:51:14.85,0:51:16.08, Lalai,galeri penangkapan4,0,0,0,,Yang Mulia.
Dialog: 0,0:51:25.37,0:51:26.91, Lalai, galeri menembak4,0,0,0,,Saya fikir kita akan meraikannya,
Dialog: 0,0:51:27.41,0:51:29.51,Lalai,tier4,0,0,0,,tetapi jika dilihat dari wajah anda, anda sedang menghapuskan kekalahan.
Dialog: 0,0:51:29.68,0:51:31.51,Lalai,tyra4,0,0,0,,Luka apa yang boleh anda sembuhkan seperti ini?
Dialog: 0,0:51:31.97,0:51:33.47, Lalai, galeri menembak4,0,0,0,,Di manakah anda cedera?
Dialog: 0,0:51:35.72,0:51:38.49, Lalai, galeri menembak4,0,0,0,, Sentuh cawan saya sekali lagi,
Dialog: 0,0:51:38.95,0:51:41.49,Lalai,tyra4,0,0,0,,dan saya akan potong tangan awak.
Dialog: 0,0:51:46.36,0:51:48.43,Lalai,tyra4,0,0,0,,Jika anda sangat mencintainya,
Dialog: 0,0:51:48.82,0:51:50.66,Lalai,tyra4,0,0,0,,bukankah saya sepatutnya faham,
Dialog: 0,0:51:50.89,0:51:52.74,Lalai,tyra4,0,0,0,,bahawa Kim So-yeon telah berubah?
Dialog: 0,0:51:53.37,0:51:56.26,Lalai,tyra4,0,0,0,,Malam tadi dia kelihatan sama seperti anda.
Dialog: 0,0:51:58.91,0:52:01.37, Lalai, galeri rakaman4,0,0,0,, Apa? Cinta?
Dialog: 0,0:52:02.20,0:52:03.70, Lalai, galeri menembak4,0,0,0,, Sungguh keji!
Dialog: 0,0:52:04.18,0:52:05.55, Lalai, galeri menembak4,0,0,0,,Saya sudah keliru,
Dialog: 0,0:52:05.55,0:52:06.91, Lalai, galeri rakaman4,0,0,0,, dan anda bercakap tentang cinta di sini.
Dialog: 0,0:52:29.91,0:52:31.11,Lalai,galeri penangkapan4,0,0,0,,Anda sudah lewat.
Dialog: 0,0:52:32.70,0:52:34.34, Lalai, galeri penggambaran4,0,0,0,, Pergi ke bilik anda dan berehat.
Dialog: 0,0:52:34.70,0:52:37.14, Lalai, galeri penggambaran4,0,0,0,,Dapur dihidupkan, jadi ia akan menjadi panas.
Dialog: 0,0:52:37.55,0:52:40.22,Lalai,tyra4,0,0,0,,Mengapa anda tidak bertanya apa-apa?
Dialog: 0,0:52:41.09,0:52:42.78,Lalai,tyra4,0,0,0,,Sebab saya seorang bapa.
Dialog: 0,0:52:53.03,0:52:54.93, Lalai,galeri penangkapan4,0,0,0,,Apa yang mereka lakukan?
Dialog: 0,0:52:54.93,0:52:57.70,Lalai,menembak4,0,0,0,,Surat dengan rancangan untuk pengkhianatan.
Dialog: 0,0:52:58.09,0:53:00.87,Lalai,menembak4,0,0,0,,Tanpa pengetahuan saya? Ia sangat berisiko.
Dialog: 0,0:53:00.87,0:53:02.91, Lalai, galeri menembak4,0,0,0,,Sebaik sahaja kami mendapatnya, ia akan menjadi senjata kami,
Dialog: 0,0:53:02.91,0:53:04.24,Lalai,tier4,0,0,0,,jadi jangan risau.
Dialog: 0,0:53:04.64,0:53:06.43,Lalai,galeri penangkapan4,0,0,0,,Saya akan bawakannya kepada anda.
Dialog: 0,0:53:06.74,0:53:08.05,Lalai,tyra4,0,0,0,,Anda dituduh khianat.
Dialog: 0,0:53:08.05,0:53:10.41, Lalai, galeri menembak4,0,0,0,,Jika anda kembali serta-merta selepas raja hilang,
Dialog: 0,0:53:11.87,0:53:13.24, Lalai,galeri penangkapan4,0,0,0,,ini akan mencurigakan.
Dialog: 0,0:53:13.72,0:53:15.59, Lalai, galeri penangkapan4,0,0,0,,Saya tidak mahu kembali.
Dialog: 0,0:53:16.24,0:53:18.01, Lalai, galeri menembak4,0,0,0,,Saya akan gembira,
Dialog: 0,0:53:18.86,0:53:22.28, Lalai, galeri penangkapan4,0,0,0,,jika saya boleh terus membantu anda dari bayang-bayang.
Dialog: 0,0:53:25.62,0:53:29.12,Lalai,tyra4,0,0,0,,By the way, saya dengar permaisuri meninggalkan istana pada waktu malam.
Dialog: 0,0:53:29.97,0:53:32.39,Lalai,tyra4,0,0,0,,Beraninya dia melarikan diri di tengah malam?
Dialog: 0,0:53:33.66,0:53:35.61,Lalai,tyra4,0,0,0,,Saya tidak memberitahu sesiapa tentang perkara ini,
Dialog: 0,0:53:35.91,0:53:37.30,Lalai,tier4,0,0,0,,tetapi anda sudah tahu segala-galanya.
Dialog: 0,0:53:37.47,0:53:40.24,Lalai,tyra4,0,0,0,,Mengetahui apa itu ratu,
Dialog: 0,0:53:40.70,0:53:42.91, Lalai, tyra4,0,0,0,,Saya tidak fikir dia hanya melarikan diri.
Dialog: 0,0:53:43.68,0:53:44.82, Lalai, galeri rakaman4,0,0,0,, Kenapa?
Dialog: 0,0:53:45.84,0:53:49.51,Lalai,galeri menembak4,0,0,0,,Saya pasti dia mahu mencari raja untuk mengembalikan segala-galanya ke tempatnya.
Dialog: 0,0:53:50.34,0:53:54.68,Lalai,tyra4,0,0,0,,Dia mesti yakin bahawa raja masih hidup.
Dialog: 0,0:53:55.62,0:53:59.30,Lalai,tyra4,0,0,0,,Dia mesti ada sebab untuk mempercayai perkara ini.
Dialog: 0,0:53:59.30,0:54:02.07,Lalai,tyra4,0,0,0,,Dia menanggalkan pakaiannya dan meninggalkan istana,
Dialog: 0,0:54:02.07,0:54:03.30,Lalai,tier4,0,0,0,,yang bermaksud
Dialog: 0,0:54:04.49,0:54:07.03,Lalai,tyra4,0,0,0,,sekarang dia hanya seorang wanita biasa.
Dialog: 0,0:54:07.30,0:54:09.20,Lalai,tyra4,0,0,0,,Walaupun mengetahui bahawa dia berbohong,
Dialog: 0,0:54:09.20,0:54:12.11,Lalai,tira4,0,0,0,,Saya cuba menerima dia demi Byonin.
Dialog: 0,0:54:13.53,0:54:15.97,Lalai,tyra4,0,0,0,,Pasangan diraja nampaknya sangat menyayangi satu sama lain,
Dialog: 0,0:54:16.74,0:54:20.34, Lalai, tyra4,0,0,0,, jadi apa kata kita kuburkan mereka bersama.
Dialog: 0,0:54:22.49,0:54:24.51,Lalai,galeri penangkapan4,0,0,0,,Jaga ini?
Dialog: 0,0:54:36.57,0:54:37.59,Lalai,menembak4,0,0,0,,En.
Dialog: 0,0:54:37.97,0:54:40.87,Lalai,tyra4,0,0,0,,Saya telah kembali untuk membantu Ratu Janda.
Dialog: 0,0:54:42.37,0:54:46.11,Lalai,tyra4,0,0,0,,Adakah mereka yang bertanggungjawab atas kematian raja?
Dialog: 0,0:54:46.74,0:54:47.80,Lalai,tier4,0,0,0,,Ya.
Dialog: 0,0:54:47.80,0:54:49.68,Lalai,tyra4,0,0,0,,Kami hanya mengumpul herba.
Dialog: 0,0:54:49.84,0:54:52.34,Lalai,tyra4,0,0,0,,Kami tidak pernah bertemu raja.
Dialog: 0,0:54:53.24,0:54:56.34, Lalai, galeri menembak4,0,0,0,,Ternyata, makhluk tanpa akar itu
Dialog: 0,0:54:56.72,0:54:59.01,Lalai,tyra4,0,0,0,,menangkap naga tanpa disedari.
Dialog: 0,0:55:25.32,0:55:27.59,Lalai,galeri menembak4,0,0,0,,Anda melonjak dengan begitu mendadak, nampaknya semuanya baik-baik saja dengan anda.
Dialog: 0,0:55:28.14,0:55:29.55,Lalai,galeri menembak4,0,0,0,,Saya fikir awak sudah mati.
Dialog: 0,0:55:30.01,0:55:31.05, Lalai, galeri menembak4,0,0,0,,Siapa kamu?
Dialog: 0,0:55:31.05,0:55:33.59, Lalai,galeri penangkapan4,0,0,0,,Apa pendapat anda? Pakar herba, jelas.
Dialog: 0,0:55:33.72,0:55:35.66, Lalai, galeri menembak4,0,0,0,,Kenapa lagi saya tinggal di dalam hutan?
Dialog: 0,0:55:37.43,0:55:38.99,Lalai,galeri menembak4,0,0,0,,Adakah anda yang menyelamatkan saya?
Dialog: 0,0:55:39.86,0:55:43.32,Lalai,galeri penangkapan4,0,0,0,,Tidak juga. Katakan saja saya jumpa awak dan bawa awak ke sini.
Dialog: 0,0:55:43.62,0:55:45.24,Lalai,tyra4,0,0,0,,Anda memakai pakaian mahal,
Dialog: 0,0:55:45.24,0:55:47.16,Lalai,tier4,0,0,0,,jadi saya fikir awak
Dialog: 0,0:55:47.16,0:55:49.01,Lalai,tyra4,0,0,0,,balas saya kerana menyelamatkan nyawa saya.
Dialog: 0,0:55:49.01,0:55:50.43, Lalai, galeri penggambaran4,0,0,0,,Anda perlu membayar untuk semuanya, anda tahu?
Dialog: 0,0:55:51.78,0:55:53.37, Lalai, galeri menembak4,0,0,0,,Tetapi anda tidak mempunyai apa-apa.
Dialog: 0,0:55:53.74,0:55:56.11,Lalai,tyra4,0,0,0,,Kain itu kelihatan mahal,
Dialog: 0,0:55:56.11,0:55:58.82,Lalai,tier4,0,0,0,,tetapi saya tidak dapat menjual kain buruk ini.
Dialog: 0,0:56:00.18,0:56:01.49, Lalai, galeri penggambaran4,0,0,0,,Saya baru sahaja membakar semuanya.
Dialog: 0,0:56:02.78,0:56:03.78, Lalai, galeri penangkapan4,0,0,0,, Bakar?
Dialog: 0,0:56:03.78,0:56:07.49, Lalai, galeri menembak4,0,0,0,,Terdapat pahlawan berjalan di mana-mana dan mencari sesuatu.
Dialog: 0,0:56:09.45,0:56:11.93, Lalai, galeri menembak4,0,0,0,,Adakah saya salah membawa awak ke sini?
Dialog: 0,0:56:13.43,0:56:14.47, Lalai,galeri penangkapan4,0,0,0,,Pengumpul!
Dialog: 0,0:56:16.20,0:56:18.26, Lalai, galeri menembak4,0,0,0,,Jika anda melarikan diri tanpa membayar,
Dialog: 0,0:56:18.26,0:56:20.09, Lalai, galeri menembak4,0,0,0,,Saya akan potong tangan awak.
Dialog: 0,0:56:21.74,0:56:22.84, Lalai,galeri penangkapan4,0,0,0,,Ingat.
Dialog: 0,0:56:34.72,0:56:36.41, Lalai, galeri penggambaran4,0,0,0,,Saya membawakan anda yang terbaik.
Dialog: 0,0:56:53.47,0:56:55.47, Lalai,galeri penangkapan4,0,0,0,,Jadi, jadi, dan apa seterusnya?
Dialog: 0,0:56:55.47,0:56:58.18,Default,tyra4,0,0,0,,Jadi, semasa pengebumian mereka menggunakan mayat orang lain.
Dialog: 0,0:56:58.18,0:57:00.74,Lalai,tyra4,0,0,0,,Jika mereka boleh mengadakan pertabalan dalam masa 6 hari,
Dialog: 0,0:57:01.55,0:57:02.57, Lalai, galeri menembak4,0,0,0,, permainan tamat.
Dialog: 0,0:57:03.55,0:57:05.12, Lalai,galeri penangkapan4,0,0,0,,Bagaimana anda tahu perkara ini?
Dialog: 0,0:57:05.12,0:57:07.34, Lalai,galeri penangkapan4,0,0,0,,Orang-orang bodoh ini sangat boleh diramal!
Dialog: 0,0:57:08.09,0:57:10.84, Lalai, galeri menembak4,0,0,0,,Orang-orang bodoh ini patut dihukum!
Dialog: 0,0:57:23.80,0:57:25.59,Default,Spillik,0,0,0,,Ini adalah pengakuan seorang pengikut Tonhak.
Dialog: 0,0:57:26.24,0:57:28.51,Lalai,Spillik,0,0,0,,Saya sudah mempunyai idea tentang siapa yang harus dipersalahkan untuk perkara ini.
Dialog: 0,0:57:29.07,0:57:30.70,Lalai,Spillik,0,0,0,,Cari saat yang sesuai selepas pertabalan,
Dialog: 0,0:57:30.70,0:57:32.01,Lalai,Spillik,0,0,0,,untuk mengumumkan ini.
Dialog: 0,0:57:34.24,0:57:35.24,Lalai,Spillit,0,0,0,,Bapa.
Dialog: 0,0:57:37.82,0:57:40.91,Lalai,Spillik,0,0,0,,Boleh saya minta awak jaga pengawal istana buat masa ini?
Dialog: 0,0:57:41.74,0:57:42.89,Lalai,Spillik,0,0,0,,Kenapa?
Dialog: 0,0:57:44.14,0:57:45.41,Lalai,Spillit,0,0,0,,Saya mahukannya sendiri
Dialog: 0,0:57:47.18,0:57:49.95,Default,Spillit,0,0,0,,bawa kepala raja dan permaisuri.
Dialog: 0,0:57:56.99,0:58:00.26,Lalai,Spillik,0,0,0,,3 hari sebelum pertabalan
Dialog: 0,0:58:02.30,0:58:03.34,Lalai,Spillik,0,0,0,,Benin!
Dialog: 0,0:58:06.07,0:58:08.05,Lalai,Spillik,0,0,0,,Adakah anda akan mencari ratu?
Dialog: 0,0:58:09.07,0:58:11.28,Lalai,Spillik,0,0,0,,Mengapa dia meninggalkan istana?
Dialog: 0,0:58:11.28,0:58:14.14,Lalai,Spillik,0,0,0,,Anda sepatutnya tahu sebabnya, anda begitu rapat.
Dialog: 0,0:58:14.95,0:58:18.51,Lalai,Spillit,0,0,0,,Permaisuri bukan lagi Soyeon yang saya kenali.
Dialog: 0,0:58:19.41,0:58:20.41,Lalai,Spillik,0,0,0,,Apa?
Dialog: 0,0:58:39.20,0:58:41.64,Lalai,Spillik,0,0,0,,Saya mesti mengembalikan raja.
Dialog: 0,0:58:41.64,0:58:45.22,Lalai,Spillit,0,0,0,,Sesetengah jenis kunci tipis. Mungkin saya boleh membukanya.
Dialog: 0,0:58:52.28,0:58:54.16,Lalai,Spillik,0,0,0,,Mesti ada sembelit kedua di suatu tempat.
Dialog: 0,0:58:54.39,0:58:55.78,Lalai,Spillik,0,0,0,,Saya terkejut anda membukanya.
Dialog: 0,0:58:55.78,0:58:56.95,Lalai,Spillik,0,0,0,,Hon.
Dialog: 0,0:59:02.39,0:59:04.16,Lalai,Spillik,0,0,0,,Putera Yeonpyeong, awak okay?
Dialog: 0,0:59:06.34,0:59:07.80,Lalai,Spillik,0,0,0,,Bagaimana anda sampai ke sini?
Dialog: 0,0:59:08.20,0:59:10.53,Lalai,Spillik,0,0,0,,Anda tahu, saya berkawan dengan semua orang di istana.
Dialog: 0,0:59:11.30,0:59:14.70,Lalai,Spillik,0,0,0,,Kamu dikunci di sini hanya kerana kamu kawan raja.
Dialog: 0,0:59:15.68,0:59:16.87,Lalai,Spillik,0,0,0,,Jangan risau tentang apa-apa.
Dialog: 0,0:59:17.24,0:59:19.87,Lalai,Spillik,0,0,0,,Saya akan bawa awak keluar, walau apa pun.
Dialog: 0,0:59:19.87,0:59:21.34,Lalai,Spillik,0,0,0,,Anda adalah kawan sejati.
Dialog: 0,0:59:22.24,0:59:25.66,Lalai,Spillik,0,0,0,,Pengabdian anda tidak berbelah bahagi walaupun dalam keadaan yang tidak menentu.
Dialog: 0,0:59:26.51,0:59:27.59,Lalai,Spillik,0,0,0,,Sudah tentu.
Dialog: 0,0:59:28.22,0:59:31.05,Lalai,Spillik,0,0,0,,Anda berkawan dengan saya bukan kerana saya dari Andonian Kims.
Dialog: 0,0:59:31.55,0:59:34.99,Default,Spillik,0,0,0,,Dan saya berkawan dengan awak bukan kerana awak kawan rapat raja.
Dialog: 0,0:59:36.89,0:59:38.24,Lalai,Spillik,0,0,0,,-Tepat sekali.\N-Perkaranya,
Dialog: 0,0:59:38.24,0:59:40.49,Lalai,Spikyulka,0,0,0,,bahawa kini terdapat huru-hara sepenuhnya di istana,\N dan seterusnya.
Dialog: 0,0:59:40.97,0:59:43.61,Default,Spillik,0,0,0,,Mereka mahu menyematkan pembunuhan raja kepada pengikut Tonhak.
Dialog: 0,0:59:44.57,0:59:46.68,Lalai,Spillik,0,0,0,,Saya takut orang yang tidak bersalah akan menderita.
Dialog: 0,0:59:47.43,0:59:48.51,Lalai,Spillit,0,0,0,,Malah ratu
Dialog: 0,0:59:49.57,0:59:52.34,Lalai,Spillie,0,0,0,,tiba-tiba hilang di tengah malam.
Dialog: 0,0:59:55.32,0:59:57.76,Lalai,Spillit,0,0,0,,Apa maksud anda ratu telah hilang?
Dialog: 0,0:59:57.76,1:00:00.49,Lalai,Spillie,0,0,0,,Dia hilang dari istana
Dialog: 0,1:00:01.12,1:00:03.36,Lalai,Spillik,0,0,0,,bersama-sama dengan wanita mahkamah dan pembantu rumah.
Dialog: 0,1:00:03.95,1:00:06.39,Lalai,Biryulka,0,0,0,,Benin baru sahaja meninggalkan istana
Dialog: 0,1:00:06.39,1:00:08.66,Lalai,Spillie,0,0,0,,untuk mencari dia,
Dialog: 0,1:00:09.80,1:00:11.99,Lalai,Spillik,0,0,0,,tetapi penampilannya mengganggu saya.
Dialog: 0,1:00:11.99,1:00:13.24,Lalai,Spillik,0,0,0,,Mengapa awak mengganggu?
Dialog: 0,1:00:13.24,1:00:15.41,Lalai,Spillik,0,0,0,,Mungkin saya mengada-ada,
Dialog: 0,1:00:16.24,1:00:17.34,Lalai,Spillik,0,0,0,,tetapi dia kelihatan seperti ini,
Dialog: 0,1:00:18.30,1:00:20.24,Lalai,Spillik,0,0,0,,seolah-olah dia mahu mengoyakkannya.
Dialog: 0,1:00:27.57,1:00:28.62,Lalai,Spillie,0,0,0,,Mommies.
Dialog: 0,1:00:33.05,1:00:34.28,Lalai,Spillik,0,0,0,,Apa? Untuk apa?
Dialog: 0,1:00:35.39,1:00:36.43,Lalai,Spillik,0,0,0,,Apa?
Dialog: 0,1:00:41.57,1:00:42.59,Lalai,Spillik,0,0,0,,Sekarang semuanya teratur.
Dialog: 0,1:00:43.89,1:00:44.97,Lalai,Spillik,0,0,0,,Jom.
Dialog: 0,1:00:44.97,1:00:47.57,Lalai,Spillkins,0,0,0,,Apa itu, Lady Choi? Awak takutkan saya.
Dialog: 0,1:00:50.01,1:00:51.74,Lalai,Spillik,0,0,0,,Anda perlu sentiasa berjaga-jaga.
Dialog: 0,1:00:53.03,1:00:54.18,Lalai,Spillik,0,0,0,,Okey.
Dialog: 0,1:00:55.64,1:00:58.07,Lalai,Spillik,0,0,0,,Anda sentiasa berhati-hati. lulus.
Dialog: 0,1:00:59.24,1:01:00.51,Lalai,Spillik,0,0,0,,Pergi, teruskan.
Dialog: 0,1:01:01.34,1:01:02.45,Lalai,Spillik,0,0,0,,Biar saya bantu.
Dialog: 0,1:01:03.91,1:01:05.76,Lalai,Spillik,0,0,0,,Sila berhati-hati.
Dialog: 0,1:01:06.05,1:01:09.45,Lalai,Spillik,0,0,0,,Wah, saya tidak percaya anda membawa begitu banyak!
Dialog: 0,1:01:09.78,1:01:10.86,Lalai,Spillik,0,0,0,,Apakah ini?
Dialog: 0,1:01:11.43,1:01:13.03,Lalai,Spillit,0,0,0,,Candied bell root.
Dialog: 0,1:01:13.36,1:01:14.59,Lalai,Spillit,0,0,0,,Candied bell root?
Dialog: 0,1:01:14.59,1:01:17.93,Lalai,Spillik,0,0,0,,Saya menerimanya daripada seseorang yang istimewa dan sangat menghargainya.
Dialog: 0,1:01:18.49,1:01:19.87,Lalai,Spillik,0,0,0,,Anda boleh terima, Yang Mulia.
Dialog: 0,1:01:20.07,1:01:21.70,Lalai,Spillik,0,0,0,,-Kemudian saya akan mencuba satu.\N-Sudah tentu.
Dialog: 0,1:01:24.41,1:01:26.93,Lalai,Spillit,0,0,0,,Ia adalah satu keajaiban betapa lazatnya. Cuba satu.
Dialog: 0,1:01:26.93,1:01:28.11,Lalai,Spillik,0,0,0,,Hon Young, dan awak?
Dialog: 0,1:01:28.61,1:01:30.30,Lalai,Spillik,0,0,0,,-Baiklah.\N-Sini, anda cuba.
Dialog: 0,1:01:30.30,1:01:31.32,Lalai,Spillik,0,0,0,,Terima kasih.
Dialog: 0,1:01:32.34,1:01:33.47,Lalai,Spillit,0,0,0,,Ini sangat lazat.
Dialog: 0,1:01:38.39,1:01:41.09,Lalai,Spillit,0,0,0,,Puan Mahkamah Choi! Bagaimana pula?
Dialog: 0,1:01:41.09,1:01:42.45,Lalai,Spillik,0,0,0,,-Saya tidak apa-apa.\N-Awak okey?
Dialog: 0,1:01:45.30,1:01:46.72,Lalai,Spillik,0,0,0,,Ya, semuanya baik-baik saja.
Dialog: 0,1:01:47.49,1:01:49.57,Lalai,Spillik,0,0,0,,Tuhan, saya baik-baik saja, ratu.
Dialog: 0,1:01:49.99,1:01:51.12,Lalai,Spillik,0,0,0,,-Teruskan.\N-Baiklah!
Dialog: 0,1:01:54.07,1:01:56.53,Lalai,Spillik,0,0,0,,Di manakah raja?
Dialog: 0,1:01:58.74,1:02:00.84,Lalai,Spillik,0,0,0,,Yang Mulia, anda dibesarkan seperti bunga yang halus.
Dialog: 0,1:02:00.84,1:02:02.74,Lalai,Spillik,0,0,0,,Adakah anda benar-benar selesa tidur seperti itu?
Dialog: 0,1:02:03.20,1:02:04.91,Lalai,Spillik,0,0,0,,Ya. Saya telah melakukan ini banyak kali.
Dialog: 0,1:02:06.22,1:02:07.51,Lalai,Spillik,0,0,0,,Betulkah? awak?
Dialog: 0,1:02:08.09,1:02:09.51,Lalai,Spillik,0,0,0,,Malah saya tidak pernah melakukannya.
Dialog: 0,1:02:09.91,1:02:11.91,Lalai,Spillie,0,0,0,,Lepaskannya. Ini mengarut.
Dialog: 0,1:02:11.91,1:02:14.01,Lalai,Biryulka,0,0,0,,Adakah anda melakukan kawad paksa sejauh 400 km dengan beban 50 kg?
Dialog: 0,1:02:14.68,1:02:15.78,Lalai,Spilyk,0,0,0,,400 kilometer?
Dialog: 0,1:02:20.09,1:02:22.32,Lalai,Spillik,0,0,0,,Sungguh bermimpi. 400 km? Ayuh.
Dialog: 0,1:02:23.49,1:02:25.43,Lalai,Spillik,0,0,0,,Nah, ya, saya melebih-lebihkan sedikit.
Dialog: 0,1:02:25.43,1:02:26.74,Lalai,Spillik,0,0,0,,Tetapi sudah pasti melepasi 200.
Dialog: 0,1:02:26.74,1:02:29.11,Lalai,Spikilka,0,0,0,,Semasa operasi musim sejuk kami mencairkan ais dan minum...
Dialog: 0,1:02:30.57,1:02:33.61,Lalai,Spillik,0,0,0,,Nah, ya, ya, ya. Kami percaya, kami percaya.
Dialog: 0,1:02:34.80,1:02:37.20,Lalai,Spillik,0,0,0,,Hei! Saya betul-betul serius!
Dialog: 0,1:02:37.20,1:02:39.51,Lalai,Spillik,0,0,0,,Sudah tentu, Yang Mulia.
Dialog: 0,1:02:39.51,1:02:41.24,Lalai,Spillit,0,0,0,,Saya tidak mahu awak masuk angin.
Dialog: 0,1:02:42.78,1:02:44.91,Lalai,Spillik,0,0,0,,Kami tidak boleh membuat api tanpa ditangkap.
Dialog: 0,1:02:45.51,1:02:47.95,Lalai,Spillik,0,0,0,,Saya bimbang tentang bagaimana kita akan tidur pada malam yang sejuk.
Dialog: 0,1:02:48.76,1:02:50.78,Lalai,Spillik,0,0,0,,Sayang sekali awak sedang melalui ini, ratu.
Dialog: 0,1:02:51.43,1:02:53.30,Lalai,Spillik,0,0,0,,Ini mengarut. Dan ia tidak sejuk sama sekali.
Dialog: 0,1:02:53.45,1:02:55.47,Lalai,Spilyk,0,0,0,,Tiada apa-apa yang setanding dengan operasi musim sejuk kami.
Dialog: 0,1:02:58.20,1:02:59.39,Lalai,Spillik,0,0,0,,Yang Mulia.
Dialog: 0,1:03:26.49,1:03:28.37,Lalai,Spillik,0,0,0,,Matikan penghawa dingin, okay?
Dialog: 0,1:03:29.39,1:03:31.76,Lalai,Spillit,0,0,0,,Saya mungkin diserang selsema.
Dialog: 0,1:04:30.53,1:04:31.66,Lalai,Spillik,0,0,0,,Kami tidak menjumpainya.
Dialog: 0,1:04:32.45,1:04:34.49,Lalai,Spillik,0,0,0,,Berpecah kepada kumpulan dan sikat seluruh gunung.
Dialog: 0,1:04:34.72,1:04:35.72,Lalai,Spillik,0,0,0,,-Ya!\N-Ya!
Dialog: 0,1:04:58.86,1:05:01.09,Lalai,Spillik,0,0,0,,Atas sebab tertentu saya berasa baik hari ini.
Dialog: 0,1:05:01.86,1:05:05.59,Lalai,Spillik,0,0,0,,Dengan cahaya matahari ini, saya percaya bahawa hari ini kita akan menemui raja.
Dialog: 0,1:05:16.47,1:05:18.93,Lalai,Spillik,0,0,0,,-Kami tidak mempunyai masa untuk ini. Teruskan.\N-Ya, betul.
Dialog: 0,1:05:20.11,1:05:21.24,Lalai,Spillik,0,0,0,,-Mari cepat.\N-Kita perlu cepat.
Dialog: 0,1:05:21.95,1:05:24.91,Lalai,Spillik,0,0,0,,-Adakah ini jalannya?\N-Ya, ratu. Jom teruskan.
Dialog: 0,1:05:29.01,1:05:30.34,Lalai,Spillik,0,0,0,,Kami hampir sampai.
Dialog: 0,1:05:30.34,1:05:32.76,Lalai,Spillit,0,0,0,,Tidak lama lagi kita akan sampai ke tebing.
Dialog: 0,1:05:33.12,1:05:35.68,Lalai,Spillik,0,0,0,,Anda yang begitu yakin pada usia 20-an.
Dialog: 0,1:05:36.26,1:05:37.53,Lalai,Spillik,0,0,0,,Tenaga sedang bergegas!
Dialog: 0,1:05:39.09,1:05:41.53,Lalai,Spillik,0,0,0,,-Mari kita berehat sebentar.\N-Ya, Tuanku.
Dialog: 0,1:05:51.01,1:05:53.93,Lalai,Spillik,0,0,0,,Saya mesti katakan, dunia kini lebih cerah,
Dialog: 0,1:05:54.68,1:05:57.45,Lalai,Spillik,0,0,0,,apabila kita berada di luar istana, permaisuri.
Dialog: 0,1:05:59.74,1:06:02.12,Lalai,Spillik,0,0,0,,Dan sebelum dia benci meninggalkan istana.
Dialog: 0,1:06:02.28,1:06:03.28,Lalai,Spillik,0,0,0,,Nah, ya.
Dialog: 0,1:06:05.05,1:06:06.05,Lalai,Spillik,0,0,0,,Dan awak, Hong Young?
Dialog: 0,1:06:06.26,1:06:07.99,Lalai,Spillik,0,0,0,,Yang manakah anda lebih suka?\Nistana atau di luarnya?
Dialog: 0,1:06:08.86,1:06:10.53,Lalai,Spillik,0,0,0,,Di mana anda berada, Yang Mulia.
Dialog: 0,1:06:11.28,1:06:13.53,Lalai,Spillik,0,0,0,,-Itu yang dia cakap.\N-Hei, hentikan.
Dialog: 0,1:06:18.14,1:06:20.07,Lalai,Spillik,0,0,0,,Ratu, mereka ada di sini.
Dialog: 0,1:06:21.66,1:06:23.16,Lalai,Spillik,0,0,0,,Ini dia. Dapatkan mereka!
Dialog: 0,1:06:23.16,1:06:24.51,Lalai,Spillik,0,0,0,,Lari, anda perlu bersembunyi!
Dialog: 0,1:06:24.51,1:06:25.70,Lalai,Spillik,0,0,0,,-Baiklah.\N-Lari!
Dialog: 0,1:06:28.57,1:06:30.51,Lalai,Spillik,0,0,0,,Hon Young, iringi permaisuri. Lari!
Dialog: 0,1:06:31.07,1:06:33.28,Lalai,Spillit,0,0,0,,Puan Choi, kamu hendak ke mana? di mana?
Dialog: 0,1:06:34.01,1:06:36.72,Lalai,Spillik,0,0,0,,Jangan berani, geeks! Saya tidak akan benarkan!
Dialog: 0,1:06:36.72,1:06:38.12,Lalai,Spillik,0,0,0,,Yang Mulia, kita mesti lari.
Dialog: 0,1:06:38.45,1:06:40.62,Lalai,Spillit,0,0,0,,-Court Lady Choi!\N-Saya tidak akan benarkan anda masuk!
Dialog: 0,1:06:40.62,1:06:41.78,Lalai,Spillie,0,0,0,,Lepaskan saya!
Dialog: 0,1:06:43.36,1:06:44.53,Lalai,Spillik,0,0,0,,Yang Mulia...
Dialog: 0,1:06:47.55,1:06:48.57,Lalai,Spillik,0,0,0,,Tidak!
Dialog: 0,1:06:49.76,1:06:51.37,Lalai,Spillik,0,0,0,,Kembali!
Dialog: 0,1:07:04.95,1:07:06.24,Lalai,Spillit,0,0,0,,-Puan Mahkamah Choi!\N-Permaisuri!
Dialog: 0,1:07:06.74,1:07:07.84,Lalai,Spillik,0,0,0,,Tidak, sila!
Dialog: 0,1:07:09.84,1:07:10.84,Lalai,Spillik,0,0,0,,Ambil!
Dialog: 0,1:07:11.18,1:07:12.59,Lalai,Spillik,0,0,0,,Saya mohon, berhenti.
Dialog: 0,1:07:14.38,1:07:16.96,Lalai,Spillik,0,0,0,,Tidak! tak perlu.
Dialog: 0,1:07:16.96,1:07:20.20,Lalai,Spillit,0,0,0,,-Puan Choi!\N-Permaisuri! Tolong...
Dialog: 0,1:07:20.92,1:07:24.50,Lalai,Spillit,0,0,0,,-Lady Choi!\N-Tidak. Tidak!
Dialog: 0,1:07:26.33,1:07:30.33,Lalai,Spillik,0,0,0,,-Tidak! Court Lady Choi!\N-Kita mesti melarikan diri, ratu!
Dialog: 0,1:07:30.63,1:07:31.88,Lalai,Spillit,0,0,0,,Court lady Choi!
Dialog: 0,1:07:34.28,1:07:35.34,Lalai,Spillik,0,0,0,,Yang Mulia!
Dialog: 0,1:07:35.71,1:07:39.92,Lalai,Spillit,0,0,0,,Lari! Ratu, saya mohon, lari!
Dialog: 0,1:07:50.83,1:07:52.72,Lalai,Spillik,0,0,0,,Yang Mulia, saya harap tuan dapat menemui raja.
Dialog: 0,1:07:57.17,1:07:58.33,Lalai,Spillit,0,0,0,,Hon Young!
Dialog: 0,1:07:59.26,1:08:00.33,Lalai,Spillie,0,0,0,,Ikuti dia!
Dialog: 0,1:09:22.21,1:09:23.51,Lalai,Spillik,0,0,0,,Siapa awak?
Dialog: 0,1:09:25.25,1:09:28.08,Lalai,Spillik,0,0,0,,Apa yang awak buat dengan Soyeon?
Dialog: 0,1:09:43.63,1:09:47.91,Lalai,Spillit,0,0,0,,Bagaimana saya menjadi seorang ratu
Dialog: 0,1:10:07.86,1:10:10.29,Lalai,Spillik,0,0,0,,Awak kata awak tahu segala-galanya tentang saya dan Soyeon.
Dialog: 0,1:10:11.59,1:10:13.00,Lalai,Spillik,0,0,0,,Tiba-tiba mereka kembali kepada saya
Dialog: 0,1:10:13.17,1:10:14.29,Lalai,Spillik,0,0,0,,semua ingatannya.
Dialog: 0,1:10:18.50,1:10:21.30,Lalai,Spillik,0,0,0,,Soyeon masih tinggal di dalam diri anda jika ingatannya dikekalkan.
Dialog: 0,1:10:21.50,1:10:24.00,Lalai,Spillik,0,0,0,,Pegang tangan saya sehingga awak keluar tanpa cedera.
Dialog: 0,1:10:24.00,1:10:27.01,Lalai,Spillik,0,0,0,,Saya tahu. Anda hanya memikirkan tentang diri sendiri.
Dialog: 0,1:10:29.54,1:10:30.62,Lalai,Spillik,0,0,0,,Ambil mereka.
Dialog: 0,1:10:31.68,1:10:32.92,Lalai,Spillit,0,0,0,,Ikut permaisuri!
Dialog: 0,0:15:38.67,0:15:40.67,Lalai,,0,0,0,,

Ulasan: 0,0:39:42.84,0:39:43.84,Lalai,Lily3,0,0,0,,Baiklah.
Ulasan: 0,0:41:02.82,0:41:04.22,Lalai,Lily3,0,0,0,,Pemindahan atau penggulingan raja
