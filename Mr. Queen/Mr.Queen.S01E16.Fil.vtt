Dialogue: 0,0:00:58.00,0:01:03.98,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДДСТА
Dialogue: 0,0:00:58.00,0:01:03.98,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807}\fscy2007 92 38 l 0 38
Dialogue: 0,0:00:58.00,0:01:03.98,nagtrabaho,,0,0,0,,{\pos(801,256)}Gumawa sa serye:\N Lily, Tiramisu, Biryulka, Host, Pineapple, Hazelnut
Dialogue: 0,0:00:58.00,0:01:03.98,title,,0,0,0,,{\fscx75\fscy75\pos(846,392)}Paano ako naging
Dialogue: 0,0:00:58.00,0:01:03.98,pangalan,,0,0,0,,{\fscx75\fscy75\pos(848,456)}reyna
Dialogue: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialogue: 0,0:01:04.08,0:01:06.55,Default,,0,0,0,,Lahat ng character ay kathang-isip lang,
Dialogue: 0,0:01:06.55,0:01:08.59,Default,,0,0,0,,at ang mga kaganapang ipinakita ay kathang-isip lamang.
Dialogue: 0,0:01:09.16,0:01:11.63,Default,,0,0,0,,Naku, mga mommies! Ano ang gagawin?\NIsa itong hindi mabibiling aklat.
Dialogue: 0,0:01:11.63,0:01:12.63,Default,,0,0,0,,16 episode
Dialogue: 0,0:01:27.91,0:01:30.21,Default,,0,0,0,,Bakit mo nasabi na ang librong ito ay hindi mabibili ng salapi?
Dialogue: 0,0:01:32.68,0:01:36.25,Default,,0,0,0,,Paano mahalaga sa iyo ang Pangunahing Pagtuturo para sa mga Bata?
Dialogue: 0,0:01:37.98,0:01:39.82,Default,,0,0,0,,-Iyan ay...\N-Ikaw ba iyon?
Dialogue: 0,0:01:41.72,0:01:44.32,Default,,0,0,0,,Ang nagligtas sa akin ay ikaw?
Dialogue: 0,0:01:44.69,0:01:46.79,Default,,0,0,0,,Iniligtas mo ako mula sa balon?
Dialogue: 0,0:01:56.47,0:01:58.84,Default,,0,0,0,,Oo. Ako iyon.
Dialogue: 0,0:02:04.68,0:02:05.98,Default,,0,0,0,,Nakalimutan mo na ba ang lahat?
Dialogue: 0,0:02:06.35,0:02:08.25,Default,,0,0,0,,Oo, kinaladkad kita sa aking umbok.
Dialogue: 0,0:02:09.62,0:02:12.02,Default,,0,0,0,,Nalalagas pa rin ang mga kamay.
Dialogue: 0,0:02:12.52,0:02:15.92,Default,,0,0,0,,Hindi ako makapaniwala na nakalimutan mo na ang lahat.\NWala ka man lang naaalalang mabuti.
Dialogue: 0,0:02:16.26,0:02:18.73,Default,,0,0,0,,Hindi, pinag-uusapan ko ang mga pangyayari noong nakalipas na walong taon.
Dialogue: 0,0:02:19.19,0:02:20.89,Default,,0,0,0,,So hindi ito ang unang beses na nahulog ka sa isang balon?
Dialogue: 0,0:02:21.80,0:02:23.93,Default,,0,0,0,,Hindi ka ba lumilingon sa paligid?
Dialogue: 0,0:02:27.50,0:02:29.64,Default,,0,0,0,,Kung gayon bakit napakamahal ng aklat na ito?
Dialogue: 0,0:02:31.51,0:02:33.87,Default,,0,0,0,,Mukhang isa sa mga tunay na obra maestra.
Dialogue: 0,0:02:36.01,0:02:37.98,Default,,0,0,0,,Muling kalokohan ang sinasabi mo.
Dialogue: 0,0:02:39.68,0:02:41.82,Default,,0,0,0,,Nagising mula sa isang bangungot,\Npara akong nakakulong sa isang balon,
Dialogue: 0,0:02:41.82,0:02:43.32,Default,,0,0,0,,Naisip kita agad.
Dialogue: 0,0:02:44.89,0:02:47.39,Default,,0,0,0,,Napagpasyahan ko ito ay dahil tinulungan mo akong makaalis,
Dialogue: 0,0:02:48.66,0:02:50.79,Default,,0,0,0,,pero simula noon naging
Dialogue: 0,0:02:50.79,0:02:52.89,Default,,0,0,0,,napapansin kung gaano ka katulad\Nyo sa babaeng nagligtas sa akin.
Dialogue: 0,0:02:55.06,0:02:57.96,Default,,0,0,0,,Naisip na baka ikaw iyon.
Dialogue: 0,0:03:01.30,0:03:04.27,Default,,0,0,0,,Kung bumukol ang noodles,\Hindi masarap ang lasa.
Dialogue: 0,0:03:05.57,0:03:06.67,Default,,0,0,0,,Gusto mo ba?
Dialogue: 0,0:03:09.41,0:03:11.18,Default,,0,0,0,,Bon appetit.
Dialogue: 0,0:03:16.25,0:03:17.35,Default,,0,0,0,,Cutie.
Dialogue: 0,0:03:19.85,0:03:23.32,Default,,0,0,0,,Hipan para lumamig, at huwag magmadali.
Dialogue: 0,0:03:32.33,0:03:33.90,Default,,0,0,0,,Ano ang kawili-wili sa iyo?
Dialogue: 0,0:03:34.37,0:03:36.47,Default,,0,0,0,,Ming Dynasty Tactics Manual.
Dialogue: 0,0:03:36.67,0:03:37.94,Default,,0,0,0,,Manwal ng mga taktika?
Dialogue: 0,0:03:38.77,0:03:39.84,Default,,0,0,0,,Mga taktikang militar?
Dialogue: 0,0:03:41.01,0:03:42.48,Default,,0,0,0,,Nagbabalak ka bang magsimula ng digmaan?
Dialogue: 0,0:03:42.84,0:03:44.84,Default,,0,0,0,,Kung gusto kong palakasin ang kapangyarihan,
Dialogue: 0,0:03:44.84,0:03:46.85,Default,,0,0,0,,Kailangan ko ng suporta ng hukbo.
Dialogue: 0,0:03:48.55,0:03:50.72,Default,,0,0,0,,May mga bangungot pa rin ako tungkol sa
Dialogue: 0,0:03:51.45,0:03:53.09,Default,,0,0,0,,paano ka mamamatay nang walang nakakamit?
Dialogue: 0,0:03:53.45,0:03:54.69,Default,,0,0,0,,Case by case.
Dialogue: 0,0:04:00.69,0:04:04.93,Default,,0,0,0,,Kung mangyari ito,\Hindi dahil bobo ka.
Dialogue: 0,0:04:05.13,0:04:07.17,Default,,0,0,0,,Ito ay orihinal na nilayon.
Dialogue: 0,0:04:07.53,0:04:11.17,Default,,0,0,0,,Malas ka lang.
Dialogue: 0,0:04:11.17,0:04:12.34,Default,,0,0,0,,Hindi mo kasalanan.
Dialogue: 0,0:04:12.97,0:04:14.41,Default,,0,0,0,,Siguro tama ka.
Dialogue: 0,0:04:15.28,0:04:18.88,Default,,0,0,0,,Kaya itigil mo na ang pagpapahirap sa sarili mo ng ganyan.
Dialogue: 0,0:04:19.38,0:04:20.81,Default,,0,0,0,,Hindi mo pa rin kaya
Dialogue: 0,0:04:22.18,0:04:23.38,Default,,0,0,0,,makagambala sa kapalaran.
Dialogue: 0,0:04:28.42,0:04:30.02,Default,,0,0,0,,Minsan nagigising ako mula sa isang bangungot,
Dialogue: 0,0:04:30.66,0:04:33.16,Default,,0,0,0,,at mga kakaibang kaisipan ang pumapasok sa isip.
Dialogue: 0,0:04:35.00,0:04:36.56,Default,,0,0,0,,Na ang panaginip na ito ay totoo,
Dialogue: 0,0:04:37.63,0:04:39.17,Default,,0,0,0,,at nabubuhay tayo sa nakaraan.
Dialogue: 0,0:04:46.44,0:04:49.88,Default,,0,0,0,,Para bang lahat ng ito ay aking mga pangitain
Dialogue: 0,0:04:50.61,0:04:52.01,Default,,0,0,0,, bago mamatay.
Dialogue: 0,0:04:55.82,0:04:57.45,Default,,0,0,0,,At sa sandaling ito
Dialogue: 0,0:05:00.29,0:05:03.96,Default,,0,0,0,,May pagkakataon akong gumawa ng isang bagay, para ayusin ang lahat.
Dialogue: 0,0:05:08.43,0:05:10.10,Default,,0,0,0,,Malamang ngayon
Dialogue: 0,0:05:12.43,0:05:15.64,Default,,0,0,0,,Ginagawa ko ang lahat para labanan ang tadhana.
Dialogue: 0,0:05:24.74,0:05:29.42,Default,,0,0,0,,Para sa kapakanan ng lalaking ito, na ang tadhana ay matalo,\NI ay gustong isakripisyo ang lahat.
Dialogue: 0,0:05:35.96,0:05:38.76,Default,,0,0,0,,All-in
Dialogue: 0,0:05:44.76,0:05:47.17,Default,,0,0,0,,Talagang matatalo mo silang lahat.
Dialogue: 0,0:05:48.87,0:05:50.70,Default,,0,0,0,,Palagi akong nasa panig ng mga nanalo.
Dialogue: 0,0:05:50.70,0:05:53.74,Default,,0,0,0,,At habang nandiyan ako,\Nvictory ay sa iyo.
Dialogue: 0,0:05:56.21,0:05:59.55,Default,,0,0,0,,Napakalakas ng loob mo.
Dialogue: 0,0:06:01.08,0:06:03.12,Default,,0,0,0,,Mayroon akong secret weapon.
Dialogue: 0,0:06:04.32,0:06:05.59,Default,,0,0,0,,Alam ko ang hinaharap.
Dialogue: 0,0:06:07.05,0:06:08.66,Default,,0,0,0,,Remember?
Dialogue: 0,0:06:08.66,0:06:10.29,Default,,0,0,0,,Tulad ng sinabi mo,\Nna ako ay isang tao mula sa malayong hinaharap?
Dialogue: 0,0:06:10.29,0:06:12.86,Default,,0,0,0,,Syempre naaalala ko.\NIAng hirap kalimutan.
Dialogue: 0,0:06:13.16,0:06:14.79,Default,,0,0,0,,Paano kung totoo ito,
Dialogue: 0,0:06:15.60,0:06:18.10,Default,,0,0,0,,at ibabahagi ko sa iyo ang aking kaalaman?
Dialogue: 0,0:06:19.13,0:06:21.37,Default,,0,0,0,,Sa tingin mo ba maniniwala ako dito?
Dialogue: 0,0:06:22.67,0:06:23.84,Default,,0,0,0,,Sa kasong ito,
Dialogue: 0,0:06:25.00,0:06:28.71,Default,,0,0,0,,isipin ko na nanaginip ako.\NA kapaki-pakinabang na panaginip na propeta.
Dialogue: 0,0:06:31.01,0:06:32.08,Default,,0,0,0,,Kalokohan.
Dialogue: 0,0:06:35.25,0:06:40.45,Default,,0,0,0,,Dahil panaginip lang ito,\NI ay hindi maniniwala sa iyong mga kwento,
Dialogue: 0,0:06:40.82,0:06:42.49,Default,,0,0,0,,pero makikinig ako nang may kasiyahan.
Dialogue: 0,0:06:43.39,0:06:45.23,Default,,0,0,0,,Ano ang Joseon pagkalipas ng 200 taon?
Dialogue: 0,0:06:46.39,0:06:47.39,Default,,0,0,0,,Well.
Dialogue: 0,0:06:50.30,0:06:52.63,Default,,0,0,0,,Ito ay isang kwento lamang na aking ginawa,
Dialogue: 0,0:06:54.07,0:06:56.24,Default,,0,0,0,,ngunit hindi na natin tinatawag ang ating bansang Joseon.
Dialogue: 0,0:06:57.37,0:06:59.94,Default,,0,0,0,,Republic of Korea.\NIto na ang hinihintay ni Joseon.
Dialogue: 0,0:07:01.84,0:07:02.94,Default,,0,0,0,,Republika ng Korea?
Dialogue: 0,0:07:02.94,0:07:05.88,Default,,0,0,0,,Sa bansang ito, ang mga tao mismo ang pipili\Nkung sino ang mamumuno.
Dialogue: 0,0:07:06.15,0:07:07.55,Default,,0,0,0,,Anong kalokohan.
Dialogue: 0,0:07:08.11,0:07:11.89,Default,,0,0,0,,Sabihin mo sa akin ang mas kapani-paniwala para maniwala ako.
Dialogue: 0,0:07:12.22,0:07:13.75,Default,,0,0,0,,Kung hindi ka naniniwala sa akin ngayon,\Nmay problema tayo.
Dialogue: 0,0:07:13.75,0:07:15.69,Default,,0,0,0,,Imbento ko lang ito.
Dialogue: 0,0:07:16.72,0:07:20.03,Default,,0,0,0,,200 taon na ang lumipas ay wala nang mga maharlika at karaniwang tao.
Dialogue: 0,0:07:21.36,0:07:23.30,Default,,0,0,0,,Hindi na nahahati sa klase ang mga tao?
Dialogue: 0,0:07:24.33,0:07:26.63,Default,,0,0,0,,Well, may naisip na bago ang mga tao.
Dialogue: 0,0:07:26.97,0:07:28.43,Default,,0,0,0,,Supot ka ba ng pera o hindi.
Dialogue: 0,0:07:29.74,0:07:32.41,Default,,0,0,0,,Ang katayuan ng isang tao ay tinutukoy ng kanyang bag?
Dialogue: 0,0:07:33.47,0:07:36.34,Default,,0,0,0,,At ano, lahat ay pumipili ng ruler gamit ang isang bag?
Dialogue: 0,0:07:36.68,0:07:38.78,Default,,0,0,0,,Ito ay tinatawag na pagboto.
Dialogue: 0,0:07:38.78,0:07:40.65,Default,,0,0,0,,Kapag naging 18 ka na,
Dialogue: 0,0:07:40.65,0:07:44.12,Default,,0,0,0,,maaari kang pumili ng mga ruler.
Dialogue: 0,0:07:44.85,0:07:47.12,Default,,0,0,0,,-Pumili ng mga ruler?\N-Oo.
Dialogue: 0,0:07:47.12,0:07:48.59,Default,,0,0,0,,Bakit eksaktong 18?
Dialogue: 0,0:07:53.73,0:07:57.63,Default,,0,0,0,,Ganito ang takbo ng araw ng reyna.
Dialogue: 0,0:08:01.03,0:08:02.37,Default,,0,0,0,,Ang galing mo.
Dialogue: 0,0:08:06.97,0:08:10.68,Default,,0,0,0,,Ngayon panoorin ang bawat kilos niya.
Dialogue: 0,0:08:22.86,0:08:24.12,Default,,0,0,0,,Benin,
Dialogue: 0,0:08:24.99,0:08:27.69,Default,,0,0,0,,ikaw na ngayon\Nour pinakabatang Ministro ng Digmaan
Dialogue: 0,0:08:28.23,0:08:30.10,Default,,0,0,0,,at naging mas kaakit-akit.
Dialogue: 0,0:08:30.50,0:08:31.80,Default,,0,0,0,,Sa tingin mo ba?
Dialogue: 0,0:08:32.10,0:08:34.17,Default,,0,0,0,,-Siyempre hindi.\N-Alam ko.
Dialogue: 0,0:08:36.10,0:08:37.44,Default,,0,0,0,,Binabati kita!
Dialogue: 0,0:08:46.01,0:08:47.51,Default,,0,0,0,,Nga pala, Benin,
Dialogue: 0,0:08:47.95,0:08:50.48,Default,,0,0,0,,wala man lang para sa aming pamilya
Dialogue: 0,0:08:50.68,0:08:52.85,Default,,0,0,0,,hindi makakasundo ang hari?
Dialogue: 0,0:08:54.25,0:08:55.96,Default,,0,0,0,,Siya ay napakahalaga sa reyna
Dialogue: 0,0:08:57.12,0:08:59.06,Default,,0,0,0,,at hindi siya mukhang masamang tao.
Dialogue: 0,0:08:59.06,0:09:01.59,Default,,0,0,0,,Lahat ng pakikiramay niya sa reyna ay kasinungalingan.
Dialogue: 0,0:09:03.96,0:09:07.03,Default,,0,0,0,,Para sa kanyang sariling kapakinabangan\Nlagi niyang isasapanganib ang kanyang buhay.
Dialogue: 0,0:09:08.00,0:09:09.80,Default,,0,0,0,,Hindi ko sasabihin iyon.
Dialogue: 0,0:09:09.80,0:09:11.64,Default,,0,0,0,,Ito ang pinaka nakakainis sa kanya.
Dialogue: 0,0:09:12.74,0:09:15.41,Default,,0,0,0,,Nagtatago sa likod ng mga maskara at babae.
Dialogue: 0,0:09:16.31,0:09:19.15,Default,,0,0,0,,Duplicitous behaves\Nand mapandaya ang lahat ng tao sa paligid.
Dialogue: 0,0:09:20.35,0:09:22.48,Default,,0,0,0,,Sumuko rin ang Reyna sa kanyang alindog,
Dialogue: 0,0:09:22.48,0:09:24.95,Default,,0,0,0,,at ngayon para sa kapakanan ng hari\NI'm handang isuko ang aking pamilya.
Dialogue: 0,0:09:26.15,0:09:28.45,Default,,0,0,0,,Gayunpaman, ginagamit lang siya ng hari.
Dialogue: 0,0:09:29.46,0:09:32.03,Default,,0,0,0,,Pero narinig ko na ang reyna pala
Dialogue: 0,0:09:32.03,0:09:33.73,Default,,0,0,0,,pinihit ang hari ayon sa gusto niya.
Dialogue: 0,0:09:34.26,0:09:36.53,Default,,0,0,0,,At sino,
Dialogue: 0,0:09:36.53,0:09:39.60,Default,,0,0,0,,kaya mas alam ng mga katulong ang tungkol sa personal na buhay ng hari kaysa kaninuman.
Dialogue: 0,0:09:40.43,0:09:44.77,Default,,0,0,0,,Nandoon daw sila hanggang madaling araw kagabi
Dialogue: 0,0:09:45.10,0:09:49.11,Default,,0,0,0,,nag-uusap sila sa mga silid ng hari.
Dialogue: 0,0:10:15.23,0:10:17.20,Default,,0,0,0,,Kung mabigo ang Cheoljong,
Dialogue: 0,0:10:17.20,0:10:19.14,Default,,0,0,0,,magbabago ba ang mundo pagkatapos ng 200 taon?
Dialogue: 0,0:10:19.51,0:10:22.28,Default,,0,0,0,,At pagkatapos ay hindi magkakaroon ng Japanese annexation,
Dialogue: 0,0:10:22.58,0:10:24.81,Default,,0,0,0,,at hindi isisilang ang bastos na si Director Khan.
Dialogue: 0,0:10:28.18,0:10:29.95,Default,,0,0,0,,Ang lahat ng ito ay hindi para sa Cheoljong.
Dialogue: 0,0:10:30.28,0:10:32.99,Default,,0,0,0,,Ginagawa ko ito para sa sarili ko.
Dialogue: 0,0:10:34.65,0:10:36.36,Default,,0,0,0,,Tumutulong sa iyo,
Dialogue: 0,0:10:38.59,0:10:40.29,Default,,0,0,0,,Iniligtas ko ang sarili ko.
Dialogue: 0,0:10:51.70,0:10:52.81,Default,,0,0,0,,Kamahalan!
Dialogue: 0,0:10:54.47,0:10:58.01,Default,,0,0,0,,Kamahalan!\NYang iyong ama ay nawalan ng malay!
Dialogue: 0,0:11:03.25,0:11:04.85,Default,,0,0,0,,Nakakatakot na bangungot.
Dialogue: 0,0:11:05.02,0:11:06.79,Default,,0,0,0,,Huwag kang bumangon!
Dialogue: 0,0:11:13.09,0:11:15.23,Default,,0,0,0,,-Anong nangyari?\N-Delikado dito.
Dialogue: 0,0:11:15.23,0:11:17.33,Default,,0,0,0,,Bakit ka dumating?
Dialogue: 0,0:11:18.87,0:11:21.70,Default,,0,0,0,,Hindi! Mas delikado sa palasyo.
Dialogue: 0,0:11:23.60,0:11:26.34,Default,,0,0,0,,Reyna, manatili sa bahay.
Dialogue: 0,0:11:26.51,0:11:28.94,Default,,0,0,0,,Gagawin ko ang lahat para protektahan ka.
Dialogue: 0,0:11:30.91,0:11:33.25,Default,,0,0,0,,Dapat nahimatay ka\Nsa pag-aalala sa akin.
Dialogue: 0,0:11:34.28,0:11:36.88,Default,,0,0,0,,Kasalanan ko.
Dialogue: 0,0:11:37.42,0:11:41.09,Default,,0,0,0,,Para akong personal na nagpakain sa iyo nitong lason.
Dialogue: 0,0:11:42.32,0:11:45.19,Default,,0,0,0,,Isinulat ko ang tangang librong iyon\Hindi ito sinunod ni Nand.
Dialogue: 0,0:11:45.63,0:11:47.56,Default,,0,0,0,,Mali ang ginawa nila.
Dialogue: 0,0:11:48.39,0:11:52.03,Default,,0,0,0,,Hindi mo ito kasalanan, kaya huminto ka.
Dialogue: 0,0:11:52.13,0:11:54.37,Default,,0,0,0,,Mas mabuting pangalagaan ang iyong kalusugan.
Dialogue: 0,0:11:54.37,0:11:55.90,Default,,0,0,0,,Ako ay malusog na parang baka.
Dialogue: 0,0:11:57.20,0:12:00.74,Default,,0,0,0,,Basta masaya ka, ako din.
Dialogue: 0,0:12:02.34,0:12:03.51,Default,,0,0,0,,Samakatuwid, mahal,
Dialogue: 0,0:12:05.45,0:12:07.35,Default,,0,0,0,,tanggihan ang titulong reyna.
Dialogue: 0,0:12:09.18,0:12:10.92,Default,,0,0,0,,-Tatay.\N-Soyeon.
Dialogue: 0,0:12:12.72,0:12:14.49,Default,,0,0,0,,Noong buntis ang iyong ina,
Dialogue: 0,0:12:14.82,0:12:17.06,Default,,0,0,0,,palagi niyang inuulit ang isang bagay.
Dialogue: 0,0:12:17.96,0:12:20.73,Default,,0,0,0,,Gusto niyang maging mas masaya ang kanyang anak kaysa sa kanya.
Dialogue: 0,0:12:21.69,0:12:24.46,Default,,0,0,0,,Para mamuhay ka sa paraang hindi niya kaya.
Dialogue: 0,0:12:24.93,0:12:27.30,Default,,0,0,0,,Para mas maganda ang buhay mo\Nkaysa sa nanay mo.
Dialogue: 0,0:12:28.67,0:12:30.84,Default,,0,0,0,,Ito ang kanyang huling hiling.
Dialogue: 0,0:12:31.87,0:12:33.07,Default,,0,0,0,,Mula pagkatapos ng kamatayan
Dialogue: 0,0:12:33.34,0:12:36.11,Default,,0,0,0,,pwede ko bang tingnan ang nanay mo sa mata?
Dialogue: 0,0:12:38.71,0:12:39.85,Default,,0,0,0,,Tatay.
Dialogue: 0,0:12:40.88,0:12:44.58,Default,,0,0,0,,Tutupad talaga ako sa hiling ng nanay ko.
Dialogue: 0,0:12:44.92,0:12:48.86,Default,,0,0,0,,Gaganti ako sa kanila sa lahat ng ginawa nila sa akin.
Dialogue: 0,0:12:50.06,0:12:51.09,Default,,0,0,0,,Reyna!
Dialogue: 0,0:12:51.09,0:12:53.46,Default,,0,0,0,,Kaya wala kang ma-root.
Dialogue: 0,0:12:57.33,0:12:59.37,Default,,0,0,0,,May hiling ako sa iyo.
Dialogue: 0,0:13:00.33,0:13:04.14,Default,,0,0,0,,Makinig. Maaari kang humingi ng kahit ano.
Dialogue: 0,0:13:04.30,0:13:06.87,Default,,0,0,0,,Gagawin ko ang lahat.
Dialogue: 0,0:13:08.37,0:13:10.11,Default,,0,0,0,,Sale mula sa stock
Dialogue: 0,0:13:11.14,0:13:13.95,Default,,0,0,0,,Nabaliw ang may-ari!
Dialogue: 0,0:13:16.38,0:13:17.98,Default,,0,0,0,,Sa buhay ko hindi ko akalain na ganito siya!
Dialogue: 0,0:13:18.22,0:13:21.22,Default,,0,0,0,,Paano kung pilitin ka nilang magbayad ng doble?
Dialogue: 0,0:13:21.22,0:13:22.26,Default,,0,0,0,,Ano?
Dialogue: 0,0:13:23.02,0:13:24.49,Default,,0,0,0,,Salamat!
Dialogue: 0,0:13:24.52,0:13:27.13,Default,,0,0,0,,Mr. Kim! Kamahalan!
Dialogue: 0,0:13:27.13,0:13:29.70,Default,,0,0,0,,Mahabang buhay sa iyo!
Dialogue: 0,0:13:30.70,0:13:32.30,Default,,0,0,0,,Nabentahan siya ng isang supot ng bigas?
Dialogue: 0,0:13:32.30,0:13:33.77,Default,,0,0,0,,Lipad lang ito na parang kuku!
Dialogue: 0,0:13:35.30,0:13:38.37,Default,,0,0,0,,Nawala sa isip ang ginoo!
Dialogue: 0,0:13:42.68,0:13:44.64,Default,,0,0,0,,May hiling ako sa iyo.
Dialogue: 0,0:13:44.78,0:13:46.51,Default,,0,0,0,,Kalimutan ang tungkol sa katiwalian,
Dialogue: 0,0:13:46.95,0:13:48.98,Default,,0,0,0,,ingatan mo ang iyong reputasyon.
Dialogue: 0,0:13:51.85,0:13:55.19,Default,,0,0,0,,Sigurado ka bang gusto mong ibenta ang lahat ng ito sa mga tao?
Dialogue: 0,0:13:55.19,0:13:56.19,Default,,0,0,0,,Eksakto!
Dialogue: 0,0:13:56.66,0:13:59.99,Default,,0,0,0,,Hindi ko ma-drag ang lahat ng ito sa libingan.
Dialogue: 0,0:14:07.73,0:14:11.34,Default,,0,0,0,,Paumanhin, hindi mo ba ako pakakawalan?
Dialogue: 0,0:14:14.01,0:14:16.74,Default,,0,0,0,,Ang kasakiman ay isang masamang ugali.
Dialogue: 0,0:14:28.29,0:14:30.72,Default,,0,0,0,,Gumawa ng mahalagang desisyon ang iyong ama.
Dialogue: 0,0:14:30.79,0:14:31.82,Default,,0,0,0,,At hindi lang iyon.
Dialogue: 0,0:14:35.33,0:14:37.16,Default,,0,0,0,,Hinahanap mo ang accounting book.
Dialogue: 0,0:14:37.16,0:14:39.50,Default,,0,0,0,,Naaalala ni Papa ang lahat ng nakasulat dito.
Dialogue: 0,0:14:43.67,0:14:45.74,Default,,0,0,0,,Hindi mga ministro, kundi mga daga ng basura.
Dialogue: 0,0:14:45.74,0:14:48.81,Default,Spikyulka2,0,0,0,,Ang kaliwang adviser ay nagsagawa ng panloloko gamit ang butil.
Dialogue: 0,0:14:48.98,0:14:51.01,Default,Spikyulka2,0,0,0,,Sa iba't ibang paraan ay inilaan niya
Dialogue: 0,0:14:51.14,0:14:52.81,Default,Spilyk2,0,0,0,,isang malaking halaga nito.
Dialogue: 0,0:14:55.58,0:14:58.08,Default,Spilyk2,0,0,0,,Ang punong tagapayo ay nagpainit ng kanyang mga kamay sa mga lupain.
Dialogue: 0,0:14:58.08,0:15:01.25,Default,Spikyulka2,0,0,0,,Halimbawa, magpapalusot siya sa isang tao ng quarry at pipilitin silang magtrabaho dito,
Dialogue: 0,0:15:01.25,0:15:02.76,Default,Spikyulka2,0,0,0,,at pagkatapos ay durugin ka ng labis na buwis.
Dialogue: 0,0:15:05.22,0:15:06.39,Default,Spikyulka2,0,0,0,,Walang hindi nagnanakaw,
Dialogue: 0,0:15:06.39,0:15:07.56,Default,Spikyulka2,0,0,0,,at walang bagay na hindi ninakaw.
Dialogue: 0,0:15:07.96,0:15:10.03,Default,Spikyulka2,0,0,0,,At pati na rin ang korapsyon sa militar at ang pagbili ng mga posisyon.
Dialogue: 0,0:15:10.70,0:15:12.10,Default,Spilyk2,0,0,0,,Sa halip na magpadala ng bangkang may asin,
Dialogue: 0,0:15:12.10,0:15:13.50,Default,Spikyulka2,0,0,0,,pinuno nila ito ng mga bato at nilunod,
Dialogue: 0,0:15:13.50,0:15:15.03,Default,Spilyk2,0,0,0,,at kinuha nila ang asin para sa kanilang sarili.
Dialogue: 0,0:15:15.20,0:15:17.87,Default,Spikyulka2,0,0,0,,Ginawa ang mga katulad na trick na may mga regalo para sa hari.
Dialogue: 0,0:15:18.30,0:15:20.24,Default,Spikyulka2,0,0,0,,At sa lahat ng ito,\N na pinaka-asar sa akin,
Dialogue: 0,0:15:20.74,0:15:22.14,Default,Spikyulka2,0,0,0,,kaya ito ay mga nagpapautang.
Dialogue: 0,0:15:22.14,0:15:24.08,Default,Spikyulka2,0,0,0,,Nagtaas sila ng buwis sa mga magsasaka,
Dialogue: 0,0:15:24.08,0:15:25.81,Default,Spikyulka2,0,0,0,,at pagkatapos ay pinahiram sila ng pera sa 5%.
Dialogue: 0,0:15:25.98,0:15:28.18,Default,Spikyulka2,0,0,0,,Kaya ang mga utang ay lalago sa bawat paghinga.
Dialogue: 0,0:15:28.98,0:15:31.82,Default,Spilyk2,0,0,0,,Asal na parang gangster.
Dialogue: 0,0:15:31.82,0:15:34.59,Default,Spikyulka2,0,0,0,,Alaala ng iyong ama tungkol sa kita
Dialogue: 0,0:15:35.52,0:15:37.09,Default,Spillik2,0,0,0,,talagang kahanga-hanga.
Dialogue: 0,0:15:37.66,0:15:40.79,Default,Spikyulka2,0,0,0,,Siya nga pala, sabihin mo sa akin,
Dialogue: 0,0:15:40.83,0:15:44.10,Default,Spikyulka2,0,0,0,,ano ang gagawin mo sa impormante?
Dialogue: 0,0:15:45.53,0:15:48.93,Default,Spikyulka2,0,0,0,,Ang iyong ama ay isang pangunahing tauhan sa lahat ng mga pakana na ito.
Dialogue: 0,0:15:49.74,0:15:51.90,Default,Spillik2,0,0,0,,Hindi mawawala ng ganoon ang kanyang mga krimen.
Dialogue: 0,0:15:53.41,0:15:55.51,Default,Spikyulka2,0,0,0,,-Gayunpaman...\N-Ano ang "gayunpaman"?
Dialogue: 0,0:15:55.51,0:15:58.44,Default,Spikyulka2,0,0,0,,Para sa akin, isa pang tiwaling kriminal ang tatay mo.
Dialogue: 0,0:16:01.61,0:16:02.68,Default,Spilyk2,0,0,0,,Gayunpaman
Dialogue: 0,0:16:04.08,0:16:06.25,Default,Spikyulka2,0,0,0,,siya lang ang kadugo mo.
Dialogue: 0,0:16:10.29,0:16:11.86,Default,Spillik2,0,0,0,,Paano kung oo?
Dialogue: 0,0:16:13.93,0:16:15.06,Default,Spikyulka2,0,0,0,,Sabi nila
Dialogue: 0,0:16:15.06,0:16:16.20,Default,Spikyulka2,0,0,0,,na napakaraming merito
Dialogue: 0,0:16:16.20,0:16:17.73,Default,Spikyulka2,0,0,0,,maaring bigyang-katwiran ang mga pagkukulang.
Dialogue: 0,0:16:19.53,0:16:20.67,Default,Spillik2,0,0,0,,Kailangan pa ba niya ng merito?
Dialogue: 0,0:16:21.00,0:16:22.07,Default,Spillik2,0,0,0,,Halimbawa?
Dialogue: 0,0:16:22.10,0:16:23.47,Default,Spilyk2,0,0,0,,Halimbawa,
Dialogue: 0,0:16:23.90,0:16:26.51,Default,Spikyulka2,0,0,0,,makakatulong siyang makakuha ng ebidensya.
Dialogue: 0,0:16:28.07,0:16:31.14,Default,Spikyulka2,0,0,0,,Mahirap silang parusahan gamit lang ang ledger.
Dialogue: 0,0:16:33.21,0:16:35.15,Default,Spikyulka2,0,0,0,,Bilang kapalit ginagarantiyahan mo ang proteksyon
Dialogue: 0,0:16:35.61,0:16:37.12,Default,Spilyk2,0,0,0,,informant.
Dialogue: 0,0:16:37.58,0:16:38.65,Default,Spillik2,0,0,0,,Siyempre.
Dialogue: 0,0:16:44.99,0:16:48.09,Default,Spikyulka2,0,0,0,,Kamahalan, oras na para sa royal council.
Dialogue: 0,0:16:48.43,0:16:49.60,Default,Spillik2,0,0,0,,Okay.
Dialogue: 0,0:16:56.27,0:16:57.54,Default,Spillik2,0,0,0,,Royal Council?
Dialogue: 0,0:16:59.57,0:17:02.98,Default,Spikyulka2,0,0,0,,Kung gusto mong magsunog ng basura, pumunta sa landfill.
Dialogue: 0,0:17:03.91,0:17:05.88,Default,Spillik2,0,0,0,,Tanging, maliban sa regent - ang dowager queen,
Dialogue: 0,0:17:06.25,0:17:08.45,Default,Spikyulka2,0,0,0,,bawal doon ang mga babae.
Dialogue: 0,0:17:09.15,0:17:11.45,Default,Spikyulka2,0,0,0,,Itinatalaga ko ang aking kapatid, si Prince Yeonpyeong,
Dialogue: 0,0:17:11.45,0:17:14.09,Default,Spilyk2,0,0,0,,ng pinuno ng Ijeongcheon.
Dialogue: 0,0:17:14.25,0:17:16.22,Default,Spikyulka2,0,0,0,,-Hindi mo dapat gawin iyon.\N-Hindi mo dapat gawin iyon.
Dialogue: 0,0:17:18.06,0:17:19.26,Default,Spillik2,0,0,0,,Bakit ganito?
Dialogue: 0,0:17:19.26,0:17:22.19,Default,Spikyulka2,0,0,0,,Masyadong malaki ang ganitong gawain at responsibilidad
Dialogue: 0,0:17:22.19,0:17:25.43,Default,Spikyulka2,0,0,0,,para sa isang walang karanasan na binata gaya ni Prince Yeonpyeong, hindi niya kakayanin.
Dialogue: 0,0:17:27.27,0:17:29.44,Default,Spikyulka2,0,0,0,,Sa kabaligtaran, hindi siya nauugnay sa sinumang makapangyarihan.
Dialogue: 0,0:17:30.60,0:17:34.27,Default,Spillie2,0,0,0,,Ito ang pinakamataas na birtud para sa pamamahala sa Ijeongcheon.
Dialogue: 0,0:17:35.27,0:17:36.48,Default,Spilyk2,0,0,0,,Sa karagdagan,
Dialogue: 0,0:17:38.21,0:17:41.85,Default,Spikyulka2,0,0,0,,mukhang tinatanong kita ngayon?
Dialogue: 0,0:17:47.52,0:17:49.89,Default,Spillik2,0,0,0,,Sunog, Cheoljong.
Dialogue: 0,0:17:51.46,0:17:55.49,Default,Spikyulka2,0,0,0,,Nagpadala ako ng secret inspector kay Yeungnam.
Dialogue: 0,0:17:56.46,0:17:58.06,Default,Spikyulka2,0,0,0,,Mga may kasalanan ng pang-aabuso sa kapangyarihan
Dialogue: 0,0:17:58.06,0:17:59.70,Default,Spikyulka2,0,0,0,,ay parurusahan alinsunod sa batas.
Dialogue: 0,0:17:59.70,0:18:01.60,Default,Spikyulka2,0,0,0,,Lahat ng pinagkamalan nila,
Dialogue: 0,0:18:02.37,0:18:04.40,Default,Spikyulka2,0,0,0,,ay gagamitin para tulungan ang mga tao.
Dialogue: 0,0:18:05.17,0:18:08.81,Default,Spikyulka2,0,0,0,,Magiging halimbawa ito para sa ating walong gobernador
Dialogue: 0,0:18:09.81,0:18:11.31,Default,Spikyulka2,0,0,0,,at pipilitin silang umamin.
Dialogue: 0,0:18:12.21,0:18:14.31,Default,Silk2,0,0,0,,-Kami ay tumututol, Kamahalan.\N-Kami ay tumututol, Kamahalan.
Dialogue: 0,0:18:14.55,0:18:19.12,Default,Spikyulka2,0,0,0,,Nagpadala na ang Ministro ng Digmaan ng mga pinunong militar doon.
Dialogue: 0,0:18:20.59,0:18:22.82,Default,Spikyulka2,0,0,0,,Ipinadala sila nang walang pahintulot ko?
Dialogue: 0,0:18:23.12,0:18:24.62,Default,Spikyulka2,0,0,0,,Kamakailan
Dialogue: 0,0:18:24.62,0:18:26.93,Default,Spillik2,0,0,0,,malaking insidente na dulot ng mga tagasunod ng Tonhak,
Dialogue: 0,0:18:26.93,0:18:28.79,Default,Biryulka2,0,0,0,,nagpapaalaala sa mga pag-aalsa noon
Dialogue: 0,0:18:28.79,0:18:31.16,Default,Spikyulka2,0,0,0,,nagbanta sa soberanya ng Joseon.
Dialogue: 0,0:18:31.53,0:18:34.87,Default,Spikyulka2,0,0,0,,Nagkaroon ng krisis, at nangangailangan ito ng mabilis na solusyon.
Dialogue: 0,0:18:34.87,0:18:36.94,Default,Spikyulka2,0,0,0,,Sigurado akong gagawin ng kagawaran ng hangganan ang gusto nito.
Dialogue: 0,0:18:42.51,0:18:44.58,Default,Spikyulka2,0,0,0,,Nagulo ang mga tagasunod ni Tonghak
Dialogue: 0,0:18:44.58,0:18:46.41,Default,Spikyulka2,0,0,0,,at nagbanta sa mga lingkod-bayan.
Dialogue: 0,0:18:46.41,0:18:48.78,Default,Spikyulka2,0,0,0,,Sa huli, nagdulot sila ng pinsala sa mga opisyal.
Dialogue: 0,0:18:50.52,0:18:53.65,Default,Spikyulka2,0,0,0,,Kinailangan naming mabilis na hulihin at parusahan ang lider ng gang.
Dialogue: 0,0:18:54.19,0:18:56.42,Default,Spikyulka2,0,0,0,,Upang maiwasan ang pag-uulit,
Dialogue: 0,0:18:56.96,0:18:58.62,Default,Spikyulka2,0,0,0,,kinailangang puksain ang pinagmulan ng kasamaan.
Dialogue: 0,0:18:59.69,0:19:01.13,Default,Spillik2,0,0,0,,Puksain ang pinagmulan ng kasamaan?
Dialogue: 0,0:19:01.36,0:19:03.00,Default,Spikyulka2,0,0,0,,Nahuli namin, ikinulong at pinarusahan
Dialogue: 0,0:19:03.00,0:19:06.97,Default,Spilyk2,0,0,0,,tagasunod at nagpapakalat ng mga turo ni Tonhak.
Dialogue: 0,0:19:07.97,0:19:10.20,Default,Spikyulka2,0,0,0,,Sinisisi nila lahat ng problema ni Joseon
Dialogue: 0,0:19:10.20,0:19:12.00,Default,Spillik2,0,0,0,,sa isang gang ng mga bandido!
Dialogue: 0,0:19:12.51,0:19:14.01,Default,Spikyulka2,0,0,0,,Upang puksain ang tunay na pinagmumulan ng kasamaan,
Dialogue: 0,0:19:14.01,0:19:16.84,Default,Spikyulka2,0,0,0,,Pahihintulutan ko si Ijeongcheon na magsagawa ng imbestigasyon para sa interes ng mga tao!
Dialogue: 0,0:19:18.21,0:19:20.38,Default,Spillik2,0,0,0,,Nakaupo sa trono
Dialogue: 0,0:19:20.38,0:19:22.11,Default,Spikyulka2,0,0,0,,ang esensya ng mga tao ay hindi maintindihan.
Dialogue: 0,0:19:22.85,0:19:25.75,Default,Spikyulka2,0,0,0,,Kapag sinimulan mong tuparin ang kanilang mga hinihingi, walang katapusan ito.
Dialogue: 0,0:19:26.42,0:19:28.45,Default,Spilyk2,0,0,0,,Dapat nating sugpuin sila sa pamamagitan ng puwersa,
Dialogue: 0,0:19:29.56,0:19:32.22,Default,Spikyulka2,0,0,0,,upang matiyak na hindi na mauulit ang mga pag-aalsa.
Dialogue: 0,0:19:32.42,0:19:35.06,Default,Spikyulka2,0,0,0,,-Sumasang-ayon kami, Kamahalan.\N-Sumasang-ayon kami, Kamahalan.
Dialogue: 0,0:19:44.54,0:19:46.34,Default,Spilyk2,0,0,0,,Titingnan ko lahat ng mga bilanggo para makasigurado
Dialogue: 0,0:19:47.01,0:19:49.14,Default,Spikyulka2,0,0,0,,na sa kanila ay walang mga inosenteng biktima ng kawalan ng batas.
Dialogue: 0,0:19:49.91,0:19:52.61,Default,Spikyulka2,0,0,0,,At saka, paparusahan ko ng mahigpit ang mga bandido,
Dialogue: 0,0:19:52.61,0:19:54.71,Default,Spilyk2,0,0,0,,upang may halimbawa para sa lahat.
Dialogue: 0,0:19:55.41,0:19:57.78,Default,Spikyulka2,0,0,0,,At iuutos ko sa mga gobernador at mga pinuno ng militar na parusahan,
Dialogue: 0,0:19:58.58,0:20:00.05,Default,Spilyk2,0,0,0,,mga responsable sa ating mga problema.
Dialogue: 0,0:20:15.37,0:20:18.60,Default,Spikyulka2,0,0,0,,Nais supilin ang pag-aalsa sa tulong lamang ng batas.
Dialogue: 0,0:20:20.27,0:20:22.37,Default,Spillik2,0,0,0,,Gaano kawalang muwang.
Dialogue: 0,0:20:23.84,0:20:25.81,Default,Silk2,0,0,0,,Bago mawalan ng kontrol ang pag-aalsa,
Dialogue: 0,0:20:26.08,0:20:29.01,Default,Spikyulka2,0,0,0,,Magpapadala ako ng mga tropa at susukuin ang mga tagasunod ng Tonhak.
Dialogue: 0,0:20:31.25,0:20:32.55,Default,Spillik2,0,0,0,,Ano ang ginagawa mo?
Dialogue: 0,0:20:32.72,0:20:35.45,Default,Spillik2,0,0,0,,Ilapat ang elixir bago matuyo ang aking mukha.
Dialogue: 0,0:20:35.79,0:20:39.53,Default,Spikyulka2,0,0,0,,Kamahalan, tapos na.
Dialogue: 0,0:20:43.60,0:20:48.23,Default,Spikyulka2,0,0,0,,Dapat ko bang hilingin sa reyna na gumawa ng higit pa?
Dialogue: 0,0:20:48.50,0:20:49.77,Default,Spillik2,0,0,0,,Hindi sulit.
Dialogue: 0,0:20:49.77,0:20:51.57,Default,Spikyulka2,0,0,0,,Siyempre hindi. Kalimutan mo na ang sinabi ko.
Dialogue: 0,0:20:51.57,0:20:53.44,Default,Spilyk2,0,0,0,,-Maaari kang pumunta.\N-Oo.
Dialogue: 0,0:21:05.05,0:21:08.29,Default,Silk2,0,0,0,,Hindi mo pa rin ba mapapatawad ang reyna?
Dialogue: 0,0:21:08.49,0:21:10.42,Default,Spilyk2,0,0,0,,Basahin ko ang kanyang sulat sa hari,
Dialogue: 0,0:21:10.42,0:21:12.36,Default,Spilyk2,0,0,0,,hindi sana nagtanong.
Dialogue: 0,0:21:12.52,0:21:14.73,Default,Spillik2,0,0,0,,Hindi malulutas ng pagpapatawad ang problema.
Dialogue: 0,0:21:15.03,0:21:17.70,Default,Spillik2,0,0,0,,Walang ibang kalokohan sa love letters nila.
Dialogue: 0,0:21:18.63,0:21:20.97,Default,Spikyulka2,0,0,0,,Gusto pa nilang ibigay ang kanilang buhay para sa isa't isa.
Dialogue: 0,0:21:40.89,0:21:42.92,Default,Spikyulka2,0,0,0,,At ito ang gantimpala para sa aking debosyon sa iyong pamilya?
Dialogue: 0,0:21:43.22,0:21:45.02,Default,Spikyulka2,0,0,0,,Na-frame mo ang pamilya ko at kami ay pinaalis.
Dialogue: 0,0:21:45.02,0:21:46.29,Default,Spikyulka2,0,0,0,,Ginawa kaming mga rebelde
Dialogue: 0,0:21:46.29,0:21:47.53,Default,Spikyulka2,0,0,0,,at pinagkaitan ng hinaharap.
Dialogue: 0,0:21:47.53,0:21:49.80,Default,Spikyulka2,0,0,0,,Paano mo kami ipaubaya sa aming kapalaran?
Dialogue: 0,0:21:51.50,0:21:54.90,Default,Spikyulka2,0,0,0,,Isipin ang iyong sarili na masuwerte na hindi ka pinatay.
Dialogue: 0,0:21:56.47,0:22:00.21,Default,Spillik2,0,0,0,,At least buhay ang pamilya mo.
Dialogue: 0,0:22:13.15,0:22:14.95,Default,Spillik2,0,0,0,,Halika magtrabaho para sa akin sa palasyo.
Dialogue: 0,0:22:16.49,0:22:17.99,Default,Spikyulka2,0,0,0,,Patutunayan ko,
Dialogue: 0,0:22:18.99,0:22:20.96,Default,Spilyk2,0,0,0,,na iba ako sa tatay ko.
Dialogue: 0,0:22:31.30,0:22:32.40,Default,Spillik2,0,0,0,,Masarap ang booze sa araw.
Dialogue: 0,0:22:32.40,0:22:33.51,Default,Spillik2,0,0,0,,Siyempre.
Dialogue: 0,0:22:35.17,0:22:37.54,Default,Spillik2,0,0,0,,Pag-inom sa kalagitnaan ng araw.
Dialogue: 0,0:22:39.11,0:22:42.41,Default,Spillit2,0,0,0,,Oh, hipon. Bihirang produkto.
Dialogue: 0,0:22:46.59,0:22:48.82,Default,Spilyk2,0,0,0,,-Sino ka?\N-Sino ka?
Dialogue: 0,0:22:49.22,0:22:51.19,Default,Spillik2,0,0,0,,Buong araw kang umiinom dito.
Dialogue: 0,0:22:51.42,0:22:54.19,Default,Spilyk2,0,0,0,,Ano? How dare you talk to me like that?
Dialogue: 0,0:22:54.66,0:22:56.53,Default,Spilyk2,0,0,0,,Sino ka pa rin?
Dialogue: 0,0:22:57.66,0:22:58.80,Default,Spillik2,0,0,0,,Hayaan mo akong magpakilala.
Dialogue: 0,0:23:01.60,0:23:02.74,Default,Spillik2,0,0,0,,Oo.
Dialogue: 0,0:23:03.44,0:23:04.64,Default,Spillik2,0,0,0,,Ako ay isang lihim na inspektor.
Dialogue: 0,0:23:09.31,0:23:10.64,Default,Spilyk2,0,0,0,,Oh, ganyan dapat.
Dialogue: 0,0:23:14.11,0:23:17.52,Default,Spikyulka2,0,0,0,,Nabalitaan ko na ngayon ay may mga pekeng sikretong inspektor dito.
Dialogue: 0,0:23:17.52,0:23:19.22,Default,Spikyulka2,0,0,0,,Hindi ko binibili ang trick mo.
Dialogue: 0,0:23:20.05,0:23:23.02,Default,Spillit2,0,0,0,,Wala nang kapangyarihan ang token gaya ng dati.
Dialogue: 0,0:23:31.96,0:23:34.87,Default,Spikyulka2,0,0,0,,Dumating na ang Secret Inspector.
Dialogue: 0,0:23:35.50,0:23:37.47,Default,Spillik2,0,0,0,,Maawa ka.
Dialogue: 0,0:23:37.47,0:23:42.04,Default,Spikyulka2,0,0,0,,Sa ngayon, mas maaasahan ang isang baril kaysa sa isang token.
Dialogue: 0,0:23:51.08,0:23:52.38,Default,Spilyk2,0,0,0,,Narito ang isang splinter.
Dialogue: 0,0:23:52.38,0:23:54.52,Default,Spilyk2,0,0,0,,Lalaki kami. Hindi kami naghahain ng tsaa na may matamis.
Dialogue: 0,0:23:56.29,0:23:58.49,Default,Silk2,0,0,0,,Nagtataka ako kung bakit niya kami tinawag.
Dialogue: 0,0:23:58.49,0:24:01.73,Default,Spillik2,0,0,0,,Gumagamit ng latigo ang hari. At ang reyna ay gingerbread.
Dialogue: 0,0:24:02.16,0:24:03.70,Default,Spikyulka2,0,0,0,,Marahil ito ang plano nila.
Dialogue: 0,0:24:05.56,0:24:08.50,Default,Silk2,0,0,0,,Marahil gustong ipakita na tayo ay mula sa iisang angkan.
Dialogue: 0,0:24:09.30,0:24:10.40,Default,Spikyulka2,0,0,0,,Ngunit hindi ito gagana.
Dialogue: 0,0:24:11.00,0:24:13.67,Default,Spillik2,0,0,0,,Makipaglaro lang tayo.
Dialogue: 0,0:24:14.77,0:24:16.71,Default,Spilyk2,0,0,0,,-Syempre.\N-Tara na.
Dialogue: 0,0:24:21.05,0:24:23.45,Default,Spikyulka2,0,0,0,, Medyo mahabang panahon na ang lumipas mula noong ako ay umakyat sa trono.
Dialogue: 0,0:24:23.92,0:24:26.82,Default,Silk2,0,0,0,,Ngunit hindi ko kailanman inimbitahan ang aking angkan sa kapistahan.
Dialogue: 0,0:24:27.89,0:24:29.72,Default,Spikyulka2,0,0,0,,Naging abala ako kamakailan.
Dialogue: 0,0:24:30.69,0:24:31.99,Default,Spikyulka2,0,0,0,,Patawarin mo ako.
Dialogue: 0,0:24:37.03,0:24:39.36,Default,Silk2,0,0,0,,Hindi ito marami dito, ngunit ako mismo ang nagluto para sa iyo.
Dialogue: 0,0:24:40.60,0:24:41.70,Default,Spillik2,0,0,0,,Enjoy.
Dialogue: 0,0:24:51.84,0:24:54.45,Default,Spikyulka2,0,0,0,,Ito ay alak, hindi tsaa.
Dialogue: 0,0:24:55.85,0:24:57.32,Default,Spillik2,0,0,0,,Magpanggap na tsaa.
Dialogue: 0,0:24:57.32,0:24:59.52,Default,Spillik2,0,0,0,,Inutusan ng hari na bawasan ang bilang ng mga ulam.
Dialogue: 0,0:24:59.65,0:25:02.25,Default,Spikyulka2,0,0,0,,Paano pa kaya magsasama-sama at mag-iinuman ang mga sakop niya?
Dialogue: 0,0:25:02.55,0:25:03.69,Default,Spikyulka2,0,0,0,,Pero kung malaman niya...
Dialogue: 0,0:25:15.03,0:25:18.20,Default,Spikyulka2,0,0,0,,Nilinlang mo kami, Kamahalan.
Dialogue: 0,0:25:18.74,0:25:21.04,Default,Spilyk2,0,0,0,,Na-set up mo na ba kami?
Dialogue: 0,0:25:21.14,0:25:23.14,Default,Spillik2,0,0,0,,-Hindi kapani-paniwala.\N-Paano siya?
Dialogue: 0,0:25:25.38,0:25:28.11,Default,Spillik2,0,0,0,,Tigilan mo na ako sa galit. Nakakasira ng mood.
Dialogue: 0,0:25:28.85,0:25:31.15,Default,Spikyulka2,0,0,0,,Pero pinagalit mo kami.
Dialogue: 0,0:25:31.15,0:25:34.62,Default,Spillik2,0,0,0,,Ano? Kanino mo kami dinadala?
Dialogue: 0,0:25:36.02,0:25:39.79,Default,Spilyk2,0,0,0,,Alam ko talaga kung sino ka.
Dialogue: 0,0:25:41.56,0:25:43.90,Default,Spikyulka2,0,0,0,,Ikaw ang kasamaan ng lipunang ito.
Dialogue: 0,0:25:44.60,0:25:46.83,Default,Spillik2,0,0,0,,-Evil?\N-Evil?
Dialogue: 0,0:25:48.33,0:25:53.01,Default,Spikyulka2,0,0,0,,Sa iyong wika - ikaw ang salot ng panahong ito.
Dialogue: 0,0:25:53.01,0:25:54.81,Default,Spillik2,0,0,0,,-Ano?\N-Ano?
Dialogue: 0,0:25:54.81,0:25:57.34,Default,Spikyulka2,0,0,0,,Bakit natin dapat tiisin ang ganitong pagtrato?
Dialogue: 0,0:25:57.68,0:25:58.84,Default,Spillik2,0,0,0,,Aalis.
Dialogue: 0,0:25:59.48,0:26:01.31,Default,Spilyk2,0,0,0,,Bakit mo ito inayos para sa amin?
Dialogue: 0,0:26:02.41,0:26:04.52,Default,Spilyk2,0,0,0,,Magandang tanong. Natutuwa kang nagtanong.
Dialogue: 0,0:26:05.18,0:26:07.62,Default,Spikyulka2,0,0,0,,No wonder the chief adviser, napakatalino mo.
Dialogue: 0,0:26:07.62,0:26:08.75,Default,Spilyk2,0,0,0,,Ano...
Dialogue: 0,0:26:09.66,0:26:11.66,Default,Spikyulka2,0,0,0,,Tinatanong mo ba kung bakit ko ito inayos?
Dialogue: 0,0:26:12.82,0:26:17.66,Default,Spikyulka2,0,0,0,,Sinusubukan kong sabihin sa iyo na huwag hadlangan ang hari.
Dialogue: 0,0:26:19.60,0:26:23.17,Default,Spikyulka2,0,0,0,,Lalabanan mo ang kanyang mga ideya,
Dialogue: 0,0:26:23.87,0:26:27.07,Default,Spikyulka2,0,0,0,,alam na manggagaling ako sa likod at sabay-sabay
Dialogue: 0,0:26:27.07,0:26:29.47,Default,Spilyk2,0,0,0,,Papatayin ko lahat.
Dialogue: 0,0:26:30.71,0:26:31.94,Default,Spillik2,0,0,0,,Isider na binalaan ka.
Dialogue: 0,0:26:40.25,0:26:42.02,Default,Spikyulka2,0,0,0,,Kung ang layunin mo ay lumikha ng kawalan ng batas,
Dialogue: 0,0:26:42.02,0:26:44.19,Default,Spilyk2,0,0,0,,nagtatago sa likod ng clan,
Dialogue: 0,0:26:45.69,0:26:48.29,Default,Spilyk2,0,0,0,,mag-ingat ka.
Dialogue: 0,0:26:49.06,0:26:51.06,Default,Spikyulka2,0,0,0,,Reyna, isa ka rin sa mga Andonian Kim.
Dialogue: 0,0:26:51.06,0:26:53.80,Default,Biryulka2,0,0,0,,Kaya nagpasya akong palitan ang aking apelyido.
Dialogue: 0,0:26:53.80,0:26:56.47,Default,Spikyulka2,0,0,0,,Ngayon hindi na ako si Kim So-yeon. Ako si Chan Soyeon.
Dialogue: 0,0:26:56.47,0:26:59.17,Default,Spikyulka2,0,0,0,,-Ano?\N-Ano ba...
Dialogue: 0,0:27:01.14,0:27:04.38,Default,Spikyulka2,0,0,0,,Napakasiksik yata nila, dahil tinulungan sila ng clan na makakuha ng mga posisyon.
Dialogue: 0,0:27:04.38,0:27:05.61,Default,Spillik2,0,0,0,,Tamaan ang iyong ilong.
Dialogue: 0,0:27:05.61,0:27:07.45,Default,Spikyulka2,0,0,0,,Wala nang pagtutol.
Dialogue: 0,0:27:07.81,0:27:09.72,Default,Spikyulka2,0,0,0,,Walang mga pagtatalo. Walang sabwatan.
Dialogue: 0,0:27:09.72,0:27:11.18,Default,Spilyk2,0,0,0,,Walang biyahe papuntang Okthajeong.
Dialogue: 0,0:27:11.18,0:27:13.25,Default,Spikyulka2,0,0,0,,Ano ang kinalaman ni Okthajon dito?
Dialogue: 0,0:27:14.52,0:27:15.82,Default,Spilyk2,0,0,0,,Well, hindi ako makakapunta.
Dialogue: 0,0:27:18.02,0:27:20.87,Default,Lily,0,0,0,,Natupad ang order nang walang anumang problema.
Dialogue: 0,0:27:22.17,0:27:26.61,Default,Lily,0,0,0,,Inalagaan ito ng Queen Dowager.
Dialogue: 0,0:27:29.00,0:27:31.43,Default,Lily,0,0,0,,Dumating ako ngayon na may kahilingan.
Dialogue: 0,0:27:32.81,0:27:35.31,Default,Lily,0,0,0,,Ngayong nakipagkaisa ka na sa aking angkan,
Dialogue: 0,0:27:35.31,0:27:38.62,Default,Lily,0,0,0,,huwag mo nang takutin o saktan ang reyna,
Dialogue: 0,0:27:38.74,0:27:40.24,Default,Lily,0,0,0,,mula din siya sa clan namin.
Dialogue: 0,0:27:43.28,0:27:45.16,Default,Lily,0,0,0,,Ang ating kaaway ay ang hari.
Dialogue: 0,0:27:46.42,0:27:50.63,Default,Lily,0,0,0,,Pagbabanta sa isa't isa gamit ang mga espada,\NTutulungan lang natin ang kalaban.
Dialogue: 0,0:27:51.86,0:27:53.67,Default,Lily,0,0,0,,Sumasang-ayon ako.
Dialogue: 0,0:27:53.67,0:27:57.80,Default,Lily,0,0,0,,Wala nang shamanic rituals at talismans. Pinabayaan ko sila.
Dialogue: 0,0:28:01.93,0:28:05.31,Default,Lily,0,0,0,,-Kamahalan.\N-May sasabihin ako sa iyo.
Dialogue: 0,0:28:16.62,0:28:18.82,Default,Lily,0,0,0,,Oo, dapat akong magbasa ng mga libro sa panahong ito,
Dialogue: 0,0:28:18.82,0:28:20.39,Default,Lily,0,0,0,,upang mas maunawaan ang wika.
Dialogue: 0,0:28:20.83,0:28:23.13,Default,Lily,0,0,0,,Mahirap magmura sa magiliw na paraan.
Dialogue: 0,0:28:24.02,0:28:27.46,Default,Lily,0,0,0,,Saan ko mababasa ang tungkol sa mga salitang balbal ng Joseon?
Dialogue: 0,0:28:27.46,0:28:30.43,Default,Lily,0,0,0,,Walang ganoong mga libro sa library na ito.
Dialogue: 0,0:28:30.80,0:28:31.96,Default,Lily,0,0,0,,Nasaan ito?
Dialogue: 0,0:28:32.14,0:28:34.64,Default,Lily,0,0,0,,Bumaling sa mga nobela,
Dialogue: 0,0:28:34.64,0:28:36.77,Default,Lily,0,0,0,,ibinebenta sa isang tindahan sa labas ng palasyo.
Dialogue: 0,0:28:38.00,0:28:39.20,Default,Lily,0,0,0,,Ano ang pinag-uusapan nila?
Dialogue: 0,0:28:39.97,0:28:43.88,Default,Lily,0,0,0,,Narinig ko ang tungkol sa kanila. Pero never kong binasa.
Dialogue: 0,0:28:44.82,0:28:46.24,Default,Lily,0,0,0,,Alam ko ang ilan.
Dialogue: 0,0:28:47.71,0:28:49.18,Default,Lily,0,0,0,,Tungkol sa isang tapat na asawa,
Dialogue: 0,0:28:49.18,0:28:51.01,Default,Lilia,0,0,0,,namatay pagkatapos ng pagtataksil ng kanyang asawa.
Dialogue: 0,0:28:51.01,0:28:53.56,Default,Lily,0,0,0,,Bumalik ang kanyang espiritu na may nunal malapit sa kanyang bibig,
Dialogue: 0,0:28:53.56,0:28:54.98,Default,Lily,0,0,0,,upang maghiganti.
Dialogue: 0,0:28:56.16,0:28:57.80,Default,Lily,0,0,0,,Anong pamilyar na kwento.
Dialogue: 0,0:28:57.86,0:28:59.06,Default,Lily,0,0,0,,Ano ang pangalan ng libro?
Dialogue: 0,0:28:59.13,0:29:00.49,Default,Lily,0,0,0,,"Tukso ng asawa."
Dialogue: 0,0:29:01.90,0:29:02.99,Default,Lily,0,0,0,,Hindi mo binasa.
Dialogue: 0,0:29:03.10,0:29:06.10,Default,Lily,0,0,0,,Pangalan lang ang alam ko.
Dialogue: 0,0:29:07.70,0:29:09.41,Default,Lily,0,0,0,,At gayundin? ano pa ba?
Dialogue: 0,0:29:09.67,0:29:11.00,Default,Lily,0,0,0,,Ito ay lumabas kamakailan.
Dialogue: 0,0:29:11.00,0:29:12.64,Default,Lily,0,0,0,,Tungkol sa marangal na ginang.
Dialogue: 0,0:29:12.64,0:29:15.67,Default,Lilia,0,0,0,,Nakipagrelasyon ang kanyang asawa sa anak ng kapitbahay.
Dialogue: 0,0:29:15.67,0:29:17.32,Default,Lily,0,0,0,,"Ang mundo ng mag-asawa."
Dialogue: 0,0:29:19.38,0:29:22.24,Default,Lily,0,0,0,,Lady Choi, bakit ka nag-aalala, hindi mo ba nabasa?
Dialogue: 0,0:29:23.12,0:29:24.56,Default,Lily,0,0,0,,Paumanhin.
Dialogue: 0,0:29:26.42,0:29:29.45,Default,Lily,0,0,0,,Pareho ang reaksyon ng lahat ng babae sa mga ganitong kwento.
Dialogue: 0,0:29:35.72,0:29:37.19,Default,Lily,0,0,0,,Bakit mo ginawa ito?
Dialogue: 0,0:29:38.46,0:29:39.76,Default,Lily,0,0,0,,Iwan mo kami.
Dialogue: 0,0:29:42.07,0:29:43.14,Default,Lily,0,0,0,,Oo.
Dialogue: 0,0:29:49.44,0:29:52.62,Default,Lily,0,0,0,,Kailangan mo ng suporta ng clan para matiyak ang iyong kaligtasan.
Dialogue: 0,0:29:53.05,0:29:55.12,Default,Lily,0,0,0,,Bakit sinisira ang relasyon mo sa kanila?
Dialogue: 0,0:29:55.51,0:29:56.95,Default,Lily,0,0,0,,Mukhang nakalimutan mo,
Dialogue: 0,0:29:56.98,0:29:59.45,Default,Lily,0,0,0,,na sinubukan akong patayin ng matatandang ito.
Dialogue: 0,0:29:59.45,0:30:01.72,Default,Lily,0,0,0,,Ginagawa ko ang lahat ng aking makakaya upang makagawa ng mga tulay,
Dialogue: 0,0:30:01.72,0:30:03.45,Default,Lily,0,0,0,,para makabalik ka.
Dialogue: 0,0:30:03.45,0:30:05.13,Default,Lily,0,0,0,,Ayoko nang bumalik.
Dialogue: 0,0:30:06.49,0:30:07.96,Default,Lily,0,0,0,,I tried my best,
Dialogue: 0,0:30:07.96,0:30:10.46,Default,Lily,0,0,0,,upang ligawan ang Dowager Queen.
Dialogue: 0,0:30:10.46,0:30:12.93,Default,Lily,0,0,0,,Hindi ako nagsumikap kahit sa Blue House.
Dialogue: 0,0:30:14.73,0:30:16.20,Default,Lily,0,0,0,,At ano ang nakuha ko bilang tugon?
Dialogue: 0,0:30:16.58,0:30:17.70,Default,Lily,0,0,0,,Poisoned ice.
Dialogue: 0,0:30:17.70,0:30:19.85,Default,Lily,0,0,0,,Ito ay dahil sa mga tsismis na ipinakalat ng angkan ng Cho.
Dialogue: 0,0:30:20.55,0:30:22.74,Default,Lily,0,0,0,,Iingatan kitang ligtas.
Dialogue: 0,0:30:23.27,0:30:24.97,Default,Lily,0,0,0,,Let's clear.
Dialogue: 0,0:30:24.97,0:30:26.94,Default,Lily,0,0,0,,Mas maaga kaysa mamaya.
Dialogue: 0,0:30:28.01,0:30:30.39,Default,Lily,0,0,0,,Hindi ko ibabalik ang nararamdaman mo
Dialogue: 0,0:30:30.39,0:30:32.28,Default,Lily,0,0,0,,at hindi ko magagamit ang mga ito.
Dialogue: 0,0:30:32.78,0:30:33.86,Default,Lily,0,0,0,,I
Dialogue: 0,0:30:35.56,0:30:37.42,Default,Lily,0,0,0,,pumili ng ibang landas,
Dialogue: 0,0:30:37.80,0:30:39.90,Default,Lily,0,0,0,,mas mabuti na ang bawat isa ay pumunta sa kanya-kanyang paraan.
Dialogue: 0,0:30:43.84,0:30:45.87,Default,Lily,0,0,0,,Iyo ako, Kamahalan.
Dialogue: 0,0:30:51.97,0:30:53.85,Default,Lily,0,0,0,,Bakit ang hari?
Dialogue: 0,0:30:54.41,0:30:57.12,Default,Lily,0,0,0,,Kung mawala siya, gagawin ko ang lahat,
Dialogue: 0,0:30:57.12,0:30:59.58,Default,Lily,0,0,0,,anuman ang hilingin mo. Bakit siya?
Dialogue: 0,0:31:04.82,0:31:06.72,Default,Lily,0,0,0,,Hindi ito tungkol sa kanya.
Dialogue: 0,0:31:07.89,0:31:09.92,Default,Lily,0,0,0,,Wala akong nararamdaman para sa iyo.
Dialogue: 0,0:31:23.03,0:31:25.31,Default,Lily,0,0,0,,Huwag mong bitawan ang kamay ko, Soyeon.
Dialogue: 0,0:31:28.11,0:31:29.88,Default,Lily,0,0,0,,Ikaw ang lahat sa akin.
Dialogue: 0,0:32:11.71,0:32:13.45,Default,Lily,0,0,0,,Dapat mong ilarawan
Dialogue: 0,0:32:13.45,0:32:15.18,Default,Lily,0,0,0,,bawat detalye, bawat hibla ng buhok.
Dialogue: 0,0:32:16.25,0:32:18.13,Default,Lily,0,0,0,,Sinalamin hindi lamang ang hitsura,
Dialogue: 0,0:32:18.13,0:32:19.66,Default,Lily,0,0,0,,kundi pati na rin ang panloob na lakas at dignidad.
Dialogue: 0,0:32:19.66,0:32:21.80,Default,Lily,0,0,0,,Huwag gumamit ng sarili mong istilo.
Dialogue: 0,0:32:31.17,0:32:32.27,Default,Lily,0,0,0,,My queen.
Dialogue: 0,0:32:33.24,0:32:35.11,Default,Lily,0,0,0,,May inaalala ka ba?
Dialogue: 0,0:32:36.31,0:32:37.55,Default,Lily,0,0,0,,Hindi, hindi ko sasabihin.
Dialogue: 0,0:32:39.27,0:32:41.18,Default,Lily,0,0,0,,Masama ang pakiramdam ko.
Dialogue: 0,0:32:44.51,0:32:45.75,Default,Lily,0,0,0,,My queen.
Dialogue: 0,0:32:50.10,0:32:51.40,Default,Lily,0,0,0,,Ano ang nangyari sa iyo?
Dialogue: 0,0:32:52.90,0:32:55.67,Default,Lily,0,0,0,,Kapag ngumiti ako ng ganyan parang hari ang boses ko.
Dialogue: 0,0:32:55.67,0:32:58.99,Default,Lily,0,0,0,,At kapag nag-cross ang mga mata, ang boses ay parang eunuch.
Dialogue: 0,0:33:03.88,0:33:05.27,Default,Lily,0,0,0,,Hindi nakakatawa?
Dialogue: 0,0:33:05.97,0:33:09.24,Default,Lily,0,0,0,,Napakahirap magpatawa.
Dialogue: 0,0:33:09.58,0:33:10.67,Default,Lily,0,0,0,,Pagkatapos...
Dialogue: 0,0:33:11.55,0:33:14.35,Default,Lily,0,0,0,,Kapag nakayuko ako, nagsasalita ako na parang utusan.
Dialogue: 0,0:33:14.35,0:33:17.92,Default,Lily,0,0,0,,At kapag tumuwid ako, nagsasalita ako na parang mandirigma.
Dialogue: 0,0:33:17.92,0:33:19.39,Default,Lily,0,0,0,,Hindi nakakatawa?
Dialogue: 0,0:33:27.83,0:33:29.13,Default,Lily,0,0,0,,Tumawa ka.
Dialogue: 0,0:33:30.23,0:33:31.37,Default,Lily,0,0,0,,Kamahalan.
Dialogue: 0,0:33:31.69,0:33:34.00,Default,Lily,0,0,0,,-Take your pose.\N-Okay.
Dialogue: 0,0:33:35.11,0:33:36.73,Default,Lily,0,0,0,,Patawanin kita mamaya.
Dialogue: 0,0:33:39.31,0:33:42.08,Default,Lily,0,0,0,,Nga pala, bakit mo kailangan itong portrait?
Dialogue: 0,0:33:42.08,0:33:44.35,Default,Lily,0,0,0,,Ayon sa panuntunang "Cho" at "Chon",
Dialogue: 0,0:33:44.35,0:33:46.65,Default,Lily,0,0,0,,Si Haring Seongjong ay tatawaging Sunjo nang may karangalan,
Dialogue: 0,0:33:48.65,0:33:51.21,Default,Lily,0,0,0,,na ang ibig sabihin ay igagalang din nila ako,
Dialogue: 0,0:33:51.21,0:33:52.75,Default,Lily,0,0,0,,para sa pagnanais na parangalan ang kanyang alaala.
Dialogue: 0,0:33:52.75,0:33:55.16,Default,Lily,0,0,0,,Rule "Cho" at "Chon"...
Dialogue: 0,0:33:55.33,0:33:57.66,Default,Lily,0,0,0,,Narinig ko ang tungkol sa kanya.
Dialogue: 0,0:33:57.92,0:34:00.26,Default,Lily,0,0,0,,Sa pagpili ng posthumous na pangalan ng hari
Dialogue: 0,0:34:00.26,0:34:02.72,Default,Lily,0,0,0,,"Cho" ay ginagamit para sa mga gumawa ng malaking kontribusyon,
Dialogue: 0,0:34:02.72,0:34:05.19,Default,Lily,0,0,0,,at "Chon" ay para sa mga sikat sa kabutihan.
Dialogue: 0,0:34:06.34,0:34:07.74,Default,Lily,0,0,0,,Exactly, now I remember.
Dialogue: 0,0:34:13.70,0:34:15.78,Default,Lily,0,0,0,,Kamahalan, dinala ko ang hinihiling mo.
Dialogue: 0,0:34:16.68,0:34:18.34,Default,Lily,0,0,0,,Tingnan natin.
Dialogue: 0,0:34:26.32,0:34:28.13,Default,Lily,0,0,0,,Mukhang cool.
Dialogue: 0,0:34:28.13,0:34:30.09,Default,Lily,0,0,0,,Gusto mo bang matuto ng fencing?
Dialogue: 0,0:34:30.40,0:34:31.72,Default,Lily,0,0,0,,Magaling ako.
Dialogue: 0,0:34:32.36,0:34:34.47,Default,Lily,0,0,0,,Hindi ko na kailangan pang mag-aral.
Dialogue: 0,0:34:34.67,0:34:36.59,Default,Lily,0,0,0,,Ako ang pinakamagaling sa kutsilyo.
Dialogue: 0,0:34:37.20,0:34:41.76,Default,Lily,0,0,0,,Ito ay regalo para sa isang espesyal na tao.
Dialogue: 0,0:34:43.61,0:34:44.88,Default,Lily,0,0,0,,Espesyal?
Dialogue: 0,0:35:07.26,0:35:08.59,Default,Lily,0,0,0,,My turn?
Dialogue: 0,0:35:08.97,0:35:10.43,Default,Lily,0,0,0,,Kaya hinihintay mo ito?
Dialogue: 0,0:35:10.67,0:35:12.07,Default,Lily,0,0,0,,Well, sorry.
Dialogue: 0,0:35:12.40,0:35:14.51,Default,Lily,0,0,0,,Ikaw ay pinalayas,
Dialogue: 0,0:35:14.51,0:35:17.03,Default,Lily,0,0,0,,Hindi ako sigurado na sulit na makipaglokohan sa iyo.
Dialogue: 0,0:35:17.97,0:35:19.18,Default,Lily,0,0,0,,Nakakatawa.
Dialogue: 0,0:35:20.28,0:35:21.95,Default,Lily,0,0,0,,Nagmungkahi ka ng isang alyansa,
Dialogue: 0,0:35:21.95,0:35:23.61,Default,Lily,0,0,0,,pero umalis sila ng walang paalam.
Dialogue: 0,0:35:23.68,0:35:25.92,Default,Lily,0,0,0,,Hindi mo makontrol ang iyong asawa.
Dialogue: 0,0:35:25.92,0:35:28.82,Default,Lily,0,0,0,,So hindi mo sinigurado ang kaligtasan ko?
Dialogue: 0,0:35:32.22,0:35:34.26,Default,Lily,0,0,0,,Kita mo, may plano ako.
Dialogue: 0,0:35:34.26,0:35:36.22,Default,Lily,0,0,0,,Hanggang sa hinamon mo ako.
Dialogue: 0,0:35:36.59,0:35:38.43,Default,Lily,0,0,0,,Ano ang punto?
Dialogue: 0,0:35:38.43,0:35:40.97,Default,Lily,0,0,0,,Mamuhay ng kalmado, boring na buhay.
Dialogue: 0,0:35:44.63,0:35:45.86,Default,Lily,0,0,0,,Ilabas ang iyong espada.
Dialogue: 0,0:35:47.80,0:35:50.51,Default,Lily,0,0,0,,Hindi ako nakikipag-away sa mga babae.
Dialogue: 0,0:35:52.80,0:35:55.68,Default,Lily,0,0,0,,Ito ay isang regalo tungkol sa pagtanggal sa pwesto.
Dialogue: 0,0:35:57.11,0:36:01.28,Default,Lily,0,0,0,,Lahat ng iyong mga nagawa ay minarkahan sa talim,
Dialogue: 0,0:36:02.22,0:36:03.51,Default,Lily,0,0,0,,tingnan mo.
Dialogue: 0,0:36:11.82,0:36:15.22,Default,Lily,0,0,0,,Ito ang buhay na pinangunahan mo.
Dialogue: 0,0:36:17.09,0:36:18.57,Default,Lily,0,0,0,,Sabi mo wala akong pakialam sa kahit ano
Dialogue: 0,0:36:19.09,0:36:22.61,Default,Lily,0,0,0,,ay hindi kaya, dahil babae ako, hindi reyna.
Dialogue: 0,0:36:23.84,0:36:26.47,Default,Lily,0,0,0,,Teka. Ipapakita ko ang aking mga kakayahan.
Dialogue: 0,0:36:27.78,0:36:30.32,Default,Lily,0,0,0,,Wala nang mga hadlang sa aking mga salita o gawa,
Dialogue: 0,0:36:30.65,0:36:32.18,Default,Lily,0,0,0,,dahil wala akong mawawala.
Dialogue: 0,0:36:49.20,0:36:52.20,Default,Lily,0,0,0,,Kamahalan, dumating na ang pangunahing babae.
Dialogue: 0,0:36:53.43,0:36:54.63,Default,Lily,0,0,0,,Papasukin mo siya.
Dialogue: 0,0:37:08.84,0:37:10.26,Default,Lily,0,0,0,,Kumusta ang pakiramdam mo?
Dialogue: 0,0:37:13.05,0:37:16.05,Default,Lily,0,0,0,,Inayos ko ang aking mga iniisip habang nag-shooting ako gamit ang busog.
Dialogue: 0,0:37:16.05,0:37:17.82,Default,Lily,0,0,0,,Nakahanap ng kapayapaan.
Dialogue: 0,0:37:19.05,0:37:20.13,Default,Lily,0,0,0,,Natutuwa akong marinig iyon.
Dialogue: 0,0:37:21.90,0:37:24.09,Default,Lily,0,0,0,,Gabi na, at marami ka pang dapat gawin.
Dialogue: 0,0:37:24.09,0:37:26.13,Default,Lily,0,0,0,,Huwag mag-alala tungkol dito.
Dialogue: 0,0:37:32.84,0:37:34.34,Default,Lily,0,0,0,,Paunang tagubilin para sa mga bata
Dialogue: 0,0:37:47.49,0:37:50.32,Default,Lily,0,0,0,,Kung alam ko kung gaano mo papahalagahan ang aklat na ito,
Dialogue: 0,0:37:50.80,0:37:52.49,Default,Lily,0,0,0,,Susubukan kong hayaan itong malinis.
Dialogue: 0,0:37:53.49,0:37:54.93,Default,Lily,0,0,0,,Tingnan ang mga scribble na ito.
Dialogue: 0,0:38:02.80,0:38:05.53,Default,Lily,0,0,0,,Mukhang busy ka. Masyado na akong naglaan ng oras.
Dialogue: 0,0:38:05.53,0:38:06.63,Default,Lily,0,0,0,,Pupunta ako.
Dialogue: 0,0:38:12.22,0:38:13.28,Default,Lily,0,0,0,,Concubine.
Dialogue: 0,0:38:15.49,0:38:17.82,Default,Lily,0,0,0,,Wala akong oras na sabihin.
Dialogue: 0,0:38:20.26,0:38:21.72,Default,Lily,0,0,0,,Nagustuhan kita
Dialogue: 0,0:38:23.38,0:38:25.45,Default,Lily,0,0,0,,hindi lang dahil sa meeting sa balon
Dialogue: 0,0:38:25.45,0:38:27.43,Default,Lily,0,0,0,,walong taon na ang nakalipas.
Dialogue: 0,0:38:28.53,0:38:30.63,Default,Lily,0,0,0,,Nang bumalik ako sa Hanyang at nakilala kita,
Dialogue: 0,0:38:31.86,0:38:33.26,Default,Lily,0,0,0,,Nagustuhan kita.
Dialogue: 0,0:38:38.34,0:38:40.80,Default,Lily,0,0,0,,Kamahalan, dumating na si Prince Yeonpyeong.
Dialogue: 0,0:38:46.47,0:38:48.74,Default,Lily,0,0,0,,Hindi ko alam na nandito ka.
Dialogue: 0,0:38:48.92,0:38:50.28,Default,Lily,0,0,0,,Aalis na sana ako.
Dialogue: 0,0:38:51.68,0:38:53.18,Default,Lily,0,0,0,,Iiwan na kita.
Dialogue: 0,0:39:06.24,0:39:08.40,Default,Lily,0,0,0,,Ano ang pinag-uusapan mo?
Dialogue: 0,0:39:11.18,0:39:13.34,Default,Lily,0,0,0,,Tumalikod sa katotohanang walang nangangailangan,
Dialogue: 0,0:39:14.97,0:39:16.70,Default,Lily,0,0,0,,mas tama.
Dialogue: 0,0:39:47.45,0:39:49.40,Default,Lily,0,0,0,,Mga mata na puno ng pagsinta.
Dialogue: 0,0:39:51.11,0:39:53.88,Default,Lily,0,0,0,,Napakahilig sa social sciences.
Dialogue: 0,0:39:58.76,0:40:00.88,Default,Lily,0,0,0,,Buong araw kang naghihintay sa lesson ko.
Dialogue: 0,0:40:01.32,0:40:04.13,Default,Lily,0,0,0,,Hindi ako naniniwala sa iyo, ngunit masasabi mo
Dialogue: 0,0:40:04.13,0:40:05.90,Default,Lily,0,0,0,,mga kwento tungkol sa hinaharap, tulad kagabi.
Dialogue: 0,0:40:06.59,0:40:07.97,Default,Lily,0,0,0,,Paksa ng aralin para sa araw na ito.
Dialogue: 0,0:40:26.18,0:40:27.49,Default,Lily,0,0,0,,Constitutional monarchy.
Dialogue: 0,0:40:28.92,0:40:30.32,Default,Lily,0,0,0,,Constitutional monarchy?
Dialogue: 0,0:40:30.65,0:40:32.68,Default,Lily,0,0,0,,May mga monarch, ngunit hindi nila pinamumunuan ang mga tao.
Dialogue: 0,0:40:33.99,0:40:37.09,Default,Lily,0,0,0,,Ang pinuno ay umiiral, ngunit ang mga tao ay may kapangyarihan din.
Dialogue: 0,0:40:40.03,0:40:41.49,Default,Lily,0,0,0,,May bansang tinatawag na Bhutan.
Dialogue: 0,0:40:41.90,0:40:43.63,Default,Lily,0,0,0,,Kakaibang pangalan para sa isang bansa.
Dialogue: 0,0:40:43.86,0:40:46.67,Default,Lily,0,0,0,,May isang hari na may mas kakaibang pangalan, Jigme Khesar.
Dialogue: 0,0:40:46.97,0:40:49.43,Default,Lily,0,0,0,,Dati ay may absolutong monarkiya, tulad ng sa Joseon.
Dialogue: 0,0:40:49.43,0:40:51.11,Default,Lily,0,0,0,,Ngunit binago niya ito sa isang monarkiya ng konstitusyon.
Dialogue: 0,0:40:51.51,0:40:52.61,Default,Lily,0,0,0,,Bakit?
Dialogue: 0,0:40:53.11,0:40:55.84,Default,Lily,0,0,0,,Natatakot siya na baka umakyat sa trono ang isang tyrant,
Dialogue: 0,0:40:55.84,0:40:57.28,Default,Lily,0,0,0,,na sisira sa bansa.
Dialogue: 0,0:40:57.92,0:41:00.18,Default,Lily,0,0,0,,Kaya ipinakilala niya ang isang constitutional system.
Dialogue: 0,0:41:00.45,0:41:02.09,Default,Lily,0,0,0,,Siya ang namamahala sa bansa batay sa batas.
Dialogue: 0,0:41:02.22,0:41:04.26,Default,Lily,0,0,0,,Kaya simbolo lang ang kaharian.
Dialogue: 0,0:41:04.68,0:41:07.18,Default,Lily,0,0,0,,Si Jigme Khesar ay matalino.
Dialogue: 0,0:41:08.22,0:41:10.49,Default,Lily,0,0,0,,Anong Chinese character ang ginamit niya sa pagsulat ng "Ji"?
Dialogue: 0,0:41:28.90,0:41:31.45,Default,Lily,0,0,0,,Oras na para umuwi.
Dialogue: 0,0:41:32.74,0:41:33.78,Default,Lily,0,0,0,,Uuwi na?
Dialogue: 0,0:41:34.88,0:41:35.92,Default,Lily,0,0,0,,Nasaan ito?
Dialogue: 0,0:41:35.92,0:41:40.18,Default,Lily,0,0,0,,Dude, masyado kang nainom.
Dialogue: 0,0:41:40.18,0:41:41.63,Default,Lily,0,0,0,,Nakalimutan kung saan ang iyong bahay.
Dialogue: 0,0:41:42.68,0:41:45.03,Default,Lily,0,0,0,,Alam mo kung ano? Sapat na ako.
Dialogue: 0,0:41:45.03,0:41:48.20,Default,Lily,0,0,0,,Kailangan ko ng umuwi at magpahinga.
Dialogue: 0,0:41:56.17,0:41:57.74,Default,Lily,0,0,0,,Wala akong bahay.
Dialogue: 0,0:42:00.70,0:42:02.15,Default,Lily,0,0,0,,Wala akong anuman.
Dialogue: 0,0:42:05.61,0:42:09.34,Default,Lily,0,0,0,,Wala akong mapupuntahan, wala ako.
Dialogue: 0,0:42:11.68,0:42:13.99,Default,Lily,0,0,0,,Wala akong kahit ano.
Dialogue: 0,0:42:29.24,0:42:33.57,Default,tier 4,0,0,0,,nagustuhan kita \Nhindi lang dahil sa meeting sa balon
Dialogue: 0,0:42:33.57,0:42:35.51,Default,tier 4,0,0,0,,walong taon na ang nakalipas.
Dialogue: 0,0:42:37.28,0:42:38.32,Default,tier 4,0,0,0,,No.
Dialogue: 0,0:42:40.01,0:42:41.78,Default,tier 4,0,0,0,,Hindi niya malaman ang katotohanan.
Dialogue: 0,0:42:52.86,0:42:55.09,Default,tier 4,0,0,0,,Hindi ka makapasok.
Dialogue: 0,0:42:55.09,0:42:56.59,Default,tier 4,0,0,0,,Dapat kong makita ang hari.
Dialogue: 0,0:42:57.34,0:42:59.20,Default,tier 4,0,0,0,,Well...
Dialogue: 0,0:43:04.70,0:43:06.93,Default,shooting 4,0,0,0,,Kamahalan, ito si Hwajin.
Dialogue: 0,0:43:45.57,0:43:47.92,Default,tier 4,0,0,0,,Kaya gusto mo,
Dialogue: 0,0:43:47.92,0:43:50.22,Default,tier 4,0,0,0,,para matapos ko ang libro sa mga taktika kasama ang reyna,
Dialogue: 0,0:43:50.49,0:43:52.26,Default,tier 4,0,0,0,,nakasuot ng lalaki.
Dialogue: 0,0:43:53.78,0:43:55.03,Default,tier 4,0,0,0,,Mahusay.
Dialogue: 0,0:43:56.88,0:43:58.22,Default,tier 4,0,0,0,,Itapon ang iyong mga pagkiling.
Dialogue: 0,0:43:58.40,0:43:59.65,Default,tier 4,0,0,0,,Gumagawa siya ng mga armas,
Dialogue: 0,0:43:59.65,0:44:01.49,Default,tier 4,0,0,0,,na wala pang nakakita noon.
Dialogue: 0,0:44:03.97,0:44:06.57,Default,tier 4,0,0,0,,Well, makinig tayo.
Dialogue: 0,0:44:07.61,0:44:10.88,Default,tier 4,0,0,0,,Bago iyon, pag-usapan natin ang nakamamatay na paraan ng pagsasanay sa mga sundalo.
Dialogue: 0,0:44:11.18,0:44:12.84,Default,tier 4,0,0,0,,Bakit hindi magsimula dito?
Dialogue: 0,0:44:14.95,0:44:16.05,Default,tier 4,0,0,0,,Nakamamatay na paraan?
Dialogue: 0,0:44:18.92,0:44:21.42,Default,tier 4,0,0,0,,1, 2, 3.
Dialogue: 0,0:44:21.68,0:44:22.72,Default,tier 4,0,0,0,,Seven.
Dialogue: 0,0:44:22.72,0:44:26.26,Default,tier 4,0,0,0,,Hindi kita marinig. Yan lang ba ang kaya mong gawin?
Dialogue: 0,0:44:27.09,0:44:30.18,Default,tier 4,0,0,0,,Okay, naiintindihan ko ang lahat. Pag-usapan natin ang tungkol sa mga armas.
Dialogue: 0,0:44:30.55,0:44:32.99,Default,tier 4,0,0,0,,14 approach sa kabuuan. Ito ang ika-8.
Dialogue: 0,0:44:34.97,0:44:37.09,Default,tier 4,0,0,0,,Huwag sabihin ang huling numero.
Dialogue: 0,0:44:37.30,0:44:39.86,Default,tier 4,0,0,0,,Kung pangalanan mo ito, magsisimula kang muli.
Dialogue: 0,0:44:41.26,0:44:43.57,Default,tier 4,0,0,0,,1, 2, 3.
Dialogue: 0,0:44:43.90,0:44:44.90,Default,tier 4,0,0,0,,Anim.
Dialogue: 0,0:44:45.70,0:44:46.97,Default,tier 4,0,0,0,,1, 2, 3.
Dialogue: 0,0:44:46.97,0:44:48.90,Default,tier 4,0,0,0,,-Tumingin ng diretso.\N-Seven.
Dialogue: 0,0:44:49.07,0:44:51.61,Default,tier 4,0,0,0,,Mapanganib na payagan siya sa diskarteng militar.
Dialogue: 0,0:44:51.92,0:44:54.82,Default,tier 4,0,0,0,,Nagdeklara ng digmaan ang Reyna sa kanyang angkan.
Dialogue: 0,0:44:55.78,0:44:58.38,Default,tier 4,0,0,0,,Hindi na niya kailangang patunayan na siya ay para sa atin.
Dialogue: 0,0:45:01.09,0:45:02.18,Default,tier 4,0,0,0,,Kamahalan.
Dialogue: 0,0:45:02.18,0:45:04.86,Default,tier 4,0,0,0,,-Itaas ang iyong mga paa.\N-2, 3.
Dialogue: 0,0:45:05.13,0:45:06.49,Default,tier 4,0,0,0,,-Eight.\N-Nakaraan.
Dialogue: 0,0:45:07.26,0:45:08.76,Default,tier 4,0,0,0,,Eight ang huling numero.
Dialogue: 0,0:45:09.32,0:45:11.09,Default,tier 4,0,0,0,,Magsimula muli.
Dialogue: 0,0:45:11.09,0:45:12.86,Default,tier 4,0,0,0,,Maghintay. Ang pamamaraang ito ng pagpatay
Dialogue: 0,0:45:12.86,0:45:14.51,Default,tier 4,0,0,0,,matatapos kapag namatay ako?
Dialogue: 0,0:45:14.51,0:45:16.20,Default,tier 4,0,0,0,,Magsimula muli.
Dialogue: 0,0:45:16.70,0:45:18.01,Default,tier 4,0,0,0,,-Halika.\N-Isa.
Dialogue: 0,0:45:19.03,0:45:20.28,Default,tier 4,0,0,0,,Kamahalan.
Dialogue: 0,0:45:32.32,0:45:34.13,Default,tier 4,0,0,0,,Mabagal na nagiging halimaw -
Dialogue: 0,0:45:37.53,0:45:39.59,Default,tier 4,0,0,0,,at hindi mo ito napapansin mismo.
Dialogue: 0,0:45:50.13,0:45:51.70,Default,tier 4,0,0,0,,Itong pekeng entry
Dialogue: 0,0:45:51.70,0:45:54.01,Default,tier 4,0,0,0,,sapat para alisin ang kaliwang tagapayo.
Dialogue: 0,0:45:54.84,0:45:57.20,Default,tier 4,0,0,0,,-Alagaan mo siya.\N-Oo.
Dialogue: 0,0:46:00.18,0:46:03.05,Default,tier 4,0,0,0,,Kamahalan, dumating na ang pangunahing babae.
Dialogue: 0,0:46:03.82,0:46:04.99,Default,tier 4,0,0,0,,Papasukin mo ako.
Dialogue: 0,0:46:16.86,0:46:18.40,Default,tier 4,0,0,0,,May kailangan akong sabihin sa iyo.
Dialogue: 0,0:46:20.84,0:46:23.93,Default,tier 4,0,0,0,,Prinsipe Yeonpyeong, pwede mo ba kaming iwan?
Dialogue: 0,0:46:24.61,0:46:26.63,Default,tier 4,0,0,0,,-Your Highness.\N-Pakiusap.
Dialogue: 0,0:46:36.11,0:46:39.88,Default,tier 4,0,0,0,,Kamakailan ay madalas mong kausapin ang reyna sa gabi.
Dialogue: 0,0:46:41.05,0:46:42.99,Default,tier 4,0,0,0,,Pwede ko bang malaman kung ano ang iyong tinalakay?
Dialogue: 0,0:46:43.36,0:46:45.90,Default,tier 4,0,0,0,,Napag-usapan namin kung paano ko nakikita ang hinaharap ni Joseon.
Dialogue: 0,0:46:47.80,0:46:51.09,Default,tier 4,0,0,0,,Akala ko ako lang ang makakasama mo sa iyong mga pangarap.
Dialogue: 0,0:46:52.30,0:46:53.59,Default,tier 4,0,0,0,,Habang papalapit sa iyo ang reyna,
Dialogue: 0,0:46:53.59,0:46:57.13,Default,tier 4,0,0,0,,ang ginawa ko lang ay nag-alinlangan dahil sa kasinungalingan ng iba.
Dialogue: 0,0:47:00.90,0:47:03.01,Default,tier 4,0,0,0,,Ngunit hindi ko na ito papayagan.
Dialogue: 0,0:47:05.15,0:47:06.78,Default,tier 4,0,0,0,,Paunang tagubilin para sa mga bata
Dialogue: 0,0:47:08.51,0:47:09.88,Default,tier 4,0,0,0,,hindi sa akin.
Dialogue: 0,0:47:15.15,0:47:16.68,Default,tier 4,0,0,0,,Alam mo na ang tungkol dito.
Dialogue: 0,0:47:17.95,0:47:20.20,Default,tier 4,0,0,0,,Kung gayon bakit wala silang sinabi?
Dialogue: 0,0:47:20.53,0:47:22.57,Default,tier 4,0,0,0,,Dahil wala itong mababago.
Dialogue: 0,0:47:22.57,0:47:24.74,Default,tier 4,0,0,0,,Bakit walang magbabago nito?
Dialogue: 0,0:47:26.13,0:47:29.24,Default,tier 4,0,0,0,,Wala ka nang tiwala sa akin.
Dialogue: 0,0:47:30.90,0:47:34.01,Default,tier 4,0,0,0,,Hindi mo na ako tinitingnan sa parehong paraan.
Dialogue: 0,0:47:34.38,0:47:36.80,Default,tier 4,0,0,0,,Dahil sa isang kasinungalingan,
Dialogue: 0,0:47:37.38,0:47:40.11,Default,tier 4,0,0,0,,hindi mawawala ang oras na kasama mo.
Dialogue: 0,0:47:41.68,0:47:44.01,Default,tier 4,0,0,0,,Ang katotohanan na minahal kita sa loob ng dalawang taon,
Dialogue: 0,0:47:45.15,0:47:46.32,Default,tier 4,0,0,0,,hindi magbabago.
Dialogue: 0,0:47:46.68,0:47:48.68,Default,tier 4,0,0,0,,Sigurado akong ginawa mo ito para sa kapakanan ko.
Dialogue: 0,0:47:50.93,0:47:52.82,Default,tier 4,0,0,0,,Dahil ganyan kang tao.
Dialogue: 0,0:47:54.80,0:47:57.36,Default,tier 4,0,0,0,,Sa tingin mo ba ang katotohanan ay magpapasaya sa akin,
Dialogue: 0,0:47:57.70,0:47:59.74,Default,tier 4,0,0,0,,na nagkunwari kang walang alam?
Dialogue: 0,0:47:59.74,0:48:02.70,Default,shooting 4,0,0,0,,-Hwajin.\N-Na-frame ko ang reyna.
Dialogue: 0,0:48:04.28,0:48:05.40,Default,tier 4,0,0,0,,I
Dialogue: 0,0:48:06.53,0:48:08.24,Default,tier 4,0,0,0,,nahanap ang Kim family accounting book
Dialogue: 0,0:48:08.24,0:48:09.95,Default,tier 4,0,0,0,,at ibinigay ito sa Inang Reyna.
Dialogue: 0,0:48:11.55,0:48:12.61,Default,tier 4,0,0,0,,Bakit ka...
Dialogue: 0,0:48:14.38,0:48:15.55,Default,tier 4,0,0,0,,Dahil
Dialogue: 0,0:48:17.68,0:48:18.99,Default,tier 4,0,0,0,,I hate the queen.
Dialogue: 0,0:48:20.11,0:48:22.32,Default,tier 4,0,0,0,,Alam mo ba na ang ledger na ito
Dialogue: 0,0:48:23.15,0:48:25.15,Default,tier 4,0,0,0,,kailangan ba talaga sa akin?
Dialogue: 0,0:48:25.32,0:48:26.80,Default,tier 4,0,0,0,,Alam, ngunit ibinigay ito.
Dialogue: 0,0:48:29.09,0:48:31.47,Default,tier 4,0,0,0,,Paano mo ito magagawa?
Dialogue: 0,0:48:32.17,0:48:34.84,Default,tier 4,0,0,0,,Mas alam mo kaysa sa iba ang napanaginipan ko.
Dialogue: 0,0:48:36.13,0:48:37.63,Default,tier 4,0,0,0,,Niyurakan mo ang mga pangarap ko.
Dialogue: 0,0:48:37.63,0:48:38.90,Default,tier 4,0,0,0,,Ang pangarap ko...
Dialogue: 0,0:48:39.78,0:48:41.88,Default,tier 4,0,0,0,,Ikaw ang pangarap ko.
Dialogue: 0,0:48:43.40,0:48:46.92,Default,tier 4,0,0,0,,Ngunit nagsimulang tumibok ang iyong puso para sa reyna.
Dialogue: 0,0:48:48.24,0:48:50.42,Default,tier 4,0,0,0,,Sinubukan mo ako nang husto,
Dialogue: 0,0:48:51.18,0:48:53.92,Default,tier 4,0,0,0,,pero nakita ko kung paano mo siya inaabot.
Dialogue: 0,0:48:55.63,0:48:58.36,Default,tier 4,0,0,0,,I felt so pathetic.
Dialogue: 0,0:49:01.32,0:49:03.47,Default,tier 4,0,0,0,,Kaya nawala ako sa sarili ko.
Dialogue: 0,0:49:17.45,0:49:18.72,Default,tier 4,0,0,0,,Kasalanan ko.
Dialogue: 0,0:49:20.78,0:49:22.49,Default,tier 4,0,0,0,,Naging ganito ka dahil sa akin.
Dialogue: 0,0:49:24.05,0:49:25.68,Default,tier 4,0,0,0,,Kasalanan ko.
Dialogue: 0,0:49:27.42,0:49:31.05,Default,tier 4,0,0,0,,Hindi dapat ako nagmahal nang hindi inaalagaan ang sarili ko.
Dialogue: 0,0:49:34.97,0:49:36.32,Default,tier 4,0,0,0,,Pupunta ako
Dialogue: 0,0:49:37.86,0:49:39.40,Default,tier 4,0,0,0,,at hahanapin ko ang sarili ko.
Dialogue: 0,0:49:53.28,0:49:54.61,Default,tier 4,0,0,0,,"The World of the Married Couple. Volume 1"
Dialogue: 0,0:49:54.61,0:49:56.49,Default,tier 4,0,0,0,,Nakakaloka!
Dialogue: 0,0:49:57.65,0:49:58.72,Default,tier 4,0,0,0,,Susunod.
Dialogue: 0,0:49:59.95,0:50:01.18,Default,tier 4,0,0,0,,"The World of the Married Couple. Volume 2"
Dialogue: 0,0:50:03.45,0:50:07.93,Default,shooting range 4,0,0,0,,Kamahalan, hindi ka ba pupunta sa Hijeongjong Hall ngayon?
Dialogue: 0,0:50:08.57,0:50:09.99,Default,tier 4,0,0,0,,Siguro dapat ko itong laktawan ngayon?
Dialogue: 0,0:50:13.07,0:50:16.03,Default,tier 4,0,0,0,,Ang aking Cheoljong ay lubhang maghihintay sa aking pagdating.
Dialogue: 0,0:50:19.57,0:50:22.65,Default,tier 4,0,0,0,,Sino ang mag-aakala\N na ako ay may tulad na uhaw sa kaalaman.
Dialogue: 0,0:50:23.78,0:50:25.11,Default,shooting 4,0,0,0,,Isa pang page.
Dialogue: 0,0:50:36.36,0:50:39.40,Default,tier 4,0,0,0,,Kim Soyeon
Dialogue: 0,0:50:42.47,0:50:45.99,Default,shooting 4,0,0,0,,Choljong, sorry, sorry. Isang page lang ang gusto kong basahin
Dialogue: 0,0:50:45.99,0:50:47.49,Default,tier 4,0,0,0,,ngunit hindi mahinto.
Dialogue: 0,0:50:48.24,0:50:49.70,Default,tier 4,0,0,0,,Bakit hindi ka pa nagpapalit ng damit?
Dialogue: 0,0:50:58.38,0:51:01.49,Default,tier 4,0,0,0,,Ano? Bakit mo ako binibigay?
Dialogue: 0,0:51:02.18,0:51:06.72,Default,tier 4,0,0,0,,Diba sabi mo ibalik ko siya sayo kung gusto kong mabuhay?
Dialogue: 0,0:51:12.59,0:51:17.32,Default,tier 4,0,0,0,,Maaari mong saktan ang isang tao nang hindi nalalaman ang katotohanan.
Dialogue: 0,0:51:18.47,0:51:20.36,Default,tier 4,0,0,0,,Matagal ko nang hinihintay,
Dialogue: 0,0:51:20.99,0:51:22.80,Default,tier 4,0,0,0,,upang ibalik ang aklat sa may-ari nito.
Dialogue: 0,0:51:32.24,0:51:33.68,Default,tier 4,0,0,0,,Paumanhin,
Dialogue: 0,0:51:34.88,0:51:36.55,Default,tier 4,0,0,0,,na hindi kita nakilala.
Dialogue: 0,0:51:39.36,0:51:40.72,Default,tier 4,0,0,0,,At ikaw ako.
Dialogue: 0,0:51:42.18,0:51:44.65,Default,tier 4,0,0,0,,Hindi ako naging tapat sa iyo.
Dialogue: 0,0:51:47.05,0:51:49.22,Default,tier 4,0,0,0,,Bumalik siya sa may-ari pagkatapos ng 8 taon.
Dialogue: 0,0:51:49.99,0:51:53.13,Default,tier 4,0,0,0,,Hindi na natin maibabalik ang nawala nating oras.
Dialogue: 0,0:51:55.40,0:51:56.97,Default,tier 4,0,0,0,,Gayunpaman
Dialogue: 0,0:51:58.38,0:52:01.20,Default,tier 4,0,0,0,,Hindi na kita iiwan muli.
Dialogue: 0,0:52:07.11,0:52:10.59,Default,tier 4,0,0,0,,Pero paano ka nabuhay
Dialogue: 0,0:52:11.01,0:52:13.65,Default,tier 4,0,0,0,,lahat ng walong taon na ito?
Dialogue: 0,0:52:14.82,0:52:18.80,Default,tier 4,0,0,0,,Kakaiba ka noon, ngunit hindi ganoon kalaki.
Dialogue: 0,0:52:19.36,0:52:21.22,Default,tier 4,0,0,0,,May na-miss ba ako?
Dialogue: 0,0:52:23.30,0:52:24.59,Default,tier 4,0,0,0,,Magandang tanong.
Dialogue: 0,0:52:40.89,0:52:42.76,Default,tier 4,0,0,0,,Mukhang maganda, bagama't hindi ko alam kung ano ito.
Dialogue: 0,0:52:45.03,0:52:46.26,Default,tier 4,0,0,0,,Ito ay gamot.
Dialogue: 0,0:52:47.50,0:52:49.70,Default,tier 4,0,0,0,,Lahat ng lihim mong kinakain ay dapat masarap.
Dialogue: 0,0:52:51.70,0:52:52.84,Default,tier 4,0,0,0,,Yogurt?
Dialogue: 0,0:52:54.34,0:52:56.37,Default,tier 4,0,0,0,,-Amoy alak.\N-Well, yun...
Dialogue: 0,0:52:57.64,0:52:58.91,Default,tier 4,0,0,0,,Ito ay pear wine.
Dialogue: 0,0:52:59.14,0:53:01.04,Default,tier 4,0,0,0,,Gawa sa mga bulaklak ng peras
Dialogue: 0,0:53:01.04,0:53:04.82,Default,tier 4,0,0,0,,at inumin kapag umiikot sa hangin ang halimuyak ng mga bulaklak.
Dialogue: 0,0:53:05.82,0:53:06.98,Default,tier 4,0,0,0,,Magbubuhos ka ba ng baso?
Dialogue: 0,0:53:07.15,0:53:08.65,Default,tier 4,0,0,0,,Isa na lang ang natitira sa akin.
Dialogue: 0,0:53:08.65,0:53:11.66,Default,tier 4,0,0,0,,Ang paglikha nito ay nangangailangan ng maraming pagsisikap, kaya iningatan ko ito.
Dialogue: 0,0:53:11.66,0:53:13.16,Default,tier 4,0,0,0,,-Pero dahil sayo...\N-Damn.
Dialogue: 0,0:53:15.43,0:53:16.73,Default,tier 4,0,0,0,,Paano mo ito nagawa?
Dialogue: 0,0:53:17.66,0:53:21.30,Default,tier 4,0,0,0,,Una, ihanda ang kuwarta sa pamamagitan ng paghahalo ng tubig na may mababang taba na pulbos ng bigas.
Dialogue: 0,0:53:21.30,0:53:24.03,Default,tier 4,0,0,0,,Pagkatapos ay patagin natin ang masa at gumawa ng butas.
Dialogue: 0,0:53:24.03,0:53:25.80,Default,tier 4,0,0,0,,Ginagawa ang paghahanda.
Dialogue: 0,0:53:27.91,0:53:29.34,Default,tier 4,0,0,0,,Mukhang donut.
Dialogue: 0,0:53:32.68,0:53:33.68,Default,tier 4,0,0,0,,Magpatuloy.
Dialogue: 0,0:53:33.68,0:53:36.95,Default,tier 4,0,0,0,,Kaya, magluto sa mainit na tubig, ilabas ito,
Dialogue: 0,0:53:36.95,0:53:39.08,Default,tier 4,0,0,0,,masahin at hayaang lumamig.
Dialogue: 0,0:53:39.88,0:53:42.82,Default,tier 4,0,0,0,,Kumuha ng mga bulaklak ng peras at pre-prepared yeast
Dialogue: 0,0:53:42.82,0:53:44.56,Default,tier 4,0,0,0,,at gawin muli ang kuwarta.
Dialogue: 0,0:53:44.82,0:53:48.59,Default,tier 4,0,0,0,,Ilagay ito sa pitsel at isara ang takip.
Dialogue: 0,0:53:48.59,0:53:50.96,Default,tier 4,0,0,0,,Sa tatlong araw...
Dialogue: 0,0:53:50.96,0:53:52.10,Default,tier 4,0,0,0,,Pwede ba akong uminom?
Dialogue: 0,0:53:54.63,0:53:55.97,Default,tier 4,0,0,0,,Siyempre hindi.
Dialogue: 0,0:53:56.43,0:53:59.67,Default,tier 4,0,0,0,,Alogin mo ito.
Dialogue: 0,0:53:59.67,0:54:01.47,Default,tier 4,0,0,0,,At pagkatapos ng 20 araw
Dialogue: 0,0:54:02.47,0:54:04.11,Default,tier 4,0,0,0,,maari ka nang uminom.
Dialogue: 0,0:54:06.61,0:54:08.21,Default,tier 4,0,0,0,,Hayaan ang oras na lumipad.
Dialogue: 0,0:54:08.88,0:54:10.61,Default,tier 4,0,0,0,,Ipilit kaagad.
Dialogue: 0,0:54:16.32,0:54:17.89,Default,tier 4,0,0,0,,Left Advisor Kim Seok-keun
Dialogue: 0,0:54:17.89,0:54:19.46,Default,tier 4,0,0,0,,kasama ang mga lokal na opisyal
Dialogue: 0,0:54:19.46,0:54:23.16,Default,tier 4,0,0,0,,maling ginamit ang paggawa ng mga magsasaka at mga huwad na rekord.
Dialogue: 0,0:54:23.16,0:54:24.76,Default,tier 4,0,0,0,,Kaugnay ng kaso ng pagnanakaw
Dialogue: 0,0:54:24.76,0:54:26.36,Default,tier 4,0,0,0,,aalisin siya sa kanyang posisyon,
Dialogue: 0,0:54:26.36,0:54:28.57,Default,tier 4,0,0,0,,at kukumpiskahin ang kanyang ari-arian.
Dialogue: 0,0:54:28.80,0:54:30.40,Default,tier 4,0,0,0,,How dare you!
Dialogue: 0,0:54:32.97,0:54:35.44,Default,tier 4,0,0,0,,Huwag lumapit. Bitawan mo ako!
Dialogue: 0,0:54:35.84,0:54:37.71,Default,tier 4,0,0,0,,Hayaan mo!
Dialogue: 0,0:54:39.14,0:54:40.44,Default,tier 4,0,0,0,,Hands off!
Dialogue: 0,0:54:45.62,0:54:49.12,Default,tier 4,0,0,0,,Hindi ko man lang naisip na ang babala ng reyna ay hindi komedya.
Dialogue: 0,0:54:50.32,0:54:52.36,Default,tier 4,0,0,0,,Sa halip ng kaliwang tagapayo
Dialogue: 0,0:54:52.66,0:54:54.99,Default,tier 4,0,0,0,,Itinalaga ko ang ama ng concubine na si Min,
Dialogue: 0,0:54:54.99,0:54:57.29,Default,tier 4,0,0,0,,Min Ujina mula sa Yohyn clan Min.
Dialogue: 0,0:54:57.29,0:54:59.10,Default,tier 4,0,0,0,,Muling isaalang-alang ang iyong desisyon.
Dialogue: 0,0:54:59.10,0:55:01.60,Default,tier 4,0,0,0,,-Muling isaalang-alang ang iyong desisyon.\N-Muling isaalang-alang ang iyong desisyon.
Dialogue: 0,0:55:16.45,0:55:17.88,Default,tier 4,0,0,0,,Magiging maikli ang pag-uusap.
Dialogue: 0,0:55:19.12,0:55:21.42,Default,tier 4,0,0,0,,Kailan maibabalik ang aking regency?
Dialogue: 0,0:55:21.49,0:55:24.66,Default,tier 4,0,0,0,,Dapat mangyari ito bago sirain ng hari si Joseon.
Dialogue: 0,0:55:24.82,0:55:28.03,Default,tier 4,0,0,0,,Hindi na mawawalan ng posisyon ang aming pamilya.
Dialogue: 0,0:55:28.59,0:55:30.69,Default,tier 4,0,0,0,,Bukod dito, nagtitipon kami ng mga tropa,
Dialogue: 0,0:55:30.89,0:55:33.16,Default,tier 4,0,0,0,,kaya hindi nagtagal umalis ang hari.
Dialogue: 0,0:55:33.16,0:55:34.43,Default,tier 4,0,0,0,,Bilisan mo.
Dialogue: 0,0:55:34.43,0:55:36.70,Default,tier 4,0,0,0,,Hindi ako kilala sa aking pasensya.
Dialogue: 0,0:55:36.97,0:55:38.07,Default,tier 4,0,0,0,,Oo.
Dialogue: 0,0:55:38.57,0:55:42.17,Default,tier 4,0,0,0,,Nga pala, may narinig akong kakaiba.
Dialogue: 0,0:55:43.71,0:55:47.24,Default,tier 4,0,0,0,,Na ipinakilala ng reyna ang hari sa mga ideyal na lapastangan sa diyos.
Dialogue: 0,0:56:00.79,0:56:01.86,Default,tier 4,0,0,0,,Sa gabing walang tulog, naglalakad ako.
Dialogue: 0,0:56:01.86,0:56:02.93,Default,tier 4,0,0,0,,Nababakas ang liwanag sa madilim na kalangitan sa gabi.
Dialogue: 0,0:56:11.00,0:56:12.30,Default,tier 4,0,0,0,,
Dialogue: 0,0:56:17.47,0:56:19.61,Default,tier 4,0,0,0,,
Dialogue: 0,0:56:19.61,0:56:21.21,Default,tier 4,0,0,0,,Meron pa ba siya nito?
Dialogue: 0,0:56:43.70,0:56:45.24,Default,tier 4,0,0,0,,Lahat ba sila ay tagasunod ni Tonhak?
Dialogue: 0,0:56:45.80,0:56:46.80,Default,tier 4,0,0,0,,Oo.
Dialogue: 0,0:56:46.80,0:56:50.71,Default,shooting 4,0,0,0,,-Lumabas ka.\N-Mom.
Dialogue: 0,0:56:50.71,0:56:53.11,Default,tier 4,0,0,0,,Bakit mo dinadala ang bata?
Dialogue: 0,0:56:53.41,0:56:55.58,Default,tier 4,0,0,0,,Pangarap! Pangarap!
Dialogue: 0,0:57:01.49,0:57:02.99,Default,,0,0,0,,Nakikilala mo ba ang sulat-kamay?
Dialogue: 0,0:57:12.46,0:57:15.07,Default,,0,0,0,,Ito ang cipher ng mga tagasunod ng Tonhak.
Dialogue: 0,0:57:21.27,0:57:23.64,Default,,0,0,0,,Sa digmaan, lahat ng paraan ay patas.
Dialogue: 0,0:57:23.64,0:57:24.94,Default,,0,0,0,,"Mga Pondo"? Ano ang ibig sabihin nito?
Dialogue: 0,0:57:25.28,0:57:26.54,Default,,0,0,0,,Isang uri ng salawikain?
Dialogue: 0,0:57:26.88,0:57:29.78,Default,,0,0,0,,Ang isang granada ay maaaring maging mas epektibo kaysa sa 10 sundalo.
Dialogue: 0,0:57:30.15,0:57:32.15,Default,,0,0,0,,Mukhang fiction.
Dialogue: 0,0:57:32.15,0:57:33.18,Default,,0,0,0,,Nga pala,
Dialogue: 0,0:57:33.35,0:57:36.32,Default,,0,0,0,,Naalala ko ang 15 training session dito.
Dialogue: 0,0:57:36.49,0:57:39.66,Default,,0,0,0,,Mukhang totoo, "grenade".
Dialogue: 0,0:57:42.26,0:57:44.69,Default,,0,0,0,,Kung maglalagay ka ng pulbura sa naturang bag at itatapon,
Dialogue: 0,0:57:44.69,0:57:47.16,Default,,0,0,0,,sasabog siya ng ganyan.
Dialogue: 0,0:57:48.10,0:57:49.33,Default,,0,0,0,,Meron kami nito.
Dialogue: 0,0:57:49.93,0:57:51.27,Default,,0,0,0,,Pasabog na bomba.
Dialogue: 0,0:57:51.87,0:57:54.54,Default,,0,0,0,,Talaga? Mayroon ka bang bulletproof vest?
Dialogue: 0,0:57:55.47,0:57:56.91,Default,,0,0,0,,Bulletproof na damit?
Dialogue: 0,0:57:57.31,0:57:58.71,Default,,0,0,0,,Ang ibig mong sabihin ay armor?
Dialogue: 0,0:57:59.24,0:58:01.38,Default,,0,0,0,,Hindi, nagsusuot ng under armor.
Dialogue: 0,0:58:02.78,0:58:03.85,Default,,0,0,0,,Ganyan yan.
Dialogue: 0,0:58:05.45,0:58:06.85,Default,,0,0,0,,Hon!
Dialogue: 0,0:58:08.55,0:58:11.35,Default,,0,0,0,,Dumaan ako, at bukas ang ilaw.
Dialogue: 0,0:58:11.96,0:58:13.42,Default,,0,0,0,,Magandang tingnan.
Dialogue: 0,0:58:15.16,0:58:18.30,Default,,0,0,0,,Nagsasaya ka nang wala ako dito.
Dialogue: 0,0:58:18.60,0:58:20.50,Default,,0,0,0,,Hindi ako makapaniwala na hindi ako inimbitahan.
Dialogue: 0,0:58:25.07,0:58:26.24,Default,,0,0,0,,-Ano bang pinagsasasabi mo.\N-God!
Dialogue: 0,0:58:26.80,0:58:27.97,Default,,0,0,0,,Lee Senman!
Dialogue: 0,0:58:28.57,0:58:30.61,Default,,0,0,0,,Live!
Dialogue: 0,0:58:33.38,0:58:35.11,Default,,0,0,0,,Gaano ako nag-alala.
Dialogue: 0,0:58:36.45,0:58:38.68,Default,,0,0,0,,Nagkita kami sa wakas. talaga!
Dialogue: 0,0:58:40.85,0:58:43.19,Default,,0,0,0,,Natutuwa akong makilala ka rin.
Dialogue: 0,0:58:43.19,0:58:45.62,Default,,0,0,0,,Hindi na bumalik sa Okthajeong?
Dialogue: 0,0:58:45.62,0:58:47.12,Default,,0,0,0,,Napakaraming alak ang nainom ko
Dialogue: 0,0:58:47.12,0:58:50.33,Default,,0,0,0,,doon, umaasang makilala ka.
Dialogue: 0,0:58:50.86,0:58:52.13,Default,,0,0,0,,Lee Senman!
Dialogue: 0,0:58:58.00,0:59:01.10,Default,,0,0,0,,Hands off. Baka pwede kang magpakilala muna?
Dialogue: 0,0:59:01.77,0:59:03.34,Default,,0,0,0,,Sino ka?
Dialogue: 0,0:59:03.51,0:59:07.08,Default,,0,0,0,,Ako ay isang malapit na kaibigan ni Lee Sanman.
Dialogue: 0,0:59:07.94,0:59:10.08,Default,,0,0,0,,"Kaibigan"? ako...
Dialogue: 0,0:59:10.71,0:59:12.98,Default,,0,0,0,,-Iyong...\N-ako...
Dialogue: 0,0:59:14.55,0:59:17.05,Default,,0,0,0,,Maghintay ng isang minuto. Medyo pamilyar ang mukha.
Dialogue: 0,0:59:18.39,0:59:20.92,Default,,0,0,0,,Kaibigan ko, Jeong Chul.
Dialogue: 0,0:59:21.16,0:59:22.23,Default,,0,0,0,,Bakit...
Dialogue: 0,0:59:23.36,0:59:24.93,Default,,0,0,0,,Sino ka kung gayon?
Dialogue: 0,0:59:25.46,0:59:26.70,Default,,0,0,0,,Ako si Jeong Chul.
Dialogue: 0,0:59:30.23,0:59:33.47,Default,,0,0,0,,Oo! Tagumpay!
Dialogue: 0,0:59:35.31,0:59:38.44,Default,,0,0,0,,Ano ang kailangan mong gawin para maglaro ng ganito?
Dialogue: 0,0:59:39.88,0:59:41.78,Default,,0,0,0,,Sabihin na natin, sayang ang kabataan.
Dialogue: 0,0:59:42.35,0:59:43.98,Default,,0,0,0,,Eksaktong kaibigan ko.
Dialogue: 0,0:59:44.28,0:59:46.35,Default,,0,0,0,,Magkapareho kami.
Dialogue: 0,0:59:46.35,0:59:49.29,Default,,0,0,0,,Diyos, tila magandang lugar ito.
Dialogue: 0,0:59:49.72,0:59:51.69,Default,,0,0,0,,Siguro itinatago mo ang mga card sa isang lugar?
Dialogue: 0,0:59:52.02,0:59:54.49,Default,,0,0,0,,Mahirap makakuha ng trump card.
Dialogue: 0,0:59:54.49,0:59:55.93,Default,,0,0,0,,Huwag sisihin ang iyong sarili sa iyong pagkakamali
Dialogue: 0,0:59:55.93,0:59:57.59,Default,,0,0,0,,ang swerte ko.
Dialogue: 0,0:59:57.93,0:59:59.56,Default,,0,0,0,,Well, magpatuloy tayo.
Dialogue: 0,0:59:59.93,1:00:02.07,Default,,0,0,0,,Nakukuha ng mga natalo ang kanilang hiling.
Dialogue: 0,1:00:05.80,1:00:07.54,Default,,0,0,0,,Panoorin ang iyong sumbrero.
Dialogue: 0,1:00:08.44,1:00:09.57,Default,,0,0,0,,Insider.
Dialogue: 0,1:00:12.71,1:00:13.74,Default,,0,0,0,,Labas.
Dialogue: 0,1:00:15.61,1:00:18.11,Default,,0,0,0,,At isang tagasunod ng kanyang mga paniniwala, tulad ko.
Dialogue: 0,1:00:18.78,1:00:20.25,Default,,0,0,0,,Anong alyansa.
Dialogue: 0,1:00:37.63,1:00:38.87,Default,,0,0,0,,Tutulong ako.
Dialogue: 0,1:00:43.07,1:00:44.61,Default,,0,0,0,,Lahat salamat sa noltwigs.
Dialogue: 0,1:00:47.71,1:00:49.18,Default,,0,0,0,,Tiwala ako sa aking tagumpay.
Dialogue: 0,1:01:13.34,1:01:15.97,Default,,0,0,0,,Hindi ako makapaniwala na ginamit nila iyon
Dialogue: 0,1:01:15.97,1:01:18.24,Default,,0,0,0,,upang ilipat ang kaliwang tagapayo.
Dialogue: 0,1:01:19.81,1:01:24.28,Default,,0,0,0,,So... I'm sure nasa kanila ang ledger.
Dialogue: 0,1:01:25.55,1:01:27.68,Default,,0,0,0,,Ngayon magsisimula na ang totoong labanan.
Dialogue: 0,1:01:28.25,1:01:29.25,Default,,0,0,0,,Ano?
Dialogue: 0,1:01:30.65,1:01:33.29,Default,,0,0,0,,Simulan na natin ang paglilinis bago ang pagdanak ng dugo.
Dialogue: 0,1:01:34.59,1:01:36.56,Default,,0,0,0,,Kung ayaw mong magulo dito,
Dialogue: 0,1:01:37.09,1:01:40.70,Default,,0,0,0,, isantabi ang iyong kasakiman at maghanda sa pagbuhos ng dugo.
Dialogue: 0,1:01:41.56,1:01:42.87,Default,,0,0,0,,Spill blood?
Dialogue: 0,1:01:44.80,1:01:47.27,Default,,0,0,0,,Yung mga nagbebenta ng mga trabaho sa gobyerno,
Dialogue: 0,1:01:47.27,1:01:49.47,Default,,0,0,0,,ay magbibitiw sa kanilang sariling kusa.
Dialogue: 0,1:01:51.04,1:01:52.31,Default,,0,0,0,,Kung yumaman ka sa butil
Dialogue: 0,1:01:52.31,1:01:53.54,Default,,0,0,0,,o sa mga regalo,
Dialogue: 0,1:01:53.54,1:01:54.84,Default,,0,0,0,,ibalik lahat.
Dialogue: 0,1:01:56.31,1:01:58.31,Default,,0,0,0,,At ingatan ang mga iyon
Dialogue: 0,1:01:59.22,1:02:02.62,Default,,0,0,0,,na nagtago ng lahat ng record at nakakaalam ng lahat.
Dialogue: 0,1:02:02.62,1:02:03.62,Default,,0,0,0,,Suicide Letter
Dialogue: 0,1:02:03.62,1:02:04.69,Default,,0,0,0,,Iyon,
Dialogue: 0,1:02:06.72,1:02:09.73,Default,,0,0,0,,na hindi naglilinis ng sarili at nag-iiwan ng mga bakas,
Dialogue: 0,1:02:11.46,1:02:13.83,Default,,0,0,0,,dapat sagutin ang lahat.
Dialogue: 0,1:02:18.57,1:02:20.67,Default,,0,0,0,,Kahit na napabagsak ko ang angkan ni Kim,
Dialogue: 0,1:02:20.67,1:02:22.71,Default,,0,0,0,,Lalong lumakas ang kapangyarihan ni Kim Byonin.
Dialogue: 0,1:02:23.34,1:02:25.64,Default,,0,0,0,,Parang walang progress.
Dialogue: 0,1:02:25.64,1:02:27.71,Default,,0,0,0,,Kailangan nating maghanap ng bagay kay Kim Byonin.
Dialogue: 0,1:02:28.55,1:02:31.05,Default,,0,0,0,,Mukhang may natulungan siya sa civil service,
Dialogue: 0,1:02:31.05,1:02:34.22,Default,,0,0,0,,pero hindi mo siya mahuhuli kung wala siyang nakuhang kapalit.
Dialogue: 0,1:02:34.22,1:02:37.72,Default,,0,0,0,,At mukhang hindi iyon.
Dialogue: 0,1:02:40.72,1:02:42.86,Default,,0,0,0,,At ang mga tinulungan niya,
Dialogue: 0,1:02:42.86,1:02:44.43,Default,,0,0,0,,sobrang nagpapasalamat sa kanya,
Dialogue: 0,1:02:45.36,1:02:46.93,Default,,0,0,0,,hindi namin sila maakit.
Dialogue: 0,1:02:46.93,1:02:49.20,Default,,0,0,0,,Nagtayo siya ng isang hindi magagapi na kuta.
Dialogue: 0,1:02:58.41,1:02:59.71,Default,,0,0,0,,Nandito ka na.
Dialogue: 0,1:03:01.91,1:03:03.31,Default,,0,0,0,,Wala pa ba si Lee Senman?
Dialogue: 0,1:03:04.55,1:03:05.62,Default,,0,0,0,,Oh, teka.
Dialogue: 0,1:03:06.35,1:03:09.02,Default,,0,0,0,,I must say, napakasipag niya.
Dialogue: 0,1:03:09.52,1:03:11.59,Default,,0,0,0,,Araw-araw siyang pumupunta para makipaglaro sa amin sa tudzhon.
Dialogue: 0,1:03:15.46,1:03:16.99,Default,,0,0,0,,Wala ka bang trabaho?
Dialogue: 0,1:03:17.23,1:03:18.60,Default,,0,0,0,,Ito ang trabaho ko.
Dialogue: 0,1:03:19.13,1:03:20.96,Default,,0,0,0,,Paano ito gagana?
Dialogue: 0,1:03:21.76,1:03:23.63,Default,,0,0,0,,Uy, tanong ko.
Dialogue: 0,1:03:40.65,1:03:44.82,Default,,0,0,0,,Ngayon parang akin ka na,
Dialogue: 0,1:03:44.82,1:03:49.13,Default,,0,0,0,,pero hindi ka akin.
Dialogue: 0,1:04:24.33,1:04:25.90,Default,,0,0,0,,Pagbati.
Dialogue: 0,1:04:33.94,1:04:39.61,Default,,0,0,0,,Pumunta ako para magreklamo tungkol sa reyna.
Dialogue: 0,1:04:39.61,1:04:41.14,Default,,0,0,0,,Oo, ako rin.
Dialogue: 0,1:04:42.25,1:04:43.78,Default,,0,0,0,,Well, simulan mo na.
Dialogue: 0,1:04:45.22,1:04:46.22,Default,,0,0,0,,Okay.
Dialogue: 0,1:04:49.95,1:04:52.29,Default,,0,0,0,,Kamahalan!
Dialogue: 0,1:04:52.76,1:04:56.76,Default,,0,0,0,,Tigilan mo na ako sa galit!
Dialogue: 0,1:05:02.30,1:05:06.10,Default,,0,0,0,,Kung magpapatuloy ka, ang iyong mukha ay magkakalansing sa dumi.
Dialogue: 0,1:05:08.84,1:05:09.91,Default,,0,0,0,,Oh, sinta.
Dialogue: 0,1:05:10.77,1:05:13.38,Default,,0,0,0,,Bihira lang makakilala ng taong mas magaling magmura kaysa sa akin.
Dialogue: 0,1:05:13.78,1:05:16.38,Default,,0,0,0,,Ngunit bigyan kita ng ilang payo. Kung huminga ka mula dito...
Dialogue: 0,1:05:17.75,1:05:19.15,Default,,0,0,0,,Ang awkward.
Dialogue: 0,1:05:20.92,1:05:23.32,Default,,0,0,0,,-Well, oras na para mag-warm up din ako.\N-Okay.
Dialogue: 0,1:05:25.32,1:05:28.22,Default,,0,0,0,,You piece... You're blowing my mind.
Dialogue: 0,1:05:33.16,1:05:34.33,Default,,0,0,0,,Dito tatanungin kita!
Dialogue: 0,1:05:39.40,1:05:40.40,Default,,0,0,0,,Diyos.
Dialogue: 0,1:05:43.47,1:05:45.44,Default,,0,0,0,,-Siguro magkasama?\N-Syempre.
Dialogue: 0,1:05:47.61,1:05:49.58,Default,,0,0,0,,-Kamahalan!\N-Kamahalan!
Dialogue: 0,1:06:08.40,1:06:11.07,Default,,0,0,0,,Mahal kita, alak ko!
Dialogue: 0,1:06:11.07,1:06:13.60,Default,,0,0,0,,Ang ganda mo, alak ko!
Dialogue: 0,1:06:15.37,1:06:17.17,Default,,0,0,0,,Iyon lang.
Dialogue: 0,1:06:17.17,1:06:18.61,Default,,0,0,0,,Subukan mo rin.
Dialogue: 0,1:06:19.18,1:06:21.21,Default,,0,0,0,,Sa ibaba. Eto na.
Dialogue: 0,1:06:24.75,1:06:25.82,Default,,0,0,0,,At sa iyo.
Dialogue: 0,1:06:26.98,1:06:28.95,Default,,0,0,0,,Ang ganda ng kulay, reyna.
Dialogue: 0,1:06:29.32,1:06:31.19,Default,,0,0,0,,At napakasarap na aroma.
Dialogue: 0,1:06:32.49,1:06:34.89,Default,,0,0,0,,Gayunpaman. Perpektong pagkakalantad.
Dialogue: 0,1:06:35.79,1:06:39.10,Default,,0,0,0,,Ano ang ginawa ninyong dalawa at nawalan kayo ng boses?
Dialogue: 0,1:06:45.20,1:06:46.50,Default,,0,0,0,,Tingnan natin.
Dialogue: 0,1:06:49.24,1:06:51.14,Default,,0,0,0,,-Kamahalan!\N-Kamahalan.
Dialogue: 0,1:06:51.21,1:06:52.78,Default,,0,0,0,,Dahil ba hindi ako kumain ng kahit ano?
Dialogue: 0,1:06:53.98,1:06:59.35,Default,,0,0,0,,Kung gayon ito ay para sa dessert!
Dialogue: 0,1:06:59.88,1:07:02.49,Default,,0,0,0,,Babalikan kita, alak ko!
Dialogue: 0,1:07:02.49,1:07:05.89,Default,,0,0,0,,Ang sarap kong alak!
Dialogue: 0,1:07:09.03,1:07:10.29,Default,,0,0,0,,Mula sa mga talulot ng namumulaklak na peras.
Dialogue: 0,1:07:11.29,1:07:14.13,Default,,0,0,0,,Tumakbo ako dito dahil gusto kong ibigay ito sa iyo ng personal.
Dialogue: 0,1:07:14.63,1:07:16.37,Default,,0,0,0,,Sa wakas, handa na ang libro.
Dialogue: 0,1:07:23.04,1:07:24.24,Default,,0,0,0,,"Military Training Directory"?
Dialogue: 0,1:07:24.91,1:07:26.14,Default,,0,0,0,,Magandang pangalan.
Dialogue: 0,1:07:26.31,1:07:27.61,Default,,0,0,0,,Salamat sa iyo.
Dialogue: 0,1:07:28.58,1:07:30.75,Default,,0,0,0,,Oo, sinabi ko lang sa iyo ang nakita ko.
Dialogue: 0,1:07:32.98,1:07:34.28,Default,,0,0,0,,Sa susunod na pahina.
Dialogue: 0,1:07:35.42,1:07:36.62,Default,,0,0,0,,Sa araw na iyon, Konsehal Hon...
Dialogue: 0,1:07:38.52,1:07:41.92,Default,,0,0,0,,Nagiging incontinent siya sa tuwing nakikita niya ang mga drawing na ito.
Dialogue: 0,1:07:43.26,1:07:45.26,Default,,0,0,0,,Oo, ang ganda ng mga drawing dito.
Dialogue: 0,1:07:49.53,1:07:50.63,Default,,0,0,0,,My queen.
Dialogue: 0,1:07:52.57,1:07:54.00,Default,,0,0,0,,Nag-iisa ka ba?
Dialogue: 0,1:07:57.77,1:08:00.44,Default,,0,0,0,,Hindi ako nabuhay nang matagal bilang isang karaniwang tao, ngunit pa rin
Dialogue: 0,1:08:01.34,1:08:03.21,Default,,0,0,0,,nakipaglaban sa kalungkutan
Dialogue: 0,1:08:03.21,1:08:05.05,Default,,0,0,0,,at nahirapan akong mag-adapt pagdating ko dito.
Dialogue: 0,1:08:06.92,1:08:09.85,Default,,0,0,0,,Pero kakaiba ka,\Dapat lalo kang malungkot.
Dialogue: 0,1:08:10.49,1:08:11.95,Default,,0,0,0,,Nag-aalala ako.
Dialogue: 0,1:08:12.69,1:08:14.46,Default,,0,0,0,,Wala akong oras para mag-isa.
Dialogue: 0,1:08:14.66,1:08:17.23,Default,,0,0,0,,Mga kahirapan araw-araw at tumatakbo.
Dialogue: 0,1:08:28.17,1:08:31.21,Default,,0,0,0,,May nagsimula pa ngang diksyunaryo para mas maintindihan ako.
Dialogue: 0,1:08:31.81,1:08:33.78,Default,,0,0,0,,Salamat sa kanya, I don't feel lonely at all.
Dialogue: 0,1:08:47.39,1:08:48.72,Default,,0,0,0,,Oras na ba ng ramen?
Dialogue: 0,1:08:52.13,1:08:54.30,Default,,0,0,0,,Sasabihin ko ba o hindi?
Dialogue: 0,1:08:54.66,1:08:55.80,Default,,0,0,0,,Oh Diyos ko!
Dialogue: 0,1:09:00.87,1:09:03.27,Default,,0,0,0,,Hindi ito sinasadya. nasusuka ako.
Dialogue: 0,1:09:06.31,1:09:09.48,Default,,0,0,0,,Tawagan kaagad ang royal physician.
Dialogue: 0,1:09:42.78,1:09:44.18,Default,,0,0,0,,May seryosong bagay?
Dialogue: 0,1:09:47.45,1:09:49.15,Default,,0,0,0,,Buntis ang Reyna.
Dialogue: 0,1:09:52.12,1:09:53.52,Default,,0,0,0,,Ano? Buntis?
Dialogue: 0,1:09:56.36,1:09:57.53,Default,,0,0,0,,Buntis ba ako?
Dialogue: 0,1:10:01.26,1:10:03.77,Default,,0,0,0,,Congratulations, Your Majesty.
Dialogue: 0,1:10:10.21,1:10:11.57,Default,,0,0,0,,Reyna ko, salamat.
Dialogue: 0,1:10:20.48,1:10:23.65,Default,,0,0,0,,-Congratulations, Your Majesty!\N-Congratulations, Your Majesty!
Dialogue: 0,1:10:26.46,1:10:28.56,Default,,0,0,0,,Magiging ama na ako!
Dialogue: 0,1:10:49.48,1:10:50.68,Default,,0,0,0,,I
Dialogue: 0,1:10:52.98,1:10:54.78,Default,,0,0,0,,buntis?
Dialogue: 0,1:10:59.49,1:11:03.76,Default,,0,0,0,,Paano ako naging reyna
Dialogue: 0,1:11:23.55,1:11:25.82,Default,,0,0,0,,Buntis ba ako?
Dialogue: 0,1:11:25.82,1:11:28.95,Default,,0,0,0,,Ang tunay na paaralan para sa mga buntis ay magsisimula ngayon.
Dialogue: 0,1:11:28.95,1:11:31.79,Default,,0,0,0,,Dapat mong tanggihan ang mga hindi pangkaraniwang pagkain.
Dialogue: 0,1:11:31.79,1:11:34.69,Default,,0,0,0,,Ipagpalagay ko na ikinakalat mo ang tsismis gaya ng itinuro ko?
Dialogue: 0,1:11:34.69,1:11:36.29,Default,,0,0,0,,Hindi talaga sila natutulog na magkasama.
Dialogue: 0,1:11:36.29,1:11:38.46,Default,,0,0,0,,Ano ang mali sa pose? Ang awkward.
Dialogue: 0,1:11:38.46,1:11:40.33,Default,,0,0,0,,Hindi ito sapat para sugpuin ang mga tsismis.
Dialogue: 0,1:11:40.33,1:11:41.76,Default,,0,0,0,,Kung sasabihin mo...
Dialogue: 0,1:11:41.83,1:11:44.07,Default,,0,0,0,,Nagiging totoo ang pinaniniwalaan ng lahat.
Dialogue: 0,1:11:44.07,1:11:46.60,Default,,0,0,0,,Dalhin mo muna sa akin ang ulo ng reyna.
Dialogue: 0,1:11:46.60,1:11:47.97,Default,,0,0,0,,Ito ay isang order.
Dialogue: 0,1:11:47.97,1:11:50.24,Default,,0,0,0,,Kung gusto kong mabuhay, lahat ng tao sa paligid ko ay mamamatay.
Dialogue: 0,1:11:50.24,1:11:51.84,Default,,0,0,0,,Kaya tatanggapin ko lahat.
Dialogue: 0,0:14:45.74,0:14:47.74,Default,,0,0,0,,


