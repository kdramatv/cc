Dialog: 0,0:00:58.95,0:01:03.92,ПРЕДСТ,,0,0,0,,ФАНСАБ-ГРУППА АЗАЛИИ ПРЕДСТАВЛЯЕТ
Dialog: 0,0:00:58.00,0:01:04.02,Default,,0,0,0,,{\c&HFFFFFF&\fade(00,0)\p1\a5\bord0\1a&H00&\pos(430,206)\fscx807\fscy277}m 0 0 l 0 0 l 92 0 aku 92 38 aku 0 38
Dialogue: 0,0:00:58.00,0:01:04.02,работали,,0,0,0,,{\pos(801,256)}Над серией работали:\N Лилия, Тирамису, Ананас, Зингер, Бирюлька
Dialogue: 0,0:00:58.00,0:01:04.02,title,,0,0,0,,{\pos(110,602)}Bagaimana jadinya aku
Dialog: 0,0:00:58.00,0:01:04.02,nama,,0,0,0,,{\pos(112,666)}ratu
Dialog: 0,0:01:13.06,2:01:37.06,PRESENT,,0,0,0,,{\fs40\pos(1181,4)}AZALEA
Dialog: 0,0:01:12.86,0:01:15.20,Default,BIR,0,0,0,,Tidak, bukan itu yang saya maksud!
Dialogue: 0,0:01:24.34,0:01:26.68,Default,BIR,0,0,0,,Kita harus mengambil langkah ekstrim.
Dialogue: 0,0:01:38.19,0:01:39.35,Default,BIR,0,0,0,,Dan dia cepat.
Dialog: 0,0:01:40.49,0:01:42.78,Default,BIR,0,0,0,,-Apa ini? \N-Aku harus menanyakan ini padamu.
Dialog: 0,0:01:42.86,0:01:45.76,Default,BIR,0,0,0,,Saat aku sedang minum, kupikir cahaya bulan akan cukup untuk suasana hatiku,
Dialogue: 0,0:01:45.76,0:01:47.16,Default,BIR,0,0,0,,jadi aku tiup lilinnya.
Dialogue: 0,0:01:49.33,0:01:53.30,Default,BIR,0,0,0,,Aku ingin meregangkan tenggorokanku sebelum aku benar-benar mulai minum.
Dialog: 0,0:01:53.50,0:01:55.77,Default,BIR,0,0,0,,Anda dapat menganggap ini sebagai pemanasan.
Dialogue: 0,0:01:57.51,0:01:58.66,Default,BIR,0,0,0,,Jadi, apa?
Dialog: 0,0:02:00.14,0:02:01.88,Default,BIR,0,0,0,,Apa yang kamu lakukan? Brengsek.
Dialogue: 0,0:02:02.04,0:02:04.74,Default,BIR,0,0,0,,Tidakkah kalian ingin saling menghangatkan tenggorokan?
Dialogue: 0,0:02:05.18,0:02:07.87,Default,BIR,0,0,0,,Dasar brengsek yang licik. Apakah dia melakukannya dengan sengaja?
Dialog: 0,0:02:09.89,0:02:11.38,Default,BIR,0,0,0,,Tidak, tidak mungkin.
Dialogue: 0,0:02:13.36,0:02:14.76,Default,BIR,0,0,0,,Karena kita sudah menghangatkan tenggorokan,
Dialog: 0,0:02:14.76,0:02:16.59,Default,BIR,0,0,0,,mulai minum sepenuh hati, ratuku.
Dialog: 0,0:02:18.59,0:02:19.73,Default,BIR,0,0,0,,Di mana?
Dialog: 0,0:02:20.23,0:02:22.02,Default,BIR,0,0,0,,Satu orang tidak menarik.
Dialog: 0,0:02:23.67,0:02:25.74,Default,BIR,0,0,0,,Entah kenapa aku tidak memikirkan hal itu.
Dialog: 0,0:02:27.04,0:02:28.16,Default,BIR,0,0,0,,Tuang.
Dialog: 0,0:02:35.95,0:02:37.55,Default,BIR,0,0,0,,Terima kasih atas sambutan hangatnya,
Dialog: 0,0:02:37.55,0:02:39.57,Default,BIR,0,0,0,,sekarang anggur telah mengalir dengan lembut.
Dialog: 0,0:02:39.98,0:02:42.65,Default,BIR,0,0,0,,Apa? Apa yang saya lakukan?
Dialog: 0,0:02:44.72,0:02:47.38,Default,BIR,0,0,0,,Ini, minum.
Dialogue: 0,0:02:49.33,0:02:52.15,Default,BIR,0,0,0,,Kamu juga harus minum, ratuku.
Dialog: 0,0:02:52.33,0:02:54.20,Default,BIR,0,0,0,,Raja minum dulu.
Dialog: 0,0:02:54.36,0:02:56.40,Default,BIR,0,0,0,,Tidak, ratu minum dulu.
Dialog: 0,0:02:56.93,0:02:58.90,Default,BIR,0,0,0,,Strategi diubah.
Dialog: 0,0:02:59.27,0:03:02.13,Default,BIR,0,0,0,,Aku tahu pikiran gelapmu.
Dialog: 0,0:03:04.14,0:03:06.81,Default,BIR,0,0,0,,Kalau begitu mari kita minum
Dialog: 0,0:03:06.81,0:03:09.27,Default,BIR,0,0,0,,dan tidur, untunglah hari yang panjang.
Dialog: 0,0:03:09.75,0:03:11.77,Default,BIR,0,0,0,,Apa yang kamu katakan? Ya, kami baru saja mulai.
Dialog: 0,0:03:12.82,0:03:13.92,Default,BIR,0,0,0,,Jangan seperti itu.
Dialog: 0,0:03:13.92,0:03:17.59,Default,BIR,0,0,0,,Ayo. Satu salvo untuk kesehatan saya.
Dialog: 0,0:03:17.99,0:03:19.12,Default,BIR,0,0,0,,Gulp.
Dialog: 0,0:03:21.76,0:03:23.56,Default,BIR,0,0,0,,Saya tidur nyenyak,
Dialog: 0,0:03:23.56,0:03:25.12,Default,BIR,0,0,0,,jadi menjauhlah saat kita tidur.
Dialog: 0,0:03:25.49,0:03:27.90,Default,BIR,0,0,0,,Permainan macam apa yang dia mainkan dengan omong kosong ini dan itu?
Dialogue: 0,0:03:39.54,0:03:43.08,Default,BIR,0,0,0,,Mekar di siang hari, layu di malam hari.
Dialog: 0,0:03:48.28,0:03:50.78,Default,BIR,0,0,0,,Kisah-kisah ini tentang kecintaan raja pada alkohol dan wanita...
Dialogue: 0,0:03:53.62,0:03:55.96,Default,BIR,0,0,0,,Kronik tentang Joseon berbohong seperti pers kuning.
Dialog: 0,0:03:56.43,0:03:57.68,Default,BIR,0,0,0,,Aku takut sia-sia.
Dialogue: 0,0:03:58.19,0:04:00.72,Default,BIR,0,0,0,,Tapi kita tidak boleh lengah.
Dialog: 0,0:04:05.07,0:04:06.74,Default,BIR,0,0,0,,Akhirnya menggunakannya
Dialog: 0,0:04:06.74,0:04:08.67,Default,BIR,0,0,0,,simpul wanita, yang saya pelajari di tentara.
Dialog: 0,0:04:09.51,0:04:12.40,Default,BIR,0,0,0,,Jika kamu ingin melepaskannya, kamu harus memotongnya.
Dialog: 0,0:04:12.54,0:04:13.64,Default,BIR,0,0,0,,Frets.
Dialogue: 0,0:04:18.41,0:04:20.68,Default,BIR,0,0,0,,Sangat egois.
Dialog: 0,0:04:20.68,0:04:22.65,Default,BIR,0,0,0,,Menempati seluruh tempat tidur.
Dialog: 0,0:04:33.50,0:04:35.22,Default,BIR,0,0,0,,Maafkan aku, ratuku.
Dialogue: 0,0:04:35.67,0:04:37.99,Default,BIR,0,0,0,,Aku memahami perasaanmu,
Dialog: 0,0:04:38.10,0:04:40.43,Default,BIR,0,0,0,,tapi hari ini aku hanya ingin tidur.
Dialog: 0,0:04:40.50,0:04:42.94,Default,BIR,0,0,0,,Semuanya salah. Saya dibesarkan dalam kenyamanan
Dialog: 0,0:04:42.94,0:04:44.87,Default,BIR,0,0,0,,Saya tidak bisa tidur di lantai kosong.
Dialog: 0,0:04:45.17,0:04:46.58,Default,BIR,0,0,0,,Beri aku satu.
Dialog: 0,0:04:47.34,0:04:48.78,Default,BIR,0,0,0,,Saya tidak bisa tidur
Dialogue: 0,0:04:48.78,0:04:51.08,Default,BIR,0,0,0,,kurang dari tiga tempat tidur bulu.
Dialogue: 0,0:04:53.25,0:04:55.47,Default,BIR,0,0,0,,Aku yakin kenyamananmu tidak bisa dibandingkan dengan kenyamanan seorang raja.
Dialogue: 0,0:05:00.22,0:05:01.52,Default,BIR,0,0,0,,Pangeran penebang pohon dari Ganghwa
Dialog: 0,0:05:01.52,0:05:02.86,Default,BIR,0,0,0,,tentu saja saya tidak belajar sejarah.
Dialog: 0,0:05:21.54,0:05:22.64,Default,BIR,0,0,0,,Yolki.
Dialog: 0,0:05:25.72,0:05:27.35,Default,BIR,0,0,0,,Untuk menghentikan kelumpuhan tidurnya.
Dialog: 0,0:05:32.09,0:05:35.25,Default,BIR,0,0,0,,Karena semuanya menjadi seperti ini,\NI akan berjaga sepanjang malam.
Dialog: 0,0:05:37.06,0:05:39.95,Default,BIR,0,0,0,,Entah kenapa hari ini saya masih ingat tentara.
Dialog: 0,0:05:53.91,0:05:57.31,Default,BIR,0,0,0,,2 episode: Tidak ada yang tahu
Dialog: 0,0:06:55.34,0:06:57.47,Default,BIR,0,0,0,,Apakah Anda sudah bangun, Yang Mulia?
Dialogue: 0,0:06:57.47,0:06:59.11,Default,BIR,0,0,0,,Ini ada penyergapan.
Dialog: 0,0:06:59.88,0:07:02.18,Default,BIR,0,0,0,,Semoga tidak, tapi aku masih di sini.
Dialog: 0,0:07:04.58,0:07:07.98,Default,BIR,0,0,0,,Bagaimana rasanya menyambut hari baru sebagai ratu?
Dialog: 0,0:07:08.78,0:07:10.01,Default,BIR,0,0,0,,Sial.
Dialog: 0,0:07:11.99,0:07:13.12,Default,BIR,0,0,0,,Itu saja.
Dialogue: 0,0:07:15.93,0:07:17.18,Default,BIR,0,0,0,,Simpul wanitaku.
Dialog: 0,0:07:21.86,0:07:24.03,Default,BIR,0,0,0,,Kehilangan sesuatu lagi?
Dialog: 0,0:07:24.20,0:07:26.54,Default,BIR,0,0,0,,-Saya akan mencari semuanya... \T-Tidak!
Dialog: 0,0:07:27.94,0:07:31.74,Default,BIR,0,0,0,,Saya yakin saya melepaskan ikatannya di malam hari, mengganggu, saya kira. Jadi?
Dialog: 0,0:08:13.02,0:08:14.12,Default,BIR,0,0,0,,Yang Mulia.
Dialogue: 0,0:08:19.29,0:08:21.72,Default,BIR,0,0,0,,Kapan kamu tiba di Hijeongjon?
Dialog: 0,0:08:21.99,0:08:24.56,Default,BIR,0,0,0,,Maaf tidak menemanimu.
Dialog: 0,0:08:25.26,0:08:28.82,Default,BIR,0,0,0,,Aku tidak ingin membangunkan ratu dan pergi diam-diam.
Dialog: 0,0:08:29.70,0:08:32.26,Default,BIR,0,0,0,,Apakah kamu mengalami mimpi buruk lagi?
Dialogue: 0,0:08:34.47,0:08:37.13,Default,BIR,0,0,0,,Dia seharusnya tidak bisa tidur karena aku.
Dialog: 0,0:08:37.44,0:08:39.31,Default,BIR,0,0,0,,Ini hari pertamanya sebagai ratu.
Dialog: 0,0:08:39.68,0:08:44.00,Default,BIR,0,0,0,,Aku akan membawakanmu teh melati Arab dan kamu akan tidur nyenyak malam ini.
Dialog: 0,0:08:46.92,0:08:51.58,Default,BIR,0,0,0,,Ratu sekarang harus menyapa para dayang istana.
Dialog: 0,0:08:51.69,0:08:54.36,Default,BIR,0,0,0,,Kudengar mereka sudah pergi.
Dialog: 0,0:08:54.82,0:08:58.23,Default,BIR,0,0,0,,Penasaran seperti apa rupa ratu sekarang.
Dialog: 0,0:09:03.93,0:09:06.17,Default,BIR,0,0,0,,Pernikahannya kemarin,
Dialogue: 0,0:09:06.34,0:09:08.94,Default,BIR,0,0,0,,kenapa aku tak bangun, bagaimana kabarnya lagi?
Dialog: 0,0:09:08.94,0:09:11.01,Default,BIR,0,0,0,,Kamu harus pergi dan menyapa
Dialog: 0,0:09:11.01,0:09:13.18,Default,BIR,0,0,0,,Janda Ratu dan Ibu Suri
Dialog: 0,0:09:13.38,0:09:16.50,Default,BIR,0,0,0,,dan mengadakan upacara meriah untuk para pejabat pengadilan.
Dialog: 0,0:09:16.65,0:09:18.81,Default,BIR,0,0,0,,Setelah bagian resmi upacara pernikahan...
Dialog: 0,0:09:18.81,0:09:20.68,Default,BIR,0,0,0,,Kapan pernikahannya akan berakhir?
Dialog: 0,0:09:20.72,0:09:23.99,Default,BIR,0,0,0,,Tidak, maka Yang Mulia harus membaca pesannya
Dialog: 0,0:09:23.99,0:09:25.29,Default,BIR,0,0,0,,tentang proklamasimu sebagai ratu.
Dialog: 0,0:09:27.42,0:09:30.03,Default,BIR,0,0,0,,Semacam pernikahan tanpa akhir.
Dialog: 0,0:09:30.96,0:09:34.16,Default,BIR,0,0,0,,Tunggu sebentar. Jadi Janda Ratu adalah...
Dialog: 0,0:09:34.16,0:09:37.33,Default,BIR,0,0,0,,Ini adalah perintah dari Janda Ratu.
Dialog: 0,0:09:37.33,0:09:40.83,Default,BIR,0,0,0,,Saya akan mengisi danau dengan air -\NI akan melanggar perintahnya.
Dialogue: 0,0:09:45.21,0:09:47.33,Default,BIR,0,0,0,,Orang seperti apa Janda Ratu itu?
Dialogue: 0,0:09:47.71,0:09:49.14,Default,BIR,0,0,0,,Janda Ratu
Dialog: 0,0:09:49.21,0:09:52.05,Default,BIR,0,0,0,,seperti Anda, dari klan Andon Kim, dia adalah seorang tetua,
Dialog: 0,0:09:52.28,0:09:55.52,Default,BIR,0,0,0,,dan ibu suri berasal dari keluarga Pungyang Cho.
Dialogue: 0,0:09:57.25,0:10:00.06,Default,BIR,0,0,0,,Jadi nenek dan mamaku sedang bermusuhan.
Dialog: 0,0:10:00.06,0:10:02.82,Default,BIR,0,0,0,,Dan aku, sang ratu, berjenis sama dengan nenek.
Dialogue: 0,0:10:03.09,0:10:05.03,Default,BIR,0,0,0,,Bolehkah aku bertanya kapan aku bertemu dengannya?
Dialog: 0,0:10:05.03,0:10:07.35,Default,BIR,0,0,0,,Yang tertua adalah ratu janda.
Dialog: 0,0:10:08.23,0:10:09.46,Default,BIR,0,0,0,,Apa lagi?
Dialog: 0,0:10:11.07,0:10:14.80,Default,BIR,0,0,0,,Saya sangat peduli, maukah Anda menceritakan semua yang Anda ketahui?
Dialog: 0,0:10:15.54,0:10:17.91,Default,BIR,0,0,0,,Dia adalah saudara perempuan Tuan Kim Jwageun
Dialog: 0,0:10:17.91,0:10:21.73,Default,BIR,0,0,0,,dan belum meninggalkan istana sejak dia tiba.
Dialog: 0,0:10:21.74,0:10:23.10,Default,BIR,0,0,0,,-Juga... \N-Berhenti.
Dialogue: 0,0:10:26.25,0:10:28.92,Default,BIR,0,0,0,,Aku sedang membicarakan tandu. Berhenti!
Dialog: 0,0:10:29.39,0:10:32.21,Default,BIR,0,0,0,,-Berhenti! \N-Berhenti.
Dialog: 0,0:10:36.66,0:10:37.93,Default,BIR,0,0,0,,Kembali.
Dialog: 0,0:10:38.46,0:10:40.93,Default,BIR,0,0,0,,Putar kembali.
Dialog: 0,0:10:41.30,0:10:43.06,Default,BIR,0,0,0,,Putar kembali.
Dialog: 0,0:10:48.54,0:10:49.67,Default,BIR,0,0,0,,Itu saja.
Dialog: 0,0:10:56.98,0:10:59.44,Default,BIR,0,0,0,,Sesuatu yang lebih penting telah muncul di sini.
Dialog: 0,0:11:32.35,0:11:36.52,Default,BIR,0,0,0,,Hilang karena istananya terlalu besar?
Dialogue: 0,0:11:40.86,0:11:43.89,Default,BIR,0,0,0,,Senang bertemu anda. Siapa namamu?
Dialog: 0,0:11:48.60,0:11:49.69,Default,BIR,0,0,0,,Wow.
Dialogue: 0,0:11:50.83,0:11:53.06,Default,BIR,0,0,0,,Aku tidak akan pernah terbiasa dengan tubuh ini.
Dialogue: 0,0:11:56.41,0:11:59.04,Default,BIR,0,0,0,,Kamu mempunyai aura yang menarik.
Dialog: 0,0:12:00.38,0:12:01.91,Default,BIR,0,0,0,,Apakah kamu dari keluarga kerajaan juga?
Dialog: 0,0:12:01.91,0:12:05.15,Default,BIR,0,0,0,,Apakah ada semacam putri di sana?
Dialogue: 0,0:12:06.52,0:12:07.75,Default,BIR,0,0,0,,Maafkan saya.
Dialog: 0,0:12:08.05,0:12:11.08,Default,BIR,0,0,0,,Jika aku sombong dan membuatmu kesal,
Dialog: 0,0:12:11.15,0:12:12.58,Default,BIR,0,0,0,,maafkan saya.
Dialog: 0,0:12:13.06,0:12:15.79,Default,BIR,0,0,0,,Tidak. Apa yang ingin saya katakan...
Dialog: 0,0:12:15.79,0:12:16.89,Default,BIR,0,0,0,,Yang Mulia.
Dialog: 0,0:12:17.39,0:12:19.85,Default,BIR,0,0,0,,Kamu berjalan begitu cepat. Bagaimana kamu sampai di sini?
Dialog: 0,0:12:20.90,0:12:22.16,Default,BIR,0,0,0,,Halo.
Dialog: 0,0:12:24.33,0:12:25.80,Default,BIR,0,0,0,,Apakah kamu kenal dia?
Dialogue: 0,0:12:27.10,0:12:29.54,Default,BIR,0,0,0,,Ini Ny. Hwajin dari keluarga Cho,
Dialog: 0,0:12:29.54,0:12:31.54,Default,BIR,0,0,0,,selir kerajaan masa depan.
Dialog: 0,0:12:32.98,0:12:34.58,Default,BIR,0,0,0,,Saya mengerti bahwa ratu aktif,
Dialog: 0,0:12:34.58,0:12:36.21,Default,BIR,0,0,0,,tapi bukankah dia terlalu menghinamu?
Dialog: 0,0:12:36.21,0:12:37.75,Default,BIR,0,0,0,,Terus bermain dengan kata-kata.
Dialog: 0,0:12:37.75,0:12:39.95,Default,BIR,0,0,0,,Ada rumor kalau itu dia
Dialog: 0,0:12:39.95,0:12:41.55,Default,BIR,0,0,0,,mendorongmu ke dalam danau.
Dialog: 0,0:12:41.55,0:12:44.79,Default,BIR,0,0,0,,Saya yakin rumor tentang ratu yang kehilangan ingatannya adalah bohong.
Dialog: 0,0:12:45.29,0:12:46.85,Default,BIR,0,0,0,,-Hati-hati. \N-Hati-hati.
Dialog: 0,0:12:55.50,0:12:59.40,Default,BIR,0,0,0,,Saya kenal banyak wanita,
Dialog: 0,0:12:59.40,0:13:01.30,Default,BIR,0,0,0,,bahwa saya dapat dengan mudah membaca wajah mereka.
Dialog: 0,0:13:02.17,0:13:03.83,Default,BIR,0,0,0,,Kamu... Bagaimana aku bisa mengatakan ini?
Dialog: 0,0:13:06.24,0:13:07.47,Default,BIR,0,0,0,,Orang baik.
Dialogue: 0,0:13:11.05,0:13:13.92,Default,BIR,0,0,0,,Saya pikir hal-hal tidak berjalan baik bagi kita di masa lalu,
Dialog: 0,0:13:14.08,0:13:15.71,Default,BIR,0,0,0,,jadi mungkin kita bisa mulai lagi?
Dialog: 0,0:13:15.95,0:13:17.65,Default,BIR,0,0,0,,Aku menyukaimu.
Dialogue: 0,0:13:19.66,0:13:20.81,Default,BIR,0,0,0,,Ayo berteman.
Dialog: 0,0:13:25.49,0:13:27.59,Default,PINEAPPLE,0,0,0,,Sudahkah Anda memutuskan untuk mengubah taktik?
Dialogue: 0,0:13:28.73,0:13:29.90,Default,PINEAPPLE,0,0,0,,Taktik?
Dialogue: 0,0:13:30.77,0:13:33.77,Default,PINEAPPLE,0,0,0,,Berkat kamu, aku belajar\Nseperti apa istana itu,
Dialog: 0,0:13:34.30,0:13:36.71,Default,PINEAPPLE,0,0,0,,akhirnya dapat memahami bahwa saya sekarang juga bagian darinya.
Dialog: 0,0:13:36.71,0:13:40.84,Default,PINEAPPLE,0,0,0,,Tidak, sepertinya Anda salah paham.
Dialogue: 0,0:13:40.84,0:13:42.94,Default,PINEAPPLE,0,0,0,,-Semuanya salah.\N-Maaf, saya harus pergi.
Dialog: 0,0:13:46.15,0:13:47.31,Default,NANAS,0,0,0,,Yang Mulia!
Dialog: 0,0:13:48.45,0:13:49.84,Default,NANAS,0,0,0,,-Yang Mulia.\N-Yang Mulia.
Dialogue: 0,0:13:50.25,0:13:53.36,Default,PINEAPPLE,0,0,0,,Saya datang ke kamarmu,\Ntapi kamu tidak ada di sana.
Dialogue: 0,0:13:53.36,0:13:56.26,Default,PINEAPPLE,0,0,0,,Aku juga ingin menyapamu, tapi aku tidak bisa menemukannya.
Dialogue: 0,0:13:56.26,0:13:58.82,Default,PINEAPPLE,0,0,0,,Begitulah kita pasti saling rindu,
Dialogue: 0,0:13:59.66,0:14:01.19,Default,PINEAPPLE,0,0,0,,karena pikiran kita menyatu.
Dialogue: 0,0:14:03.90,0:14:06.90,Default,PINEAPPLE,0,0,0,,Kalau dia selir,\Ni ternyata dia dianggap istri kedua?
Dialogue: 0,0:14:07.74,0:14:09.04,Default,PINEAPPLE,0,0,0,,Mengapa badan ini?
Dialogue: 0,0:14:09.04,0:14:10.81,Default,PINEAPPLE,0,0,0,,Mengapa ini?
Dialog: 0,0:14:12.67,0:14:16.20,Default,NANAS,0,0,0,,Api di mata ratu dapat membakar ladang.
Dialogue: 0,0:14:21.85,0:14:23.84,Default,PINEAPPLE,0,0,0,,Sewa kamar untuk dirimu sendiri!
Dialog: 0,0:14:24.72,0:14:25.84,Default,NANAS,0,0,0,,Ratuku,
Dialog: 0,0:14:26.32,0:14:29.68,Default,PINEAPPLE,0,0,0,,Saya meminta Anda untuk segera memberi tahu selir kerajaan apa dan bagaimana.
Dialogue: 0,0:14:33.13,0:14:34.66,Default,PINEAPPLE,0,0,0,,Sayang sekali!
Dialog: 0,0:14:34.66,0:14:37.60,Default,PINEAPPLE,0,0,0,,Saya tidak punya waktu untuk menjelaskan semuanya padanya di sini.
Dialogue: 0,0:14:37.60,0:14:38.96,Default,PINEAPPLE,0,0,0,,Ini perintah raja.
Dialogue: 0,0:14:40.97,0:14:43.06,Default,NANAS,0,0,0,,Persetan dengan poligami.
Dialog: 0,0:14:45.44,0:14:46.68,Default,NANAS,0,0,0,,Yang Mulia!
Dialogue: 0,0:14:46.84,0:14:50.01,Default,PINEAPPLE,0,0,0,,Para ratu telah menunggumu begitu lama!
Dialog: 0,0:14:50.71,0:14:52.01,Default,NANAS,0,0,0,,Yang Mulia!
Dialogue: 0,0:14:54.52,0:14:56.61,Default,PINEAPPLE,0,0,0,,Aku ada rapat yang sangat penting, aku akan pergi.
Dialogue: 0,0:15:04.09,0:15:05.22,Default,PINEAPPLE,0,0,0,,Apa-apaan ini?
Dialog: 0,0:15:06.83,0:15:07.95,Default,NANAS,0,0,0,,Yang Mulia!
Dialog: 0,0:15:12.27,0:15:14.00,Default,NANAS,0,0,0,,Sangat takut,
Dialog: 0,0:15:16.44,0:15:17.54,Default,NANAS,0,0,0,,Hwajin?
Dialogue: 0,0:15:18.51,0:15:20.93,Default,PINEAPPLE,0,0,0,,Akhirnya, aku bisa memanggilmu istriku.
Dialogue: 0,0:15:22.31,0:15:25.41,Default,PINEAPPLE,0,0,0,,Sekarang kita akan tinggal bersama di istana.
Dialogue: 0,0:15:26.11,0:15:28.15,Default,PINEAPPLE,0,0,0,,Kamu berhak mendapatkan upacara pernikahan sungguhan,
Dialogue: 0,0:15:28.25,0:15:31.84,Default,PINEAPPLE,0,0,0,,tapi si kasim melihatmu tidak jauh dari danau.
Dialogue: 0,0:15:33.22,0:15:35.66,Default,PINEAPPLE,0,0,0,,Pejabat mencoba\Nmenyalahkan Anda atas apa yang terjadi.
Dialogue: 0,0:15:36.12,0:15:37.93,Default,PINEAPPLE,0,0,0,,Jadi saya harus mempercepat pemilihannya.
Dialogue: 0,0:15:38.96,0:15:41.23,Default,PINEAPPLE,0,0,0,,Aku berada di danau karena aku takut,
Dialogue: 0,0:15:41.23,0:15:42.69,Default,PINEAPPLE,0,0,0,,mendengar suara keras.
Dialog: 0,0:15:43.13,0:15:44.59,Default,NANAS,0,0,0,,Jangan khawatir.
Dialog: 0,0:15:44.93,0:15:46.57,Default,NANAS,0,0,0,,Dia tidak bisa menyakitimu,
Dialogue: 0,0:15:46.57,0:15:48.36,Default,PINEAPPLE,0,0,0,,terlepas dari keluarga mana dia berasal.
Dialog: 0,0:15:55.78,0:15:58.65,Default,PINEAPPLE,0,0,0,,Tidak, bukan seperti itu.\NI akan melakukan segalanya untuk membuat Anda tetap aman.
Dialogue: 0,0:15:59.28,0:16:01.71,Default,PINEAPPLE,0,0,0,,Aku akan melakukan yang terbaik untuk melindungimu.
Dialog: 0,0:16:03.72,0:16:04.81,Default,NANAS,0,0,0,,Yang Mulia.
Dialogue: 0,0:16:05.85,0:16:08.42,Default,PINEAPPLE,0,0,0,,Sayangnya, saya\Ntidak punya banyak cara untuk melakukan ini.
Dialogue: 0,0:16:09.32,0:16:11.09,Default,PINEAPPLE,0,0,0,,Aku hanya boneka di singgasana.
Dialogue: 0,0:16:11.09,0:16:13.09,Default,PINEAPPLE,0,0,0,,Tapi aku punya saudara laki-laki yang mengkhawatirkanku,
Dialogue: 0,0:16:13.30,0:16:15.22,Default,PINEAPPLE,0,0,0,,dan seorang teman yang rela melakukan apa saja demi bersenang-senang.
Dialog: 0,0:16:15.46,0:16:16.59,Default,NANAS,0,0,0,,Dan
Dialog: 0,0:16:18.20,0:16:19.77,Default,NANAS,0,0,0,,wanita cantik.
Dialogue: 0,0:16:26.11,0:16:27.33,Default,PINEAPPLE,0,0,0,,Kamu kaya.
Dialog: 0,0:16:29.64,0:16:33.22,Default,PINEAPPLE,0,0,0,,Saya jelaskan kepada petugas di mana Anda berada.
Dialog: 0,0:16:33.22,0:16:34.55,Default,NANAS,0,0,0,,Jangan khawatir.
Dialog: 0,0:16:48.76,0:16:51.03,Default,NANAS,0,0,0,,Apa? Nah, nenek janda yang mana?
Dialogue: 0,0:16:51.03,0:16:53.14,Default,PINEAPPLE,0,0,0,,Tunduk pada Ibu Suri, Yang Mulia.
Dialogue: 0,0:16:53.97,0:16:55.43,Default,PINEAPPLE,0,0,0,,Sudahlah, tinggalkan kekurangannya.
Dialogue: 0,0:16:56.24,0:17:00.93,Default,PINEAPPLE,0,0,0,,Kuharap tidurmu nyenyak, Janda Ratu.
Dialogue: 0,0:17:08.75,0:17:11.99,Default,PINEAPPLE,0,0,0,,Kamu menjadi lebih muda malam ini!
Dialogue: 0,0:17:11.99,0:17:13.56,Default,PINEAPPLE,0,0,0,,Kamu tidak bisa mengetahui berapa umurmu.
Dialogue: 0,0:17:13.56,0:17:16.39,Default,PINEAPPLE,0,0,0,,Anda hampir menipu saya, Yang Mulia.
Dialog: 0,0:17:16.99,0:17:18.26,Default,NANAS,0,0,0,,Bajingan.
Dialog: 0,0:17:19.16,0:17:20.63,Default,NANAS,0,0,0,,Benarkah?
Dialogue: 0,0:17:21.33,0:17:23.59,Default,PINEAPPLE,0,0,0,,Jadi tidak sia-sia aku berusaha sekuat tenaga.
Dialogue: 0,0:17:24.43,0:17:26.67,Default,PINEAPPLE,0,0,0,,Gadis baik, Chan Bong-hwan, lanjutkan.
Dialogue: 0,0:17:26.90,0:17:29.80,Default,PINEAPPLE,0,0,0,,Kemalangan besar menimpamu.
Dialogue: 0,0:17:30.07,0:17:33.93,Default,PINEAPPLE,0,0,0,,Mengerikan sekali, sepertinya\Nkamu belum pulih sepenuhnya.
Dialogue: 0,0:17:34.51,0:17:36.20,Default,PINEAPPLE,0,0,0,,Omong kosong apa yang kamu bicarakan?
Dialogue: 0,0:17:36.51,0:17:39.15,Default,PINEAPPLE,0,0,0,,Kami tidak bisa menemukan ratu yang lebih baik!
Dialogue: 0,0:17:39.15,0:17:40.92,Default,PINEAPPLE,0,0,0,,Lidahnya tajam seperti biasa.
Dialog: 0,0:17:42.15,0:17:43.31,Default,NANAS,0,0,0,,Benar.
Dialogue: 0,0:17:43.75,0:17:46.11,Default,PINEAPPLE,0,0,0,,Aku melihat lebih dekat dan aku melihat.
Dialogue: 0,0:17:47.76,0:17:50.98,Default,PINEAPPLE,0,0,0,,Mereka tersenyum manis sekali, tapi kenyataannya\Nmereka akan saling mencakar leher satu sama lain.
Dialog: 0,0:17:51.36,0:17:52.89,Default,NANAS,0,0,0,,Kesiapan tempur penuh.
Dialogue: 0,0:17:53.40,0:17:56.67,Default,PINEAPPLE,0,0,0,,Sekarang kamu harus berusaha semaksimal mungkin untuk menghasilkan ahli waris.
Dialogue: 0,0:17:57.83,0:18:01.34,Default,PINEAPPLE,0,0,0,,Pada suatu waktu saya belajar\Nan cara efektif untuk melakukan ini,
Dialogue: 0,0:18:01.34,0:18:03.77,Default,PINEAPPLE,0,0,0,,sehingga seorang pangeran kecil pasti akan lahir.
Dialogue: 0,0:18:06.07,0:18:07.21,Default,PINEAPPLE,0,0,0,,Jangan siksa kami.
Dialogue: 0,0:18:08.24,0:18:11.38,Default,PINEAPPLE,0,0,0,,Bayangkan, kamu bermalam bersama pasanganmu.
Dialog: 0,0:18:11.38,0:18:13.68,Default,NANAS,0,0,0,,Dia berbaring telentang,
Dialogue: 0,0:18:13.68,0:18:14.81,Default,PINEAPPLE,0,0,0,,dan kamu berada di atas...
Dialogue: 0,0:18:31.73,0:18:34.36,Default,PINEAPPLE,0,0,0,,Beri dia penghargaan “Ibu Mertua Terbaik”.
Dialogue: 0,0:18:36.20,0:18:39.77,Default,PINEAPPLE,0,0,0,,Ini poin yang sangat penting,\Nnaik ke atas dan...
Dialogue: 0,0:18:39.77,0:18:42.33,Default,PINEAPPLE,0,0,0,,Ibu, aku sendiri bisa memikirkannya dengan baik!
Dialogue: 0,0:18:49.55,0:18:51.08,Default,PINEAPPLE,0,0,0,,Diam saja, aku mohon.
Dialogue: 0,0:18:51.52,0:18:55.49,Default,PINEAPPLE,0,0,0,,Baiklah, anggap saja saya mempelajari literatur dengan cermat.
Dialog: 0,0:19:05.30,0:19:06.47,Default,NANAS,0,0,0,,Gadis baik!
Dialogue: 0,0:19:06.67,0:19:10.51,Default,PINEAPPLE,0,0,0,,Berapa banyak hal yang telah kamu pelajari untuk menjadi istri yang luar biasa.
Dialog: 0,0:19:10.91,0:19:13.31,Default,PINEAPPLE,0,0,0,,Saya yakin Anda sangat menyadarinya.
Dialog: 0,0:19:14.34,0:19:15.63,Default,NANAS,0,0,0,,Saya setuju,
Dialogue: 0,0:19:16.01,0:19:19.81,Default,PINEAPPLE,0,0,0,,maaf sudah melewati batas.
Dialogue: 0,0:19:22.45,0:19:25.11,Default,PINEAPPLE,0,0,0,,Jadi, menantunya harus lebih rendah hati,
Dialogue: 0,0:19:26.32,0:19:29.52,Default,PINEAPPLE,0,0,0,,dan istri cucu harus memikirkan sesuatu.
Dialogue: 0,0:19:45.94,0:19:47.01,Default,PINEAPPLE,0,0,0,,Sungguh mimpi buruk!
Dialog: 0,0:19:47.01,0:19:49.57,Default,NANAS,0,0,0,,Bukan lengan baju, tapi senjata pembunuh!
Dialogue: 0,0:19:50.05,0:19:51.34,Default,PINEAPPLE,0,0,0,,Leher retak.
Dialogue: 0,0:19:52.28,0:19:53.95,Default,PINEAPPLE,0,0,0,,Kamu pasti sangat lelah.
Dialog: 0,0:19:54.48,0:19:55.52,Default,NANAS,0,0,0,,Pantas saja,
Dialogue: 0,0:19:55.52,0:19:57.81,Default,PINEAPPLE,0,0,0,,kita terlalu banyak minum tadi malam.
Dialogue: 0,0:19:58.69,0:20:00.58,Default,PINEAPPLE,0,0,0,,Apa yang kita minum disana?
Dialogue: 0,0:20:01.09,0:20:02.92,Default,PINEAPPLE,0,0,0,,Para abdi dalem sudah menunggu kita.
Dialog: 0,0:20:02.92,0:20:04.42,Default,PINEAPPLE,0,0,0,,Saya sarankan Anda bergegas.
Dialogue: 0,0:20:14.90,0:20:17.24,Default,NANAS,0,0,0,,Injeongjeong Hall
Dialog: 0,0:20:48.94,0:20:52.01,Default,NANAS,0,0,0,,Penasihat Negara Kim Byung-hak.
Dialog: 0,0:20:55.51,0:20:57.51,Default,NANAS,0,0,0,,Selamat.
Dialog: 0,0:21:03.22,0:21:05.99,Default,PINEAPPLE,0,0,0,,Penasihat Kiri Kim Seok-keun.
Dialog: 0,0:21:05.99,0:21:07.56,Default,NANAS,0,0,0,,Selamat.
Dialog: 0,0:21:08.92,0:21:12.03,Default,PINEAPPLE,0,0,0,,Menteri Perang Kim Chang-hyuk.
Dialog: 0,0:21:12.33,0:21:13.80,Default,NANAS,0,0,0,,Selamat.
Dialogue: 0,0:21:13.80,0:21:15.53,Default,PINEAPPLE,0,0,0,,Dan semua Kim.
Dialogue: 0,0:21:16.40,0:21:19.30,Default,PINEAPPLE,0,0,0,,Jadi itulah dirimu,\Ntrinitas Kim yang terkenal dari Andong.
Dialogue: 0,0:21:21.60,0:21:23.77,Default,PINEAPPLE,0,0,0,,Dengan bantuan Ibu Suri dan istri Raja
Dialogue: 0,0:21:23.77,0:21:26.94,Default,PINEAPPLE,0,0,0,,mereka datang dengan\Nberbagai alasan untuk memungut pajak.
Dialogue: 0,0:21:26.94,0:21:28.54,Default,NANAS,0,0,0,,Karena mereka, rakyat sangat menderita.
Dialogue: 0,0:21:28.78,0:21:30.85,Default,PINEAPPLE,0,0,0,,Dulu saya\Nmereka dituduh korupsi di sektor pertahanan
Dialogue: 0,0:21:30.85,0:21:32.75,Default,PINEAPPLE,0,0,0,,dan real estate,\Nas serta penghindaran pajak.
Dialog: 0,0:21:32.75,0:21:34.58,Default,NANAS,0,0,0,,Panah kita sudah matang dimana-mana.
Dialog: 0,0:21:34.58,0:21:36.22,Default,NANAS,0,0,0,,Dengan kata lain, ini dia, trio reptil,
Dialogue: 0,0:21:36.22,0:21:38.75,Default,PINEAPPLE,0,0,0,,simbol korupsi yang menghancurkan negara.
Dialogue: 0,0:21:38.75,0:21:40.26,Default,PINEAPPLE,0,0,0,,Andon klan Kim.
Dialogue: 0,0:21:42.52,0:21:45.69,Default,PINEAPPLE,0,0,0,,Penasihat Kanan Cho Man-heon.
Dialog: 0,0:21:49.76,0:21:51.73,Default,NANAS,0,0,0,,Selamat.
Dialogue: 0,0:21:52.87,0:21:56.13,Default,PINEAPPLE,0,0,0,,Menteri Pejabat Jo Dongmun.
Dialog: 0,0:21:56.77,0:21:58.44,Default,NANAS,0,0,0,,Selamat.
Dialogue: 0,0:21:58.91,0:22:00.83,Default,PINEAPPLE,0,0,0,,Ini dia keluarga Cho dari Pungyang.
Dialogue: 0,0:22:01.38,0:22:03.67,Default,PINEAPPLE,0,0,0,,Ini terkenal karena tinggal\Ndekat dengan Ibu Suri.
Dialogue: 0,0:22:04.01,0:22:05.61,Default,PINEAPPLE,0,0,0,,Saat putranya Hongjong menjadi raja,
Dialogue: 0,0:22:05.61,0:22:07.62,Default,PINEAPPLE,0,0,0,,mereka dijunjung tinggi, dan kemudian dia mati.
Dialogue: 0,0:22:07.62,0:22:09.65,Default,PINEAPPLE,0,0,0,,Kim Soyeon dari keluarga Andong naik takhta,
Dialogue: 0,0:22:09.65,0:22:11.05,Default,PINEAPPLE,0,0,0,,dan mereka kehilangan pengaruhnya.
Dialogue: 0,0:22:12.85,0:22:15.72,Default,PINEAPPLE,0,0,0,,Sekarang mereka hanya ikan kecil.
Dialogue: 0,0:22:16.02,0:22:17.43,Default,PINEAPPLE,0,0,0,,Orang yang benar-benar berarti adalah...
Dialog: 0,0:22:17.43,0:22:20.85,Default,NANAS,0,0,0,,Komandan pasukan Kim Jwageun.
Dialog: 0,0:22:22.60,0:22:24.77,Default,NANAS,0,0,0,,Selamat, Yang Mulia,
Dialog: 0,0:22:25.20,0:22:26.77,Default,NANAS,0,0,0,,Yang Mulia.
Dialogue: 0,0:22:27.40,0:22:29.30,Default,PINEAPPLE,0,0,0,,Ini dia - pria yang di tangannya seluruh kekuasaan keluarga Kim berada.
Dialogue: 0,0:22:31.14,0:22:33.94,Default,PINEAPPLE,0,0,0,,Karena kita sudah mengumpulkan informasi tentang pernikahanmu,
Dialogue: 0,0:22:33.94,0:22:36.07,Default,PINEAPPLE,0,0,0,,Saya ingin melaporkan sesuatu.
Dialog: 0,0:22:38.25,0:22:39.40,Default,NANAS,0,0,0,,Bicara.
Dialogue: 0,0:22:39.65,0:22:41.95,Default,PINEAPPLE,0,0,0,,Kepala pengawal kerajaan\Ni bertanggung jawab atas keselamatanmu.
Dialog: 0,0:22:42.78,0:22:46.11,Default,PINEAPPLE,0,0,0,,Saya menyarankan Anda untuk menunjuk Kim Moon-geun untuk posisi ini.
Dialogue: 0,0:22:48.22,0:22:49.85,Default,PINEAPPLE,0,0,0,,Ayah mertuaku?
Dialog: 0,0:22:50.33,0:22:51.49,Default,NANAS,0,0,0,,Benar.
Dialogue: 0,0:22:54.26,0:22:56.70,Default,PINEAPPLE,0,0,0,,Ini adalah postingan yang sangat penting.
Dialogue: 0,0:22:57.17,0:23:00.36,Default,PINEAPPLE,0,0,0,,Sang Ratu mengkhawatirkan keselamatanmu.
Dialog: 0,0:23:01.00,0:23:03.33,Default,PINEAPPLE,0,0,0,,Maaf karena tidak menyebutkan ini sebelumnya.
Dialogue: 0,0:23:04.71,0:23:06.81,Default,PINEAPPLE,0,0,0,,Apakah kamu menginginkan ini?
Dialog: 0,0:23:07.08,0:23:08.60,Default,NANAS,0,0,0,,Tuhan tahu, tapi
Dialogue: 0,0:23:09.08,0:23:11.60,Default,PINEAPPLE,0,0,0,,Saya akan tetap pada pemenang.
Dialogue: 0,0:23:12.65,0:23:15.72,Default,PINEAPPLE,0,0,0,,Hidup atau mati,\NI akan mengkhawatirkan keselamatanmu.
Dialog: 0,0:23:15.95,0:23:18.72,Default,NANAS,0,0,0,,Untuk memastikan kamu aman dan sehat,\NI begadang semalaman.
Dialog: 0,0:23:20.96,0:23:23.02,Default,NANAS,0,0,0,,Seekor ular, bukan wanita.
Dialogue: 0,0:23:26.53,0:23:29.32,Default,PINEAPPLE,0,0,0,,Itu saja, maka saya setuju.
Dialogue: 0,0:23:29.36,0:23:30.87,Default,PINEAPPLE,0,0,0,,Janda Ratu
Dialogue: 0,0:23:30.87,0:23:33.86,Default,PINEAPPLE,0,0,0,,senang mendengar permintaan ratu.
Dialogue: 0,0:23:34.47,0:23:36.47,Default,PINEAPPLE,0,0,0,,Adikku saat ini memegang posisi ini
Dialog: 0,0:23:36.47,0:23:37.84,Default,NANAS,0,0,0,,Pangeran Yeonpyeong.
Dialogue: 0,0:23:37.84,0:23:39.84,Default,PINEAPPLE,0,0,0,,Aku butuh waktu untuk berpikir.
Dialogue: 0,0:23:39.84,0:23:42.57,Default,PINEAPPLE,0,0,0,,Keselamatanmu adalah yang utama.
Dialog: 0,0:23:44.65,0:23:47.95,Default,NANAS,0,0,0,,Yang Mulia, mohon ambil keputusan
Dialog: 0,0:23:48.95,0:23:50.38,Default,NASA,0,0,0,,secepatnya.
Dialogue: 0,0:24:09.20,0:24:13.04,Default,PINEAPPLE,0,0,0,,Cintamu kepadaku tidak mengenal batas.
Dialog: 0,0:24:13.81,0:24:17.48,Default,PINEAPPLE,0,0,0,,Lalu, dengan izin Anda, saya akan melanjutkan.
Dialog: 0,0:24:20.68,0:24:22.12,Default,NANAS,0,0,0,,Kim Jwageun,
Dialogue: 0,0:24:22.12,0:24:24.31,Default,PINEAPPLE,0,0,0,,seorang pria yang kekuatannya melebihi raja.
Dialogue: 0,0:24:24.85,0:24:28.08,Default,PINEAPPLE,0,0,0,,Inilah yang sebenarnya memerintah negara.
Dialog: 0,0:24:31.19,0:24:33.26,Default,NANAS,0,0,0,,Pop jagung di sini.
Dialog: 0,0:24:35.96,0:24:38.09,Default,NANAS,0,0,0,,-Yang Mulia!\N-Ratu!
Dialogue: 0,0:24:56.89,0:24:59.64,Default,PINEAPPLE,0,0,0,,Maaf, ayo lanjutkan acaranya.
Dialogue: 0,0:25:02.29,0:25:06.53,Default,PINEAPPLE,0,0,0,,Sepertinya ratu lelah.\NKita mungkin akan berakhir di sini.
Dialogue: 0,0:25:06.86,0:25:10.56,Default,PINEAPPLE,0,0,0,,Malam bersama adalah saat para dewa\Nmembantu mengandung ahli waris.
Dialogue: 0,0:25:10.67,0:25:13.12,Default,PINEAPPLE,0,0,0,,Kita tidak boleh menyerah pada kesenangan.
Dialogue: 0,0:25:13.33,0:25:16.04,Default,PINEAPPLE,0,0,0,,Namun tadi malam, aku tidak sabar.
Dialogue: 0,0:25:17.11,0:25:20.14,Default,PINEAPPLE,0,0,0,,Tidak ada salahnya menikah dengan bahagia.
Dialogue: 0,0:25:20.14,0:25:21.44,Default,PINEAPPLE,0,0,0,,Benarkah?
Dialogue: 0,0:25:21.51,0:25:23.13,Default,PINEAPPLE,0,0,0,,Apa yang dia bicarakan di sini?
Dialogue: 0,0:25:23.68,0:25:26.10,Default,PINEAPPLE,0,0,0,,Kalau begitu, biarkan saja.
Dialogue: 0,0:25:26.25,0:25:30.99,Default,PINEAPPLE,0,0,0,,-Terima kasih, Yang Mulia.\N-Terima kasih, Yang Mulia.
Dialogue: 0,0:25:35.52,0:25:37.23,Default,PINEAPPLE,0,0,0,,Kamu menggertak, kan?
Dialogue: 0,0:25:37.86,0:25:39.38,Default,PINEAPPLE,0,0,0,,Saya tidak memahamimu.
Dialogue: 0,0:25:39.89,0:25:41.83,Default,PINEAPPLE,0,0,0,,Tidak terjadi apa-apa tadi malam.
Dialog: 0,0:25:41.83,0:25:45.30,Default,NANAS,0,0,0,,Kamu membuatku kesal, ya, kamu banyak minum,
Dialogue: 0,0:25:45.67,0:25:48.27,Default,PINEAPPLE,0,0,0,,tapi bagaimana kamu bisa melupakan\Napa yang terjadi di malam pernikahanmu?
Dialogue: 0,0:25:49.80,0:25:50.91,Default,PINEAPPLE,0,0,0,,Apa yang kamu bicarakan?
Dialogue: 0,0:25:50.91,0:25:52.21,Default,PINEAPPLE,0,0,0,,Saya mengerti segalanya.
Dialogue: 0,0:25:52.34,0:25:55.57,Default,PINEAPPLE,0,0,0,,Ingatanmu rusak,\Nkamu mungkin melupakan sesuatu.
Dialogue: 0,0:25:56.61,0:25:59.17,Default,PINEAPPLE,0,0,0,,Itu tidak mungkin.\NTTidak ada apa pun di antara kita.
Dialogue: 0,0:26:02.28,0:26:03.84,Default,PINEAPPLE,0,0,0,,Anda telah lulus ujian.
Dialog: 0,0:26:04.89,0:26:06.92,Default,NANAS,0,0,0,,Memeriksa? Cek seperti apa?
Dialogue: 0,0:26:06.92,0:26:10.19,Default,NANAS,0,0,0,,Tes keperawanan,\Nada darah di kasur.
Dialogue: 0,0:26:11.46,0:26:13.35,Default,PINEAPPLE,0,0,0,,Ada yang harus kulakukan, aku pergi.
Dialogue: 0,0:26:17.33,0:26:20.94,Default,PINEAPPLE,0,0,0,,Tunggu sebentar! Kami tidak setuju!
Dialogue: 0,0:26:20.94,0:26:24.06,Default,PINEAPPLE,0,0,0,,Yang Mulia, mari kita pergi ke ruangan.
Dialogue: 0,0:26:26.51,0:26:29.28,Default,PINEAPPLE,0,0,0,,Jangan khawatir, Jang Bong Hwan, dia semua berbohong.
Dialogue: 0,0:26:29.44,0:26:32.67,Default,PINEAPPLE,0,0,0,,Pikirkan sendiri, kamu akan tahu jika terjadi sesuatu.
Dialogue: 0,0:26:32.98,0:26:34.75,Default,PINEAPPLE,0,0,0,,Tidak terjadi apa-apa! Tidak ada apa-apa!
Dialogue: 0,0:26:37.22,0:26:40.31,Default,PINEAPPLE,0,0,0,,Tentu saja, dia tidak ingin orang tahu bahwa dia tidak tangguh.
Dialogue: 0,0:26:40.39,0:26:42.92,Default,PINEAPPLE,0,0,0,,Dan dia sepertinya suka memutarbalikkan kebenaran.
Dialogue: 0,0:26:42.92,0:26:45.19,Default,PINEAPPLE,0,0,0,,Dan tetap saja!\NDApakah kamu harus begitu perhitungan?
Dialogue: 0,0:26:45.19,0:26:47.09,Default,PINEAPPLE,0,0,0,,Untuk apa memeriksanya?\NUntuk apa ini?
Dialog: 0,0:26:50.30,0:26:51.47,Default,NANAS,0,0,0,,Tunggu sebentar!
Dialogue: 0,0:26:53.60,0:26:55.06,Default,PINEAPPLE,0,0,0,,Bolehkah aku bertanya?
Dialogue: 0,0:26:57.71,0:27:01.71,Default,PINEAPPLE,0,0,0,,Gadis itu akan tahu jika terjadi sesuatu?
Dialogue: 0,0:27:01.81,0:27:03.07,Default,PINEAPPLE,0,0,0,,Sesuatu?
Dialogue: 0,0:27:03.18,0:27:05.64,Default,PINEAPPLE,0,0,0,,Apa yang anda bicarakan, Yang Mulia?
Dialogue: 0,0:27:08.08,0:27:09.61,Default,PINEAPPLE,0,0,0,,Yang ini terlalu muda.
Dialogue: 0,0:27:11.15,0:27:13.52,Default,PINEAPPLE,0,0,0,,Dan selibat ini lebih buruk daripada biksu.
Dialogue: 0,0:27:15.72,0:27:18.15,Default,PINEAPPLE,0,0,0,,Sepertinya tidak ada satu pun dari kalian yang bisa menjawabku.
Dialogue: 0,0:27:21.76,0:27:23.06,Default,PINEAPPLE,0,0,0,,Sungguh mimpi buruk!
Dialog: 0,0:27:37.95,0:27:40.72,Default,3,0,0,0,,-Apakah anak itu menangis karena saya?\N-Tentu saja tidak, Yang Mulia.
Dialog: 0,0:27:40.72,0:27:42.92,Default,3,0,0,0,,Anginnya dingin. Biarkan aku menutup jendelanya.
Dialog: 0,0:27:42.92,0:27:45.09,Default,3,0,0,0,,-Aku sendiri sudah berkeringat.\N-Dingin sekali.
Dialog: 0,0:27:45.09,0:27:46.32,Default,3,0,0,0,,-Di sini panas!\N-Kamu akan masuk angin.
Dialogue: 0,0:27:46.32,0:27:47.81,Default,3,0,0,0,,Aku seksi!
Dialog: 0,0:27:47.82,0:27:49.02,Default,3,0,0,0,,Ayo berangkat.
Dialog: 0,0:27:52.06,0:27:55.56,Default,3,0,0,0,,Aku tidak bisa berhenti memikirkan kata-kata Cheoljong.
Dialog: 0,0:28:07.89,0:28:09.66,Default,3,0,0,0,,Makan dengan tenang, Yang Mulia.
Dialog: 0,0:28:11.36,0:28:12.93,Default,3,0,0,0,,Melihat ratu,
Dialog: 0,0:28:12.96,0:28:16.00,Default,3,0,0,0,,Aku menyadari bahwa dia masih bukan dirinya sendiri.
Dialog: 0,0:28:16.00,0:28:17.27,Default,3,0,0,0,,Bagaimana mengatakannya?
Dialogue: 0,0:28:19.34,0:28:21.24,Default,3,0,0,0,,Terlalu kurang ajar?
Dialog: 0,0:28:21.37,0:28:23.21,Default,3,0,0,0,,Dia selalu berani,
Dialog: 0,0:28:23.21,0:28:26.44,Default,3,0,0,0,,tapi tidak terlalu sombong dan tak kenal takut.
Dialog: 0,0:28:26.44,0:28:29.78,Default,3,0,0,0,,Dia kehilangan ketenangannya selama upacara.
Dialog: 0,0:28:29.78,0:28:32.32,Default,3,0,0,0,,Saya harus mengajarinya aturan kesopanan.
Dialog: 0,0:28:32.45,0:28:35.32,Default,3,0,0,0,,Kamu tidak bisa menunjukkan kelemahanmu kepada orang lain.
Dialog: 0,0:28:36.62,0:28:38.09,Default,3,0,0,0,,Dan untuk Cho Hwajin...
Dialog: 0,0:28:38.46,0:28:41.69,Default,3,0,0,0,,Apakah Anda yakin dia bersama Yang Mulia malam itu?
Dialog: 0,0:28:41.79,0:28:44.90,Default,3,0,0,0,,Ya, saya memastikannya.
Dialog: 0,0:28:45.10,0:28:47.93,Default,3,0,0,0,,Dia memasuki istana 15 menit kemudian
Dialog: 0,0:28:47.93,0:28:49.70,Default,3,0,0,0,,setelah kecelakaan.
Dialog: 0,0:28:49.87,0:28:53.94,Default,3,0,0,0,,Ini bukan bukti bahwa dia mencoba menyakiti Yang Mulia,
Dialog: 0,0:28:54.34,0:28:56.51,Default,3,0,0,0,,tetapi Anda dapat mencoba menggunakan ini.
Dialog: 0,0:28:57.24,0:28:59.01,Default,3,0,0,0,,Misteri besar.
Dialog: 0,0:28:59.44,0:29:02.15,Default,3,0,0,0,,Jika dia tidak melakukannya, lalu siapa?
Dialog: 0,0:29:04.12,0:29:06.18,Default,3,0,0,0,,Apakah menurut Anda ada orang lain yang terlibat?
Dialog: 0,0:29:06.55,0:29:07.79,Default,3,0,0,0,,Mungkin.
Dialog: 0,0:29:08.25,0:29:11.56,Default,3,0,0,0,,Tidak masalah siapa sebenarnya yang melakukannya.
Dialogue: 0,0:29:13.79,0:29:16.83,Default,3,0,0,0,,Yang lebih penting adalah siapa yang perlu kita salahkan dalam hal ini.
Dialog: 0,0:29:18.20,0:29:20.33,Default,3,0,0,0,,Siapa yang kita butuhkan?
Dialogue: 0,0:29:20.33,0:29:21.67,Default,3,0,0,0,,Jika kita menunjuk pada seekor rusa
Dialogue: 0,0:29:22.20,0:29:25.47,Default,3,0,0,0,,dan misalkan ini adalah seekor kuda, maka ia akan menjadi seekor kuda.
Dialog: 0,0:29:25.64,0:29:30.81,Default,3,0,0,0,,Dalam kasus kita, seekor rusa benar-benar bisa menjadi seekor kuda.
Dialog: 0,0:29:31.31,0:29:34.45,Default,3,0,0,0,,Oke. Lupakan bisnis untuk sementara waktu
Dialog: 0,0:29:34.45,0:29:36.38,Default,3,0,0,0,,dan makan, Yang Mulia.
Dialog: 0,0:29:37.82,0:29:41.05,Default,3,0,0,0,,Karena kamu memastikan aku makan enak,
Dialogue: 0,0:29:41.05,0:29:44.46,Default,3,0,0,0,,Aku harus menjaga kesehatanku.
Dialog: 0,0:29:44.46,0:29:47.16,Default,3,0,0,0,,Aku tidak akan membiarkan siapa pun menyakitimu.
Dialog: 0,0:29:48.43,0:29:49.56,Default,3,0,0,0,,Selamat makan.
Dialog: 0,0:30:04.31,0:30:07.51,Default,3,0,0,0,,"Dengan ini saya menetapkan pangkat senior di pengadilan
Dialog: 0,0:30:07.51,0:30:09.01,Default,3,0,0,0,,Cho Hwajin, putri
Dialog: 0,0:30:09.01,0:30:11.95,Default,3,0,0,0,,sekretaris pengadilan Cho Daesu dari keluarga Pungyang Cho.
Dialog: 0,0:30:12.25,0:30:15.55,Default,3,0,0,0,,Dia juga diberi gelar selir kerajaan
Dialog: 0,0:30:15.55,0:30:17.92,Default,3,0,0,0,,untuk kecantikan dan kebenarannya."
Dialog: 0,0:30:17.92,0:30:19.66,Default,3,0,0,0,,marga Pungyang dari Cho.
Dialogue: 0,0:30:19.89,0:30:21.96,Default,3,0,0,0,,Keluarga mereka berseteru, sama seperti mereka.
Dialog: 0,0:30:21.96,0:30:24.63,Default,3,0,0,0,,Apakah dia benar-benar mendorong Kim So-yeon ke dalam danau?
Dialogue: 0,0:30:25.46,0:30:26.96,Default,3,0,0,0,,Dia berbahaya,
Dialog: 0,0:30:27.67,0:30:28.93,Default,3,0,0,0,,dan ini menarik.
Dialog: 0,0:30:31.74,0:30:33.77,Default,3,0,0,0,,Saya berterima kasih kepada Anda, Yang Mulia.
Dialog: 0,0:30:36.21,0:30:37.51,Default,3,0,0,0,,Mari berteman.
Dialog: 0,0:30:41.51,0:30:43.15,Default,3,0,0,0,,Saya, tentu saja, berada di pihak yang menang,
Dialog: 0,0:30:43.15,0:30:45.65,Default,3,0,0,0,,tapi aku tidak bisa menolak keindahan seperti itu.
Dialog: 0,0:30:47.85,0:30:49.05,Default,3,0,0,0,,Mari berteman.
Dialog: 0,0:30:49.69,0:30:53.32,Default,3,0,0,0,,Anda akan segera memahami bahwa saya \Nsempurna, yah, kecuali
Dialogue: 0,0:30:53.72,0:30:55.09,Default,3,0,0,0,,beberapa kekurangan.
Dialog: 0,0:30:58.33,0:31:00.40,Default,3,0,0,0,,Karena kita sangat dekat,
Dialog: 0,0:31:00.40,0:31:02.13,Default,3,0,0,0,,bolehkah saya mengajukan pertanyaan?
Dialog: 0,0:31:02.13,0:31:04.14,Default,3,0,0,0,,Tidak ada orang lain yang bertanya.
Dialog: 0,0:31:04.20,0:31:07.81,Default,3,0,0,0,,Saya tidak yakin apakah saya memiliki kebijaksanaan untuk menjawab pertanyaan itu.
Dialog: 0,0:31:07.81,0:31:11.11,Default,3,0,0,0,,Kamu pasti tahu segalanya tentang dia. Saya sedang berbicara tentang raja.
Dialogue: 0,0:31:25.09,0:31:28.06,Default,3,0,0,0,,Apakah dia sering berbohong?
Dialog: 0,0:31:29.63,0:31:31.73,Default,3,0,0,0,,Saya sudah mendengar banyak tentang dia.
Dialog: 0,0:31:32.13,0:31:35.10,Default,3,0,0,0,,Dan mereka bilang raja
Dialog: 0,0:31:35.10,0:31:36.50,Default,3,0,0,0,,menghilang di malam hari.
Dialog: 0,0:31:37.17,0:31:39.47,Default,3,0,0,0,,Hilang di malam hari?
Dialog: 0,0:31:40.24,0:31:42.37,Default,3,0,0,0,,Saya belum pernah mendengar hal seperti itu.
Dialog: 0,0:31:42.37,0:31:45.54,Default,3,0,0,0,,Seorang pejuang di siang hari, dan menghilang di malam hari.
Dialog: 0,0:31:47.31,0:31:50.45,Default,3,0,0,0,,Dia bilang kami menghabiskan malam yang panas bersama.
Dialog: 0,0:31:50.45,0:31:53.42,Default,3,0,0,0,,-Dia cenderung memutarbalikkan...\N-Yang Mulia.
Dialog: 0,0:31:53.72,0:31:56.55,Default,3,0,0,0,,Dengan segala hormat, ini sangat tidak pantas.
Dialog: 0,0:31:56.82,0:32:00.46,Default,3,0,0,0,,Maaf jika saya menyinggung perasaan Anda. Saya tidak bisa tidak memikirkannya.
Dialog: 0,0:32:01.43,0:32:04.36,Default,3,0,0,0,,Saya baru tiba kemarin, ada banyak hal yang perlu saya khawatirkan.
Dialog: 0,0:32:04.56,0:32:07.40,Default,3,0,0,0,,Maaf menyita waktu. Pergi.
Dialog: 0,0:32:10.74,0:32:11.90,Default,3,0,0,0,,Sampai jumpa lagi.
Dialog: 0,0:32:21.25,0:32:25.22,Default,3,0,0,0,,Saya akan mengatakan satu hal dengan pasti. Yang Mulia tidak seperti itu.
Dialog: 0,0:32:35.36,0:32:39.43,Default,3,0,0,0,,Tidak seperti itu? Maksudmu dia tidak berbohong?
Dialog: 0,0:32:39.93,0:32:43.30,Default,3,0,0,0,,Atau tidak hilang di malam hari? Apa yang kamu bicarakan?
Dialog: 0,0:32:47.00,0:32:48.51,Default,3,0,0,0,,Sangat jelas!
Dialog: 0,0:32:50.98,0:32:52.24,Default,3,0,0,0,,Sial.
Dialog: 0,0:34:41.59,0:34:43.05,Default,3,0,0,0,,Perampok!
Dialog: 0,0:34:43.69,0:34:45.69,Default,3,0,0,0,,Perampok!
Dialog: 0,0:34:45.79,0:34:47.86,Default,3,0,0,0,,Perampok! Ada perampok di sini!
Dialog: 0,0:34:48.33,0:34:50.36,Default,3,0,0,0,,Perampok!
Dialog: 0,0:34:50.96,0:34:52.80,Default,3,0,0,0,,Perampok! Mereka ada di sana!
Dialog: 0,0:34:55.87,0:34:57.37,Default,3,0,0,0,,Perampok!
Dialogue: 0,0:35:16.02,0:35:18.46,Default,3,0,0,0,,Jangan menangis. Tidak perlu.
Dialog: 0,0:35:18.46,0:35:19.62,Default,3,0,0,0,,Hentikan, oke?
Dialog: 0,0:35:30.80,0:35:33.10,Default,3,0,0,0,,Sayangku, sayang!
Dialog: 0,0:35:46.25,0:35:47.35,Default,3,0,0,0,,Tidak!
Dialog: 0,0:36:38.30,0:36:39.47,Default,3,0,0,0,,Yang Mulia.
Dialog: 0,0:36:43.81,0:36:46.54,Default,3,0,0,0,,Itu juga tidak ada di penyimpanan rahasia, aku memeriksanya di malam hari.
Dialog: 0,0:36:47.04,0:36:48.68,Default,3,0,0,0,,Saya mencari secara menyeluruh
Dialog: 0,0:36:48.68,0:36:51.15,Default,3,0,0,0,,semua sudut tersembunyi di istana,
Dialogue: 0,0:36:51.45,0:36:54.05,Default,3,0,0,0,,mungkinkah ini disembunyikan di sarang harimau?
Dialog: 0,0:36:55.05,0:36:58.12,Default,3,0,0,0,,Yang Mulia, ratu ada di sini untuk menemui Anda.
Dialog: 0,0:37:07.10,0:37:09.30,Default,3,0,0,0,,Saya terlalu sibuk dengan urusan negara.
Dialog: 0,0:37:09.30,0:37:10.67,Default,3,0,0,0,,Jadi saya tepat sasaran.
Dialog: 0,0:37:10.67,0:37:12.14,Default,3,0,0,0,,Ada yang perlu dibicarakan.
Dialogue: 0,0:37:17.64,0:37:20.68,Default,3,0,0,0,,Sibuk sekali sampai kamu memegangnya terbalik.
Dialog: 0,0:37:23.31,0:37:26.25,Default,3,0,0,0,,Ini bukan tanpa alasan, aku memikirkan banyak hal.
Dialog: 0,0:37:27.65,0:37:29.99,Default,3,0,0,0,,Pikirkan pikiranmu. saya akan menunggu.
Dialogue: 0,0:37:43.57,0:37:45.47,Default,3,0,0,0,,Kenapa kamu menatap seperti itu?
Dialog: 0,0:37:46.14,0:37:47.24,Default,3,0,0,0,,Anda lihat,
Dialog: 0,0:37:47.84,0:37:50.37,Default,3,0,0,0,,menarik melihat seberapa keras Anda mencoba.
Dialog: 0,0:37:50.37,0:37:54.24,Default,3,0,0,0,,Sebagai raja, saya harus mengawasi urusan negara.
Dialogue: 0,0:37:54.51,0:37:57.58,Default,3,0,0,0,,Apakah dia sengaja membicarakan "bisnis"?
Dialog: 0,0:37:58.15,0:38:00.48,Default,3,0,0,0,,Saya telah menunjuk selir kerajaan sesuai keinginan Anda.
Dialog: 0,0:38:00.68,0:38:02.42,Default,3,0,0,0,,Kamu bisa tidur di kamarmu.
Dialog: 0,0:38:02.42,0:38:03.59,Default,3,0,0,0,,Dengan senang hati.
Dialog: 0,0:38:06.36,0:38:08.06,Default,3,0,0,0,,Apakah kamu ingin memberitahuku sesuatu?
Dialog: 0,0:38:08.86,0:38:10.83,Default,3,0,0,0,,Kamu sendiri yang datang kepadaku.
Dialog: 0,0:38:10.83,0:38:13.06,Default,3,0,0,0,,Anda mungkin ingin mengatakan sesuatu sendiri.
Dialogue: 0,0:38:14.70,0:38:17.00,Default,3,0,0,0,,Karena hanya kita berdua di sini, jujur ​​saja.
Dialogue: 0,0:38:17.00,0:38:18.04,Default,3,0,0,0,,Tadi malam kita...
Dialog: 0,0:38:18.04,0:38:20.14,Default,3,0,0,0,,Kami bersenang-senang.
Dialog: 0,0:38:22.61,0:38:25.78,Default,3,0,0,0,,Oke, jika kamu terus berpura-pura...
Dialog: 0,0:38:43.73,0:38:44.83,Default,3,0,0,0,,Ya Tuhan.
Dialogue: 0,0:38:45.23,0:38:47.23,Default,3,0,0,0,,Kau menggangguku.
Dialog: 0,0:38:50.10,0:38:51.47,Default,3,0,0,0,,Jika kamu tidak mau bicara,
Dialog: 0,0:38:51.47,0:38:53.27,Default,3,0,0,0,,gunakan isyarat tangan?
Dialog: 0,0:38:53.27,0:38:54.47,Default,3,0,0,0,,Misalnya, yang ini.
Dialog: 0,0:38:55.34,0:38:56.57,Default,3,0,0,0,,Apa ini?
Dialogue: 0,0:38:56.84,0:39:00.18,Default,3,0,0,0,,Artinya aku berbohong.
Dialog: 0,0:39:00.48,0:39:02.58,Default,3,0,0,0,,Bagaimana menurutmu? Tidak sulit, bukan?
Dialog: 0,0:39:09.09,0:39:11.96,Default,3,0,0,0,,Raja tidak pernah berbohong.
Dialog: 0,0:39:13.66,0:39:14.86,Default,3,0,0,0,,Kamu boleh pergi.
Dialog: 0,0:39:21.40,0:39:23.03,Default,3,0,0,0,,Sial. Sangat menyebalkan.
Dialog: 0,0:39:23.50,0:39:25.54,Default,3,0,0,0,,Dengan wajah datar, dia bersikeras bahwa sesuatu telah terjadi.
Dialogue: 0,0:39:25.54,0:39:28.51,Default,3,0,0,0,,Benarkah atau tidak?
Dialog: 0,0:39:29.91,0:39:32.44,Default,3,0,0,0,,Yang Mulia, apakah ini hari yang berat?
Dialog: 0,0:39:39.62,0:39:42.42,Default,3,0,0,0,,Oh, menggelitik.
Dialog: 0,0:39:42.85,0:39:44.69,Default,3,0,0,0,,Hei, santai saja.
Dialogue: 0,0:39:45.06,0:39:47.42,Default,3,0,0,0,,Aku geli.
Dialog: 0,0:39:54.43,0:39:55.60,Default,3,0,0,0,,Yang Mulia.
Dialog: 0,0:39:55.77,0:39:59.10,Default,3,0,0,0,,Kelas etika dimulai hari ini.
Dialog: 0,0:39:59.27,0:40:01.61,Default,3,0,0,0,,Perilakuku sudah beres.
Dialog: 0,0:40:05.28,0:40:08.85,Default,3,0,0,0,,Ini adalah kursus kilat tentang etika istana.
Dialog: 0,0:40:11.08,0:40:12.58,Default,3,0,0,0,,Saya tidak mau.
Dialog: 0,0:40:18.12,0:40:20.79,Default,3,0,0,0,,Perintah dari Janda Ratu.
Dialog: 0,0:40:21.36,0:40:22.43,Default,3,0,0,0,,Saya ingin kembali,
Dialog: 0,0:40:22.43,0:40:23.99,Default,3,0,0,0,,daripada lulus tes.
Dialog: 0,0:40:24.16,0:40:26.06,Default,3,0,0,0,,Untuk memulainya, aku akan mengalahkan ratu.
Dialog: 0,0:40:29.80,0:40:32.00,Default,3,0,0,0,,Anda mungkin tidak tahu, tapi saya mempelajari etiket
Dialog: 0,0:40:32.00,0:40:34.34,Default,3,0,0,0,,di Cheongaktong selama empat tahun.
Dialogue: 0,0:40:35.14,0:40:38.98,Default,3,0,0,0,,Tunjukkan seberapa santun lulusannya?
Dialog: 0,0:40:47.25,0:40:51.39,Default,3,0,0,0,,Wanita dari keluarga kerajaan itu tenang seperti seorang Buddha.
Dialog: 0,0:40:58.30,0:41:00.43,Default,3,0,0,0,,Dia tidak membuat nafas saat berjalan.
Dialog: 0,0:41:00.53,0:41:02.53,Default,3,0,0,0,,Lampu lilin tidak berkedip.
Dialog: 0,0:41:20.82,0:41:23.95,Default,3,0,0,0,,Dia tidak membuka mulutnya lebar-lebar saat makan
Dialog: 0,0:41:24.32,0:41:26.49,Default,3,0,0,0,,dan tidak menggigit dalam potongan besar.
Dialogue: 0,0:41:40.77,0:41:43.11,Default,3,0,0,0,,Bordir adalah cara terbaik bagi seorang wanita
Dialog: 0,0:41:43.11,0:41:44.68,Default,3,0,0,0,,pahami pikiranmu.
Dialogue: 0,0:41:46.74,0:41:49.38,Default,3,0,0,0,,Bordir. Dia bisa melakukannya.
Dialog: 0,0:41:59.59,0:42:01.63,Default,3,0,0,0,,Saya dibesarkan dengan baik.
Dialog: 0,0:42:01.63,0:42:02.96,Default,3,0,0,0,,Saya tidak bisa bernapas sekarang?
Dialog: 0,0:42:02.96,0:42:04.26,Default,3,0,0,0,,Di sini lebih buruk daripada di Cheongaktong.
Dialogue: 0,0:42:04.26,0:42:05.43,Default,3,0,0,0,,Persetan.
Dialogue: 0,0:42:14.44,0:42:16.47,Default,3,0,0,0,,Bagaimana cara memakan keindahan seperti itu?
Dialog: 0,0:42:17.24,0:42:19.91,Default,3,0,0,0,,Pertama, tonton dan nikmati.
Dialogue: 0,0:42:21.01,0:42:23.58,Default,3,0,0,0,,Bagaimana kalau kita menontonnya? Sepertinya
Dialog: 0,0:42:23.58,0:42:25.35,Default,3,0,0,0,,kamu memasukkan semuanya ke dalam mulutmu.
Dialogue: 0,0:42:29.32,0:42:31.72,Default,3,0,0,0,,Dulu kamu menyukainya.
Dialog: 0,0:42:33.49,0:42:35.19,Default,3,0,0,0,,Honyoung, cobalah. Lebarkan mulutmu.
Dialog: 0,0:42:46.84,0:42:48.47,Default,3,0,0,0,,Apa yang terjadi, Yang Mulia?
Dialogue: 0,0:42:55.08,0:42:57.18,Default,3,0,0,0,,Apakah ini kenangan Kim So-yeon?
Dialog: 0,0:42:58.42,0:42:59.72,Default,3,0,0,0,,Hati...
Dialog: 0,0:43:01.75,0:43:02.89,Default,3,0,0,0,,Keracunan.
Dialogue: 0,0:43:02.89,0:43:04.59,Default,3,0,0,0,,Cepat, penyembuhnya ada di sini!
Dialog: 0,0:43:04.59,0:43:05.86,Default,3,0,0,0,,-Yang Mulia.\N-Yang Mulia.
Dialog: 0,0:43:06.22,0:43:08.16,Default,3,0,0,0,,-Katakan saja.\N-Yang Mulia.
Dialog: 0,0:43:08.49,0:43:11.39,Default,3,0,0,0,,-Yang Mulia.\N-Ini bukan rasa sakit.
Dialogue: 0,0:43:13.03,0:43:17.30,Default,3,0,0,0,,Apakah wanita ini menyukai Cheoljong?
Dialog: 0,0:43:30.21,0:43:32.05,Default,3,0,0,0,,Kamu harus mencintaiku.
Dialog: 0,0:43:37.45,0:43:38.72,Default,3,0,0,0,,Matanya.
Dialog: 0,0:43:39.72,0:43:41.86,Default,3,0,0,0,,Ini lebih dari kebencian. Dia membencinya.
Dialog: 0,0:43:44.26,0:43:45.60,Default,3,0,0,0,,Tolong, Yang Mulia.
Dialogue: 0,0:43:51.57,0:43:53.87,Default,3,0,0,0,,Aku lebih suka camilan daripada alkohol itu sendiri.
Dialog: 0,0:43:54.10,0:43:55.44,Default,3,0,0,0,,Dan bagus.
Dialogue: 0,0:43:55.47,0:43:58.11,Default,3,0,0,0,,Semua alkohol menguntungkanmu.
Dialog: 0,0:43:58.11,0:44:01.55,Default,3,0,0,0,,Dia tidak akan berbagi malam ini denganku.
Dialog: 0,0:44:01.55,0:44:03.58,Default,3,0,0,0,,Jadi dia mencoba membuatku mabuk.
Dialog: 0,0:44:03.95,0:44:06.02,Default,3,0,0,0,,Kami memikirkan hal yang sama.
Dialogue: 0,0:44:06.98,0:44:10.12,Default,PINEAPPLE,0,0,0,,Sekarang kamu harus berusaha semaksimal mungkin untuk menghasilkan ahli waris.
Dialogue: 0,0:44:10.12,0:44:12.76,Default,3,0,0,0,,Sadarlah, Yang Mulia.
Dialog: 0,0:44:12.76,0:44:14.46,Default,3,0,0,0,,Bawakan air!
Dialogue: 0,0:44:14.49,0:44:15.49,Default,3,0,0,0,,Untuk mengelabui keluarga Kim,
Dialog: 0,0:44:15.49,0:44:17.16,Default,3,0,0,0,,memaksa mereka untuk tidur,
Dialog: 0,0:44:17.16,0:44:20.06,Default,3,0,0,0,,Choljong berbohong.
Dialog: 0,0:44:26.50,0:44:29.21,Default,3,0,0,0,,Honyoung. Tidak ada apa-apa!
Dialogue: 0,0:44:31.24,0:44:33.41,Default,3,0,0,0,,Memikirkan hal ini hampir membuatku gila.
Dialogue: 0,0:44:33.41,0:44:35.95,Default,3,0,0,0,,Aku percaya pada diriku sendiri, tapi bukan si bodoh itu.
Dialog: 0,0:44:35.95,0:44:37.08,Default,3,0,0,0,,Namun...
Dialog: 0,0:44:40.75,0:44:41.99,Default,3,0,0,0,,Apa yang kamu lakukan di sini?
Dialog: 0,0:44:59.34,0:45:03.14,Default,3,0,0,0,,-Lainnya. Tarik lebih tinggi.\N-Ya.
Dialogue: 0,0:45:05.54,0:45:09.05,Default,3,0,0,0,,Betapa melelahkannya mempertahankan posisimu.
Dialogue: 0,0:45:09.05,0:45:12.12,Default,3,0,0,0,,Decrepitude berarti kamu menjadi lebih lemah.
Dialog: 0,0:45:12.25,0:45:14.65,Default,3,0,0,0,,Jika Anda melakukan ini dua kali sehari,
Dialogue: 0,0:45:14.65,0:45:17.62,Default,3,0,0,0,,kerutan tidak akan bertambah dalam.
Dialog: 0,0:45:18.05,0:45:21.76,Default,3,0,0,0,,Saya mengerti. Anda berusaha keras.
Dialog: 0,0:45:22.09,0:45:23.89,Default,3,0,0,0,,Mengapa kamu datang kepadaku?
Dialog: 0,0:45:24.33,0:45:26.56,Default,3,0,0,0,,Atas desakan Anda, setelah menerima pelajaran etiket,
Dialog: 0,0:45:26.56,0:45:29.10,Default,3,0,0,0,,Saya menyadari apa yang harus saya lakukan
Dialog: 0,0:45:29.10,0:45:30.80,Default,3,0,0,0,,ratu sungguhan.
Dialog: 0,0:45:31.33,0:45:32.87,Default,3,0,0,0,,Saya sangat senang.
Dialog: 0,0:45:34.57,0:45:37.31,Default,4,0,0,0,,-Cukup, berhenti. \N-Oke, oke.
Dialog: 0,0:45:44.45,0:45:46.18,Default,4,0,0,0,,Jadi, kemarin kami tidur dengan Yang Mulia,
Dialog: 0,0:45:46.52,0:45:48.82,Default,4,0,0,0,,tapi sepertinya mereka telah memompa seluruh kekuatanku,
Dialog: 0,0:45:48.82,0:45:51.02,Default,4,0,0,0,,semua menjadi sangat lamban.
Dialog: 0,0:45:51.49,0:45:54.06,Default,4,0,0,0,,Saya terus bertanya-tanya apa alasannya, dan saya mengerti!
Dialog: 0,0:45:56.33,0:45:59.03,Default,4,0,0,0,,Semua karena waduknya dikeringkan.
Dialog: 0,0:45:59.13,0:46:01.50,Default,4,0,0,0,,Jadi prinsip kewanitaanku melemah.
Dialog: 0,0:46:02.00,0:46:03.87,Default,4,0,0,0,,Kalau saja diisi air lagi,
Dialog: 0,0:46:03.87,0:46:05.90,Default,4,0,0,0,,Aku akan segera menggendong sang pangeran.
Dialog: 0,0:46:05.90,0:46:07.17,Default,4,0,0,0,,Dikecualikan.
Dialog: 0,0:46:08.17,0:46:11.47,Default,4,0,0,0,,-Astaga.\N-Kami baru saja menyelamatkanmu.
Dialog: 0,0:46:11.47,0:46:13.41,Default,4,0,0,0,,Dengan cara yang baik, semua orang yang mengizinkan
Dialog: 0,0:46:13.41,0:46:16.35,Default,4,0,0,0,,jika hal seperti ini terjadi, seharusnya mereka dieksekusi.
Dialog: 0,0:46:16.51,0:46:18.78,Default,4,0,0,0,,Namun, pada malam peristiwa yang begitu membahagiakan,
Dialog: 0,0:46:18.78,0:46:21.52,Default,4,0,0,0,,kami menunjukkan belas kasihan dan tidak menumpahkan darah.
Dialog: 0,0:46:22.79,0:46:26.82,Default,4,0,0,0,,Tetapi karena Anda ingin mengisi kolam dengan air, Anda harus menghukum semua yang bertanggung jawab.
Dialogue: 0,0:46:27.12,0:46:30.49,Default,4,0,0,0,,Siapa disana? Hongyong, dayang Choi. Siapa lagi?
Dialogue: 0,0:46:31.46,0:46:35.13,Default,4,0,0,0,,Semua yang terlibat akan dihukum seberat-beratnya.
Dialogue: 0,0:46:35.20,0:46:38.27,Default,4,0,0,0,,Sungguh jahat. Ini bukan nenek tetanggamu yang manis.
Dialog: 0,0:46:39.24,0:46:40.40,Default,4,0,0,0,,Bagaimana jika saya mengeksekusi
Dialog: 0,0:46:41.10,0:46:42.74,Default,4,0,0,0,,tugas perkawinan selama tiga malam penuh,
Dialog: 0,0:46:42.74,0:46:44.61,Default,4,0,0,0,,untuk mengandung seorang putra bagi raja sesegera mungkin?
Dialog: 0,0:46:45.51,0:46:47.34,Default,4,0,0,0,,Maukah kamu mengisi kolam dengan air untuk ini?
Dialog: 0,0:46:47.54,0:46:48.68,Default,4,0,0,0,,Tujuh malam.
Dialog: 0,0:46:49.48,0:46:50.65,Default,4,0,0,0,,Lima.
Dialog: 0,0:46:50.71,0:46:53.75,Default,4,0,0,0,,Dengarkan di sini. Semua orang yang terlibat...
Dialog: 0,0:46:53.75,0:46:54.88,Default,4,0,0,0,,Tujuh malam.
Dialogue: 0,0:46:55.39,0:46:56.69,Default,4,0,0,0,,Tujuh adalah angka yang bagus.
Dialog: 0,0:46:57.15,0:46:59.72,Default,4,0,0,0,,Jika kamu berjanji untuk mengisi kolam dengan air,
Dialog: 0,0:46:59.72,0:47:02.36,Default,4,0,0,0,,Saya akan melakukan segalanya untuk mengandung seorang pangeran.
Dialogue: 0,0:47:05.10,0:47:08.37,Default,4,0,0,0,,Bahkan anak laki-laki, bahkan seekor anjing kecil, hanya untuk kembali.
Dialog: 0,0:47:28.45,0:47:30.52,Default,4,0,0,0,,Selir Cho datang menyambutmu.
Dialog: 0,0:47:35.79,0:47:40.26,Default,4,0,0,0,,Wow, kamu menarik dan anggun seperti yang digambarkan oleh mereka.
Dialogue: 0,0:47:40.90,0:47:45.24,Default,4,0,0,0,,Yang Mulia sangat memperhatikan keindahan.
Dialogue: 0,0:47:45.90,0:47:47.54,Default,4,0,0,0,,Kamu menyanjungku.
Dialog: 0,0:47:56.88,0:47:58.25,Default,4,0,0,0,,Ini adalah hadiah.
Dialog: 0,0:47:58.52,0:48:00.62,Default,4,0,0,0,,Sesuatu yang kamu perlukan di istana.
Dialog: 0,0:48:00.62,0:48:02.52,Default,4,0,0,0,,Tidak mungkin tanpa ini.
Dialog: 0,0:48:04.29,0:48:05.86,Default,4,0,0,0,,Lihat.
Dialog: 0,0:48:20.97,0:48:23.14,Default,4,0,0,0,,Kehidupan di istana sama sekali tidak manis.
Dialog: 0,0:48:23.44,0:48:25.38,Default,4,0,0,0,,Tidak ada yang bisa diandalkan di sini.
Dialog: 0,0:48:25.38,0:48:28.91,Default,4,0,0,0,,Di sini Anda bisa melupakan hari-hari tenang.
Dialog: 0,0:48:29.35,0:48:33.25,Default,4,0,0,0,,Oh ya, beri tahu aku tanggal dan tahun berapa kamu lahir?
Dialog: 0,0:48:33.98,0:48:37.95,Default,4,0,0,0,,Tahukah Anda apa yang harus dilakukan untuk mengandung seorang putra bagi Yang Mulia?
Dialogue: 0,0:48:39.86,0:48:42.03,Default,4,0,0,0,,Apa yang kubicarakan?
Dialog: 0,0:48:42.03,0:48:44.89,Default,4,0,0,0,,Pertama, Anda perlu memeriksa\N kompatibilitas dengan Yang Mulia.
Dialog: 0,0:48:47.16,0:48:51.90,Default,4,0,0,0,,Hubungi saya jika Anda membutuhkan jimat yang kuat.
Dialog: 0,0:48:53.07,0:48:57.24,Default,4,0,0,0,,Saya kenal seorang dukun yang tahu banyak tentang mata jahat dan kutukan.
Dialog: 0,0:48:57.34,0:48:59.88,Default,4,0,0,0,,Terakhir kali aku sangat senang dengannya.
Dialog: 0,0:49:00.04,0:49:02.91,Default,4,0,0,0,,Yang Mulia, maafkan saya.
Dialog: 0,0:49:02.91,0:49:05.92,Default,4,0,0,0,,Tetapi saya di sini untuk menjaga kebaikan Yang Mulia.
Dialog: 0,0:49:07.58,0:49:10.65,Default,4,0,0,0,,Rupanya, saya salah memahami sesuatu.
Dialog: 0,0:49:12.22,0:49:13.99,Default,4,0,0,0,,Maaf, Ibu Suri.
Dialogue: 0,0:49:14.36,0:49:16.53,Default,4,0,0,0,,Mungkin aku mengungkapkan diriku terlalu kasar.
Dialog: 0,0:49:16.56,0:49:20.16,Default,4,0,0,0,,Semuanya baik-baik saja. Jangan dimasukkan ke dalam hati.
Dialog: 0,0:49:22.80,0:49:26.04,Default,4,0,0,0,,Omong-omong, tentang hati. Ini adalah hari-hari pertamamu di istana,
Dialogue: 0,0:49:26.34,0:49:28.84,Default,4,0,0,0,,dan kamu harus bervegetasi sendirian.
Dialogue: 0,0:49:29.17,0:49:32.34,Default,4,0,0,0,,Sayang sekali. Apa yang kamu rencanakan?
Dialog: 0,0:49:33.21,0:49:34.38,Default,4,0,0,0,,Apa?
Dialog: 0,0:49:34.58,0:49:37.48,Default,4,0,0,0,,Selama tujuh hari ke depan Yang Mulia akan hadir
Dialog: 0,0:49:37.48,0:49:39.58,Default,4,0,0,0,,tidur di kamar Yang Mulia.
Dialog: 0,0:49:39.75,0:49:41.95,Default,4,0,0,0,,Semuanya sudah baik-baik saja,
Dialog: 0,0:49:41.95,0:49:44.95,Default,4,0,0,0,,tenang dan sunyi.
Dialog: 0,0:49:45.39,0:49:47.89,Default,4,0,0,0,,Jadi mereka akan menghabiskan tujuh malam lagi bersama.
Dialog: 0,0:49:48.76,0:49:50.99,Default,4,0,0,0,,Tetapi Anda tidak perlu khawatir.
Dialog: 0,0:49:51.16,0:49:53.36,Default,4,0,0,0,,Saya yakin selama tujuh hari ini perasaan Yang Mulia
Dialog: 0,0:49:53.36,0:49:56.13,Default,4,0,0,0,,mereka tidak akan menenangkanmu.
Dialog: 0,0:50:24.76,0:50:26.40,Default,4,0,0,0,,Suatu hari nanti kamu akan kalah
Dialog: 0,0:50:27.56,0:50:30.20,Default,4,0,0,0,,orang tersayang.
Dialog: 0,0:50:51.29,0:50:52.42,Default,4,0,0,0,,Ny.
Dialogue: 0,0:51:02.53,0:51:05.50,Default,4,0,0,0,,Sepertinya sheetnya rusak,\Ntidak ada yang bisa diperbaiki di sini.
Dialog: 0,0:51:06.74,0:51:09.04,Default,4,0,0,0,,Sayang sekali, tapi Anda harus menulis semuanya lagi.
Dialog: 0,0:51:11.37,0:51:15.31,Default,4,0,0,0,,Kamu sangat cantik sehingga kamu bisa dengan mudah menjadi ratu.
Dialog: 0,0:51:16.25,0:51:18.65,Default,4,0,0,0,,Satu-satunya kelebihan yang dimiliki ratu adalah silsilah yang baik,
Dialog: 0,0:51:18.65,0:51:20.55,Default,4,0,0,0,,dan dia memutar Yang Mulia sesuai keinginannya.
Dialog: 0,0:51:20.55,0:51:21.72,Default,4,0,0,0,,Ingat.
Dialog: 0,0:51:22.55,0:51:25.26,Default,4,0,0,0,,Ratu setara statusnya dengan raja.
Dialog: 0,0:51:25.56,0:51:27.72,Default,4,0,0,0,,Ingat, semakin tinggi statusnya, semakin besar tanggung jawabnya,
Dialog: 0,0:51:27.79,0:51:29.39,Default,4,0,0,0,,perhatikan apa yang kamu katakan.
Dialogue: 0,0:51:29.39,0:51:30.93,Default,4,0,0,0,,Jangan ke peramal di sini, itu perbuatannya.
Dialog: 0,0:51:30.93,0:51:32.96,Default,4,0,0,0,,Dialah yang berbisik kepada dayang istana tentang tujuh malam.
Dialog: 0,0:51:32.96,0:51:35.60,Default,4,0,0,0,,Dia juga menuduhmu melakukan sesuatu yang tidak kamu lakukan.
Dialogue: 0,0:51:35.70,0:51:38.53,Default,4,0,0,0,,Sayang sekali kamu berada di sana pada saat yang paling tidak tepat!
Dialogue: 0,0:51:44.74,0:51:47.34,Default,4,0,0,0,,Aku belum terbiasa dengan kehidupan di istana.
Dialog: 0,0:51:47.84,0:51:49.28,Default,4,0,0,0,,Lidahku adalah musuhku.
Dialog: 0,0:51:50.35,0:51:52.18,Default,4,0,0,0,,Maafkan saya, Nyonya.
Dialogue: 0,0:51:55.42,0:51:59.79,Default,4,0,0,0,,Bagaimana aku bisa mendapatkan bantuan Yang Mulia?
Dialog: 0,0:52:12.80,0:52:14.54,Default,4,0,0,0,,Dia sendiri yang menyuruhku bermalam di kamarku.
Dialog: 0,0:52:14.54,0:52:17.64,Default,4,0,0,0,,Dan kemudian dia menoleh ke Janda Ratu\N dengan permintaan yang sangat berbeda.
Dialogue: 0,0:52:17.71,0:52:20.58,Default,4,0,0,0,,Betapa sulitnya memahami hati seorang wanita.
Dialog: 0,0:52:21.38,0:52:24.45,Default,4,0,0,0,,Dengar, aku ingin menawarkanmu sesuatu\N. Anda tidak keberatan, bukan?
Dialog: 0,0:52:24.95,0:52:28.08,Default,4,0,0,0,,Bagaimana aku bisa menolakmu?
Dialog: 0,0:52:28.72,0:52:31.42,Default,4,0,0,0,,Saya menyarankan untuk menjaga jarak sosial.
Dialog: 0,0:52:31.42,0:52:33.56,Default,4,0,0,0,,-Tidak juga. \N-Kamu bilang kamu tidak akan menolak.
Dialog: 0,0:52:33.56,0:52:35.09,Default,4,0,0,0,,Saya tidak mengerti maksud kata-kata Anda.
Dialog: 0,0:52:35.26,0:52:37.16,Default,4,0,0,0,,Saya tidak mengerti apa pun, tapi apakah Anda sudah menyerah?
Dialog: 0,0:52:37.16,0:52:39.73,Default,4,0,0,0,,Makanya saya menolak karena saya tidak mengerti apa-apa.
Dialog: 0,0:52:42.47,0:52:44.17,Default,4,0,0,0,,Kalau begitu dengarkan, saya akan jelaskan sekarang.
Dialogue: 0,0:52:44.47,0:52:48.24,Default,4,0,0,0,,Jarak sosial adalah saat semua orang sendirian.
Dialog: 0,0:52:48.24,0:52:49.47,Default,4,0,0,0,,Itu sangat bagus.
Dialogue: 0,0:52:49.51,0:52:51.91,Default,4,0,0,0,,Katakanlah kita harus tidur bersama.
Dialog: 0,0:52:51.91,0:52:54.81,Default,4,0,0,0,,Faktanya, kamu tidur di tempatmu, dan aku di tempatku.
Dialog: 0,0:52:55.45,0:52:57.01,Default,4,0,0,0,,Ini menjauhkan.
Dialog: 0,0:52:59.45,0:53:00.72,Default,4,0,0,0,,Saya masih menentangnya.
Dialog: 0,0:53:01.15,0:53:02.95,Default,4,0,0,0,,Tapi kenapa?
Dialog: 0,0:53:04.32,0:53:07.39,Default,4,0,0,0,,Saya tidak tahu kenapa, tapi saya tidak menyukainya.
Dialogue: 0,0:53:08.02,0:53:09.89,Default,4,0,0,0,,Dasar mesum.
Dialog: 0,0:53:12.50,0:53:15.57,Default,4,0,0,0,,Nah, kamu perlu berbicara dengan orang mesum dalam bahasa mereka sendiri.
Dialog: 0,0:53:18.23,0:53:20.87,Default,4,0,0,0,,Kau tahu, aku tidak ingat apa pun dari tadi malam.
Dialog: 0,0:53:21.10,0:53:22.74,Default,4,0,0,0,,Mungkin kita bisa mengulanginya?
Dialogue: 0,0:53:23.34,0:53:25.41,Default,4,0,0,0,,Mari kita nyalakan dengan benar.
Dialog: 0,0:53:26.61,0:53:27.81,Default,4,0,0,0,,Haruskah kita menyalakannya?
Dialog: 0,0:53:27.81,0:53:29.25,Default,4,0,0,0,,Mari kita nikmati malam yang panas.
Dialog: 0,0:53:29.75,0:53:30.88,Default,4,0,0,0,,Malam ini
Dialog: 0,0:53:32.02,0:53:34.48,Default,4,0,0,0,,akan menjadi pertama kalinya bagi kami.
Dialogue: 0,0:53:41.62,0:53:42.89,Default,4,0,0,0,,Nah, kalau iya...
Dialog: 0,0:53:52.64,0:53:56.04,Default,4,0,0,0,,Apa yang kamu lakukan? Ayo cepat. Mereka akan memperhatikanmu.
Dialogue: 0,0:53:56.04,0:53:58.94,Default,4,0,0,0,,Tidak pantas bagi seorang raja untuk menyelinap seperti pencuri.
Dialog: 0,0:53:59.48,0:54:00.64,Default,4,0,0,0,,Bodoh sekali.
Dialog: 0,0:54:02.58,0:54:03.98,Default,4,0,0,0,,Apa? Nyonya Istana Choi?
Dialog: 0,0:54:13.99,0:54:16.19,Default,4,0,0,0,,Kita bisa mendapat masalah besar, Yang Mulia.
Dialog: 0,0:54:16.29,0:54:18.59,Default,4,0,0,0,,Bagaimana saya bisa menjadi penguasa yang baik,
Dialog: 0,0:54:18.59,0:54:20.96,Default,4,0,0,0,,jika saya tidak tahu bagaimana kehidupan orang biasa?
Dialog: 0,0:54:20.96,0:54:22.53,Default,4,0,0,0,,Semoga pikiranmu mulia,
Dialogue: 0,0:54:23.00,0:54:24.47,Default,4,0,0,0,,idenya masih terlalu berbahaya.
Dialog: 0,0:54:24.47,0:54:27.24,Default,4,0,0,0,,Aku, tentu saja, siap memberikan hidupku untukmu, tapi tetap saja...
Dialog: 0,0:54:27.24,0:54:28.40,Default,4,0,0,0,,Di mana petanya?
Dialog: 0,0:54:32.08,0:54:34.01,Default,4,0,0,0,,-Kali ini... \N-Plat nama?
Dialogue: 0,0:54:36.58,0:54:38.01,Default,4,0,0,0,,Aku harus menghentikanmu.
Dialog: 0,0:54:38.25,0:54:39.52,Default,4,0,0,0,,Ternyata nama saya
Dialog: 0,0:54:40.28,0:54:41.78,Default,4,0,0,0,,Lee Senman?
Dialogue: 0,0:54:42.85,0:54:44.72,Default,4,0,0,0,,Nama yang menyeramkan sekali?
Dialogue: 0,0:54:45.25,0:54:47.09,Default,4,0,0,0,,Sen sebagai “merenungkan” dan Manusia sebagai “seperti “mencoba”.
Dialogue: 0,0:54:47.09,0:54:50.53,Default,4,0,0,0,,Seorang kontemplator yang berusaha untuk kemaslahatan\N rakyat. Anda tidak dapat memikirkan nama yang lebih baik.
Dialog: 0,0:54:51.46,0:54:54.80,Default,4,0,0,0,,Baiklah, katakanlah. Itu bukan namaku dan tidak apa-apa.
Dialog: 0,0:54:55.30,0:54:57.80,Default,4,0,0,0,,-Kapan jam malam dimulai di sana? \N-Pada jam mouse
Dialog: 0,0:54:57.80,0:54:59.50,Default,4,0,0,0,,penjaga membunyikan bel sebanyak 28 kali,
Dialog: 0,0:54:59.50,0:55:00.90,Default,4,0,0,0,,lalu tutup gerbangnya.
Dialogue: 0,0:55:01.94,0:55:03.91,Default,4,0,0,0,,Loncengnya berbunyi ya?
Dialog: 0,0:55:04.54,0:55:06.54,Default,4,0,0,0,,Pada jam mouse?
Dialog: 0,0:55:08.75,0:55:11.25,Default,4,0,0,0,,Menyebalkan. Saat dimana semua kesenangan dimulai.
Dialog: 0,0:55:12.65,0:55:13.75,Default,4,0,0,0,,Tidak ada.
Dialog: 0,0:55:14.32,0:55:15.95,Default,4,0,0,0,,Saya berjanji akan kembali saat ini.
Dialog: 0,0:55:17.25,0:55:18.32,Default,4,0,0,0,,Yah, tidak.
Dialog: 0,0:55:18.32,0:55:19.92,Default,4,0,0,0,,Saya akan melakukan apa saja,
Dialog: 0,0:55:19.92,0:55:22.09,Default,4,0,0,0,,tapi aku tidak akan membiarkanmu pergi.
Dialog: 0,0:55:33.14,0:55:34.24,Default,4,0,0,0,,Madu.
Dialogue: 0,0:55:35.24,0:55:36.94,Default,4,0,0,0,,Orang macam apa saya ini?
Dialog: 0,0:55:38.37,0:55:40.08,Default,4,0,0,0,,Kamu selalu
Dialog: 0,0:55:41.08,0:55:44.68,Default,4,0,0,0,,baik hati dan ceria.
Dialog: 0,0:55:44.68,0:55:46.92,Default,4,0,0,0,,Sangat ramah
Dialog: 0,0:55:46.92,0:55:48.72,Default,4,0,0,0,,dan selalu sangat tersenyum.
Dialog: 0,0:55:50.35,0:55:52.42,Default,4,0,0,0,,Anda mengerti bahwa saya sebaiknya tahu
Dialog: 0,0:55:52.52,0:55:54.36,Default,4,0,0,0,,kebenaran dari Anda daripada dari orang lain.
Dialog: 0,0:55:55.02,0:55:56.13,Default,4,0,0,0,,Ya.
Dialog: 0,0:55:57.66,0:55:58.79,Default,4,0,0,0,,Oke.
Dialog: 0,0:56:02.00,0:56:04.40,Default,4,0,0,0,,Jadi, saat Anda sedang membaca buku.
Dialog: 0,0:56:10.91,0:56:13.44,Default,4,0,0,0,,Sangat mustahil untuk membaca di sini!
Dialogue: 0,0:56:14.74,0:56:16.95,Default,4,0,0,0,,Nafasmu berisik sekali,
Dialog: 0,0:56:16.95,0:56:19.18,Default,4,0,0,0,,bahwa aku akan segera menjadi tuli!
Dialog: 0,0:56:20.52,0:56:23.79,Default,4,0,0,0,,Kemarilah! Bawa dia pergi dan pukul dia dengan baik!
Dialog: 0,0:56:24.15,0:56:26.22,Default,4,0,0,0,,Saya mempunyai masalah yang sudah berlangsung lama dengan hidung saya.
Dialog: 0,0:56:26.22,0:56:27.49,Default,4,0,0,0,,Kasihanilah, Yang Mulia!
Dialog: 0,0:56:27.49,0:56:28.79,Default,4,0,0,0,,Ayo berangkat.
Dialogue: 0,0:56:42.47,0:56:45.04,Default,4,0,0,0,,Kamu salah satu nada keempat.
Dialogue: 0,0:56:45.88,0:56:48.08,Default,4,0,0,0,,Apakah ada beruang yang menginjak telingamu atau bagaimana?
Dialog: 0,0:56:48.41,0:56:49.98,Default,4,0,0,0,,Dan kamu masih menyebut dirimu seorang guru?
Dialog: 0,0:56:51.58,0:56:52.68,Default,4,0,0,0,,Kemarilah!
Dialog: 0,0:56:53.55,0:56:55.22,Default,4,0,0,0,,Cambuk si bodoh ini!
Dialog: 0,0:56:56.55,0:56:58.05,Default,4,0,0,0,,Benarkah? Tidak mungkin!
Dialog: 0,0:57:01.46,0:57:02.63,Default,4,0,0,0,,Apakah itu lucu bagimu?
Dialog: 0,0:57:03.39,0:57:05.60,Default,4,0,0,0,,Rupanya, tidak ada yang bisa dilakukan.
Dialog: 0,0:57:06.66,0:57:09.70,Default,4,0,0,0,,Kemarilah! Singkirkan keduanya dan pukul mereka dengan baik!
Dialog: 0,0:57:10.43,0:57:11.60,Default,4,0,0,0,,Hanya menarik napas
Dialog: 0,0:57:11.60,0:57:13.07,Default,4,0,0,0,,dan kamu sudah kehilangan kesabaran.
Dialogue: 0,0:57:13.07,0:57:14.07,Default,4,0,0,0,,Ada baiknya memakai parfum,
Dialog: 0,0:57:14.07,0:57:15.34,Default,4,0,0,0,,dituduh mencoba merayu raja.
Dialog: 0,0:57:15.34,0:57:16.74,Default,4,0,0,0,,Kami berjalan dengan berisik - itu buruk,
Dialog: 0,0:57:16.74,0:57:18.37,Default,4,0,0,0,,berjalan tanpa suara bahkan lebih buruk lagi.
Dialog: 0,0:57:18.37,0:57:19.94,Default,4,0,0,0,,Kamu akan selalu menemukan sesuatu untuk dikeluhkan.
Dialogue: 0,0:57:19.94,0:57:23.18,Default,4,0,0,0,,Setiap hal kecil membuatmu marah.
Dialogue: 0,0:57:23.61,0:57:26.58,Default,4,0,0,0,,Itu sebabnya mereka menyebutmu ular beludak.
Dialog: 0,0:57:31.65,0:57:32.82,Default,4,0,0,0,,Oh, maaf.
Dialog: 0,0:57:34.22,0:57:36.06,Default,4,0,0,0,,Saya hanya ingin memberi tahu Anda detailnya,
Dialog: 0,0:57:36.06,0:57:37.59,Default,4,0,0,0,,tapi saya sedikit terbawa suasana.
Dialog: 0,0:57:37.99,0:57:41.10,Default,4,0,0,0,,Sepertinya banyak orang yang ingin menenggelamkan gadis ini.
Dialog: 0,0:57:41.73,0:57:43.67,Default,4,0,0,0,,Jadi itu sebabnya para dayang istana...
Dialog: 0,0:57:44.53,0:57:46.90,Default,4,0,0,0,,Mereka hanya tidak tahu seperti apa dirimu sebenarnya.
Dialog: 0,0:57:48.07,0:57:49.31,Default,4,0,0,0,,Tahukah kamu?
Dialog: 0,0:57:49.71,0:57:50.91,Default,4,0,0,0,,Tentu saja.
Dialog: 0,0:57:51.14,0:57:54.14,Default,4,0,0,0,,Saya telah melayani Anda sejak kecil.
Dialogue: 0,0:57:54.48,0:57:56.48,Default,4,0,0,0,,Dan aku tahu kamu mempunyai hati yang baik.
Dialog: 0,0:57:56.88,0:57:58.51,Default,4,0,0,0,,Dan bahwa kamu pintar melampaui usiamu.
Dialogue: 0,0:57:58.51,0:58:00.95,Default,4,0,0,0,,Dan karena pola pikirmu sudah ditetapkan,\Nkamu pasti akan mencapai tujuanmu.
Dialog: 0,0:58:00.95,0:58:02.32,Default,4,0,0,0,,Anda adalah contoh bagi saya.
Dialog: 0,0:58:04.52,0:58:07.76,Default,4,0,0,0,,Meskipun di istana sering kali kamu merasa kesepian.
Dialog: 0,0:58:08.76,0:58:12.83,Default,4,0,0,0,,Bagaimanapun, Yang Mulia mengincar setiap rok.
Dialogue: 0,0:58:15.23,0:58:17.47,Default,4,0,0,0,,Wanita ini tidak begitu kesepian.
Dialog: 0,0:58:18.47,0:58:20.50,Default,4,0,0,0,,Karena ada orang di dekatnya yang sangat memahaminya.
Dialog: 0,0:58:21.24,0:58:22.94,Default,4,0,0,0,,Nyonya?
Dialogue: 0,0:58:23.04,0:58:26.18,Default,4,0,0,0,,Artinya kau mencerahkan kesepianku.
Dialog: 0,0:58:28.34,0:58:29.61,Default,4,0,0,0,,Apa yang kamu bicarakan.
Dialog: 0,0:58:32.55,0:58:35.18,Default,5,0,0,0,,Jangan khawatir, Hongyeon. Dapatkan tidur malam yang nyenyak.
Dialog: 0,0:58:35.75,0:58:38.99,Default,5,0,0,0,,Demi Anda, saya akan berusaha untuk tidak ketahuan.
Dialog: 0,0:58:41.09,0:58:43.06,Default,5,0,0,0,,Aku akan membunuh kalian semua!
Dialogue: 0,0:58:43.80,0:58:46.07,Default,5,0,0,0,,Lebih baik ambil pandangan yang lain, bajingan!
Dialog: 0,0:58:46.33,0:58:50.04,Default,5,0,0,0,,Aku tidak akan membiarkanmu mengambil istri dan anakku seperti budak!
Dialog: 0,0:58:50.64,0:58:51.84,Default,5,0,0,0,,Jika Anda tidak membayar pajak,
Dialog: 0,0:58:51.84,0:58:53.34,Default,5,0,0,0,,lalu berikan kepada kami!
Dialogue: 0,0:58:53.34,0:58:54.97,Default,5,0,0,0,,Bajingan ini pendosa!
Dialogue: 0,0:58:54.97,0:58:56.73,Default,5,0,0,0,,Satu-satunya dosaku adalah
Dialog: 0,0:58:56.98,0:59:01.31,Default,5,0,0,0,,biarkan seorang anak hidup di dunia yang mengerikan!
Dialogue: 0,0:59:05.22,0:59:06.92,Default,5,0,0,0,,Jangan mendekat! Jangan mendekatiku.
Dialogue: 0,0:59:07.49,0:59:10.19,Default,5,0,0,0,,Orang gila ini bersalah atas pengkhianatan!
Dialog: 0,0:59:10.19,0:59:12.46,Default,5,0,0,0,,Jika membunuh bajingan sepertimu adalah pengkhianatan, aku akan melakukannya.
Dialog: 0,0:59:12.46,0:59:14.63,Default,5,0,0,0,,Ya! Saya akan dengan senang hati melakukan ini!
Dialog: 0,0:59:15.39,0:59:16.73,Default,5,0,0,0,,Sayang!
Dialog: 0,0:59:19.43,0:59:21.07,Default,5,0,0,0,,Jangan lakukan ini.
Dialogue: 0,0:59:22.27,0:59:24.00,Default,5,0,0,0,,Aku tahu kamu kesal.
Dialogue: 0,0:59:25.67,0:59:28.90,Default,5,0,0,0,,Bajingan ini ingin kita mati.
Dialog: 0,0:59:29.34,0:59:31.34,Default,5,0,0,0,,Mengapa saya harus berhenti?
Dialog: 0,0:59:33.81,0:59:34.94,Default,5,0,0,0,,Damhyan.
Dialog: 0,0:59:42.59,0:59:46.42,Default,5,0,0,0,,Beri jalan! Minggir! Beri jalan!
Dialog: 0,0:59:49.26,0:59:50.92,Default,5,0,0,0,,Apa yang terjadi di sini.
Dialog: 0,0:59:51.36,0:59:52.59,Default,5,0,0,0,,Apa yang harus kita lakukan?
Dialog: 0,1:00:18.36,1:00:20.63,Default,5,0,0,0,,Ayah, kamu kembali.
Dialog: 0,1:00:20.86,1:00:23.15,Default,5,0,0,0,,Ya, bagaimana perjalananmu?
Dialog: 0,1:00:24.13,1:00:26.17,Default,5,0,0,0,,Maaf saya melewatkannya
Dialogue: 0,1:00:26.17,1:00:27.36,Default,5,0,0,0,,suatu peristiwa yang menggembirakan.
Dialog: 0,1:00:28.07,1:00:29.84,Default,5,0,0,0,,Sudahkah Anda mengambil keputusan?
Dialogue: 0,1:00:29.84,1:00:31.69,Default,5,0,0,0,,Kamu condong ke arah mana?
Dialog: 0,1:00:32.81,1:00:34.94,Default,5,0,0,0,,Saya memutuskan untuk mengikuti impian saya.
Dialog: 0,1:00:35.67,1:00:38.44,Default,5,0,0,0,,Tapi seberapa jauh saya akan melangkah, saya belum tahu.
Dialog: 0,1:00:38.68,1:00:40.00,Default,5,0,0,0,,Seberapa jauh?
Dialog: 0,1:00:43.08,1:00:44.17,Default,5,0,0,0,,Benar.
Dialog: 0,1:00:44.62,1:00:46.94,Default,5,0,0,0,,Saya percaya padamu dan tidak akan membuatmu terburu-buru.
Dialog: 0,1:00:47.79,1:00:51.71,Default,5,0,0,0,,Tapi sesuatu terjadi saat kamu tidak ada.
Dialog: 0,1:00:52.32,1:00:54.73,Default,5,0,0,0,,Ratu jatuh ke danau
Dialog: 0,1:00:54.73,1:00:56.59,Default,5,0,0,0,,malam sebelum pernikahan.
Dialog: 0,1:00:57.26,1:01:00.33,Default,5,0,0,0,,Dia tidak sadarkan diri sepanjang hari,
Dialog: 0,1:01:00.33,1:01:02.77,Default,5,0,0,0,,jadi pernikahannya terpaksa ditunda.
Dialog: 0,1:01:03.04,1:01:04.86,Default,5,0,0,0,,Bagaimana kabar Yang Mulia sekarang?
Dialog: 0,1:01:05.00,1:01:06.71,Default,5,0,0,0,,Apakah dia baik-baik saja?
Dialog: 0,1:01:17.88,1:01:19.07,Default,5,0,0,0,,Berhenti!
Dialog: 0,1:01:24.96,1:01:26.92,Default,5,0,0,0,,Aku belum pernah melihatmu sebelumnya.
Dialog: 0,1:01:27.39,1:01:29.96,Default,5,0,0,0,,Dilihat dari caramu melihat sekeliling...
Dialog: 0,1:01:30.70,1:01:33.17,Default,5,0,0,0,,-Yah...\N-Pertama kali di istana?
Dialog: 0,1:01:33.17,1:01:34.63,Default,5,0,0,0,,Rupanya hilang.
Dialog: 0,1:01:35.97,1:01:37.54,Default,5,0,0,0,,Saya juga tersesat untuk pertama kalinya.
Dialog: 0,1:01:37.77,1:01:38.90,Default,5,0,0,0,,Benar.
Dialog: 0,1:01:45.11,1:01:47.81,Default,5,0,0,0,,Tapi entah kenapa kamu terlihat familier.
Dialogue: 0,1:01:51.78,1:01:53.35,Default,5,0,0,0,,Pakaian mahal
Dialog: 0,1:01:53.35,1:01:56.38,Default,5,0,0,0,,dan kepercayaan diri yang tak tergoyahkan.
Dialog: 0,1:01:58.22,1:01:59.56,Default,5,0,0,0,,Harus dari keluarga bangsawan.
Dialog: 0,1:02:00.16,1:02:02.15,Default,5,0,0,0,,Saya akan mengatakan hal yang sama.
Dialog: 0,1:02:02.46,1:02:04.70,Default,5,0,0,0,,Kamu adalah putra terkenal itu.
Dialog: 0,1:02:04.70,1:02:06.50,Default,5,0,0,0,,Menarik dan dari keluarga terhormat.
Dialog: 0,1:02:06.50,1:02:08.03,Default,5,0,0,0,,Cerdas dan berbakat.
Dialog: 0,1:02:08.03,1:02:10.07,Default,5,0,0,0,,Saya pernah mendengar tentang Anda. Namamu...
Dialog: 0,1:02:10.07,1:02:11.19,Default,5,0,0,0,,Kim Hwan
Dialog: 0,1:02:11.90,1:02:13.81,Default,5,0,0,0,,dari keluarga Andon Kim.
Dialog: 0,1:02:14.14,1:02:15.64,Default,5,0,0,0,,Ini dia, kerabatnya.
Dialog: 0,1:02:15.64,1:02:17.27,Default,5,0,0,0,,Apakah saya begitu terkenal?
Dialog: 0,1:02:18.51,1:02:19.98,Default,5,0,0,0,,Tentu saja.
Dialog: 0,1:02:20.21,1:02:22.71,Default,5,0,0,0,,Tanya siapa pun di jalan: semua orang tahu.
Dialog: 0,1:02:23.15,1:02:25.25,Default,5,0,0,0,,Suatu kehormatan bertemu dengan Anda.
Dialog: 0,1:02:25.52,1:02:27.34,Default,5,0,0,0,,Aku juga hendak pergi.
Dialog: 0,1:02:27.52,1:02:28.71,Default,5,0,0,0,,Ayo pergi bersama.
Dialog: 0,1:02:29.42,1:02:31.48,Default,5,0,0,0,,Saya datang dari sisi lain.
Dialog: 0,1:02:31.89,1:02:33.46,Default,5,0,0,0,,Gelap, jadi saya bingung.
Dialog: 0,1:02:39.73,1:02:41.36,Default,5,0,0,0,,Meniup dan dia terbunuh.
Dialog: 0,1:02:42.50,1:02:44.57,Default,5,0,0,0,,Bagaimana kamu bisa banyak bicara?
Dialog: 0,1:02:44.57,1:02:46.01,Default,5,0,0,0,,Dia tidak berhenti sejenak.
Dialogue: 0,1:02:46.01,1:02:48.96,Default,5,0,0,0,,Makanya agak menyeramkan di sini.
Dialog: 0,1:02:49.48,1:02:54.17,Default,5,0,0,0,,Dan itulah sebabnya Yang Mulia mengalami mimpi buruk setiap malam.
Dialog: 0,1:02:55.11,1:02:56.25,Default,5,0,0,0,,Mimpi buruk?
Dialog: 0,1:02:57.45,1:03:00.65,Default,5,0,0,0,,Sejak Yang Mulia kembali dari Ganghwa,
Dialog: 0,1:03:00.65,1:03:03.12,Default,5,0,0,0,,dia mengalami mimpi buruk yang sama setiap malam.
Dialog: 0,1:03:03.12,1:03:04.32,Default,5,0,0,0,,Tentang,
Dialog: 0,1:03:04.96,1:03:07.63,Default,5,0,0,0,,bagaimana dia dituduh melakukan makar
Dialog: 0,1:03:07.93,1:03:09.15,Default,5,0,0,0,,dan dipenggal.
Dialog: 0,1:03:14.80,1:03:16.14,Default,5,0,0,0,,Kami mohon maaf karena tidak mengetahuinya.
Dialog: 0,1:03:16.14,1:03:18.86,Default,5,0,0,0,,Tidak menakutkan. Begitu banyak orang\N melewati gerbang ini.
Dialog: 0,1:03:21.37,1:03:22.77,Default,5,0,0,0,,Lee Senman
Dialog: 0,1:03:30.68,1:03:33.25,Default,5,0,0,0,,Pada kesempatan perkenalan kita, saya ingin
Dialog: 0,1:03:33.25,1:03:35.45,Default,5,0,0,0,,kunjungi rumah Kisen.
Dialog: 0,1:03:35.45,1:03:36.82,Default,5,0,0,0,,Mana yang terbaik?
Dialog: 0,1:03:37.46,1:03:40.42,Default,5,0,0,0,,Oktajeong. Yang ini yang terbaik.
Dialog: 0,1:03:41.26,1:03:43.80,Default,5,0,0,0,,Gadis-gadis tertawa seperti ini,
Dialog: 0,1:03:43.80,1:03:46.96,Default,5,0,0,0,,ketika Anda menyebutkan tablet giok. Oleh karena itu, Oktjeong.
Dialog: 0,1:03:49.10,1:03:50.57,Default,5,0,0,0,,Tunjukkan jalannya.
Dialog: 0,1:03:50.77,1:03:52.44,Default,5,0,0,0,,Lihat betapa terangnya bulan.
Dialogue: 0,1:03:52.44,1:03:55.04,Default,5,0,0,0,,Malam yang menyenangkan untuk bersenang-senang.
Dialog: 0,1:03:57.58,1:03:58.73,Default,5,0,0,0,,Di Sini.
Dialog: 0,1:03:59.01,1:04:00.11,Default,5,0,0,0,,Ayo pergi.
Dialog: 0,1:04:00.51,1:04:02.48,Default,5,0,0,0,,-Pekerjaan mudah.\N-Ya.
Dialog: 0,1:04:04.28,1:04:06.69,Default,5,0,0,0,,Sepertinya kita seumuran,
Dialog: 0,1:04:06.89,1:04:10.75,Default,5,0,0,0,,dan hobi kami serupa. Aku sangat senang kita bertemu.
Dialog: 0,1:04:11.22,1:04:14.79,Default,5,0,0,0,,Oh ya. Kamu belum memberitahuku namamu.
Dialog: 0,1:04:14.93,1:04:16.06,Default,5,0,0,0,,Siapa namamu?
Dialog: 0,1:04:16.43,1:04:18.06,Default,5,0,0,0,,Saya Lee Senman.
Dialog: 0,1:04:22.90,1:04:26.67,Default,5,0,0,0,,Lee Seng-man sebagai "Pecundang dalam hidup ini."
Dialogue: 0,1:04:31.14,1:04:32.27,Default,5,0,0,0,,Jangan salahkan aku!
Dialog: 0,1:04:37.85,1:04:39.48,Default,5,0,0,0,,Siapa namamu?
Dialog: 0,1:04:42.09,1:04:43.38,Default,5,0,0,0,,Ya, itu saja.
Dialog: 0,1:04:49.16,1:04:51.32,Default,5,0,0,0,,Maafkan saya.
Dialog: 0,1:05:00.74,1:05:02.67,Default,5,0,0,0,,Kamu seorang wanita.
Dialog: 0,1:05:03.34,1:05:05.58,Default,5,0,0,0,,Apa yang kamu bicarakan? Saya pastinya seorang laki-laki.
Dialog: 0,1:05:05.58,1:05:09.52,Default,5,0,0,0,,Kami tidak melayani wanita.
Dialog: 0,1:05:16.09,1:05:20.02,Default,5,0,0,0,,Anak-anak, sapa tuan muda!
Dialog: 0,1:05:40.85,1:05:42.21,Default,5,0,0,0,,Itu dia!
Dialog: 0,1:05:48.05,1:05:50.59,Default,5,0,0,0,,Suatu kehormatan besar bertemu dengan Anda.
Dialog: 0,1:05:58.63,1:06:00.86,Default,5,0,0,0,,Biarkan aku menuangkanmu...
Dialog: 0,1:06:06.11,1:06:08.86,Default,5,0,0,0,,Saya tidak minum lebih dari tiga cangkir anggur sehari.
Dialog: 0,1:06:09.31,1:06:10.78,Default,5,0,0,0,,Saya sudah minum dua,
Dialog: 0,1:06:10.78,1:06:13.67,Default,5,0,0,0,,dan saya ingin berbagi yang terakhir dengan teman saya.
Dialog: 0,1:06:15.71,1:06:18.17,Default,5,0,0,0,,Dia tidak mengubah keputusan.
Dialog: 0,1:06:20.35,1:06:24.46,Default,5,0,0,0,,Putranya baru saja lulus ujian resmi.
Dialog: 0,1:06:25.19,1:06:26.42,Default,5,0,0,0,,Selamat.
Dialog: 0,1:06:26.73,1:06:29.39,Default,5,0,0,0,,Meskipun dia mampu,
Dialog: 0,1:06:29.39,1:06:31.90,Default,5,0,0,0,,dia tidak bisa mendapatkan tempat yang bagus di Hanyang.
Dialog: 0,1:06:32.83,1:06:35.60,Default,5,0,0,0,,Jika Anda dapat membantunya, saya dengan senang hati akan membayar Anda,
Dialog: 0,1:06:35.60,1:06:37.90,Default,5,0,0,0,,selama yang Anda katakan.
Dialog: 0,1:06:39.84,1:06:41.77,Default,5,0,0,0,,Anda meminta saya untuk menjual
Dialog: 0,1:06:41.97,1:06:44.94,Default,5,0,0,0,,tempat pejabat pemerintah demi uang?
Dialogue: 0,1:06:45.18,1:06:47.44,Default,5,0,0,0,,Yah, maksudku...
Dialog: 0,1:06:48.11,1:06:50.75,Default,5,0,0,0,,Saya hanya ingin mengucapkan terima kasih.
Dialog: 0,1:06:50.75,1:06:54.42,Default,5,0,0,0,,Saya tahu anak Anda sudah lama lulus ujian.
Dialog: 0,1:06:55.15,1:06:57.48,Default,5,0,0,0,,-Kenapa kamu datang sekarang?\N-Yah, aku...
Dialog: 0,1:07:00.73,1:07:03.36,Default,5,0,0,0,,Anda pertama kali menghubungi keluarga Pungyang Cho.
Dialog: 0,1:07:05.63,1:07:10.17,Default,5,0,0,0,,Istri saya adalah kerabat jauh mereka.
Dialog: 0,1:07:10.17,1:07:11.90,Default,5,0,0,0,,Maafkan saya.
Dialog: 0,1:07:23.48,1:07:25.85,Default,5,0,0,0,,Saya memahami perasaan Anda
Dialog: 0,1:07:25.85,1:07:28.22,Default,5,0,0,0,,tentang putramu yang cerdas dan cakap yang tidak bisa
Dialog: 0,1:07:28.22,1:07:30.49,Default,5,0,0,0,,capai apa yang kamu inginkan karena kesalahan keluarga.
Dialog: 0,1:07:31.52,1:07:35.45,Default,5,0,0,0,,Aku akan membantunya membersihkan namanya dan menjadi sekretaris raja.
Dialog: 0,1:07:36.26,1:07:37.49,Default,5,0,0,0,,Sekretaris Kerajaan?
Dialog: 0,1:07:38.03,1:07:41.20,Default,5,0,0,0,,Terima kasih. Terima kasih banyak!
Dialog: 0,1:07:41.43,1:07:42.79,Default,5,0,0,0,,Dan Anda tidak perlu membayar saya.
Dialog: 0,1:07:43.54,1:07:46.70,Default,5,0,0,0,,Saya butuh teman sebagai balasannya.
Dialog: 0,1:07:48.24,1:07:50.17,Default,5,0,0,0,,Orang yang akan siap memberikan nyawanya untukku.
Dialog: 0,1:07:52.18,1:07:55.85,Default,5,0,0,0,,Mulai sekarang, seluruh keluargaku akan menjadi
Dialog: 0,1:07:55.85,1:07:57.78,Default,5,0,0,0,,Dengan senang hati saya melayani Anda, Pak.
Dialogue: 0,1:08:02.96,1:08:04.69,Default,5,0,0,0,,Tuangkan aku anggur.
Dialog: 0,1:08:05.02,1:08:06.89,Default,5,0,0,0,,Sekarang kita berteman.
Dialog: 0,1:08:06.89,1:08:09.95,Default,5,0,0,0,,Ya! Terima kasih.
Dialog: 0,1:08:19.50,1:08:22.41,Default,5,0,0,0,,Sekarang ayo berangkat!
Dialog: 0,1:08:23.94,1:08:26.54,Default,5,0,0,0,,Kita akan minum sampai terjatuh.
Dialog: 0,1:08:26.55,1:08:29.31,Default,5,0,0,0,,Mari kita hilangkan kekhawatiran kita dan bersenang-senang!
Dialog: 0,1:08:31.92,1:08:33.21,Default,5,0,0,0,,Pria wanita!
Dialog: 0,1:08:33.42,1:08:35.45,Default,5,0,0,0,,Dan jangan lupakan aku!
Dialog: 0,1:08:35.65,1:08:38.16,Default,5,0,0,0,,-Bagus sekali!\N-Lihat di sini!
Dialog: 0,1:08:38.16,1:08:39.95,Default,5,0,0,0,,Ini, minum.
Dialog: 0,1:08:40.39,1:08:42.19,Default,5,0,0,0,,-Hal lain.\N-Oke.
Dialog: 0,1:08:42.19,1:08:44.20,Default,6,0,0,0,,Tuan!
Dialog: 0,1:08:45.73,1:08:47.62,Default,6,0,0,0,,Kamu sangat tampan!
Dialog: 0,1:08:48.83,1:08:54.31,Default,6,0,0,0,,Dan siapa di antara kalian yang akan mendapat kehormatan
Dialog: 0,1:08:54.31,1:08:56.67,Default,6,0,0,0,,maukah kamu menanggalkan pakaianku di malam hari?
Dialog: 0,1:09:04.32,1:09:06.08,Default,6,0,0,0,,Aku sudah menjadi kucing selama 20 tahun,
Dialog: 0,1:09:06.59,1:09:09.99,Default,6,0,0,0,,dan aku belum pernah bertemu orang mesum seperti itu.
Dialog: 0,1:09:11.19,1:09:14.92,Default,6,0,0,0,,-Ini, minumlah.\N-Ayo, terserah.
Dialog: 0,1:09:32.14,1:09:34.15,Default,6,0,0,0,,Ini buruk.
Dialog: 0,1:09:36.38,1:09:40.21,Default,6,0,0,0,,Aku tidak percaya di tempat seperti ini\N kita minum sendirian.
Dialog: 0,1:09:41.25,1:09:43.75,Default,6,0,0,0,,Ini bukan waktunya mengeluh tentang ini.
Dialog: 0,1:09:43.79,1:09:46.75,Default,6,0,0,0,,Kami pikir dia ada di brankas rahasia, tapi ternyata kosong.
Dialog: 0,1:09:46.99,1:09:49.13,Default,6,0,0,0,,Maka hanya ada satu pilihan yang tersisa.
Dialog: 0,1:09:49.13,1:09:50.36,Default,6,0,0,0,,Di rumah ayah ratu.
Dialog: 0,1:09:50.36,1:09:54.37,Default,6,0,0,0,,Tetapi mereka ingin mengangkatnya menjadi komandan pengawal kerajaan,
Dialog: 0,1:09:54.47,1:09:56.20,Default,6,0,0,0,,yang berarti akan lebih sulit lagi untuk melewatinya.
Dialog: 0,1:09:56.37,1:09:58.09,Default,6,0,0,0,,Mereka ingin mengendalikan pengawal kerajaan,
Dialog: 0,1:09:58.44,1:10:00.94,Default,6,0,0,0,,sehingga nyawa raja ada di tangan mereka.
Dialog: 0,1:10:00.94,1:10:04.61,Default,6,0,0,0,,Maka penjaga yang menyamar akan segera terungkap.
Dialog: 0,1:10:04.61,1:10:07.87,Default,6,0,0,0,,Ya? Ini adalah situasi yang sangat berbahaya.
Dialog: 0,1:10:08.31,1:10:11.18,Default,6,0,0,0,,Jika mereka tertangkap dan dibubarkan, maka
Dialog: 0,1:10:11.18,1:10:13.55,Default,6,0,0,0,,mengejar \Npejabat korup di malam hari
Dialog: 0,1:10:13.55,1:10:15.79,Default,6,0,0,0,,dan menelusuri penyimpanan\N untuk mencari buku akuntansi
Dialog: 0,1:10:15.79,1:10:17.86,Default,6,0,0,0,,Anda dan saya harus melakukannya.
Dialog: 0,1:10:17.86,1:10:19.22,Default,6,0,0,0,,Artinya, pada siang hari saya akan menjadi pejabat,
Dialog: 0,1:10:19.22,1:10:20.29,Default,6,0,0,0,,dan di malam hari sebagai tentara bayaran?
Dialogue: 0,1:10:20.29,1:10:23.08,Default,6,0,0,0,,Ya, aku jadi gila karena terlalu memaksakan diri.
Dialog: 0,1:10:26.37,1:10:29.96,Default,6,0,0,0,,Anda memanggil saya dari Ganghwado untuk membajak seperti kuda?
Dialog: 0,1:10:33.14,1:10:34.84,Default,6,0,0,0,,Dalam perjalanan ke Hanyang
Dialog: 0,1:10:34.84,1:10:38.48,Default,6,0,0,0,,Saya penuh dengan ambisi dan impian besar.
Dialog: 0,1:10:39.61,1:10:42.95,Default,6,0,0,0,,"Saya akan menggunakan teman dan berhasil."
Dialog: 0,1:10:45.18,1:10:48.35,Default,6,0,0,0,,Saya berkata bahwa saya ingin menyelamatkan negara kita yang membusuk dan korup,
Dialog: 0,1:10:48.35,1:10:50.56,Default,6,0,0,0,,dan Anda memutuskan untuk mengikutinya.
Dialog: 0,1:10:51.76,1:10:53.96,Default,6,0,0,0,,Anda tidak mengatakan itu.
Dialog: 0,1:10:53.96,1:10:56.83,Default,6,0,0,0,,Mereka terus-menerus membicarakan Khanyan, jadi saya bertanya.
Dialog: 0,1:10:57.06,1:10:59.20,Default,6,0,0,0,,Dan inilah jawaban Anda:
Dialog: 0,1:11:03.44,1:11:05.29,Default,6,0,0,0,,Mengapa di Hanyang?
Dialog: 0,1:11:09.17,1:11:13.50,Default,6,0,0,0,,Joseon membusuk. Saya ingin memberi pelajaran pada bajingan ini!
Dialog: 0,1:11:20.09,1:11:21.32,Default,6,0,0,0,,Benar.
Dialog: 0,1:11:22.82,1:11:25.09,Default,6,0,0,0,,Kedengarannya bagus,
Dialog: 0,1:11:25.09,1:11:27.06,Default,6,0,0,0,,tapi aku tidak tahu kalau aku harus membungkukkan punggungku seperti itu.
Dialog: 0,1:11:27.06,1:11:30.90,Default,6,0,0,0,,Saya idiot.
Dialog: 0,1:11:32.73,1:11:34.79,Default,6,0,0,0,,Apakah menurut Anda Anda sudah banyak berubah?
Dialog: 0,1:11:40.57,1:11:43.48,Default,6,0,0,0,,Mungkin mereka ingin mengambil kendali para penjaga,
Dialog: 0,1:11:43.48,1:11:45.24,Default,6,0,0,0,,karena mereka mengerti apa yang kami lakukan?
Dialog: 0,1:11:45.34,1:11:46.45,Default,6,0,0,0,,Ayo.
Dialog: 0,1:11:46.45,1:11:48.35,Default,6,0,0,0,,Jika itu masalahnya, mereka akan mengirim seseorang ke sini
Dialog: 0,1:11:48.35,1:11:49.95,Default,6,0,0,0,,dengarkan kami.
Dialog: 0,1:11:50.45,1:11:51.65,Default,6,0,0,0,,Tepat.
Dialog: 0,1:11:59.79,1:12:01.53,Default,6,0,0,0,,Tendangan tidak nyaman.
Dialog: 0,1:12:10.34,1:12:12.70,Default,6,0,0,0,,Di mana toiletnya?
Dialog: 0,1:12:17.18,1:12:18.81,Default,6,0,0,0,,Dan ini dia.
Dialog: 0,1:12:24.82,1:12:28.15,Default,6,0,0,0,,(Toilet wanita, toilet pria)
Dialog: 0,1:12:36.66,1:12:37.79,Default,6,0,0,0,,Hah?
Dialog: 0,1:12:51.18,1:12:52.63,Default,6,0,0,0,,Hei.
Dialog: 0,1:12:54.85,1:12:56.00,Default,6,0,0,0,,Aku iri padamu.
Dialog: 0,1:12:56.92,1:12:58.98,Default,6,0,0,0,,Saya juga memilikinya.
Dialog: 0,1:12:59.72,1:13:03.21,Default,6,0,0,0,,Dan sekarang hilang.
Dialog: 0,1:13:05.29,1:13:07.75,Default,6,0,0,0,,Selamat tinggal, nagaku.
Dialog: 0,1:13:08.23,1:13:10.75,Default,6,0,0,0,,Sampai jumpa, naga.
Dialog: 0,1:13:14.53,1:13:16.63,Default,6,0,0,0,,Aku bahkan tidak bisa buang air sambil berdiri.
Dialog: 0,1:13:18.37,1:13:21.47,Default,6,0,0,0,,Dunia babi, kesenangan seperti itu hanya tersedia bagi mereka yang memilikinya.
Dialog: 0,1:13:22.54,1:13:25.81,Default,6,0,0,0,,Sedih sekali, saya benar-benar tidak ingin menulis.
Dialogue: 0,1:13:26.14,1:13:27.84,Default,6,0,0,0,,Bahkan air mata sudah mengering.
Dialog: 0,1:13:42.93,1:13:45.09,Default,6,0,0,0,,Dan naga itu hilang.
Dialog: 0,1:13:45.70,1:13:47.53,Default,6,0,0,0,,Dan bola naga juga.
Dialogue: 0,1:13:48.93,1:13:51.09,Default,6,0,0,0,,Lebih mudah untuk mati.
Dialog: 0,1:13:52.10,1:13:54.94,Default,6,0,0,0,,Kekejaman. Mengapa ini terjadi pada saya? Untuk apa?
Dialogue: 0,1:13:57.11,1:13:58.67,Default,6,0,0,0,,-Tuang segelas.\N-Ini.
Dialog: 0,1:14:02.81,1:14:04.28,Default,6,0,0,0,,Keren sekali.
Dialog: 0,1:14:10.19,1:14:11.36,Default,6,0,0,0,,Hah?
Dialog: 0,1:14:12.59,1:14:14.26,Default,6,0,0,0,,Apakah menurut Anda mereka menyadari darah itu
Dialog: 0,1:14:14.26,1:14:16.90,Default,6,0,0,0,,apakah sebenarnya ada babi di ranjang pernikahan?
Dialog: 0,1:14:17.03,1:14:19.63,Default,6,0,0,0,,Karena mereka ingin memberikan posisi ini kepada ayah ratu,
Dialog: 0,1:14:19.63,1:14:22.92,Default,6,0,0,0,,yang berarti mereka tidak tahu tentang kita.
Dialog: 0,1:14:23.17,1:14:24.53,Default,6,0,0,0,,Lainnya
Dialog: 0,1:14:25.57,1:14:28.13,Default,6,0,0,0,,kepalamu pasti sudah tergeletak di tanah.
Dialog: 0,1:14:31.14,1:14:32.74,Default,6,0,0,0,,Lalu kenapa tiba-tiba...
Dialog: 0,1:14:32.74,1:14:34.61,Default,6,0,0,0,,Yang berubah hanyalah ratu
Dialog: 0,1:14:34.61,1:14:36.37,Default,6,0,0,0,,dan selir kerajaan bersama di istana.
Dialogue: 0,1:14:37.62,1:14:40.12,Default,6,0,0,0,,Sang Ratu ingin tetap mengendalikannya.
Dialog: 0,1:14:41.95,1:14:45.75,Default,6,0,0,0,,Menaruh pedang di leher suaminya segera setelah pernikahan?
Dialog: 0,1:14:46.79,1:14:48.69,Default,6,0,0,0,,Gadis menyeramkan.
Dialog: 0,1:14:49.36,1:14:50.90,Default,6,0,0,0,,Mengingat apa yang terjadi,
Dialog: 0,1:14:50.90,1:14:52.83,Default,6,0,0,0,,Anda harus berhenti mencari sebentar.
Dialog: 0,1:14:53.16,1:14:54.57,Default,6,0,0,0,,Kami sedang bersiap-siap
Dialog: 0,1:14:54.57,1:14:56.77,Default,6,0,0,0,,untuk perang yang benar melawan pihak berwenang.
Dialog: 0,1:14:56.87,1:15:00.07,Default,6,0,0,0,,Satu-satunya cara untuk menghukum mereka adalah
Dialog: 0,1:15:00.21,1:15:04.17,Default,6,0,0,0,,temukan makalah yang mengkonfirmasi korupsi.
Dialog: 0,1:15:05.68,1:15:08.41,Default,6,0,0,0,,Mereka menggunakan sistem entri ganda, kami tidak bisa
Dialog: 0,1:15:09.01,1:15:10.37,Default,6,0,0,0,,menunda pencarian buku.
Dialogue: 0,1:15:10.58,1:15:12.48,Default,6,0,0,0,,Lalu apa yang harus kita lakukan?
Dialog: 0,1:15:12.72,1:15:15.58,Default,6,0,0,0,,Biarkan dia mengambil posisi komandan pengawal kerajaan.
Dialog: 0,1:15:16.62,1:15:18.09,Default,6,0,0,0,,-Tapi!\N-Jika kita melempar umpan,
Dialog: 0,1:15:18.09,1:15:19.42,Default,6,0,0,0,,mereka akan menyerangnya
Dialog: 0,1:15:19.42,1:15:21.56,Default,6,0,0,0,,dan mereka bahkan tidak menyadari apa yang sebenarnya terjadi.
Dialog: 0,1:15:21.66,1:15:23.70,Default,6,0,0,0,,Dia akan diserap oleh posisi baru,
Dialog: 0,1:15:24.00,1:15:26.87,Default,6,0,0,0,,ini akan membantu Anda menemukan buku akuntansi.
Dialog: 0,1:15:27.73,1:15:30.64,Default,6,0,0,0,,Untuk posisinya bisa kita ambil,
Dialog: 0,1:15:30.64,1:15:32.16,Default,6,0,0,0,,ketika dia mengira dia miliknya.
Dialog: 0,1:15:32.20,1:15:34.11,Default,6,0,0,0,,Sulit mempertahankan posisi kita,
Dialog: 0,1:15:34.37,1:15:35.81,Default,6,0,0,0,,tetapi mengembalikannya akan lebih sulit lagi.
Dialog: 0,1:15:35.91,1:15:38.17,Default,6,0,0,0,,Hanya pejuang sejati yang akan memimpin penjaga.
Dialog: 0,1:15:38.41,1:15:40.38,Default,6,0,0,0,,Saya mengerti dia akan menjadi boneka sederhana,
Dialog: 0,1:15:40.38,1:15:41.71,Default,6,0,0,0,,tetapi tidak berhasil,
Dialog: 0,1:15:41.71,1:15:43.37,Default,6,0,0,0,,kecuali dia secara fisik mampu melakukan pekerjaan itu.
Dialog: 0,1:15:45.18,1:15:48.92,Default,6,0,0,0,,Mari kita atur insiden kecil di hari pertamanya.
Dialog: 0,1:15:48.99,1:15:52.38,Default,6,0,0,0,,Dan jika Kim Moon-geun lebih pintar dari yang kita kira,
Dialog: 0,1:15:53.32,1:15:55.33,Default,6,0,0,0,,dan akan mengerti siapa penjaga sebenarnya?
Dialog: 0,1:15:56.49,1:15:58.62,Default,6,0,0,0,,Mari kita pastikan pengawal kerajaan terlindungi,
Dialog: 0,1:15:59.20,1:16:01.03,Default,6,0,0,0,,dan dapatkan bukunya.
Dialog: 0,1:16:01.03,1:16:02.99,Default,6,0,0,0,,Ayo lakukan tindakan ekstrem.
Dialog: 0,1:16:03.33,1:16:05.37,Default,6,0,0,0,,Kalau sudah tahu caranya, kenapa tidak sekarang?
Dialog: 0,1:16:05.67,1:16:07.44,Default,6,0,0,0,, “Pilihan terakhir” seperti apa?
Dialog: 0,1:16:11.04,1:16:12.20,Default,6,0,0,0,,Upaya.
Dialogue: 0,1:16:17.68,1:16:19.71,Default,6,0,0,0,,Itu akan tetap terjadi.
Dialogue: 0,1:16:37.60,1:16:39.70,Default,6,0,0,0,,Ruangan kecil yang membosankan?
Dialog: 0,1:17:00.02,1:17:01.23,Default,6,0,0,0,,Oh, kamu!
Dialog: 0,1:17:01.79,1:17:03.19,Default,6,0,0,0,,Lonceng berbunyi!
Dialogue: 0,1:17:13.67,1:17:15.11,Default,6,0,0,0,,Itu tadi ratunya?
Dialog: 0,1:17:15.11,1:17:17.28,Default,6,0,0,0,,Dia memperhatikan kita berpakaian seperti laki-laki?
Dialog: 0,1:17:17.28,1:17:18.78,Default,6,0,0,0,,Kita tidak bisa membiarkan dia lolos.
Dialog: 0,1:17:18.94,1:17:21.85,Default,6,0,0,0,,Kami bahkan tidak tahu apa yang dia dengar.
Dialog: 0,1:17:21.85,1:17:23.50,Default,6,0,0,0,,Saya yakin ada orang lain di sini bersamanya.
Dialog: 0,1:17:23.58,1:17:26.37,Default,6,0,0,0,,Jadi, kamu harus menyusulnya dan menutup mulutmu.
Dialog: 0,1:17:33.79,1:17:34.92,Default,6,0,0,0,,Yang Mulia.
Dialog: 0,1:17:43.94,1:17:46.44,Default,6,0,0,0,,Jangan biarkan emosi menghalangimu.
Dialog: 0,1:17:49.51,1:17:51.20,Default,6,0,0,0,,Saya akan mencari tahu sendiri.
Dialog: 0,1:18:33.12,1:18:34.24,Default,6,0,0,0,,10.
Dialog: 0,1:18:37.56,1:18:39.12,Default,6,0,0,0,,11.
Dialog: 0,1:18:40.76,1:18:43.19,Default,6,0,0,0,,Sial, aku akan ketahuan kalau tidak kembali tepat waktu.
Dialog: 0,1:20:20.99,1:20:23.70,Default,6,0,0,0,,Yang Mulia, jangan percaya siapa pun.
Dialog: 0,1:20:23.70,1:20:25.62,Default,6,0,0,0,,Terutama hati-hati dengan mereka yang dekat.
Dialog: 0,1:20:27.33,1:20:29.70,Default,6,0,0,0,,Anda tahu siapa yang melakukannya.
Dialog: 0,1:20:29.70,1:20:30.84,Default,6,0,0,0,,Penjahatnya adalah...
Dialog: 0,1:20:30.84,1:20:32.70,Default,6,0,0,0,,Jika ratu mendengar semuanya,
Dialog: 0,1:20:32.70,1:20:35.20,Default,6,0,0,0,,pertumpahan darah tidak bisa dihindari.
Dialog: 0,1:20:35.34,1:20:36.34,Default,6,0,0,0,,Siapa kamu?
Dialog: 0,1:20:36.34,1:20:38.81,Default,6,0,0,0,,Beraninya gadis itu datang ke sini?
Dialog: 0,1:20:38.81,1:20:40.51,Default,6,0,0,0,,Saat aku di sini,
Dialog: 0,1:20:40.51,1:20:41.98,Default,6,0,0,0,,Saya bosnya.
Dialog: 0,1:20:41.98,1:20:43.84,Default,6,0,0,0,,Apakah kamu menahannya seperti itu?
Dialog: 0,0:00:58.00,0:01:03.00,Default,,0,0,0,,


